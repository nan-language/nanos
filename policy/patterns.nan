//! Patterns: the globs of a rule's principals, operations and objects, which forms each parses as, and what each matches, `*` one segment and `**` any number.

/// The base instances' monikers, which `@base` matches with their paths below `/sys/instances` and `/sys/config`.
const BASE: Str = "supervisor devices fat keys store journal policy boot net link console admission clock power infer"

/// Whether `pattern` parses as an operation pattern.
pub fn operation_parses(pattern: Str, alloc: mem::Alloc) -> bool {
    if pattern == "*" {
        return true
    }
    let parts = split(pattern.as_bytes(), separator: b'.', alloc)
    if not globs(parts) {
        return false
    }
    let head = parts[0].view()
    let count = parts.len()
    if head == b"step" {
        return count == 2
    }
    if head == b"op" {
        return count >= 3
    }
    if head == b"reversibility" {
        return count == 2 and one_of(parts[1].view(), choices: "none recorded restorable *", alloc)
    }
    if head == b"irreversible" {
        return count == 1 or (count == 2 and one_of(parts[1].view(), choices: "emit actuate erase spend", alloc))
    }
    return count == 1 and one_of(head, choices: "widening trust-escape downgrade delegate extract", alloc)
} operation_parses

/// Whether `pattern` parses as an object pattern: `*`, `@base`, a path glob, a destination or a moniker glob.
pub fn object_parses(pattern: Str, alloc: mem::Alloc) -> bool {
    let bytes = pattern.as_bytes()
    if pattern == "*" or pattern == "@base" {
        return true
    }
    if bytes.len() > 0 and bytes[0] == b'/' {
        let Some(parts) = bytes.split_at(1) else {
            return false
        }
        return globs(split(parts.tail, separator: b'/', alloc))
    }
    let Some(colon) = position(bytes, byte: b':') else {
        return globs(split(bytes, separator: b'.', alloc))
    }
    let Some(halves) = bytes.split_at(colon) else {
        return false
    }
    let Some(ports) = halves.tail.split_at(1) else {
        return false
    }
    return host_parses(halves.head, alloc) and ports_parse(ports.tail)
} object_parses

/// Whether `pattern` parses as a principal glob.
pub fn principal_parses(pattern: Str, alloc: mem::Alloc) -> bool {
    return globs(split(pattern.as_bytes(), separator: b'.', alloc))
} principal_parses

/// Whether the dotted glob `pattern` matches the dotted name `name`.
pub fn dotted_matches(pattern: Str, name: Str, alloc: mem::Alloc) -> bool {
    return segments_match(split(pattern.as_bytes(), separator: b'.', alloc), name: split(name.as_bytes(), separator: b'.', alloc), alloc)
} dotted_matches

/// Whether the object pattern `pattern` matches `target`, a path, a destination `<host>:<port>` or a moniker, matching only objects of its form.
pub fn object_matches(pattern: Str, target: Str, alloc: mem::Alloc) -> bool {
    let wanted = pattern.as_bytes()
    let named = target.as_bytes()
    if pattern == "*" {
        return true
    }
    if pattern == "@base" {
        return base_object(named, alloc)
    }
    let path = named.len() > 0 and named[0] == b'/'
    if wanted.len() > 0 and wanted[0] == b'/' {
        if not path {
            return false
        }
        let Some(glob) = wanted.split_at(1) else {
            return false
        }
        let Some(rest) = named.split_at(1) else {
            return false
        }
        return segments_match(split(glob.tail, separator: b'/', alloc), name: split(rest.tail, separator: b'/', alloc), alloc)
    }
    let destination = position(named, byte: b':')
    match position(wanted, byte: b':') {
        Some(colon) => {
            let Some(at) = destination else {
                return false
            }
            let Some(glob) = wanted.split_at(colon) else {
                return false
            }
            let Some(host) = named.split_at(at) else {
                return false
            }
            return segments_match(split(glob.head, separator: b'.', alloc), name: split(host.head, separator: b'.', alloc), alloc) and port_matches(glob.tail, port: host.tail)
        }
        None => {
            if path or destination.is_some() {
                return false
            }
            return segments_match(split(wanted, separator: b'.', alloc), name: split(named, separator: b'.', alloc), alloc)
        }
    }
} object_matches

/// Whether `target` is what `@base` matches: a base instance's moniker, its specification's or configuration record's path, or `/sys/config/auth`.
fn base_object(target: Slice[u8], alloc: mem::Alloc) -> bool {
    if target == b"/sys/config/auth" or one_of(target, choices: BASE, alloc) {
        return true
    }
    return base_below(target, dir: b"/sys/instances/", alloc) or base_below(target, dir: b"/sys/config/", alloc)
} base_object

/// Whether `target` names a base instance's moniker directly below `dir`.
fn base_below(target: Slice[u8], dir: Slice[u8], alloc: mem::Alloc) -> bool {
    let Some(parts) = target.split_at(dir.len()) else {
        return false
    }
    return parts.head == dir and one_of(parts.tail, choices: BASE, alloc)
} base_below

/// Whether each part of a glob is `*`, `**` or a name segment.
fn globs(parts: mem::List[mem::Bytes]) -> bool {
    if parts.len() == 0 {
        return false
    }
    for part in parts {
        if part.len() == 0 {
            return false
        }
        for byte in part {
            if byte == b'/' or byte == b':' or byte == b' ' or byte < 0x21 or byte > 0x7E {
                return false
            }
        }
    }
    return true
} globs

/// Whether `host` parses as a destination's host: a moniker glob, or an address with a prefix length.
fn host_parses(host: Slice[u8], alloc: mem::Alloc) -> bool {
    match position(host, byte: b'/') {
        Some(slash) => {
            let Some(parts) = host.split_at(slash) else {
                return false
            }
            let Some(prefix) = parts.tail.split_at(1) else {
                return false
            }
            return parts.head.len() > 0 and number_of(prefix.tail).is_some()
        }
        None => return globs(split(host, separator: b'.', alloc))
    }
} host_parses

/// Whether `ports` parses as a destination's ports: `*`, a port, or a range of ports.
fn ports_parse(ports: Slice[u8]) -> bool {
    if ports == b"*" {
        return true
    }
    return port_range(ports).is_some()
} ports_parse

/// Whether the ports glob `glob`, led by `:`, matches `port`, led by `:`.
fn port_matches(glob: Slice[u8], port: Slice[u8]) -> bool {
    let Some(wanted) = glob.split_at(1) else {
        return false
    }
    let Some(given) = port.split_at(1) else {
        return false
    }
    if wanted.tail == b"*" {
        return true
    }
    let Some(range) = port_range(wanted.tail) else {
        return false
    }
    let Some(number) = number_of(given.tail) else {
        return false
    }
    return number >= range.low and number <= range.high
} port_matches

struct Ports derives Copy {
    low: u64
    high: u64
} Ports

/// The ports `text` names: one port, or a range `<low>-<high>`, each below 65,536.
fn port_range(text: Slice[u8]) -> Option[Ports] {
    match position(text, byte: b'-') {
        Some(dash) => {
            let Some(parts) = text.split_at(dash) else {
                return None
            }
            let Some(high) = parts.tail.split_at(1) else {
                return None
            }
            let Some(low) = number_of(parts.head) else {
                return None
            }
            let Some(top) = number_of(high.tail) else {
                return None
            }
            if low > top or top > 65_535 {
                return None
            }
            return Some(Ports(low: low, high: top))
        }
        None => {
            let Some(port) = number_of(text) else {
                return None
            }
            if port > 65_535 {
                return None
            }
            return Some(Ports(low: port, high: port))
        }
    }
} port_range

/// The decimal number `text` holds, `None` when it holds another byte or is empty or too long.
fn number_of(text: Slice[u8]) -> Option[u64] {
    if text.len() == 0 or text.len() > 9 {
        return None
    }
    var value: u64 = 0
    for byte in text {
        if byte < b'0' or byte > b'9' {
            return None
        }
        value = value * 10 + u64.widen(byte - b'0')
    }
    return Some(value)
} number_of

/// Whether the glob segments `pattern` match the segments `name`.
fn segments_match(pattern: mem::List[mem::Bytes], name: mem::List[mem::Bytes], alloc: mem::Alloc) -> bool {
    let count = name.len()
    var reach = mem::List[bool].empty(alloc)
    for at in 0..=count {
        mut reach.push(at == 0)
    }
    for glob in pattern {
        var next = mem::List[bool].empty(alloc)
        if glob.view() == b"**" {
            var any = false
            for at in 0..=count {
                any = any or reach[at]
                mut next.push(any)
            }
        } else {
            mut next.push(false)
            for at in 1..=count {
                mut next.push(reach[at - 1] and (glob.view() == b"*" or glob.view() == name[at - 1].view()))
            }
        }
        reach = next
    }
    return reach[count]
} segments_match

/// The parts of `text` between `separator`s.
fn split(text: Slice[u8], separator: u8, alloc: mem::Alloc) -> mem::List[mem::Bytes] {
    var parts = mem::List[mem::Bytes].empty(alloc)
    var part = mem::Bytes.empty(alloc)
    for byte in text {
        if byte == separator {
            mut parts.push(take part)
            part = mem::Bytes.empty(alloc)
        } else {
            mut part.push(byte)
        }
    }
    mut parts.push(take part)
    return parts
} split

/// Where `byte` first lies in `text`.
fn position(text: Slice[u8], byte: u8) -> Option[usize] {
    for at in 0..<text.len() {
        if text[at] == byte {
            return Some(at)
        }
    }
    return None
} position

/// Whether `word` is one of the words `choices` separates by spaces.
fn one_of(word: Slice[u8], choices: Str, alloc: mem::Alloc) -> bool {
    for choice in split(choices.as_bytes(), separator: b' ', alloc) {
        if choice.view() == word {
            return true
        }
    }
    return false
} one_of

test globs_match_one_or_any_segments for dotted_matches {
    let alloc = testing::world().alloc
    let deep = dotted_matches("agent.**", name: "agent.ops.c1", alloc)
    let none = dotted_matches("agent.**", name: "agent", alloc)
    let one = dotted_matches("op.boot.*", name: "op.boot.install", alloc)
    let two = dotted_matches("op.boot.*", name: "op.boot.a.b", alloc)
    let other = dotted_matches("human.**", name: "agent.ops", alloc)
    expect deep and none and one and not two and not other
} globs_match_one_or_any_segments

test objects_match_only_their_form for object_matches {
    let alloc = testing::world().alloc
    let path = object_matches("/sys/config/*", target: "/sys/config/store", alloc)
    let moniker = object_matches("/sys/config/*", target: "store", alloc)
    let spec = object_matches("@base", target: "/sys/instances/keys", alloc)
    let named_base = object_matches("@base", target: "journal", alloc)
    let app = object_matches("@base", target: "app.mail", alloc)
    let host = object_matches("*.example.org:587", target: "smtp.example.org:587", alloc)
    let range = object_matches("*.example.org:1-100", target: "smtp.example.org:587", alloc)
    expect path and not moniker and spec and named_base and not app and host and not range
    let operation = operation_parses("op.boot.*", alloc)
    let kind = operation_parses("irreversible.emit", alloc)
    let bare = operation_parses("step", alloc)
    let unknown = operation_parses("reversibility.lost", alloc)
    expect operation and kind and not bare and not unknown
    let address = object_parses("10.0.0.0/8:*", alloc)
    let tree = object_parses("/data/**", alloc)
    let port = object_parses("host:99999", alloc)
    expect address and tree and not port
} objects_match_only_their_form
