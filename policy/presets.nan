//! The presets: the rules of `locked`, `supervised` and `autonomous`, and a policy of each with the fields every preset shares.

/// A preset of chapter 19.
pub closed enum Preset derives Copy, Eq {
    Locked
    Supervised
    Autonomous
} Preset

/// The rules chapter 19 numbers 1 to 22.
const PRESET_RULES: u32 = 22

/// The preset's name, as `Policy.preset` holds it.
pub fn Preset.name(self) -> text::Fixed[16] {
    return text::Fixed[16].of(match self {
        Preset.Locked => "locked"
        Preset.Supervised => "supervised"
        Preset.Autonomous => "autonomous"
    })
} Preset.name

/// The policy of this preset, version `version`, for the machine `machine`.
pub fn Preset.policy(self, version: u64, machine: Array[u8, 16], alloc: mem::Alloc) -> Policy {
    var rules = mem::List[Rule].empty(alloc)
    for number in 1..=PRESET_RULES {
        if self.holds(number) {
            mut rules.push(preset_rule(number, alloc))
        }
    }
    var budgets = mem::List[AgentBudget].empty(alloc)
    mut budgets.push(AgentBudget(principals: text::String.of("agent.**", alloc), no_return_per_hour: 10, egress_bytes_per_day: 67_108_864, energy_mj_per_day: 36_000_000, tokens_per_day: 1_000_000, money_per_day: 0))
    return Policy(
        version: version,
        machine: machine,
        preset: text::String.of(self.name().as_str(), alloc),
        rules: take rules,
        allowlist: mem::List.empty(alloc),
        sensitive: mem::List.empty(alloc),
        reviewers: names("owner human.**", alloc),
        sealers: names("owner human.** vendor.**", alloc),
        builders: names("builder.**", alloc),
        agent_shared_space: false,
        asks_pending: 10,
        asks_per_hour: 30,
        extraction_bits: 64,
        budgets: take budgets,
    )
} Preset.policy

/// Whether the rule numbered `number` belongs to this preset.
fn Preset.holds(self, number: u32) -> bool {
    let locked = number <= 3
    let supervised = number <= 5 or number == 10 or number == 11 or number == 13 or number == 16 or number == 17 or number >= 20
    let autonomous = number <= 4 or (number >= 6 and number <= 10) or number == 12 or (number >= 14 and number <= 16) or number >= 18
    return match self {
        Preset.Locked => locked
        Preset.Supervised => supervised
        Preset.Autonomous => autonomous
    }
} Preset.holds

/// The rule numbered `number`, its fields the presets leave blank at their defaults: approvers `owner` and `human.**`, quorum 1, expiry 15 min.
fn preset_rule(number: u32, alloc: mem::Alloc) -> Rule {
    let principals = match number {
        1 => "owner"
        2 => "human.**"
        else => "agent.**"
    }
    var taint = TaintTest.Any
    if number == 7 {
        taint = TaintTest.Empty
    } else if number == 9 {
        taint = TaintTest.Tainted
    }
    var destinations = DestinationTest.Any
    if number == 7 {
        destinations = DestinationTest.Allowlisted
    } else if number == 8 {
        destinations = DestinationTest.Other
    }
    var channel = Channel.Any
    if number == 5 or number == 6 or number == 8 or number == 9 or number == 21 {
        channel = Channel.Independent
    }
    var provenance = mem::List[os::Provenance].empty(alloc)
    if number == 12 or number == 14 or number == 19 {
        mut provenance.push(os::Provenance.Reviewed)
        mut provenance.push(os::Provenance.Agent)
    }
    var budget_above = mem::List[BudgetKind].empty(alloc)
    if number == 22 {
        mut budget_above.push(BudgetKind.NoReturn)
        mut budget_above.push(BudgetKind.Egress)
        mut budget_above.push(BudgetKind.Energy)
        mut budget_above.push(BudgetKind.Tokens)
        mut budget_above.push(BudgetKind.Money)
    }
    return Rule(name: text::String.of(rule_name(number).as_str(), alloc), decision: decision_of(number), principals: names(principals, alloc), operations: names(operations_of(number).as_str(), alloc), objects: names(objects_of(number).as_str(), alloc), taint: taint, destinations: destinations, rule_of_two: number == 21, budget_above: take budget_above, provenance: take provenance, window: None, first_use: false, approvers: names("owner human.**", alloc), quorum: 1, expiry_min: 15, channel: channel)
} preset_rule

/// The decision of the preset rule numbered `number`.
fn decision_of(number: u32) -> Decision {
    if number <= 4 or number == 7 {
        return Decision.Allow
    }
    return Decision.Ask
} decision_of

/// The operation patterns of the preset rule numbered `number`, separated by spaces.
fn operations_of(number: u32) -> text::Fixed[80] {
    return text::Fixed[80].of(match number {
        3 => "delegate extract"
        4 => "reversibility.*"
        5 => "irreversible"
        6 => "irreversible.actuate irreversible.erase irreversible.spend"
        7 or 8 or 9 => "irreversible.emit"
        10 => "widening"
        11 or 12 => "trust-escape"
        13 or 14 => "step.generation"
        15 => "downgrade"
        16 => "op.boot.*"
        17 or 20 => "step.*"
        18 => "step.write step.delete step.stop step.restore-checkpoint step.call"
        19 => "step.update"
        else => "*"
    })
} operations_of

/// The object patterns of the preset rule numbered `number`, separated by spaces.
fn objects_of(number: u32) -> text::Fixed[48] {
    return text::Fixed[48].of(match number {
        17 or 18 or 19 => "@base"
        20 => "/sys/config/store /sys/config/journal"
        else => "*"
    })
} objects_of

/// The name of the preset rule numbered `number`.
fn rule_name(number: u32) -> text::Fixed[32] {
    return text::Fixed[32].of(match number {
        1 => "owner"
        2 => "humans"
        3 => "agent-requests"
        4 => "agent-steps"
        5 => "no-return"
        6 => "no-return-held"
        7 => "egress-allowlisted"
        8 => "egress-other"
        9 => "egress-tainted"
        10 => "widenings"
        11 => "trust-escapes"
        12 => "trust-escapes-unvendored"
        13 => "generations"
        14 => "generations-unvendored"
        15 => "downgrades"
        16 => "boot-operations"
        17 => "base-instances"
        18 => "base-changes"
        19 => "base-updates-unvendored"
        20 => "retention"
        21 => "rule-of-two"
        else => "budgets"
    })
} rule_name

/// The names `spaced` holds, separated by spaces.
fn names(spaced: Str, alloc: mem::Alloc) -> mem::List[text::String] {
    var held = mem::List[text::String].empty(alloc)
    var name = text::String.empty(alloc)
    for byte in spaced.as_bytes() {
        if byte == b' ' {
            mut held.push(take name)
            name = text::String.empty(alloc)
        } else {
            mut name.push(char.checked_from_bits(u32.widen(byte)).value_or('?'))
        }
    }
    if name.byte_len() > 0 {
        mut held.push(take name)
    }
    return held
} names

test presets_hold_their_rules for Preset.policy {
    let alloc = testing::world().alloc
    let locked = Preset.Locked.policy(version: 1, machine: Array[u8, 16].filled(0), alloc)
    let supervised = Preset.Supervised.policy(version: 1, machine: Array[u8, 16].filled(0), alloc)
    let autonomous = Preset.Autonomous.policy(version: 1, machine: Array[u8, 16].filled(0), alloc)
    expect locked.rules.len() == 3 and supervised.rules.len() == 13 and autonomous.rules.len() == 18
    expect supervised.rules[4].name.as_str() == "no-return" and supervised.rules[4].channel == Channel.Independent
    expect autonomous.rules[6].name.as_str() == "egress-other" and supervised.preset.as_str() == "supervised"
} presets_hold_their_rules
