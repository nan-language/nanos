//! The policy's records: its rules with their decisions and conditions, the agent budgets, the policy and its signed record at `/sys/policy`, and `policy`'s configuration.

/// A rule's decision, `Deny` the strongest and `Allow` the weakest.
pub closed enum Decision derives Copy, Eq, Ord, Render, Encode {
    Allow
    Notify
    Ask
    Deny
} Decision

pub closed enum TaintTest derives Copy, Eq, Render, Encode {
    Any
    Empty
    Tainted
} TaintTest

pub closed enum DestinationTest derives Copy, Eq, Render, Encode {
    Any
    Allowlisted
    Other
} DestinationTest

pub closed enum Channel derives Copy, Eq, Render, Encode {
    Any
    Independent
} Channel

pub closed enum BudgetKind derives Copy, Eq, Render, Encode {
    NoReturn
    Egress
    Energy
    Tokens
    Money
} BudgetKind

/// The days, bit 0 for Monday to bit 6 for Sunday, and the UTC minutes of the day a rule holds in.
pub closed struct Window derives Copy, Eq, Render, Encode {
    pub days: u8
    pub from_min: u16 where from_min < 1_440
    pub to_min: u16 where to_min <= 1_440
} Window

pub closed struct Rule derives Render, Encode {
    pub name: text::String
    pub decision: Decision
    pub principals: mem::List[text::String]
    pub operations: mem::List[text::String]
    pub objects: mem::List[text::String]
    pub taint: TaintTest
    pub destinations: DestinationTest
    pub rule_of_two: bool
    pub budget_above: mem::List[BudgetKind]
    pub provenance: mem::List[os::Provenance]
    pub window: Option[Window]
    pub first_use: bool
    pub approvers: mem::List[text::String]
    pub quorum: u8 where quorum >= 1
    pub expiry_min: u16 where expiry_min >= 1 and expiry_min <= 1_440
    pub channel: Channel
} Rule

pub closed struct AgentBudget derives Render, Encode {
    pub principals: text::String
    pub no_return_per_hour: u32
    pub egress_bytes_per_day: u64
    pub energy_mj_per_day: u64
    pub tokens_per_day: u64
    pub money_per_day: u64
} AgentBudget

pub closed struct Policy derives Render, Encode {
    pub version: u64
    pub machine: Array[u8, 16]
    pub preset: text::String
    pub rules: mem::List[Rule]
    pub allowlist: mem::List[text::String]
    pub sensitive: mem::List[text::String]
    pub reviewers: mem::List[text::String]
    pub sealers: mem::List[text::String]
    pub builders: mem::List[text::String]
    pub agent_shared_space: bool
    pub asks_pending: u16
    pub asks_per_hour: u16
    pub extraction_bits: u16
    pub budgets: mem::List[AgentBudget]
} Policy

/// The record of `/sys/policy`: the policy and the owner's signature of kind `policy` over its `mem::wire` encoding.
pub closed struct SignedPolicy derives Render, Encode {
    pub policy: Policy
    pub signature: Option[ident::Signature]
} SignedPolicy

/// The configuration of `policy`, `/sys/config/policy`: the machine id.
pub closed struct PolicyConfig derives Copy, Eq, Render, Encode {
    pub machine: Array[u8, 16]
} PolicyConfig
