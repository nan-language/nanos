//! The `policy` instance: the owner-signed policy and its presets, the patterns its rules match, and the decisions it gives subjects.

package policy {
    language 1
    targets any
    dep ident "../ident"
    dep journal "../journal"
    dep keys "../keys"
    dep os "../os"
    dep store "../store"
    allow validate in ident, journal, keys, os, policy, store
} policy
