//! Parsing the canonical rendering back: each name, identifier and time read from the text form its `Render` writes, a hash from its full form.

impl HashValue: core::Parse

impl Signature: core::Parse

impl Moniker: core::Parse

impl Principal: core::Parse

impl Path: core::Parse

impl OriginLabel: core::Parse

impl RequestId: core::Parse

impl CommitId: core::Parse

impl Cause: core::Parse

impl ApprovalId: core::Parse

impl Cursor: core::Parse

impl SessionId: core::Parse

impl WallTime: core::Parse

/// Its full form; a short form, which names a hash only in part, fails with `Invalid`.
pub fn HashValue.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> HashValue fails core::DecodeError {
    return match HashText.parse(raw.inspect()) {
        Some(HashText.Full(hash)) => hash
        Some(HashText.Short(_)) => fail core::DecodeError.Invalid
        None => fail core::DecodeError.Malformed
    }
} HashValue.parse

pub fn Signature.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> Signature fails core::DecodeError {
    return match Signature.of_text(raw.inspect()) {
        Some(signature) => signature
        None => fail core::DecodeError.Malformed
    }
} Signature.parse

pub fn Moniker.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> Moniker fails core::DecodeError {
    let text = raw.inspect()
    if text.byte_len() > 59 or not is_moniker(text::Fixed[59].of(text)) {
        fail core::DecodeError.Invalid
    }
    return Moniker(text: text::Fixed[59].of(text))
} Moniker.parse

pub fn Principal.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> Principal fails core::DecodeError {
    let text = raw.inspect()
    if text.byte_len() > 64 or not is_principal(text::Fixed[64].of(text)) {
        fail core::DecodeError.Invalid
    }
    return Principal(text: text::Fixed[64].of(text))
} Principal.parse

pub fn Path.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> Path fails core::DecodeError {
    let text = text::String.of(raw.inspect(), alloc)
    if not is_path(text) {
        fail core::DecodeError.Invalid
    }
    return Path(text: take text)
} Path.parse

pub fn OriginLabel.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> OriginLabel fails core::DecodeError {
    let text = raw.inspect()
    if text.byte_len() > 260 or not is_origin_label(text::Fixed[260].of(text)) {
        fail core::DecodeError.Invalid
    }
    return OriginLabel(text: text::Fixed[260].of(text))
} OriginLabel.parse

pub fn RequestId.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> RequestId fails core::DecodeError {
    let text = raw.inspect()
    if text.byte_len() > 32 or not is_request_id(text::Fixed[32].of(text)) {
        fail core::DecodeError.Invalid
    }
    return RequestId(text: text::Fixed[32].of(text))
} RequestId.parse

pub fn CommitId.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> CommitId fails core::DecodeError {
    return match CommitId.of_text(raw.inspect()) {
        Some(commit) => commit
        None => fail core::DecodeError.Malformed
    }
} CommitId.parse

pub fn Cause.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> Cause fails core::DecodeError {
    return match Cause.of_text(raw.inspect()) {
        Some(cause) => cause
        None => fail core::DecodeError.Malformed
    }
} Cause.parse

pub fn ApprovalId.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> ApprovalId fails core::DecodeError {
    return match ApprovalId.of_text(raw.inspect()) {
        Some(approval) => approval
        None => fail core::DecodeError.Malformed
    }
} ApprovalId.parse

pub fn Cursor.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> Cursor fails core::DecodeError {
    return match Cursor.of_text(raw.inspect()) {
        Some(cursor) => cursor
        None => fail core::DecodeError.Malformed
    }
} Cursor.parse

/// `s<b>.<n>`, the form its `Render` writes.
pub fn SessionId.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> SessionId fails core::DecodeError {
    let text = raw.inspect()
    if text.find(".").is_none() {
        fail core::DecodeError.Malformed
    }
    return match SessionId.of_text(text, current_boot: 0) {
        Some(session) => session
        None => fail core::DecodeError.Malformed
    }
} SessionId.parse

pub fn WallTime.parse(raw: Untrusted[Str], alloc: mem::Alloc) -> WallTime fails core::DecodeError {
    return match WallTime.of_text(raw.inspect()) {
        Some(time) => time
        None => fail core::DecodeError.Malformed
    }
} WallTime.parse

/// A record of identifiers, for tests.
struct Named derives Eq, Render, Encode {
    principal: Principal
    path: Path
    commit: CommitId
    session: SessionId
    hash: HashValue
} Named

test renderings_parse_back for Principal.parse {
    let alloc = testing::world().alloc
    var bytes = Array[u8, 33].filled(7)
    bytes[0] = 0x01
    let named = Named(principal: Principal(text: text::Fixed[64].of("agent.ops")), path: Path(text: text::String.of("/sys/config/app", alloc)), commit: CommitId(number: 12), session: SessionId(boot: 3, number: 4), hash: HashValue(bytes: bytes))
    var rendered = text::String.empty(alloc)
    mut rendered.write(Dyn[Render].view(named), budget: 512)
    expect rendered.as_str().starts_with("Named(principal: agent.ops, path: /sys/config/app, commit: #12, session: s3.4, hash: ")
    var full = text::String.of("Named(principal: agent.ops, path: /sys/config/app, commit: #12, session: s3.4, hash: ", alloc)
    mut full.append(HashValue(bytes: bytes).full_form().as_str())
    mut full.push(')')
    let decoded = attempt text::construction::Codec[Named].decode(Untrusted.of(full.as_str().as_bytes()), alloc)
    let short = attempt text::construction::Codec[Named].decode(Untrusted.of(rendered.as_str().as_bytes()), alloc)
    let same = match decoded {
        Ok(read) => read == named
        Err(_) => false
    }
    expect same and short == Err(core::DecodeError.Invalid)
} renderings_parse_back
