//! The canonical rendering of names, identifiers and times: the text forms records render them in.

impl HashValue: Render

impl Signature: Render

impl Moniker: Render

impl Principal: Render

impl Path: Render

impl OriginLabel: Render

impl RequestId: Render

impl CommitId: Render

impl Cause: Render

impl ApprovalId: Render

impl Cursor: Render

impl SessionId: Render

impl WallTime: Render

/// The short form.
pub fn HashValue.render(self, mut out: core::Renderer) {
    mut out.write(self.short_form().as_str())
} HashValue.render

pub fn Signature.render(self, mut out: core::Renderer) {
    mut out.write(self.to_text().as_str())
} Signature.render

pub fn Moniker.render(self, mut out: core::Renderer) {
    mut out.write(self.text.as_str())
} Moniker.render

pub fn Principal.render(self, mut out: core::Renderer) {
    mut out.write(self.text.as_str())
} Principal.render

/// Its text, which holds each segment in canonical rendering.
pub fn Path.render(self, mut out: core::Renderer) {
    mut out.write(self.text.as_str())
} Path.render

pub fn OriginLabel.render(self, mut out: core::Renderer) {
    mut out.write(self.text.as_str())
} OriginLabel.render

pub fn RequestId.render(self, mut out: core::Renderer) {
    mut out.write(self.text.as_str())
} RequestId.render

pub fn CommitId.render(self, mut out: core::Renderer) {
    mut out.write(self.to_text().as_str())
} CommitId.render

pub fn Cause.render(self, mut out: core::Renderer) {
    mut out.write(self.to_text().as_str())
} Cause.render

pub fn ApprovalId.render(self, mut out: core::Renderer) {
    mut out.write(self.to_text().as_str())
} ApprovalId.render

pub fn Cursor.render(self, mut out: core::Renderer) {
    mut out.write(self.to_text().as_str())
} Cursor.render

/// `s<b>.<n>`, the form naming a session of any boot.
pub fn SessionId.render(self, mut out: core::Renderer) {
    var form = text::Fixed[42].of("s")
    push_number(self.boot, out: mut form)
    mut form.push('.')
    push_number(self.number, out: mut form)
    mut out.write(form.as_str())
} SessionId.render

pub fn WallTime.render(self, mut out: core::Renderer) {
    mut out.write(self.to_text().as_str())
} WallTime.render

test identifiers_render_their_text_forms for SessionId.render {
    let world = testing::world()
    let alloc = world.alloc
    var out = text::String.empty(alloc)
    let path = Path(text: text::String.of("/data/agent.ops/\"notes 2026.txt\"", alloc))
    mut out.write(Dyn[Render].view(path), budget: 256)
    expect out.as_str() == "/data/agent.ops/\"notes 2026.txt\""
    var session = text::String.empty(alloc)
    let id = SessionId(boot: 12, number: 3)
    mut session.write(Dyn[Render].view(id), budget: 16)
    expect session.as_str() == "s12.3"
    var nested = text::String.empty(alloc)
    let named: Option[Moniker] = Some(Moniker(text: text::Fixed[59].of("app")))
    mut nested.write(Dyn[Render].view(named), budget: 16)
    expect nested.as_str() == "Some(app)"
} identifiers_render_their_text_forms
