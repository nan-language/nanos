//! Hashes and signatures of NaN OS objects.

/// A sort of object NaN OS hashes: its name and a line feed precede the object's bytes in the object's hash.
pub closed enum Kind derives Copy, Eq {
    Record
    Secret
    Stream
    Ephemeral
    Dir
    Entry
    Run
    Transaction
    Manifest
    Code
    Bundle
    Review
    Seal
    Certificate
    Plan
    ReadSet
    Approval
    Policy
    Request
    Audit
    Anchor
    Handshake
} Kind

/// The hash of content hashed alone, such as a blob's or a manifest's file's.
pub fn HashValue.of_content(content: Slice[u8]) -> HashValue {
    var digest = Blake3.empty()
    mut digest.update(content)
    return HashValue.of_digest(digest.finish())
} HashValue.of_content

/// The hash of content received as Untrusted, such as a file read from a volume.
pub validator fn HashValue.of_untrusted(content: Untrusted[Slice[u8]]) -> HashValue {
    return HashValue.of_content(content.inspect())
} HashValue.of_untrusted

/// The hash of an object of kind `kind` whose bytes are `bytes`.
pub fn HashValue.of_object(kind: Kind, bytes: Slice[u8]) -> HashValue {
    var digest = Blake3.empty()
    kind.begin(mut digest)
    mut digest.update(bytes)
    return HashValue.of_digest(digest.finish())
} HashValue.of_object

/// The most bytes a piece of a blob holds: 64 BLAKE3 chunks.
pub const PIECE_BYTES: usize = 65_536

/// The key of the piece of a blob numbered `index`, holding `piece`: the chaining value, without the root flag, of the subtree of the blob's BLAKE3 tree covering the piece's chunks.
pub fn piece_key(piece: Slice[u8], index: u64) -> Array[u8, 32]
    requires piece.len() > 0 and piece.len() <= PIECE_BYTES
{
    var digest = Blake3.at_chunk(index * 64)
    mut digest.update(piece)
    let words = digest.subtree()
    var key = Array[u8, 32].filled(0)
    for i in 0..<8usize {
        mut key.view_mut().write_u32_le(4 * i, value: words[i])
    }
    return key
} piece_key

/// The hash of a blob of more than one piece, from the keys of its pieces in order.
pub fn HashValue.of_pieces(keys: Slice[Array[u8, 32]], alloc: mem::Alloc) -> HashValue
    requires keys.len() >= 2
{
    var values = mem::List[Array[u32, 8]].empty(alloc)
    for key in keys {
        var words = Array[u32, 8].filled(0)
        for i in 0..<8usize {
            words[i] = key.view().u32_le(4 * i)
        }
        mut values.push(words)
    }
    return HashValue.of_digest(root_of_subtrees(values.view()))
} HashValue.of_pieces

/// The most bytes of data [derive] takes, which with its key and tag fill one BLAKE3 chunk.
pub const DERIVED_BYTES: usize = 991

/// The BLAKE3-256 digest of `key`, `tag` and `data` in turn: what `key` derives under `tag`, apart from what it derives under any other.
pub fn derive(key: Array[u8, 32], tag: u8, data: Slice[u8]) -> Array[u8, 32]
    requires data.len() <= DERIVED_BYTES
{
    var chunk = Chunk.empty()
    for byte in key.view() {
        mut chunk.add(byte, counter: 0)
    }
    mut chunk.add(tag, counter: 0)
    for byte in data {
        mut chunk.add(byte, counter: 0)
    }
    return chunk.output(counter: 0).root()
} derive

/// Whether this is the signature of `object` by the Ed25519 public key `key`.
pub fn Signature.verifies(self, key: Array[u8, 32], object: HashValue) -> bool {
    let signature = core::crypto::Signature(bytes: self.bytes)
    return core::crypto::PublicKey(bytes: key).verify(object.bytes.view(), signature)
} Signature.verifies

fn HashValue.of_digest(digest: Array[u8, 32]) -> HashValue {
    var bytes = Array[u8, 33].filled(0x01)
    for i in 0..<32usize {
        invariant bytes[0] == 0x01
        bytes[i + 1] = digest[i]
    }
    return HashValue(bytes: bytes)
} HashValue.of_digest

fn Kind.begin(self, mut digest: Blake3) {
    let line = match self {
        Kind.Record => b"record\n"
        Kind.Secret => b"secret\n"
        Kind.Stream => b"stream\n"
        Kind.Ephemeral => b"ephemeral\n"
        Kind.Dir => b"dir\n"
        Kind.Entry => b"entry\n"
        Kind.Run => b"run\n"
        Kind.Transaction => b"transaction\n"
        Kind.Manifest => b"manifest\n"
        Kind.Code => b"code\n"
        Kind.Bundle => b"bundle\n"
        Kind.Review => b"review\n"
        Kind.Seal => b"seal\n"
        Kind.Certificate => b"certificate\n"
        Kind.Plan => b"plan\n"
        Kind.ReadSet => b"read-set\n"
        Kind.Approval => b"approval\n"
        Kind.Policy => b"policy\n"
        Kind.Request => b"request\n"
        Kind.Audit => b"audit\n"
        Kind.Anchor => b"anchor\n"
        Kind.Handshake => b"handshake\n"
    }
    mut digest.update(line)
} Kind.begin

fn pattern(len: usize, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.zeroed(len, alloc)
    for i in 0..<len {
        bytes[i] = u8.truncate(i % 251)
    }
    return bytes
} pattern

fn digest_of_pattern(len: usize, alloc: mem::Alloc) -> Array[u8, 32] {
    let content = pattern(len, alloc)
    let hash = HashValue.of_content(content.view())
    var digest = Array[u8, 32].filled(0)
    for i in 0..<32usize {
        digest[i] = hash.bytes[i + 1]
    }
    return digest
} digest_of_pattern

test content_hashes_are_blake3 for HashValue.of_content {
    let alloc = testing::world().alloc
    expect HashValue.of_content(b"").bytes[0] == 0x01
    let len_0 = digest_of_pattern(0, alloc)
    expect len_0.view() == b"\xaf\x13\x49\xb9\xf5\xf9\xa1\xa6\xa0\x40\x4d\xea\x36\xdc\xc9\x49\x9b\xcb\x25\xc9\xad\xc1\x12\xb7\xcc\x9a\x93\xca\xe4\x1f\x32\x62"
    let len_1 = digest_of_pattern(1, alloc)
    expect len_1.view() == b"\x2d\x3a\xde\xdf\xf1\x1b\x61\xf1\x4c\x88\x6e\x35\xaf\xa0\x36\x73\x6d\xcd\x87\xa7\x4d\x27\xb5\xc1\x51\x02\x25\xd0\xf5\x92\xe2\x13"
    let len_63 = digest_of_pattern(63, alloc)
    expect len_63.view() == b"\xe9\xbc\x37\xa5\x94\xda\xad\x83\xbe\x94\x70\xdf\x7f\x7b\x37\x98\x29\x7c\x3d\x83\x4c\xe8\x0b\xa8\x5d\x6e\x20\x76\x27\xb7\xdb\x7b"
    let len_64 = digest_of_pattern(64, alloc)
    expect len_64.view() == b"\x4e\xed\x71\x41\xea\x4a\x5c\xd4\xb7\x88\x60\x6b\xd2\x3f\x46\xe2\x12\xaf\x9c\xac\xeb\xac\xdc\x7d\x1f\x4c\x6d\xc7\xf2\x51\x1b\x98"
    let len_65 = digest_of_pattern(65, alloc)
    expect len_65.view() == b"\xde\x1e\x5f\xa0\xbe\x70\xdf\x6d\x2b\xe8\xff\xfd\x0e\x99\xce\xaa\x8e\xb6\xe8\xc9\x3a\x63\xf2\xd8\xd1\xc3\x0e\xcb\x6b\x26\x3d\xee"
    let len_1023 = digest_of_pattern(1_023, alloc)
    expect len_1023.view() == b"\x10\x10\x89\x70\xee\xda\x3e\xb9\x32\xba\xac\x14\x28\xc7\xa2\x16\x3b\x0e\x92\x4c\x9a\x9e\x25\xb3\x5b\xba\x72\xb2\x8f\x70\xbd\x11"
    let len_1024 = digest_of_pattern(1_024, alloc)
    expect len_1024.view() == b"\x42\x21\x47\x39\xf0\x95\xa4\x06\xf3\xfc\x83\xde\xb8\x89\x74\x4a\xc0\x0d\xf8\x31\xc1\x0d\xaa\x55\x18\x9b\x5d\x12\x1c\x85\x5a\xf7"
    let len_1025 = digest_of_pattern(1_025, alloc)
    expect len_1025.view() == b"\xd0\x02\x78\xae\x47\xeb\x27\xb3\x4f\xae\xcf\x67\xb4\xfe\x26\x3f\x82\xd5\x41\x29\x16\xc1\xff\xd9\x7c\x8c\xb7\xfb\x81\x4b\x84\x44"
    let len_2048 = digest_of_pattern(2_048, alloc)
    expect len_2048.view() == b"\xe7\x76\xb6\x02\x8c\x7c\xd2\x2a\x4d\x0b\xa1\x82\xa8\xbf\x62\x20\x5d\x2e\xf5\x76\x46\x7e\x83\x8e\xd6\xf2\x52\x9b\x85\xfb\xa2\x4a"
    let len_2049 = digest_of_pattern(2_049, alloc)
    expect len_2049.view() == b"\x5f\x4d\x72\xf4\x0d\x7a\x5f\x82\xb1\x5c\xa2\xb2\xe4\x4b\x1d\xe3\xc2\xef\x86\xc4\x26\xc9\x5c\x1a\xf0\xb6\x87\x95\x22\x56\x30\x30"
    let len_3072 = digest_of_pattern(3_072, alloc)
    expect len_3072.view() == b"\xb9\x8c\xb0\xff\x36\x23\xbe\x03\x32\x6b\x37\x3d\xe6\xb9\x09\x52\x18\x51\x3e\x64\xf1\xee\x2e\xdd\x25\x25\xc7\xad\x1e\x5c\xff\xd2"
    let len_3073 = digest_of_pattern(3_073, alloc)
    expect len_3073.view() == b"\x71\x24\xb4\x95\x01\x01\x2f\x81\xcc\x7f\x11\xca\x06\x9e\xc9\x22\x6c\xec\xb8\xa2\xc8\x50\xcf\xe6\x44\xe3\x27\xd2\x2d\x3e\x1c\xd3"
    let len_4096 = digest_of_pattern(4_096, alloc)
    expect len_4096.view() == b"\x01\x50\x94\x01\x3f\x57\xa5\x27\x7b\x59\xd8\x47\x5c\x05\x01\x04\x2c\x0b\x64\x2e\x53\x1b\x0a\x1c\x8f\x58\xd2\x16\x32\x29\xe9\x69"
    let len_4097 = digest_of_pattern(4_097, alloc)
    expect len_4097.view() == b"\x9b\x40\x52\xb3\x8f\x1c\x5f\xc8\xb1\xf9\xff\x7a\xc7\xb2\x7c\xd2\x42\x48\x7b\x3d\x89\x0d\x15\xc9\x6a\x1c\x25\xb8\xaa\x0f\xb9\x95"
    let len_8193 = digest_of_pattern(8_193, alloc)
    expect len_8193.view() == b"\xba\xb6\xc0\x9c\xb8\xce\x8c\xf4\x59\x26\x13\x98\xd2\xe7\xae\xf3\x57\x00\xbf\x48\x81\x16\xce\xb9\x4a\x36\xd0\xf5\xf1\xb7\xbc\x3b"
    let len_31744 = digest_of_pattern(31_744, alloc)
    expect len_31744.view() == b"\x62\xb6\x96\x0e\x1a\x44\xbc\xc1\xeb\x1a\x61\x1a\x8d\x62\x35\xb6\xb4\xb7\x8f\x32\xe7\xab\xc4\xfb\x4c\x6c\xdc\xce\x94\x89\x5c\x47"
} content_hashes_are_blake3

test derived_keys_hash_the_key_tag_and_data for derive {
    var joined = Array[u8, 35].filled(7)
    joined[32] = 2
    joined[33] = 0x61
    joined[34] = 0x62
    expect HashValue.of_digest(derive(Array[u8, 32].filled(7), tag: 2, data: b"ab")) == HashValue.of_content(joined.view())
} derived_keys_hash_the_key_tag_and_data

fn hash_by_pieces(len: usize, alloc: mem::Alloc) -> HashValue {
    let content = pattern(len, alloc)
    var keys = mem::List[Array[u8, 32]].empty(alloc)
    var at: usize = 0
    while at < len {
        let Some(parts) = content.view().split_at(at) else {
            break
        }
        let size = match parts.tail.len() < PIECE_BYTES {
            true => parts.tail.len()
            false => PIECE_BYTES
        }
        let Some(piece) = parts.tail.prefix(size) else {
            break
        }
        mut keys.push(piece_key(piece, index: u64.widen(at / PIECE_BYTES)))
        at += size
    }
    return HashValue.of_pieces(keys.view(), alloc)
} hash_by_pieces

fn pieces_agree(len: usize, alloc: mem::Alloc) -> bool {
    let whole = pattern(len, alloc)
    return hash_by_pieces(len, alloc) == HashValue.of_content(whole.view())
} pieces_agree

test pieces_give_the_blob_hash for HashValue.of_pieces {
    let alloc = testing::world().alloc
    let two = pieces_agree(65_537, alloc)
    let whole_pieces = pieces_agree(131_072, alloc)
    let partial_chunk = pieces_agree(132_096, alloc)
    let three = pieces_agree(200_000, alloc)
    let five = pieces_agree(262_145, alloc)
    expect two and whole_pieces and partial_chunk and three and five
} pieces_give_the_blob_hash

test received_content_hashes_alike for HashValue.of_untrusted {
    let received = HashValue.of_untrusted(Untrusted.of(b"abc"))
    expect received == HashValue.of_content(b"abc")
} received_content_hashes_alike

test object_hashes_prefix_the_kind for HashValue.of_object {
    let manifest = HashValue.of_object(Kind.Manifest, bytes: b"abc")
    expect manifest == HashValue.of_content(b"manifest\nabc")
    expect manifest.bytes.view().prefix(5) == Some(b"\x01\x55\x81\x5d\x67")
    expect HashValue.of_object(Kind.ReadSet, bytes: b"") == HashValue.of_content(b"read-set\n")
} object_hashes_prefix_the_kind

test signatures_verify_by_key_and_object for Signature.verifies {
    let key = core::crypto::SecretKey.of_seed(Array[u8, 32].filled(7))
    let object = HashValue.of_object(Kind.Request, bytes: b"claim")
    let signed = Signature(bytes: key.sign(object.bytes.view()).bytes)
    expect signed.verifies(key.public_key().bytes, object)
    expect not signed.verifies(key.public_key().bytes, object: HashValue.of_object(Kind.Plan, bytes: b"claim"))
    let other = core::crypto::SecretKey.of_seed(Array[u8, 32].filled(8))
    expect not signed.verifies(other.public_key().bytes, object)
} signatures_verify_by_key_and_object
