//! BLAKE3-256 digests.

const IV: Array[u32, 8] = initial_words()

const CHUNK_START: u32 = 1

const CHUNK_END: u32 = 2

const PARENT: u32 = 4

const ROOT: u32 = 8

const BLOCK_BYTES: usize = 64

const CHUNK_BLOCKS: u32 = 16

/// A digest of the bytes given to [Blake3.update], kept with the last block and the last chunk pending so that [Blake3.finish] can mark them.
pkg struct Blake3 {
    chunk: Chunk
    chunks: u64
    stack: Array[Array[u32, 8], 54]
    depth: usize
} Blake3

/// The chunk being hashed: its chaining value, its pending block and that block's length, and how many blocks it has compressed.
pkg struct Chunk derives Copy {
    cv: Array[u32, 8]
    block: Array[u8, 64]
    block_len: usize
    blocks: u32
} Chunk

/// The inputs of one compression, which yields a chaining value or, flagged `ROOT`, the digest.
pkg struct Output derives Copy {
    cv: Array[u32, 8]
    words: Array[u32, 16]
    counter: u64
    block_len: u32
    flags: u32
} Output

pkg fn Blake3.empty() -> Blake3 {
    return Blake3(chunk: Chunk.empty(), chunks: 0, stack: Array[Array[u32, 8], 54].filled(IV), depth: 0)
} Blake3.empty

pkg fn Blake3.update(mut self, data: Slice[u8]) {
    for byte in data {
        if self.chunk.block_len == BLOCK_BYTES and self.chunk.blocks + 1 == CHUNK_BLOCKS {
            let cv = self.chunk.output(counter: self.chunks).chaining_value()
            self.chunks += 1
            mut self.add_chunk(cv)
            self.chunk = Chunk.empty()
        }
        mut self.chunk.add(byte, counter: self.chunks)
    }
} Blake3.update

/// A digest of a subtree of a larger tree whose first chunk is chunk `first_chunk` of that tree, a multiple of the most chunks the subtree holds.
pkg fn Blake3.at_chunk(first_chunk: u64) -> Blake3 {
    return Blake3(chunk: Chunk.empty(), chunks: first_chunk, stack: Array[Array[u32, 8], 54].filled(IV), depth: 0)
} Blake3.at_chunk

pkg fn Blake3.finish(self) -> Array[u8, 32] {
    return self.top().root()
} Blake3.finish

/// The chaining value of the subtree the digested bytes fill: what a parent node above it reads.
pkg fn Blake3.subtree(self) -> Array[u32, 8] {
    return self.top().chaining_value()
} Blake3.subtree

/// The digest of the tree whose subtrees, all of one size but the last, which may be smaller, have the chaining values `values`.
pkg fn root_of_subtrees(values: Slice[Array[u32, 8]]) -> Array[u8, 32]
    requires values.len() >= 2
{
    var tree = Blake3.empty()
    for at in 0..<(values.len() - 1) {
        tree.chunks += 1
        mut tree.add_chunk(values[at])
    }
    var top = values[values.len() - 1]
    var depth = tree.depth
    loop {
        depth -= 1
        let output = parent_node(tree.stack[depth], right: top)
        if depth == 0 {
            return output.root()
        }
        top = output.chaining_value()
    }
} root_of_subtrees

pkg fn Chunk.empty() -> Chunk = Chunk(cv: IV, block: Array[u8, 64].filled(0), block_len: 0, blocks: 0)

/// Adds `byte` to the chunk of number `counter`, compressing its full pending block first, which more input follows.
pkg fn Chunk.add(mut self, byte: u8, counter: u64) {
    if self.block_len == BLOCK_BYTES {
        let words = compress(self.cv, words: block_words(self.block), counter, block_len: 64, flags: self.start_flag())
        self.cv = chaining(words)
        self.blocks += 1
        self.block = Array[u8, 64].filled(0)
        self.block_len = 0
    }
    self.block[self.block_len] = byte
    self.block_len += 1
} Chunk.add

/// The compression ending the chunk of number `counter`.
pkg fn Chunk.output(self, counter: u64) -> Output {
    return Output(
        cv: self.cv,
        words: block_words(self.block),
        counter: counter,
        block_len: u32.fit(self.block_len),
        flags: self.start_flag() | CHUNK_END,
    )
} Chunk.output

fn Chunk.start_flag(self) -> u32 {
    if self.blocks == 0 {
        return CHUNK_START
    }
    return 0
} Chunk.start_flag

/// The digest of the tree this compression is the root of.
pkg fn Output.root(self) -> Array[u8, 32] {
    let words = compress(self.cv, words: self.words, counter: 0, block_len: self.block_len, flags: self.flags | ROOT)
    var digest = Array[u8, 32].filled(0)
    for i in 0..<8usize {
        mut digest.view_mut().write_u32_le(4 * i, value: words[i])
    }
    return digest
} Output.root

/// The compression ending the tree: the pending chunk's, merged with the stack of subtrees.
fn Blake3.top(self) -> Output {
    var output = self.chunk.output(counter: self.chunks)
    var depth = self.depth
    for _ in 0..<54usize {
        if depth == 0 {
            break
        }
        depth -= 1
        output = parent_node(self.stack[depth], right: output.chaining_value())
    }
    return output
} Blake3.top

/// Merges the chaining value of a finished chunk into the stack of subtrees, the number of finished chunks deciding how many merge.
fn Blake3.add_chunk(mut self, cv: Array[u32, 8]) {
    var merged = cv
    var count = self.chunks
    for _ in 0..<64usize {
        if (count & 1) != 0 {
            break
        }
        self.depth -= 1
        merged = parent_node(self.stack[self.depth], right: merged).chaining_value()
        count = count >> 1
    }
    self.stack[self.depth] = merged
    self.depth += 1
} Blake3.add_chunk

fn Output.chaining_value(self) -> Array[u32, 8] {
    return chaining(compress(self.cv, words: self.words, counter: self.counter, block_len: self.block_len, flags: self.flags))
} Output.chaining_value

fn parent_node(left: Array[u32, 8], right: Array[u32, 8]) -> Output {
    var words = Array[u32, 16].filled(0)
    for i in 0..<8usize {
        words[i] = left[i]
        words[i + 8] = right[i]
    }
    return Output(cv: IV, words: words, counter: 0, block_len: 64, flags: PARENT)
} parent_node

fn compress(
    cv: Array[u32, 8],
    words: Array[u32, 16],
    counter: u64,
    block_len: u32,
    flags: u32,
    ) -> Array[u32, 16] {
    var state = Array[u32, 16].filled(0)
    for i in 0..<8usize {
        state[i] = cv[i]
    }
    for i in 0..<4usize {
        state[i + 8] = IV[i]
    }
    state[12] = u32.truncate(counter)
    state[13] = u32.truncate(counter >> 32)
    state[14] = block_len
    state[15] = flags
    var message = words
    round(mut state, message)
    for _ in 0..<6usize {
        message = permute(message)
        round(mut state, message)
    }
    for i in 0..<8usize {
        state[i] = state[i] ^ state[i + 8]
        state[i + 8] = state[i + 8] ^ cv[i]
    }
    return state
} compress

fn round(mut state: Array[u32, 16], message: Array[u32, 16]) {
    mix(mut state, a: 0, b: 4, c: 8, d: 12, x: message[0], y: message[1])
    mix(mut state, a: 1, b: 5, c: 9, d: 13, x: message[2], y: message[3])
    mix(mut state, a: 2, b: 6, c: 10, d: 14, x: message[4], y: message[5])
    mix(mut state, a: 3, b: 7, c: 11, d: 15, x: message[6], y: message[7])
    mix(mut state, a: 0, b: 5, c: 10, d: 15, x: message[8], y: message[9])
    mix(mut state, a: 1, b: 6, c: 11, d: 12, x: message[10], y: message[11])
    mix(mut state, a: 2, b: 7, c: 8, d: 13, x: message[12], y: message[13])
    mix(mut state, a: 3, b: 4, c: 9, d: 14, x: message[14], y: message[15])
} round

fn mix(
    mut state: Array[u32, 16],
    a: usize,
    b: usize,
    c: usize,
    d: usize,
    x: u32,
    y: u32,
    )
    requires a < 16 and b < 16 and c < 16 and d < 16
{
    state[a] = state[a].wrapping_add(state[b]).wrapping_add(x)
    state[d] = rotate16(state[d] ^ state[a])
    state[c] = state[c].wrapping_add(state[d])
    state[b] = rotate12(state[b] ^ state[c])
    state[a] = state[a].wrapping_add(state[b]).wrapping_add(y)
    state[d] = rotate8(state[d] ^ state[a])
    state[c] = state[c].wrapping_add(state[d])
    state[b] = rotate7(state[b] ^ state[c])
} mix

fn permute(message: Array[u32, 16]) -> Array[u32, 16] {
    var permuted = message
    permuted[0] = message[2]
    permuted[1] = message[6]
    permuted[2] = message[3]
    permuted[3] = message[10]
    permuted[4] = message[7]
    permuted[5] = message[0]
    permuted[6] = message[4]
    permuted[7] = message[13]
    permuted[8] = message[1]
    permuted[9] = message[11]
    permuted[10] = message[12]
    permuted[11] = message[5]
    permuted[12] = message[9]
    permuted[13] = message[14]
    permuted[14] = message[15]
    permuted[15] = message[8]
    return permuted
} permute

fn initial_words() -> Array[u32, 8] {
    var words = Array[u32, 8].filled(0x6A09_E667)
    words[1] = 0xBB67_AE85
    words[2] = 0x3C6E_F372
    words[3] = 0xA54F_F53A
    words[4] = 0x510E_527F
    words[5] = 0x9B05_688C
    words[6] = 0x1F83_D9AB
    words[7] = 0x5BE0_CD19
    return words
} initial_words

fn block_words(block: Array[u8, 64]) -> Array[u32, 16] {
    var words = Array[u32, 16].filled(0)
    for i in 0..<16usize {
        words[i] = block.view().u32_le(4 * i)
    }
    return words
} block_words

fn chaining(words: Array[u32, 16]) -> Array[u32, 8] {
    var cv = Array[u32, 8].filled(0)
    for i in 0..<8usize {
        cv[i] = words[i]
    }
    return cv
} chaining

fn rotate16(x: u32) -> u32 = (x >> 16) | (x << 16)

fn rotate12(x: u32) -> u32 = (x >> 12) | (x << 20)

fn rotate8(x: u32) -> u32 = (x >> 8) | (x << 24)

fn rotate7(x: u32) -> u32 = (x >> 7) | (x << 25)
