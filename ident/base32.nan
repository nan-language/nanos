//! Text forms of hashes, signatures and public keys, in NaN's checksummed base32.

const ALPHABET: Slice[u8] = b"abcdefghijklmnopqrstuvwxyz234567"

/// A hash as a request writes it: a full form names one hash, and a short form every hash with its tag and first 9 digest bytes.
pub closed enum HashText derives Copy, Eq {
    Full(HashValue)
    Short(Array[u8, 10])
} HashText

/// The short form of this hash: the checksummed base32 of its tag and the first 9 bytes of its digest.
pub fn HashValue.short_form(self) -> text::Fixed[18] {
    let head = self.head()
    var form = text::Fixed[18].empty()
    write_checksummed(head.view(), out: mut form)
    return form
} HashValue.short_form

/// The full form of this hash: the checksummed base32 of its 33 bytes.
pub fn HashValue.full_form(self) -> text::Fixed[55] {
    var form = text::Fixed[55].empty()
    write_checksummed(self.bytes.view(), out: mut form)
    return form
} HashValue.full_form

/// The hash a full form names or the hashes a short form names, `None` for any other text.
pub fn HashText.parse(text: Str) -> Option[HashText] {
    if text.byte_len() == 18 {
        var head = Array[u8, 10].filled(0)
        if not read_checksummed(text, out: mut head.view_mut()) or head[0] != 0x01 {
            return None
        }
        return Some(HashText.Short(head))
    }
    var bytes = Array[u8, 33].filled(0)
    if not read_checksummed(text, out: mut bytes.view_mut()) or bytes[0] != 0x01 {
        return None
    }
    return Some(HashText.Full(HashValue(bytes: bytes)))
} HashText.parse

/// Whether this text names `hash`.
pub fn HashText.names(self, hash: HashValue) -> bool {
    return match self {
        HashText.Full(full) => full == hash
        HashText.Short(head) => head == hash.head()
    }
} HashText.names

/// This signature's text: the checksummed base32 of its 64 bytes.
pub fn Signature.to_text(self) -> text::Fixed[105] {
    var form = text::Fixed[105].empty()
    write_checksummed(self.bytes.view(), out: mut form)
    return form
} Signature.to_text

/// The signature a text writes, `None` for any other text.
pub fn Signature.parse(text: Str) -> Option[Signature] {
    var bytes = Array[u8, 64].filled(0)
    if not read_checksummed(text, out: mut bytes.view_mut()) {
        return None
    }
    return Some(Signature(bytes: bytes))
} Signature.parse

/// The text of an Ed25519 public key: the checksummed base32 of its 32 bytes.
pub fn key_text(key: Array[u8, 32]) -> text::Fixed[54] {
    var form = text::Fixed[54].empty()
    write_checksummed(key.view(), out: mut form)
    return form
} key_text

/// The public key a text writes, `None` for any other text.
pub fn parse_key(text: Str) -> Option[Array[u8, 32]] {
    var key = Array[u8, 32].filled(0)
    if not read_checksummed(text, out: mut key.view_mut()) {
        return None
    }
    return Some(key)
} parse_key

/// The bytes a short form writes: the tag and the first 9 bytes of the digest.
fn HashValue.head(self) -> Array[u8, 10] {
    var head = Array[u8, 10].filled(0)
    for i in 0..<10usize {
        head[i] = self.bytes[i]
    }
    return head
} HashValue.head

fn write_checksummed[N: usize where N > 0](bytes: Slice[u8], mut out: text::Fixed[N]) {
    var pending: u32 = 0
    var bits: u32 = 0
    for byte in bytes {
        pending = (pending << 8) | u32.widen(byte)
        bits += 8
        while bits >= 5 {
            bits -= 5
            push_digit((pending >> bits) & 31, mut out)
        }
        pending = pending & ((1u32 << bits) - 1)
    }
    if bits > 0 {
        push_digit((pending << (5 - bits)) & 31, mut out)
    }
    let check = checksum(bytes)
    push_digit(check >> 5, mut out)
    push_digit(check & 31, mut out)
} write_checksummed

/// Fills `out` from a checksummed base32 text of exactly its length, reporting whether the text was one.
fn read_checksummed(text: Str, mut out: SliceMut[u8]) -> bool {
    let chars = text.as_bytes()
    let data = (out.len() * 8 + 4) / 5
    if chars.len() != data + 2 {
        return false
    }
    var pending: u32 = 0
    var bits: u32 = 0
    var filled: usize = 0
    for i in 0..<data {
        let Some(value) = digit_value(chars[i]) else {
            return false
        }
        pending = (pending << 5) | value
        bits += 5
        if bits >= 8 {
            bits -= 8
            out[filled] = u8.truncate(pending >> bits)
            filled += 1
            pending = pending & ((1u32 << bits) - 1)
        }
    }
    let Some(high) = digit_value(chars[data]) else {
        return false
    }
    let Some(low) = digit_value(chars[data + 1]) else {
        return false
    }
    return pending == 0 and filled == out.len() and checksum(out.view()) == ((high << 5) | low)
} read_checksummed

/// The first 10 bits of the BLAKE3-256 digest of `bytes`.
fn checksum(bytes: Slice[u8]) -> u32 {
    var digest = Blake3.empty()
    mut digest.update(bytes)
    let sum = digest.finish()
    return (u32.widen(sum[0]) << 2) | u32.widen(sum[1] >> 6)
} checksum

fn push_digit[N: usize where N > 0](value: u32, mut out: text::Fixed[N])
    requires value < 32
{
    mut out.push(char.checked_from_bits(u32.widen(ALPHABET[usize.widen(value)])).value_or('a'))
} push_digit

fn digit_value(symbol: u8) -> Option[u32] {
    if symbol >= b'a' and symbol <= b'z' {
        return Some(u32.widen(symbol - b'a'))
    }
    if symbol >= b'2' and symbol <= b'7' {
        return Some(u32.widen(symbol - b'2') + 26)
    }
    return None
} digit_value

test forms_round_trip for HashValue.full_form {
    let hash = HashValue.of_content(b"abc")
    let full = hash.full_form()
    let short = hash.short_form()
    expect full.byte_len() == 55
    expect short.byte_len() == 18
    expect full.starts_with("a")
    expect HashText.parse(full.as_str()) == Some(HashText.Full(hash))
    let Some(named) = HashText.parse(short.as_str()) else {
        expect false
        return
    }
    expect named.names(hash)
    expect not named.names(HashValue.of_content(b"abd"))
} forms_round_trip

test damaged_forms_are_rejected for HashText.parse {
    let full = HashValue.of_content(b"abc").full_form()
    expect HashText.parse("") == None
    expect HashText.parse("aaaaaaaaaaaaaaaaaa") == None
    let Some(tail) = full.slice_bytes(1, end: 55) else {
        expect false
        return
    }
    var changed = text::Fixed[55].of("b")
    mut changed.append(tail)
    expect HashText.parse(changed.as_str()) == None
} damaged_forms_are_rejected

test seeds_decode_with_their_checksum for read_checksummed {
    var seed = Array[u8, 8].filled(0)
    let decoded = read_checksummed("yzbpxx7c6ar46db", out: mut seed.view_mut())
    expect decoded
    let misspelt = read_checksummed("yzbpxx7c6ar46dc", out: mut seed.view_mut())
    expect not misspelt
    let truncated = read_checksummed("yzbpxx7c6ar46d", out: mut seed.view_mut())
    expect not truncated
} seeds_decode_with_their_checksum

test signatures_and_keys_round_trip for Signature.to_text {
    let key = core::crypto::SecretKey.of_seed(Array[u8, 32].filled(3))
    let public = key.public_key().bytes
    let signature = Signature(bytes: key.sign(b"x").bytes)
    let text = signature.to_text()
    expect text.byte_len() == 105
    expect Signature.parse(text.as_str()) == Some(signature)
    let written = key_text(public)
    expect written.byte_len() == 54
    expect parse_key(written.as_str()) == Some(public)
} signatures_and_keys_round_trip
