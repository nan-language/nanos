//! Text forms of identifiers, and the bit layout of causes.

const CAUSE_NUMBERS: u64 = 0x800_0000_0000

const CAUSE_BOOTS: u64 = 0x10_0000

/// The cause of number `number`, below 2^43, in the boot of counter `boot`, which the cause keeps modulo 2^20.
pub fn Cause.of(boot: u64, number: u64) -> Cause
    requires number < CAUSE_NUMBERS
{
    return Cause(bits: (boot % CAUSE_BOOTS) * CAUSE_NUMBERS + number)
} Cause.of

/// The boot counter modulo 2^20 of the boot this cause was assigned in.
pub fn Cause.boot(self) -> u64 = self.bits / CAUSE_NUMBERS

/// This cause's number within its boot.
pub fn Cause.number(self) -> u64 = self.bits % CAUSE_NUMBERS

/// The cause assigned after this one in its boot, the number wrapping from 2^43 − 1 to 1.
pub fn Cause.next(self) -> Cause {
    let number = self.number() + 1
    if number == CAUSE_NUMBERS {
        return Cause.of(self.boot(), number: 1)
    }
    return Cause.of(self.boot(), number)
} Cause.next

/// `#<n>`.
pub fn CommitId.to_text(self) -> text::Fixed[21] {
    var form = text::Fixed[21].of("#")
    push_number(self.number, out: mut form)
    return form
} CommitId.to_text

pub fn CommitId.parse(text: Str) -> Option[CommitId] {
    let Some(number) = prefixed_number(text, prefix: b'#') else {
        return None
    }
    return Some(CommitId(number: number))
} CommitId.parse

/// `c<b>.<n>`.
pub fn Cause.to_text(self) -> text::Fixed[22] {
    var form = text::Fixed[22].of("c")
    push_number(self.boot(), out: mut form)
    mut form.push('.')
    push_number(self.number(), out: mut form)
    return form
} Cause.to_text

pub fn Cause.parse(text: Str) -> Option[Cause] {
    let Some(pair) = prefixed_pair(text, prefix: b'c') else {
        return None
    }
    if pair.left >= CAUSE_BOOTS or pair.right >= CAUSE_NUMBERS {
        return None
    }
    return Some(Cause.of(pair.left, number: pair.right))
} Cause.parse

/// `a<n>`.
pub fn ApprovalId.to_text(self) -> text::Fixed[21] {
    var form = text::Fixed[21].of("a")
    push_number(self.number, out: mut form)
    return form
} ApprovalId.to_text

pub fn ApprovalId.parse(text: Str) -> Option[ApprovalId] {
    let Some(number) = prefixed_number(text, prefix: b'a') else {
        return None
    }
    return Some(ApprovalId(number: number))
} ApprovalId.parse

/// `e<n>`.
pub fn Cursor.to_text(self) -> text::Fixed[21] {
    var form = text::Fixed[21].of("e")
    push_number(self.seq, out: mut form)
    return form
} Cursor.to_text

pub fn Cursor.parse(text: Str) -> Option[Cursor] {
    let Some(seq) = prefixed_number(text, prefix: b'e') else {
        return None
    }
    return Some(Cursor(seq: seq))
} Cursor.parse

/// `s<n>` for a session of the boot of counter `current_boot`, else `s<b>.<n>`.
pub fn SessionId.to_text(self, current_boot: u64) -> text::Fixed[42] {
    var form = text::Fixed[42].of("s")
    if self.boot != current_boot {
        push_number(self.boot, out: mut form)
        mut form.push('.')
    }
    push_number(self.number, out: mut form)
    return form
} SessionId.to_text

/// The session `s<b>.<n>` names, or the session `s<n>` names in the boot of counter `current_boot`.
pub fn SessionId.parse(text: Str, current_boot: u64) -> Option[SessionId] {
    let Some(number) = prefixed_number(text, prefix: b's') else {
        let Some(pair) = prefixed_pair(text, prefix: b's') else {
            return None
        }
        return Some(SessionId(boot: pair.left, number: pair.right))
    }
    return Some(SessionId(boot: current_boot, number: number))
} SessionId.parse

/// `f<n>`, the text of the fault whose record has sequence number `fault` in `/journal/faults`.
pub fn fault_text(fault: u64) -> text::Fixed[21] {
    var form = text::Fixed[21].of("f")
    push_number(fault, out: mut form)
    return form
} fault_text

pub fn parse_fault(text: Str) -> Option[u64] {
    return prefixed_number(text, prefix: b'f')
} parse_fault

/// Two numbers joined by `.`.
struct Pair derives Copy {
    left: u64
    right: u64
} Pair

fn prefixed_number(text: Str, prefix: u8) -> Option[u64] {
    let Some(parts) = text.as_bytes().split_at(1) else {
        return None
    }
    if parts.head[0] != prefix {
        return None
    }
    return parse_number(parts.tail)
} prefixed_number

fn prefixed_pair(text: Str, prefix: u8) -> Option[Pair] {
    let Some(parts) = text.as_bytes().split_at(1) else {
        return None
    }
    if parts.head[0] != prefix {
        return None
    }
    let Some(dot) = position(parts.tail, of: b'.') else {
        return None
    }
    let Some(halves) = parts.tail.split_at(dot) else {
        return None
    }
    let Some(right) = halves.tail.split_at(1) else {
        return None
    }
    let Some(left) = parse_number(halves.head) else {
        return None
    }
    let Some(number) = parse_number(right.tail) else {
        return None
    }
    return Some(Pair(left: left, right: number))
} prefixed_pair

/// A NUMBER: `0`, or digits without a leading zero, of a value below 2^64.
pkg fn parse_number(digits: Slice[u8]) -> Option[u64] {
    if digits.is_empty() or (digits[0] == b'0' and digits.len() > 1) {
        return None
    }
    var value: u64 = 0
    for digit in digits {
        if digit < b'0' or digit > b'9' {
            return None
        }
        let Some(scaled) = value.checked_mul(10) else {
            return None
        }
        let Some(next) = scaled.checked_add(u64.widen(digit - b'0')) else {
            return None
        }
        value = next
    }
    return Some(value)
} parse_number

pkg fn push_number[N: usize where N > 0](value: u64, mut out: text::Fixed[N]) {
    var digits = Array[u8, 20].filled(0)
    var count: usize = 0
    var rest = value
    loop {
        digits[count] = u8.truncate(rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 {
            break
        }
    }
    while count > 0 {
        count -= 1
        mut out.push(char.checked_from_bits(0x30 + u32.widen(digits[count])).value_or('0'))
    }
} push_number

fn position(bytes: Slice[u8], of: u8) -> Option[usize] {
    for i in 0..<bytes.len() {
        if bytes[i] == of {
            return Some(i)
        }
    }
    return None
} position

test causes_keep_boot_and_number for Cause.of {
    let cause = Cause.of(0x10_0003, number: 12)
    expect cause.boot() == 3
    expect cause.number() == 12
    expect cause.to_text().as_str() == "c3.12"
    expect Cause.parse("c3.12") == Some(cause)
    expect Cause.of(3, number: CAUSE_NUMBERS - 1).next() == Cause.of(3, number: 1)
    expect Cause.parse("c1048576.1") == None
    expect Cause.parse("c3.08796093022208") == None
} causes_keep_boot_and_number

test identifiers_round_trip for CommitId.to_text {
    expect CommitId(number: 1).to_text().as_str() == "#1"
    expect CommitId.parse("#18446744073709551615") == Some(CommitId(number: 18_446_744_073_709_551_615))
    expect CommitId.parse("#18446744073709551616") == None
    expect CommitId.parse("#01") == None
    expect CommitId.parse("#") == None
    expect ApprovalId.parse(ApprovalId(number: 0).to_text().as_str()) == Some(ApprovalId(number: 0))
    expect Cursor.parse("e42") == Some(Cursor(seq: 42))
    expect Cursor.parse("a42") == None
    expect fault_text(7).as_str() == "f7"
    expect parse_fault("f7") == Some(7)
} identifiers_round_trip

test sessions_name_their_boot for SessionId.to_text {
    let session = SessionId(boot: 4, number: 2)
    expect session.to_text(4).as_str() == "s2"
    expect session.to_text(5).as_str() == "s4.2"
    expect SessionId.parse("s2", current_boot: 4) == Some(session)
    expect SessionId.parse("s4.2", current_boot: 9) == Some(session)
    expect SessionId.parse("s4.", current_boot: 9) == None
    expect SessionId.parse("s.2", current_boot: 9) == None
} sessions_name_their_boot
