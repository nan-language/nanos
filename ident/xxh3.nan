//! XXH3-128 with seed 0 and the default secret.

const SECRET: Slice[u8] = b"\xb8\xfe\x6c\x39\x23\xa4\x4b\xbe\x7c\x01\x81\x2c\xf7\x21\xad\x1c\xde\xd4\x6d\xe9\x83\x90\x97\xdb\x72\x40\xa4\xa4\xb7\xb3\x67\x1f\xcb\x79\xe6\x4e\xcc\xc0\xe5\x78\x82\x5a\xd0\x7d\xcc\xff\x72\x21\xb8\x08\x46\x74\xf7\x43\x24\x8e\xe0\x35\x90\xe6\x81\x3a\x26\x4c\x3c\x28\x52\xbb\x91\xc3\x00\xcb\x88\xd0\x65\x8b\x1b\x53\x2e\xa3\x71\x64\x48\x97\xa2\x0d\xf9\x4e\x38\x19\xef\x46\xa9\xde\xac\xd8\xa8\xfa\x76\x3f\xe3\x9c\x34\x3f\xf9\xdc\xbb\xc7\xc7\x0b\x4f\x1d\x8a\x51\xe0\x4b\xcd\xb4\x59\x31\xc8\x9f\x7e\xc9\xd9\x78\x73\x64\xea\xc5\xac\x83\x34\xd3\xeb\xc3\xc5\x81\xa0\xff\xfa\x13\x63\xeb\x17\x0d\xdd\x51\xb7\xf0\xda\x49\xd3\x16\x55\x26\x29\xd4\x68\x9e\x2b\x16\xbe\x58\x7d\x47\xa1\xfc\x8f\xf8\xb8\xd1\x7a\xd0\x31\xce\x45\xcb\x3a\x8f\x95\x16\x04\x28\xaf\xd7\xfb\xca\xbb\x4b\x40\x7e"

const PRIME32_1: u64 = 0x9E37_79B1

const PRIME32_2: u64 = 0x85EB_CA77

const PRIME32_3: u64 = 0xC2B2_AE3D

const PRIME64_1: u64 = 0x9E37_79B1_85EB_CA87

const PRIME64_2: u64 = 0xC2B2_AE3D_27D4_EB4F

const PRIME64_3: u64 = 0x1656_67B1_9E37_79F9

const PRIME64_4: u64 = 0x85EB_CA77_C2B2_AE63

const PRIME64_5: u64 = 0x27D4_EB2F_1656_67C5

const MIX_PRIME: u64 = 0x1656_6791_9E37_79F9

const SHORT_PRIME: u64 = 0x9FB2_1C65_1E98_DF25

const STRIPE_BYTES: usize = 64

const STRIPES_PER_LONG_BLOCK: usize = 16

const LONG_BLOCK_BYTES: usize = 1_024

/// A 128-bit hash, as its low and high 64 bits.
pub closed struct Hash128 derives Copy, Eq {
    pub low: u64
    pub high: u64
} Hash128

/// The XXH3-128 hash of `input`.
pub fn xxh3_128(input: Slice[u8]) -> Hash128 {
    let len = input.len()
    if len == 0 {
        return Hash128(low: fold_xxh64(SECRET.u64_le(64) ^ SECRET.u64_le(72)), high: fold_xxh64(SECRET.u64_le(80) ^ SECRET.u64_le(88)))
    }
    if len <= 3 {
        return hash_tiny(input)
    }
    if len <= 8 {
        return hash_small(input)
    }
    if len <= 16 {
        return hash_short(input)
    }
    if len <= 128 {
        return hash_medium(input)
    }
    if len <= 240 {
        return hash_midsize(input)
    }
    return hash_long(input)
} xxh3_128

/// The 16 bytes of `hash`: its low 64 bits, then its high 64 bits, each little-endian.
pub fn Hash128.to_bytes(self) -> Array[u8, 16] {
    var bytes = Array[u8, 16].filled(0)
    mut bytes.view_mut().write_u64_le(0, value: self.low)
    mut bytes.view_mut().write_u64_le(8, value: self.high)
    return bytes
} Hash128.to_bytes

fn hash_tiny(input: Slice[u8]) -> Hash128
    requires input.len() >= 1 and input.len() <= 3
{
    let len = input.len()
    let combined = (u32.widen(input[0]) << 16) | (u32.widen(input[len >> 1]) << 24) | u32.widen(input[len - 1]) | (u32.truncate(len) << 8)
    let swapped = rotl32(swap32(combined), by: 13)
    let low_flip = u64.widen(SECRET.u32_le(0) ^ SECRET.u32_le(4))
    let high_flip = u64.widen(SECRET.u32_le(8) ^ SECRET.u32_le(12))
    return Hash128(low: fold_xxh64(u64.widen(combined) ^ low_flip), high: fold_xxh64(u64.widen(swapped) ^ high_flip))
} hash_tiny

fn hash_small(input: Slice[u8]) -> Hash128
    requires input.len() >= 4 and input.len() <= 8
{
    let len = input.len()
    let joined = u64.widen(input.u32_le(0)) + (u64.widen(input.u32_le(len - 4)) << 32)
    let keyed = joined ^ (SECRET.u64_le(16) ^ SECRET.u64_le(24))
    let product = keyed.wide_mul(PRIME64_1 + (u64.widen(len) << 2))
    let high = product.high.wrapping_add(product.low << 1)
    let low = product.low ^ (high >> 3)
    let mixed = xorshift(xorshift(low, by: 35).wrapping_mul(SHORT_PRIME), by: 28)
    return Hash128(low: mixed, high: avalanche(high))
} hash_small

fn hash_short(input: Slice[u8]) -> Hash128
    requires input.len() >= 9 and input.len() <= 16
{
    let len = input.len()
    let low_flip = SECRET.u64_le(32) ^ SECRET.u64_le(40)
    let high_flip = SECRET.u64_le(48) ^ SECRET.u64_le(56)
    let head = input.u64_le(0)
    let last = input.u64_le(len - 8)
    let product = (head ^ last ^ low_flip).wide_mul(PRIME64_1)
    let low = product.low.wrapping_add(u64.widen(len - 1) << 54)
    let flipped = last ^ high_flip
    let high = product.high.wrapping_add(flipped).wrapping_add((flipped & 0xFFFF_FFFF).wrapping_mul(PRIME32_2 - 1))
    let folded = low ^ swap64(high)
    let result = folded.wide_mul(PRIME64_2)
    return Hash128(low: avalanche(result.low), high: avalanche(result.high.wrapping_add(high.wrapping_mul(PRIME64_2))))
} hash_short

fn hash_medium(input: Slice[u8]) -> Hash128
    requires input.len() >= 17 and input.len() <= 128
{
    let len = input.len()
    var acc = Hash128(low: u64.widen(len).wrapping_mul(PRIME64_1), high: 0)
    if len > 96 {
        acc = mix32(acc, input, lead: 48, trail: len - 64, key_at: 96)
    }
    if len > 64 {
        acc = mix32(acc, input, lead: 32, trail: len - 48, key_at: 64)
    }
    if len > 32 {
        acc = mix32(acc, input, lead: 16, trail: len - 32, key_at: 32)
    }
    acc = mix32(acc, input, lead: 0, trail: len - 16, key_at: 0)
    return finish(acc, len)
} hash_medium

fn hash_midsize(input: Slice[u8]) -> Hash128
    requires input.len() >= 129 and input.len() <= 240
{
    let len = input.len()
    var acc = Hash128(low: u64.widen(len).wrapping_mul(PRIME64_1), high: 0)
    for step in 0..<4usize {
        acc = mix32(acc, input, lead: 32 * step, trail: 32 * step + 16, key_at: 32 * step)
    }
    acc = Hash128(low: avalanche(acc.low), high: avalanche(acc.high))
    for step in 4..<(len / 32) {
        acc = mix32(acc, input, lead: 32 * step, trail: 32 * step + 16, key_at: 3 + 32 * (step - 4))
    }
    acc = mix32(acc, input, lead: len - 16, trail: len - 32, key_at: 103)
    return finish(acc, len)
} hash_midsize

fn hash_long(input: Slice[u8]) -> Hash128
    requires input.len() > 240
{
    var lanes = initial_lanes()
    let blocks = (input.len() - 1) / LONG_BLOCK_BYTES
    for block in 0..<blocks {
        for stripe in 0..<STRIPES_PER_LONG_BLOCK {
            accumulate(mut lanes, input, at: block * LONG_BLOCK_BYTES + stripe * STRIPE_BYTES, key_at: stripe * 8)
        }
        scramble(mut lanes)
    }
    let stripes = (input.len() - 1 - blocks * LONG_BLOCK_BYTES) / STRIPE_BYTES
    for stripe in 0..<stripes {
        accumulate(mut lanes, input, at: blocks * LONG_BLOCK_BYTES + stripe * STRIPE_BYTES, key_at: stripe * 8)
    }
    accumulate(mut lanes, input, at: input.len() - STRIPE_BYTES, key_at: SECRET.len() - STRIPE_BYTES - 7)
    let len = u64.widen(input.len())
    return Hash128(
        low: merge(lanes, key_at: 11, start: len.wrapping_mul(PRIME64_1)),
        high: merge(lanes, key_at: SECRET.len() - STRIPE_BYTES - 11, start: ~(len.wrapping_mul(PRIME64_2))),
    )
} hash_long

fn mix32(
    acc: Hash128,
    input: Slice[u8],
    lead: usize,
    trail: usize,
    key_at: usize,
    ) -> Hash128 {
    let low = acc.low.wrapping_add(mix16(input, at: lead, key_at)) ^ input.u64_le(trail).wrapping_add(input.u64_le(trail + 8))
    let high = acc.high.wrapping_add(mix16(input, at: trail, key_at: key_at + 16)) ^ input.u64_le(lead).wrapping_add(input.u64_le(lead + 8))
    return Hash128(low: low, high: high)
} mix32

fn mix16(input: Slice[u8], at: usize, key_at: usize) -> u64 {
    let product = (input.u64_le(at) ^ SECRET.u64_le(key_at)).wide_mul(input.u64_le(at + 8) ^ SECRET.u64_le(key_at + 8))
    return product.low ^ product.high
} mix16

fn finish(acc: Hash128, len: usize) -> Hash128 {
    let low = acc.low.wrapping_add(acc.high)
    let high = acc.low.wrapping_mul(PRIME64_1).wrapping_add(acc.high.wrapping_mul(PRIME64_4)).wrapping_add(u64.widen(len).wrapping_mul(PRIME64_2))
    return Hash128(low: avalanche(low), high: 0u64.wrapping_sub(avalanche(high)))
} finish

fn accumulate(mut lanes: Array[u64, 8], input: Slice[u8], at: usize, key_at: usize) {
    for lane in 0..<8usize {
        let value = input.u64_le(at + 8 * lane)
        let keyed = value ^ SECRET.u64_le(key_at + 8 * lane)
        lanes[lane ^ 1] = lanes[lane ^ 1].wrapping_add(value)
        lanes[lane] = lanes[lane].wrapping_add((keyed & 0xFFFF_FFFF).wrapping_mul(keyed >> 32))
    }
} accumulate

fn scramble(mut lanes: Array[u64, 8]) {
    for lane in 0..<8usize {
        let key = SECRET.u64_le(SECRET.len() - STRIPE_BYTES + 8 * lane)
        lanes[lane] = (lanes[lane] ^ (lanes[lane] >> 47) ^ key).wrapping_mul(PRIME32_1)
    }
} scramble

fn merge(lanes: Array[u64, 8], key_at: usize, start: u64) -> u64 {
    var result = start
    for pair in 0..<4usize {
        let left = lanes[2 * pair] ^ SECRET.u64_le(key_at + 16 * pair)
        let right = lanes[2 * pair + 1] ^ SECRET.u64_le(key_at + 16 * pair + 8)
        let product = left.wide_mul(right)
        result = result.wrapping_add(product.low ^ product.high)
    }
    return avalanche(result)
} merge

fn initial_lanes() -> Array[u64, 8] {
    var lanes = Array[u64, 8].filled(PRIME32_3)
    lanes[1] = PRIME64_1
    lanes[2] = PRIME64_2
    lanes[3] = PRIME64_3
    lanes[4] = PRIME64_4
    lanes[5] = PRIME32_2
    lanes[6] = PRIME64_5
    lanes[7] = PRIME32_1
    return lanes
} initial_lanes

fn avalanche(value: u64) -> u64 {
    let mixed = xorshift(value, by: 37).wrapping_mul(MIX_PRIME)
    return xorshift(mixed, by: 32)
} avalanche

fn fold_xxh64(value: u64) -> u64 {
    let once = xorshift(value, by: 33).wrapping_mul(PRIME64_2)
    let twice = xorshift(once, by: 29).wrapping_mul(PRIME64_3)
    return xorshift(twice, by: 32)
} fold_xxh64

fn xorshift(value: u64, by: u32) -> u64
    requires by < 64
{
    return value ^ (value >> by)
} xorshift

fn rotl32(value: u32, by: u32) -> u32
    requires by > 0 and by < 32
{
    return (value << by) | (value >> (32 - by))
} rotl32

fn swap32(value: u32) -> u32 {
    return ((value & 0xFF) << 24) | ((value & 0xFF00) << 8) | ((value >> 8) & 0xFF00) | (value >> 24)
} swap32

fn swap64(value: u64) -> u64 {
    return (u64.widen(swap32(u32.truncate(value))) << 32) | u64.widen(swap32(u32.truncate(value >> 32)))
} swap64

fn hash_of_pattern(len: usize, alloc: mem::Alloc) -> Hash128 {
    var input = mem::Bytes.zeroed(len, alloc)
    for i in 0..<len {
        input[i] = u8.truncate(i % 251)
    }
    return xxh3_128(input.view())
} hash_of_pattern

test inputs_of_every_length_hash_as_xxh3_128 for xxh3_128 {
    let alloc = testing::world().alloc
    let len_0 = hash_of_pattern(0, alloc)
    expect len_0 == Hash128(low: 0x6001_C324_468D_497F, high: 0x99AA_06D3_0147_98D8)
    let len_1 = hash_of_pattern(1, alloc)
    expect len_1 == Hash128(low: 0xC44B_DFF4_074E_ECDB, high: 0xA6CD_5E93_9200_0F6A)
    let len_3 = hash_of_pattern(3, alloc)
    expect len_3 == Hash128(low: 0x5F42_99FC_161C_9CBB, high: 0xE3B5_5F57_945A_17CF)
    let len_4 = hash_of_pattern(4, alloc)
    expect len_4 == Hash128(low: 0xA611_1D53_E80A_3DB5, high: 0xEB70_BF5F_C779_E9E6)
    let len_8 = hash_of_pattern(8, alloc)
    expect len_8 == Hash128(low: 0xCFD5_0C61_C8BB_98C1, high: 0xE1E4_432A_6221_7FE4)
    let len_9 = hash_of_pattern(9, alloc)
    expect len_9 == Hash128(low: 0x9079_3197_9DCA_3746, high: 0x16C7_69D8_3E4A_EBCE)
    let len_16 = hash_of_pattern(16, alloc)
    expect len_16 == Hash128(low: 0x8428_12CC_870D_CAE2, high: 0x7295_0631_8276_07E2)
    let len_17 = hash_of_pattern(17, alloc)
    expect len_17 == Hash128(low: 0xC06E_233D_F772_9217, high: 0x685B_C458_B37D_057F)
    let len_33 = hash_of_pattern(33, alloc)
    expect len_33 == Hash128(low: 0xE08D_8495_1339_DE86, high: 0x0217_5C3A_ABB0_0637)
    let len_65 = hash_of_pattern(65, alloc)
    expect len_65 == Hash128(low: 0x1AEE_64A1_615D_E88F, high: 0xEBED_F05E_EADC_28F1)
    let len_97 = hash_of_pattern(97, alloc)
    expect len_97 == Hash128(low: 0x5B32_84A6_1F91_E97D, high: 0x9B09_227E_063D_A5A2)
    let len_128 = hash_of_pattern(128, alloc)
    expect len_128 == Hash128(low: 0x0532_1A0B_64D6_7B41, high: 0x1479_2FC3_AF88_DC6C)
    let len_129 = hash_of_pattern(129, alloc)
    expect len_129 == Hash128(low: 0xBC30_B633_82B0_9A3B, high: 0xDD5E_74AC_6B45_F54E)
    let len_160 = hash_of_pattern(160, alloc)
    expect len_160 == Hash128(low: 0xC67F_CD13_C31B_09F4, high: 0x4E95_C1CD_6DC7_BB85)
    let len_240 = hash_of_pattern(240, alloc)
    expect len_240 == Hash128(low: 0xC92B_68E1_6F83_BBB6, high: 0x65B5_BE86_DA55_40E7)
    let len_241 = hash_of_pattern(241, alloc)
    expect len_241 == Hash128(low: 0x02E8_CD95_421C_6D02, high: 0x1DA1_CB61_BCB8_A2A1)
    let len_1024 = hash_of_pattern(1_024, alloc)
    expect len_1024 == Hash128(low: 0xE5D7_8BAF_A45B_2AA5, high: 0xD0AC_1F7B_93BF_57B9)
    let len_1025 = hash_of_pattern(1_025, alloc)
    expect len_1025 == Hash128(low: 0xE95C_4228_8F28_186E, high: 0x2882_EBCA_04EC_915C)
    let len_4080 = hash_of_pattern(4_080, alloc)
    expect len_4080 == Hash128(low: 0x03CE_EE8D_7CD5_4D79, high: 0xE400_B276_E354_CAF7)
} inputs_of_every_length_hash_as_xxh3_128
