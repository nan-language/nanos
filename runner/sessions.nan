//! Sessions' accounts: the account and the cell of each session `link` opens, the sessions of one principal drawing through one cell, draining one energy bucket, consuming together and sharing their weight on each CPU, the gauge of each session, and the CPU reservations of `Session` grants, on which the `latency` work of their sessions draws.

/// A principal with open sessions: the cell they draw through, the energy bucket they drain, and the group whose weight their accounts share, the number of its first session.
linear struct Principal {
    name: ident::Principal
    cell: mem::Budget
    bucket: task::Cown[Energy]
    group: u64
} Principal

/// An open session: its principal and the group of its principal's sessions, the number of the `Session` grant it opened under, none for the default share, its share, the number of its account's executor, what its work runs on, and where its gauge is read and its share and end told.
struct Session {
    principal: ident::Principal
    group: u64
    grant: Option[u64]
    share: os::Share
    executor: u64
    account: os::SessionAccount
    marks: task::Sender[Mark]
} Session

/// What the closed sessions of a principal consumed together.
struct Consumption {
    principal: ident::Principal
    consumed: os::Consumed
} Consumption

/// Carries out each order `orders` brings for the accounts of sessions and the reservations of `Session` grants, running the gauge of each open session on a task of `s`, until the orders end.
fn Shared.keep_sessions(self, take orders: task::Receiver[os::AccountOrder], s: task::Scope) fails task::Cancelled uses wait {
    let alloc = self.config.alloc
    var principals = mem::List[Principal].empty(alloc)
    defer close_principals(take principals)
    var sessions = mem::Map[u64, Session].empty(alloc)
    var consumption = mem::List[Consumption].empty(alloc)
    var granted = mem::Map[u64, Admitted].empty(alloc)
    var receiver = orders
    loop {
        let Some(order) = try await mut receiver.receive() else {
            return
        }
        match order {
            os::AccountOrder.Open(session: session, principal: principal, grant: grant, memory_bytes: memory_bytes, done: done) => {
                let given = match try await self.open_session(mut principals, mut sessions, granted, session, take principal, grant, memory_bytes, s) {
                    Some(account) => Some(os::OpenedAccount(account: account, consumed: try await self.consumed(session, sessions, consumption)))
                    None => None
                }
                discard attempt await done.send(given)
            }
            os::AccountOrder.Find(session: session, done: done) => {
                let found = match sessions.get(session) {
                    Some(kept) => Some(kept.account)
                    None => None
                }
                discard attempt await done.send(found)
            }
            os::AccountOrder.Close(session: session, done: done) => {
                try await self.close_session(mut principals, mut sessions, mut consumption, session)
                discard attempt await done.send(Unit)
            }
            os::AccountOrder.Reset(done: done) => {
                var open = mem::List[u64].empty(alloc)
                for kept in sessions {
                    mut open.push(kept.key())
                }
                for session in open {
                    try await self.close_session(mut principals, mut sessions, mut consumption, session)
                }
                mut consumption.truncate(0)
                discard attempt await done.send(Unit)
            }
            os::AccountOrder.Reserve(grants: grants, done: done) => {
                let held = try await self.reserve_grants(mut granted, grants)
                for kept in sessions {
                    let open = kept.value()
                    self.bind(open.executor, account: open.account.number, reservation: granted_reservation(granted, grant: open.grant), group: open.group)
                }
                discard attempt await done.send(take held)
            }
        }
    }
} Shared.keep_sessions

/// Holds in `granted`, by grant, the reservations of exactly `grants`: ends those of the grants left out or asking for another reservation and admits the others; the reservation each of `grants` holds.
fn Shared.reserve_grants(self, mut granted: mem::Map[u64, Admitted], grants: mem::List[os::SessionGrant]) -> mem::List[os::GrantReservation] fails task::Cancelled uses wait {
    let alloc = self.config.alloc
    var ended = mem::List[u64].empty(alloc)
    for held in granted {
        let kept = grants.position(fn(each: os::SessionGrant) => each.grant == held.key() and Reservation.of(each.share) == Some(held.value().reservation))
        if kept.is_none() {
            mut ended.push(held.key())
        }
    }
    for grant in ended {
        let Some(admitted) = mut granted.remove(grant) else {
            continue
        }
        try await self.release(admitted)
    }
    var holding = mem::List[os::GrantReservation].empty(alloc)
    for each in grants {
        let reservation = match try await self.grant_admitted(mut granted, each) {
            Some(admitted) => Some(os::CpuReservation(cpu: admitted.cpu, ppm: u32.fit(admitted.reservation.ppm)))
            None => None
        }
        mut holding.push(os::GrantReservation(grant: each.grant, reservation: reservation))
    }
    return holding
} Shared.reserve_grants

/// The reservation `each` holds in `granted`, admitted first when it holds none; `None` when it asks for none or fits on no CPU.
fn Shared.grant_admitted(self, mut granted: mem::Map[u64, Admitted], each: os::SessionGrant) -> Option[Admitted] fails task::Cancelled uses wait {
    match granted.get(each.grant) {
        Some(admitted) => return Some(admitted)
        None => {
        }
    }
    let Some(reservation) = Reservation.of(each.share) else {
        return None
    }
    let reservations = self.reservations.share()
    let Some(admitted) = await when mut reservations => mut reservations.admit(reservation) else {
        return None
    }
    self.run_reservation(admitted)
    discard mut granted.insert(each.grant, value: admitted)
    return Some(admitted)
} Shared.grant_admitted

/// The reservation `granted` holds for the grant numbered `grant`, none for `None`.
fn granted_reservation(granted: mem::Map[u64, Admitted], grant: Option[u64]) -> Option[Admitted] {
    let Some(number) = grant else {
        return None
    }
    return granted.get(number)
} granted_reservation

/// Opens the account of the session numbered `session` of `principal`, with the share of its `Session` grant `grant`, the default share when `None`, and its `latency` work drawing on the reservation `granted` holds for that grant, its cell split from its principal's, and its gauge on a task of `s`; gives the account of a session already open, under that grant from then on, and `None` when its principal has no cell.
fn Shared.open_session(
    self,
    mut principals: mem::List[Principal],
    mut sessions: mem::Map[u64, Session],
    granted: mem::Map[u64, Admitted],
    session: u64,
    take principal: ident::Principal,
    grant: Option[os::SessionGrant],
    memory_bytes: Option[u64],
    s: task::Scope,
    ) -> Option[os::SessionAccount] fails task::Cancelled uses wait {
    match mut sessions.remove(session) {
        Some(kept) => {
            let account = kept.account
            let regranted = try await self.regrant_session(mut principals, take kept, grant, granted)
            discard mut sessions.insert(session, value: take regranted)
            return Some(account)
        }
        None => {
        }
    }
    let share = share_of(grant)
    let Some(index) = try await self.principal_of(mut principals, principal: ident::Principal(text: principal.text), share, memory_bytes, opening: session) else {
        return None
    }
    let number = os::SESSION_ACCOUNTS | u32.truncate(session)
    try await self.gauges.open_folds(number)
    let cell = principals.at(index).cell.alloc().split(principals.at(index).cell.limit())
    let account = self.config.exec.split_on(self.config.share(share), alloc: cell.alloc())
    let executor = account.id()
    let group = principals.at(index).group
    let numbered = number_of(grant)
    self.bind(executor, account: number, reservation: granted_reservation(granted, grant: numbered), group)
    let given = os::SessionAccount(exec: account.executor(), alloc: cell.alloc(), number: number)
    let task::Channel(sender: marks, receiver: marked) = task::Channel[Mark].bounded(1, alloc: self.config.alloc)
    let bucket = principals.at(index).bucket.share()
    let busy_mw = self.machine.busy_mw()
    let clock = self.config.clock
    let shares = self.config.shares(share)
    let charging = Charging(gauges: self.gauges.share(), account: number)
    discard s.spawn(fn[take marked, take account, take cell, take bucket, take busy_mw, take charging]() fails task::Cancelled uses wait limits stack 8_192 {
        try await gauge_session(take marked, take account, take cell, bucket, shares, busy_mw, clock, charging)
    })
    try await self.gauges.watch(session_name(session).as_str(), watch: marks.split(), alloc: self.config.alloc)
    discard mut sessions.insert(session, value: Session(principal: take principal, group: group, grant: numbered, share: share, executor: executor, account: given, marks: take marks))
    return Some(given)
} Shared.open_session

/// The share of the `Session` grant `grant`, the default share for `None`.
fn share_of(grant: Option[os::SessionGrant]) -> os::Share {
    return match grant {
        Some(held) => held.share
        None => os::Share.default()
    }
} share_of

/// The number of the `Session` grant `grant`.
fn number_of(grant: Option[os::SessionGrant]) -> Option[u64] {
    return match grant {
        Some(held) => Some(held.grant)
        None => None
    }
} number_of

/// The open session `kept` under its principal's `Session` grant `grant`: its `latency` work draws on the reservation `granted` holds for it, and when that grant gives another share, its gauge reshares its account and its principal's energy bucket takes the share's budget.
fn Shared.regrant_session(
    self,
    mut principals: mem::List[Principal],
    take kept: Session,
    grant: Option[os::SessionGrant],
    granted: mem::Map[u64, Admitted],
    ) -> Session fails task::Cancelled uses wait {
    var session = kept
    session.grant = number_of(grant)
    self.bind(session.executor, account: session.account.number, reservation: granted_reservation(granted, grant: session.grant), group: session.group)
    let share = share_of(grant)
    if session.share == share {
        return session
    }
    session.share = share
    discard attempt await session.marks.send(Mark.Reshare(shares: self.config.shares(share)))
    match principals.position(fn(each: Principal) => each.name == session.principal) {
        Some(at) => {
            let bucket = principals.at(at).bucket.share()
            await when mut bucket {
                mut bucket.rebudget(share.energy_mj_per_h)
            }
        }
        None => {
        }
    }
    return session
} Shared.regrant_session

/// The place in `principals` of `principal`, whose cell is split when it has none, of `memory_bytes`, or of its pool's size when `None`, from the pool the machine names, whose energy bucket then holds `share`'s budget, and whose group is then numbered after its session `opening`; `None` while every pool is at its top pressure level.
fn Shared.principal_of(
    self,
    mut principals: mem::List[Principal],
    take principal: ident::Principal,
    share: os::Share,
    memory_bytes: Option[u64],
    opening: u64,
    ) -> Option[usize] fails task::Cancelled uses wait {
    for index in 0..<principals.len() {
        if principals.at(index).name == principal {
            return Some(index)
        }
    }
    let Some(pooled) = try await self.machine.pool() else {
        return None
    }
    let cell = pooled.alloc.split(usize.widen(memory_bytes.value_or(pooled.bytes)))
    let bucket = task::Cown.of(Energy.of(budget_mj_per_h: share.energy_mj_per_h, now_ns: now(self.config.clock)), alloc: self.config.alloc)
    mut principals.push(Principal(name: take principal, cell: take cell, bucket: take bucket, group: opening))
    return Some(principals.len() - 1)
} Shared.principal_of

/// What the sessions of the principal of the open session numbered `session` consumed together: what `consumption` holds of its closed sessions with what the gauges of its open ones read.
fn Shared.consumed(self, session: u64, sessions: mem::Map[u64, Session], consumption: mem::List[Consumption]) -> os::Consumed fails task::Cancelled uses wait {
    var consumed = os::Consumed(cpu_ns: 0, energy_mj: 0)
    let Some(kept) = sessions.get(session) else {
        return consumed
    }
    match consumption.position(fn(each: Consumption) => each.principal == kept.principal) {
        Some(at) => {
            consumed = consumption[at].consumed
        }
        None => {
        }
    }
    for open in sessions {
        if open.value().principal != kept.principal {
            continue
        }
        match try await self.gauges.read(session_name(open.key()).as_str(), alloc: self.config.alloc) {
            Some(gauge) => {
                consumed = consumed_with(consumed, gauge)
            }
            None => {
            }
        }
    }
    return consumed
} Shared.consumed

/// `consumed` with the CPU time and the energy `gauge` reads.
fn consumed_with(consumed: os::Consumed, gauge: os::Gauge) -> os::Consumed {
    return os::Consumed(cpu_ns: consumed.cpu_ns.saturating_add(gauge.cpu_ns), energy_mj: consumed.energy_mj.saturating_add(gauge.energy_mj))
} consumed_with

/// Closes the account of the session numbered `session`, adding what it consumed to what `consumption` holds of its principal, and its principal's cell when no other session of its principal is open.
fn Shared.close_session(
    self,
    mut principals: mem::List[Principal],
    mut sessions: mem::Map[u64, Session],
    mut consumption: mem::List[Consumption],
    session: u64,
    ) fails task::Cancelled uses wait {
    let Some(closed) = mut sessions.remove(session) else {
        return
    }
    let name = session_name(session)
    let last = try await self.gauges.read(name.as_str(), alloc: self.config.alloc)
    self.machine.unbind(closed.executor)
    try await self.gauges.unwatch(name.as_str(), alloc: self.config.alloc)
    try await self.gauges.end_folds(closed.account.number)
    match last {
        Some(gauge) => {
            match consumption.position(fn(each: Consumption) => each.principal == closed.principal) {
                Some(at) => {
                    consumption[at].consumed = consumed_with(consumption[at].consumed, gauge)
                }
                None => mut consumption.push(Consumption(principal: ident::Principal(text: closed.principal.text), consumed: consumed_with(os::Consumed(cpu_ns: 0, energy_mj: 0), gauge)))
            }
        }
        None => {
        }
    }
    for open in sessions {
        if open.value().principal == closed.principal {
            return
        }
    }
    for index in 0..<principals.len() {
        if principals.at(index).name == closed.principal {
            let Principal(name: _, cell: cell, bucket: _, group: _) = mut principals.remove(index)
            take cell.close()
            return
        }
    }
} Shared.close_session

/// Answers each reading of a session's gauge from `marks` with the counters of its `account`, with the handler calls of its messages and the transfers that `charging` folded into it, and of its `cell`, charging the CPU time it ran since the last reading to its own energy and to its principal's `bucket` at the power `busy_mw` holds, until the marks end; then closes the account and the cell. The account runs in its `shares`, those a change of its share gives from then on, its own share's while the bucket holds budget and the `background` one while it is spent.
fn gauge_session(
    take marks: task::Receiver[Mark],
    take account: task::Account,
    take cell: mem::Budget,
    bucket: task::Cown[Energy],
    shares: Shares,
    busy_mw: mem::Shared[core::atomic::AtomicU64],
    clock: sys::Clock,
    charging: Charging,
    ) fails task::Cancelled uses wait {
    defer take account.close()
    defer take cell.close()
    var receiver = marks
    var spent = Spent(energy: Energy.of(budget_mj_per_h: 0, now_ns: now(clock)), charged_ns: 0)
    var resharing = Resharing.of(shares)
    var throttled = false
    loop {
        let reply = match try await mut receiver.receive() {
            Some(Mark.Read(reply: reply)) => reply
            Some(Mark.Reshare(shares: next)) => {
                resharing.shares = next
                mut resharing.run(account, throttled)
                continue
            }
            Some(Mark.Began) or Some(Mark.Took(ns: _)) or Some(Mark.Charged(account: _, ns: _)) => continue
            Some(Mark.Ended) or None => return
        }
        let folded = try await charging.gauges.folded(charging.account)
        let used = account.used_ns().saturating_add(folded.ns)
        let ran = used.saturating_sub(spent.charged_ns)
        let power = busy_mw.contents().load()
        let at = now(clock)
        mut spent.charge(used_ns: used, busy_mw: power, now_ns: at)
        throttled = await when mut bucket => drained(mut bucket, cpu_ns: ran, busy_mw: power, now_ns: at)
        mut resharing.run(account, throttled)
        let gauge = os::Gauge(intake: 0, memory: os::Usage(charged: u64.widen(cell.charged()), limit: u64.widen(cell.limit()), peak: u64.widen(cell.peak())), reserved: false, executor: account.id(), cpu_ns: used, read_bytes: folded.read_bytes, written_bytes: folded.written_bytes, energy_mj: spent.energy.used_mj(), throttled: throttled, class: resharing.shares.class, bundle: ident::HashValue.zero(), incarnation: 0, messages: 0, latency: Array[u64, 32].filled(0), traps: 0)
        discard attempt await reply.send(gauge)
    }
} gauge_session

/// Charges `cpu_ns` at `busy_mw` at `now_ns` to the energy bucket `bucket`; whether it is throttled.
fn drained(mut bucket: Energy, cpu_ns: u64, busy_mw: u64, now_ns: u64) -> bool {
    mut bucket.charge(cpu_ns, busy_mw, now_ns)
    return bucket.throttled
} drained

/// The name of the account of the session numbered `session`: `s<n>`.
fn session_name(session: u64) -> text::Fixed[24] {
    var name = text::Fixed[24].of("s")
    mut name.write(Dyn[Render].view(session), budget: 22)
    return name
} session_name

/// Closes the cells of the principals left with open sessions.
fn close_principals(take principals: mem::List[Principal]) {
    for held in take principals {
        let Principal(name: _, cell: cell, bucket: _, group: _) = held
        take cell.close()
    }
} close_principals
