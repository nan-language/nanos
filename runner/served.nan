/// Hands the driver each reply and summary `replies` queues, as `signal` tells it they come, until cancelled.
fn hand_over(replies: mem::Shared[hw::SpinLock[mem::Bounded[Handed, QUEUED_REPLIES]]], signal: mem::Shared[hw::Signal[Unit]], reports: task::Sender[Input], incarnation: u64) fails task::Cancelled uses wait {
    loop {
        try await signal.contents().wait()
        loop {
            let next = hw::without_irqs(fn(t: hw::IrqsDisabled) -> Option[Handed] limits notrap {
                return replies.contents().with(t, body: fn(mut queue: mem::Bounded[Handed, QUEUED_REPLIES]) -> Option[Handed] limits notrap, terminates, noalloc {
                    return mut queue.pop()
                })
            })
            let Some(handed) = next else {
                break
            }
            let report = match handed {
                Handed.Reply(request: request, reply: reply) => Report.Answered(id: request, answer: os::Answer.Replied(take reply))
                Handed.Summary(bytes: bytes) => Report.Published(summary: take bytes)
            }
            try await tell(reports, incarnation, take report)
        }
    }
} hand_over
