//! The task of an instance's domain: it builds the Env, starts or restores the component, serves the calls its driver delivers, one at a time, keeps its checkpoints, and hands its driver the replies the component gives postponed requests.

/// What an instance's driver gives the task of its domain: the calls it delivers, where the domain reports what it takes and answers and when its handlers run, the abandoner of the domain, the time without a message after which the component is suspended, never when 0, for a checkpointed instance how its checkpoints are kept and the checkpoint it restores, which its hibernation image gives a revival, the instance's configuration record, and for a fork what it runs and where it tells what it saw.
pub open struct Serving {
    deliveries: task::Receiver[Delivery]
    reports: task::Sender[Input]
    marks: task::Sender[Mark]
    incarnation: u64
    clock: sys::Clock
    pub abandoner: mem::Shared[sys::Abandoner]
    suspend_ms: u32
    keeping: Option[Keeping]
    restore: Option[os::Checkpoint]
    revival: bool
    config: Option[Untrusted[mem::Bytes]]
    forking: Option[ForkRun]
} Serving

/// What a fork's domain runs: the call it handles, or none for its start or resumption, where it tells what its run saw, the tape of its clock and random source, and whether its ports reached another instance.
struct ForkRun {
    call: Option[os::ForkCall]
    reporting: task::Sender[os::Forked]
    tape: Tape
    reaching: mem::Shared[core::atomic::AtomicBool]
} ForkRun

/// What a driver delivers to its instance's domain: a call with its header, the time without a message after which its component is suspended, never when 0, an order its holder carries out between handler calls, or the order to stop once the handler running returns.
enum Delivery {
    Call(id: u64, hash: sys::ProtocolHash, encoded: sys::Encoded, request: bool, header: os::Header)
    SuspendAfter(ms: u32)
    Hold(order: HolderOrder)
    Stop
} Delivery

/// What the task of an instance's domain tells its driver: among others, how a hibernation it was ordered ended, with the image it took or none when the instance serves on.
enum Report {
    Running(from: journal::StartedFrom)
    Hibernation(image: Option[Image])
    Taken(id: u64)
    Postponed(id: u64)
    Answered(id: u64, answer: os::Answer)
    Suspended
    Woken
    Ending
    CheckpointFailed(code: text::Fixed[32], bytes: u64)
    Published(summary: mem::Bytes)
    Replayed(outcome: Result[os::Replayed, os::ControlError])
} Report

/// What the watch of an incarnation takes: when its handlers run, which it bounds, their start, then how long they took; a reading of its gauge; and the end of its domain.
enum Mark {
    Began
    Took(ns: u64)
    Read(reply: task::Sender[os::Gauge])
    Ended
} Mark

/// How an instance's domain ended other than by abandonment: stopped, hibernated, without an Env, unhealthy at its start, or with a latest checkpoint that does not decode.
pub closed enum Ended derives Copy, Eq {
    Stopped
    Hibernated
    EnvIncomplete
    Unhealthy
    CheckpointUndecodable
} Ended

/// The instances of a component of state S serving P whose Env is Env, which they build from their world.
pub open struct Served[S: sys::Component[Env, P] and Encode, Env: nanos::Environment and Send, P: sys::Protocol and Send] {
} Served

/// The instances of a component of state S serving P whose Env is Env, built before they run.
pub open struct Driven[S: sys::Component[Env, P] and Encode, Env: Any and Send, P: sys::Protocol and Send] {
} Driven

/// The end of the delivery loop: the driver asked to stop, or released its deliveries.
enum Stopping {
    Asked
    Cancelled(task::Cancelled) from
} Stopping

/// Whether the instance's checkpoints are kept: it is checkpointed, and `store` took calls at its start.
pub fn Serving.keeps(self) -> bool = self.keeping.is_some()

/// The instance's configuration record as `/sys/config` held it at its start, `None` when it held none; a later call gives `None`.
pub fn Serving.take_config(mut self) -> Option[Untrusted[mem::Bytes]] {
    return mut self.config.extract()
} Serving.take_config

/// Runs an instance whose Env it builds from `world`, as `Driven.run` runs one.
pub fn Served.run(take world: nanos::World, take serving: Serving) -> Ended fails task::Cancelled uses wait {
    let exec = world.exec
    let alloc = world.alloc
    let Ok(env) = attempt Env.build(take world) else {
        return Ended.EnvIncomplete
    }
    return try await Driven[S, Env, P].run(take env, exec, alloc, take serving, peers: mem::List.empty(alloc), release: fn(take ended: Env) limits stack 512 {
    })
} Served.run

/// Runs an instance on `env`: starts the component, resumes it from the checkpoint `serving` restores or revives it from its hibernation image, ends it at once when its health is not `Healthy`, then serves what `serving` delivers, P's calls and those of the protocols whose schemas `peers` holds. Told to stop, it lets the handler running return, handles every message that waits, keeps a checkpoint of the component when it is dirty, and ends it, handing its Env to `release`; ordered to hibernate, it ends it once it has the image. The replies its handlers give the requests they postponed go to the driver as they come. A component that has had no message for the time `serving` sets is suspended until its next message.
pub fn Driven.run(
    take env: Env,
    exec: task::Executor,
    alloc: mem::Alloc,
    take serving: Serving,
    take peers: mem::List[sys::ProtocolSchema],
    release: fn(take ended: Env) limits stack 8_192,
    ) -> Ended fails task::Cancelled uses wait {
    if serving.forking.is_some() {
        return try await Driven[S, Env, P].forked(take env, exec, alloc, take serving, release)
    }
    let Serving(deliveries: deliveries, reports: reports, marks: marks, incarnation: incarnation, clock: clock, abandoner: _, suspend_ms: suspend_ms, keeping: keeping, restore: restore, revival: revival, config: _, forking: _) = serving
    let syncing = mem::Shared.of(core::atomic::AtomicBool.of(false), alloc)
    let pending = Pending(replies: mem::Shared.of(hw::SpinLock.of(mem::Bounded[Handed, QUEUED_REPLIES].empty()), alloc), signal: mem::Shared.of(hw::Signal[Unit].empty(), alloc), keeps: keeping.is_some(), syncing: syncing.share(), alloc: alloc)
    let replies = pending.replies.share()
    let signal = pending.signal.share()
    let replier = sys::Minter[Replier, Pending, u8].of(take pending, alloc)
    defer take replier.close()
    let Some(Begun(stepper: begun, reason: reason, restored: restored)) = try Driven[S, Env, P].begin(take env, take restore, exec, alloc, release) else {
        return Ended.CheckpointUndecodable
    }
    var stepper = begun
    var due_at = epoch_after(keeping, clock)
    defer take stepper.abandon()
    let orders = Orders.of(stepper.waker(), alloc)
    var holding = Holding[P].none(alloc)
    match attempt sys::Runner.served(replier.mint(0)) {
        Ok(runner) => mut stepper.attach(runner)
        Err(_) => {
        }
    }
    mut stepper.resumed(resumed_for(reason, revival))
    discard mut stepper.start_keyed()
    match mut stepper.health() {
        sys::HealthReply.Healthy => {
        }
        sys::HealthReply.Unhealthy(_) => return Ended.Unhealthy
    }
    try await tell(reports, incarnation, report: Report.Running(from: started_from(restored, revival)))
    let out = stepper.outbox()
    let steps = mem::Shared.of(Steps(begun: core::atomic::AtomicU64.of(0), done: core::atomic::AtomicU64.of(0), wanted: core::atomic::AtomicU64.of(0)), alloc)
    let quiet = mem::Shared.of(core::atomic::AtomicU64.of(u64.widen(suspend_ms)), alloc)
    let task::Channel(sender: finished, receiver: finishes) = task::Channel[u64].bounded(1, alloc)
    let telling = Telling(reports: reports.split(), marks: marks.split(), steps: steps.share(), finished: take finished, clock: clock, incarnation: incarnation, alloc: alloc)
    var given = Some(Given(deliveries: take deliveries, finishes: take finishes, peers: take peers))
    var image: Option[Image] = None
    let looped = attempt await task::scope(exec, body: fn[mut stepper, mut given, mut due_at, mut holding, mut image](s: task::Scope) fails Stopping uses wait {
        let Some(Given(deliveries: receiver, finishes: finishing, peers: known)) = mut given.extract() else {
            return
        }
        let sending = reports.split()
        let counted = steps.share()
        let setting = quiet.share()
        let ordering = orders.share()
        discard s.spawn(fn[take receiver, take finishing, take sending, take counted, take known, take setting, take ordering]() fails Stopping uses wait limits stack 40_960 {
            try await dispatch(out, deliveries: take receiver, steps: counted, finishes: take finishing, reports: sending, incarnation, peers: known, quiet: setting, orders: ordering, alloc)
        })
        let answering = reports.split()
        let queued = replies.share()
        let ringing = signal.share()
        discard s.spawn(fn[take answering, take queued, take ringing]() fails task::Cancelled uses wait limits stack 16_384 {
            try await hand_over(queued, signal: ringing, reports: answering, incarnation)
        })
        image = Some(try await hold(mut stepper, keeping, mut due_at, syncing: syncing.contents(), quiet: quiet.contents(), orders, mut holding, telling, s))
        s.cancel()
    })
    match looped {
        Err(Stopping.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
    undefer stepper
    return match mut image.extract() {
        Some(taken) => try await Driven[S, Env, P].hibernate(take stepper, image: take taken, mut holding, orders, replies, telling, release)
        None => try await Driven[S, Env, P].stop(take stepper, mut holding, keeping, dirty: due_at.is_some(), telling, release)
    }
} Driven.run

/// Ends the component behind `stepper` once told to stop: handles every message that waits, drops what its replays keep, keeps a checkpoint of it when it is `dirty` or handled a message, and ends the stepper, cancelling its keyed tasks with acknowledgement and handing its Env to `release`.
fn Driven.stop(
    take stepper: sys::Stepper[S, Env, P],
    mut holding: Holding[P],
    keeping: Option[Keeping],
    dirty: bool,
    telling: Telling,
    release: fn(take ended: Env) limits stack 8_192,
    ) -> Ended fails task::Cancelled uses wait {
    var ending = stepper
    defer take ending.abandon()
    let handled = try await call_handlers(mut ending, kept: holding.tasks, telling)
    mut holding.drop_kept(mut ending)
    match first keeping {
        Some(kept) if handled or dirty => {
            discard try await checkpoint(ending, keeping: kept, telling)
        }
        else => {
        }
    }
    try await telling.tell(report: Report.Ending)
    undefer ending
    let sys::Stopped(state: _, env: ended) = try await take ending.end()
    release(take ended)
    return Ended.Stopped
} Driven.stop

/// Ends the component behind `stepper` once a hibernation took its image: refuses the orders still waiting for its holder, drops what its replays keep and its held keyed tasks, hands the driver the replies and summaries `replies` queues and then `image`, and ends the stepper, cancelling its keyed tasks with acknowledgement and handing its Env to `release`.
fn Driven.hibernate(
    take stepper: sys::Stepper[S, Env, P],
    take image: Image,
    mut holding: Holding[P],
    orders: Orders,
    replies: mem::Shared[hw::SpinLock[mem::Bounded[Handed, QUEUED_REPLIES]]],
    telling: Telling,
    release: fn(take ended: Env) limits stack 8_192,
    ) -> Ended fails task::Cancelled uses wait {
    var ending = stepper
    defer take ending.abandon()
    loop {
        let Some(order) = orders.next() else {
            break
        }
        try await take order.refuse()
    }
    mut holding.drop_kept(mut ending)
    while (mut ending.take_held()).is_some() {
    }
    try await hand_all(replies, reports: telling.reports, incarnation: telling.incarnation)
    try await telling.tell(report: Report.Hibernation(image: Some(take image)))
    undefer ending
    let sys::Stopped(state: _, env: ended) = try await take ending.end()
    release(take ended)
    return Ended.Hibernated
} Driven.hibernate

/// The reason the component's `resume` is called with: `Revived` for a revival, else the one its start gave.
fn resumed_for(reason: sys::ResumeReason, revival: bool) -> sys::ResumeReason {
    if revival {
        return sys::ResumeReason.Revived
    }
    return reason
} resumed_for

/// What a start began from: a revival, the checkpoint `restored` names, or the component's start.
fn started_from(restored: Option[u64], revival: bool) -> journal::StartedFrom {
    if revival {
        return journal::StartedFrom.Revival
    }
    return match restored {
        Some(number) => journal::StartedFrom.Checkpoint(number: number)
        None => journal::StartedFrom.Start
    }
} started_from

/// Runs a fork of an instance on `env`: starts the component, or resumes it from the checkpoint `serving` restores, then handles once, one level deep, the call `serving` gives, or without one calls its `resume`, then probes its health once; tells `serving` the bytes of the state it resumed from, the reply to its call, the messages its handlers sent it and the classes of the keyed tasks they spawned, none of which runs, its state once it handled its call, the clock reads and random words its call's handler took through its tape, whether that handler called another instance, and whether it is unhealthy; then ends it, handing its Env to `release`.
fn Driven.forked(
    take env: Env,
    exec: task::Executor,
    alloc: mem::Alloc,
    take serving: Serving,
    release: fn(take ended: Env) limits stack 8_192,
    ) -> Ended fails task::Cancelled uses wait {
    let Serving(deliveries: _, reports: _, marks: _, incarnation: _, clock: _, abandoner: _, suspend_ms: _, keeping: _, restore: restore, revival: _, config: _, forking: forking) = serving
    let Some(ForkRun(call: call, reporting: reporting, tape: tape, reaching: reaching)) = forking else {
        release(take env)
        return Ended.Stopped
    }
    let state_bytes = restored_bytes(restore)
    let Some(Begun(stepper: begun, reason: reason, restored: _)) = try Driven[S, Env, P].begin(take env, take restore, exec, alloc, release) else {
        return Ended.CheckpointUndecodable
    }
    var stepper = begun
    defer take stepper.abandon()
    var reply: Option[mem::Bytes] = None
    var state: Option[os::StateCopy] = None
    var recorded = os::Recorded(clock: mem::List.empty(alloc), random: mem::List.empty(alloc))
    var reached = false
    match call {
        Some(given) => {
            discard held_outputs(mut stepper, alloc)
            discard held_spawns(mut stepper, alloc)
            reaching.contents().store(false)
            tape.record()
            reply = try await Driven[S, Env, P].handled_once(mut stepper, call: take given, exec, alloc)
            recorded = tape.recorded(alloc)
            reached = reaching.contents().load()
            state = Some(state_copy(stepper, alloc))
        }
        None => mut stepper.resumed(reason)
    }
    let sent = held_outputs(mut stepper, alloc)
    let spawns = held_spawns(mut stepper, alloc)
    let fault: Option[os::ForkFault] = match mut stepper.health() {
        sys::HealthReply.Healthy => None
        sys::HealthReply.Unhealthy(why) => Some(os::ForkFault.Unhealthy(reason: text::String.of(why.as_str(), alloc)))
    }
    discard attempt await reporting.send(os::Forked(state_bytes: state_bytes, reply: take reply, sent: take sent, spawns: take spawns, state: take state, recorded: take recorded, reached: reached, fault: take fault))
    undefer stepper
    let sys::Stopped(state: _, env: ended) = try await take stepper.end()
    release(take ended)
    return Ended.Stopped
} Driven.forked

/// The bytes of the encoded state of `restore`, none without one.
fn restored_bytes(restore: Option[os::Checkpoint]) -> u64 {
    return match restore {
        Some(saved) => u64.widen(saved.state.len())
        None => 0
    }
} restored_bytes

/// A component's stepper, the reason its `resume` is called with, and the number of the checkpoint it was restored from.
linear struct Begun[S, Env: Any, P: Any] {
    stepper: sys::Stepper[S, Env, P]
    reason: sys::ResumeReason
    restored: Option[u64]
} Begun

/// The stepper of a component on `env`: resumed from `restore` when given, else started; `None` once `env` is released when `restore` does not decode as the state.
fn Driven.begin(
    take env: Env,
    take restore: Option[os::Checkpoint],
    exec: task::Executor,
    alloc: mem::Alloc,
    release: fn(take ended: Env) limits stack 8_192,
    ) -> Option[Begun[S, Env, P]] fails task::Cancelled {
    let Some(saved) = restore else {
        return Some(Begun(stepper: try sys::Stepper[S, Env, P].start(take env, exec, alloc), reason: sys::ResumeReason.Started, restored: None))
    }
    if saved.schema.bytes != mem::wire::Codec[S].schema_hash().bytes {
        release(take env)
        return None
    }
    let Ok(state) = attempt mem::wire::Codec[S].decode(Untrusted.of(saved.state.view()), alloc) else {
        release(take env)
        return None
    }
    return Some(Begun(stepper: try sys::Stepper[S, Env, P].resume(take state, take env, exec, alloc), reason: sys::ResumeReason.Restored, restored: Some(saved.number)))
} Driven.begin

/// Holds the component until a hibernation takes its image, which it gives: waits for its messages, suspending it after `quiet` without one, and calls their handlers, carrying out between them the orders `orders` gives it with what `holding` sets aside and keeps, and only those orders while it is paused; the tasks it posts messages from belong to `s`. With `keeping`, a checkpoint falls due at `due_at`, an epoch after the first handler call since the last checkpoint or the failure of one, at once when a handler asked for one through `syncing`, and is kept once the component is idle. A hibernation that takes no image is reported to the driver, and the component serves on.
fn hold[S: Encode, Env: Any, P: sys::Protocol and Send](
    mut stepper: sys::Stepper[S, Env, P],
    keeping: Option[Keeping],
    mut due_at: Option[u64],
    syncing: core::atomic::AtomicBool,
    quiet: core::atomic::AtomicU64,
    orders: Orders,
    mut holding: Holding[P],
    telling: Telling,
    s: task::Scope,
    ) -> Image fails task::Cancelled uses wait {
    let clock = telling.clock
    loop {
        if try await carry_out(mut stepper, orders, mut holding, telling, s) {
            match try await hibernation(mut stepper, keeping, mut due_at, kept: holding.tasks, telling) {
                Some(image) => return image
                None => try await telling.tell(report: Report.Hibernation(image: None))
            }
        }
        if holding.paused {
            try await orders.wait()
            continue
        }
        if syncing.swap(false) {
            due_at = Some(now(clock))
        }
        match first keeping {
            Some(kept) if due_at.is_some() => {
                let arrived = try await task::within_ns(clock, ns: due_at.value_or(0).saturating_sub(now(clock)), body: fn() fails task::Cancelled uses wait {
                    try await stepper.incoming()
                })
                if arrived.is_none() and not try await stepper.ready() {
                    due_at = match try await checkpoint(stepper, keeping: kept, telling) {
                        true => None
                        false => epoch_after(keeping, clock)
                    }
                    continue
                }
            }
            else => try await idle(mut stepper, quiet, telling)
        }
        if try await call_handlers(mut stepper, kept: holding.tasks, telling) and due_at.is_none() {
            due_at = epoch_after(keeping, clock)
        }
    }
} hold

/// The hibernation image of the quiescent component behind `stepper`: calls the handlers of the messages waiting, keeps a checkpoint of its state when that is dirty, `due_at` then clearing, and encodes the state, giving it with the messages its handlers sent it that wait for their delay, which it takes from it; `None` without `keeping`, when the checkpoint failed or when the encoding passes the bytes `keeping` allows, the component then serving on as it was.
fn hibernation[S: Encode, Env: Any, P: sys::Protocol and Send](
    mut stepper: sys::Stepper[S, Env, P],
    keeping: Option[Keeping],
    mut due_at: Option[u64],
    kept: mem::List[u64],
    telling: Telling,
    ) -> Option[Image] fails task::Cancelled uses wait {
    let Some(keeper) = keeping else {
        return None
    }
    if try await call_handlers(mut stepper, kept, telling) or due_at.is_some() {
        if not try await checkpoint(stepper, keeping: keeper, telling) {
            return None
        }
        due_at = None
    }
    var state = mem::Bytes.empty(telling.alloc)
    mem::wire::Codec[S].encode(stepper.state(), out: mut state)
    if u64.widen(state.len()) > keeper.max_bytes {
        return None
    }
    return Some(Image(state: take state, schema: ident::HashValue(bytes: mem::wire::Codec[S].schema_hash().bytes), delayed: delayed_of(mut stepper, clock: telling.clock, alloc: telling.alloc)))
} hibernation

/// The messages the handlers of the component behind `stepper` sent it that wait for their delay, taken from it, each encoded with the monotonic time by `clock` at which it falls due.
fn delayed_of[S, Env: Any, P: sys::Protocol and Send](mut stepper: sys::Stepper[S, Env, P], clock: sys::Clock, alloc: mem::Alloc) -> mem::List[Delayed] {
    let now_ns = now(clock)
    var delayed = mem::List[Delayed].empty(alloc)
    loop {
        let Some(sent) = mut stepper.take_sent() else {
            return delayed
        }
        var encoded = sys::Encoded.empty(alloc)
        discard sys::Wire[P].encode_any(sent.message, out: mut encoded)
        let header = match sent.header {
            Some(carried) => os::Header.from_bits(carried.bytes)
            None => os::Header.current()
        }
        mut delayed.push(Delayed(hash: sys::Wire[P].hash(), encoded: take encoded, header: header, due_ns: now_ns.saturating_add(sent.delay_ns)))
    }
} delayed_of

/// When a checkpoint of the component `keeping` keeps falls due once it is dirty from now: an epoch later, never without `keeping`.
fn epoch_after(keeping: Option[Keeping], clock: sys::Clock) -> Option[u64] {
    let Some(kept) = keeping else {
        return None
    }
    return Some(now(clock) + kept.epoch_ms * NS_PER_MS)
} epoch_after

/// Keeps the quiescent state of the component as its next checkpoint, telling the driver when that fails; whether it was kept.
fn checkpoint[S: Encode, Env: Any, P: Any](stepper: sys::Stepper[S, Env, P], keeping: Keeping, telling: Telling) -> bool fails task::Cancelled uses wait {
    var bytes = mem::Bytes.empty(telling.alloc)
    mem::wire::Codec[S].encode(stepper.state(), out: mut bytes)
    let encoded = u64.widen(bytes.len())
    let Some(code) = try await keeping.keep(take bytes, schema: mem::wire::Codec[S].schema_hash(), incarnation: telling.incarnation) else {
        return true
    }
    try await telling.tell(report: Report.CheckpointFailed(code: code, bytes: encoded))
    return false
} checkpoint

/// What the holder of an instance's domain tells and counts through: the driver's inputs for the incarnation `incarnation`, the marks of its watch, the steps it counts for the dispatcher with the signal of those finished, the monotonic clock, and the allocator of the domain.
struct Telling {
    reports: task::Sender[Input]
    marks: task::Sender[Mark]
    steps: mem::Shared[Steps]
    finished: task::Sender[u64]
    clock: sys::Clock
    incarnation: u64
    alloc: mem::Alloc
} Telling

/// Tells the driver `report`.
fn Telling.tell(self, take report: Report) fails task::Cancelled uses wait {
    try await tell(self.reports, incarnation: self.incarnation, take report)
} Telling.tell

/// The steps of an instance's holder: how many it began and finished, and the count of finished steps the dispatcher waits for, 0 when it waits for none.
struct Steps {
    begun: core::atomic::AtomicU64
    done: core::atomic::AtomicU64
    wanted: core::atomic::AtomicU64
} Steps

/// What the dispatcher of an instance's domain takes: the calls its driver delivers, the counts of finished steps the holder signals, and the schemas of the client protocols it serves.
struct Given {
    deliveries: task::Receiver[Delivery]
    finishes: task::Receiver[u64]
    peers: mem::List[sys::ProtocolSchema]
} Given

/// Serves each call delivered through the protocol P, or one whose schema `peers` holds, on the component behind `out`, one at a time and in order, until told to stop, keeping in `quiet` the time without a message after which the component is suspended and handing each order for the holder to `orders`.
fn dispatch[P: sys::Protocol and Send](
    out: sys::Outbox[P],
    take deliveries: task::Receiver[Delivery],
    steps: mem::Shared[Steps],
    take finishes: task::Receiver[u64],
    reports: task::Sender[Input],
    incarnation: u64,
    peers: mem::List[sys::ProtocolSchema],
    quiet: mem::Shared[core::atomic::AtomicU64],
    orders: Orders,
    alloc: mem::Alloc,
    ) fails Stopping uses wait {
    var receiver = deliveries
    var signals = finishes
    loop {
        let Some(delivery) = try await mut receiver.receive() else {
            fail Stopping.Asked
        }
        match delivery {
            Delivery.Call(id: id, hash: hash, encoded: encoded, request: request, header: header) => try await serve_call(out, id, hash, take encoded, request, header, steps, mut signals, reports, incarnation, peers, alloc)
            Delivery.SuspendAfter(ms: ms) => quiet.contents().store(u64.widen(ms))
            Delivery.Hold(order: order) => {
                discard orders.give(take order)
            }
            Delivery.Stop => fail Stopping.Asked
        }
    }
} dispatch

/// Serves the call `id` of header `header` on the component behind `out`, its handler call doing the instance's work under the call's header: a request is answered once its handler returns, or reported postponed, and a one-way call is reported taken once the handler call that took it has returned.
fn serve_call[P: sys::Protocol and Send](
    out: sys::Outbox[P],
    id: u64,
    hash: sys::ProtocolHash,
    take encoded: sys::Encoded,
    request: bool,
    header: os::Header,
    steps: mem::Shared[Steps],
    mut signals: task::Receiver[u64],
    reports: task::Sender[Input],
    incarnation: u64,
    peers: mem::List[sys::ProtocolSchema],
    alloc: mem::Alloc,
    ) fails Stopping uses wait {
    let work = header.handled_by(os::Header.current().sender)
    let outcome = attempt await sys::run_headed(work.carried(), body: fn() -> Option[sys::Encoded] fails sys::CallError[Never] uses wait {
        return try await sys::Wire[P].serve(out, request: id, hash, peers: peers.view(), raw: Untrusted.of(encoded.bytes.view()), handles: encoded.handles.view(), alloc)
    })
    if not request {
        if outcome.is_ok() {
            try await finish_step(steps.contents(), mut signals)
        }
        try await tell(reports, incarnation, report: Report.Taken(id: id))
        return
    }
    let answer = match outcome {
        Ok(Some(reply)) => os::Answer.Replied(take reply)
        Ok(None) => {
            try await tell(reports, incarnation, report: Report.Postponed(id: id))
            return
        }
        Err(sys::CallError.Malformed(_)) => os::Answer.Malformed
        else => os::Answer.ServerStopped
    }
    try await tell(reports, incarnation, report: Report.Answered(id: id, answer: take answer))
} serve_call

/// Waits until the step that took the call just posted has finished: every step begun by now. The holder signals the count it waits for when it reaches it, unless the count is already reached and the dispatcher withdraws its wait first.
fn finish_step(steps: Steps, mut signals: task::Receiver[u64]) fails Stopping uses wait {
    let target = steps.begun.load()
    steps.wanted.store(target)
    if steps.done.load() >= target and steps.wanted.compare_swap(expected: target, replacement: 0).is_ok() {
        return
    }
    loop {
        let Some(through) = try await mut signals.receive() else {
            fail Stopping.Asked
        }
        if through >= target {
            return
        }
    }
} finish_step

/// Waits until a message waits in the component's intake; once the component has had none for the time `quiet` holds, never when 0, suspends it until its next message and then wakes it, telling the driver of both.
fn idle[S, Env: Any, P: Any](mut stepper: sys::Stepper[S, Env, P], quiet: core::atomic::AtomicU64, telling: Telling) fails task::Cancelled uses wait {
    let clock = telling.clock
    loop {
        let ms = quiet.load()
        if ms == 0 {
            try await stepper.incoming()
            return
        }
        let arrived = try await task::within(clock, ms, body: fn() fails task::Cancelled uses wait {
            try await stepper.incoming()
        })
        if arrived.is_some() {
            return
        }
        if quiet.load() != 0 {
            break
        }
    }
    mut stepper.suspend()
    try await telling.tell(report: Report.Suspended)
    try await stepper.incoming()
    mut stepper.wake()
    try await telling.tell(report: Report.Woken)
} idle

/// Calls the handlers of every message waiting in the component's intake, starting the keyed tasks they spawn but those `kept` names, and counting each step for the dispatcher; tells the watchdog when they begin and how long they took, and returns whether it called any.
fn call_handlers[S, Env: Any, P: Any](mut stepper: sys::Stepper[S, Env, P], kept: mem::List[u64], telling: Telling) -> bool fails task::Cancelled uses wait {
    try await mark(telling.marks, marked: Mark.Began)
    let started = now(telling.clock)
    let counts = telling.steps.contents()
    var handled = false
    loop {
        discard counts.begun.fetch_add(1)
        let stepped = mut stepper.step()
        let done = counts.done.fetch_add(1).value_or(0) + 1
        if counts.wanted.compare_swap(expected: done, replacement: 0).is_ok() {
            match attempt await telling.finished.send(done) {
                Err(task::SendError.Cancelled(cancelled)) => fail cancelled
                else => {
                }
            }
        }
        if stepped.is_none() {
            break
        }
        handled = true
        start_unkept(mut stepper, kept, alloc: telling.alloc)
    }
    try await mark(telling.marks, marked: Mark.Took(ns: now(telling.clock).saturating_sub(started)))
    return handled
} call_handlers

/// Sends a report of the incarnation `incarnation` to the driver, which a driver that has stopped listening no longer needs.
fn tell(reports: task::Sender[Input], incarnation: u64, take report: Report) fails task::Cancelled uses wait {
    match attempt await reports.send(Input.Report(incarnation: incarnation, report: take report)) {
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} tell

fn mark(marks: task::Sender[Mark], take marked: Mark) fails task::Cancelled uses wait {
    match attempt await marks.send(take marked) {
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} mark

/// The monotonic time in nanoseconds, 0 through a revoked clock.
fn now(clock: sys::Clock) -> u64 {
    return match attempt clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
} now

/// The replies an incarnation's queue holds before a task of its domain hands them to the driver.
const QUEUED_REPLIES: usize = 64

/// The runner capability of an incarnation's component, which takes the replies to the requests it postponed and its requests for checkpoints.
pub open struct Replier {
} Replier

impl Replier: sys::Kind[Pending, u8]

impl Replier: sys::RunnerService

/// The replies of an incarnation's postponed requests waiting for its driver, the signal its replies post, whether its checkpoints are kept and one is asked for, and where the replies' copies are drawn from.
struct Pending {
    replies: mem::Shared[hw::SpinLock[mem::Bounded[Handed, QUEUED_REPLIES]]]
    signal: mem::Shared[hw::Signal[Unit]]
    keeps: bool
    syncing: mem::Shared[core::atomic::AtomicBool]
    alloc: mem::Alloc
} Pending

/// What the component hands its driver: the reply to the request the driver numbered `request`, or the summary it published.
enum Handed {
    Reply(request: u64, reply: sys::Encoded)
    Summary(bytes: mem::Bytes)
} Handed

/// Queues the reply to the request `request` for the driver, its bytes and the handles beside them; unknown when the queue is full.
pub fn Replier.reply(self, request: u64, bytes: Slice[u8], handles: Slice[sys::Handle]) fails sys::RunnerError limits stack 4_096 {
    let queued = sys::reach(self, body: fn(state: Pending, record: u8) -> bool {
        var reply = sys::Encoded.empty(state.alloc)
        mut reply.bytes.append(bytes)
        for handle in handles {
            mut reply.handles.push(handle)
        }
        return state.hand(handed: Handed.Reply(request: request, reply: take reply))
    })
    if queued != Some(true) {
        fail sys::RunnerError.Unknown
    }
} Replier.reply

/// Queues `handed` for the driver and posts the signal; whether the queue had room.
fn Pending.hand(self, take handed: Handed) -> bool {
    var held = Some(take handed)
    return hw::without_irqs(fn[mut held](t: hw::IrqsDisabled) -> bool limits notrap {
        let fitted = self.replies.contents().with(t, body: fn[mut held](mut queue: mem::Bounded[Handed, QUEUED_REPLIES]) -> bool limits notrap, terminates, noalloc {
            let Some(next) = mut held.extract() else {
                return false
            }
            if queue.is_full() {
                return false
            }
            mut queue.push(take next)
            return true
        })
        if fitted {
            self.signal.contents().post(t, value: Unit)
        }
        return fitted
    })
} Pending.hand

pub fn Replier.send_to(
    self,
    port: u64,
    hash: sys::ProtocolHash,
    bytes: Slice[u8],
    handles: Slice[sys::Handle],
    ) fails sys::RunnerError limits stack 4_096 {
    fail sys::RunnerError.Unknown
} Replier.send_to

pub fn Replier.call(
    self,
    port: u64,
    hash: sys::ProtocolHash,
    bytes: Slice[u8],
    handles: Slice[sys::Handle],
    alloc: mem::Alloc,
    ) -> sys::Encoded fails sys::RunnerError limits stack 4_096 {
    fail sys::RunnerError.Unknown
} Replier.call

/// Queues the component's summary for the driver, which publishes it with the instance's record; unknown when the queue is full.
pub fn Replier.publish(self, summary: Slice[u8]) fails sys::RunnerError limits stack 4_096 {
    let queued = sys::reach(self, body: fn(state: Pending, record: u8) -> bool {
        var bytes = mem::Bytes.empty(state.alloc)
        mut bytes.append(summary)
        return state.hand(handed: Handed.Summary(bytes: take bytes))
    })
    if queued != Some(true) {
        fail sys::RunnerError.Unknown
    }
} Replier.publish

/// Asks for a checkpoint of the component once it is idle; unknown when the instance keeps none.
pub fn Replier.sync(self) fails sys::RunnerError limits stack 4_096 {
    let asked = sys::reach(self, body: fn(state: Pending, record: u8) -> bool {
        if state.keeps {
            state.syncing.contents().store(true)
        }
        return state.keeps
    })
    if asked != Some(true) {
        fail sys::RunnerError.Unknown
    }
} Replier.sync

pub fn Replier.capability(self, id: u64) -> sys::Handle fails sys::RunnerError limits stack 4_096 {
    fail sys::RunnerError.Unknown
} Replier.capability

pub fn Replier.drop_capability(self, id: u64) fails sys::RunnerError limits stack 4_096 {
    fail sys::RunnerError.Unknown
} Replier.drop_capability

pub fn Replier.resource(self, id: u64) -> sys::Held fails sys::RunnerError limits stack 8_192 {
    fail sys::RunnerError.Unknown
} Replier.resource

pub fn Replier.take_resource(self, id: u64) -> sys::Held fails sys::RunnerError limits stack 8_192 {
    fail sys::RunnerError.Unknown
} Replier.take_resource

pub fn Replier.put_resource(self, id: u64, take resource: sys::Held) fails sys::RunnerError limits stack 8_192 {
    fail sys::RunnerError.Unknown
} Replier.put_resource

/// Hands the driver each reply and summary `replies` queues, as `signal` tells it they come, until cancelled.
fn hand_over(replies: mem::Shared[hw::SpinLock[mem::Bounded[Handed, QUEUED_REPLIES]]], signal: mem::Shared[hw::Signal[Unit]], reports: task::Sender[Input], incarnation: u64) fails task::Cancelled uses wait {
    loop {
        try await signal.contents().wait()
        try await hand_all(replies, reports, incarnation)
    }
} hand_over

/// Hands the driver every reply and summary `replies` queues.
fn hand_all(replies: mem::Shared[hw::SpinLock[mem::Bounded[Handed, QUEUED_REPLIES]]], reports: task::Sender[Input], incarnation: u64) fails task::Cancelled uses wait {
    loop {
        let next = hw::without_irqs(fn(t: hw::IrqsDisabled) -> Option[Handed] limits notrap {
            return replies.contents().with(t, body: fn(mut queue: mem::Bounded[Handed, QUEUED_REPLIES]) -> Option[Handed] limits notrap, terminates, noalloc {
                return mut queue.pop()
            })
        })
        let Some(handed) = next else {
            return
        }
        let report = match handed {
            Handed.Reply(request: request, reply: reply) => Report.Answered(id: request, answer: os::Answer.Replied(take reply))
            Handed.Summary(bytes: bytes) => Report.Published(summary: take bytes)
        }
        try await tell(reports, incarnation, take report)
    }
} hand_all
