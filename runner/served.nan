//! The task of an instance's domain: it builds the Env, starts or restores the component, serves the calls its driver delivers, one at a time, keeps its checkpoints, and hands its driver the replies the component gives postponed requests.

/// What an instance's driver gives the task of its domain: the calls it delivers, where the domain reports what it takes and answers and when its handlers run, the abandoner of the domain, the time without a message after which the component is suspended, never when 0, for a checkpointed instance how its checkpoints are kept and the checkpoint it restores, the instance's configuration record, and for a fork where it tells what its run saw.
pub open struct Serving {
    deliveries: task::Receiver[Delivery]
    reports: task::Sender[Input]
    marks: task::Sender[Mark]
    incarnation: u64
    clock: sys::Clock
    pub abandoner: mem::Shared[sys::Abandoner]
    suspend_ms: u32
    keeping: Option[Keeping]
    restore: Option[os::Checkpoint]
    config: Option[Untrusted[mem::Bytes]]
    forking: Option[task::Sender[os::Forked]]
} Serving

/// What a driver delivers to its instance's domain: a call with its header, the time without a message after which its component is suspended, never when 0, or the order to stop once the handler running returns.
enum Delivery {
    Call(id: u64, hash: sys::ProtocolHash, encoded: sys::Encoded, request: bool, header: os::Header)
    SuspendAfter(ms: u32)
    Stop
} Delivery

/// What the task of an instance's domain tells its driver.
enum Report {
    Running(checkpoint: Option[u64])
    Taken(id: u64)
    Postponed(id: u64)
    Answered(id: u64, answer: os::Answer)
    Suspended
    Woken
    Ending
    CheckpointFailed(code: text::Fixed[32], bytes: u64)
    Published(summary: mem::Bytes)
} Report

/// What the watch of an incarnation takes: when its handlers run, which it bounds, their start, then how long they took; a reading of its gauge; and the end of its domain.
enum Mark {
    Began
    Took(ns: u64)
    Read(reply: task::Sender[os::Gauge])
    Ended
} Mark

/// How an instance's domain ended other than by abandonment: stopped, without an Env, unhealthy at its start, or with a latest checkpoint that does not decode.
pub closed enum Ended derives Copy, Eq {
    Stopped
    EnvIncomplete
    Unhealthy
    CheckpointUndecodable
} Ended

/// The instances of a component of state S serving P whose Env is Env, which they build from their world.
pub open struct Served[S: sys::Component[Env, P] and Encode, Env: nanos::Environment and Send, P: sys::Protocol and Send] {
} Served

/// The instances of a component of state S serving P whose Env is Env, built before they run.
pub open struct Driven[S: sys::Component[Env, P] and Encode, Env: Any and Send, P: sys::Protocol and Send] {
} Driven

/// The end of the delivery loop: the driver asked to stop, or released its deliveries.
enum Stopping {
    Asked
    Cancelled(task::Cancelled) from
} Stopping

/// Whether the instance's checkpoints are kept: it is checkpointed, and `store` took calls at its start.
pub fn Serving.keeps(self) -> bool = self.keeping.is_some()

/// The instance's configuration record as `/sys/config` held it at its start, `None` when it held none; a later call gives `None`.
pub fn Serving.take_config(mut self) -> Option[Untrusted[mem::Bytes]] {
    return mut self.config.extract()
} Serving.take_config

/// Runs an instance whose Env it builds from `world`, as `Driven.run` runs one.
pub fn Served.run(take world: nanos::World, take serving: Serving) -> Ended fails task::Cancelled uses wait {
    let exec = world.exec
    let alloc = world.alloc
    let Ok(env) = attempt Env.build(take world) else {
        return Ended.EnvIncomplete
    }
    return try await Driven[S, Env, P].run(take env, exec, alloc, take serving, peers: mem::List.empty(alloc), release: fn(take ended: Env) limits stack 512 {
    })
} Served.run

/// Runs an instance on `env`: starts the component, or resumes it from the checkpoint `serving` restores, ends it at once when its health is not `Healthy`, then serves what `serving` delivers, P's calls and those of the protocols whose schemas `peers` holds, until it is told to stop, letting the handler running return and handling every message that waits, keeps a checkpoint of the component when it is dirty, and ends it, handing its Env to `release`. The replies its handlers give the requests they postponed go to the driver as they come. A component that has had no message for the time `serving` sets is suspended until its next message.
pub fn Driven.run(
    take env: Env,
    exec: task::Executor,
    alloc: mem::Alloc,
    take serving: Serving,
    take peers: mem::List[sys::ProtocolSchema],
    release: fn(take ended: Env) limits stack 8_192,
    ) -> Ended fails task::Cancelled uses wait {
    if serving.forking.is_some() {
        return try await Driven[S, Env, P].forked(take env, exec, alloc, take serving, release)
    }
    let Serving(deliveries: deliveries, reports: reports, marks: marks, incarnation: incarnation, clock: clock, abandoner: _, suspend_ms: suspend_ms, keeping: keeping, restore: restore, config: _, forking: _) = serving
    let syncing = mem::Shared.of(core::atomic::AtomicBool.of(false), alloc)
    let pending = Pending(replies: mem::Shared.of(hw::SpinLock.of(mem::Bounded[Handed, QUEUED_REPLIES].empty()), alloc), signal: mem::Shared.of(hw::Signal[Unit].empty(), alloc), keeps: keeping.is_some(), syncing: syncing.share(), alloc: alloc)
    let replies = pending.replies.share()
    let signal = pending.signal.share()
    let replier = sys::Minter[Replier, Pending, u8].of(take pending, alloc)
    defer take replier.close()
    let Some(Begun(stepper: begun, reason: reason, restored: restored)) = try Driven[S, Env, P].begin(take env, take restore, exec, alloc, release) else {
        return Ended.CheckpointUndecodable
    }
    var stepper = begun
    var due_at = epoch_after(keeping, clock)
    defer take stepper.abandon()
    match attempt sys::Runner.served(replier.mint(0)) {
        Ok(runner) => mut stepper.attach(runner)
        Err(_) => {
        }
    }
    mut stepper.resumed(reason)
    discard mut stepper.start_keyed()
    match mut stepper.health() {
        sys::HealthReply.Healthy => {
        }
        sys::HealthReply.Unhealthy(_) => return Ended.Unhealthy
    }
    try await tell(reports, incarnation, report: Report.Running(checkpoint: restored))
    let out = stepper.outbox()
    let steps = mem::Shared.of(Steps(begun: core::atomic::AtomicU64.of(0), done: core::atomic::AtomicU64.of(0), wanted: core::atomic::AtomicU64.of(0)), alloc)
    let quiet = mem::Shared.of(core::atomic::AtomicU64.of(u64.widen(suspend_ms)), alloc)
    let task::Channel(sender: finished, receiver: finishes) = task::Channel[u64].bounded(1, alloc)
    var given = Some(Given(deliveries: take deliveries, finishes: take finishes, peers: take peers))
    let looped = attempt await task::scope(exec, body: fn[mut stepper, mut given, mut due_at](s: task::Scope) fails Stopping uses wait {
        let Some(Given(deliveries: receiver, finishes: finishing, peers: known)) = mut given.extract() else {
            return
        }
        let sending = reports.split()
        let counted = steps.share()
        let setting = quiet.share()
        discard s.spawn(fn[take receiver, take finishing, take sending, take counted, take known, take setting]() fails Stopping uses wait limits stack 40_960 {
            try await dispatch(out, deliveries: take receiver, steps: counted, finishes: take finishing, reports: sending, incarnation, peers: known, quiet: setting, alloc)
        })
        let answering = reports.split()
        let queued = replies.share()
        let ringing = signal.share()
        discard s.spawn(fn[take answering, take queued, take ringing]() fails task::Cancelled uses wait limits stack 16_384 {
            try await hand_over(queued, signal: ringing, reports: answering, incarnation)
        })
        try await hold(mut stepper, keeping, mut due_at, syncing: syncing.contents(), quiet: quiet.contents(), clock, reports, marks, steps, finished, incarnation, alloc)
    })
    match looped {
        Ok(_) => {
        }
        Err(Stopping.Asked) => {
        }
        Err(Stopping.Cancelled(cancelled)) => fail cancelled
    }
    let handled = try await call_handlers(mut stepper, marks, steps, finished, clock)
    match first keeping {
        Some(kept) if handled or due_at.is_some() => {
            discard try await checkpoint(stepper, keeping: kept, reports, incarnation, alloc)
        }
        else => {
        }
    }
    try await tell(reports, incarnation, report: Report.Ending)
    undefer stepper
    let sys::Stopped(state: _, env: ended) = try await take stepper.end()
    release(take ended)
    return Ended.Stopped
} Driven.run

/// Runs a fork of an instance on `env`: starts the component, or resumes it from the checkpoint `serving` restores, then probes its health once, telling `serving` how many keyed tasks its handlers spawned and messages they sent it, none of which runs, and whether it is unhealthy; then ends it, handing its Env to `release`.
fn Driven.forked(
    take env: Env,
    exec: task::Executor,
    alloc: mem::Alloc,
    take serving: Serving,
    release: fn(take ended: Env) limits stack 8_192,
    ) -> Ended fails task::Cancelled uses wait {
    let Serving(deliveries: _, reports: _, marks: _, incarnation: _, clock: _, abandoner: _, suspend_ms: _, keeping: _, restore: restore, config: _, forking: forking) = serving
    let Some(reporting) = forking else {
        release(take env)
        return Ended.Stopped
    }
    let Some(Begun(stepper: begun, reason: reason, restored: _)) = try Driven[S, Env, P].begin(take env, take restore, exec, alloc, release) else {
        return Ended.CheckpointUndecodable
    }
    var stepper = begun
    defer take stepper.abandon()
    mut stepper.resumed(reason)
    var spawns: u32 = 0
    loop {
        let Some(_) = mut stepper.take_held() else {
            break
        }
        spawns = spawns.saturating_add(1)
    }
    var sent: u32 = 0
    loop {
        let Some(_) = mut stepper.take_sent() else {
            break
        }
        sent = sent.saturating_add(1)
    }
    let fault: Option[os::ForkFault] = match mut stepper.health() {
        sys::HealthReply.Healthy => None
        sys::HealthReply.Unhealthy(why) => Some(os::ForkFault.Unhealthy(reason: text::String.of(why.as_str(), alloc)))
    }
    discard attempt await reporting.send(os::Forked(spawns: spawns, sent: sent, fault: take fault))
    undefer stepper
    let sys::Stopped(state: _, env: ended) = try await take stepper.end()
    release(take ended)
    return Ended.Stopped
} Driven.forked

/// A component's stepper, the reason its `resume` is called with, and the number of the checkpoint it was restored from.
linear struct Begun[S, Env: Any, P: Any] {
    stepper: sys::Stepper[S, Env, P]
    reason: sys::ResumeReason
    restored: Option[u64]
} Begun

/// The stepper of a component on `env`: resumed from `restore` when given, else started; `None` once `env` is released when `restore` does not decode as the state.
fn Driven.begin(
    take env: Env,
    take restore: Option[os::Checkpoint],
    exec: task::Executor,
    alloc: mem::Alloc,
    release: fn(take ended: Env) limits stack 8_192,
    ) -> Option[Begun[S, Env, P]] fails task::Cancelled {
    let Some(saved) = restore else {
        return Some(Begun(stepper: try sys::Stepper[S, Env, P].start(take env, exec, alloc), reason: sys::ResumeReason.Started, restored: None))
    }
    if saved.schema.bytes != mem::wire::Codec[S].schema_hash().bytes {
        release(take env)
        return None
    }
    let Ok(state) = attempt mem::wire::Codec[S].decode(Untrusted.of(saved.state.view()), alloc) else {
        release(take env)
        return None
    }
    return Some(Begun(stepper: try sys::Stepper[S, Env, P].resume(take state, take env, exec, alloc), reason: sys::ResumeReason.Restored, restored: Some(saved.number)))
} Driven.begin

/// Holds the component: waits for its messages, suspending it after `quiet` without one, and calls their handlers. With `keeping`, a checkpoint falls due at `due_at`, an epoch after the first handler call since the last checkpoint or the failure of one, at once when a handler asked for one through `syncing`, and is kept once the component is idle.
fn hold[S: Encode, Env: Any, P: Any](
    mut stepper: sys::Stepper[S, Env, P],
    keeping: Option[Keeping],
    mut due_at: Option[u64],
    syncing: core::atomic::AtomicBool,
    quiet: core::atomic::AtomicU64,
    clock: sys::Clock,
    reports: task::Sender[Input],
    marks: task::Sender[Mark],
    steps: mem::Shared[Steps],
    finished: task::Sender[u64],
    incarnation: u64,
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    loop {
        if syncing.swap(false) {
            due_at = Some(now(clock))
        }
        match first keeping {
            Some(kept) if due_at.is_some() => {
                let arrived = try await task::within_ns(clock, ns: due_at.value_or(0).saturating_sub(now(clock)), body: fn() fails task::Cancelled uses wait {
                    try await stepper.incoming()
                })
                if arrived.is_none() and not try await stepper.ready() {
                    due_at = match try await checkpoint(stepper, keeping: kept, reports, incarnation, alloc) {
                        true => None
                        false => epoch_after(keeping, clock)
                    }
                    continue
                }
            }
            else => try await idle(mut stepper, quiet, clock, reports, incarnation)
        }
        if try await call_handlers(mut stepper, marks, steps, finished, clock) and due_at.is_none() {
            due_at = epoch_after(keeping, clock)
        }
    }
} hold

/// When a checkpoint of the component `keeping` keeps falls due once it is dirty from now: an epoch later, never without `keeping`.
fn epoch_after(keeping: Option[Keeping], clock: sys::Clock) -> Option[u64] {
    let Some(kept) = keeping else {
        return None
    }
    return Some(now(clock) + kept.epoch_ms * NS_PER_MS)
} epoch_after

/// Keeps the quiescent state of the component as its next checkpoint, telling the driver when that fails; whether it was kept.
fn checkpoint[S: Encode, Env: Any, P: Any](
    stepper: sys::Stepper[S, Env, P],
    keeping: Keeping,
    reports: task::Sender[Input],
    incarnation: u64,
    alloc: mem::Alloc,
    ) -> bool fails task::Cancelled uses wait {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[S].encode(stepper.state(), out: mut bytes)
    let encoded = u64.widen(bytes.len())
    let Some(code) = try await keeping.keep(take bytes, schema: mem::wire::Codec[S].schema_hash(), incarnation) else {
        return true
    }
    try await tell(reports, incarnation, report: Report.CheckpointFailed(code: code, bytes: encoded))
    return false
} checkpoint

/// The steps of an instance's holder: how many it began and finished, and the count of finished steps the dispatcher waits for, 0 when it waits for none.
struct Steps {
    begun: core::atomic::AtomicU64
    done: core::atomic::AtomicU64
    wanted: core::atomic::AtomicU64
} Steps

/// What the dispatcher of an instance's domain takes: the calls its driver delivers, the counts of finished steps the holder signals, and the schemas of the client protocols it serves.
struct Given {
    deliveries: task::Receiver[Delivery]
    finishes: task::Receiver[u64]
    peers: mem::List[sys::ProtocolSchema]
} Given

/// Serves each call delivered through the protocol P, or one whose schema `peers` holds, on the component behind `out`, one at a time and in order, until told to stop, keeping in `quiet` the time without a message after which the component is suspended.
fn dispatch[P: sys::Protocol and Send](
    out: sys::Outbox[P],
    take deliveries: task::Receiver[Delivery],
    steps: mem::Shared[Steps],
    take finishes: task::Receiver[u64],
    reports: task::Sender[Input],
    incarnation: u64,
    peers: mem::List[sys::ProtocolSchema],
    quiet: mem::Shared[core::atomic::AtomicU64],
    alloc: mem::Alloc,
    ) fails Stopping uses wait {
    var receiver = deliveries
    var signals = finishes
    loop {
        let Some(delivery) = try await mut receiver.receive() else {
            fail Stopping.Asked
        }
        match delivery {
            Delivery.Call(id: id, hash: hash, encoded: encoded, request: request, header: header) => try await serve_call(out, id, hash, take encoded, request, header, steps, mut signals, reports, incarnation, peers, alloc)
            Delivery.SuspendAfter(ms: ms) => quiet.contents().store(u64.widen(ms))
            Delivery.Stop => fail Stopping.Asked
        }
    }
} dispatch

/// Serves the call `id` of header `header` on the component behind `out`, its handler call doing the instance's work under the call's header: a request is answered once its handler returns, or reported postponed, and a one-way call is reported taken once the handler call that took it has returned.
fn serve_call[P: sys::Protocol and Send](
    out: sys::Outbox[P],
    id: u64,
    hash: sys::ProtocolHash,
    take encoded: sys::Encoded,
    request: bool,
    header: os::Header,
    steps: mem::Shared[Steps],
    mut signals: task::Receiver[u64],
    reports: task::Sender[Input],
    incarnation: u64,
    peers: mem::List[sys::ProtocolSchema],
    alloc: mem::Alloc,
    ) fails Stopping uses wait {
    let work = header.handled_by(os::Header.current().sender)
    let outcome = attempt await sys::run_headed(work.carried(), body: fn() -> Option[sys::Encoded] fails sys::CallError[Never] uses wait {
        return try await sys::Wire[P].serve(out, request: id, hash, peers: peers.view(), raw: Untrusted.of(encoded.bytes.view()), handles: encoded.handles.view(), alloc)
    })
    if not request {
        if outcome.is_ok() {
            try await finish_step(steps.contents(), mut signals)
        }
        try await tell(reports, incarnation, report: Report.Taken(id: id))
        return
    }
    let answer = match outcome {
        Ok(Some(reply)) => os::Answer.Replied(take reply)
        Ok(None) => {
            try await tell(reports, incarnation, report: Report.Postponed(id: id))
            return
        }
        Err(sys::CallError.Malformed(_)) => os::Answer.Malformed
        else => os::Answer.ServerStopped
    }
    try await tell(reports, incarnation, report: Report.Answered(id: id, answer: take answer))
} serve_call

/// Waits until the step that took the call just posted has finished: every step begun by now. The holder signals the count it waits for when it reaches it, unless the count is already reached and the dispatcher withdraws its wait first.
fn finish_step(steps: Steps, mut signals: task::Receiver[u64]) fails Stopping uses wait {
    let target = steps.begun.load()
    steps.wanted.store(target)
    if steps.done.load() >= target and steps.wanted.compare_swap(expected: target, replacement: 0).is_ok() {
        return
    }
    loop {
        let Some(through) = try await mut signals.receive() else {
            fail Stopping.Asked
        }
        if through >= target {
            return
        }
    }
} finish_step

/// Waits until a message waits in the component's intake; once the component has had none for the time `quiet` holds, never when 0, suspends it until its next message and then wakes it, telling the driver of both.
fn idle[S, Env: Any, P: Any](
    mut stepper: sys::Stepper[S, Env, P],
    quiet: core::atomic::AtomicU64,
    clock: sys::Clock,
    reports: task::Sender[Input],
    incarnation: u64,
    ) fails task::Cancelled uses wait {
    loop {
        let ms = quiet.load()
        if ms == 0 {
            try await stepper.incoming()
            return
        }
        let arrived = try await task::within(clock, ms, body: fn() fails task::Cancelled uses wait {
            try await stepper.incoming()
        })
        if arrived.is_some() {
            return
        }
        if quiet.load() != 0 {
            break
        }
    }
    mut stepper.suspend()
    try await tell(reports, incarnation, report: Report.Suspended)
    try await stepper.incoming()
    mut stepper.wake()
    try await tell(reports, incarnation, report: Report.Woken)
} idle

/// Calls the handlers of every message waiting in the component's intake, starting the keyed tasks they spawn, and counting each step for the dispatcher; tells the watchdog when they begin and how long they took, and returns whether it called any.
fn call_handlers[S, Env: Any, P: Any](
    mut stepper: sys::Stepper[S, Env, P],
    marks: task::Sender[Mark],
    steps: mem::Shared[Steps],
    finished: task::Sender[u64],
    clock: sys::Clock,
    ) -> bool fails task::Cancelled uses wait {
    try await mark(marks, marked: Mark.Began)
    let started = now(clock)
    let counts = steps.contents()
    var handled = false
    loop {
        discard counts.begun.fetch_add(1)
        let stepped = mut stepper.step()
        let done = counts.done.fetch_add(1).value_or(0) + 1
        if counts.wanted.compare_swap(expected: done, replacement: 0).is_ok() {
            match attempt await finished.send(done) {
                Err(task::SendError.Cancelled(cancelled)) => fail cancelled
                else => {
                }
            }
        }
        if stepped.is_none() {
            break
        }
        handled = true
        discard mut stepper.start_keyed()
    }
    try await mark(marks, marked: Mark.Took(ns: now(clock).saturating_sub(started)))
    return handled
} call_handlers

/// Sends a report of the incarnation `incarnation` to the driver, which a driver that has stopped listening no longer needs.
fn tell(reports: task::Sender[Input], incarnation: u64, take report: Report) fails task::Cancelled uses wait {
    match attempt await reports.send(Input.Report(incarnation: incarnation, report: take report)) {
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} tell

fn mark(marks: task::Sender[Mark], take marked: Mark) fails task::Cancelled uses wait {
    match attempt await marks.send(take marked) {
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} mark

/// The monotonic time in nanoseconds, 0 through a revoked clock.
fn now(clock: sys::Clock) -> u64 {
    return match attempt clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
} now

/// The replies an incarnation's queue holds before a task of its domain hands them to the driver.
const QUEUED_REPLIES: usize = 64

/// The runner capability of an incarnation's component, which takes the replies to the requests it postponed and its requests for checkpoints.
pub open struct Replier {
} Replier

impl Replier: sys::Kind[Pending, u8]

impl Replier: sys::RunnerService

/// The replies of an incarnation's postponed requests waiting for its driver, the signal its replies post, whether its checkpoints are kept and one is asked for, and where the replies' copies are drawn from.
struct Pending {
    replies: mem::Shared[hw::SpinLock[mem::Bounded[Handed, QUEUED_REPLIES]]]
    signal: mem::Shared[hw::Signal[Unit]]
    keeps: bool
    syncing: mem::Shared[core::atomic::AtomicBool]
    alloc: mem::Alloc
} Pending

/// What the component hands its driver: the reply to the request the driver numbered `request`, or the summary it published.
enum Handed {
    Reply(request: u64, reply: sys::Encoded)
    Summary(bytes: mem::Bytes)
} Handed

/// Queues the reply to the request `request` for the driver, its bytes and the handles beside them; unknown when the queue is full.
pub fn Replier.reply(self, request: u64, bytes: Slice[u8], handles: Slice[sys::Handle]) fails sys::RunnerError limits stack 4_096 {
    let queued = sys::reach(self, body: fn(state: Pending, record: u8) -> bool {
        var reply = sys::Encoded.empty(state.alloc)
        mut reply.bytes.append(bytes)
        for handle in handles {
            mut reply.handles.push(handle)
        }
        return state.hand(handed: Handed.Reply(request: request, reply: take reply))
    })
    if queued != Some(true) {
        fail sys::RunnerError.Unknown
    }
} Replier.reply

/// Queues `handed` for the driver and posts the signal; whether the queue had room.
fn Pending.hand(self, take handed: Handed) -> bool {
    var held = Some(take handed)
    return hw::without_irqs(fn[mut held](t: hw::IrqsDisabled) -> bool limits notrap {
        let fitted = self.replies.contents().with(t, body: fn[mut held](mut queue: mem::Bounded[Handed, QUEUED_REPLIES]) -> bool limits notrap, terminates, noalloc {
            let Some(next) = mut held.extract() else {
                return false
            }
            if queue.is_full() {
                return false
            }
            mut queue.push(take next)
            return true
        })
        if fitted {
            self.signal.contents().post(t, value: Unit)
        }
        return fitted
    })
} Pending.hand

pub fn Replier.send_to(
    self,
    port: u64,
    hash: sys::ProtocolHash,
    bytes: Slice[u8],
    handles: Slice[sys::Handle],
    ) fails sys::RunnerError limits stack 4_096 {
    fail sys::RunnerError.Unknown
} Replier.send_to

pub fn Replier.call(
    self,
    port: u64,
    hash: sys::ProtocolHash,
    bytes: Slice[u8],
    handles: Slice[sys::Handle],
    alloc: mem::Alloc,
    ) -> sys::Encoded fails sys::RunnerError limits stack 4_096 {
    fail sys::RunnerError.Unknown
} Replier.call

/// Queues the component's summary for the driver, which publishes it with the instance's record; unknown when the queue is full.
pub fn Replier.publish(self, summary: Slice[u8]) fails sys::RunnerError limits stack 4_096 {
    let queued = sys::reach(self, body: fn(state: Pending, record: u8) -> bool {
        var bytes = mem::Bytes.empty(state.alloc)
        mut bytes.append(summary)
        return state.hand(handed: Handed.Summary(bytes: take bytes))
    })
    if queued != Some(true) {
        fail sys::RunnerError.Unknown
    }
} Replier.publish

/// Asks for a checkpoint of the component once it is idle; unknown when the instance keeps none.
pub fn Replier.sync(self) fails sys::RunnerError limits stack 4_096 {
    let asked = sys::reach(self, body: fn(state: Pending, record: u8) -> bool {
        if state.keeps {
            state.syncing.contents().store(true)
        }
        return state.keeps
    })
    if asked != Some(true) {
        fail sys::RunnerError.Unknown
    }
} Replier.sync

