//! Drivers: the task carrying out one instance's lifecycle, holding its intake, its minted capabilities and the domain of each of its incarnations.

/// How long stopping waits for an instance's keyed tasks before abandoning its domain.
const STOP_GRACE_MS: u64 = 5_000

/// The stack of the first task of an instance's domain, on which its component's handlers run.
const INSTANCE_STACK: usize = 262_144

const NS_PER_MS: u64 = 1_000_000

/// The most bytes of a call's encoding that a dead letter keeps.
const MOST_DEAD_BYTES: usize = 16_384

/// What reaches an instance's driver.
enum Input {
    Order(os::Order)
    Call(os::Call)
    Report(incarnation: u64, report: Report)
    Ended(incarnation: u64, outcome: Result[Ended, sys::Trap])
    Elapsed(incarnation: u64)
    Overran(incarnation: u64)
    Slow(ns: u64)
    Lingered(incarnation: u64)
    Revoke(grants: mem::Set[u64], done: task::Sender[Unit])
    Trace(until_ns: Option[u64])
    /// The dead letter `seq` read for its redelivery under the cause `cause`, and where the order's outcome goes.
    Letter(seq: u64, cause: u64, letter: Result[os::DeadLetter, os::ControlError], done: task::Sender[Result[os::Outcome, os::ControlError]])
    /// The checkpoint read for a restore under the cause `cause`, and where the order's outcome goes.
    Restoring(cause: u64, checkpoint: Result[os::Checkpoint, os::ControlError], done: task::Sender[Result[os::Outcome, os::ControlError]])
    /// The first message the instance waits for falls due, as the task the driver armed `armed`th tells.
    Due(armed: u64)
    Pressed(Pressing)
} Input

/// An instance as its driver holds it, `restoring` the checkpoint its next start restores a copy of, `intake` the length of `queue` for readers of its gauge, `cause` the start cause of its latest incarnation, `changed_by` the cause of the order, trap or call that last changed its lifecycle, under which its next start cause opens, `traced_until` the monotonic time until which its handler calls are traced, `suspended` while its component is, `suspend_ms` the time without a message after which it is, what it publishes of it, `paused` while no call reaches it, with the order `pausing` waiting for its holder to pause, the replay `replaying` running on it and the replay `waking` waiting for it to run; `hibernating` the hibernation order waiting, `hibernation_ordered` once its holder has it, `hibernated` while its next start is a revival, from `image` when hibernation memory keeps it, `delayed` the messages it sent itself that it waits for, armed through `due_armed`, and `next_id` the number of its next call delivered; `messaged_ns` the monotonic time it was last messaged, `hibernated_ns` the time its image was kept, `passed_over` once a hibernation for pressure ended with it running, until a handler runs, and `hibernation_idle` while the hibernation ordered is one for pressure, which only an idle instance takes; causes as a header holds them.
linear struct Driver {
    moniker: ident::Moniker
    slot: u32
    spec: os::InstanceSpec
    lifecycle: Option[os::Lifecycle]
    gate: os::Gate
    incarnation: u64
    traps: u64
    started_ns: u64
    queue: mem::List[Queued]
    intake: mem::Shared[core::atomic::AtomicU32]
    domain: Option[Domain]
    then: Then
    abandonment: Abandonment
    cause: u64
    changed_by: u64
    traced_until: Option[u64]
    restarts: Restarts
    waiters: mem::List[Waiter]
    minted: Minted
    reserved: Option[mem::Heap]
    postponed: mem::List[Outstanding]
    deleting: Option[task::Sender[Result[os::Outcome, os::ControlError]]]
    unplugged: bool
    suspend_ms: Option[u32]
    suspended: bool
    showing: Showing
    restoring: Option[os::Checkpoint]
    paused: bool
    pausing: Option[task::Sender[Result[os::Outcome, os::ControlError]]]
    replaying: Option[Replaying]
    waking: Option[Waking]
    hibernating: Option[task::Sender[Result[os::Outcome, os::ControlError]]]
    hibernation_ordered: bool
    hibernated: bool
    image: Option[KeptImage]
    delayed: mem::List[Delayed]
    due_armed: u64
    next_id: u64
    messaged_ns: u64
    hibernated_ns: u64
    passed_over: bool
    hibernation_idle: bool
    alloc: mem::Alloc
} Driver

/// A replay ordered on a paused instance: its call, the dead letter it delivers again, the branch its Views of `main` reach and the readings its clock and random source serve meanwhile, where its outcome goes, and the cause ordering it.
struct Waking {
    call: os::ForkCall
    redelivery: Option[u64]
    branch: text::String
    recorded: os::Recorded
    done: task::Sender[Result[os::Outcome, os::ControlError]]
    cause: u64
} Waking

/// A replay running on a paused instance: where its outcome goes, its header, and the dead letter it delivers again.
struct Replaying {
    done: task::Sender[Result[os::Outcome, os::ControlError]]
    header: os::Header
    redelivery: Option[u64]
} Replaying

/// The running incarnation's domain: where its calls go, what abandons it, and the call delivered to it whose handler call has not ended.
struct Domain {
    deliveries: task::Sender[Delivery]
    abandoner: mem::Shared[sys::Abandoner]
    outstanding: Option[Outstanding]
} Domain

/// A call waiting in the instance's intake since the monotonic time `since_ns`, the message of the dead letter `redelivery` when it delivers one again.
struct Queued {
    call: os::Call
    since_ns: u64
    redelivery: Option[u64]
} Queued

/// A call delivered to the running domain: its number, where its reply goes, its credit, its header, its encoding when it holds at most `MOST_DEAD_BYTES`, which a dead letter keeps when its handler call is abandoned, for a traced call the span its handler call starts, and the dead letter it delivers again.
struct Outstanding {
    id: u64
    reply: Option[task::Sender[os::Answer]]
    lease: os::Lease
    header: os::Header
    message: Option[mem::Bytes]
    span: Option[Span]
    redelivery: Option[u64]
} Outstanding

/// What follows the stop of the running incarnation.
enum Then derives Copy, Eq {
    Stop
    Restart
} Then

/// Why the runner abandoned the running incarnation's domain from outside.
enum Abandonment derives Copy, Eq {
    Inside
    HandlerLimit
    Lingered
} Abandonment

/// An order waiting for its instance's lifecycle to run, hibernate or fail, to stop, or to differ from the one an order saw, or for its suspension to differ from the one an order saw.
struct Waiter {
    done: task::Sender[Result[os::Outcome, os::ControlError]]
    awaits: Awaited
} Waiter

enum Awaited derives Copy, Eq {
    Running
    Stopped
    Change(seen: Option[os::Lifecycle])
    Suspension(seen: bool)
} Awaited

/// What the tasks a driver spawns need from the runner.
struct Shared[C: Components and Copy and Send, R: Memory and Send] {
    components: C
    memory: R
    config: Config
    directory: task::Cown[Directory]
    orders: task::Sender[os::Order]
    withheld: Withheld
    postings: task::Sender[os::Posting]
    logs: task::Sender[journal::Logged]
    gauges: Gauges
    traced: task::Cown[mem::List[journal::TracedInstance]]
} Shared

/// The driver of the instance `moniker`, not yet created, under `spec`, its calls passing `gate`.
fn Driver.of(
    take moniker: ident::Moniker,
    slot: u32,
    take spec: os::InstanceSpec,
    take gate: os::Gate,
    alloc: mem::Alloc,
    ) -> Driver {
    return Driver(moniker: take moniker, slot: slot, spec: take spec, lifecycle: None, gate: take gate, incarnation: 0, traps: 0, started_ns: 0, queue: mem::List.empty(alloc), intake: mem::Shared.of(core::atomic::AtomicU32.of(0), alloc), domain: None, then: Then.Stop, abandonment: Abandonment.Inside, cause: 0, changed_by: 0, traced_until: None, restarts: Restarts.none(alloc), waiters: mem::List.empty(alloc), minted: Minted.none(alloc), reserved: None, postponed: mem::List.empty(alloc), deleting: None, unplugged: false, suspend_ms: None, suspended: false, showing: Showing.none(), restoring: None, paused: false, pausing: None, replaying: None, waking: None, hibernating: None, hibernation_ordered: false, hibernated: false, image: None, delayed: mem::List.empty(alloc), due_armed: 0, next_id: 0, messaged_ns: 0, hibernated_ns: 0, passed_over: false, hibernation_idle: false, alloc: alloc)
} Driver.of

/// Carries out the lifecycle of the instance `driver` holds, as its inputs come, until they end or the instance, deleted, has stopped, left the directory and had its capabilities revoked; the tasks of its incarnations run in the driver's own scope.
fn Shared.drive[J: Journal and Send](
    self,
    take driver: Driver,
    take inputs: task::Receiver[Input],
    sender: task::Sender[Input],
    journal: J,
    ) fails task::Cancelled uses wait {
    var held = driver
    defer take held.abandon()
    try await journal.name(held.slot, moniker: ident::Moniker(text: held.moniker.text))
    let traced = self.traced.share()
    let config = self.config
    held.traced_until = await when traced => traced_until(traced, moniker: held.moniker, config)
    var receiver = inputs
    try await self.show(mut held)
    try await task::scope(self.config.exec, body: fn[mut held, mut receiver](s: task::Scope) fails task::Cancelled uses wait {
        loop {
            let Some(input) = try await mut receiver.receive() else {
                s.cancel()
                return
            }
            try await self.take_input(mut held, take input, sender, journal, s)
            try await mut held.settle()
            try await self.show(mut held)
            if held.deleted() {
                try await self.retire_state(mut held)
                let moniker = ident::Moniker(text: held.moniker.text)
                let alloc = self.config.alloc
                let directory = self.directory.share()
                await when mut directory {
                    mut directory.remove_instance(moniker, alloc)
                }
                held.gate.set(open: false)
                mut held.minted.clear()
                try await self.unshow(ident::Moniker(text: held.moniker.text))
                match mut held.deleting.extract() {
                    Some(done) => {
                        discard attempt await done.send(Ok(os::Outcome.Done))
                    }
                    None => {
                    }
                }
                s.cancel()
                return
            }
        }
    })
} Shared.drive

/// Whether the instance is deleted and has stopped.
fn Driver.deleted(self) -> bool {
    return self.deleting.is_some() and self.domain.is_none() and match self.lifecycle {
        None or Some(os::Lifecycle.Stopped) or Some(os::Lifecycle.Failed) => true
        else => false
    }
} Driver.deleted

fn Shared.take_input[J: Journal](
    self,
    mut driver: Driver,
    take input: Input,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    let now_ns = now(self.config.clock)
    match input {
        Input.Order(order) => try await self.order(mut driver, take order, sender, journal, s)
        Input.Call(call) => {
            if not driver.takes_calls() {
                try await refuse(take call, answer: os::Answer.Stopped)
                return
            }
            let cause = call.header.cause
            driver.messaged_ns = now_ns
            mut driver.queue.push(Queued(call: take call, since_ns: now_ns, redelivery: None))
            driver.counted()
            if driver.lifecycle == Some(os::Lifecycle.Hibernated) {
                driver.changed_by = cause
                try await self.start(mut driver, sender, journal, s)
            }
            try await mut driver.deliver(now_ns)
        }
        Input.Report(incarnation: incarnation, report: report) => {
            if incarnation != driver.incarnation {
                return
            }
            match report {
                Report.Ending => self.linger(s, inputs: sender.split(), incarnation)
                Report.Hibernation(image: image) => try await self.hibernated(mut driver, outcome: take image, journal, now_ns)
                else => {
                    match try await mut driver.report(take report, journal, now_ns) {
                        Some(noted) => try await self.note(mut driver, take noted, s)
                        None => {
                        }
                    }
                }
            }
        }
        Input.Ended(incarnation: incarnation, outcome: outcome) => {
            if incarnation == driver.incarnation {
                try await self.gauges.unwatch(driver.moniker, alloc: self.config.alloc)
                try await self.ended(mut driver, take outcome, sender, journal, s)
                discard try await self.memory.settle()
            }
        }
        Input.Elapsed(incarnation: incarnation) => {
            if incarnation == driver.incarnation and driver.domain.is_none() and driver.lifecycle == Some(os::Lifecycle.Starting) {
                try await self.start(mut driver, sender, journal, s)
            }
        }
        Input.Overran(incarnation: incarnation) => {
            if incarnation == driver.incarnation {
                driver.abandonment = Abandonment.HandlerLimit
            }
        }
        Input.Slow(ns: ns) => journal.record(driver.slot, cause: driver.at_fault(), event: Event.SlowHandler(ns: ns))
        Input.Lingered(incarnation: incarnation) => {
            if incarnation == driver.incarnation and driver.lifecycle == Some(os::Lifecycle.Stopping) {
                driver.abandonment = Abandonment.Lingered
                driver.trigger()
            }
        }
        Input.Revoke(grants: grants, done: done) => {
            mut driver.minted.revoke(grants)
            discard attempt await done.send(Unit)
        }
        Input.Trace(until_ns: until) => {
            driver.traced_until = until
        }
        Input.Letter(seq: seq, cause: ordering, letter: letter, done: done) => try await self.redeliver(mut driver, seq, cause: ordering, take letter, take done, now_ns, sender, journal, s)
        Input.Restoring(cause: ordering, checkpoint: read, done: done) => try await self.restore(mut driver, cause: ordering, take read, take done, sender, journal, s)
        Input.Due(armed: armed) => {
            if armed == driver.due_armed {
                try await self.fall_due(mut driver, now_ns, sender, journal, s)
            }
        }
        Input.Pressed(pressing) => try await mut driver.pressed(take pressing)
    }
} Shared.take_input

/// A port to the instance of `driver` with the credit `credit`, revoked when the instance is deleted.
fn Shared.ordered_port(self, mut driver: Driver, credit: os::Credit) -> Result[os::Outcome, os::ControlError] fails task::Cancelled uses wait {
    let moniker = ident::Moniker(text: driver.moniker.text)
    let alloc = self.config.alloc
    let directory = self.directory.share()
    let minted = await when directory => directory.mint(moniker, credit, alloc)
    match minted {
        Some(port) => {
            let handle = port.handle()
            mut driver.minted.ordered.push(take port)
            return Ok(os::Outcome.Port(handle))
        }
        None => return Err(os::ControlError.Missing)
    }
} Shared.ordered_port

/// Calls the instance of `driver` with `encoded`, a call of the protocol of hash `hash`, on a task of `s` under the cause `cause`, through a port minted for the call alone and revoked once it is answered or in the instance's intake, telling `done` of its reply.
fn Shared.call(
    self,
    driver: Driver,
    hash: sys::ProtocolHash,
    take encoded: sys::Encoded,
    request: bool,
    take done: task::Sender[Result[os::Outcome, os::ControlError]],
    cause: u64,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    let moniker = ident::Moniker(text: driver.moniker.text)
    let alloc = self.config.alloc
    let directory = self.directory.share()
    let minted = await when directory => directory.mint(moniker, credit: os::Credit(messages: 1, calls: 1), alloc)
    let port = match minted {
        Some(found) => found
        None => {
            discard attempt await done.send(Err(os::ControlError.Missing))
            return
        }
    }
    let header = os::Header.of_work(cause, slot: 0)
    discard s.spawn(fn[take port, take encoded, take done]() fails task::Cancelled uses wait limits stack 16_384 {
        var given = Some(take encoded)
        let answered = attempt await sys::run_headed(header.carried(), body: fn[mut given]() -> sys::Encoded fails os::PortError[Never] uses wait {
            let Some(call) = mut given.extract() else {
                return sys::Encoded.empty(alloc)
            }
            if not request {
                try await port.handle().post(hash, take call)
                return sys::Encoded.empty(alloc)
            }
            return try await port.handle().request(hash, take call, alloc)
        })
        take port.close()
        let outcome: Result[os::Outcome, os::ControlError] = match first answered {
            Ok(reply) => Ok(os::Outcome.Replied(take reply))
            Err(os::PortError.Cancelled(cancelled)) => fail cancelled
            Err(failure) => Err(os::ControlError.Unanswered(take failure))
        }
        discard attempt await done.send(take outcome)
    })
} Shared.call

/// The protocol schema the instance of `driver` serves and the bundle it runs.
fn Shared.described(self, driver: Driver) -> Result[os::Outcome, os::ControlError] {
    return match self.components.schema(driver.spec.component.as_str(), alloc: self.config.alloc) {
        Some(schema) => Ok(os::Outcome.Described(os::Described(schema: take schema, bundle: driver.spec.bundle)))
        None => Err(os::ControlError.Missing)
    }
} Shared.described

/// Restarts the instance from a copy of the checkpoint `read` gives, read for a restore of the cause `cause`, once it has stopped, telling `done` once it runs or fails, or why it cannot.
fn Shared.restore[J: Journal](
    self,
    mut driver: Driver,
    cause: u64,
    take read: Result[os::Checkpoint, os::ControlError],
    take done: task::Sender[Result[os::Outcome, os::ControlError]],
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    let saved = match read {
        Ok(found) => found
        Err(failure) => {
            discard attempt await done.send(Err(take failure))
            return
        }
    }
    driver.changed_by = cause
    driver.restoring = Some(take saved)
    mut driver.waiters.push(Waiter(done: take done, awaits: Awaited.Running))
    try await self.stop(mut driver, then: Then.Restart, journal)
    if driver.lifecycle == Some(os::Lifecycle.Failed) or driver.lifecycle == Some(os::Lifecycle.Stopped) or driver.lifecycle.is_none() {
        try await self.create_or_start(mut driver, sender, journal, s)
    }
} Shared.restore

/// Appends the message of the dead letter `letter` read as the instance's dead letter `seq` to its intake under the cause `cause`, flagged redelivered and noted on the letter once handled, starting a hibernated instance; tells `done` once it is queued, or why it is not.
fn Shared.redeliver[J: Journal](
    self,
    mut driver: Driver,
    seq: u64,
    cause: u64,
    take letter: Result[os::DeadLetter, os::ControlError],
    take done: task::Sender[Result[os::Outcome, os::ControlError]],
    now_ns: u64,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    let read = match letter {
        Ok(found) => found
        Err(failure) => {
            discard attempt await done.send(Err(take failure))
            return
        }
    }
    let Some(message) = read.message else {
        discard attempt await done.send(Err(os::ControlError.DeadLetterEmpty))
        return
    }
    let Some(protocols) = self.components.protocols(driver.spec.component.as_str()) else {
        discard attempt await done.send(Err(os::ControlError.Missing))
        return
    }
    if not driver.takes_calls() {
        discard attempt await done.send(Err(os::ControlError.Stopped))
        return
    }
    let alloc = self.config.alloc
    var encoded = sys::Encoded.empty(alloc)
    mut encoded.bytes.append(message.view())
    mut driver.queue.push(Queued(call: os::Call(hash: protocols.own, encoded: take encoded, reply: None, lease: os::Lease.free(alloc), header: os::Header.redelivered(cause)), since_ns: now_ns, redelivery: Some(seq)))
    driver.counted()
    if driver.lifecycle == Some(os::Lifecycle.Hibernated) {
        driver.changed_by = cause
        try await self.start(mut driver, sender, journal, s)
    }
    try await mut driver.deliver(now_ns)
    discard attempt await done.send(Ok(os::Outcome.Done))
} Shared.redeliver

/// Notes `noted` on its dead letter from a task of `s`, through the instance's View of `/state`.
fn Shared.note(self, mut driver: Driver, take noted: Noted, s: task::Scope) fails task::Cancelled uses wait {
    let alloc = self.config.alloc
    let directory = self.directory.share()
    let moniker = ident::Moniker(text: driver.moniker.text)
    let minted = await when directory => directory.state_view(mut driver.minted, moniker: ident::Moniker(text: moniker.text), principal: ident::Principal(text: driver.spec.principal.text), alloc)
    let Some(view) = minted else {
        return
    }
    discard s.spawn(fn[take noted, take moniker]() fails task::Cancelled uses wait limits stack 32_768 {
        try await note_redelivery(view, moniker, take noted, alloc)
    })
} Shared.note

/// Reads, from a task of `s`, the dead letter `seq` or the checkpoint `number` of the instance through its View of `/state` for an order of the cause `cause`, handing what it read to the driver through `sender` with `done`; a checkpoint of an instance keeping none is `instance.volatile`.
fn Shared.read_state(
    self,
    mut driver: Driver,
    take reading: Reading,
    cause: u64,
    take done: task::Sender[Result[os::Outcome, os::ControlError]],
    sender: task::Sender[Input],
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    let checkpointed = driver.spec.durability.class == os::DurabilityClass.Checkpointed
    match first reading {
        Reading.Checkpoint(number: _) if not checkpointed => {
            discard attempt await done.send(Err(os::ControlError.Volatile))
            return
        }
        else => {
        }
    }
    let alloc = self.config.alloc
    let directory = self.directory.share()
    let moniker = ident::Moniker(text: driver.moniker.text)
    let minted = await when directory => directory.state_view(mut driver.minted, moniker: ident::Moniker(text: moniker.text), principal: ident::Principal(text: driver.spec.principal.text), alloc)
    let Some(view) = minted else {
        discard attempt await done.send(Err(os::ControlError.Missing))
        return
    }
    let inputs = sender.split()
    discard s.spawn(fn[take reading, take moniker, take done, take inputs]() fails task::Cancelled uses wait limits stack 32_768 {
        let input = match reading {
            Reading.Letter(seq: seq) => Input.Letter(seq: seq, cause: cause, letter: try await read_dead(view, moniker, seq, alloc), done: take done)
            Reading.Checkpoint(number: number) => Input.Restoring(cause: cause, checkpoint: try await read_checkpoint(view, moniker, number, alloc), done: take done)
        }
        discard attempt await inputs.send(take input)
    })
} Shared.read_state

/// What an order reads of an instance's `/state`: its dead letter `seq`, or its checkpoint `number`.
enum Reading {
    Letter(seq: u64)
    Checkpoint(number: u64)
} Reading

/// Carries out a `Control` order.
fn Shared.order[J: Journal](
    self,
    mut driver: Driver,
    take order: os::Order,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    let os::Order(action: action, moniker: _, grant: _, done: done, cause: cause) = order
    match action {
        os::Action.Start or os::Action.Stop or os::Action.Restart or os::Action.Delete(unplugged: _) or os::Action.Hibernate or os::Action.Wake => {
            driver.changed_by = cause
        }
        else => {
        }
    }
    match action {
        os::Action.Read => try await driver.tell_lifecycle(take done)
        os::Action.Port(credit: credit) => {
            let minted = try await self.ordered_port(mut driver, credit)
            discard attempt await done.send(take minted)
        }
        os::Action.Delete(unplugged: unplugged) => {
            driver.deleting = Some(take done)
            driver.unplugged = unplugged
            try await self.stop(mut driver, then: Then.Stop, journal)
        }
        os::Action.Changed(seen: seen) => mut driver.waiters.push(Waiter(done: take done, awaits: Awaited.Change(seen: seen)))
        os::Action.SuspendAfter(ms: ms) => {
            driver.suspend_ms = ms
            match driver.domain {
                Some(domain) => {
                    discard attempt await domain.deliveries.send(Delivery.SuspendAfter(ms: ms.value_or(0)))
                }
                None => {
                }
            }
            discard attempt await done.send(Ok(os::Outcome.Done))
        }
        os::Action.Suspended(seen: seen) => mut driver.waiters.push(Waiter(done: take done, awaits: Awaited.Suspension(seen: seen)))
        os::Action.Converge(desired: desired) => {
            if desired > driver.showing.desired {
                driver.showing.desired = desired
            }
            discard attempt await done.send(Ok(os::Outcome.Done))
        }
        os::Action.Describe => {
            discard attempt await done.send(self.described(driver))
        }
        os::Action.Redeliver(seq: seq) => try await self.read_state(mut driver, reading: Reading.Letter(seq: seq), cause, take done, sender, s)
        os::Action.Restore(number: number) => try await self.read_state(mut driver, reading: Reading.Checkpoint(number: number), cause, take done, sender, s)
        os::Action.Fork(forking: forking) => try await self.fork(mut driver, take forking, take done, s)
        os::Action.Call(hash: hash, encoded: encoded, request: request) => try await self.call(driver, hash, take encoded, request, take done, cause, s)
        os::Action.Start => {
            mut driver.waiters.push(Waiter(done: take done, awaits: Awaited.Running))
            try await self.create_or_start(mut driver, sender, journal, s)
        }
        os::Action.Stop => {
            mut driver.waiters.push(Waiter(done: take done, awaits: Awaited.Stopped))
            try await self.stop(mut driver, then: Then.Stop, journal)
        }
        os::Action.Restart => {
            mut driver.waiters.push(Waiter(done: take done, awaits: Awaited.Running))
            try await self.stop(mut driver, then: Then.Restart, journal)
            if driver.lifecycle == Some(os::Lifecycle.Failed) or driver.lifecycle == Some(os::Lifecycle.Stopped) or driver.lifecycle.is_none() {
                try await self.create_or_start(mut driver, sender, journal, s)
            }
        }
        os::Action.Replay(call: call, redelivery: redelivery, branch: branch, recorded: recorded) => try await self.replay(mut driver, waking: Waking(call: take call, redelivery: redelivery, branch: take branch, recorded: take recorded, done: take done, cause: cause), sender, journal, s)
        os::Action.Hibernate => try await mut driver.order_hibernation(take done, only_idle: false)
        os::Action.Wake => try await self.wake(mut driver, take done, sender, journal, s)
        else => try await mut driver.pause_order(take action, take done, cause, now_ns: now(self.config.clock))
    }
    try await mut driver.settle()
} Shared.order

/// Tells `done` the instance's lifecycle, `port.no-target` before it is created.
fn Driver.tell_lifecycle(self, take done: task::Sender[Result[os::Outcome, os::ControlError]]) fails task::Cancelled uses wait {
    let answer: Result[os::Outcome, os::ControlError] = match self.lifecycle {
        Some(lifecycle) => Ok(os::Outcome.Lifecycle(lifecycle))
        None => Err(os::ControlError.Missing)
    }
    discard attempt await done.send(take answer)
} Driver.tell_lifecycle

/// Replays `waking` on the paused instance as `Driver.replay` does: at once, or, while the instance hibernates, once the start this begins has it running.
fn Shared.replay[J: Journal](
    self,
    mut driver: Driver,
    take waking: Waking,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    if driver.lifecycle != Some(os::Lifecycle.Hibernated) or not driver.paused or driver.waking.is_some() {
        try await mut driver.replay(take waking)
        return
    }
    driver.changed_by = waking.cause
    driver.waking = Some(take waking)
    try await self.start(mut driver, sender, journal, s)
} Shared.replay

/// Carries out `action` when it pauses or resumes the instance, or releases or drops what its replays keep, telling `done`; `request.invalid-operand` for any other action.
fn Driver.pause_order(
    mut self,
    take action: os::Action,
    take done: task::Sender[Result[os::Outcome, os::ControlError]],
    cause: u64,
    now_ns: u64,
    ) fails task::Cancelled uses wait {
    match action {
        os::Action.Pause => {
            if self.paused {
                discard attempt await done.send(Ok(os::Outcome.Done))
                return
            }
            self.paused = true
            self.pausing = Some(take done)
            try await mut self.pause_holder()
        }
        os::Action.Resume => {
            try await mut self.resume(now_ns)
            discard attempt await done.send(Ok(os::Outcome.Done))
        }
        os::Action.Release(kept: kept) => try await self.hold_order(HolderOrder.Release(kept: take kept, done: take done))
        os::Action.Deliver(kept: kept) => try await self.hold_order(HolderOrder.Deliver(kept: kept, done: take done))
        os::Action.Discard => try await self.hold_order(HolderOrder.Discard(done: take done))
        else => {
            discard attempt await done.send(Err(os::ControlError.Invalid))
        }
    }
} Driver.pause_order

/// Creates the instance from its specification, or starts it from `stopped` or `failed`: it hibernates when lazy, and starts at once otherwise.
fn Shared.create_or_start[J: Journal](
    self,
    mut driver: Driver,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    match driver.lifecycle {
        None or Some(os::Lifecycle.Stopped) or Some(os::Lifecycle.Failed) => {
        }
        else => return
    }
    if driver.lifecycle == Some(os::Lifecycle.Failed) {
        driver.restarts = Restarts.none(self.config.alloc)
    }
    driver.spec.stopped = false
    driver.gate.set(open: true)
    if driver.spec.lazy {
        driver.lifecycle = Some(os::Lifecycle.Hibernated)
        return
    }
    try await self.start(mut driver, sender, journal, s)
} Shared.create_or_start

/// Starts a new incarnation: draws its cell and account, builds its world, and runs its domain.
fn Shared.start[J: Journal](
    self,
    mut driver: Driver,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    driver.lifecycle = Some(os::Lifecycle.Starting)
    driver.abandonment = Abandonment.Inside
    driver.cause = driver.changed_by
    driver.suspended = false
    driver.started_ns = now(self.config.clock)
    let revival = driver.hibernated
    driver.hibernated = false
    var keeping: Option[Keeping] = None
    var restore: Option[os::Checkpoint] = None
    match try await self.restoring(mut driver, revival) {
        Restoring.Fresh(keeping: kept) => {
            keeping = kept
        }
        Restoring.From(keeping: kept, checkpoint: saved) => {
            keeping = Some(kept)
            if saved.incarnation > driver.incarnation {
                driver.incarnation = saved.incarnation
            }
            restore = Some(take saved)
        }
        Restoring.Revived(keeping: kept, checkpoint: saved) => {
            keeping = kept
            restore = Some(take saved)
        }
        Restoring.Unreadable => {
            try await self.give_up(mut driver, journal, cause: driver.cause)
            return
        }
    }
    if not revival {
        driver.incarnation += 1
    }
    driver.cause = journal.open(driver.slot, moniker: ident::Moniker(text: driver.moniker.text), incarnation: driver.incarnation, parent: driver.changed_by)
    let config = try await self.configuration(mut driver)
    let budget = match try await self.cell(mut driver) {
        Ok(cell) => cell
        Err(code) => {
            mut driver.showing.faulted(text::String.of(code.as_str(), alloc: self.config.alloc))
            try await self.give_up(mut driver, journal, cause: driver.cause)
            return
        }
    }
    let account = self.config.exec.split_on(self.config.share(driver.spec.share), alloc: budget.alloc())
    var sources = Some(Sources(clock: self.config.clock, random: self.config.random))
    if self.components.forkable(driver.spec.component.as_str()) {
        sources = mut driver.minted.taped_sources(clock: self.config.clock, random: self.config.random, alloc: self.config.alloc)
    }
    let Some(drawn) = sources else {
        take account.close()
        take budget.close()
        try await self.give_up(mut driver, journal, cause: driver.cause)
        return
    }
    let request = Request(moniker: ident::Moniker(text: driver.moniker.text), cell: budget.alloc(), exec: account.executor(), clock: drawn.clock, random: drawn.random, withheld: self.withheld, orders: self.orders.split(), logs: self.logs.split(), forking: None, alloc: self.config.alloc)
    let directory = self.directory.share()
    let built = await when directory => directory.world(driver.spec, minted: mut driver.minted, request)
    let Some(world) = built else {
        take account.close()
        take budget.close()
        try await self.give_up(mut driver, journal, cause: driver.cause)
        return
    }
    let task::Channel(sender: deliveries, receiver: delivered) = task::Channel[Delivery].bounded(2, alloc: self.config.alloc)
    let task::Channel(sender: marks, receiver: marked) = task::Channel[Mark].bounded(2, alloc: self.config.alloc)
    let ending = marks.split()
    let gauged = marks.split()
    let abandoner = mem::Shared.of(sys::Abandoner.new(), alloc: self.config.alloc)
    let serving = Serving(deliveries: take delivered, reports: sender.split(), marks: take marks, incarnation: driver.incarnation, clock: self.config.clock, abandoner: abandoner.share(), suspend_ms: driver.suspend_ms.value_or(0), keeping: keeping, restore: take restore, revival: revival, config: take config, forking: None)
    let exec = account.executor()
    let alloc = budget.alloc()
    let held = Held(budget: take budget, reserved: driver.spec.budget.reserved, account: take account, class: driver.spec.share.class, intake: driver.intake.share(), bundle: driver.spec.bundle, traps: driver.traps)
    self.launch(s, component: text::String.of(driver.spec.component.as_str(), alloc: self.config.alloc), take world, take serving, exec, alloc, abandoner: abandoner.share(), take ending, ended: sender.split(), incarnation: driver.incarnation, header: os::Header.of_work(cause: driver.cause, slot: driver.slot))
    self.watch(s, marks: take marked, take held, abandoner: abandoner.share(), inputs: sender.split(), incarnation: driver.incarnation, handlers: driver.spec.handlers)
    driver.domain = Some(Domain(deliveries: take deliveries, abandoner: take abandoner, outstanding: None))
    try await self.gauges.watch(ident::Moniker(text: driver.moniker.text), watch: take gauged, alloc: self.config.alloc)
} Shared.start

/// The cell of a new incarnation: split from the node pool at the specification's limit, `budget.memory-pressure` while the pool is at the top pressure level; or for a reserved instance from the store over its region, which its first start takes and later starts reuse, `budget.over-reservation` when no free range holds the region.
fn Shared.cell(self, mut driver: Driver) -> Result[mem::Budget, text::Fixed[32]] fails task::Cancelled uses wait {
    let limit = driver.spec.budget.limit
    if not driver.spec.budget.reserved {
        if try await self.memory.settle() >= TOP_LEVEL {
            return Err(text::Fixed[32].of("budget.memory-pressure"))
        }
        return Ok(self.config.pool.split(usize.widen(limit)))
    }
    if driver.reserved.is_none() {
        driver.reserved = try await self.memory.reserve(limit)
    }
    let Some(store) = driver.reserved else {
        return Err(text::Fixed[32].of("budget.over-reservation"))
    }
    return Ok(store.alloc().split(usize.widen(limit)))
} Shared.cell

/// What an incarnation's watch holds: its cell, whether a reserved region supplies it, its account, its account's CPU class, and the length of its instance's queue.
linear struct Held {
    budget: mem::Budget
    reserved: bool
    account: task::Account
    class: os::CpuClass
    intake: mem::Shared[core::atomic::AtomicU32]
    bundle: ident::HashValue
    traps: u64
} Held

/// The handler calls an incarnation's watch counted: how many, by run time in the buckets of `os::Gauge`.
struct Calls derives Copy {
    count: u64
    latency: Array[u64, 32]
} Calls

/// The gauge of the incarnation `incarnation` that `held` keeps, its handler calls being `calls`.
fn Held.gauge(self, incarnation: u64, calls: Calls) -> os::Gauge {
    return os::Gauge(intake: self.intake.contents().load(), memory: os::Usage(charged: u64.widen(self.budget.charged()), limit: u64.widen(self.budget.limit()), peak: u64.widen(self.budget.peak())), reserved: self.reserved, cpu_ns: self.account.used_ns(), class: self.class, bundle: self.bundle, incarnation: incarnation, messages: calls.count, latency: calls.latency, traps: self.traps)
} Held.gauge

/// The bucket of a handler call that ran `ns`: 0 below 1 µs, k from 2^(k−1) to 2^k µs, 31 beyond.
fn latency_bucket(ns: u64) -> usize {
    var micros = ns / 1_000
    var bucket: usize = 0
    while micros > 0 and bucket < 31 {
        micros = micros >> 1
        bucket += 1
    }
    return bucket
} latency_bucket

/// Runs an incarnation's domain under `header` on a task of `s` through `exec` and `alloc`, then tells its watch, through `ending`, and its driver how it ended.
fn Shared.launch(
    self,
    s: task::Scope,
    take component: text::String,
    take world: nanos::World,
    take serving: Serving,
    exec: task::Executor,
    alloc: mem::Alloc,
    take abandoner: mem::Shared[sys::Abandoner],
    take ending: task::Sender[Mark],
    take ended: task::Sender[Input],
    incarnation: u64,
    header: os::Header,
    ) {
    let components = self.components
    discard s.spawn(fn[take component, take world, take serving, take abandoner, take ending, take ended]() fails task::Cancelled uses wait limits stack 16_384 {
        let ran = attempt await abandoner.contents().run_sized(fn[take component, take world, take serving]() -> Ended fails task::Cancelled uses wait limits stack 131_072 {
            var given = Some(Launched(component: take component, world: take world, serving: take serving))
            return try await sys::run_headed(header.carried(), body: fn[mut given]() -> Ended fails task::Cancelled uses wait {
                let Some(Launched(component: path, world: built, serving: served)) = mut given.extract() else {
                    return Ended.Stopped
                }
                return try await components.serve(path.as_str(), world: take built, serving: take served)
            })
        }, stack: INSTANCE_STACK, exec, alloc)
        discard attempt await ending.send(Mark.Ended)
        let outcome = match ran {
            Ok(result) => result
            Err(cancelled) => fail cancelled
        }
        discard attempt await ended.send(Input.Ended(incarnation: incarnation, outcome: take outcome))
    })
} Shared.launch

/// What the first task of an incarnation's domain runs: the path of its component, its world and what it serves.
struct Launched {
    component: text::String
    world: nanos::World
    serving: Serving
} Launched

/// Watches an incarnation's handlers on a task of `s`, answering the readings of its gauge from `held` until its domain has ended, then closes its account and cell: a handler call past `handlers.handler_s` abandons the domain, and one of `handlers.slow_ms` or more is reported slow.
fn Shared.watch(
    self,
    s: task::Scope,
    take marks: task::Receiver[Mark],
    take held: Held,
    take abandoner: mem::Shared[sys::Abandoner],
    take inputs: task::Sender[Input],
    incarnation: u64,
    handlers: os::Limits,
    ) {
    let clock = self.config.clock
    discard s.spawn(fn[take marks, take held, take abandoner, take inputs]() fails task::Cancelled uses wait limits stack 16_384 {
        let watched = attempt await watch_marks(take marks, held, abandoner, inputs, clock, incarnation, handlers)
        let Held(budget: budget, reserved: _, account: account, class: _, intake: _, bundle: _, traps: _) = held
        take account.close()
        take budget.close()
        match watched {
            Ok(_) => {
            }
            Err(cancelled) => fail cancelled
        }
    })
} Shared.watch

/// Takes the marks of an incarnation until its domain has ended, bounding each handler call it tells of and answering each reading with the gauge of `held`.
fn watch_marks(
    take marks: task::Receiver[Mark],
    held: Held,
    abandoner: mem::Shared[sys::Abandoner],
    inputs: task::Sender[Input],
    clock: sys::Clock,
    incarnation: u64,
    handlers: os::Limits,
    ) fails task::Cancelled uses wait {
    var receiver = marks
    var overran_at: Option[u64] = None
    var calls = Calls(count: 0, latency: Array[u64, 32].filled(0))
    loop {
        var received: Option[Mark] = None
        match overran_at {
            None => {
                received = try await mut receiver.receive()
            }
            Some(at) => {
                let left = at.saturating_sub(now(clock))
                let within = try await task::within_ns(clock, ns: left, body: fn[mut receiver]() -> Option[Mark] fails task::Cancelled uses wait {
                    return try await mut receiver.receive()
                })
                match within {
                    Some(given) => {
                        received = given
                    }
                    None => {
                        overran_at = None
                        discard attempt await inputs.send(Input.Overran(incarnation: incarnation))
                        abandoner.contents().trigger()
                        continue
                    }
                }
            }
        }
        match received {
            Some(Mark.Began) => {
                overran_at = Some(now(clock).saturating_add(u64.widen(handlers.handler_s) * 1_000 * NS_PER_MS))
            }
            Some(Mark.Took(ns: ns)) => {
                overran_at = None
                calls.count += 1
                calls.latency[latency_bucket(ns)] += 1
                if ns >= u64.widen(handlers.slow_ms) * NS_PER_MS {
                    discard attempt await inputs.send(Input.Slow(ns: ns))
                }
            }
            Some(Mark.Read(reply: reply)) => {
                discard attempt await reply.send(held.gauge(incarnation, calls))
            }
            else => return
        }
    }
} watch_marks

/// Stops the instance, or has it start again once stopped when `then` is `Restart`: queued calls stay for a restart and are dropped or failed for a stop, what a hibernation left it is dropped, and an instance not yet created is created `stopped`.
fn Shared.stop[J: Journal](self, mut driver: Driver, then: Then, journal: J) fails task::Cancelled uses wait {
    mut driver.forget_hibernation()
    if then == Then.Stop {
        driver.spec.stopped = true
        driver.gate.set(open: false)
        try await mut driver.refuse_queued()
    }
    match driver.lifecycle {
        Some(os::Lifecycle.Running) => {
        }
        Some(os::Lifecycle.Stopping) => {
            driver.then = then
            return
        }
        Some(os::Lifecycle.Starting) or Some(os::Lifecycle.Hibernated) => {
            if driver.domain.is_none() {
                mut driver.stopped(journal, abandoned: false)
                return
            }
        }
        None => {
            if then == Then.Stop {
                driver.lifecycle = Some(os::Lifecycle.Stopped)
            }
            return
        }
        else => return
    }
    driver.lifecycle = Some(os::Lifecycle.Stopping)
    driver.then = then
    let Some(domain) = driver.domain else {
        return
    }
    discard attempt await domain.deliveries.send(Delivery.Stop)
} Shared.stop

/// Handles the end of the running incarnation's domain: a stop it was asked for, or an abandonment and the restart policy.
fn Shared.ended[J: Journal](
    self,
    mut driver: Driver,
    take outcome: Result[Ended, sys::Trap],
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    match first outcome {
        Ok(Ended.Hibernated) => {
            try await self.slept(mut driver, sender, journal, s)
            try await mut driver.settle()
            return
        }
        else => {
        }
    }
    let dead = match first outcome {
        Err(_) if driver.abandonment != Abandonment.Lingered => driver.handled_message()
        else => None
    }
    let trapped = driver.at_fault()
    let running = driver.running_span(now_ns: now(self.config.clock))
    try await mut driver.end_domain()
    match outcome {
        Ok(Ended.Stopped) or Ok(Ended.Hibernated) => {
            mut driver.stopped(journal, abandoned: false)
            if driver.then == Then.Restart {
                try await self.create_or_start(mut driver, sender, journal, s)
            }
        }
        Ok(Ended.EnvIncomplete) or Ok(Ended.Unhealthy) or Ok(Ended.CheckpointUndecodable) => try await self.give_up(mut driver, journal, cause: driver.cause)
        Err(trap) => {
            match running {
                Some(span) => {
                    var ended = span
                    ended.trapped = Some(trap.kind())
                    journal.span(driver.slot, span: ended)
                }
                None => {
                }
            }
            if driver.abandonment == Abandonment.Lingered {
                mut driver.stopped(journal, abandoned: true)
                if driver.then == Then.Restart {
                    try await self.create_or_start(mut driver, sender, journal, s)
                }
            } else {
                match dead {
                    Some(handled) => try await self.record_dead(mut driver, trap, take handled, s)
                    None => {
                    }
                }
                try await self.abandoned(mut driver, kind: trap.kind(), trapped, sender, journal, s)
            }
        }
    }
    try await mut driver.settle()
} Shared.ended

/// The call whose handler call is running: its header, and a copy of its encoding when the driver kept one; `None` when no handler call runs.
fn Driver.handled_message(self) -> Option[Handled] {
    let Some(domain) = self.domain else {
        return None
    }
    let Some(outstanding) = domain.outstanding else {
        return None
    }
    let Some(kept) = outstanding.message else {
        return Some(Handled(header: outstanding.header, message: None, redelivery: outstanding.redelivery))
    }
    var message = mem::Bytes.empty(self.alloc)
    mut message.append(kept.view())
    return Some(Handled(header: outstanding.header, message: Some(take message), redelivery: outstanding.redelivery))
} Driver.handled_message

/// The call a handler call was handling: its header, its encoding when kept, and the dead letter it delivered again.
struct Handled {
    header: os::Header
    message: Option[mem::Bytes]
    redelivery: Option[u64]
} Handled

/// The outcome of the delivery again of the dead letter `seq`.
struct Noted {
    seq: u64
    redelivery: os::Redelivery
} Noted

/// The name of the operation `message` calls, empty when it was not kept.
fn operation_in(message: Option[mem::Bytes], alloc: mem::Alloc) -> text::String {
    return match message {
        Some(kept) => operation_of(kept.view(), alloc)
        None => text::String.empty(alloc)
    }
} operation_in

/// The cause of the work running in the domain: the call whose handler call runs, else the incarnation's start.
fn Driver.at_fault(self) -> u64 {
    let Some(domain) = self.domain else {
        return self.cause
    }
    let Some(outstanding) = domain.outstanding else {
        return self.cause
    }
    return outstanding.header.cause
} Driver.at_fault

/// The span of the handler call of the outstanding call when traced, ending at `now_ns`.
fn Driver.running_span(self, now_ns: u64) -> Option[Span] {
    let Some(domain) = self.domain else {
        return None
    }
    let Some(outstanding) = domain.outstanding else {
        return None
    }
    let Some(begun) = outstanding.span else {
        return None
    }
    var span = begun
    span.run_ns = now_ns.saturating_sub(span.start_ns)
    return Some(span)
} Driver.running_span

/// Records the call `handled`, which the handler call of the incarnation `trap` abandoned was handling, as the instance's next dead letter with the call's header, written from a task of `s` through the instance's View of `/state`; a dead letter it delivered again notes that it became this one.
fn Shared.record_dead(
    self,
    mut driver: Driver,
    trap: sys::Trap,
    take handled: Handled,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    let Handled(header: header, message: message, redelivery: redelivery) = handled
    let alloc = self.config.alloc
    var bytes = Array[u8, 24].filled(0)
    let carried = header.to_bits()
    for at in 0..<bytes.len() {
        bytes[at] = carried[at]
    }
    let operation = operation_in(message, alloc)
    var kind = text::String.empty(alloc)
    mut kind.write(Dyn[Render].view(trap.kind()), budget: 64)
    var report = text::String.empty(alloc)
    mut report.write(Dyn[Render].view(trap), budget: 1_024)
    let letter = os::DeadLetter(seq: 0, incarnation: driver.incarnation, time: self.config.wall.now(self.config.clock), header: bytes, sender: None, operation: take operation, message: take message, kind: take kind, report: take report, redeliveries: mem::List.empty(alloc))
    let directory = self.directory.share()
    let moniker = ident::Moniker(text: driver.moniker.text)
    let principal = ident::Principal(text: driver.spec.principal.text)
    let minted = await when directory => directory.state_view(mut driver.minted, moniker: ident::Moniker(text: moniker.text), take principal, alloc)
    let Some(view) = minted else {
        return
    }
    let keep = driver.deleting.is_none()
    discard s.spawn(fn[take letter, take moniker]() fails task::Cancelled uses wait limits stack 32_768 {
        let written = try await write_dead(take letter, view, moniker: ident::Moniker(text: moniker.text), keep, alloc)
        let Some(original) = redelivery else {
            return
        }
        let Some(seq) = written else {
            return
        }
        try await note_redelivery(view, moniker, noted: Noted(seq: original, redelivery: os::Redelivery(cause: header.named_cause(), outcome: os::Redelivered.Dead(seq: seq))), alloc)
    })
} Shared.record_dead

/// Applies the restart policy after an abandonment of kind `kind` in work of the cause `trapped`: a restart under it after the backoff, or `failed`.
fn Shared.abandoned[J: Journal](
    self,
    mut driver: Driver,
    kind: sys::TrapKind,
    trapped: u64,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    if kind == sys::TrapKind.Exception {
        journal.record(driver.slot, cause: trapped, event: Event.Integrity(incarnation: driver.incarnation))
    }
    journal.record(driver.slot, cause: trapped, event: Event.Trapped(incarnation: driver.incarnation, kind: kind, limit: driver.abandonment == Abandonment.HandlerLimit))
    driver.changed_by = trapped
    driver.traps += 1
    mut driver.forget_hibernation()
    var code = text::String.empty(self.config.alloc)
    mut code.write(Dyn[Render].view(kind), budget: 64)
    mut driver.showing.faulted(take code)
    let supervisor = driver.moniker.text.as_str() == "supervisor"
    let policy = driver.spec.restart.policy
    if policy == os::RestartPolicy.Temporary and not supervisor {
        try await self.give_up(mut driver, journal, cause: trapped)
        return
    }
    match mut driver.restarts.next(driver.spec.restart, bounded: not supervisor, started_ns: driver.started_ns, now_ns: now(self.config.clock)) {
        Next.Fail => try await self.give_up(mut driver, journal, cause: trapped)
        Next.After(ns: ns) => {
            driver.lifecycle = Some(os::Lifecycle.Starting)
            self.elapse(s, ns, inputs: sender.split(), incarnation: driver.incarnation)
        }
    }
} Shared.abandoned

/// Tells the driver on a task of `s` when incarnation `incarnation` has spent the grace that ending its keyed tasks has, after which the driver abandons its domain.
fn Shared.linger(self, s: task::Scope, take inputs: task::Sender[Input], incarnation: u64) {
    let clock = self.config.clock
    discard s.spawn(fn[take inputs]() fails task::Cancelled uses wait limits stack 8_192 {
        try await clock.sleep(STOP_GRACE_MS)
        discard attempt await inputs.send(Input.Lingered(incarnation: incarnation))
    })
} Shared.linger

/// Tells the driver on a task of `s` that the backoff of `ns` before the restart of incarnation `incarnation` has elapsed.
fn Shared.elapse(
    self,
    s: task::Scope,
    ns: u64,
    take inputs: task::Sender[Input],
    incarnation: u64,
    ) {
    let clock = self.config.clock
    discard s.spawn(fn[take inputs]() fails task::Cancelled uses wait limits stack 8_192 {
        try await clock.sleep_ns(ns)
        discard attempt await inputs.send(Input.Elapsed(incarnation: incarnation))
    })
} Shared.elapse

/// Sends the instance to `failed` in work of the cause `cause`: its queued calls are dropped or failed, and its gate closes.
fn Shared.give_up[J: Journal](self, mut driver: Driver, journal: J, cause: u64) fails task::Cancelled uses wait {
    driver.lifecycle = Some(os::Lifecycle.Failed)
    driver.gate.set(open: false)
    try await mut driver.refuse_queued()
    journal.record(driver.slot, cause, event: Event.Failed(restarts: u32.fit(driver.restarts.times.len())))
} Shared.give_up

/// Records the instance stopped, by the order that last changed its lifecycle.
fn Driver.stopped[J: Journal](mut self, journal: J, abandoned: bool) {
    self.lifecycle = Some(os::Lifecycle.Stopped)
    journal.record(self.slot, cause: self.changed_by, event: Event.Stopped(abandoned: abandoned))
} Driver.stopped

/// Handles what the domain reports at `now_ns`: that it runs, that it took a call, a request's answer, that its component was suspended or woken, or that a checkpoint failed; gives the outcome of a dead letter delivered again once taken.
fn Driver.report[J: Journal](mut self, take report: Report, journal: J, now_ns: u64) -> Option[Noted] fails task::Cancelled uses wait {
    var noted: Option[Noted] = None
    match report {
        Report.Running(from: from) => {
            if self.lifecycle == Some(os::Lifecycle.Starting) {
                self.lifecycle = Some(os::Lifecycle.Running)
                journal.record(self.slot, cause: self.cause, event: Event.Started(incarnation: self.incarnation, from: from))
            }
        }
        Report.CheckpointFailed(code: code, bytes: bytes) => journal.record(self.slot, cause: 0, event: Event.CheckpointFailed(code: code, bytes: bytes))
        Report.Published(summary: summary) => mut self.showing.summarize(take summary)
        Report.Replayed(outcome: outcome) => {
            noted = try await mut self.replayed(take outcome)
        }
        Report.Taken(id: id) => {
            let taken = mut self.take_outstanding(id, request: false, journal, now_ns)
            match taken {
                Some(outstanding) => {
                    match outstanding.redelivery {
                        Some(seq) => {
                            noted = Some(Noted(seq: seq, redelivery: os::Redelivery(cause: outstanding.header.named_cause(), outcome: os::Redelivered.Handled)))
                        }
                        None => {
                        }
                    }
                    try await take outstanding.lease.release()
                }
                None => {
                }
            }
        }
        Report.Ending or Report.Hibernation(image: _) => {
        }
        Report.Suspended => {
            self.suspended = true
        }
        Report.Woken => {
            self.suspended = false
        }
        Report.Postponed(id: id) => {
            let postponed = mut self.take_outstanding(id, request: true, journal, now_ns)
            match postponed {
                Some(outstanding) => mut self.postponed.push(take outstanding)
                None => {
                }
            }
        }
        Report.Answered(id: id, answer: answer) => {
            var answered = mut self.take_outstanding(id, request: true, journal, now_ns)
            if answered.is_none() {
                answered = mut self.take_postponed(id)
            }
            match answered {
                Some(outstanding) => {
                    match outstanding.reply {
                        Some(reply) => {
                            discard attempt await reply.send(take answer)
                        }
                        None => {
                        }
                    }
                    try await take outstanding.lease.release()
                }
                None => {
                }
            }
        }
    }
    try await mut self.deliver(now_ns)
    try await mut self.settle()
    return noted
} Driver.report

/// The outstanding call `id` when its handler call ends at `now_ns`, recording its span when traced: a one-way call once taken, a request once answered or postponed.
fn Driver.take_outstanding[J: Journal](
    mut self,
    id: u64,
    request: bool,
    journal: J,
    now_ns: u64,
    ) -> Option[Outstanding] {
    let Some(domain) = mut self.domain.extract() else {
        return None
    }
    var current = domain
    var ended: Option[Outstanding] = None
    if current.ends(id, request) {
        ended = mut current.outstanding.extract()
    }
    self.domain = Some(take current)
    let Some(found) = ended else {
        return None
    }
    var outstanding = found
    match mut outstanding.span.extract() {
        Some(begun) => {
            var span = begun
            span.run_ns = now_ns.saturating_sub(span.start_ns)
            journal.span(self.slot, span)
        }
        None => {
        }
    }
    return Some(take outstanding)
} Driver.take_outstanding

/// The postponed request `id`, which its answer ends.
fn Driver.take_postponed(mut self, id: u64) -> Option[Outstanding] {
    var at: usize = 0
    while at < self.postponed.len() {
        if self.postponed[at].id == id {
            return Some(mut self.postponed.remove(at))
        }
        at += 1
    }
    return None
} Driver.take_postponed

/// Whether the call `id` is outstanding and of the kind `request` says.
fn Domain.ends(self, id: u64, request: bool) -> bool {
    let Some(outstanding) = self.outstanding else {
        return false
    }
    return outstanding.id == id and outstanding.reply.is_some() == request
} Domain.ends

/// Hands the order waiting for the instance to pause to the holder of its domain once no call is outstanding, or answers it at once when no domain runs.
fn Driver.pause_holder(mut self) fails task::Cancelled uses wait {
    let calling = match self.domain {
        Some(domain) => domain.outstanding.is_some()
        None => false
    }
    if calling {
        return
    }
    let Some(done) = mut self.pausing.extract() else {
        return
    }
    if self.domain.is_none() {
        discard attempt await done.send(Ok(os::Outcome.Done))
        return
    }
    try await self.hold_order(HolderOrder.Pause(done: take done))
} Driver.pause_holder

/// Ends the instance's pause: its holder posts again what it set aside, and its queued calls reach it from `now_ns` on; an order waiting for the pause is answered `port.stopped`.
fn Driver.resume(mut self, now_ns: u64) fails task::Cancelled uses wait {
    if not self.paused {
        return
    }
    self.paused = false
    match mut self.pausing.extract() {
        Some(done) => {
            discard attempt await done.send(Err(os::ControlError.Stopped))
        }
        None => {
            match self.domain {
                Some(domain) => {
                    discard attempt await domain.deliveries.send(Delivery.Hold(order: HolderOrder.Resume))
                }
                None => {
                }
            }
        }
    }
    try await mut self.deliver(now_ns)
} Driver.resume

/// Has the holder of the paused instance replay the call of `waking` under its cause, as the dead letter it names delivered again when it names one, its Views of `main` reaching its branch and its tape serving its readings; its order hears what the replay gave once the holder reports. `request.invalid-operand` unless the instance is paused, with no call outstanding and no replay running, and `port.stopped` when no domain runs.
fn Driver.replay(mut self, take waking: Waking) fails task::Cancelled uses wait {
    let Waking(call: call, redelivery: redelivery, branch: branch, recorded: recorded, done: done, cause: cause) = waking
    let Some(domain) = self.domain else {
        discard attempt await done.send(Err(os::ControlError.Stopped))
        return
    }
    if not self.paused or self.pausing.is_some() or self.replaying.is_some() or domain.outstanding.is_some() {
        discard attempt await done.send(Err(os::ControlError.Invalid))
        return
    }
    let header = match redelivery {
        Some(_) => os::Header.redelivered(cause)
        None => os::Header.of_work(cause, slot: 0)
    }
    self.replaying = Some(Replaying(done: take done, header: header, redelivery: redelivery))
    discard attempt await domain.deliveries.send(Delivery.Hold(order: HolderOrder.Replay(call: take call, header: header, branch: take branch, redirect: self.minted.redirect.share(), recorded: take recorded, tape: self.minted.tape.share())))
} Driver.replay

/// Tells the replay running on the instance its outcome `outcome`, and gives the note of the dead letter it delivered again once it was handled.
fn Driver.replayed(mut self, take outcome: Result[os::Replayed, os::ControlError]) -> Option[Noted] fails task::Cancelled uses wait {
    let Some(replaying) = mut self.replaying.extract() else {
        return None
    }
    let Replaying(done: done, header: header, redelivery: redelivery) = replaying
    var noted: Option[Noted] = None
    match redelivery {
        Some(seq) => {
            if outcome.is_ok() {
                noted = Some(Noted(seq: seq, redelivery: os::Redelivery(cause: header.named_cause(), outcome: os::Redelivered.Handled)))
            }
        }
        None => {
        }
    }
    let answer: Result[os::Outcome, os::ControlError] = match outcome {
        Ok(given) => Ok(os::Outcome.Replayed(take given))
        Err(failure) => Err(take failure)
    }
    discard attempt await done.send(take answer)
    return noted
} Driver.replayed

/// Replays the replay waiting for the instance to run once it runs, or answers it `port.stopped` once it stopped or failed.
fn Driver.woken(mut self) fails task::Cancelled uses wait {
    let running = match self.lifecycle {
        Some(os::Lifecycle.Running) => true
        Some(os::Lifecycle.Stopped) or Some(os::Lifecycle.Failed) => false
        else => return
    }
    let Some(waking) = mut self.waking.extract() else {
        return
    }
    if running {
        try await mut self.replay(take waking)
        return
    }
    discard attempt await waking.done.send(Err(os::ControlError.Stopped))
} Driver.woken

/// Hands `order` to the holder of the running domain, or answers it `port.stopped` when none runs.
fn Driver.hold_order(self, take order: HolderOrder) fails task::Cancelled uses wait {
    match self.domain {
        Some(domain) => {
            discard attempt await domain.deliveries.send(Delivery.Hold(order: take order))
        }
        None => try await take order.refuse()
    }
} Driver.hold_order

/// Delivers the next queued call at `now_ns` to a running domain with no call outstanding, beginning its span when its cause or the instance is traced.
fn Driver.deliver(mut self, now_ns: u64) fails task::Cancelled uses wait {
    if self.hibernating.is_some() {
        try await mut self.hibernate_holder()
        return
    }
    if self.paused {
        try await mut self.pause_holder()
        return
    }
    if self.lifecycle != Some(os::Lifecycle.Running) or self.queue.len() == 0 {
        return
    }
    let Some(domain) = mut self.domain.extract() else {
        return
    }
    var current = domain
    if current.outstanding.is_some() {
        self.domain = Some(take current)
        return
    }
    let Queued(call: call, since_ns: since_ns, redelivery: redelivery) = mut self.queue.remove(0)
    let os::Call(hash: hash, encoded: encoded, reply: reply, lease: lease, header: header) = call
    self.counted()
    self.passed_over = false
    let id = self.next_id
    self.next_id += 1
    let request = reply.is_some()
    var message: Option[mem::Bytes] = None
    if encoded.bytes.len() <= MOST_DEAD_BYTES {
        var copy = mem::Bytes.empty(self.alloc)
        mut copy.append(encoded.bytes.view())
        message = Some(take copy)
    }
    var span: Option[Span] = None
    if header.traced() or self.traced(now_ns) {
        span = Some(Span(cause: header.cause, start_ns: now_ns, wait_ns: now_ns.saturating_sub(since_ns), run_ns: 0, sender: header.sender, operation: operation_name(encoded.bytes.view(), alloc: self.alloc), trapped: None))
    }
    current.outstanding = Some(Outstanding(id: id, reply: take reply, lease: take lease, header: header, message: take message, span: span, redelivery: redelivery))
    let deliveries = current.deliveries.split()
    self.domain = Some(take current)
    discard attempt await deliveries.send(Delivery.Call(id: id, hash: hash, encoded: take encoded, request: request, header: header))
} Driver.deliver

/// Whether the instance's handler calls are traced at `now_ns`.
fn Driver.traced(self, now_ns: u64) -> bool {
    return match self.traced_until {
        Some(until) => now_ns < until
        None => false
    }
} Driver.traced

/// Ends the running incarnation's domain: its outstanding call and the requests it postponed end with `port.server-stopped`, or for a driver with `device.reset`, `device.unplugged` once its device left, and its deliveries close.
fn Driver.end_domain(mut self) fails task::Cancelled uses wait {
    let ending = match first self.minted.devices.len() > 0 {
        false => Ending.ServerStopped
        true if self.unplugged => Ending.Unplugged
        true => Ending.Reset
    }
    while self.postponed.len() > 0 {
        try await stop_outstanding(mut self.postponed.remove(0), ending)
    }
    match mut self.pausing.extract() {
        Some(done) => {
            discard attempt await done.send(Ok(os::Outcome.Done))
        }
        None => {
        }
    }
    match mut self.replaying.extract() {
        Some(replaying) => {
            discard attempt await replaying.done.send(Err(os::ControlError.Stopped))
        }
        None => {
        }
    }
    self.hibernation_ordered = false
    match mut self.hibernating.extract() {
        Some(done) => {
            discard attempt await done.send(Err(os::ControlError.NotRunning))
        }
        None => {
        }
    }
    let Some(domain) = mut self.domain.extract() else {
        return
    }
    let Domain(deliveries: _, abandoner: _, outstanding: outstanding) = domain
    let Some(ended) = outstanding else {
        return
    }
    try await stop_outstanding(take ended, ending)
} Driver.end_domain

/// How the requests a domain did not answer end.
enum Ending derives Copy, Eq {
    ServerStopped
    Reset
    Unplugged
} Ending

/// Ends a call its domain did not answer: a request as `ending` says, and its credit returns.
fn stop_outstanding(take ended: Outstanding, ending: Ending) fails task::Cancelled uses wait {
    match ended.reply {
        Some(reply) => {
            discard attempt await reply.send(match ending {
                Ending.ServerStopped => os::Answer.ServerStopped
                Ending.Reset => os::Answer.Reset
                Ending.Unplugged => os::Answer.Unplugged
            })
        }
        None => {
        }
    }
    try await take ended.lease.release()
} stop_outstanding

/// Drops the queued one-way calls and fails the queued requests with `port.server-stopped`.
fn Driver.refuse_queued(mut self) fails task::Cancelled uses wait {
    while self.queue.len() > 0 {
        let Queued(call: call, since_ns: _, redelivery: _) = mut self.queue.remove(0)
        try await refuse(take call, answer: os::Answer.ServerStopped)
    }
    self.counted()
} Driver.refuse_queued

/// Tells readers of the gauge the length of the queue.
fn Driver.counted(self) {
    self.intake.contents().store(u32.saturate(self.queue.len()))
} Driver.counted

/// Whether a call reaching the instance waits in its intake: it is not refused while the instance exists and is not `stopped`, `failed` or stopping for good.
fn Driver.takes_calls(self) -> bool {
    return match self.lifecycle {
        Some(os::Lifecycle.Starting) or Some(os::Lifecycle.Running) or Some(os::Lifecycle.Hibernated) => true
        Some(os::Lifecycle.Stopping) => self.then == Then.Restart
        else => false
    }
} Driver.takes_calls

/// Ends a call without delivering it: a one-way call is dropped, a request answered with `answer`, and its credit returns.
fn refuse(take call: os::Call, take answer: os::Answer) fails task::Cancelled uses wait {
    let os::Call(hash: _, encoded: _, reply: reply, lease: lease, header: _) = call
    match reply {
        Some(sender) => {
            discard attempt await sender.send(take answer)
        }
        None => {
        }
    }
    try await take lease.release()
} refuse

/// Answers the orders waiting for the instance to settle.
fn Driver.settle(mut self) fails task::Cancelled uses wait {
    let Some(lifecycle) = self.lifecycle else {
        return
    }
    var at: usize = 0
    while at < self.waiters.len() {
        let settled = match self.waiters[at].awaits {
            Awaited.Change(seen: seen) => seen != Some(lifecycle)
            Awaited.Stopped => lifecycle == os::Lifecycle.Stopped or lifecycle == os::Lifecycle.Failed
            Awaited.Running => lifecycle == os::Lifecycle.Running or lifecycle == os::Lifecycle.Hibernated or lifecycle == os::Lifecycle.Failed
            Awaited.Suspension(seen: seen) => seen != self.suspended
        }
        if settled {
            let Waiter(done: done, awaits: awaits) = mut self.waiters.remove(at)
            let outcome = match awaits {
                Awaited.Suspension(seen: _) => os::Outcome.Suspended(self.suspended)
                else => os::Outcome.Lifecycle(lifecycle)
            }
            discard attempt await done.send(Ok(take outcome))
        } else {
            at += 1
        }
    }
    try await mut self.woken()
} Driver.settle

/// Abandons the running incarnation's domain from outside.
fn Driver.trigger(self) {
    let Some(domain) = self.domain else {
        return
    }
    domain.abandoner.contents().trigger()
} Driver.trigger

/// Releases what the driver holds once its inputs have ended.
fn Driver.abandon(take self) {
    let Driver(moniker: _, slot: _, spec: _, lifecycle: _, gate: gate, incarnation: _, traps: _, started_ns: _, queue: _, intake: _, domain: _, then: _, abandonment: _, cause: _, changed_by: _, traced_until: _, restarts: _, waiters: _, minted: minted, reserved: _, postponed: _, deleting: _, unplugged: _, suspend_ms: _, suspended: _, showing: _, restoring: _, paused: _, pausing: _, replaying: _, waking: _, hibernating: _, hibernation_ordered: _, hibernated: _, image: _, delayed: _, due_armed: _, next_id: _, messaged_ns: _, hibernated_ns: _, passed_over: _, hibernation_idle: _, alloc: _) = self
    gate.set(open: false)
    take minted.close()
} Driver.abandon
