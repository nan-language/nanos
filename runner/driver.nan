//! Drivers: the task carrying out one instance's lifecycle, holding its intake, its minted capabilities and the domain of each of its incarnations.

/// How long stopping waits for an instance's keyed tasks before abandoning its domain.
const STOP_GRACE_MS: u64 = 5_000

/// The stack of the first task of an instance's domain, on which its component's handlers run.
const INSTANCE_STACK: usize = 262_144

const NS_PER_MS: u64 = 1_000_000

/// The most bytes of a call's encoding that a dead letter keeps.
const MOST_DEAD_BYTES: usize = 16_384

/// What reaches an instance's driver.
enum Input {
    Order(os::Order)
    Call(os::Call)
    Report(incarnation: u64, report: Report)
    Ended(incarnation: u64, outcome: Result[Ended, sys::Trap])
    Elapsed(incarnation: u64)
    Overran(incarnation: u64)
    Slow(ns: u64)
    Lingered(incarnation: u64)
    Revoke(grants: mem::Set[u64], done: task::Sender[Unit])
} Input

/// An instance as its driver holds it, `intake` the length of `queue` for readers of its gauge, `suspended` while its component is, `suspend_ms` the time without a message after which it is, and what it publishes of it.
linear struct Driver {
    moniker: ident::Moniker
    slot: u32
    spec: os::InstanceSpec
    lifecycle: Option[os::Lifecycle]
    gate: os::Gate
    incarnation: u64
    started_ns: u64
    queue: mem::List[os::Call]
    intake: mem::Shared[core::atomic::AtomicU32]
    domain: Option[Domain]
    then: Then
    cause: Cause
    restarts: Restarts
    waiters: mem::List[Waiter]
    minted: Minted
    reserved: Option[mem::Heap]
    postponed: mem::List[Outstanding]
    deleting: Option[task::Sender[Result[os::Outcome, os::ControlError]]]
    unplugged: bool
    suspend_ms: Option[u32]
    suspended: bool
    showing: Showing
    alloc: mem::Alloc
} Driver

/// The running incarnation's domain: where its calls go, what abandons it, and the call delivered to it whose handler call has not ended.
struct Domain {
    deliveries: task::Sender[Delivery]
    abandoner: mem::Shared[sys::Abandoner]
    outstanding: Option[Outstanding]
    next_id: u64
} Domain

/// A call delivered to the running domain: its number, where its reply goes, its credit, and its encoding when it holds at most `MOST_DEAD_BYTES`, which a dead letter keeps when its handler call is abandoned.
struct Outstanding {
    id: u64
    reply: Option[task::Sender[os::Answer]]
    lease: os::Lease
    message: Option[mem::Bytes]
} Outstanding

/// What follows the stop of the running incarnation.
enum Then derives Copy, Eq {
    Stop
    Restart
} Then

/// Why the runner abandoned the running incarnation's domain from outside.
enum Cause derives Copy, Eq {
    Inside
    HandlerLimit
    Lingered
} Cause

/// An order waiting for its instance's lifecycle to run, hibernate or fail, to stop, or to differ from the one an order saw, or for its suspension to differ from the one an order saw.
struct Waiter {
    done: task::Sender[Result[os::Outcome, os::ControlError]]
    awaits: Awaited
} Waiter

enum Awaited derives Copy, Eq {
    Running
    Stopped
    Change(seen: Option[os::Lifecycle])
    Suspension(seen: bool)
} Awaited

/// What the tasks a driver spawns need from the runner.
struct Shared[C: Components and Copy and Send, R: Reservations and Send] {
    components: C
    reservations: R
    config: Config
    directory: task::Cown[Directory]
    orders: task::Sender[os::Order]
    withheld: Withheld
    postings: task::Sender[os::Posting]
    logs: task::Sender[journal::Logged]
    gauges: Gauges
} Shared

/// The driver of the instance `moniker`, not yet created, under `spec`, its calls passing `gate`.
fn Driver.of(
    take moniker: ident::Moniker,
    slot: u32,
    take spec: os::InstanceSpec,
    take gate: os::Gate,
    alloc: mem::Alloc,
    ) -> Driver {
    return Driver(moniker: take moniker, slot: slot, spec: take spec, lifecycle: None, gate: take gate, incarnation: 0, started_ns: 0, queue: mem::List.empty(alloc), intake: mem::Shared.of(core::atomic::AtomicU32.of(0), alloc), domain: None, then: Then.Stop, cause: Cause.Inside, restarts: Restarts.none(alloc), waiters: mem::List.empty(alloc), minted: Minted.none(alloc), reserved: None, postponed: mem::List.empty(alloc), deleting: None, unplugged: false, suspend_ms: None, suspended: false, showing: Showing.none(), alloc: alloc)
} Driver.of

/// Carries out the lifecycle of the instance `driver` holds, as its inputs come, until they end or the instance, deleted, has stopped, left the directory and had its capabilities revoked; the tasks of its incarnations run in the driver's own scope.
fn Shared.drive[J: Journal and Send](
    self,
    take driver: Driver,
    take inputs: task::Receiver[Input],
    sender: task::Sender[Input],
    journal: J,
    ) fails task::Cancelled uses wait {
    var held = driver
    defer take held.abandon()
    try await journal.name(held.slot, moniker: ident::Moniker(text: held.moniker.text))
    var receiver = inputs
    try await self.show(mut held)
    try await task::scope(self.config.exec, body: fn[mut held, mut receiver](s: task::Scope) fails task::Cancelled uses wait {
        loop {
            let Some(input) = try await mut receiver.receive() else {
                s.cancel()
                return
            }
            try await self.take_input(mut held, take input, sender, journal, s)
            try await mut held.settle()
            try await self.show(mut held)
            if held.deleted() {
                try await self.retire_state(mut held)
                let moniker = ident::Moniker(text: held.moniker.text)
                let alloc = self.config.alloc
                let directory = self.directory.share()
                await when mut directory {
                    mut directory.remove_instance(moniker, alloc)
                }
                held.gate.set(open: false)
                mut held.minted.clear()
                try await self.unshow(ident::Moniker(text: held.moniker.text))
                match mut held.deleting.extract() {
                    Some(done) => {
                        discard attempt await done.send(Ok(os::Outcome.Done))
                    }
                    None => {
                    }
                }
                s.cancel()
                return
            }
        }
    })
} Shared.drive

/// Whether the instance is deleted and has stopped.
fn Driver.deleted(self) -> bool {
    return self.deleting.is_some() and self.domain.is_none() and match self.lifecycle {
        None or Some(os::Lifecycle.Stopped) or Some(os::Lifecycle.Failed) => true
        else => false
    }
} Driver.deleted

fn Shared.take_input[J: Journal](
    self,
    mut driver: Driver,
    take input: Input,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    match input {
        Input.Order(order) => try await self.order(mut driver, take order, sender, journal, s)
        Input.Call(call) => {
            if not driver.takes_calls() {
                try await refuse(take call, answer: os::Answer.Stopped)
                return
            }
            mut driver.queue.push(take call)
            driver.counted()
            if driver.lifecycle == Some(os::Lifecycle.Hibernated) {
                try await self.start(mut driver, sender, journal, s)
            }
            try await mut driver.deliver()
        }
        Input.Report(incarnation: incarnation, report: report) => {
            if incarnation != driver.incarnation {
                return
            }
            let ending = match report {
                Report.Ending => true
                else => false
            }
            if ending {
                self.linger(s, inputs: sender.split(), incarnation)
            } else {
                try await mut driver.report(take report, journal)
            }
        }
        Input.Ended(incarnation: incarnation, outcome: outcome) => {
            if incarnation == driver.incarnation {
                try await self.gauges.unwatch(driver.moniker, alloc: self.config.alloc)
                try await self.ended(mut driver, take outcome, sender, journal, s)
            }
        }
        Input.Elapsed(incarnation: incarnation) => {
            if incarnation == driver.incarnation and driver.domain.is_none() and driver.lifecycle == Some(os::Lifecycle.Starting) {
                try await self.start(mut driver, sender, journal, s)
            }
        }
        Input.Overran(incarnation: incarnation) => {
            if incarnation == driver.incarnation {
                driver.cause = Cause.HandlerLimit
            }
        }
        Input.Slow(ns: ns) => journal.record(driver.slot, event: Event.SlowHandler(ns: ns))
        Input.Lingered(incarnation: incarnation) => {
            if incarnation == driver.incarnation and driver.lifecycle == Some(os::Lifecycle.Stopping) {
                driver.cause = Cause.Lingered
                driver.trigger()
            }
        }
        Input.Revoke(grants: grants, done: done) => {
            mut driver.minted.revoke(grants)
            discard attempt await done.send(Unit)
        }
    }
} Shared.take_input

/// Carries out a `Control` order.
fn Shared.order[J: Journal](
    self,
    mut driver: Driver,
    take order: os::Order,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    let os::Order(action: action, moniker: _, grant: _, done: done) = order
    match action {
        os::Action.Read => {
            let answer: Result[os::Outcome, os::ControlError] = match driver.lifecycle {
                Some(lifecycle) => Ok(os::Outcome.Lifecycle(lifecycle))
                None => Err(os::ControlError.Missing)
            }
            discard attempt await done.send(take answer)
        }
        os::Action.Port(credit: credit) => {
            let moniker = ident::Moniker(text: driver.moniker.text)
            let alloc = self.config.alloc
            let directory = self.directory.share()
            let minted = await when directory => directory.mint(moniker, credit, alloc)
            match minted {
                Some(port) => {
                    let handle = port.handle()
                    mut driver.minted.ordered.push(take port)
                    discard attempt await done.send(Ok(os::Outcome.Port(handle)))
                }
                None => {
                    discard attempt await done.send(Err(os::ControlError.Missing))
                }
            }
        }
        os::Action.Delete(unplugged: unplugged) => {
            driver.deleting = Some(take done)
            driver.unplugged = unplugged
            try await self.stop(mut driver, then: Then.Stop, journal)
        }
        os::Action.Changed(seen: seen) => mut driver.waiters.push(Waiter(done: take done, awaits: Awaited.Change(seen: seen)))
        os::Action.SuspendAfter(ms: ms) => {
            driver.suspend_ms = ms
            match driver.domain {
                Some(domain) => {
                    discard attempt await domain.deliveries.send(Delivery.SuspendAfter(ms: ms.value_or(0)))
                }
                None => {
                }
            }
            discard attempt await done.send(Ok(os::Outcome.Done))
        }
        os::Action.Suspended(seen: seen) => mut driver.waiters.push(Waiter(done: take done, awaits: Awaited.Suspension(seen: seen)))
        os::Action.Converge(desired: desired) => {
            if desired > driver.showing.desired {
                driver.showing.desired = desired
            }
            discard attempt await done.send(Ok(os::Outcome.Done))
        }
        os::Action.Start => {
            mut driver.waiters.push(Waiter(done: take done, awaits: Awaited.Running))
            try await self.create_or_start(mut driver, sender, journal, s)
        }
        os::Action.Stop => {
            mut driver.waiters.push(Waiter(done: take done, awaits: Awaited.Stopped))
            try await self.stop(mut driver, then: Then.Stop, journal)
        }
        os::Action.Restart => {
            mut driver.waiters.push(Waiter(done: take done, awaits: Awaited.Running))
            try await self.stop(mut driver, then: Then.Restart, journal)
            if driver.lifecycle == Some(os::Lifecycle.Failed) or driver.lifecycle == Some(os::Lifecycle.Stopped) or driver.lifecycle.is_none() {
                try await self.create_or_start(mut driver, sender, journal, s)
            }
        }
        else => {
            discard attempt await done.send(Err(os::ControlError.Invalid))
        }
    }
    try await mut driver.settle()
} Shared.order

/// Creates the instance from its specification, or starts it from `stopped` or `failed`: it hibernates when lazy, and starts at once otherwise.
fn Shared.create_or_start[J: Journal](
    self,
    mut driver: Driver,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    match driver.lifecycle {
        None or Some(os::Lifecycle.Stopped) or Some(os::Lifecycle.Failed) => {
        }
        else => return
    }
    if driver.lifecycle == Some(os::Lifecycle.Failed) {
        driver.restarts = Restarts.none(self.config.alloc)
    }
    driver.spec.stopped = false
    driver.gate.set(open: true)
    if driver.spec.lazy {
        driver.lifecycle = Some(os::Lifecycle.Hibernated)
        return
    }
    try await self.start(mut driver, sender, journal, s)
} Shared.create_or_start

/// Starts a new incarnation: draws its cell and account, builds its world, and runs its domain.
fn Shared.start[J: Journal](
    self,
    mut driver: Driver,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    driver.lifecycle = Some(os::Lifecycle.Starting)
    driver.cause = Cause.Inside
    driver.suspended = false
    driver.started_ns = now(self.config.clock)
    var keeping: Option[Keeping] = None
    var restore: Option[os::Checkpoint] = None
    match try await self.restoring(mut driver) {
        Restoring.Fresh(keeping: kept) => {
            keeping = kept
        }
        Restoring.From(keeping: kept, checkpoint: saved) => {
            keeping = Some(kept)
            if saved.incarnation > driver.incarnation {
                driver.incarnation = saved.incarnation
            }
            restore = Some(take saved)
        }
        Restoring.Unreadable => {
            try await self.give_up(mut driver, journal)
            return
        }
    }
    driver.incarnation += 1
    let config = try await self.configuration(mut driver)
    let Some(budget) = try await self.cell(mut driver) else {
        try await self.give_up(mut driver, journal)
        return
    }
    let account = self.config.exec.split(self.config.share(driver.spec.share))
    let request = Request(moniker: ident::Moniker(text: driver.moniker.text), cell: budget.alloc(), exec: account.executor(), clock: self.config.clock, random: self.config.random, withheld: self.withheld, orders: self.orders.split(), logs: self.logs.split(), alloc: self.config.alloc)
    let directory = self.directory.share()
    let built = await when directory => directory.world(driver.spec, minted: mut driver.minted, request)
    let Some(world) = built else {
        take account.close()
        take budget.close()
        try await self.give_up(mut driver, journal)
        return
    }
    let task::Channel(sender: deliveries, receiver: delivered) = task::Channel[Delivery].bounded(2, alloc: self.config.alloc)
    let task::Channel(sender: marks, receiver: marked) = task::Channel[Mark].bounded(2, alloc: self.config.alloc)
    let ending = marks.split()
    let gauged = marks.split()
    let abandoner = mem::Shared.of(sys::Abandoner.new(), alloc: self.config.alloc)
    let serving = Serving(deliveries: take delivered, reports: sender.split(), marks: take marks, incarnation: driver.incarnation, clock: self.config.clock, abandoner: abandoner.share(), suspend_ms: driver.suspend_ms.value_or(0), keeping: keeping, restore: take restore, config: take config)
    let exec = account.executor()
    let alloc = budget.alloc()
    let held = Held(budget: take budget, account: take account, class: driver.spec.share.class, intake: driver.intake.share())
    self.launch(s, component: text::String.of(driver.spec.component.as_str(), alloc: self.config.alloc), take world, take serving, exec, alloc, abandoner: abandoner.share(), take ending, ended: sender.split(), incarnation: driver.incarnation)
    self.watch(s, marks: take marked, take held, abandoner: abandoner.share(), inputs: sender.split(), incarnation: driver.incarnation, handlers: driver.spec.handlers)
    driver.domain = Some(Domain(deliveries: take deliveries, abandoner: take abandoner, outstanding: None, next_id: 0))
    try await self.gauges.watch(ident::Moniker(text: driver.moniker.text), watch: take gauged, alloc: self.config.alloc)
} Shared.start

/// The cell of a new incarnation: split from the node pool at the specification's limit, or for a reserved instance from the store over its region, which its first start takes and later starts reuse; `None` when no free range holds the region.
fn Shared.cell(self, mut driver: Driver) -> Option[mem::Budget] fails task::Cancelled uses wait {
    let limit = driver.spec.budget.limit
    if not driver.spec.budget.reserved {
        return Some(self.config.pool.split(usize.widen(limit)))
    }
    if driver.reserved.is_none() {
        driver.reserved = try await self.reservations.reserve(limit)
    }
    let Some(store) = driver.reserved else {
        return None
    }
    return Some(store.alloc().split(usize.widen(limit)))
} Shared.cell

/// What an incarnation's watch holds: its cell and account, its account's CPU class, and the length of its instance's queue.
linear struct Held {
    budget: mem::Budget
    account: task::Account
    class: os::CpuClass
    intake: mem::Shared[core::atomic::AtomicU32]
} Held

/// The gauge of the incarnation `held` keeps.
fn Held.gauge(self) -> os::Gauge {
    return os::Gauge(intake: self.intake.contents().load(), memory: os::Usage(charged: u64.widen(self.budget.charged()), limit: u64.widen(self.budget.limit()), peak: u64.widen(self.budget.peak())), cpu_ns: self.account.used_ns(), class: self.class)
} Held.gauge

/// Runs an incarnation's domain on a task of `s` through `exec` and `alloc`, then tells its watch, through `ending`, and its driver how it ended.
fn Shared.launch(
    self,
    s: task::Scope,
    take component: text::String,
    take world: nanos::World,
    take serving: Serving,
    exec: task::Executor,
    alloc: mem::Alloc,
    take abandoner: mem::Shared[sys::Abandoner],
    take ending: task::Sender[Mark],
    take ended: task::Sender[Input],
    incarnation: u64,
    ) {
    let components = self.components
    discard s.spawn(fn[take component, take world, take serving, take abandoner, take ending, take ended]() fails task::Cancelled uses wait limits stack 16_384 {
        let ran = attempt await abandoner.contents().run_sized(fn[take component, take world, take serving]() -> Ended fails task::Cancelled uses wait limits stack 131_072 {
            return try await components.serve(component.as_str(), take world, take serving)
        }, stack: INSTANCE_STACK, exec, alloc)
        discard attempt await ending.send(Mark.Ended)
        let outcome = match ran {
            Ok(result) => result
            Err(cancelled) => fail cancelled
        }
        discard attempt await ended.send(Input.Ended(incarnation: incarnation, outcome: take outcome))
    })
} Shared.launch

/// Watches an incarnation's handlers on a task of `s`, answering the readings of its gauge from `held` until its domain has ended, then closes its account and cell: a handler call past `handlers.handler_s` abandons the domain, and one of `handlers.slow_ms` or more is reported slow.
fn Shared.watch(
    self,
    s: task::Scope,
    take marks: task::Receiver[Mark],
    take held: Held,
    take abandoner: mem::Shared[sys::Abandoner],
    take inputs: task::Sender[Input],
    incarnation: u64,
    handlers: os::Limits,
    ) {
    let clock = self.config.clock
    discard s.spawn(fn[take marks, take held, take abandoner, take inputs]() fails task::Cancelled uses wait limits stack 16_384 {
        let watched = attempt await watch_marks(take marks, held, abandoner, inputs, clock, incarnation, handlers)
        let Held(budget: budget, account: account, class: _, intake: _) = held
        take account.close()
        take budget.close()
        match watched {
            Ok(_) => {
            }
            Err(cancelled) => fail cancelled
        }
    })
} Shared.watch

/// Takes the marks of an incarnation until its domain has ended, bounding each handler call it tells of and answering each reading with the gauge of `held`.
fn watch_marks(
    take marks: task::Receiver[Mark],
    held: Held,
    abandoner: mem::Shared[sys::Abandoner],
    inputs: task::Sender[Input],
    clock: sys::Clock,
    incarnation: u64,
    handlers: os::Limits,
    ) fails task::Cancelled uses wait {
    var receiver = marks
    var overran_at: Option[u64] = None
    loop {
        var received: Option[Mark] = None
        match overran_at {
            None => {
                received = try await mut receiver.receive()
            }
            Some(at) => {
                let left = at.saturating_sub(now(clock))
                let within = try await task::within_ns(clock, ns: left, body: fn[mut receiver]() -> Option[Mark] fails task::Cancelled uses wait {
                    return try await mut receiver.receive()
                })
                match within {
                    Some(given) => {
                        received = given
                    }
                    None => {
                        overran_at = None
                        discard attempt await inputs.send(Input.Overran(incarnation: incarnation))
                        abandoner.contents().trigger()
                        continue
                    }
                }
            }
        }
        match received {
            Some(Mark.Began) => {
                overran_at = Some(now(clock).saturating_add(u64.widen(handlers.handler_s) * 1_000 * NS_PER_MS))
            }
            Some(Mark.Took(ns: ns)) => {
                overran_at = None
                if ns >= u64.widen(handlers.slow_ms) * NS_PER_MS {
                    discard attempt await inputs.send(Input.Slow(ns: ns))
                }
            }
            Some(Mark.Read(reply: reply)) => {
                discard attempt await reply.send(held.gauge())
            }
            else => return
        }
    }
} watch_marks

/// Stops the instance, or has it start again once stopped when `then` is `Restart`: queued calls stay for a restart and are dropped or failed for a stop, and an instance not yet created is created `stopped`.
fn Shared.stop[J: Journal](self, mut driver: Driver, then: Then, journal: J) fails task::Cancelled uses wait {
    if then == Then.Stop {
        driver.spec.stopped = true
        driver.gate.set(open: false)
        try await mut driver.refuse_queued()
    }
    match driver.lifecycle {
        Some(os::Lifecycle.Running) => {
        }
        Some(os::Lifecycle.Stopping) => {
            driver.then = then
            return
        }
        Some(os::Lifecycle.Starting) or Some(os::Lifecycle.Hibernated) => {
            if driver.domain.is_none() {
                mut driver.stopped(journal, abandoned: false)
                return
            }
        }
        None => {
            if then == Then.Stop {
                driver.lifecycle = Some(os::Lifecycle.Stopped)
            }
            return
        }
        else => return
    }
    driver.lifecycle = Some(os::Lifecycle.Stopping)
    driver.then = then
    let Some(domain) = driver.domain else {
        return
    }
    discard attempt await domain.deliveries.send(Delivery.Stop)
} Shared.stop

/// Handles the end of the running incarnation's domain: a stop it was asked for, or an abandonment and the restart policy.
fn Shared.ended[J: Journal](
    self,
    mut driver: Driver,
    take outcome: Result[Ended, sys::Trap],
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    let dead = match first outcome {
        Err(_) if driver.cause != Cause.Lingered => driver.handled_message()
        else => None
    }
    try await mut driver.end_domain()
    match outcome {
        Ok(Ended.Stopped) => {
            mut driver.stopped(journal, abandoned: false)
            if driver.then == Then.Restart {
                try await self.create_or_start(mut driver, sender, journal, s)
            }
        }
        Ok(Ended.EnvIncomplete) or Ok(Ended.Unhealthy) or Ok(Ended.CheckpointUndecodable) => try await self.give_up(mut driver, journal)
        Err(trap) => {
            if driver.cause == Cause.Lingered {
                mut driver.stopped(journal, abandoned: true)
                if driver.then == Then.Restart {
                    try await self.create_or_start(mut driver, sender, journal, s)
                }
            } else {
                match dead {
                    Some(message) => try await self.record_dead(mut driver, trap, take message, s)
                    None => {
                    }
                }
                try await self.abandoned(mut driver, kind: trap.kind(), sender, journal, s)
            }
        }
    }
    try await mut driver.settle()
} Shared.ended

/// The call whose handler call is running: a copy of its encoding when the driver kept one; `None` when no handler call runs.
fn Driver.handled_message(self) -> Option[Option[mem::Bytes]] {
    let Some(domain) = self.domain else {
        return None
    }
    let Some(outstanding) = domain.outstanding else {
        return None
    }
    let Some(kept) = outstanding.message else {
        return Some(None)
    }
    var message = mem::Bytes.empty(self.alloc)
    mut message.append(kept.view())
    return Some(Some(take message))
} Driver.handled_message

/// Records the call the handler call of the incarnation `trap` abandoned was handling, `message` its encoding when kept, as the instance's next dead letter, written from a task of `s` through the instance's View of `/state`.
fn Shared.record_dead(
    self,
    mut driver: Driver,
    trap: sys::Trap,
    take message: Option[mem::Bytes],
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    let alloc = self.config.alloc
    var kind = text::String.empty(alloc)
    mut kind.write(Dyn[Render].view(trap.kind()), budget: 64)
    var report = text::String.empty(alloc)
    mut report.write(Dyn[Render].view(trap), budget: 1_024)
    let letter = os::DeadLetter(seq: 0, incarnation: driver.incarnation, time: self.config.wall.now(self.config.clock), header: Array[u8, 24].filled(0), sender: None, operation: operation_of(message, alloc), message: take message, kind: take kind, report: take report, redeliveries: mem::List.empty(alloc))
    let directory = self.directory.share()
    let moniker = ident::Moniker(text: driver.moniker.text)
    let principal = ident::Principal(text: driver.spec.principal.text)
    let minted = await when directory => directory.state_view(mut driver.minted, moniker: ident::Moniker(text: moniker.text), take principal, alloc)
    let Some(view) = minted else {
        return
    }
    let keep = driver.deleting.is_none()
    discard s.spawn(fn[take letter, take moniker]() fails task::Cancelled uses wait limits stack 32_768 {
        try await write_dead(take letter, view, moniker, keep, alloc)
    })
} Shared.record_dead

/// Applies the restart policy after an abandonment of kind `kind`: a restart after the backoff, or `failed`.
fn Shared.abandoned[J: Journal](
    self,
    mut driver: Driver,
    kind: sys::TrapKind,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    if kind == sys::TrapKind.Exception {
        journal.record(driver.slot, event: Event.Integrity(incarnation: driver.incarnation))
    }
    journal.record(driver.slot, event: Event.Trapped(incarnation: driver.incarnation, kind: kind, limit: driver.cause == Cause.HandlerLimit))
    var code = text::String.empty(self.config.alloc)
    mut code.write(Dyn[Render].view(kind), budget: 64)
    mut driver.showing.faulted(take code)
    let supervisor = driver.moniker.text.as_str() == "supervisor"
    let policy = driver.spec.restart.policy
    if policy == os::RestartPolicy.Temporary and not supervisor {
        try await self.give_up(mut driver, journal)
        return
    }
    match mut driver.restarts.next(driver.spec.restart, bounded: not supervisor, started_ns: driver.started_ns, now_ns: now(self.config.clock)) {
        Next.Fail => try await self.give_up(mut driver, journal)
        Next.After(ns: ns) => {
            driver.lifecycle = Some(os::Lifecycle.Starting)
            self.elapse(s, ns, inputs: sender.split(), incarnation: driver.incarnation)
        }
    }
} Shared.abandoned

/// Tells the driver on a task of `s` when incarnation `incarnation` has spent the grace that ending its keyed tasks has, after which the driver abandons its domain.
fn Shared.linger(self, s: task::Scope, take inputs: task::Sender[Input], incarnation: u64) {
    let clock = self.config.clock
    discard s.spawn(fn[take inputs]() fails task::Cancelled uses wait limits stack 8_192 {
        try await clock.sleep(STOP_GRACE_MS)
        discard attempt await inputs.send(Input.Lingered(incarnation: incarnation))
    })
} Shared.linger

/// Tells the driver on a task of `s` that the backoff of `ns` before the restart of incarnation `incarnation` has elapsed.
fn Shared.elapse(
    self,
    s: task::Scope,
    ns: u64,
    take inputs: task::Sender[Input],
    incarnation: u64,
    ) {
    let clock = self.config.clock
    discard s.spawn(fn[take inputs]() fails task::Cancelled uses wait limits stack 8_192 {
        try await clock.sleep_ns(ns)
        discard attempt await inputs.send(Input.Elapsed(incarnation: incarnation))
    })
} Shared.elapse

/// Sends the instance to `failed`: its queued calls are dropped or failed, and its gate closes.
fn Shared.give_up[J: Journal](self, mut driver: Driver, journal: J) fails task::Cancelled uses wait {
    driver.lifecycle = Some(os::Lifecycle.Failed)
    driver.gate.set(open: false)
    try await mut driver.refuse_queued()
    journal.record(driver.slot, event: Event.Failed(restarts: u32.fit(driver.restarts.times.len())))
} Shared.give_up

/// Records the instance stopped.
fn Driver.stopped[J: Journal](mut self, journal: J, abandoned: bool) {
    self.lifecycle = Some(os::Lifecycle.Stopped)
    journal.record(self.slot, event: Event.Stopped(abandoned: abandoned))
} Driver.stopped

/// Handles what the domain reports: that it runs, that it took a call, a request's answer, that its component was suspended or woken, or that a checkpoint failed.
fn Driver.report[J: Journal](mut self, take report: Report, journal: J) fails task::Cancelled uses wait {
    match report {
        Report.Running(checkpoint: restored) => {
            if self.lifecycle == Some(os::Lifecycle.Starting) {
                self.lifecycle = Some(os::Lifecycle.Running)
                journal.record(self.slot, event: Event.Started(incarnation: self.incarnation, checkpoint: restored))
            }
        }
        Report.CheckpointFailed(code: code, bytes: bytes) => journal.record(self.slot, event: Event.CheckpointFailed(code: code, bytes: bytes))
        Report.Published(summary: summary) => mut self.showing.summarize(take summary)
        Report.Taken(id: id) => {
            let taken = mut self.take_outstanding(id, request: false)
            match taken {
                Some(outstanding) => try await take outstanding.lease.release()
                None => {
                }
            }
        }
        Report.Ending => {
        }
        Report.Suspended => {
            self.suspended = true
        }
        Report.Woken => {
            self.suspended = false
        }
        Report.Postponed(id: id) => {
            let postponed = mut self.take_outstanding(id, request: true)
            match postponed {
                Some(outstanding) => mut self.postponed.push(take outstanding)
                None => {
                }
            }
        }
        Report.Answered(id: id, answer: answer) => {
            var answered = mut self.take_outstanding(id, request: true)
            if answered.is_none() {
                answered = mut self.take_postponed(id)
            }
            match answered {
                Some(outstanding) => {
                    match outstanding.reply {
                        Some(reply) => {
                            discard attempt await reply.send(take answer)
                        }
                        None => {
                        }
                    }
                    try await take outstanding.lease.release()
                }
                None => {
                }
            }
        }
    }
    try await mut self.deliver()
    try await mut self.settle()
} Driver.report

/// The outstanding call `id` when it ends now: a one-way call once taken, a request once answered.
fn Driver.take_outstanding(mut self, id: u64, request: bool) -> Option[Outstanding] {
    let Some(domain) = mut self.domain.extract() else {
        return None
    }
    var current = domain
    var ended: Option[Outstanding] = None
    if current.ends(id, request) {
        ended = mut current.outstanding.extract()
    }
    self.domain = Some(take current)
    return ended
} Driver.take_outstanding

/// The postponed request `id`, which its answer ends.
fn Driver.take_postponed(mut self, id: u64) -> Option[Outstanding] {
    var at: usize = 0
    while at < self.postponed.len() {
        if self.postponed[at].id == id {
            return Some(mut self.postponed.remove(at))
        }
        at += 1
    }
    return None
} Driver.take_postponed

/// Whether the call `id` is outstanding and of the kind `request` says.
fn Domain.ends(self, id: u64, request: bool) -> bool {
    let Some(outstanding) = self.outstanding else {
        return false
    }
    return outstanding.id == id and outstanding.reply.is_some() == request
} Domain.ends

/// Delivers the next queued call to a running domain with no call outstanding.
fn Driver.deliver(mut self) fails task::Cancelled uses wait {
    if self.lifecycle != Some(os::Lifecycle.Running) or self.queue.len() == 0 {
        return
    }
    let Some(domain) = mut self.domain.extract() else {
        return
    }
    var current = domain
    if current.outstanding.is_some() {
        self.domain = Some(take current)
        return
    }
    let os::Call(hash: hash, encoded: encoded, reply: reply, lease: lease) = mut self.queue.remove(0)
    self.counted()
    let id = current.next_id
    current.next_id += 1
    let request = reply.is_some()
    var message: Option[mem::Bytes] = None
    if encoded.bytes.len() <= MOST_DEAD_BYTES {
        var copy = mem::Bytes.empty(self.alloc)
        mut copy.append(encoded.bytes.view())
        message = Some(take copy)
    }
    current.outstanding = Some(Outstanding(id: id, reply: take reply, lease: take lease, message: take message))
    let deliveries = current.deliveries.split()
    self.domain = Some(take current)
    discard attempt await deliveries.send(Delivery.Call(id: id, hash: hash, encoded: take encoded, request: request))
} Driver.deliver

/// Ends the running incarnation's domain: its outstanding call and the requests it postponed end with `port.server-stopped`, or for a driver with `device.reset`, `device.unplugged` once its device left, and its deliveries close.
fn Driver.end_domain(mut self) fails task::Cancelled uses wait {
    let ending = match first self.minted.devices.len() > 0 {
        false => Ending.ServerStopped
        true if self.unplugged => Ending.Unplugged
        true => Ending.Reset
    }
    while self.postponed.len() > 0 {
        try await stop_outstanding(mut self.postponed.remove(0), ending)
    }
    let Some(domain) = mut self.domain.extract() else {
        return
    }
    let Domain(deliveries: _, abandoner: _, outstanding: outstanding, next_id: _) = domain
    let Some(ended) = outstanding else {
        return
    }
    try await stop_outstanding(take ended, ending)
} Driver.end_domain

/// How the requests a domain did not answer end.
enum Ending derives Copy, Eq {
    ServerStopped
    Reset
    Unplugged
} Ending

/// Ends a call its domain did not answer: a request as `ending` says, and its credit returns.
fn stop_outstanding(take ended: Outstanding, ending: Ending) fails task::Cancelled uses wait {
    match ended.reply {
        Some(reply) => {
            discard attempt await reply.send(match ending {
                Ending.ServerStopped => os::Answer.ServerStopped
                Ending.Reset => os::Answer.Reset
                Ending.Unplugged => os::Answer.Unplugged
            })
        }
        None => {
        }
    }
    try await take ended.lease.release()
} stop_outstanding

/// Drops the queued one-way calls and fails the queued requests with `port.server-stopped`.
fn Driver.refuse_queued(mut self) fails task::Cancelled uses wait {
    while self.queue.len() > 0 {
        try await refuse(mut self.queue.remove(0), answer: os::Answer.ServerStopped)
    }
    self.counted()
} Driver.refuse_queued

/// Tells readers of the gauge the length of the queue.
fn Driver.counted(self) {
    self.intake.contents().store(u32.saturate(self.queue.len()))
} Driver.counted

/// Whether a call reaching the instance waits in its intake: it is not refused while the instance exists and is not `stopped`, `failed` or stopping for good.
fn Driver.takes_calls(self) -> bool {
    return match self.lifecycle {
        Some(os::Lifecycle.Starting) or Some(os::Lifecycle.Running) or Some(os::Lifecycle.Hibernated) => true
        Some(os::Lifecycle.Stopping) => self.then == Then.Restart
        else => false
    }
} Driver.takes_calls

/// Ends a call without delivering it: a one-way call is dropped, a request answered with `answer`, and its credit returns.
fn refuse(take call: os::Call, take answer: os::Answer) fails task::Cancelled uses wait {
    let os::Call(hash: _, encoded: _, reply: reply, lease: lease) = call
    match reply {
        Some(sender) => {
            discard attempt await sender.send(take answer)
        }
        None => {
        }
    }
    try await take lease.release()
} refuse

/// Answers the orders waiting for the instance to settle.
fn Driver.settle(mut self) fails task::Cancelled uses wait {
    let Some(lifecycle) = self.lifecycle else {
        return
    }
    var at: usize = 0
    while at < self.waiters.len() {
        let settled = match self.waiters[at].awaits {
            Awaited.Change(seen: seen) => seen != Some(lifecycle)
            Awaited.Stopped => lifecycle == os::Lifecycle.Stopped or lifecycle == os::Lifecycle.Failed
            Awaited.Running => lifecycle == os::Lifecycle.Running or lifecycle == os::Lifecycle.Hibernated or lifecycle == os::Lifecycle.Failed
            Awaited.Suspension(seen: seen) => seen != self.suspended
        }
        if settled {
            let Waiter(done: done, awaits: awaits) = mut self.waiters.remove(at)
            let outcome = match awaits {
                Awaited.Suspension(seen: _) => os::Outcome.Suspended(self.suspended)
                else => os::Outcome.Lifecycle(lifecycle)
            }
            discard attempt await done.send(Ok(take outcome))
        } else {
            at += 1
        }
    }
} Driver.settle

/// Abandons the running incarnation's domain from outside.
fn Driver.trigger(self) {
    let Some(domain) = self.domain else {
        return
    }
    domain.abandoner.contents().trigger()
} Driver.trigger

/// Releases what the driver holds once its inputs have ended.
fn Driver.abandon(take self) {
    let Driver(moniker: _, slot: _, spec: _, lifecycle: _, gate: gate, incarnation: _, started_ns: _, queue: _, intake: _, domain: _, then: _, cause: _, restarts: _, waiters: _, minted: minted, reserved: _, postponed: _, deleting: _, unplugged: _, suspend_ms: _, suspended: _, showing: _, alloc: _) = self
    gate.set(open: false)
    take minted.close()
} Driver.abandon
