//! Jobs: instances running a program bundle's `main`, created by a `Job` order and acting for the principal it names, their writes going to a branch of their own that the store merges into theirs when `main` returns, their specification and result kept in `/state/<moniker>`.

/// The type of `/state/<moniker>/job`.
const JOB_SPEC_TYPE: Str = "os::JobSpec"

/// The type of `/state/<moniker>/result`.
const JOB_RESULT_TYPE: Str = "os::JobResult"

/// The grant number the root entry of a job's View of the root of its target branch goes under, which no grant has.
const BRANCH_GRANT: u64 = 0xFFFF_FFFF_FFFF_FFFD

/// The grant number the root entry of a job's View of `/sys/code` goes under, which no grant has.
const CODE_GRANT: u64 = 0xFFFF_FFFF_FFFF_FFFC

/// The bytes of an image each read of it takes.
const IMAGE_CHUNK: u32 = 1_048_576

/// A job as its driver holds it: what its order gave of its specification, when its latest run started, whether its next run is prepared, a View of the branch its latest run writes to, the View of `/sys/code` its runs read its bundle's image through, `None` while `store` has no endpoint, why the runner cancelled its latest run, and whether it has ended for good.
struct Job {
    order: os::JobOrder
    started: ident::WallTime
    prepared: bool
    writing: Option[store::service::View]
    code: Option[store::service::View]
    cancelled: Option[text::Fixed[16]]
    over: bool
} Job

/// What a job order takes into the directory.
struct JobCreation {
    moniker: ident::Moniker
    spec: os::InstanceSpec
    order: mem::Box[os::JobOrder]
} JobCreation

/// What the task of a job's run takes: a View of `/sys/code` reading the image of the bundle of code hash `bundle`, `None` while `store` has no endpoint, the encoding of its input and its world.
struct JobLaunch {
    code: Option[store::service::View]
    bundle: ident::HashValue
    input: mem::Bytes
    world: nanos::World
} JobLaunch

/// How a run of a job ended, once its result is kept: the name of its outcome's kind and the commit merging its branch, whether the job runs again, and the lifecycle it ends in otherwise.
struct Recorded {
    outcome: text::Fixed[16]
    commit: Option[ident::CommitId]
    rerun: bool
    ending: os::Lifecycle
} Recorded

/// Lists the job `creation` names under the moniker its specification names, or under `job-<n>` when it names none, giving its driver; failing when the moniker is no moniker or one in use.
fn Directory.create_job(mut self, mut creation: Option[JobCreation], slot: u32, alloc: mem::Alloc) -> Result[Started, os::ControlError] {
    let Some(JobCreation(moniker: ordered, spec: spec, order: order)) = mut creation.extract() else {
        return Err(os::ControlError.Invalid)
    }
    var moniker = ordered
    if not order.contents().named {
        moniker = mut self.next_job(alloc)
    }
    if not ident::is_moniker(moniker.text) {
        return Err(os::ControlError.Invalid)
    }
    if self.endpoints.get(moniker).is_some() or self.jobs.contains(moniker) {
        return Err(os::ControlError.Exists)
    }
    let job = Job(order: take order.into_contents(), started: ident::WallTime(utc_ns: 0, uncertainty_ns: 0), prepared: false, writing: None, code: None, cancelled: None, over: false)
    discard mut self.jobs.insert(ident::Moniker(text: moniker.text))
    discard mut self.slots.insert(slot, value: ident::Moniker(text: moniker.text))
    let task::Channel(sender: _, receiver: calls) = task::Channel[os::Call].bounded(1, alloc)
    let task::Channel(sender: inputs, receiver: taken) = task::Channel[Input].bounded(QUEUED_INPUTS, alloc)
    var driver = Driver.of(take moniker, slot, take spec, gate: os::Gate.of(alloc), job: Some(mem::Heap.of(alloc).boxed(take job)), hosted: None, alloc)
    self.read_code(mut driver, alloc)
    return Ok(Started(driver: take driver, inputs: take inputs, taken: take taken, calls: take calls))
} Directory.create_job

/// The moniker `job-<n>` of the next job of the boot, n the first number past the last one given that no instance or job has.
fn Directory.next_job(mut self, alloc: mem::Alloc) -> ident::Moniker {
    loop {
        self.jobs_numbered += 1
        var numbered = text::Fixed[59].of("job-")
        for digit in store::decimal_name(self.jobs_numbered, alloc) {
            mut numbered.push(char.checked_from_bits(u32.widen(digit)).value_or('0'))
        }
        let moniker = ident::Moniker(text: numbered)
        if self.endpoints.get(moniker).is_none() and not self.jobs.contains(moniker) {
            return moniker
        }
    }
} Directory.next_job

/// Whether the driver runs a job that has ended for good.
fn Driver.job_over(self) -> bool {
    return match self.job {
        Some(job) => job.contents().over
        None => false
    }
} Driver.job_over

/// Whether the driver runs a job whose next run is not yet prepared.
fn Driver.job_unprepared(self) -> bool {
    return match self.job {
        Some(job) => not job.contents().prepared
        None => false
    }
} Driver.job_unprepared

/// Prepares the next run of the job of `driver` on a task of `s`, which tells the driver through `sender`: it writes the job's specification to `/state/<moniker>/job` and creates `job/<moniker>` at the head of the job's branch.
fn Shared.prepare_job(self, mut driver: Driver, sender: task::Sender[Input], s: task::Scope) fails task::Cancelled uses wait {
    let alloc = self.config.alloc
    var record = mem::Bytes.empty(alloc)
    var spec_names = true
    var target = text::String.empty(alloc)
    match driver.job {
        Some(job) => {
            let given = job.contents().order
            mut record.append(given.record.view())
            spec_names = given.named
            mut target.append(given.branch.as_str())
        }
        None => return
    }
    let moniker = ident::Moniker(text: driver.moniker.text)
    let principal = ident::Principal(text: driver.spec.principal.text)
    let directory = self.directory.share()
    let states = await when directory => directory.state_view(mut driver.minted, moniker: ident::Moniker(text: moniker.text), principal: ident::Principal(text: principal.text), alloc)
    let roots = await when directory => directory.own_view(mut driver.minted, grant: BRANCH_GRANT, prefix: "/", branch: target.as_str(), rights: branching(), moniker: ident::Moniker(text: moniker.text), principal: ident::Principal(text: principal.text), alloc)
    let inputs = sender.split()
    discard s.spawn(fn[take record, take moniker, take inputs]() fails task::Cancelled uses wait limits stack 32_768 {
        let prepared = match states {
            Some(state) => match roots {
                Some(root) => try await prepared_run(state, root, moniker, take record, renamed: not spec_names, alloc)
                None => Err(text::Fixed[32].of("port.server-stopped"))
            }
            None => Err(text::Fixed[32].of("port.server-stopped"))
        }
        discard attempt await inputs.send(Input.JobPrepared(outcome: prepared))
    })
} Shared.prepare_job

/// The rights of a job's View of the root of its branch: reading, writing, branching and merging, and owning the nodes its owning operations write.
fn branching() -> store::service::Rights = store::service::Rights(read: true, write: true, admin: true, secret_read: false, own: true, reserved: 0)

/// The next run of the job `moniker`: its specification `record`, given the moniker when `renamed`, written through `state`, a View of `/state`, and the View of `job/<moniker>`, created through `root`, a View of the root of the job's branch. The code of what failed otherwise.
fn prepared_run(
    state: store::service::View,
    root: store::service::View,
    moniker: ident::Moniker,
    take record: mem::Bytes,
    renamed: bool,
    alloc: mem::Alloc,
    ) -> Result[store::service::View, text::Fixed[32]] fails task::Cancelled uses wait {
    var written = mem::Bytes.empty(alloc)
    if renamed {
        let Ok(spec) = attempt mem::wire::Codec[os::JobSpec].decode(Untrusted.of(record.view()), alloc) else {
            return Err(text::Fixed[32].of("store.corrupt"))
        }
        var given = spec
        given.moniker = Some(ident::Moniker(text: moniker.text))
        mem::wire::Codec[os::JobSpec].encode(given, out: mut written)
    } else {
        mut written.append(record.view())
    }
    match try await put_record(state, path: state_dir(moniker, name: "job", alloc), type: store::TypeRef.of(JOB_SPEC_TYPE, schema: mem::wire::Codec[os::JobSpec].schema_hash(), alloc), bytes: take written, alloc) {
        Some(failed) => return Err(failed)
        None => {
        }
    }
    return match first attempt await root.branch(job_branch(moniker, alloc), at: None, alloc) {
        Ok(branched) => Ok(branched.view)
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => Err(failed.code())
    }
} prepared_run

/// Takes the preparation of the next run of the job of `driver`, which `outcome` gives, unless the job no longer starts: the run starts once a task of `s` tells the driver through `sender`, its Views of the job's branch reaching `job/<moniker>`, or ends as failed with the preparation's code.
fn Shared.job_prepared[J: Journal](
    self,
    mut driver: Driver,
    outcome: Result[store::service::View, text::Fixed[32]],
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    if driver.lifecycle != Some(os::Lifecycle.Starting) or driver.domain.is_some() {
        return
    }
    let failure = match outcome {
        Ok(writing) => match mut driver.job_ready(writing) {
            true => {
                self.elapse(s, ns: 0, inputs: sender.split(), incarnation: driver.incarnation)
                return
            }
            false => text::Fixed[32].of("request.invalid-operand")
        }
        Err(code) => code
    }
    try await self.job_ended(mut driver, outcome: os::JobOutcome.Failed(text: text::String.of(failure.as_str(), alloc: self.config.alloc)), cpu_ns: 0, sender, journal, s)
} Shared.job_prepared

/// Has the next run of the job of the driver write through `writing`, its Views of the job's branch reaching `job/<moniker>`; false, the run not prepared, when the branch name is too long for a redirect.
fn Driver.job_ready(mut self, writing: store::service::View) -> bool {
    let Some(job) = mut self.job.extract() else {
        return false
    }
    var ready = take job.into_contents()
    let redirected = self.minted.redirect.set(from: ready.order.branch.as_str(), to: Some(job_branch(ident::Moniker(text: self.moniker.text), alloc: self.alloc).as_str()))
    if redirected {
        ready.prepared = true
        ready.writing = Some(writing)
        ready.cancelled = None
    }
    self.job = Some(mem::Heap.of(self.alloc).boxed(take ready))
    return redirected
} Driver.job_ready

/// The run of the job of the driver its preparation made ready, `None` for an instance of a component: the View reading the image of its bundle, the encoding of its input and its deadline, the run starting at `started`.
fn Driver.take_run(mut self, started: ident::WallTime) -> Option[mem::Box[JobRun]] {
    let Some(job) = mut self.job.extract() else {
        return None
    }
    var running = take job.into_contents()
    var launching: Option[mem::Box[JobRun]] = None
    if running.prepared {
        var input = mem::Bytes.empty(self.alloc)
        mut input.append(running.order.input.view())
        launching = Some(mem::Heap.of(self.alloc).boxed(JobRun(code: running.code, bundle: self.spec.bundle, input: take input, deadline_s: running.order.deadline_s)))
        running.started = started
        running.prepared = false
    }
    self.job = Some(mem::Heap.of(self.alloc).boxed(take running))
    return launching
} Driver.take_run

/// A run of a job ready to launch: the View reading the image of the bundle of code hash `bundle`, the encoding of its input, and its deadline.
struct JobRun {
    code: Option[store::service::View]
    bundle: ident::HashValue
    input: mem::Bytes
    deadline_s: Option[u32]
} JobRun

/// Handles the end of the run `incarnation` of the job of `driver`, with `outcome` and `cpu_ns` charged, unless a later run started.
fn Shared.run_ended[J: Journal](
    self,
    mut driver: Driver,
    incarnation: u64,
    take outcome: os::JobOutcome,
    cpu_ns: u64,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    if incarnation != driver.incarnation {
        return
    }
    self.unbind(driver)
    try await self.gauges.unwatch(driver.moniker.text.as_str(), alloc: self.config.alloc)
    try await self.job_ended(mut driver, take outcome, cpu_ns, sender, journal, s)
    discard try await self.machine.settle(driver.pool)
} Shared.run_ended

/// Cancels the run `incarnation` of the job for its deadline, unless it has ended.
fn Driver.overdue(mut self, incarnation: u64) {
    if incarnation == self.incarnation and self.domain.is_some() {
        mut self.cancel_job("deadline")
    }
} Driver.overdue

/// The branch the job `moniker` writes to.
fn job_branch(moniker: ident::Moniker, alloc: mem::Alloc) -> text::String {
    var name = text::String.of("job/", alloc)
    mut name.append(moniker.text.as_str())
    return name
} job_branch

/// The image of the admitted bundle of code hash `bundle`, read through `code`, a View of `/sys/code`, in pieces; `store.not-found` when no image is admitted for it.
fn read_image(code: store::service::View, bundle: ident::HashValue, alloc: mem::Alloc) -> Result[mem::Bytes, text::Fixed[32]] fails task::Cancelled uses wait {
    var text = text::String.of("/", alloc)
    mut text.append(bundle.full_form().as_str())
    mut text.append("/image")
    let node = match first attempt await code.get(ident::Path(text: text::String.of(text.as_str(), alloc)), at: None, alloc) {
        Ok(found) => found
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => return Err(failed.code())
    }
    let Some(id) = node.hash else {
        return Err(text::Fixed[32].of("store.not-found"))
    }
    var read = Untrusted.of(mem::Bytes.empty(alloc))
    while u64.widen(read.byte_len()) < node.size {
        let piece = match first attempt await code.read(ident::Path(text: text::String.of(text.as_str(), alloc)), at: Some(node.version), offset: u64.widen(read.byte_len()), length: IMAGE_CHUNK, alloc) {
            Ok(given) => given
            Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
            Err(failed) => return Err(failed.code())
        }
        if piece.byte_len() == 0 {
            return Err(text::Fixed[32].of("store.corrupt"))
        }
        mut read.append(piece.view())
    }
    return match admitted_image(read.view(), id, alloc) {
        Some(image) => Ok(take image)
        None => Err(text::Fixed[32].of("store.corrupt"))
    }
} read_image

/// A copy of the image `raw` holds when its blob id is `id`, that of the image admission took.
validator fn admitted_image(raw: Untrusted[Slice[u8]], id: ident::HashValue, alloc: mem::Alloc) -> Option[mem::Bytes] {
    let bytes = raw.inspect()
    if ident::HashValue.of_content(bytes) != id {
        return None
    }
    var image = mem::Bytes.empty(alloc)
    mut image.append(bytes)
    return Some(take image)
} admitted_image

/// Puts the record `bytes` of `type` at `path` of `view`; the code of the commit's failure, `None` once committed.
fn put_record(
    view: store::service::View,
    take path: ident::Path,
    take type: store::TypeRef,
    take bytes: mem::Bytes,
    alloc: mem::Alloc,
    ) -> Option[text::Fixed[32]] fails task::Cancelled uses wait {
    var writes = mem::List[store::Write].empty(alloc)
    mut writes.push(store::Write.Put(path: take path, value: store::Value.Record(type: take type, bytes: take bytes, secret: false)))
    let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: None, plan: None, intent: None)
    return match first attempt await view.commit(take transaction, typed: true, alloc) {
        Ok(_) => None
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => Some(failed.code())
    }
} put_record

/// Runs the job's `main` `ready` launches under `header` on a task of `s`, through `exec` and `alloc` in a domain run of `abandoner`, on `world`, from the image of its bundle and the encoding of its input; then reads the CPU time its account was charged through `marks`, ends its watch, and tells its driver how it ended. A task of `s` tells the driver when the run's deadline passes.
fn Shared.launch_job(
    self,
    s: task::Scope,
    take ready: mem::Box[JobRun],
    take world: nanos::World,
    exec: task::Executor,
    alloc: mem::Alloc,
    take abandoner: mem::Shared[sys::Abandoner],
    take marks: task::Sender[Mark],
    take ended: task::Sender[Input],
    incarnation: u64,
    header: os::Header,
    ) {
    let JobRun(code: reading, bundle: hash, input: input, deadline_s: deadline_s) = take ready.into_contents()
    let launch = JobLaunch(code: reading, bundle: hash, input: take input, world: take world)
    let components = self.components
    let own = self.config.alloc
    match deadline_s {
        Some(seconds) => {
            let clock = self.config.clock
            let overdue = ended.split()
            discard s.spawn(fn[take overdue]() fails task::Cancelled uses wait limits stack 4_096 {
                try await clock.sleep_ns(u64.widen(seconds) * 1_000_000_000)
                discard attempt await overdue.send(Input.Overdue(incarnation: incarnation))
            })
        }
        None => {
        }
    }
    discard s.spawn(fn[take launch, take abandoner, take marks, take ended]() fails task::Cancelled uses wait limits stack 32_768 {
        var given = Some(take launch)
        let outcome = try await sys::run_headed(header.carried(), body: fn[mut given]() -> os::JobOutcome fails task::Cancelled uses wait {
            let Some(JobLaunch(code: code, bundle: bundle, input: encoded, world: granted)) = mut given.extract() else {
                return os::JobOutcome.Interrupted
            }
            let Some(view) = code else {
                return os::JobOutcome.Failed(text: text::String.of("port.server-stopped", alloc))
            }
            let image = match try await read_image(view, bundle, alloc) {
                Ok(read) => read
                Err(failure) => return os::JobOutcome.Failed(text: text::String.of(failure.as_str(), alloc))
            }
            return try await components.run_job(take image, code: bundle, input: take encoded, world: take granted, domain: abandoner.contents(), exec, alloc)
        })
        var cpu_ns: u64 = 0
        let task::Channel(sender: reply, receiver: read) = task::Channel[os::Gauge].bounded(1, alloc: own)
        match attempt await marks.send(Mark.Read(reply: take reply)) {
            Ok(_) => {
                var receiver = read
                match try await mut receiver.receive() {
                    Some(gauge) => {
                        cpu_ns = gauge.cpu_ns
                    }
                    None => {
                    }
                }
            }
            Err(task::SendError.Closed) => {
            }
            Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        }
        discard attempt await marks.send(Mark.Ended)
        discard attempt await ended.send(Input.JobEnded(incarnation: incarnation, outcome: take outcome, cpu_ns: cpu_ns))
    })
} Shared.launch_job

/// Has the running job of the driver cancelled for `reason`, abandoning its domain.
fn Driver.cancel_job(mut self, reason: Str) {
    let Some(job) = mut self.job.extract() else {
        return
    }
    var cancelling = take job.into_contents()
    if cancelling.cancelled.is_none() {
        cancelling.cancelled = Some(text::Fixed[16].of(reason))
    }
    self.job = Some(mem::Heap.of(self.alloc).boxed(take cancelling))
    self.trigger()
} Driver.cancel_job

/// Notes that the job of the driver has ended for good.
fn Driver.end_job(mut self) {
    let Some(job) = mut self.job.extract() else {
        return
    }
    var ended = take job.into_contents()
    ended.over = true
    self.job = Some(mem::Heap.of(self.alloc).boxed(take ended))
} Driver.end_job

/// Handles the end of a run of the job of `driver` with `outcome`, its account charged `cpu_ns`, its Views of the job's branch reaching that branch again: a task of `s` has the store merge `job/<moniker>` into the job's branch when `main` returned and keeps the result at `/state/<moniker>/result`, then tells the driver through `sender` whether the job runs again, as its restart policy asks unless the runner cancelled it.
fn Shared.job_ended[J: Journal](
    self,
    mut driver: Driver,
    take outcome: os::JobOutcome,
    cpu_ns: u64,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    try await self.end_reservation(mut driver)
    try await mut driver.end_domain()
    let alloc = self.config.alloc
    var branch = text::String.empty(alloc)
    var started = ident::WallTime(utc_ns: 0, uncertainty_ns: 0)
    var cancelled: Option[text::Fixed[16]] = None
    var writing: Option[store::service::View] = None
    match driver.job {
        Some(job) => {
            let held = job.contents()
            mut branch.append(held.order.branch.as_str())
            started = held.started
            cancelled = held.cancelled
            writing = held.writing
        }
        None => return
    }
    discard driver.minted.redirect.set(from: branch.as_str(), to: None)
    var ended = outcome
    if unexplained(ended) {
        ended = os::JobOutcome.Cancelled(reason: text::String.of(match cancelled {
            Some(reason) => reason.as_str()
            None => "cancel"
        }, alloc))
    }
    let returned = match ended {
        os::JobOutcome.Returned(bytes: _) => true
        else => false
    }
    let rerun = match driver.spec.restart.policy {
        os::RestartPolicy.Permanent => cancelled.is_none()
        os::RestartPolicy.Transient => cancelled.is_none() and not returned
        os::RestartPolicy.Temporary => false
    }
    let ending = match returned or cancelled.is_some() {
        true => os::Lifecycle.Stopped
        false => os::Lifecycle.Failed
    }
    driver.lifecycle = Some(os::Lifecycle.Stopping)
    let moniker = ident::Moniker(text: driver.moniker.text)
    let principal = ident::Principal(text: driver.spec.principal.text)
    let directory = self.directory.share()
    let states = await when directory => directory.state_view(mut driver.minted, moniker: ident::Moniker(text: moniker.text), principal: ident::Principal(text: principal.text), alloc)
    let roots = await when directory => directory.own_view(mut driver.minted, grant: BRANCH_GRANT, prefix: "/", branch: branch.as_str(), rights: branching(), moniker: ident::Moniker(text: moniker.text), principal: ident::Principal(text: principal.text), alloc)
    let ended_at = self.config.wall.now(self.config.clock)
    let inputs = sender.split()
    discard s.spawn(fn[take ended, take moniker, take inputs]() fails task::Cancelled uses wait limits stack 32_768 {
        var commit: Option[ident::CommitId] = None
        var failure: Option[text::String] = None
        if returned {
            match try await merged(roots, writing, moniker, alloc) {
                Ok(done) => {
                    commit = Some(done)
                }
                Err(code) => {
                    failure = Some(text::String.of(code.as_str(), alloc))
                }
            }
        }
        let kind = outcome_name(ended)
        let result = os::JobResult(outcome: take ended, status: None, commit: commit, commit_failure: take failure, seed: None, started: started, ended: ended_at, cpu_ns: cpu_ns)
        match states {
            Some(state) => {
                var bytes = mem::Bytes.empty(alloc)
                mem::wire::Codec[os::JobResult].encode(result, out: mut bytes)
                discard try await put_record(state, path: state_dir(moniker, name: "result", alloc), type: store::TypeRef.of(JOB_RESULT_TYPE, schema: mem::wire::Codec[os::JobResult].schema_hash(), alloc), take bytes, alloc)
            }
            None => {
            }
        }
        discard attempt await inputs.send(Input.JobRecorded(Recorded(outcome: kind, commit: commit, rerun: rerun, ending: ending)))
    })
} Shared.job_ended

/// Takes the end of a run of the job of `driver`, once its result is kept as `recorded` tells: emits `instance.job-ended`, then runs the job again when `recorded` asks and its restart intensity allows, and ends it for good otherwise.
fn Shared.job_recorded[J: Journal](
    self,
    mut driver: Driver,
    recorded: Recorded,
    sender: task::Sender[Input],
    journal: J,
    s: task::Scope,
    ) {
    journal.record(driver.slot, cause: driver.cause, event: Event.JobEnded(outcome: recorded.outcome, commit: recorded.commit))
    if recorded.rerun {
        match mut driver.restarts.next(driver.spec.restart, bounded: true, started_ns: driver.started_ns, now_ns: now(self.config.clock)) {
            Next.After(ns: ns) => {
                driver.lifecycle = Some(os::Lifecycle.Starting)
                self.elapse(s, ns, inputs: sender.split(), incarnation: driver.incarnation)
                return
            }
            Next.Fail => {
            }
        }
    }
    driver.lifecycle = Some(recorded.ending)
    mut driver.end_job()
} Shared.job_recorded

/// Whether `outcome` is a cancellation whose reason the runner has to give: an abandonment of the job's domain.
fn unexplained(outcome: os::JobOutcome) -> bool {
    return match outcome {
        os::JobOutcome.Cancelled(reason: reason) => reason.byte_len() == 0
        else => false
    }
} unexplained

/// Has the store merge `job/<moniker>`, which `writing` is a View of, as one commit into the branch `root` is a View of the root of, then delete it, giving the commit or the code of the failure; the branch is kept when the merge fails.
fn merged(root: Option[store::service::View], writing: Option[store::service::View], moniker: ident::Moniker, alloc: mem::Alloc) -> Result[ident::CommitId, text::Fixed[32]] fails task::Cancelled uses wait {
    let Some(target) = root else {
        return Err(text::Fixed[32].of("port.server-stopped"))
    }
    let Some(source) = writing else {
        return Err(text::Fixed[32].of("request.invalid-operand"))
    }
    let commit = match first attempt await target.merge(source, takes: mem::List.empty(alloc), alloc) {
        Ok(committed) => committed.number
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => return Err(failed.code())
    }
    match first attempt await target.delete_branch(job_branch(moniker, alloc), alloc) {
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
    return Ok(commit)
} merged

/// The name of the kind of a job's outcome, as `instance.job-ended` gives it.
fn outcome_name(outcome: os::JobOutcome) -> text::Fixed[16] {
    return text::Fixed[16].of(match outcome {
        os::JobOutcome.Returned(bytes: _) => "returned"
        os::JobOutcome.Failed(text: _) => "failed"
        os::JobOutcome.Trapped(text: _) => "trapped"
        os::JobOutcome.Cancelled(reason: _) => "cancelled"
        os::JobOutcome.Interrupted => "interrupted"
    })
} outcome_name
