//! Energy: what an account's CPU time costs at the power of a running CPU, and the bucket of its energy budget.

/// The nanojoules of a millijoule.
const NJ_PER_MJ: u64 = 1_000_000

/// The nanoseconds of an hour, over which a bucket refills its whole budget.
const HOUR_NS: u64 = 3_600_000_000_000

/// The part of an hour's budget a throttled bucket refills to before its account runs in its class again: a minute.
const MINUTES_PER_HOUR: u64 = 60

/// An account's energy: what it has used, in nanojoules, and the bucket of its budget of `budget_mj_per_h` millijoules per hour, none when 0, holding `held_nj` as of `filled_ns`, and whether the account is throttled.
struct Energy derives Copy, Eq {
    used_nj: u64
    budget_mj_per_h: u64
    held_nj: u64
    filled_ns: u64
    throttled: bool
} Energy

/// The energy of an account with a budget of `budget_mj_per_h` millijoules per hour, its bucket full at `now_ns`.
fn Energy.of(budget_mj_per_h: u64, now_ns: u64) -> Energy {
    return Energy(used_nj: 0, budget_mj_per_h: budget_mj_per_h, held_nj: budget_mj_per_h.saturating_mul(NJ_PER_MJ), filled_ns: now_ns, throttled: false)
} Energy.of

/// The millijoules the account has used.
fn Energy.used_mj(self) -> u64 = self.used_nj / NJ_PER_MJ

/// Charges `cpu_ns` more of CPU time at `busy_mw` milliwatts at `now_ns`: the bucket refills at the budget per hour up to a whole hour's budget, then drains by the energy used; it throttles the account once empty, and lets it run in its class again once it holds a minute's budget.
fn Energy.charge(mut self, cpu_ns: u64, busy_mw: u64, now_ns: u64) {
    let used = cpu_ns.saturating_mul(busy_mw) / 1_000
    self.used_nj = self.used_nj.saturating_add(used)
    if self.budget_mj_per_h == 0 {
        return
    }
    let full = self.budget_mj_per_h.saturating_mul(NJ_PER_MJ)
    let refill = now_ns.saturating_sub(self.filled_ns).saturating_mul(self.budget_mj_per_h) / (HOUR_NS / NJ_PER_MJ)
    self.filled_ns = now_ns
    self.held_nj = self.held_nj.saturating_add(refill).min(full).saturating_sub(used)
    if self.held_nj == 0 {
        self.throttled = true
    } else if self.held_nj >= full / MINUTES_PER_HOUR {
        self.throttled = false
    }
} Energy.charge

/// An account's energy and the CPU time charged to it so far.
struct Spent derives Copy {
    energy: Energy
    charged_ns: u64
} Spent

/// Charges the CPU time the account has used beyond what was charged, `used_ns` in all, at `busy_mw` at `now_ns`.
fn Spent.charge(mut self, used_ns: u64, busy_mw: u64, now_ns: u64) {
    mut self.energy.charge(cpu_ns: used_ns.saturating_sub(self.charged_ns), busy_mw, now_ns)
    self.charged_ns = self.charged_ns.max(used_ns)
} Spent.charge

/// A second of CPU time at 2 W costs 2 J; a budget of 3.6 J per hour refills 1 mJ a second, an account spending more than its bucket holds is throttled, and runs in its class again once a minute's budget has refilled.
test buckets_throttle_until_a_minute_of_budget_refills for Energy.charge {
    var energy = Energy.of(budget_mj_per_h: 3_600, now_ns: 0)
    mut energy.charge(cpu_ns: 1_000_000_000, busy_mw: 2_000, now_ns: 1_000_000_000)
    expect energy.used_mj() == 2_000 and not energy.throttled and energy.held_nj == 1_600 * NJ_PER_MJ
    mut energy.charge(cpu_ns: 1_000_000_000, busy_mw: 2_000, now_ns: 2_000_000_000)
    expect energy.throttled and energy.held_nj == 0
    mut energy.charge(cpu_ns: 0, busy_mw: 2_000, now_ns: 61_000_000_000)
    expect energy.throttled and energy.held_nj == 59 * NJ_PER_MJ
    mut energy.charge(cpu_ns: 0, busy_mw: 2_000, now_ns: 62_000_000_000)
    expect not energy.throttled and energy.used_mj() == 4_000
    var unbudgeted = Energy.of(budget_mj_per_h: 0, now_ns: 0)
    mut unbudgeted.charge(cpu_ns: 10_000_000_000, busy_mw: 2_000, now_ns: 1)
    expect not unbudgeted.throttled and unbudgeted.used_mj() == 20_000
} buckets_throttle_until_a_minute_of_budget_refills
