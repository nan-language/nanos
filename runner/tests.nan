    let started = counts.started.contents().load()
    expect started == 1
} forks_run_apart_from_their_instance

/// Adds 5 to the running tally, then has a fork of its state at quiescence handle `echo(2)` once; `None` unless the tally's own total stays 5.
fn echoed(core: Core, alloc: mem::Alloc) -> Option[os::Forked] fails Failure uses wait {
    discard try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    discard try await add(port, amount: 5, alloc)
    let forking = os::Forking(branch: text::String.of("main", alloc), from: os::ForkFrom.Live, call: Some(echo_call(alloc)))
    let seen = try await core.control.fork(named("tally"), take forking, alloc)
    if try await add(port, amount: 0, alloc) != 5 {
        return None
    }
    return seen
} echoed

