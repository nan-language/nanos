//! Tests of the runner, running instances of a tally that serves the Counter protocol.

enum Refused derives Render, Encode {
    TooLarge
} Refused

protocol Counter {
    pub fn add(amount: u32) -> u64 fails Refused limits pure
    pub fn note(amount: u32) limits pure
    pub fn divide(by: u32) limits pure
    /// The total once a later `settle` answers it, 0 at once while another waits.
    pub fn later() -> u64 limits recorded
    /// Answers the `later` waiting with the total, giving how many it answered.
    pub fn settle() -> u32 limits recorded
    /// Whether the tally is suspended.
    pub fn asleep() -> bool limits pure
    /// The cause of the handler call, as a header holds it.
    pub fn cause() -> u64 limits pure
} Counter

struct TallyEnv {
    alloc: mem::Alloc
} TallyEnv

impl TallyEnv: nanos::Environment

struct Tally derives Encode {
    total: u64
    waiting: Option[u64]
    suspended: bool
} Tally

impl Tally: sys::Component[TallyEnv, Counter]

impl Tally: sys::Suspend[TallyEnv, Counter]

/// A component of the runner's tests, which runs only `runner::Tally`.
struct Tallies derives Copy {
} Tallies

impl Tallies: Components

/// The memory the tests set aside for reserved instances: a store over the world's allocator, or none when it does not hold any.
struct Spare {
    alloc: mem::Alloc
    holds: bool
} Spare

impl Spare: Reservations

/// A journal counting each kind of event and the spans, keeping the cause of the last start and of the last span, and opening causes numbered from `OPENED` up, the last under `parent`.
struct Counts {
    started: mem::Shared[core::atomic::AtomicU64]
    stopped: mem::Shared[core::atomic::AtomicU64]
    trapped: mem::Shared[core::atomic::AtomicU64]
    failed: mem::Shared[core::atomic::AtomicU64]
    revoked: mem::Shared[core::atomic::AtomicU64]
    spans: mem::Shared[core::atomic::AtomicU64]
    start_cause: mem::Shared[core::atomic::AtomicU64]
    span_cause: mem::Shared[core::atomic::AtomicU64]
    opened: mem::Shared[core::atomic::AtomicU64]
    parent: mem::Shared[core::atomic::AtomicU64]
} Counts

/// The first cause a `Counts` opens.
const OPENED: u64 = 0x1000

impl Counts: Journal

enum Failure derives Render {
    Port(os::PortError[Refused]) from
    Post(os::PortError[Never]) from
    Control(os::ControlError) from
    Cancelled(task::Cancelled) from
} Failure

fn TallyEnv.build(take world: nanos::World) -> TallyEnv = TallyEnv(alloc: world.alloc)

fn Tally.start(mut env: TallyEnv) -> Tally = Tally(total: 0, waiting: None, suspended: false)

fn Tally.add(mut self, take amount: u32, mut env: TallyEnv, mut cx: sys::Cx[Counter]) -> u64 fails Refused {
    if amount > 1_000 {
        fail Refused.TooLarge
    }
    self.total += u64.widen(amount)
    return self.total
} Tally.add

fn Tally.note(mut self, take amount: u32, mut env: TallyEnv, mut cx: sys::Cx[Counter]) {
    self.total += u64.widen(amount)
} Tally.note

fn Tally.divide(mut self, take by: u32, mut env: TallyEnv, mut cx: sys::Cx[Counter]) {
    self.total = self.total / u64.widen(by)
} Tally.divide

fn Tally.later(mut self, mut env: TallyEnv, mut cx: sys::Cx[Counter]) -> u64 {
    self.waiting = mut cx.postpone()
    return 0
} Tally.later

fn Tally.settle(mut self, mut env: TallyEnv, mut cx: sys::Cx[Counter]) -> u32 {
    let Some(request) = mut self.waiting.extract() else {
        return 0
    }
    var reply = sys::Encoded.empty(env.alloc)
    let total: Result[u64, Never] = Ok(self.total)
    mem::wire::Codec[Result[u64, Never]].encode(total, out: mut reply.bytes)
    discard attempt mut cx.reply(request, reply)
    return 1
} Tally.settle

fn Tally.asleep(mut self, mut env: TallyEnv, mut cx: sys::Cx[Counter]) -> bool {
    return self.suspended
} Tally.asleep

fn Tally.cause(mut self, mut env: TallyEnv, mut cx: sys::Cx[Counter]) -> u64 {
    return os::Header.current().cause
} Tally.cause

fn Tally.suspend(mut self, mut env: TallyEnv, mut cx: sys::Cx[Counter]) {
    self.suspended = true
} Tally.suspend

fn Tally.wake(mut self, mut env: TallyEnv, mut cx: sys::Cx[Counter]) {
    self.suspended = false
} Tally.wake

fn Tallies.protocols(self, component: Str) -> Option[os::Protocols] {
    if component == "runner::Tally" {
        return Some(os::Protocols(own: sys::Wire[Counter].hash(), serves: None))
    }
    return None
} Tallies.protocols

fn Tallies.configured(self, component: Str) -> bool = false

fn Tallies.forkable(self, component: Str) -> bool = true

fn Tallies.schema(self, component: Str, alloc: mem::Alloc) -> Option[sys::ProtocolSchema] {
    if component == "runner::Tally" {
        return Some(sys::Wire[Counter].schema(alloc))
    }
    return None
} Tallies.schema

fn Tallies.serve(self, component: Str, take world: nanos::World, take serving: Serving) -> Ended fails task::Cancelled uses wait {
    return try await Served[Tally, TallyEnv, Counter].run(take world, take serving)
} Tallies.serve

fn Spare.reserve(self, bytes: u64) -> Option[mem::Heap] {
    if not self.holds {
        return None
    }
    return Some(mem::Heap.of(self.alloc))
} Spare.reserve

/// Postings no board reads.
fn unlogged(alloc: mem::Alloc) -> task::Sender[journal::Logged] {
    let task::Channel(sender: logs, receiver: dropped) = task::Channel[journal::Logged].bounded(1, alloc)
    discard dropped
    return logs
} unlogged

/// No set of traced instances.
fn untraced(alloc: mem::Alloc) -> task::Receiver[mem::List[journal::TracedInstance]] {
    let task::Channel(sender: dropped, receiver: tracings) = task::Channel[mem::List[journal::TracedInstance]].bounded(1, alloc)
    discard dropped
    return tracings
} untraced

fn unread(alloc: mem::Alloc) -> task::Sender[os::Posting] {
    let task::Channel(sender: posted, receiver: dropped) = task::Channel[os::Posting].bounded(1, alloc)
    discard dropped
    return posted
} unread

fn Counts.of(alloc: mem::Alloc) -> Counts {
    return Counts(started: counter(alloc), stopped: counter(alloc), trapped: counter(alloc), failed: counter(alloc), revoked: counter(alloc), spans: counter(alloc), start_cause: counter(alloc), span_cause: counter(alloc), opened: counter(alloc), parent: counter(alloc))
} Counts.of

fn Counts.record(self, slot: u32, cause: u64, event: Event) {
    match event {
        Event.Started(incarnation: _, checkpoint: _) => self.start_cause.contents().store(cause)
        else => {
        }
    }
    let count = match event {
        Event.Started(incarnation: _, checkpoint: _) => self.started.share()
        Event.Stopped(abandoned: _) => self.stopped.share()
        Event.Trapped(incarnation: _, kind: _, limit: _) => self.trapped.share()
        Event.Failed(restarts: _) => self.failed.share()
        Event.Revoked(grant: _, reason: _) => self.revoked.share()
        else => return
    }
    discard count.contents().fetch_add(1)
} Counts.record

fn Counts.open(self, slot: u32, moniker: ident::Moniker, incarnation: u64, parent: u64) -> u64 {
    self.parent.contents().store(parent)
    return OPENED + self.opened.contents().fetch_add(1).value_or(0)
} Counts.open

fn Counts.span(self, slot: u32, span: Span) {
    self.span_cause.contents().store(span.cause)
    discard self.spans.contents().fetch_add(1)
} Counts.span

fn Counts.name(self, slot: u32, take moniker: ident::Moniker) {
} Counts.name

fn counter(alloc: mem::Alloc) -> mem::Shared[core::atomic::AtomicU64] {
    return mem::Shared.of(core::atomic::AtomicU64.of(0), alloc)
} counter

fn named(text: Str) -> ident::Moniker {
    return ident::Moniker(text: text::Fixed[59].of(text))
} named

fn system() -> ident::Principal {
    return ident::Principal(text: text::Fixed[64].of("system"))
} system

/// The wall time the tests' runners start at: noon UTC on 2026-11-05.
const NOON_NS: i64 = 1_793_880_000_000_000_000

/// A runner configuration over a test's world.
fn configured(world: host::World) -> Config {
    var classes = Array[u8, 4].filled(0)
    classes[0] = 1
    classes[1] = 2
    classes[2] = 3
    classes[3] = 4
    return Config(exec: world.exec, pool: world.alloc, alloc: world.alloc, clock: world.clock, wall: ident::Wall(at: ident::WallTime(utc_ns: NOON_NS, uncertainty_ns: 1_000_000_000), since_ns: 0), random: world.random, classes: classes, system: ident::Cause.of(1, number: 1))
} configured

/// One tally named `tally`, whose specification `adjust` changes, and no grant.
fn one_tally(alloc: mem::Alloc, adjust: fn(mut spec: os::InstanceSpec)) -> Known {
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    var spec = os::InstanceSpec.of(principal: system(), bundle: ident::HashValue(bytes: bundle), component: "runner::Tally", alloc)
    adjust(mut spec)
    var specs = mem::Map[ident::Moniker, os::InstanceSpec].empty(alloc)
    discard mut specs.insert(named("tally"), value: take spec)
    return Known(specs: take specs, grants: mem::Map.empty(alloc))
} one_tally

fn add(port: os::Port[Counter], amount: u32, alloc: mem::Alloc) -> u64 fails os::PortError[Refused] uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Counter].add(mut call, amount)
    return try await port.call(take call, reply, alloc)
} add

fn note(port: os::Port[Counter], amount: u32, alloc: mem::Alloc) fails os::PortError[Never] uses wait {
    var call = sys::Encoded.empty(alloc)
    sys::Wire[Counter].note(mut call, amount)
    try await port.post(take call)
} note

fn cause_of(port: os::Port[Counter], alloc: mem::Alloc) -> u64 fails os::PortError[Never] uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Counter].cause(mut call)
    return try await port.call(take call, reply, alloc)
} cause_of

fn divide(port: os::Port[Counter], by: u32, alloc: mem::Alloc) fails os::PortError[Never] uses wait {
    var call = sys::Encoded.empty(alloc)
    sys::Wire[Counter].divide(mut call, by)
    try await port.post(take call)
} divide

/// What a test body saw.
struct Seen derives Copy, Eq {
    started: os::Lifecycle
    totals: Array[u64, 3]
    last: os::Lifecycle
    refused: bool
} Seen

fn unchanged(mut spec: os::InstanceSpec) {
} unchanged

/// Starts the tally, calls and posts to it, stops it, then calls it once more.
fn exercised(core: Core, alloc: mem::Alloc) -> Seen fails Failure uses wait {
    let started = try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    var totals = Array[u64, 3].filled(0)
    totals[0] = try await add(port, amount: 5, alloc)
    try await note(port, amount: 3, alloc)
    totals[1] = try await add(port, amount: 7, alloc)
    let large = attempt await add(port, amount: 5_000, alloc)
    totals[2] = try await add(port, amount: 0, alloc)
    let last = try await core.control.stop(named("tally"), alloc)
    let stopped = attempt await add(port, amount: 1, alloc)
    let refused = match large {
        Err(os::PortError.Failed(Refused.TooLarge)) => true
        else => false
    }
    let closed = match stopped {
        Err(os::PortError.Stopped) => true
        else => false
    }
    return Seen(started: started, totals: totals, last: last, refused: refused and closed)
} exercised

/// Whether the gauge of the running incarnation of `tally` read its cell's charge within its limit, and whether none read once it stopped.
fn read_tally(core: Core, gauges: Gauges, alloc: mem::Alloc) -> Array[bool, 2] fails Failure uses wait {
    discard try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    discard try await add(port, amount: 5, alloc)
    discard try await add(port, amount: 2, alloc)
    let running = try await gauges.read("tally", alloc)
    discard try await core.control.stop(named("tally"), alloc)
    let stopped = try await gauges.read("tally", alloc)
    var seen = Array[bool, 2].filled(false)
    seen[0] = match running {
        Some(gauge) => gauge.memory.charged > 0 and gauge.memory.charged <= gauge.memory.peak and gauge.memory.peak <= gauge.memory.limit and gauge.intake == 0 and gauge.incarnation == 1 and gauge.messages >= 1 and bucketed(gauge.latency) == gauge.messages
        None => false
    }
    seen[1] = stopped.is_none()
    return seen
} read_tally

fn bucketed(latency: Array[u64, 32]) -> u64 {
    var total: u64 = 0
    for count in latency {
        total += count
    }
    return total
} bucketed

test running_incarnations_read_their_gauges_until_they_end for Gauges.read {
    let world = testing::world()
    let gauges = Gauges.empty(world.alloc)
    let reading = gauges.share()
    let seen = try await run(one_tally(world.alloc, adjust: unchanged), components: Tallies(), journal: Counts.of(world.alloc), reservations: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges, tracings: untraced(world.alloc), body: fn(core: Core) -> Array[bool, 2] fails Failure uses wait {
        return try await read_tally(core, gauges: reading, alloc: world.alloc)
    })
    let Some(read) = seen else {
        expect false
        return
    }
    expect read[0] and read[1]
} running_incarnations_read_their_gauges_until_they_end

/// The causes the tally's handler calls saw: of a call sent under `traced`, then of one sent as the runner's work.
fn caused(core: Core, traced: u64, alloc: mem::Alloc) -> Array[u64, 2] fails Failure uses wait {
    discard try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    var seen = Array[u64, 2].filled(0)
    seen[0] = try await sys::run_headed(os::Header.of_work(cause: traced, slot: 0).carried(), body: fn() -> u64 fails Failure uses wait {
        return try await cause_of(port, alloc)
    })
    seen[1] = try await cause_of(port, alloc)
    discard try await core.control.stop(named("tally"), alloc)
    return seen
} caused

test calls_carry_their_cause_and_traced_ones_a_span for run {
    let world = testing::world()
    let counts = Counts.of(world.alloc)
    let traced = ident::Cause.of(1, number: 7).bits | 0x8000_0000_0000_0000
    let seen = try await run(one_tally(world.alloc, adjust: unchanged), components: Tallies(), journal: counts, reservations: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[u64, 2] fails Failure uses wait {
        return try await caused(core, traced, alloc: world.alloc)
    })
    let Some(causes) = seen else {
        expect false
        return
    }
    let spans = counts.spans.contents().load()
    let span_cause = counts.span_cause.contents().load()
    let start_cause = counts.start_cause.contents().load()
    let parent = counts.parent.contents().load()
    let system_cause = ident::Cause.of(1, number: 1).bits
    expect causes[0] == traced and causes[1] == system_cause
    expect spans == 1 and span_cause == traced and start_cause == OPENED and parent == system_cause
} calls_carry_their_cause_and_traced_ones_a_span

test instances_are_traced_until_their_expiry for traced_until {
    let world = testing::world()
    let config = configured(world)
    var traced = mem::List[journal::TracedInstance].empty(world.alloc)
    mut traced.push(journal::TracedInstance(moniker: named("tally"), expires: ident::WallTime(utc_ns: NOON_NS + 60_000_000_000, uncertainty_ns: 0)))
    mut traced.push(journal::TracedInstance(moniker: named("gone"), expires: ident::WallTime(utc_ns: NOON_NS - 1, uncertainty_ns: 0)))
    let until = traced_until(traced, moniker: named("tally"), config).value_or(0)
    let expired = traced_until(traced, moniker: named("gone"), config)
    let unnamed = traced_until(traced, moniker: named("other"), config)
    let bound = now(config.clock) + 60_000_000_000
    expect until > 59_000_000_000 and until <= bound
    expect expired.is_none() and unnamed.is_none()
} instances_are_traced_until_their_expiry

test instances_serve_calls_in_order_until_stopped for run {
    let world = testing::world()
    let counts = Counts.of(world.alloc)
    let seen = try await run(one_tally(world.alloc, adjust: unchanged), components: Tallies(), journal: counts, reservations: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Seen fails Failure uses wait {
        return try await exercised(core, alloc: world.alloc)
    })
    var totals = Array[u64, 3].filled(0)
    totals[0] = 5
    totals[1] = 15
    totals[2] = 15
    expect seen == Some(Seen(started: os::Lifecycle.Running, totals: totals, last: os::Lifecycle.Stopped, refused: true))
    let started = counts.started.contents().load()
    let stopped = counts.stopped.contents().load()
    expect started == 1 and stopped == 1
} instances_serve_calls_in_order_until_stopped

/// Describes the tally through the core's `Control`, then refuses to restore a checkpoint of it, which keeps none.
fn describing(core: Core, alloc: mem::Alloc) -> bool fails Failure uses wait {
    let described = try await core.control.describe(named("tally"), alloc)
    let restored = attempt await core.control.restore(named("tally"), number: 1, alloc)
    let volatile = match restored {
        Err(os::ControlError.Volatile) => true
        else => false
    }
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    return volatile and described.schema.hash == sys::Wire[Counter].hash() and described.schema.operations.len() == 7 and described.bundle == ident::HashValue(bytes: bundle)
} describing

test controls_describe_instances_and_restore_only_checkpointed_ones for Shared.described {
    let world = testing::world()
    let counts = Counts.of(world.alloc)
    let seen = try await run(one_tally(world.alloc, adjust: unchanged), components: Tallies(), journal: counts, reservations: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> bool fails Failure uses wait {
        return try await describing(core, alloc: world.alloc)
    })
    expect seen == Some(true)
} controls_describe_instances_and_restore_only_checkpointed_ones

/// Adds 5 to the running tally, then forks it fresh: the fork's run, which sees no fault, leaves the tally's total as it was.
fn forked(core: Core, alloc: mem::Alloc) -> Option[os::Forked] fails Failure uses wait {
    discard try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    discard try await add(port, amount: 5, alloc)
    let seen = try await core.control.fork(named("tally"), forking: os::Forking(branch: text::String.of("main", alloc), resumed: false, checkpoint: None), alloc)
    if try await add(port, amount: 0, alloc) != 5 {
        return None
    }
    return seen
} forked

test forks_run_apart_from_their_instance for Shared.fork {
    let world = testing::world()
    let counts = Counts.of(world.alloc)
    let seen = try await run(one_tally(world.alloc, adjust: unchanged), components: Tallies(), journal: counts, reservations: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Option[os::Forked] fails Failure uses wait {
        return try await forked(core, alloc: world.alloc)
    })
    let Some(Some(forked_run)) = seen else {
        expect false
        return
    }
    expect forked_run.spawns == 0 and forked_run.sent == 0 and forked_run.fault.is_none()
    let started = counts.started.contents().load()
    expect started == 1
} forks_run_apart_from_their_instance

/// Calls the tally across a trap: the call queued behind the trapping one reaches the restarted incarnation.
fn restarted(core: Core, alloc: mem::Alloc) -> Array[u64, 2] fails Failure uses wait {
    discard try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    var totals = Array[u64, 2].filled(0)
    totals[0] = try await add(port, amount: 5, alloc)
    try await divide(port, by: 0, alloc)
    totals[1] = try await add(port, amount: 1, alloc)
    return totals
} restarted

test trapped_instances_restart_and_keep_their_intake for run {
    let world = testing::world()
    let counts = Counts.of(world.alloc)
    let totals = try await run(one_tally(world.alloc, adjust: unchanged), components: Tallies(), journal: counts, reservations: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[u64, 2] fails Failure uses wait {
        return try await restarted(core, alloc: world.alloc)
    })
    let started = counts.started.contents().load()
    let trapped = counts.trapped.contents().load()
    let Some(seen) = totals else {
        expect false
        return
    }
    expect seen[0] == 5 and seen[1] == 1
    expect started == 2 and trapped == 1
} trapped_instances_restart_and_keep_their_intake

fn fragile(mut spec: os::InstanceSpec) {
    spec.restart.intensity = 1
} fragile

/// Traps the tally twice within its period, then restarts it.
fn exhausted(core: Core, alloc: mem::Alloc) -> Array[os::Lifecycle, 2] fails Failure uses wait {
    discard try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    try await divide(port, by: 0, alloc)
    discard try await add(port, amount: 1, alloc)
    try await divide(port, by: 0, alloc)
    let refused = attempt await add(port, amount: 1, alloc)
    var states = Array[os::Lifecycle, 2].filled(os::Lifecycle.Stopped)
    states[0] = try await core.control.lifecycle(named("tally"), alloc)
    states[1] = try await core.control.restart(named("tally"), alloc)
    let again = try await add(port, amount: 2, alloc)
    let failed_calls = match refused {
        Err(os::PortError.Stopped) or Err(os::PortError.ServerStopped) => true
        else => false
    }
    if not failed_calls or again != 2 {
        fail Failure.Control(os::ControlError.Denied)
    }
    return states
} exhausted

test intensity_sends_instances_to_failed for run {
    let world = testing::world()
    let counts = Counts.of(world.alloc)
    let states = try await run(one_tally(world.alloc, adjust: fragile), components: Tallies(), journal: counts, reservations: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[os::Lifecycle, 2] fails Failure uses wait {
        return try await exhausted(core, alloc: world.alloc)
    })
    let failed = counts.failed.contents().load()
    let Some(seen) = states else {
        expect false
        return
    }
    expect seen[0] == os::Lifecycle.Failed and seen[1] == os::Lifecycle.Running
    expect failed == 1
} intensity_sends_instances_to_failed

/// Starts the tally, waits for its lifecycle to differ from `starting`, then from `running` while a task stops it.
fn followed(core: Core, exec: task::Executor, alloc: mem::Alloc) -> Array[os::Lifecycle, 2] fails Failure uses wait {
    var states = Array[os::Lifecycle, 2].filled(os::Lifecycle.Starting)
    discard try await core.control.start(named("tally"), alloc)
    states[0] = try await core.control.changed(named("tally"), seen: Some(os::Lifecycle.Starting), alloc)
    let control = core.control
    var changed: Result[os::Lifecycle, os::ControlError] = Err(os::ControlError.Missing)
    try await task::scope(exec, body: fn[mut changed](s: task::Scope) fails task::Cancelled uses wait {
        discard s.spawn(fn() fails task::Cancelled uses wait limits stack 8_192 {
            discard attempt await control.stop(named("tally"), alloc)
        })
        changed = match first attempt await control.changed(named("tally"), seen: Some(os::Lifecycle.Running), alloc) {
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            other => other
        }
    })
    states[1] = match changed {
        Ok(lifecycle) => lifecycle
        Err(failure) => fail Failure.Control(take failure)
    }
    return states
} followed

test changes_are_answered_once_the_lifecycle_differs for run {
    let world = testing::world()
    let counts = Counts.of(world.alloc)
    let states = try await run(one_tally(world.alloc, adjust: unchanged), components: Tallies(), journal: counts, reservations: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[os::Lifecycle, 2] fails Failure uses wait {
        return try await followed(core, exec: world.exec, alloc: world.alloc)
    })
    let Some(seen) = states else {
        expect false
        return
    }
    expect seen[0] == os::Lifecycle.Running
    expect seen[1] == os::Lifecycle.Stopping or seen[1] == os::Lifecycle.Stopped
} changes_are_answered_once_the_lifecycle_differs

fn lazy(mut spec: os::InstanceSpec) {
    spec.lazy = true
} lazy

/// Starts the lazy tally, then calls it.
fn woken(core: Core, alloc: mem::Alloc) -> Array[os::Lifecycle, 2] fails Failure uses wait {
    var states = Array[os::Lifecycle, 2].filled(os::Lifecycle.Stopped)
    states[0] = try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    if try await add(port, amount: 3, alloc) != 3 {
        fail Failure.Control(os::ControlError.Denied)
    }
    states[1] = try await core.control.lifecycle(named("tally"), alloc)
    return states
} woken

test lazy_instances_start_at_their_first_call for run {
    let world = testing::world()
    let counts = Counts.of(world.alloc)
    let states = try await run(one_tally(world.alloc, adjust: lazy), components: Tallies(), journal: counts, reservations: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[os::Lifecycle, 2] fails Failure uses wait {
        return try await woken(core, alloc: world.alloc)
    })
    let started = counts.started.contents().load()
    let Some(seen) = states else {
        expect false
        return
    }
    expect seen[0] == os::Lifecycle.Hibernated and seen[1] == os::Lifecycle.Running
    expect started == 1
} lazy_instances_start_at_their_first_call

fn asleep(port: os::Port[Counter], alloc: mem::Alloc) -> bool fails os::PortError[Never] uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Counter].asleep(mut call)
    return try await port.call(take call, reply, alloc)
} asleep

/// Has the tally suspended after 20 ms without a message, calls it, waits until it is suspended, then calls it again: whether it was suspended, whether it was still asleep at that call, and whether it was suspended after it.
fn slept(core: Core, alloc: mem::Alloc) -> Array[bool, 3] fails Failure uses wait {
    discard try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    try await core.control.suspend_after(named("tally"), ms: Some(20), alloc)
    discard try await add(port, amount: 1, alloc)
    var seen = Array[bool, 3].filled(false)
    seen[0] = try await core.control.suspended(named("tally"), seen: false, alloc)
    seen[1] = try await asleep(port, alloc)
    seen[2] = try await core.control.suspended(named("tally"), seen: true, alloc)
    return seen
} slept

test idle_instances_suspend_until_their_next_message for idle {
    let world = testing::world()
    let counts = Counts.of(world.alloc)
    let seen = try await run(one_tally(world.alloc, adjust: unchanged), components: Tallies(), journal: counts, reservations: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[bool, 3] fails Failure uses wait {
        return try await slept(core, alloc: world.alloc)
    })
    let Some(states) = seen else {
        expect false
        return
    }
    expect states[0] and not states[1] and not states[2]
} idle_instances_suspend_until_their_next_message

protocol Probed {
    pub fn ping() limits recorded
} Probed

/// A client of the tally, whose Env holds a port to it.
struct ClientEnv {
    counter: os::Port[Counter]
    alloc: mem::Alloc
} ClientEnv

impl ClientEnv: nanos::Environment

struct Client derives Encode {
} Client

impl Client: sys::Component[ClientEnv, Probed]

/// The tally and a client, both components of these tests.
struct Pair derives Copy {
} Pair

impl Pair: Components

fn ClientEnv.build(take world: nanos::World) -> ClientEnv fails nanos::CapError {
    let handle = try nanos::Cap[os::PortHandle].get(world.caps, key: "counter")
    let Some(port) = os::Port[Counter].of(handle) else {
        fail nanos::CapError.Missing
    }
    return ClientEnv(counter: port, alloc: world.alloc)
} ClientEnv.build

fn Client.start(mut env: ClientEnv) -> Client = Client()

/// Notes 1 on the tally from a keyed task.
fn Client.ping(mut self, mut env: ClientEnv, mut cx: sys::Cx[Probed]) {
    let tally = env.counter
    let alloc = env.alloc
    mut cx.spawn(key: 1, run: fn(out: sys::Outbox[Probed]) fails task::Cancelled uses wait limits stack 16_384 {
        discard attempt await note(tally, amount: 1, alloc)
    })
} Client.ping

fn Pair.protocols(self, component: Str) -> Option[os::Protocols] {
    if component == "runner::Client" {
        return Some(os::Protocols(own: sys::Wire[Probed].hash(), serves: None))
    }
    return Tallies().protocols(component)
} Pair.protocols

fn Pair.configured(self, component: Str) -> bool = false

fn Pair.forkable(self, component: Str) -> bool = component == "runner::Tally"

fn Pair.schema(self, component: Str, alloc: mem::Alloc) -> Option[sys::ProtocolSchema] {
    if component == "runner::Client" {
        return Some(sys::Wire[Probed].schema(alloc))
    }
    return Tallies().schema(component, alloc)
} Pair.schema

fn Pair.serve(self, component: Str, take world: nanos::World, take serving: Serving) -> Ended fails task::Cancelled uses wait {
    if component == "runner::Client" {
        return try await Served[Client, ClientEnv, Probed].run(take world, take serving)
    }
    return try await Tallies().serve(component, take world, take serving)
} Pair.serve

/// A tally, and a client wired to it acting for `principal`, under the root grant held by `system`.
fn tally_and_client(take principal: ident::Principal, alloc: mem::Alloc) -> Known {
    var known = one_tally(alloc, adjust: unchanged)
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    var client = os::InstanceSpec.of(take principal, bundle: ident::HashValue(bytes: bundle), component: "runner::Client", alloc)
    discard mut client.wiring.insert(text::String.of("counter", alloc), value: os::Wire.to(named("tally")))
    discard mut known.specs.insert(named("client"), value: take client)
    var rights = mem::Set[os::Right].empty(alloc)
    discard mut rights.insert(os::Right.Read)
    discard mut known.grants.insert(0, value: os::Grant(holder: system(), object: os::Object.Machine, rights: take rights, caveats: os::Caveats.none(), parent: None, granted_by: ident::CommitId(number: 1)))
    return known
} tally_and_client

test wires_need_a_covering_grant for Directory.world {
    let world = testing::world()
    let alloc = world.alloc
    let covered = try await run(tally_and_client(system(), alloc), components: Pair(), journal: Counts.of(alloc), reservations: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> os::Lifecycle fails os::ControlError uses wait {
        let started = try await core.control.start(named("client"), alloc)
        let Some(minted) = try await core.port(named("client"), credit: os::Credit(messages: 1, calls: 1)) else {
            return started
        }
        let Some(client) = os::Port[Probed].of(minted.handle()) else {
            take minted.close()
            return started
        }
        var call = sys::Encoded.empty(alloc)
        sys::Wire[Probed].ping(mut call)
        discard attempt await client.post(take call)
        take minted.close()
        return started
    })
    let stranger = ident::Principal(text: text::Fixed[64].of("agent.stranger"))
    let uncovered = try await run(tally_and_client(take stranger, alloc), components: Pair(), journal: Counts.of(alloc), reservations: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> os::Lifecycle fails os::ControlError uses wait {
        return try await core.control.start(named("client"), alloc)
    })
    expect covered == Some(os::Lifecycle.Running)
    expect uncovered == Some(os::Lifecycle.Failed)
} wires_need_a_covering_grant

fn reserved(mut spec: os::InstanceSpec) {
    spec.budget.reserved = true
} reserved

/// Starts the reserved tally and calls it, giving its lifecycle, or the lifecycle its start gave when it does not run.
fn reserved_call(core: Core, alloc: mem::Alloc) -> os::Lifecycle fails Failure uses wait {
    let started = try await core.control.start(named("tally"), alloc)
    if started != os::Lifecycle.Running {
        return started
    }
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 1, calls: 1)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    if try await add(port, amount: 4, alloc) != 4 {
        fail Failure.Control(os::ControlError.Denied)
    }
    return started
} reserved_call

test reserved_instances_need_a_region for Shared.cell {
    let world = testing::world()
    let alloc = world.alloc
    let held = try await run(one_tally(alloc, adjust: reserved), components: Tallies(), journal: Counts.of(alloc), reservations: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> os::Lifecycle fails Failure uses wait {
        return try await reserved_call(core, alloc)
    })
    let missing = try await run(one_tally(alloc, adjust: reserved), components: Tallies(), journal: Counts.of(alloc), reservations: Spare(alloc: alloc, holds: false), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> os::Lifecycle fails Failure uses wait {
        return try await reserved_call(core, alloc)
    })
    expect held == Some(os::Lifecycle.Running)
    expect missing == Some(os::Lifecycle.Failed)
} reserved_instances_need_a_region

/// What the client's lifecycle was at each step of `revoke_root`, and whether revoking `g0` took `g1` with it, once.
struct Outcomes derives Copy, Eq {
    started: os::Lifecycle
    descendants: bool
    kept: os::Lifecycle
    restarted: os::Lifecycle
} Outcomes

/// Starts the client, revokes the root grant its wire derives from twice, then restarts it.
fn revoke_root(core: Core, alloc: mem::Alloc) -> Outcomes fails os::ControlError uses wait {
    let started = try await core.control.start(named("client"), alloc)
    let revoked = try await core.revoke(0)
    let again = try await core.revoke(0)
    let kept = try await core.control.lifecycle(named("client"), alloc)
    let later = try await core.control.restart(named("client"), alloc)
    let descendants = revoked.len() == 2 and revoked.contains(0) and revoked.contains(1) and again.len() == 0
    return Outcomes(started: started, descendants: descendants, kept: kept, restarted: later)
} revoke_root

test revoking_a_grant_takes_its_descendants_and_fails_later_starts for Core.revoke {
    let world = testing::world()
    let alloc = world.alloc
    var known = tally_and_client(system(), alloc)
    discard mut known.grants.insert(1, value: os::Grant(holder: system(), object: os::Object.Instance(prefix: named("tally")), rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: Some(0), granted_by: ident::CommitId(number: 2)))
    let counts = Counts.of(alloc)
    let seen = try await run(take known, components: Pair(), journal: counts, reservations: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Outcomes fails os::ControlError uses wait {
        return try await revoke_root(core, alloc)
    })
    let revoked = counts.revoked.contents().load()
    expect seen == Some(Outcomes(started: os::Lifecycle.Running, descendants: true, kept: os::Lifecycle.Running, restarted: os::Lifecycle.Failed))
    expect revoked == 2
} revoking_a_grant_takes_its_descendants_and_fails_later_starts

test revoked_root_entries_make_their_copies_stale for Minted.revoke {
    let alloc = testing::world().alloc
    let task::Channel(sender: orders, receiver: ordered) = task::Channel[os::Order].bounded(1, alloc)
    let task::Channel(sender: intake, receiver: calls) = task::Channel[os::Call].bounded(1, alloc)
    var minted = Minted.none(alloc)
    mut minted.controls.push(GrantedControl(grant: 1, control: os::MintedControl.of(orders, grant: None, prefix: None, alloc)))
    mut minted.controls.push(GrantedControl(grant: 2, control: os::MintedControl.of(orders, grant: None, prefix: None, alloc)))
    mut minted.ports.push(WiredPort(field: text::String.of("counter", alloc), grant: 1, port: os::MintedPort.of(intake, gate: os::Gate.of(alloc), protocols: os::Protocols(own: sys::Wire[Counter].hash(), serves: None), operations: None, credit: os::Credit(messages: 1, calls: 1), alloc)))
    let control = minted.controls[0].control.mint(os::ControlRights(read: true, lifecycle: false, spawn: false, reserved: 0))
    let port = os::Port[Counter].of(minted.ports[0].port.handle())
    var grants = mem::Set[u64].empty(alloc)
    discard mut grants.insert(1)
    mut minted.revoke(grants)
    let kept = minted.controls.len() == 1 and minted.controls[0].grant == 2 and minted.ports.len() == 0
    take minted.close()
    let read = attempt await control.lifecycle(named("tally"), alloc)
    let Some(tally) = port else {
        expect false
        return
    }
    let posted = attempt await note(tally, amount: 1, alloc)
    expect kept
    expect match read {
        Err(os::ControlError.Revoked) => true
        else => false
    }
    expect match posted {
        Err(os::PortError.Revoked) => true
        else => false
    }
    discard ordered
    discard calls
} revoked_root_entries_make_their_copies_stale

/// A grant held by `holder` reaching every instance, under `parent`, that expires `seconds` after the tests' wall time.
fn expiring(take holder: ident::Principal, parent: u64, seconds: i64, alloc: mem::Alloc) -> os::Grant {
    var caveats = os::Caveats.none()
    caveats.expires_utc_ns = Some(NOON_NS + seconds * 1_000_000_000)
    return os::Grant(holder: take holder, object: os::Object.Machine, rights: mem::Set.empty(alloc), caveats: take caveats, parent: Some(parent), granted_by: ident::CommitId(number: 2))
} expiring

fn child() -> ident::Principal {
    return ident::Principal(text: text::Fixed[64].of("agent.child"))
} child

/// Starts the client, whose wire derives from a grant expiring in 10 s, waits 12 s, then restarts it, giving each lifecycle.
fn outlived(core: Core, clock: sys::Clock, alloc: mem::Alloc) -> Array[os::Lifecycle, 2] fails os::ControlError uses wait {
    var states = Array[os::Lifecycle, 2].filled(os::Lifecycle.Stopped)
    states[0] = try await core.control.start(named("client"), alloc)
    try await clock.sleep(12_000)
    states[1] = try await core.control.restart(named("client"), alloc)
    return states
} outlived

