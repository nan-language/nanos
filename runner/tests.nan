        return try await exhausted(core, alloc: world.alloc)
    })
    let failed = counts.failed.contents().load()
    let Some(seen) = states else {
        expect false
        return
    }
    expect seen[0] == os::Lifecycle.Failed and seen[1] == os::Lifecycle.Running
    expect failed == 1
} intensity_sends_instances_to_failed

/// Starts the tally, waits for its lifecycle to differ from `starting`, then from `running` while a task stops it.
fn followed(core: Core, exec: task::Executor, alloc: mem::Alloc) -> Array[os::Lifecycle, 2] fails Failure uses wait {
    var states = Array[os::Lifecycle, 2].filled(os::Lifecycle.Starting)
    discard try await core.control.start(named("tally"), alloc)
    states[0] = try await core.control.changed(named("tally"), seen: Some(os::Lifecycle.Starting), alloc)
    let control = core.control
    var changed: Result[os::Lifecycle, os::ControlError] = Err(os::ControlError.Missing)
    try await task::scope(exec, body: fn[mut changed](s: task::Scope) fails task::Cancelled uses wait {
        discard s.spawn(fn() fails task::Cancelled uses wait limits stack 8_192 {
            discard attempt await control.stop(named("tally"), alloc)
        })
        changed = match first attempt await control.changed(named("tally"), seen: Some(os::Lifecycle.Running), alloc) {
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            other => other
        }
    })
    states[1] = match changed {
        Ok(lifecycle) => lifecycle
        Err(failure) => fail Failure.Control(take failure)
    }
    return states
} followed

test changes_are_answered_once_the_lifecycle_differs for run {
