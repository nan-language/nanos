fn asleep(port: os::Port[Counter], alloc: mem::Alloc) -> bool fails os::PortError[Never] uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Counter].asleep(mut call)
    return try await port.call(take call, reply, alloc)
} asleep

/// Has the tally suspended after 20 ms without a message, calls it, waits until it is suspended, then calls it again: whether it was suspended, whether it was still asleep at that call, and whether it was suspended after it.
fn slept(core: Core, alloc: mem::Alloc) -> Array[bool, 3] fails Failure uses wait {
    discard try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    try await core.control.suspend_after(named("tally"), ms: Some(20), alloc)
    discard try await add(port, amount: 1, alloc)
    var seen = Array[bool, 3].filled(false)
    seen[0] = try await core.control.suspended(named("tally"), seen: false, alloc)
    seen[1] = try await asleep(port, alloc)
    seen[2] = try await core.control.suspended(named("tally"), seen: true, alloc)
    return seen
} slept

test idle_instances_suspend_until_their_next_message for idle {
    let world = testing::world()
    let counts = Counts.of(world.alloc)
    let seen = try await run(one_tally(world.alloc, adjust: unchanged), components: Tallies(), journal: counts, machine: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[bool, 3] fails Failure uses wait {
        return try await slept(core, alloc: world.alloc)
    })
    let Some(states) = seen else {
        expect false
        return
    }
    expect states[0] and not states[1] and not states[2]
} idle_instances_suspend_until_their_next_message

protocol Probed {
    pub fn ping() limits recorded
} Probed

/// A client of the tally, whose Env holds a port to it.
struct ClientEnv {
    counter: os::Port[Counter]
    alloc: mem::Alloc
} ClientEnv

impl ClientEnv: nanos::Environment

struct Client derives Encode {
} Client

impl Client: sys::Component[ClientEnv, Probed]

/// The tally and a client, both components of these tests.
struct Pair derives Copy {
} Pair

impl Pair: Components

fn ClientEnv.build(take world: nanos::World) -> ClientEnv fails nanos::CapError {
    let handle = try nanos::Cap[os::PortHandle].get(world.caps, key: "counter")
    let Some(port) = os::Port[Counter].of(handle) else {
        fail nanos::CapError.Missing
    }
    return ClientEnv(counter: port, alloc: world.alloc)
} ClientEnv.build

fn Client.start(mut env: ClientEnv) -> Client = Client()

/// Notes 1 on the tally from a keyed task.
fn Client.ping(mut self, mut env: ClientEnv, mut cx: sys::Cx[Probed]) {
    let tally = env.counter
    let alloc = env.alloc
    mut cx.spawn(key: 1, run: fn(out: sys::Outbox[Probed]) fails task::Cancelled uses wait limits stack 16_384 {
        discard attempt await note(tally, amount: 1, alloc)
    })
} Client.ping

fn Pair.protocols(self, component: Str) -> Option[os::Protocols] {
    if component == "runner::Client" {
        return Some(os::Protocols(own: sys::Wire[Probed].hash(), serves: None))
    }
    return Tallies().protocols(component)
} Pair.protocols

fn Pair.configured(self, component: Str) -> bool = false

fn Pair.forkable(self, component: Str) -> bool = component == "runner::Tally"

fn Pair.schema(self, component: Str, alloc: mem::Alloc) -> Option[sys::ProtocolSchema] {
    if component == "runner::Client" {
        return Some(sys::Wire[Probed].schema(alloc))
    }
    return Tallies().schema(component, alloc)
} Pair.schema

fn Pair.serve(self, component: Str, take world: nanos::World, take serving: Serving) -> Ended fails task::Cancelled uses wait {
    if component == "runner::Client" {
        return try await Served[Client, ClientEnv, Probed].run(take world, take serving)
    }
    return try await Tallies().serve(component, take world, take serving)
} Pair.serve

/// A tally, and a client wired to it acting for `principal`, under the root grant held by `system`.
fn tally_and_client(take principal: ident::Principal, alloc: mem::Alloc) -> Known {
    var known = one_tally(alloc, adjust: unchanged)
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    var client = os::InstanceSpec.of(take principal, bundle: ident::HashValue(bytes: bundle), component: "runner::Client", alloc)
    discard mut client.wiring.insert(text::String.of("counter", alloc), value: os::Wire.to(named("tally")))
    discard mut known.specs.insert(named("client"), value: take client)
    var rights = mem::Set[os::Right].empty(alloc)
    discard mut rights.insert(os::Right.Read)
    discard mut known.grants.insert(0, value: os::Grant(holder: system(), object: os::Object.Machine, rights: take rights, caveats: os::Caveats.none(), parent: None, granted_by: ident::CommitId(number: 1)))
    return known
} tally_and_client

test wires_need_a_covering_grant for Directory.world {
    let world = testing::world()
    let alloc = world.alloc
    let covered = try await run(tally_and_client(system(), alloc), components: Pair(), journal: Counts.of(alloc), machine: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> os::Lifecycle fails os::ControlError uses wait {
        let started = try await core.control.start(named("client"), alloc)
        let Some(minted) = try await core.port(named("client"), credit: os::Credit(messages: 1, calls: 1)) else {
            return started
        }
        let Some(client) = os::Port[Probed].of(minted.handle()) else {
            take minted.close()
            return started
        }
        var call = sys::Encoded.empty(alloc)
        sys::Wire[Probed].ping(mut call)
        discard attempt await client.post(take call)
        take minted.close()
        return started
    })
    let stranger = ident::Principal(text: text::Fixed[64].of("agent.stranger"))
    let uncovered = try await run(tally_and_client(take stranger, alloc), components: Pair(), journal: Counts.of(alloc), machine: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> os::Lifecycle fails os::ControlError uses wait {
        return try await core.control.start(named("client"), alloc)
    })
    expect covered == Some(os::Lifecycle.Running)
    expect uncovered == Some(os::Lifecycle.Failed)
} wires_need_a_covering_grant

fn reserved(mut spec: os::InstanceSpec) {
    spec.budget.reserved = true
} reserved

/// Starts the reserved tally and calls it, giving its lifecycle, or the lifecycle its start gave when it does not run.
fn reserved_call(core: Core, alloc: mem::Alloc) -> os::Lifecycle fails Failure uses wait {
    let started = try await core.control.start(named("tally"), alloc)
    if started != os::Lifecycle.Running {
        return started
    }
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 1, calls: 1)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    if try await add(port, amount: 4, alloc) != 4 {
        fail Failure.Control(os::ControlError.Denied)
    }
    return started
} reserved_call

test reserved_instances_need_a_region for Shared.cell {
    let world = testing::world()
    let alloc = world.alloc
    let held = try await run(one_tally(alloc, adjust: reserved), components: Tallies(), journal: Counts.of(alloc), machine: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> os::Lifecycle fails Failure uses wait {
        return try await reserved_call(core, alloc)
    })
    let missing = try await run(one_tally(alloc, adjust: reserved), components: Tallies(), journal: Counts.of(alloc), machine: Spare(alloc: alloc, holds: false), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> os::Lifecycle fails Failure uses wait {
        return try await reserved_call(core, alloc)
    })
    expect held == Some(os::Lifecycle.Running)
    expect missing == Some(os::Lifecycle.Failed)
} reserved_instances_need_a_region

/// What the client's lifecycle was at each step of `revoke_root`, and whether revoking `g0` took `g1` with it, once.
struct Outcomes derives Copy, Eq {
    started: os::Lifecycle
    descendants: bool
    kept: os::Lifecycle
    restarted: os::Lifecycle
} Outcomes

/// Starts the client, revokes the root grant its wire derives from twice, then restarts it.
fn revoke_root(core: Core, alloc: mem::Alloc) -> Outcomes fails os::ControlError uses wait {
    let started = try await core.control.start(named("client"), alloc)
    let revoked = try await core.revoke(0)
    let again = try await core.revoke(0)
    let kept = try await core.control.lifecycle(named("client"), alloc)
    let later = try await core.control.restart(named("client"), alloc)
    let descendants = revoked.len() == 2 and revoked.contains(0) and revoked.contains(1) and again.len() == 0
    return Outcomes(started: started, descendants: descendants, kept: kept, restarted: later)
} revoke_root

test revoking_a_grant_takes_its_descendants_and_fails_later_starts for Core.revoke {
    let world = testing::world()
    let alloc = world.alloc
    var known = tally_and_client(system(), alloc)
    discard mut known.grants.insert(1, value: os::Grant(holder: system(), object: os::Object.Instance(prefix: named("tally")), rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: Some(0), granted_by: ident::CommitId(number: 2)))
    let counts = Counts.of(alloc)
    let seen = try await run(take known, components: Pair(), journal: counts, machine: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Outcomes fails os::ControlError uses wait {
        return try await revoke_root(core, alloc)
    })
    let revoked = counts.revoked.contents().load()
    expect seen == Some(Outcomes(started: os::Lifecycle.Running, descendants: true, kept: os::Lifecycle.Running, restarted: os::Lifecycle.Failed))
    expect revoked == 2
} revoking_a_grant_takes_its_descendants_and_fails_later_starts

test revoked_root_entries_make_their_copies_stale for Minted.revoke {
    let alloc = testing::world().alloc
    let task::Channel(sender: orders, receiver: ordered) = task::Channel[os::Order].bounded(1, alloc)
    let task::Channel(sender: intake, receiver: calls) = task::Channel[os::Call].bounded(1, alloc)
    var minted = Minted.none(alloc)
    mut minted.controls.push(GrantedControl(grant: 1, control: os::MintedControl.of(orders, grant: None, prefix: None, alloc)))
    mut minted.controls.push(GrantedControl(grant: 2, control: os::MintedControl.of(orders, grant: None, prefix: None, alloc)))
    mut minted.ports.push(WiredPort(field: text::String.of("counter", alloc), grant: 1, port: os::MintedPort.of(intake, gate: os::Gate.of(alloc), protocols: os::Protocols(own: sys::Wire[Counter].hash(), serves: None), operations: None, credit: os::Credit(messages: 1, calls: 1), alloc)))
    let control = minted.controls[0].control.mint(os::ControlRights(read: true, lifecycle: false, spawn: false, reserved: 0))
    let port = os::Port[Counter].of(minted.ports[0].port.handle())
    var grants = mem::Set[u64].empty(alloc)
    discard mut grants.insert(1)
    mut minted.revoke(grants)
    let kept = minted.controls.len() == 1 and minted.controls[0].grant == 2 and minted.ports.len() == 0
    take minted.close()
    let read = attempt await control.lifecycle(named("tally"), alloc)
    let Some(tally) = port else {
        expect false
        return
    }
    let posted = attempt await note(tally, amount: 1, alloc)
    expect kept
    expect match read {
        Err(os::ControlError.Revoked) => true
        else => false
    }
    expect match posted {
        Err(os::PortError.Revoked) => true
        else => false
    }
    discard ordered
    discard calls
} revoked_root_entries_make_their_copies_stale

/// A grant held by `holder` reaching every instance, under `parent`, that expires `seconds` after the tests' wall time.
fn expiring(take holder: ident::Principal, parent: u64, seconds: i64, alloc: mem::Alloc) -> os::Grant {
    var caveats = os::Caveats.none()
    caveats.expires_utc_ns = Some(NOON_NS + seconds * 1_000_000_000)
    return os::Grant(holder: take holder, object: os::Object.Machine, rights: mem::Set.empty(alloc), caveats: take caveats, parent: Some(parent), granted_by: ident::CommitId(number: 2))
} expiring

fn child() -> ident::Principal {
    return ident::Principal(text: text::Fixed[64].of("agent.child"))
} child

/// Starts the client, whose wire derives from a grant expiring in 10 s, waits 12 s, then restarts it, giving each lifecycle.
fn outlived(core: Core, clock: sys::Clock, alloc: mem::Alloc) -> Array[os::Lifecycle, 2] fails os::ControlError uses wait {
    var states = Array[os::Lifecycle, 2].filled(os::Lifecycle.Stopped)
    states[0] = try await core.control.start(named("client"), alloc)
    try await clock.sleep(12_000)
    states[1] = try await core.control.restart(named("client"), alloc)
    return states
} outlived

test grants_expire_at_start_and_once_their_expiry_passes for expire {
    let world = testing::world()
    let alloc = world.alloc
    var known = tally_and_client(child(), alloc)
    discard mut known.grants.insert(1, value: expiring(child(), parent: 0, seconds: 10, alloc))
    discard mut known.grants.insert(2, value: expiring(system(), parent: 0, seconds: -1, alloc))
    discard mut known.grants.insert(3, value: os::Grant(holder: system(), object: os::Object.Clock, rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: Some(2), granted_by: ident::CommitId(number: 3)))
    let counts = Counts.of(alloc)
    let seen = try await run(take known, components: Pair(), journal: counts, machine: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[os::Lifecycle, 2] fails os::ControlError uses wait {
        return try await outlived(core, clock: world.clock, alloc)
    })
    let revoked = counts.revoked.contents().load()
    let Some(states) = seen else {
        expect false
        return
    }
    expect states[0] == os::Lifecycle.Running and states[1] == os::Lifecycle.Failed
    expect revoked == 3
} grants_expire_at_start_and_once_their_expiry_passes

/// What a created tally gave: its first total, the total its postponed request was answered with, whether its port was revoked once it was deleted, and whether a start after the deletion found it missing.
struct Made derives Copy, Eq {
    initial: u64
    postponed: u64
    revoked: bool
    missing: bool
} Made

fn wait_later(port: os::Port[Counter], alloc: mem::Alloc) -> u64 fails os::PortError[Never] uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Counter].later(mut call)
    return try await port.call(take call, reply, alloc)
} wait_later

fn settle_all(port: os::Port[Counter], alloc: mem::Alloc) -> u32 fails os::PortError[Never] uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Counter].settle(mut call)
    return try await port.call(take call, reply, alloc)
} settle_all

/// Creates a tally through the core's `Control`, calls it through a port the order mints, has a later handler answer a postponed request, then deletes it.
fn made(core: Core, exec: task::Executor, alloc: mem::Alloc) -> Made fails Failure uses wait {
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    let spec = os::InstanceSpec.of(principal: system(), bundle: ident::HashValue(bytes: bundle), component: "runner::Tally", alloc)
    try await core.control.create(named("made"), take spec, grants: mem::Map.empty(alloc), alloc)
    discard try await core.control.start(named("made"), alloc)
    let handle = try await core.control.port(named("made"), credit: os::Credit(messages: 2, calls: 2), alloc)
    let Some(port) = os::Port[Counter].of(handle) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    let initial = try await add(port, amount: 6, alloc)
    var postponed: u64 = 0
    try await task::scope(exec, body: fn[mut postponed](s: task::Scope) fails Failure uses wait {
        let waited = s.spawn(fn() -> u64 fails os::PortError[Never] uses wait limits stack 16_384 {
            return try await wait_later(port, alloc)
        })
        while try await settle_all(port, alloc) == 0 {
        }
        postponed = try await take waited.join()
    })
    try await core.control.delete(named("made"), alloc)
    let after = attempt await add(port, amount: 1, alloc)
    let again = attempt await core.control.start(named("made"), alloc)
    let revoked = match after {
        Err(os::PortError.Revoked) => true
        else => false
    }
    let missing = match again {
        Err(os::ControlError.Missing) => true
        else => false
    }
    return Made(initial: initial, postponed: postponed, revoked: revoked, missing: missing)
} made

test created_instances_answer_postponed_requests_until_deleted for Directory.create {
    let world = testing::world()
    let alloc = world.alloc
    let seen = try await run(Known(specs: mem::Map.empty(alloc), grants: mem::Map.empty(alloc)), components: Tallies(), journal: Counts.of(alloc), machine: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Made fails Failure uses wait {
        return try await made(core, exec: world.exec, alloc)
    })
    expect seen == Some(Made(initial: 6, postponed: 6, revoked: true, missing: true))
} created_instances_answer_postponed_requests_until_deleted

/// A directory holding the tally's endpoint, the root grant and a `Device` grant held by `inst.driver`, and the spec of `driver`, claiming that device and wired to the holder of the entropy role.
fn claiming(alloc: mem::Alloc) -> Directory {
    var listed = Directory(grants: mem::Map.empty(alloc), endpoints: mem::Map.empty(alloc), roles: mem::Map.empty(alloc))
    let task::Channel(sender: intake, receiver: _) = task::Channel[os::Call].bounded(1, alloc)
    discard mut listed.endpoints.insert(named("tally"), value: Endpoint(intake: take intake, gate: os::Gate.of(alloc), protocols: os::Protocols(own: sys::Wire[Counter].hash(), serves: None)))
    discard mut listed.grants.insert(0, value: os::Grant(holder: system(), object: os::Object.Machine, rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: None, granted_by: ident::CommitId(number: 1)))
    let holder = ident::Principal(text: text::Fixed[64].of("inst.driver"))
    discard mut listed.grants.insert(5, value: os::Grant(holder: take holder, object: os::Object.Device(path: text::String.of("pci/0000.00.03.0", alloc)), rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: Some(0), granted_by: ident::CommitId(number: 1)))
    return listed
} claiming

test worlds_draw_randomness_only_under_a_random_grant for Directory.world {
    let world = testing::world()
    let alloc = world.alloc
    var listed = Directory(grants: mem::Map.empty(alloc), endpoints: mem::Map.empty(alloc), roles: mem::Map.empty(alloc))
    discard mut listed.grants.insert(0, value: os::Grant(holder: ident::Principal(text: text::Fixed[64].of("inst.drawer")), object: os::Object.Random, rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: None, granted_by: ident::CommitId(number: 1)))
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    let bare = os::InstanceSpec.of(principal: system(), bundle: ident::HashValue(bytes: bundle), component: "runner::Tally", alloc)
    var granted = os::InstanceSpec.of(principal: system(), bundle: ident::HashValue(bytes: bundle), component: "runner::Tally", alloc)
    discard mut granted.grants.insert(text::String.of("random", alloc), value: 0)
    let task::Channel(sender: orders, receiver: _) = task::Channel[os::Order].bounded(1, alloc)
    let Ok(withheld) = attempt Withheld.of(world.clock, alloc) else {
        expect false
        return
    }
    let request = Request(moniker: named("drawer"), cell: alloc, exec: world.exec, clock: world.clock, random: world.random, withheld: withheld, orders: take orders, logs: unlogged(alloc), forking: None, alloc: alloc)
    var minted = Minted.none(alloc)
    let without = listed.world(bare, mut minted, request)
    let with = listed.world(granted, mut minted, request)
    take minted.close()
    let Some(denied) = without else {
        expect false
        return
    }
    let Some(served) = with else {
        expect false
        return
    }
    var drawn = Array[u8, 8].filled(0)
    let refused = attempt denied.random.fill(mut drawn.view_mut())
    let filled = attempt served.random.fill(mut drawn.view_mut())
    expect refused.is_err() and filled.is_ok()
} worlds_draw_randomness_only_under_a_random_grant

test worlds_claim_devices_and_wire_roles_once_assigned for Directory.world {
    let world = testing::world()
    let alloc = world.alloc
    var listed = claiming(alloc)
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    var spec = os::InstanceSpec.of(principal: system(), bundle: ident::HashValue(bytes: bundle), component: "runner::Tally", alloc)
    discard mut spec.grants.insert(text::String.of("device", alloc), value: 5)
    discard mut spec.wiring.insert(text::String.of("source", alloc), value: os::Wire(target: os::Target.Role(os::Role.Entropy), operations: None, credit: os::Credit(messages: 1, calls: 1)))
    let task::Channel(sender: orders, receiver: _) = task::Channel[os::Order].bounded(1, alloc)
    let Ok(withheld) = attempt Withheld.of(world.clock, alloc) else {
        expect false
        return
    }
    let request = Request(moniker: named("driver"), cell: alloc, exec: world.exec, clock: world.clock, random: world.random, withheld: withheld, orders: take orders, logs: unlogged(alloc), forking: None, alloc: alloc)
    var minted = Minted.none(alloc)
    let unassigned = listed.world(spec, mut minted, request)
    expect unassigned.is_none()
    discard mut listed.assign(os::Role.Entropy, moniker: named("tally"))
    let Some(built) = listed.world(spec, mut minted, request) else {
        expect false
        take minted.close()
        return
    }
    let source = attempt nanos::Cap[os::PortHandle].get(built.caps, key: "source")
    let path = match attempt nanos::Cap[os::Device].get(built.caps, key: "device") {
        Ok(device) => device.path(alloc)
        Err(_) => None
    }
    take minted.close()
    expect source.is_ok()
    let Some(named_path) = path else {
        expect false
        return
    }
    expect named_path.as_str() == "pci/0000.00.03.0"
} worlds_claim_devices_and_wire_roles_once_assigned

fn keeps_checkpoints(mut spec: os::InstanceSpec) {
    spec.durability.class = os::DurabilityClass.Checkpointed
} keeps_checkpoints

/// The outcomes of hibernating the tally before it starts and once it runs, then the total a call gives after it.
fn hibernated(core: Core, alloc: mem::Alloc) -> Array[u64, 3] fails Failure uses wait {
    let early = attempt await core.control.hibernate(named("tally"), alloc)
    discard try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    discard try await add(port, amount: 4, alloc)
    let running = attempt await core.control.hibernate(named("tally"), alloc)
    var seen = Array[u64, 3].filled(0)
    seen[0] = outcome_code(early)
    seen[1] = outcome_code(running)
    seen[2] = try await add(port, amount: 1, alloc)
    return seen
} hibernated

/// 1 for `instance.volatile`, 2 for `instance.not-running`, 3 for `running`, 4 for `hibernated`, 0 for any other outcome.
fn outcome_code(outcome: Result[os::Lifecycle, os::ControlError]) -> u64 {
    return match outcome {
        Err(os::ControlError.Volatile) => 1
        Err(os::ControlError.NotRunning) => 2
        Ok(os::Lifecycle.Running) => 3
        Ok(os::Lifecycle.Hibernated) => 4
        else => 0
    }
} outcome_code

/// A volatile tally never hibernates; a checkpointed one hibernates only running, and without a store keeping its checkpoints its hibernation ends with the tally serving on.
test hibernation_needs_a_running_instance_whose_checkpoints_are_kept for Driver.order_hibernation {
    let world = testing::world()
    let volatile = try await run(one_tally(world.alloc, adjust: unchanged), components: Tallies(), journal: Counts.of(world.alloc), machine: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[u64, 3] fails Failure uses wait {
        return try await hibernated(core, alloc: world.alloc)
    })
    let kept = try await run(one_tally(world.alloc, adjust: keeps_checkpoints), components: Tallies(), journal: Counts.of(world.alloc), machine: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[u64, 3] fails Failure uses wait {
        return try await hibernated(core, alloc: world.alloc)
    })
    var refused = Array[u64, 3].filled(1)
    refused[2] = 5
    var served = Array[u64, 3].filled(2)
    served[1] = 3
    served[2] = 5
    expect volatile == Some(refused)
    expect kept == Some(served)
} hibernation_needs_a_running_instance_whose_checkpoints_are_kept

/// A machine whose pool's pressure level the test sets, waking those waiting for it to change, which keeps the latency tolerance last set, 0 for none, and whose running CPUs draw 2 W.
struct Squeezed {
    alloc: mem::Alloc
    level: mem::Shared[core::atomic::AtomicU64]
    raised: mem::Shared[hw::Signal[Unit]]
    tolerance_ns: mem::Shared[core::atomic::AtomicU64]
} Squeezed

impl Squeezed: Machine

fn Squeezed.of(alloc: mem::Alloc) -> Squeezed {
    return Squeezed(alloc: alloc, level: mem::Shared.of(core::atomic::AtomicU64.of(0), alloc), raised: mem::Shared.of(hw::Signal[Unit].empty(), alloc), tolerance_ns: mem::Shared.of(core::atomic::AtomicU64.of(0), alloc))
} Squeezed.of

fn Squeezed.reserve(self, bytes: u64) -> Option[mem::Heap] = None

fn Squeezed.busy_mw(self) -> mem::Shared[core::atomic::AtomicU64] {
    return mem::Shared.of(core::atomic::AtomicU64.of(2_000), alloc: self.alloc)
} Squeezed.busy_mw

fn Squeezed.tolerate(self, cpu: u32, tolerance_ns: Option[u64]) {
    self.tolerance_ns.contents().store(tolerance_ns.value_or(0))
} Squeezed.tolerate

fn Squeezed.settle(self) -> u8 {
    return u8.truncate(self.level.contents().load())
} Squeezed.settle

/// Another handle on the same pool.
fn Squeezed.share(self) -> Squeezed {
    return Squeezed(alloc: self.alloc, level: self.level.share(), raised: self.raised.share(), tolerance_ns: self.tolerance_ns.share())
} Squeezed.share

fn Squeezed.changed(self, seen: u8) -> u8 fails task::Cancelled uses wait {
    loop {
        let level = self.settle()
        if level != seen {
            return level
        }
        try await self.raised.contents().wait()
    }
} Squeezed.changed

/// Sets the level to `level`.
fn Squeezed.squeeze(self, level: u8) {
    self.level.contents().store(u64.widen(level))
    hw::without_irqs(fn(t: hw::IrqsDisabled) limits notrap {
        self.raised.contents().post(t, value: Unit)
    })
} Squeezed.squeeze

fn pressed_of(port: os::Port[Counter], alloc: mem::Alloc) -> u64 fails os::PortError[Never] uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Counter].pressed(mut call)
    return try await port.call(take call, reply, alloc)
} pressed_of

/// Starts the tally, raises the pool's level to 2, then to 4, reading the levels the tally was told of after each, and starts the tally again once stopped.
fn squeezed(core: Core, pool: Squeezed, clock: sys::Clock, alloc: mem::Alloc) -> Array[u64, 3] fails Failure uses wait {
    discard try await core.control.start(named("tally"), alloc)
    let Some(minted) = try await core.port(named("tally"), credit: os::Credit(messages: 2, calls: 2)) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    defer take minted.close()
    let Some(port) = os::Port[Counter].of(minted.handle()) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    var seen = Array[u64, 3].filled(0)
    pool.squeeze(2)
    try await clock.sleep(10)
    seen[0] = try await pressed_of(port, alloc)
    pool.squeeze(4)
    try await clock.sleep(10)
    seen[1] = try await pressed_of(port, alloc)
    discard try await core.control.stop(named("tally"), alloc)
    seen[2] = match try await core.control.start(named("tally"), alloc) {
        os::Lifecycle.Failed => 1
        else => 0
    }
    return seen
} squeezed

/// Each rise of the pool's level calls the instances' `pressure` with each level risen through, and at the top level a start fails.
test pressure_reaches_instances_and_refuses_starts_at_its_top_level for Shared.relieve {
    let world = testing::world()
    let pool = Squeezed.of(world.alloc)
    let seen = try await run(one_tally(world.alloc, adjust: unchanged), components: Tallies(), journal: Counts.of(world.alloc), machine: pool.share(), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[u64, 3] fails Failure uses wait {
        return try await squeezed(core, pool, clock: world.clock, alloc: world.alloc)
    })
    var expected = Array[u64, 3].filled(12)
    expected[1] = 1_234
    expected[2] = 1
    expect seen == Some(expected)
} pressure_reaches_instances_and_refuses_starts_at_its_top_level

fn half_a_cpu(mut spec: os::InstanceSpec) {
    spec.share = os::Share(class: os::CpuClass.Latency, weight: 100, runtime_us: 500, period_us: 1_000, energy_mj_per_h: 0)
} half_a_cpu

fn most_of_a_cpu(mut spec: os::InstanceSpec) {
    spec.share = os::Share(class: os::CpuClass.Latency, weight: 100, runtime_us: 900, period_us: 1_000, energy_mj_per_h: 0)
} most_of_a_cpu

/// The lifecycles of the tally once started, once started again after a stop.
fn started_twice(core: Core, alloc: mem::Alloc) -> Array[os::Lifecycle, 2] fails Failure uses wait {
    var seen = Array[os::Lifecycle, 2].filled(os::Lifecycle.Stopped)
    seen[0] = try await core.control.start(named("tally"), alloc)
    discard try await core.control.stop(named("tally"), alloc)
    seen[1] = try await core.control.start(named("tally"), alloc)
    return seen
} started_twice

/// On the tests' single CPU, a reservation of half of it starts again once its instance stopped, the CPU tolerating the 500 µs left of each period while it runs and any latency once it stopped, and one of 90% fails its start.
test reservations_beyond_80_percent_of_a_cpu_fail_starts for Shared.resources {
    let world = testing::world()
    let machine = Squeezed.of(world.alloc)
    let tolerance = machine.tolerance_ns.share()
    let fitting = try await run(one_tally(world.alloc, adjust: half_a_cpu), components: Tallies(), journal: Counts.of(world.alloc), machine: machine.share(), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[os::Lifecycle, 2] fails Failure uses wait {
        let seen = try await started_twice(core, alloc: world.alloc)
        let held = tolerance.contents().load()
        discard try await core.control.stop(named("tally"), alloc: world.alloc)
        let lifted = tolerance.contents().load()
        expect held == 500_000 and lifted == 0
        return seen
    })
    let refused = try await run(one_tally(world.alloc, adjust: most_of_a_cpu), components: Tallies(), journal: Counts.of(world.alloc), machine: Spare(alloc: world.alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[os::Lifecycle, 2] fails Failure uses wait {
        return try await started_twice(core, alloc: world.alloc)
    })
    let running = Array[os::Lifecycle, 2].filled(os::Lifecycle.Running)
    expect fitting == Some(running)
    expect refused == Some(Array[os::Lifecycle, 2].filled(os::Lifecycle.Failed))
} reservations_beyond_80_percent_of_a_cpu_fail_starts
