    discard mut known.grants.insert(2, value: expiring(system(), parent: 0, seconds: -1, alloc))
    discard mut known.grants.insert(3, value: os::Grant(holder: system(), object: os::Object.Clock, rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: Some(2), granted_by: ident::CommitId(number: 3)))
    let counts = Counts.of(alloc)
    let seen = try await run(take known, components: Pair(), journal: counts, reservations: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Array[os::Lifecycle, 2] fails os::ControlError uses wait {
        return try await outlived(core, clock: world.clock, alloc)
    })
    let revoked = counts.revoked.contents().load()
    let Some(states) = seen else {
        expect false
        return
    }
    expect states[0] == os::Lifecycle.Running and states[1] == os::Lifecycle.Failed
    expect revoked == 3
} grants_expire_at_start_and_once_their_expiry_passes

/// What a created tally gave: its first total, the total its postponed request was answered with, whether its port was revoked once it was deleted, and whether a start after the deletion found it missing.
struct Made derives Copy, Eq {
    initial: u64
    postponed: u64
    revoked: bool
    missing: bool
} Made

fn wait_later(port: os::Port[Counter], alloc: mem::Alloc) -> u64 fails os::PortError[Never] uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Counter].later(mut call)
    return try await port.call(take call, reply, alloc)
} wait_later

fn settle_all(port: os::Port[Counter], alloc: mem::Alloc) -> u32 fails os::PortError[Never] uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Counter].settle(mut call)
    return try await port.call(take call, reply, alloc)
} settle_all

/// Creates a tally through the core's `Control`, calls it through a port the order mints, has a later handler answer a postponed request, then deletes it.
fn made(core: Core, exec: task::Executor, alloc: mem::Alloc) -> Made fails Failure uses wait {
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    let spec = os::InstanceSpec.of(principal: system(), bundle: ident::HashValue(bytes: bundle), component: "runner::Tally", alloc)
    try await core.control.create(named("made"), take spec, grants: mem::Map.empty(alloc), alloc)
    discard try await core.control.start(named("made"), alloc)
    let handle = try await core.control.port(named("made"), credit: os::Credit(messages: 2, calls: 2), alloc)
    let Some(port) = os::Port[Counter].of(handle) else {
        fail Failure.Control(os::ControlError.Missing)
    }
    let initial = try await add(port, amount: 6, alloc)
    var postponed: u64 = 0
    try await task::scope(exec, body: fn[mut postponed](s: task::Scope) fails Failure uses wait {
        let waited = s.spawn(fn() -> u64 fails os::PortError[Never] uses wait limits stack 16_384 {
            return try await wait_later(port, alloc)
        })
        while try await settle_all(port, alloc) == 0 {
        }
        postponed = try await take waited.join()
    })
    try await core.control.delete(named("made"), alloc)
    let after = attempt await add(port, amount: 1, alloc)
    let again = attempt await core.control.start(named("made"), alloc)
    let revoked = match after {
        Err(os::PortError.Revoked) => true
        else => false
    }
    let missing = match again {
        Err(os::ControlError.Missing) => true
        else => false
    }
    return Made(initial: initial, postponed: postponed, revoked: revoked, missing: missing)
} made

test created_instances_answer_postponed_requests_until_deleted for Directory.create {
    let world = testing::world()
    let alloc = world.alloc
    let seen = try await run(Known(specs: mem::Map.empty(alloc), grants: mem::Map.empty(alloc)), components: Tallies(), journal: Counts.of(alloc), reservations: Spare(alloc: alloc, holds: true), config: configured(world), postings: unread(world.alloc), logs: unlogged(world.alloc), gauges: Gauges.empty(world.alloc), tracings: untraced(world.alloc), body: fn(core: Core) -> Made fails Failure uses wait {
        return try await made(core, exec: world.exec, alloc)
    })
    expect seen == Some(Made(initial: 6, postponed: 6, revoked: true, missing: true))
} created_instances_answer_postponed_requests_until_deleted

/// A directory holding the tally's endpoint, the root grant and a `Device` grant held by `inst.driver`, and the spec of `driver`, claiming that device and wired to the holder of the entropy role.
fn claiming(alloc: mem::Alloc) -> Directory {
    var listed = Directory(grants: mem::Map.empty(alloc), endpoints: mem::Map.empty(alloc), roles: mem::Map.empty(alloc))
    let task::Channel(sender: intake, receiver: _) = task::Channel[os::Call].bounded(1, alloc)
    discard mut listed.endpoints.insert(named("tally"), value: Endpoint(intake: take intake, gate: os::Gate.of(alloc), protocols: os::Protocols(own: sys::Wire[Counter].hash(), serves: None)))
    discard mut listed.grants.insert(0, value: os::Grant(holder: system(), object: os::Object.Machine, rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: None, granted_by: ident::CommitId(number: 1)))
    let holder = ident::Principal(text: text::Fixed[64].of("inst.driver"))
    discard mut listed.grants.insert(5, value: os::Grant(holder: take holder, object: os::Object.Device(path: text::String.of("pci/0000.00.03.0", alloc)), rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: Some(0), granted_by: ident::CommitId(number: 1)))
    return listed
} claiming

test worlds_draw_randomness_only_under_a_random_grant for Directory.world {
    let world = testing::world()
    let alloc = world.alloc
    var listed = Directory(grants: mem::Map.empty(alloc), endpoints: mem::Map.empty(alloc), roles: mem::Map.empty(alloc))
    discard mut listed.grants.insert(0, value: os::Grant(holder: ident::Principal(text: text::Fixed[64].of("inst.drawer")), object: os::Object.Random, rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: None, granted_by: ident::CommitId(number: 1)))
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    let bare = os::InstanceSpec.of(principal: system(), bundle: ident::HashValue(bytes: bundle), component: "runner::Tally", alloc)
    var granted = os::InstanceSpec.of(principal: system(), bundle: ident::HashValue(bytes: bundle), component: "runner::Tally", alloc)
    discard mut granted.grants.insert(text::String.of("random", alloc), value: 0)
    let task::Channel(sender: orders, receiver: _) = task::Channel[os::Order].bounded(1, alloc)
    let Ok(withheld) = attempt Withheld.of(world.clock, alloc) else {
        expect false
        return
    }
    let request = Request(moniker: named("drawer"), cell: alloc, exec: world.exec, clock: world.clock, random: world.random, withheld: withheld, orders: take orders, logs: unlogged(alloc), forking: None, alloc: alloc)
    var minted = Minted.none(alloc)
    let without = listed.world(bare, mut minted, request)
    let with = listed.world(granted, mut minted, request)
    take minted.close()
    let Some(denied) = without else {
        expect false
        return
    }
    let Some(served) = with else {
        expect false
        return
    }
    var drawn = Array[u8, 8].filled(0)
    let refused = attempt denied.random.fill(mut drawn.view_mut())
    let filled = attempt served.random.fill(mut drawn.view_mut())
    expect refused.is_err() and filled.is_ok()
} worlds_draw_randomness_only_under_a_random_grant

test worlds_claim_devices_and_wire_roles_once_assigned for Directory.world {
    let world = testing::world()
    let alloc = world.alloc
    var listed = claiming(alloc)
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    var spec = os::InstanceSpec.of(principal: system(), bundle: ident::HashValue(bytes: bundle), component: "runner::Tally", alloc)
    discard mut spec.grants.insert(text::String.of("device", alloc), value: 5)
    discard mut spec.wiring.insert(text::String.of("source", alloc), value: os::Wire(target: os::Target.Role(os::Role.Entropy), operations: None, credit: os::Credit(messages: 1, calls: 1)))
    let task::Channel(sender: orders, receiver: _) = task::Channel[os::Order].bounded(1, alloc)
    let Ok(withheld) = attempt Withheld.of(world.clock, alloc) else {
        expect false
        return
    }
    let request = Request(moniker: named("driver"), cell: alloc, exec: world.exec, clock: world.clock, random: world.random, withheld: withheld, orders: take orders, logs: unlogged(alloc), forking: None, alloc: alloc)
    var minted = Minted.none(alloc)
    let unassigned = listed.world(spec, mut minted, request)
    expect unassigned.is_none()
    discard mut listed.assign(os::Role.Entropy, moniker: named("tally"))
    let Some(built) = listed.world(spec, mut minted, request) else {
        expect false
        take minted.close()
        return
    }
    let source = attempt nanos::Cap[os::PortHandle].get(built.caps, key: "source")
    let path = match attempt nanos::Cap[os::Device].get(built.caps, key: "device") {
        Ok(device) => device.path(alloc)
        Err(_) => None
    }
    take minted.close()
    expect source.is_ok()
    let Some(named_path) = path else {
        expect false
        return
    }
    expect named_path.as_str() == "pci/0000.00.03.0"
} worlds_claim_devices_and_wire_roles_once_assigned
