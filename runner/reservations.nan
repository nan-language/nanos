//! CPU reservations: the CPUs on which the `latency` shares of instances are admitted, each holding at most 80% of its time in reservations, and the latency tolerance they set on each.

/// The millionths of a CPU its admitted reservations may use together.
const ADMISSIBLE_PPM: u64 = 800_000

/// What a reservation holds of a CPU: `ppm` millionths of its time, leaving it `slack_ns` of each period.
struct Reservation derives Copy, Eq {
    ppm: u64
    slack_ns: u64
} Reservation

/// A reservation admitted on CPU `cpu`.
struct Admitted derives Copy, Eq {
    cpu: u32
    reservation: Reservation
} Admitted

/// The reservations admitted on the machine's `cpus` CPUs.
struct Reservations {
    cpus: u32
    admitted: mem::List[Admitted]
} Reservations

/// The reservation of `share`: its runtime in each period, none outside the `latency` class or when it rounds to no millionth of a CPU.
fn Reservation.of(share: os::Share) -> Option[Reservation] {
    if share.class != os::CpuClass.Latency or share.period_us == 0 {
        return None
    }
    let ppm = u64.widen(share.runtime_us) * 1_000_000 / u64.widen(share.period_us)
    if ppm == 0 {
        return None
    }
    let slack_us = u64.widen(share.period_us).saturating_sub(u64.widen(share.runtime_us))
    return Some(Reservation(ppm: ppm, slack_ns: slack_us * 1_000))
} Reservation.of

/// No reservation admitted on any of `cpus` CPUs.
fn Reservations.of(cpus: u32, alloc: mem::Alloc) -> Reservations = Reservations(cpus: cpus, admitted: mem::List.empty(alloc))

/// Admits `reservation` on the CPU whose admitted reservations use the least of it, the lowest numbered on ties, when they then use at most 80% of it; `None` when none holds it.
fn Reservations.admit(mut self, reservation: Reservation) -> Option[Admitted] {
    var chosen: Option[u32] = None
    var least: u64 = 0
    for cpu in 0..<self.cpus {
        let used = self.used(cpu)
        if chosen.is_none() or used < least {
            chosen = Some(cpu)
            least = used
        }
    }
    let Some(cpu) = chosen else {
        return None
    }
    if least.saturating_add(reservation.ppm) > ADMISSIBLE_PPM {
        return None
    }
    let admitted = Admitted(cpu: cpu, reservation: reservation)
    mut self.admitted.push(admitted)
    return Some(admitted)
} Reservations.admit

/// Ends the reservation `admitted`.
fn Reservations.release(mut self, admitted: Admitted) {
    for index in 0..<self.admitted.len() {
        if self.admitted[index] == admitted {
            discard mut self.admitted.remove(index)
            return
        }
    }
} Reservations.release

/// The millionths of CPU `cpu` its admitted reservations use.
fn Reservations.used(self, cpu: u32) -> u64 {
    var used: u64 = 0
    for admitted in self.admitted {
        if admitted.cpu == cpu {
            used = used.saturating_add(admitted.reservation.ppm)
        }
    }
    return used
} Reservations.used

/// The latency tolerance of CPU `cpu`: the least slack of the reservations admitted on it, `None` when none is.
fn Reservations.tolerance(self, cpu: u32) -> Option[u64] {
    var tolerance: Option[u64] = None
    for admitted in self.admitted {
        if admitted.cpu == cpu {
            tolerance = Some(tolerance.value_or(admitted.reservation.slack_ns).min(admitted.reservation.slack_ns))
        }
    }
    return tolerance
} Reservations.tolerance

/// Reservations go to the least used CPU, the lowest numbered on ties, as long as each CPU's stay within 80% of it, and an ended one frees its part; each CPU tolerates the least slack of those it holds.
test reservations_spread_over_cpus_up_to_80_percent for Reservations.admit {
    let alloc = testing::world().alloc
    var reservations = Reservations.of(cpus: 2, alloc)
    let half = mut reservations.admit(Reservation(ppm: 500_000, slack_ns: 500_000))
    let lighter = mut reservations.admit(Reservation(ppm: 300_000, slack_ns: 7_000_000))
    let joined = mut reservations.admit(Reservation(ppm: 400_000, slack_ns: 600_000))
    let refused = mut reservations.admit(Reservation(ppm: 400_000, slack_ns: 600_000))
    expect half == Some(Admitted(cpu: 0, reservation: Reservation(ppm: 500_000, slack_ns: 500_000)))
    expect lighter == Some(Admitted(cpu: 1, reservation: Reservation(ppm: 300_000, slack_ns: 7_000_000)))
    expect joined == Some(Admitted(cpu: 1, reservation: Reservation(ppm: 400_000, slack_ns: 600_000))) and refused.is_none()
    expect reservations.tolerance(0) == Some(500_000) and reservations.tolerance(1) == Some(600_000)
    mut reservations.release(Admitted(cpu: 0, reservation: Reservation(ppm: 500_000, slack_ns: 500_000)))
    expect reservations.tolerance(0).is_none()
    let freed = mut reservations.admit(Reservation(ppm: 800_000, slack_ns: 250_000))
    expect freed == Some(Admitted(cpu: 0, reservation: Reservation(ppm: 800_000, slack_ns: 250_000)))
} reservations_spread_over_cpus_up_to_80_percent
