//! CPU reservations: the CPUs on which the `latency` shares of instances and `Session` grants are admitted.

/// What a reservation holds of a CPU: `runtime_ns` of every `period_ns`, `ppm` millionths of its time.
struct Reservation derives Copy, Eq {
    ppm: u64
    runtime_ns: u64
    period_ns: u64
} Reservation

/// The reservation numbered `id`, admitted on CPU `cpu`.
struct Admitted derives Copy, Eq {
    id: u64
    cpu: u32
    reservation: Reservation
} Admitted

/// The millionths of each CPU, by number, that admitted reservations take, and the number of the next reservation admitted.
struct Reservations {
    used: mem::List[u64]
    next: u64
} Reservations

/// The reservation of `share`, none outside the `latency` class.
fn Reservation.of(share: os::Share) -> Option[Reservation] {
    let ppm = share.reserved_ppm()
    if ppm == 0 {
        return None
    }
    return Some(Reservation(ppm: ppm, runtime_ns: u64.widen(share.runtime_us) * 1_000, period_ns: u64.widen(share.period_us) * 1_000))
} Reservation.of

/// No reservation admitted on any of `cpus` CPUs.
fn Reservations.of(cpus: u32, alloc: mem::Alloc) -> Reservations {
    var used = mem::List[u64].empty(alloc)
    for _ in 0..<cpus {
        mut used.push(0)
    }
    return Reservations(used: take used, next: 1)
} Reservations.of

/// Admits `reservation` on the CPU `os::admitting_cpu` names; `None` when none holds it.
fn Reservations.admit(mut self, reservation: Reservation) -> Option[Admitted] {
    let Some(cpu) = os::admitting_cpu(self.used.view(), ppm: reservation.ppm) else {
        return None
    }
    let index = usize.widen(cpu)
    self.used[index] = self.used[index].saturating_add(reservation.ppm)
    let admitted = Admitted(id: self.next, cpu: cpu, reservation: reservation)
    self.next = self.next.saturating_add(1)
    return Some(admitted)
} Reservations.admit

/// Ends the reservation `admitted`.
fn Reservations.release(mut self, admitted: Admitted) {
    let cpu = usize.widen(admitted.cpu)
    if cpu < self.used.len() {
        self.used[cpu] = self.used[cpu].saturating_sub(admitted.reservation.ppm)
    }
} Reservations.release

/// A reservation of `ppm` millionths of every millisecond.
fn reserving(ppm: u64) -> Reservation = Reservation(ppm: ppm, runtime_ns: ppm, period_ns: 1_000_000)

/// Reservations spread over the CPUs as `os::admitting_cpu` places them, each admitted one numbered after the last, and an ended one frees its part.
test reservations_spread_over_cpus_up_to_80_percent for Reservations.admit {
    let alloc = testing::world().alloc
    var reservations = Reservations.of(cpus: 2, alloc)
    let half = mut reservations.admit(reserving(500_000))
    let lighter = mut reservations.admit(reserving(300_000))
    let joined = mut reservations.admit(reserving(400_000))
    let refused = mut reservations.admit(reserving(400_000))
    expect half == Some(Admitted(id: 1, cpu: 0, reservation: reserving(500_000)))
    expect lighter == Some(Admitted(id: 2, cpu: 1, reservation: reserving(300_000)))
    expect joined == Some(Admitted(id: 3, cpu: 1, reservation: reserving(400_000))) and refused.is_none()
    mut reservations.release(Admitted(id: 1, cpu: 0, reservation: reserving(500_000)))
    let freed = mut reservations.admit(reserving(800_000))
    expect freed == Some(Admitted(id: 4, cpu: 0, reservation: reserving(800_000)))
} reservations_spread_over_cpus_up_to_80_percent
