//! CPU reservations: the CPUs on which the `latency` shares of instances are admitted, each holding at most 80% of its time in reservations.

/// The millionths of a CPU its admitted reservations may use together.
const ADMISSIBLE_PPM: u64 = 800_000

/// The millionths of each CPU, by number, that admitted reservations use.
struct Reservations {
    used: mem::List[u64]
} Reservations

/// A reservation admitted on CPU `cpu`, using `ppm` millionths of it.
struct Admitted derives Copy, Eq {
    cpu: u32
    ppm: u64
} Admitted

/// No reservation admitted on any of `cpus` CPUs.
fn Reservations.of(cpus: u32, alloc: mem::Alloc) -> Reservations {
    var used = mem::List[u64].empty(alloc)
    for _ in 0..<cpus {
        mut used.push(0)
    }
    return Reservations(used: take used)
} Reservations.of

/// Admits a reservation of `ppm` millionths of a CPU on the CPU whose admitted reservations use the least of it, the lowest numbered on ties, when they then use at most 80% of it; `None` when none holds it.
fn Reservations.admit(mut self, ppm: u64) -> Option[Admitted] {
    var chosen: Option[usize] = None
    for cpu in 0..<self.used.len() {
        let lighter = match chosen {
            Some(best) => self.used[cpu] < self.used[best]
            None => true
        }
        if lighter {
            chosen = Some(cpu)
        }
    }
    let Some(cpu) = chosen else {
        return None
    }
    if self.used[cpu].saturating_add(ppm) > ADMISSIBLE_PPM {
        return None
    }
    self.used[cpu] += ppm
    return Some(Admitted(cpu: u32.truncate(u64.widen(cpu)), ppm: ppm))
} Reservations.admit

/// Ends the reservation `admitted`.
fn Reservations.release(mut self, admitted: Admitted) {
    let cpu = usize.widen(admitted.cpu)
    if cpu < self.used.len() {
        self.used[cpu] = self.used[cpu].saturating_sub(admitted.ppm)
    }
} Reservations.release

/// The millionths of a CPU the reservation of `share` uses: its runtime in each period, none outside the `latency` class.
fn reserved_ppm(share: os::Share) -> u64 {
    if share.class != os::CpuClass.Latency or share.period_us == 0 {
        return 0
    }
    return u64.widen(share.runtime_us) * 1_000_000 / u64.widen(share.period_us)
} reserved_ppm

/// Reservations go to the least used CPU, the lowest numbered on ties, as long as each CPU's stay within 80% of it, and an ended one frees its part.
test reservations_spread_over_cpus_up_to_80_percent for Reservations.admit {
    let alloc = testing::world().alloc
    var reservations = Reservations.of(cpus: 2, alloc)
    let half = mut reservations.admit(ppm: 500_000)
    let lighter = mut reservations.admit(ppm: 300_000)
    let joined = mut reservations.admit(ppm: 400_000)
    let refused = mut reservations.admit(ppm: 400_000)
    expect half == Some(Admitted(cpu: 0, ppm: 500_000)) and lighter == Some(Admitted(cpu: 1, ppm: 300_000))
    expect joined == Some(Admitted(cpu: 1, ppm: 400_000)) and refused.is_none()
    mut reservations.release(Admitted(cpu: 0, ppm: 500_000))
    let freed = mut reservations.admit(ppm: 800_000)
    expect freed == Some(Admitted(cpu: 0, ppm: 800_000))
} reservations_spread_over_cpus_up_to_80_percent
