//! Recordings: an instance's flight recorder armed by `record`, by a probation or after a trap, its recording committed to `/state/<moniker>/recording` as the armed period ends, and the re-running of a recorded input on forks of the instance.

/// How long a trap arms the flight recorder of the next incarnation, in nanoseconds.
const AFTER_TRAP_NS: u64 = 600_000_000_000

/// The bytes a recording armed after a trap holds at most.
const AFTER_TRAP_BYTES: u64 = 4_194_304

/// The bytes one append of a recording's draft gives, and one read of it takes.
const RECORDING_CHUNK: u32 = 1_048_576

/// Arms the flight recorder of the running instance for `period`, through its holder's order, or for a bundle's component at its holder's next step; whether it could, the instance being recordable. A task of `s` tells `inputs` when the period ends.
fn Shared.arm(self, mut driver: Driver, period: Period, inputs: task::Sender[Input], s: task::Scope) -> bool fails task::Cancelled uses wait {
    if not driver.recordable(self.components) or driver.lifecycle != Some(os::Lifecycle.Running) {
        return false
    }
    let Some(domain) = driver.domain else {
        return false
    }
    if driver.hosted.is_some() {
        try await driver.recorder.order_arming(bundle: driver.spec.bundle, period, tape: driver.minted.tape.share())
    } else {
        match attempt await domain.deliveries.send(Delivery.Hold(order: HolderOrder.Arm(bundle: driver.spec.bundle, period: period, tape: driver.minted.tape.share()))) {
            Err(task::SendError.Cancelled(cancelled)) => fail cancelled
            Err(task::SendError.Closed) => return false
            Ok(_) => {
            }
        }
    }
    match period.until_ns {
        Some(at) => {
            let clock = self.config.clock
            let telling = inputs.split()
            discard s.spawn(fn[take telling]() fails task::Cancelled uses wait limits stack 8_192 {
                try await clock.sleep_ns(at.saturating_sub(now(clock)))
                discard attempt await telling.send(Input.Disarm(until_ns: at))
            })
        }
        None => {
        }
    }
    return true
} Shared.arm

/// Disarms the instance's flight recorder when its armed period is the one ending at `until_ns`, committing its recording.
fn Shared.disarm_at(self, mut driver: Driver, until_ns: u64, s: task::Scope) fails task::Cancelled uses wait {
    match first try await driver.recorder.period() {
        Some(period) if period.until_ns == Some(until_ns) => try await self.disarm(mut driver, s)
        else => {
        }
    }
} Shared.disarm_at

/// Arms the flight recorder of the instance that has just started running: for its probation, under the probation's recording bound, and for the period a stop or a trap deferred to its start.
fn Shared.arm_at_start(self, mut driver: Driver, inputs: task::Sender[Input], s: task::Scope) fails task::Cancelled uses wait {
    let deferred = try await driver.recorder.take_deferred()
    match driver.probation_bound() {
        Some(bound) => {
            discard try await self.arm(mut driver, period: Period(bound: bound, until_ns: None, to_checkpoint: false), inputs, s)
        }
        None => {
        }
    }
    let Some(period) = deferred else {
        return
    }
    match first period.until_ns {
        Some(until) if until > now(self.config.clock) => {
            discard try await self.arm(mut driver, period, inputs, s)
        }
        else => {
        }
    }
} Shared.arm_at_start

/// Ends the armed period of the instance's flight recorder as its domain ended, committing its recording, and has its next start arm it again for the rest of the period; after a `trapped` end, also for 10 minutes or until its next checkpoint.
fn Shared.recording_ended(self, mut driver: Driver, trapped: bool, s: task::Scope) fails task::Cancelled uses wait {
    var next = match first try await driver.recorder.period() {
        Some(period) if period.until_ns.is_some() => Some(period)
        else => None
    }
    try await self.disarm(mut driver, s)
    if trapped and driver.recordable(self.components) {
        let after = Period(bound: AFTER_TRAP_BYTES, until_ns: Some(now(self.config.clock).saturating_add(AFTER_TRAP_NS)), to_checkpoint: true)
        next = match next {
            Some(rest) => Some(rest.joined(after))
            None => Some(after)
        }
    }
    match next {
        Some(period) => try await driver.recorder.defer_arming(period)
        None => {
        }
    }
} Shared.recording_ended

/// Ends the armed period of a probation that ended, committing its recording.
fn Shared.end_probation_recording(self, mut driver: Driver, s: task::Scope) fails task::Cancelled uses wait {
    if not driver.recorder.is_armed() or driver.in_probation() {
        return
    }
    match first try await driver.recorder.period() {
        Some(period) if period.until_ns.is_none() => try await self.disarm(mut driver, s)
        else => {
        }
    }
} Shared.end_probation_recording

/// Disarms the instance's flight recorder and commits its recording to `/state/<moniker>/recording` as a blob, on a task of `s`.
fn Shared.disarm(self, mut driver: Driver, s: task::Scope) fails task::Cancelled uses wait {
    let Some(recording) = try await driver.recorder.disarm() else {
        return
    }
    let alloc = self.config.alloc
    if driver.updating.is_some() {
        mut driver.keep_inputs(copied_inputs(recording.inputs.view(), alloc))
    }
    let directory = self.directory.share()
    let view = await when directory => directory.state_view(mut driver.minted, moniker: ident::Moniker(text: driver.moniker.text), principal: ident::Principal(text: driver.spec.principal.text), alloc)
    let Some(state) = view else {
        return
    }
    let moniker = ident::Moniker(text: driver.moniker.text)
    discard s.spawn(fn[take recording, take moniker]() fails task::Cancelled uses wait limits stack 16_384 {
        try await commit_recording(state, take moniker, take recording, alloc)
    })
} Shared.disarm

/// Commits `recording` to `/<moniker>/recording` of `state`, a View of `/state`, as a blob replacing the one before.
fn commit_recording(state: store::service::View, take moniker: ident::Moniker, take recording: os::Recording, alloc: mem::Alloc) fails task::Cancelled uses wait {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[os::Recording].encode(recording, out: mut bytes)
    let draft = match first attempt await state.draft(alloc) {
        Ok(drafted) => drafted
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return
    }
    var at: usize = 0
    while at < bytes.len() {
        let count = usize.widen(RECORDING_CHUNK).min(bytes.len() - at)
        let Some(parts) = bytes.view().split_at(at) else {
            return
        }
        let Some(part) = parts.tail.prefix(count) else {
            return
        }
        var piece = mem::Bytes.empty(alloc)
        mut piece.append(part)
        match first attempt await state.draft_append(draft, bytes: take piece, alloc) {
            Ok(_) => {
            }
            Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
            Err(_) => return
        }
        at += count
    }
    let closed = match first attempt await state.draft_close(draft, expected: None, alloc) {
        Ok(blob) => blob
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return
    }
    var writes = mem::List[store::Write].empty(alloc)
    mut writes.push(store::Write.Put(path: state_dir(moniker, name: "recording", alloc), value: store::Value.Blob(closed.id)))
    let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: None, plan: None, intent: None)
    match first attempt await state.commit(take transaction, typed: true, alloc) {
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} commit_recording

/// The recording `/<moniker>/recording` of `state`, a View of `/state`, holds; `None` when it holds none that decodes.
fn committed_recording(state: store::service::View, moniker: ident::Moniker, alloc: mem::Alloc) -> Option[os::Recording] fails task::Cancelled uses wait {
    let path = state_dir(moniker, name: "recording", alloc)
    let node = match first attempt await state.get(ident::Path(text: text::String.of(path.text.as_str(), alloc)), at: None, alloc) {
        Ok(found) => found
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return None
    }
    var read = Untrusted.of(mem::Bytes.empty(alloc))
    while u64.widen(read.byte_len()) < node.size {
        let piece = match first attempt await state.read(ident::Path(text: text::String.of(path.text.as_str(), alloc)), at: Some(node.version), offset: u64.widen(read.byte_len()), length: RECORDING_CHUNK, alloc) {
            Ok(given) => given
            Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
            Err(_) => return None
        }
        if piece.byte_len() == 0 {
            return None
        }
        mut read.append(piece.view())
    }
    return match attempt mem::wire::Codec[os::Recording].decode(read.view(), alloc) {
        Ok(recording) => Some(take recording)
        Err(_) => None
    }
} committed_recording

/// Carries out each order `journal` gives to arm a flight recorder: the driver of its instance arms it, or the order is told it was not armed.
fn keep_arming(take arming: task::Receiver[journal::Arming], routes: task::Cown[mem::Map[ident::Moniker, task::Sender[Input]]]) fails task::Cancelled uses wait {
    var receiver = arming
    loop {
        let Some(order) = try await mut receiver.receive() else {
            return
        }
        let journal::Arming(moniker: moniker, duration_s: duration_s, bound: bound, done: done) = order
        let route = await when routes => match routes.get(moniker) {
            Some(inputs) => Some(inputs.split())
            None => None
        }
        let Some(inputs) = route else {
            discard attempt await done.send(false)
            continue
        }
        match attempt await inputs.send(Input.Arm(duration_s: duration_s, bound: bound, done: take done)) {
            Err(task::SendError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
    }
} keep_arming

/// Re-runs the recorded input `seq` on forks of the instance, from the base of the recording holding it, kept in memory or committed, under the recorded bundle, their store reads reaching `branch`, on a task of `s` telling `done` what it gave; another bundle than the recorded one, and an instance that may hold a resource, are not forked.
fn Shared.rerun(
    self,
    mut driver: Driver,
    seq: u64,
    bundle: Option[ident::HashValue],
    take branch: text::String,
    take done: task::Sender[Result[os::Outcome, os::ControlError]],
    s: task::Scope,
    ) fails task::Cancelled uses wait {
    let alloc = self.config.alloc
    if not driver.forkable(self.components) or (bundle.is_some() and bundle != Some(driver.spec.bundle)) {
        discard attempt await done.send(Err(os::ControlError.NotForkable))
        return
    }
    let held = try await driver.recorder.holding(seq, alloc)
    let directory = self.directory.share()
    let view = await when directory => directory.state_view(mut driver.minted, moniker: ident::Moniker(text: driver.moniker.text), principal: ident::Principal(text: driver.spec.principal.text), alloc)
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[os::InstanceSpec].encode(driver.spec, out: mut bytes)
    let Ok(spec) = attempt mem::wire::Codec[os::InstanceSpec].decode(Untrusted.of(bytes.view()), alloc) else {
        discard attempt await done.send(Err(os::ControlError.Invalid))
        return
    }
    let moniker = ident::Moniker(text: driver.moniker.text)
    let header = os::Header.of_work(cause: driver.changed_by, slot: driver.slot)
    let pool = match try await self.machine.pool() {
        Some(pooled) => Some(pooled.alloc)
        None => None
    }
    let forks = Forks(components: self.components, config: self.config, directory: self.directory.share(), withheld: self.withheld, pool: pool)
    discard s.spawn(fn[take held, take view, take spec, take moniker, take branch, take forks, take done]() fails task::Cancelled uses wait limits stack 49_152 {
        var recording = held
        if recording.is_none() {
            match view {
                Some(state) => {
                    recording = try await committed_recording(state, moniker: ident::Moniker(text: moniker.text), alloc)
                }
                None => {
                }
            }
        }
        let outcome = match recording {
            Some(found) => try await forks.rerun(spec, take moniker, branch: branch.as_str(), recording: take found, seq, header)
            None => Err(os::ControlError.NotRecorded)
        }
        let answer: Result[os::Outcome, os::ControlError] = match outcome {
            Ok(found) => Ok(os::Outcome.Reran(mem::Heap.of(alloc).boxed(take found)))
            Err(failed) => Err(take failed)
        }
        discard attempt await done.send(take answer)
    })
} Shared.rerun

/// Re-runs the inputs of `recording` up to `seq` on forks of the instance `moniker` under `spec`, each from the state the one before ended with, its clock and random source serving the recorded reads, their store reads reaching `branch`: the state the input `seq` started from and what its fork saw; `NotRecorded` when the recording does not hold it, `Diverged` when a re-run handler called another instance or an earlier one ended without a state.
fn Forks.rerun(
    self,
    spec: os::InstanceSpec,
    take moniker: ident::Moniker,
    branch: Str,
    take recording: os::Recording,
    seq: u64,
    header: os::Header,
    ) -> Result[os::Rerun, os::ControlError] fails task::Cancelled uses wait {
    let alloc = self.config.alloc
    if recording.inputs.position(fn(input: os::RecordedInput) => input.seq == seq).is_none() {
        return Err(os::ControlError.NotRecorded)
    }
    let reached = mem::Shared.of(core::atomic::AtomicBool.of(false), alloc)
    let task::Channel(sender: intake, receiver: calls) = task::Channel[os::Call].bounded(1, alloc)
    var result: Result[os::Rerun, os::ControlError] = Err(os::ControlError.NotRecorded)
    var given = Some(Rerunning(recording: take recording, calls: take calls))
    try await task::scope(self.config.exec, body: fn[mut result, mut given](s: task::Scope) fails task::Cancelled uses wait {
        let Some(Rerunning(recording: held, calls: refused)) = mut given.extract() else {
            return
        }
        let reaching = reached.share()
        discard s.spawn(fn[take refused, take reaching]() fails task::Cancelled uses wait limits stack 8_192 {
            try await forked_calls(take refused, reaching)
        })
        result = try await self.rerun_inputs(spec, moniker: ident::Moniker(text: moniker.text), branch, recording: take held, seq, header, intake, reached)
        s.cancel()
    })
    return result
} Forks.rerun

/// What re-running a recording takes into its scope: the recording, and the calls its forks make.
struct Rerunning {
    recording: os::Recording
    calls: task::Receiver[os::Call]
} Rerunning

/// Re-runs the inputs of `recording` up to `seq` as `Forks.rerun` does, the forks' ports reaching `intake`, which notes in `reached` that it was reached.
fn Forks.rerun_inputs(
    self,
    spec: os::InstanceSpec,
    take moniker: ident::Moniker,
    branch: Str,
    take recording: os::Recording,
    seq: u64,
    header: os::Header,
    intake: task::Sender[os::Call],
    reached: mem::Shared[core::atomic::AtomicBool],
    ) -> Result[os::Rerun, os::ControlError] fails task::Cancelled uses wait {
    let alloc = self.config.alloc
    let os::Recording(bundle: bundle, base: base, inputs: inputs) = recording
    var state = base
    for input in take inputs {
        if input.seq > seq {
            break
        }
        let os::RecordedInput(seq: number, hash: hash, encoded: encoded, recorded: recorded) = input
        let before = os::StateCopy(schema: state.schema, state: copied(state.state.view(), alloc))
        let seen = try await self.run(spec, moniker: ident::Moniker(text: moniker.text), branch, source: Source.Given(copy: take state), call: Some(os::ForkCall(hash: hash, encoded: take encoded)), intake: intake.split(), reaching: reached.share(), header, served: Some(take recorded))
        if seen.reached {
            return Err(os::ControlError.Diverged)
        }
        if number == seq {
            return Ok(os::Rerun(bundle: bundle, before: take before, forked: take seen))
        }
        let Some(after) = seen.state else {
            return Err(os::ControlError.Diverged)
        }
        state = after
    }
    return Err(os::ControlError.NotRecorded)
} Forks.rerun_inputs
