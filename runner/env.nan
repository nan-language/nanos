//! Env construction: the world an instance's component builds its Env from, holding its cell, its executor and the capabilities minted from its grants and wiring.

/// The moniker of the instance serving the store, whose port every View holds.
const STORE_MONIKER: Str = "store"

/// The moniker of the instance serving the journal, whose port every source holds.
const JOURNAL_MONIKER: Str = "journal"

/// The service behind the log, random source and standard streams of every world, revoked before any instance holds them.
pub open struct Denied {
} Denied

impl Denied: sys::Kind[u8, u8]

impl Denied: sys::LogService

impl Denied: sys::RandomService

impl Denied: sys::StdioService

/// Revoked capabilities, which a world holds where its instance has no source.
struct Withheld derives Copy {
    clock: sys::Clock
    log: sys::Log
    random: sys::Random
    stdio: sys::Stdio
} Withheld

/// What the runner knows that worlds draw on: every live grant by number, where each instance with a specification takes calls, by moniker, and the holder of each assigned role.
struct Directory {
    grants: mem::Map[u64, os::Grant]
    endpoints: mem::Map[ident::Moniker, Endpoint]
    roles: mem::Map[os::Role, ident::Moniker]
} Directory

struct Endpoint {
    intake: task::Sender[os::Call]
    gate: os::Gate
    protocols: os::Protocols
} Endpoint

/// The root entries of the capabilities minted for one instance, kept across its incarnations: the minted port of each port field, with the grant it derives from, the root `Control`, device claim and View of each grant, the redirect of its Views of `main`, the tape of its clock and random source with their root entry, the ports to the instance that `Control` orders minted, and the source of its events, once minted.
linear struct Minted {
    ports: mem::List[WiredPort]
    controls: mem::List[GrantedControl]
    devices: mem::List[GrantedDevice]
    views: mem::List[GrantedView]
    redirect: store::service::Redirect
    tape: Tape
    taped: mem::List[sys::Minter[Taped, Taps, u8]]
    ordered: mem::List[os::MintedPort]
    sources: mem::List[EmittingSource]
    logging: mem::List[journal::MintedLogging]
} Minted

/// The root entry of an instance's sources and the port to `journal` they reach.
linear struct EmittingSource {
    port: os::MintedPort
    source: journal::MintedSource
} EmittingSource

linear struct WiredPort {
    field: text::String
    grant: u64
    port: os::MintedPort
} WiredPort

linear struct GrantedControl {
    grant: u64
    control: os::MintedControl
} GrantedControl

linear struct GrantedDevice {
    grant: u64
    device: os::MintedDevice
} GrantedDevice

/// A View's root entry and the port to `store` its Views reach.
linear struct GrantedView {
    grant: u64
    port: os::MintedPort
    view: store::service::MintedView
} GrantedView

/// What a world is built for: the instance, its specification and the sources its Env draws on, and for a fork its substitutes.
struct Request {
    moniker: ident::Moniker
    cell: mem::Alloc
    exec: task::Executor
    clock: sys::Clock
    random: sys::Random
    withheld: Withheld
    orders: task::Sender[os::Order]
    logs: task::Sender[journal::Logged]
    forking: Option[Substitutes]
    alloc: mem::Alloc
} Request

/// What a fork's world reaches in place of the instances: an intake that no instance serves, which its ports, those of its Views excepted, reach, and the branch its Views read and write.
struct Substitutes {
    intake: task::Sender[os::Call]
    branch: text::String
} Substitutes

pub fn Denied.log(self, level: sys::LogLevel, message: Str, value: Str) limits stack 4_096 {
} Denied.log

pub fn Denied.fill(self, mut buf: SliceMut[u8]) limits stack 4_096 {
} Denied.fill

pub fn Denied.read_in(self, mut buf: SliceMut[u8]) -> usize fails sys::StdioError limits stack 4_096 {
    fail sys::StdioError.Closed
} Denied.read_in

pub fn Denied.write_out(self, data: Slice[u8]) fails sys::StdioError limits stack 4_096 {
    fail sys::StdioError.Closed
} Denied.write_out

pub fn Denied.write_err(self, data: Slice[u8]) fails sys::StdioError limits stack 4_096 {
    fail sys::StdioError.Closed
} Denied.write_err

/// The revoked capabilities: the services of a closed minter of `Denied`, and a revoked copy of `clock`.
fn Withheld.of(clock: sys::Clock, alloc: mem::Alloc) -> Withheld fails sys::Revoked {
    let minter = sys::Minter[Denied, u8, u8].of(0, alloc)
    let served = attempt Withheld.served(minter.mint(0), clock)
    take minter.close()
    var withheld = match served {
        Ok(services) => services
        Err(failure) => fail failure
    }
    let revoker = try sys::revocable(clock)
    withheld.clock = revoker.capability()
    take revoker.revoke()
    return withheld
} Withheld.of

fn Withheld.served(service: Denied, clock: sys::Clock) -> Withheld fails sys::Revoked {
    return Withheld(clock: clock, log: try sys::Log.served(service), random: try sys::Random.served(service), stdio: try sys::Stdio.served(service))
} Withheld.served

fn Minted.none(alloc: mem::Alloc) -> Minted {
    return Minted(ports: mem::List.empty(alloc), controls: mem::List.empty(alloc), devices: mem::List.empty(alloc), views: mem::List.empty(alloc), redirect: store::service::Redirect.none(alloc), tape: Tape.none(alloc), taped: mem::List.empty(alloc), ordered: mem::List.empty(alloc), sources: mem::List.empty(alloc), logging: mem::List.empty(alloc))
} Minted.none

/// Revokes every capability minted for the instance.
fn Minted.close(take self) {
    let Minted(ports: ports, controls: controls, devices: devices, views: views, redirect: _, tape: _, taped: taped, ordered: ordered, sources: sources, logging: logging) = self
    for root in take taped {
        take root.close()
    }
    for emitting in take sources {
        take emitting.close()
    }
    for logs in take logging {
        take logs.close()
    }
    for granted in take views {
        take granted.close()
    }
    for wired in take ports {
        let WiredPort(field: _, grant: _, port: port) = wired
        take port.close()
    }
    for granted in take controls {
        let GrantedControl(grant: _, control: control) = granted
        take control.close()
    }
    for granted in take devices {
        let GrantedDevice(grant: _, device: device) = granted
        take device.close()
    }
    for port in take ordered {
        take port.close()
    }
} Minted.close

/// The world of the instance `request` names under `spec`, `None` when a grant it names is not its own and live, or a wire or port grant reaches no instance or is covered by no grant of its own or of its principal, or a wire names a role no instance holds.
fn Directory.world(self, spec: os::InstanceSpec, mut minted: Minted, request: Request) -> Option[nanos::World] {
    var caps = nanos::Caps.empty(request.cell)
    var clock = request.withheld.clock
    var random = request.withheld.random
    let holder = instance_principal(request.moniker)
    for granted in spec.grants {
        let Some(grant) = self.grants.get(granted.value()) else {
            return None
        }
        if grant.holder != holder {
            return None
        }
        match grant.object {
            os::Object.Clock => {
                clock = request.clock
            }
            os::Object.Random => {
                random = request.random
            }
            os::Object.Port(prefix: prefix, operations: _) => {
                let Some(handle) = self.port(mut minted, field: granted.key(), grant: granted.value(), target: prefix, operations: grant.operations(request.alloc), credit: os::Credit(messages: 64, calls: 64), request) else {
                    return None
                }
                mut nanos::Cap[os::PortHandle].put(mut caps, key: granted.key().as_str(), capability: handle)
            }
            os::Object.Device(path: path) => {
                let claim = mut minted.device(path: path.as_str(), number: granted.value(), alloc: request.alloc)
                mut nanos::Cap[os::Device].put(mut caps, key: granted.key().as_str(), capability: claim)
            }
            os::Object.Session(share: _, budget: _) => {
            }
            os::Object.Tree(prefix: prefix, branch: branch) => {
                let Some(view) = self.view(mut minted, grant, number: granted.value(), prefix, branch: branch.as_str(), spec, request) else {
                    return None
                }
                mut nanos::Cap[store::service::View].put(mut caps, key: granted.key().as_str(), capability: view)
            }
            else => {
                let control = mut minted.control(grant, number: granted.value(), request)
                mut nanos::Cap[os::Control].put(mut caps, key: granted.key().as_str(), capability: control)
            }
        }
    }
    match self.source(mut minted, principal: spec.principal, request) {
        Some(source) => mut nanos::Cap[journal::Source].put(mut caps, key: "events", capability: source)
        None => {
        }
    }
    for wired in spec.wiring {
        let Some(target) = self.target_of(wired.value().target) else {
            return None
        }
        let Some(covering) = self.covering(target, operations: wired.value().operations, holder, principal: spec.principal) else {
            return None
        }
        let Some(handle) = self.port(mut minted, field: wired.key(), grant: covering, target, operations: set_of(wired.value().operations, alloc: request.alloc), credit: wired.value().credit, request) else {
            return None
        }
        mut nanos::Cap[os::PortHandle].put(mut caps, key: wired.key().as_str(), capability: handle)
    }
    let log = match attempt sys::Log.served(mut minted.logging_of(request)) {
        Ok(served) => served
        Err(_) => request.withheld.log
    }
    return Some(nanos::World(alloc: request.cell, exec: request.exec, clock: clock, random: random, log: log, stdio: request.withheld.stdio, fs: sys::Fs.denied(), net: sys::Net.denied(), caps: take caps))
} Directory.world

/// A log capability of the instance `request` names, from its root entry, minted at the first use.
fn Minted.logging_of(mut self, request: Request) -> journal::Logging {
    for logs in self.logging {
        return logs.mint()
    }
    let root = journal::MintedLogging.of(request.logs.split(), instance: ident::Moniker(text: request.moniker.text), alloc: request.alloc)
    let logs = root.mint()
    mut self.logging.push(take root)
    return logs
} Minted.logging_of

/// The handle of the port minted for the Env field `field`, minting one from the grant `grant` to the instance `target` when the field has none, which reaches its intake, or for a fork the intake of its substitutes; `None` when `target` has no specification.
fn Directory.port(
    self,
    mut minted: Minted,
    field: text::String,
    grant: u64,
    target: ident::Moniker,
    take operations: Option[mem::Set[text::String]],
    credit: os::Credit,
    request: Request,
    ) -> Option[os::PortHandle] {
    let alloc = request.alloc
    for wired in minted.ports {
        if wired.field == field {
            return Some(wired.port.handle())
        }
    }
    let Some(endpoint) = self.endpoints.get(target) else {
        return None
    }
    let intake = match request.forking {
        Some(substitutes) => substitutes.intake
        None => endpoint.intake
    }
    let port = os::MintedPort.of(intake, gate: endpoint.gate, protocols: endpoint.protocols, take operations, credit, alloc)
    let handle = port.handle()
    mut minted.ports.push(WiredPort(field: text::String.of(field.as_str(), alloc), grant: grant, port: take port))
    return Some(handle)
} Directory.port

/// A View of the grant `number`, `grant`, from its root entry for this instance, minted at the first use: the subtree `prefix` of `branch` with the grant's rights, writing the nodes their owning operations write for an instance acting for `system` that may write, through a port to `store`; `None` when `store` has no specification.
fn Directory.view(
    self,
    mut minted: Minted,
    grant: os::Grant,
    number: u64,
    prefix: ident::Path,
    branch: Str,
    spec: os::InstanceSpec,
    request: Request,
    ) -> Option[store::service::View] {
    var rights = store::service::Rights.of(grant.rights)
    rights.own = rights.write and spec.principal.text.as_str() == "system"
    for granted in minted.views {
        if granted.grant == number {
            return Some(granted.view.mint(rights))
        }
    }
    let Some(endpoint) = self.endpoints.get(ident::Moniker(text: text::Fixed[59].of(STORE_MONIKER))) else {
        return None
    }
    let port = os::MintedPort.of(endpoint.intake, gate: endpoint.gate, protocols: endpoint.protocols, operations: None, credit: os::Credit(messages: 64, calls: 64), alloc: request.alloc)
    var served = text::String.of(branch, alloc: request.alloc)
    var redirect = Some(minted.redirect.share())
    match request.forking {
        Some(substitutes) => {
            served = text::String.of(substitutes.branch.as_str(), alloc: request.alloc)
            redirect = None
        }
        None => {
        }
    }
    let root = store::service::MintedView.of(store: port.handle(), prefix: ident::Path(text: text::String.of(prefix.text.as_str(), alloc: request.alloc)), branch: served.as_str(), take redirect, principal: ident::Principal(text: spec.principal.text), instance: Some(ident::Moniker(text: request.moniker.text)), alloc: request.alloc)
    let view = root.mint(rights)
    mut minted.views.push(GrantedView(grant: number, port: take port, view: take root))
    return Some(view)
} Directory.view

/// The instance a wire's target names: the instance itself, or the holder of its role, `None` when no instance holds that role.
fn Directory.target_of(self, target: os::Target) -> Option[ident::Moniker] {
    return match target {
        os::Target.Instance(moniker) => Some(ident::Moniker(text: moniker.text))
        os::Target.Role(role) => match self.roles.get(role) {
            Some(holder) => Some(ident::Moniker(text: holder.text))
            None => None
        }
    }
} Directory.target_of

/// A port to the instance `moniker` with the credit `credit`, reaching every operation; `None` when it has no specification.
fn Directory.mint(self, moniker: ident::Moniker, credit: os::Credit, alloc: mem::Alloc) -> Option[os::MintedPort] {
    let Some(endpoint) = self.endpoints.get(moniker) else {
        return None
    }
    return Some(os::MintedPort.of(endpoint.intake, gate: endpoint.gate, protocols: endpoint.protocols, operations: None, credit, alloc))
} Directory.mint

/// The number of the lowest-numbered live grant held by `holder` or `principal` that covers the instance `target` and, for a `Port` grant, the operations a wire to it names, all when `None`.
fn Directory.covering(
    self,
    target: ident::Moniker,
    operations: Option[mem::List[text::String]],
    holder: ident::Principal,
    principal: ident::Principal,
    ) -> Option[u64] {
    for entry in self.grants {
        let grant = entry.value()
        if (grant.holder == holder or grant.holder == principal) and grant.covers(target) and permits(grant, operations) {
            return Some(entry.key())
        }
    }
    return None
} Directory.covering

/// Removes the grant `grant` and every live grant descending from it from the live grants, returning their numbers; none when `grant` is not live.
fn Directory.revoke(mut self, grant: u64, alloc: mem::Alloc) -> mem::Set[u64] {
    var roots = mem::Set[u64].empty(alloc)
    discard mut roots.insert(grant)
    return mut self.remove(roots, alloc)
} Directory.revoke

/// Removes every live grant whose expiry the UTC time `reached` reaches, in nanoseconds, and every live grant descending from them, returning their numbers.
fn Directory.expire(mut self, reached: i64, alloc: mem::Alloc) -> mem::Set[u64] {
    var roots = mem::Set[u64].empty(alloc)
    for entry in self.grants {
        let Some(at) = entry.value().caveats.expires_utc_ns else {
            continue
        }
        if at <= reached {
            discard mut roots.insert(entry.key())
        }
    }
    return mut self.remove(roots, alloc)
} Directory.expire

/// The live grant that expires first, `None` when none expires.
fn Directory.earliest(self) -> Option[Expiry] {
    var earliest: Option[Expiry] = None
    for entry in self.grants {
        let Some(at) = entry.value().caveats.expires_utc_ns else {
            continue
        }
        let sooner = match earliest {
            Some(known) => at < known.at
            None => true
        }
        if sooner {
            earliest = Some(Expiry(grant: entry.key(), at: at))
        }
    }
    return earliest
} Directory.earliest

/// A grant's number and its expiry in UTC nanoseconds.
struct Expiry derives Copy {
    grant: u64
    at: i64
} Expiry

/// Removes the live grants among `roots` and every live grant descending from them from the live grants, returning their numbers.
fn Directory.remove(mut self, roots: mem::Set[u64], alloc: mem::Alloc) -> mem::Set[u64] {
    var removed = mem::Set[u64].empty(alloc)
    for root in roots {
        if self.grants.get(root).is_some() {
            discard mut removed.insert(root)
        }
    }
    var grown = removed.len() > 0
    while grown {
        grown = false
        for entry in self.grants {
            let Some(parent) = entry.value().parent else {
                continue
            }
            if removed.contains(parent) and not removed.contains(entry.key()) {
                discard mut removed.insert(entry.key())
                grown = true
            }
        }
    }
    for number in removed {
        discard mut self.grants.remove(number)
    }
    return removed
} Directory.remove

/// Revokes every capability minted for the instance and forgets them.
fn Minted.clear(mut self) {
    while self.ports.len() > 0 {
        let WiredPort(field: _, grant: _, port: port) = mut self.ports.remove(0)
        take port.close()
    }
    while self.controls.len() > 0 {
        let GrantedControl(grant: _, control: control) = mut self.controls.remove(0)
        take control.close()
    }
    while self.devices.len() > 0 {
        let GrantedDevice(grant: _, device: device) = mut self.devices.remove(0)
        take device.close()
    }
    while self.views.len() > 0 {
        let granted = mut self.views.remove(0)
        take granted.close()
    }
    while self.ordered.len() > 0 {
        let port = mut self.ordered.remove(0)
        take port.close()
    }
    while self.sources.len() > 0 {
        let emitting = mut self.sources.remove(0)
        take emitting.close()
    }
    while self.logging.len() > 0 {
        let logs = mut self.logging.remove(0)
        take logs.close()
    }
} Minted.clear

/// Revokes the root entry of the instance's sources and the port they reach `journal` through.
fn EmittingSource.close(take self) {
    let EmittingSource(port: port, source: source) = self
    take source.close()
    take port.close()
} EmittingSource.close

/// The source of the events of the instance `request` names, acting for `principal`, from its root entry, minted at the first use, through a port to `journal`, or for a fork to the intake of its substitutes; `None` when `journal` has no specification.
fn Directory.source(self, mut minted: Minted, principal: ident::Principal, request: Request) -> Option[journal::Source] {
    let alloc = request.alloc
    for emitting in minted.sources {
        return Some(emitting.source.mint())
    }
    let Some(endpoint) = self.endpoints.get(ident::Moniker(text: text::Fixed[59].of(JOURNAL_MONIKER))) else {
        return None
    }
    let intake = match request.forking {
        Some(substitutes) => substitutes.intake
        None => endpoint.intake
    }
    let port = os::MintedPort.of(intake, gate: endpoint.gate, protocols: endpoint.protocols, operations: None, credit: os::Credit(messages: 64, calls: 64), alloc)
    let root = journal::MintedSource.of(journal: port.handle(), instance: ident::Moniker(text: request.moniker.text), principal: ident::Principal(text: principal.text), alloc)
    let source = root.mint()
    mut minted.sources.push(EmittingSource(port: take port, source: take root))
    return Some(source)
} Directory.source

/// Revokes the root entries minted from the grants `grants` and forgets them, so that later incarnations mint from live grants only.
fn Minted.revoke(mut self, grants: mem::Set[u64]) {
    var at: usize = 0
    while at < self.ports.len() {
        if grants.contains(self.ports[at].grant) {
            let WiredPort(field: _, grant: _, port: port) = mut self.ports.remove(at)
            take port.close()
        } else {
            at += 1
        }
    }
    at = 0
    while at < self.controls.len() {
        if grants.contains(self.controls[at].grant) {
            let GrantedControl(grant: _, control: control) = mut self.controls.remove(at)
            take control.close()
        } else {
            at += 1
        }
    }
    at = 0
    while at < self.devices.len() {
        if grants.contains(self.devices[at].grant) {
            let GrantedDevice(grant: _, device: device) = mut self.devices.remove(at)
            take device.close()
        } else {
            at += 1
        }
    }
    at = 0
    while at < self.views.len() {
        if grants.contains(self.views[at].grant) {
            let granted = mut self.views.remove(at)
            take granted.close()
        } else {
            at += 1
        }
    }
} Minted.revoke

/// Revokes the View's root entry and the port its Views reach `store` through.
fn GrantedView.close(take self) {
    let GrantedView(grant: _, port: port, view: view) = self
    take view.close()
    take port.close()
} GrantedView.close

/// A `Control` of the grant `number`, from its root entry for this instance, minted at the first use.
fn Minted.control(mut self, grant: os::Grant, number: u64, request: Request) -> os::Control {
    let rights = os::ControlRights.of(grant.rights)
    for granted in self.controls {
        if granted.grant == number {
            return granted.control.mint(rights)
        }
    }
    let prefix = match grant.object {
        os::Object.Instance(prefix: prefix) => Some(ident::Moniker(text: prefix.text))
        else => None
    }
    let root = os::MintedControl.of(request.orders, grant: Some(number), take prefix, alloc: request.alloc)
    let control = root.mint(rights)
    mut self.controls.push(GrantedControl(grant: number, control: take root))
    return control
} Minted.control

/// A claim on the device at `path` of the grant `number`, from its root entry for this instance, minted at the first use.
fn Minted.device(mut self, path: Str, number: u64, alloc: mem::Alloc) -> os::Device {
    for granted in self.devices {
        if granted.grant == number {
            return granted.device.mint()
        }
    }
    let root = os::MintedDevice.of(path, alloc)
    let claim = root.mint()
    mut self.devices.push(GrantedDevice(grant: number, device: take root))
    return claim
} Minted.device

/// Whether a grant lets a port send the operations a wire names, all when `None`.
fn permits(grant: os::Grant, operations: Option[mem::List[text::String]]) -> bool {
    let os::Object.Port(prefix: _, operations: allowed) = grant.object else {
        return true
    }
    if allowed.len() == 0 {
        return true
    }
    let Some(names) = operations else {
        return false
    }
    for name in names {
        if not allowed.contains(name) {
            return false
        }
    }
    return true
} permits

fn set_of(operations: Option[mem::List[text::String]], alloc: mem::Alloc) -> Option[mem::Set[text::String]] {
    let Some(names) = operations else {
        return None
    }
    var set = mem::Set[text::String].empty(alloc)
    for name in names {
        discard mut set.insert(text::String.of(name.as_str(), alloc))
    }
    return Some(take set)
} set_of

/// The principal `inst.<moniker>` an instance's own grants are held by.
fn instance_principal(moniker: ident::Moniker) -> ident::Principal {
    var name = text::Fixed[64].of("inst.")
    mut name.append(moniker.text.as_str())
    return ident::Principal(text: name)
} instance_principal
