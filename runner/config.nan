//! Configuration records: the record of `/sys/config/<moniker>` the runner reads at each start of an instance, from which the instance's Env takes its configuration.

/// The grant number the root entry of an instance's View of `/sys/config` goes under, which no grant has.
const CONFIG_GRANT: u64 = 0xFFFF_FFFF_FFFF_FFFE

/// The instance's View of `/sys/config`, reading alone, from its root entry, minted at the first use, acting for `principal`; `None` when `store` has no specification.
fn Directory.config_view(
    self,
    mut minted: Minted,
    take moniker: ident::Moniker,
    take principal: ident::Principal,
    alloc: mem::Alloc,
    ) -> Option[store::service::View] {
    return self.branch_config_view(mut minted, take moniker, take principal, branch: "main", alloc)
} Directory.config_view

/// The instance's View of `/sys/config` of the branch `branch`, as `config_view` gives that of `main`.
fn Directory.branch_config_view(
    self,
    mut minted: Minted,
    take moniker: ident::Moniker,
    take principal: ident::Principal,
    branch: Str,
    alloc: mem::Alloc,
    ) -> Option[store::service::View] {
    let rights = store::service::Rights.reading()
    for granted in minted.views {
        if granted.grant == CONFIG_GRANT {
            return Some(granted.view.mint(rights))
        }
    }
    let Some(endpoint) = self.endpoints.get(ident::Moniker(text: text::Fixed[59].of(STORE_MONIKER))) else {
        return None
    }
    let port = os::MintedPort.of(endpoint.intake, gate: endpoint.gate, protocols: endpoint.protocols, operations: None, credit: os::Credit(messages: 64, calls: 64), alloc)
    let root = store::service::MintedView.of(store: port.handle(), prefix: ident::Path(text: text::String.of("/sys/config", alloc)), branch, take principal, instance: Some(take moniker), alloc)
    let view = root.mint(rights)
    mut minted.views.push(GrantedView(grant: CONFIG_GRANT, port: take port, view: take root))
    return Some(view)
} Directory.branch_config_view

/// The configuration record of the instance `driver` runs, `None` when its component takes none, `/sys/config` holds none for it or `store` does not answer.
fn Shared.configuration(self, mut driver: Driver) -> Option[Untrusted[mem::Bytes]] fails task::Cancelled uses wait {
    if not self.components.configured(driver.spec.component.as_str()) {
        return None
    }
    let alloc = self.config.alloc
    let directory = self.directory.share()
    let found = await when directory => directory.config_view(mut driver.minted, moniker: ident::Moniker(text: driver.moniker.text), principal: ident::Principal(text: driver.spec.principal.text), alloc)
    let Some(view) = found else {
        return None
    }
    let Some(path) = ident::Path(text: text::String.of("/", alloc)).child(driver.moniker.text.as_bytes(), alloc) else {
        return None
    }
    let node = match first attempt await view.get(take path, at: None, alloc) {
        Ok(read) => read
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return None
    }
    return node.value
} Shared.configuration
