//! The runner: instances of components in their own domains, their intakes, lifecycles, restarts and Envs.

/// The components the runner can run, by the canonical path of their state type.
pub interface Components {
    /// The protocols the component serves, `None` for a path naming no component.
    fn protocols(self, component: Str) -> Option[os::Protocols]
    /// Whether the component's Env takes a configuration record.
    fn configured(self, component: Str) -> bool
    /// The protocol schema the component serves, `None` for a path naming no component.
    fn schema(self, component: Str, alloc: mem::Alloc) -> Option[sys::ProtocolSchema]
    /// Whether the component's Env draws only on its world, so that a fork of an instance of it holds no resource.
    fn forkable(self, component: Str) -> bool
    /// Runs an instance of the component on `world` as `serving` asks, the task of the instance's domain.
    fn serve(self, component: Str, take world: nanos::World, take serving: Serving) -> Ended fails task::Cancelled uses wait
} Components

/// What the runner takes from the machine: the regions set aside for reserved instances, the pressure level of the pool the cells of the others split from, and the latency tolerance of each CPU, which the reservations admitted on it set.
pub interface Machine {
    /// A store over a region of at least `bytes` set aside for the rest of the boot, `None` when no free range holds one.
    fn reserve(self, bytes: u64) -> Option[mem::Heap] fails task::Cancelled uses wait
    /// The pool's pressure level, settled on what the pool has drawn now.
    fn settle(self) -> u8 fails task::Cancelled uses wait
    /// The pool's pressure level once it differs from `seen`.
    fn changed(self, seen: u8) -> u8 fails task::Cancelled uses wait
    /// Sets the latency tolerance of CPU `cpu` to `tolerance_ns`, unbounded when `None`.
    fn tolerate(self, cpu: u32, tolerance_ns: Option[u64])
} Machine

/// Where the runner records events, each with the slot of its instance, 0 for the core's, and the cause of the work it tells of as a header holds it, 0 for the core's own; where it opens the start causes of incarnations and records the spans of handler calls; and the instance each slot names.
pub interface Journal {
    fn record(self, slot: u32, cause: u64, event: Event)
    /// Opens the start cause of the incarnation `incarnation` of the instance `moniker` of slot `slot`, under the cause `parent`, and gives it, each as a header holds it.
    fn open(
        self,
        slot: u32,
        moniker: ident::Moniker,
        incarnation: u64,
        parent: u64,
        ) -> u64
    fn span(self, slot: u32, span: Span)
    /// Notes that the slot `slot` names the instance `moniker`.
    fn name(self, slot: u32, take moniker: ident::Moniker) fails task::Cancelled uses wait
} Journal

/// A handler call: its cause as a header holds it, the monotonic time it began, its time queued in the instance's intake and running, the slot of the sending instance, 0 for the core, the operation it handled, its name cut to 20 bytes, and the kind of its trap when it trapped.
pub closed struct Span derives Copy {
    pub cause: u64
    pub start_ns: u64
    pub wait_ns: u64
    pub run_ns: u64
    pub sender: u32
    pub operation: text::Fixed[20]
    pub trapped: Option[sys::TrapKind]
} Span

/// An event of an instance's life, or of the core's for `Revoked`: a start names what it started from, a failed checkpoint the code of its failure and the bytes of its encoding, a hibernation the bytes of its image.
pub closed enum Event derives Copy, Eq {
    Started(incarnation: u64, from: journal::StartedFrom)
    Stopped(abandoned: bool)
    Trapped(incarnation: u64, kind: sys::TrapKind, limit: bool)
    Integrity(incarnation: u64)
    Failed(restarts: u32)
    SlowHandler(ns: u64)
    Revoked(grant: u64, reason: Reason)
    CheckpointFailed(code: text::Fixed[32], bytes: u64)
    Hibernated(bytes: u64)
} Event

/// Why a grant was revoked: a revocation, or its expiry.
pub closed enum Reason derives Copy, Eq {
    Revoke
    Expiry
} Reason

/// What the runner draws on: the executor its instances' accounts split from, the allocator their cells split from, the hibernation cell that hibernation images are kept through, its own allocator, the power of a running CPU in milliwatts, which its CPU time costs, the number of CPUs reservations are admitted on, the monotonic clock, the wall clock grants expire by, the random source instances holding a `Random` grant draw from, the executor's class of each CPU class, `latency`, `normal` and `background` in order, then of core work whose timers never wake an idle machine, and the boot's system cause, that of the runner's own work.
pub closed struct Config derives Copy {
    pub exec: task::Executor
    pub pool: mem::Alloc
    pub hibernation: mem::Alloc
    pub alloc: mem::Alloc
    pub busy_mw: u64
    pub cpus: u32
    pub clock: sys::Clock
    pub wall: ident::Wall
    pub random: sys::Random
    pub classes: Array[u8, 4]
    pub system: ident::Cause
} Config

/// The header of the runner's own work.
fn Config.work(self) -> os::Header = os::Header.of_work(cause: self.system.bits, slot: 0)

/// The latest UTC the wall time `time` may be, in nanoseconds: its time plus its uncertainty.
fn latest(time: ident::WallTime) -> i64 = time.utc_ns.saturating_add(i64.saturate(time.uncertainty_ns))

/// The executor's share serving an instance's share: its class, its weight, and the part of a CPU its reservation takes in millionths.
fn Config.share(self, share: os::Share) -> task::Share {
    let class = match share.class {
        os::CpuClass.Latency => self.classes[0]
        os::CpuClass.Normal => self.classes[1]
        os::CpuClass.Background => self.classes[2]
    }
    return task::Share(weight: u32.widen(share.weight), class: class, reserve_ppm: u32.fit(share.reserved_ppm()))
} Config.share

/// What the runner starts from: the specification of each instance it may create, by moniker, and every live grant, by number.
pub closed struct Known {
    pub specs: mem::Map[ident::Moniker, os::InstanceSpec]
    pub grants: mem::Map[u64, os::Grant]
} Known

/// What the core holds while the runner runs: a `Control` over every instance, the directory its ports reach instances through, and where it sends revocations.
pub open struct Core {
    pub control: os::Control
    directory: task::Cown[Directory]
    revocations: task::Sender[Revocation]
    alloc: mem::Alloc
} Core

/// A port minted for the core to the instance `moniker`, with the credit `credit`; `None` when it has no specification.
pub fn Core.port(self, moniker: ident::Moniker, credit: os::Credit) -> Option[os::MintedPort] fails task::Cancelled uses wait {
    let alloc = self.alloc
    let directory = self.directory.share()
    return await when directory => directory.mint(moniker, credit, alloc)
} Core.port

/// Revokes the grant `grant` and every live grant descending from it, returning their numbers once they have left the live grants and every capability minted from them is stale; none when `grant` is not live.
pub fn Core.revoke(self, grant: u64) -> mem::Set[u64] fails task::Cancelled uses wait {
    return try await ask(self.revocations, grant, reason: Reason.Revoke, alloc: self.alloc)
} Core.revoke

/// A revocation of the grant `grant` and its descendants for `reason`, and where their numbers go once it is carried out.
struct Revocation {
    grant: u64
    reason: Reason
    done: task::Sender[mem::Set[u64]]
} Revocation

/// Has the runner revoke the grant `grant` and its descendants for `reason`, returning their numbers once it has.
fn ask(revocations: task::Sender[Revocation], grant: u64, reason: Reason, alloc: mem::Alloc) -> mem::Set[u64] fails task::Cancelled uses wait {
    let task::Channel(sender: done, receiver: answer) = task::Channel[mem::Set[u64]].bounded(1, alloc)
    match attempt await revocations.send(Revocation(grant: grant, reason: reason, done: take done)) {
        Ok(_) => {
        }
        Err(task::SendError.Closed) => return mem::Set.empty(alloc)
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
    }
    var receiver = answer
    let Some(revoked) = try await mut receiver.receive() else {
        return mem::Set.empty(alloc)
    }
    return revoked
} ask

/// Runs the instances `known` describes, and those `Control` orders create, until `body` returns, then ends them, as work of the boot's system cause, `body`'s included: each has a driver carrying out its lifecycle and publishing its record through `postings` and the gauge of its running incarnation through `gauges`, an intake taking the calls of its ports and an endpoint in the directory worlds draw on, and `body` holds the core's `Control` over every instance. Grants past their expiry leave before any capability is minted, and the others once it passes. The handler calls of the instances each set `tracings` gives names are traced, each until it expires. Each rise of the pressure level of the pool `machine` tells relieves it.
pub fn run[C: Components and Copy and Send, J: Journal and Send, R: Machine and Send, T: Send, E: Send](
    take known: Known,
    components: C,
    journal: J,
    take machine: R,
    config: Config,
    postings: task::Sender[os::Posting],
    logs: task::Sender[journal::Logged],
    gauges: Gauges,
    take tracings: task::Receiver[mem::List[journal::TracedInstance]],
    body: fn(core: Core) -> T fails E uses wait limits stack 16_384,
    ) -> Option[T] fails E uses wait {
    let alloc = config.alloc
    let Ok(withheld) = attempt Withheld.of(config.clock, alloc) else {
        return None
    }
    let task::Channel(sender: orders, receiver: ordered) = task::Channel[os::Order].bounded(QUEUED_ORDERS, alloc)
    let task::Channel(sender: revocations, receiver: revoking) = task::Channel[Revocation].bounded(QUEUED_ORDERS, alloc)
    let Known(specs: specs, grants: grants) = known
    var listed = Directory(grants: take grants, endpoints: mem::Map.empty(alloc), roles: mem::Map.empty(alloc))
    var drivers = mem::List[Started].empty(alloc)
    for entry in take specs {
        let mem::KeyValue(key: moniker, value: spec) = entry
        let Some(started) = mut listed.add(take moniker, take spec, components, slot: u32.fit(drivers.len() + 1), alloc) else {
            continue
        }
        mut drivers.push(take started)
    }
    let expired = mut listed.expire(reached: latest(config.wall.now(config.clock)), alloc)
    for number in expired {
        journal.record(0, cause: 0, event: Event.Revoked(grant: number, reason: Reason.Expiry))
    }
    let directory = task::Cown.of(take listed, alloc)
    let reached = directory.share()
    let routes = task::Cown.of(mem::Map[ident::Moniker, task::Sender[Input]].empty(alloc), alloc)
    let traced = task::Cown.of(mem::List[journal::TracedInstance].empty(alloc), alloc)
    let shared = Shared[C, R](components: components, machine: take machine, reservations: task::Cown.of(Reservations.of(config.cpus, alloc), alloc), config: config, directory: take directory, orders: orders.split(), withheld: withheld, postings: postings.split(), logs: logs.split(), gauges: gauges.share(), traced: traced.share())
    let core = os::MintedControl.of(orders, grant: None, prefix: None, alloc)
    defer take core.close()
    var result: Option[T] = None
    var waiting = Some(Waiting(drivers: take drivers, ordered: take ordered, revoking: take revoking, tracing: take tracings))
    defer abandon(take waiting)
    try await sys::run_headed(config.work().carried(), body: fn[mut result, mut waiting]() fails E uses wait {
        try await task::scope(config.exec, body: fn[mut result, mut waiting](s: task::Scope) fails E uses wait {
            let Some(Waiting(drivers: started, ordered: orders_in, revoking: revoking_in, tracing: tracing_in)) = mut waiting.extract() else {
                return
            }
            let governed = routes.share()
            discard s.spawn(fn[take started, take orders_in, take governed]() fails task::Cancelled uses wait limits stack 81_920 {
                try await shared.govern(take started, orders: take orders_in, routes: governed, journal)
            })
            let revoked = reached.share()
            let revoking_routes = routes.share()
            discard s.spawn(fn[take revoking_in, take revoked, take revoking_routes]() fails task::Cancelled uses wait limits stack 16_384 {
                try await revoke(take revoking_in, routes: revoking_routes, directory: revoked, journal, alloc)
            })
            let tracing_routes = routes.share()
            let tracing_set = traced.share()
            discard s.spawn(fn[take tracing_in, take tracing_routes, take tracing_set]() fails task::Cancelled uses wait limits stack 16_384 {
                try await trace(take tracing_in, routes: tracing_routes, traced: tracing_set, config)
            })
            let relieved = routes.share()
            discard s.spawn(fn[take relieved]() fails task::Cancelled uses wait limits stack 16_384 {
                try await shared.relieve(routes: relieved)
            })
            let timed = reached.share()
            let expiries = revocations.split()
            discard s.spawn(fn[take timed, take expiries]() fails task::Cancelled uses wait limits stack 16_384 {
                try await expire_deferred(take expiries, directory: timed, config)
            })
            let control = core.mint(os::ControlRights(read: true, lifecycle: true, spawn: true, reserved: 0))
            result = Some(try await body(Core(control: control, directory: reached.share(), revocations: revocations.split(), alloc: alloc)))
            s.cancel()
        })
    })
    return result
} run

/// The calls a driver's intake holds before it takes them, the inputs it holds, and the orders the runner holds before it routes them.
const QUEUED_CALLS: usize = 64

const QUEUED_INPUTS: usize = 64

const QUEUED_ORDERS: usize = 16

/// A driver before it runs, with the channels of its inputs and of its intake.
linear struct Started {
    driver: Driver
    inputs: task::Sender[Input]
    taken: task::Receiver[Input]
    calls: task::Receiver[os::Call]
} Started

/// What the runner's scope takes once: the drivers, the orders to carry out, the revocations, and the instances to trace.
linear struct Waiting {
    drivers: mem::List[Started]
    ordered: task::Receiver[os::Order]
    revoking: task::Receiver[Revocation]
    tracing: task::Receiver[mem::List[journal::TracedInstance]]
} Waiting

/// Releases the drivers that never ran.
fn abandon(take waiting: Option[Waiting]) {
    match waiting {
        Some(left) => {
            let Waiting(drivers: drivers, ordered: _, revoking: _, tracing: _) = left
            for each in take drivers {
                let Started(driver: driver, inputs: _, taken: _, calls: _) = each
                take driver.abandon()
            }
        }
        None => {
        }
    }
} abandon

/// Carries out each revocation in turn: its grants leave the live grants, every driver `routes` reaches revokes the root entries it holds of them, and each removal is recorded as the core's, before their numbers are answered.
fn revoke[J: Journal](
    take revocations: task::Receiver[Revocation],
    routes: task::Cown[mem::Map[ident::Moniker, task::Sender[Input]]],
    directory: task::Cown[Directory],
    journal: J,
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    var receiver = revocations
    loop {
        let Some(Revocation(grant: grant, reason: reason, done: done)) = try await mut receiver.receive() else {
            return
        }
        let revoked = await when mut directory => mut directory.revoke(grant, alloc)
        let drivers = await when routes => routed(routes, alloc)
        if revoked.len() > 0 and drivers.len() > 0 {
            let task::Channel(sender: closed, receiver: acknowledged) = task::Channel[Unit].bounded(drivers.len(), alloc)
            var asked: usize = 0
            for driver in drivers {
                match attempt await driver.inputs.send(Input.Revoke(grants: copy_of(revoked, alloc), done: closed.split())) {
                    Ok(_) => {
                        asked += 1
                    }
                    Err(task::SendError.Closed) => {
                    }
                    Err(task::SendError.Cancelled(cancelled)) => fail cancelled
                }
            }
            var acknowledgements = acknowledged
            for _ in 0..<asked {
                discard try await mut acknowledgements.receive()
            }
        }
        for number in revoked {
            journal.record(0, cause: 0, event: Event.Revoked(grant: number, reason: reason))
        }
        discard attempt await done.send(take revoked)
    }
} revoke

/// Keeps each set of traced instances in `traced`, for the drivers launched after it, and tells every driver `routes` reaches until when its instance is traced.
fn trace(take tracings: task::Receiver[mem::List[journal::TracedInstance]], routes: task::Cown[mem::Map[ident::Moniker, task::Sender[Input]]], traced: task::Cown[mem::List[journal::TracedInstance]], config: Config) fails task::Cancelled uses wait {
    var receiver = tracings
    loop {
        let Some(instances) = try await mut receiver.receive() else {
            return
        }
        var given = Some(take instances)
        await when mut traced {
            match mut given.extract() {
                Some(set) => {
                    traced = set
                }
                None => {
                }
            }
        }
        let drivers = await when routes => routed(routes, alloc: config.alloc)
        for driver in drivers {
            let until = await when traced => traced_until(traced, moniker: driver.moniker, config)
            match attempt await driver.inputs.send(Input.Trace(until_ns: until)) {
                Err(task::SendError.Cancelled(cancelled)) => fail cancelled
                else => {
                }
            }
        }
    }
} trace

/// The monotonic time until which `traced` traces the instance `moniker`, `None` when it does not or its expiry has passed.
fn traced_until(traced: mem::List[journal::TracedInstance], moniker: ident::Moniker, config: Config) -> Option[u64] {
    for instance in traced {
        if instance.moniker != moniker {
            continue
        }
        let left = instance.expires.utc_ns.saturating_sub(config.wall.now(config.clock).utc_ns)
        if left <= 0 {
            return None
        }
        return Some(now(config.clock).saturating_add(u64.saturate(left)))
    }
    return None
} traced_until

/// A driver `routes` reaches, and its instance.
struct Routed {
    moniker: ident::Moniker
    inputs: task::Sender[Input]
} Routed

fn routed(routes: mem::Map[ident::Moniker, task::Sender[Input]], alloc: mem::Alloc) -> mem::List[Routed] {
    var drivers = mem::List[Routed].empty(alloc)
    for route in routes {
        mut drivers.push(Routed(moniker: ident::Moniker(text: route.key().text), inputs: route.value().split()))
    }
    return drivers
} routed

/// Runs `expire` on an account of core work whose timers never wake an idle machine, so that an expiry passing while it idles revokes at its next wake-up.
fn expire_deferred(take revocations: task::Sender[Revocation], directory: task::Cown[Directory], config: Config) fails task::Cancelled uses wait {
    let account = config.exec.split(task::Share(weight: 1, class: config.classes[3], reserve_ppm: 0))
    defer take account.close()
    var pending = Some(take revocations)
    try await task::scope(account.executor(), body: fn[mut pending](s: task::Scope) {
        let Some(asked) = mut pending.extract() else {
            return
        }
        let timed = directory.share()
        discard s.spawn(fn[take asked, take timed]() fails task::Cancelled uses wait limits stack 16_384 {
            try await expire(take asked, directory: timed, config)
        })
    })
} expire_deferred

/// Revokes each live grant once the latest the wall time may be reaches its expiry, sleeping until the earliest expiry among live grants; it ends once no live grant expires.
fn expire(take revocations: task::Sender[Revocation], directory: task::Cown[Directory], config: Config) fails task::Cancelled uses wait {
    loop {
        let Some(next) = await when directory => directory.earliest() else {
            return
        }
        let reached = latest(config.wall.now(config.clock))
        if next.at > reached {
            try await config.clock.sleep_ns(u64.saturate(next.at.saturating_sub(reached)))
            continue
        }
        discard try await ask(revocations, grant: next.grant, reason: Reason.Expiry, alloc: config.alloc)
    }
} expire

fn copy_of(numbers: mem::Set[u64], alloc: mem::Alloc) -> mem::Set[u64] {
    var copy = mem::Set[u64].empty(alloc)
    for number in numbers {
        discard mut copy.insert(number)
    }
    return copy
} copy_of

/// Passes each call of an intake to its driver, in order.
fn forward(take calls: task::Receiver[os::Call], take inputs: task::Sender[Input]) fails task::Cancelled uses wait {
    var receiver = calls
    loop {
        let Some(call) = try await mut receiver.receive() else {
            return
        }
        if (attempt await inputs.send(Input.Call(take call))).is_err() {
            return
        }
    }
} forward
