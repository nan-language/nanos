//! Instances of a bundle's components: the admission record describing each one's component, and the task of its domain, which reads the image of its bundle at each start and drives the instance the kernel holds for it as `Driven.run` drives a component of the kernel image.

/// A bundle's component as the runner runs it: the name of the entry its bundle exports it under, the protocol it serves, its state schema and the frozen shapes its state's forward migrations convert from, the names of its operations by number, whether its Env takes a configuration record, the View of `/sys/code` its starts read its bundle's image through, `None` while `store` has no endpoint, and the encoding of the protocol schema its bundle gives for it once an incarnation told it.
struct Hosted {
    entry: text::String
    protocol: sys::ProtocolHash
    schema: ident::HashValue
    migrations: mem::List[ident::HashValue]
    operations: mem::List[text::String]
    configured: bool
    code: Option[store::service::View]
    served: Option[mem::Bytes]
} Hosted

/// The longest an instance started by an update waits for a message before its holder looks for a health probe to run, in nanoseconds; such an instance is never suspended.
const PROBED_WAIT_NS: u64 = 1_000_000_000

/// What an instance of a bundle's component takes from its driver before the kernel holds it: what the driver serves it, the protocol its component serves and the names of its operations by number, the encoding of the protocol schema its bundle gives for it, the executor and allocator of its domain, and the runner capability its component hands the replies to postponed requests through, with the queue of those replies, their signal and whether a checkpoint is asked for.
pub open linear struct Hosting {
    serving: Serving
    protocol: sys::ProtocolHash
    operations: mem::List[text::String]
    served: Option[mem::Bytes]
    exec: task::Executor
    alloc: mem::Alloc
    replier: sys::Minter[Replier, Pending, u8]
    replies: mem::Shared[hw::SpinLock[mem::Bounded[Handed, QUEUED_REPLIES]]]
    signal: mem::Shared[hw::Signal[Unit]]
    syncing: mem::Shared[core::atomic::AtomicBool]
} Hosting

/// The component `component` of the bundle the admission record `record` describes, a type of its root module whose name is its entry; `None` when the record lists no such component.
validator fn hosted_in(record: Untrusted[Slice[u8]], component: Str, alloc: mem::Alloc) -> Option[Hosted] {
    let Ok(admission) = attempt mem::wire::Codec[code::Admission].decode(record, alloc) else {
        return None
    }
    var root = text::String.of(admission.root.as_str(), alloc)
    mut root.append("::")
    if not component.starts_with(root.as_str()) {
        return None
    }
    let Some(entry) = component.slice_bytes(root.byte_len(), end: component.byte_len()) else {
        return None
    }
    for described in admission.components {
        if described.state.as_str() != component {
            continue
        }
        var operations = mem::List[text::String].empty(alloc)
        for operation in described.operations {
            mut operations.push(text::String.of(operation.name.as_str(), alloc))
        }
        var migrations = mem::List[ident::HashValue].empty(alloc)
        for shape in described.migrations {
            mut migrations.push(shape.schema)
        }
        return Some(Hosted(entry: text::String.of(entry, alloc), protocol: sys::ProtocolHash(bytes: described.protocol.bytes), schema: described.schema, migrations: take migrations, operations: take operations, configured: described.config.is_some(), code: None, served: None))
    }
    return None
} hosted_in

/// The component of `spec` as its bundle's admission record describes it, read on a task of its own through a View of `/sys/code` minted for the read; `None` for a spec of the base bundle, `Invalid` when no admitted bundle has the component.
fn Shared.bundled(self, spec: os::InstanceSpec) -> Result[Option[mem::Box[Hosted]], os::ControlError] fails task::Cancelled uses wait {
    if spec.bundle == self.config.base {
        return Ok(None)
    }
    let alloc = self.config.alloc
    let directory = self.directory.share()
    let minted = await when directory => directory.code_view(alloc)
    var granted = match minted {
        Some(view) => view
        None => return Err(os::ControlError.Invalid)
    }
    defer take granted.close()
    let codes = granted.view.mint(store::service::Rights.reading())
    let bundle = spec.bundle
    let component = text::String.of(spec.component.as_str(), alloc)
    let task::Channel(sender: reader, receiver: answers) = task::Channel[Result[Hosted, os::ControlError]].bounded(1, alloc)
    var given = Some(AdmissionRead(told: take reader, component: take component))
    try await task::scope(self.config.exec, body: fn[mut given](s: task::Scope) {
        let Some(AdmissionRead(told: sender, component: path)) = mut given.extract() else {
            return
        }
        discard s.spawn(fn[take sender, take path]() fails task::Cancelled uses wait limits stack 65_536 {
            let read = try await hosted_of(codes, bundle, component: path.as_str(), alloc)
            discard attempt await sender.send(take read)
        })
    })
    var receiver = answers
    return match try await mut receiver.receive() {
        Some(Ok(hosted)) => Ok(Some(mem::Heap.of(alloc).boxed(take hosted)))
        Some(Err(failure)) => Err(take failure)
        None => Err(os::ControlError.Invalid)
    }
} Shared.bundled

/// What the task reading an admission record takes: where it tells the component it read, and the canonical path of the component's state type.
struct AdmissionRead {
    told: task::Sender[Result[Hosted, os::ControlError]]
    component: text::String
} AdmissionRead

/// A View of `/sys/code` on `main` reading for `system`, with the port and root it is minted from; `None` while `store` has no endpoint.
fn Directory.code_view(self, alloc: mem::Alloc) -> Option[GrantedView] {
    return self.system_view(prefix: "/sys/code", grant: CODE_GRANT, alloc)
} Directory.code_view

/// A View of `prefix` on `main` reading and writing for `system`, with the port and root it is minted from under the grant number `grant`; `None` while `store` has no endpoint.
fn Directory.system_view(self, prefix: Str, grant: u64, alloc: mem::Alloc) -> Option[GrantedView] {
    let Some(endpoint) = self.endpoints.get(ident::Moniker(text: text::Fixed[59].of(STORE_MONIKER))) else {
        return None
    }
    let port = os::MintedPort.of(endpoint.intake, gate: endpoint.gate, protocols: endpoint.protocols, operations: None, credit: os::Credit(messages: 1, calls: 1), clock: self.clock, alloc)
    let root = store::service::MintedView.of(store: port.handle(), prefix: ident::Path(text: text::String.of(prefix, alloc)), branch: "main", redirect: None, principal: ident::Principal(text: text::Fixed[64].of("system")), instance: None, alloc)
    return Some(GrantedView(grant: grant, port: take port, view: take root))
} Directory.system_view

/// The component `component` of the bundle of code hash `bundle` as its admission record, read through `code`, a View of `/sys/code`, describes it; `Invalid` when no admitted bundle has the component.
fn hosted_of(code: store::service::View, bundle: ident::HashValue, component: Str, alloc: mem::Alloc) -> Result[Hosted, os::ControlError] fails task::Cancelled uses wait {
    var path = text::String.of("/", alloc)
    mut path.append(bundle.full_form().as_str())
    mut path.append("/admission")
    let node = match first attempt await code.get(ident::Path(text: take path), at: None, alloc) {
        Ok(found) => found
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return Err(os::ControlError.Invalid)
    }
    let Some(value) = node.value else {
        return Err(os::ControlError.Invalid)
    }
    return match hosted_in(value.view(), component, alloc) {
        Some(hosted) => Ok(take hosted)
        None => Err(os::ControlError.Invalid)
    }
} hosted_of

/// The protocols the instance of `spec` serves: those of its bundle's component as `hosted` describes it, else those `components` gives for its component.
fn protocols_of[C: Components](components: C, spec: os::InstanceSpec, hosted: Option[mem::Box[Hosted]]) -> Option[os::Protocols] {
    return match hosted {
        Some(described) => Some(os::Protocols(own: described.contents().protocol, serves: None))
        None => components.protocols(spec.component.as_str())
    }
} protocols_of

/// Whether a fork of the instance holds no resource: never for a bundle's component, which forks do not run.
fn Driver.forkable[C: Components](self, components: C) -> bool {
    return self.hosted.is_none() and components.forkable(self.spec.component.as_str())
} Driver.forkable

/// Whether the instance's flight recorder can be armed: its component is a bundle's or forkable.
fn Driver.recordable[C: Components](self, components: C) -> bool {
    return self.hosted.is_some() or self.forkable(components)
} Driver.recordable

/// Whether the Env of the instance's component takes a configuration record.
fn Driver.configured[C: Components](self, components: C) -> bool {
    return match self.hosted {
        Some(described) => described.contents().configured
        None => components.configured(self.spec.component.as_str())
    }
} Driver.configured

/// Has the driver of a job or of a bundle's component read its bundle's images through a View of `/sys/code` reading for `system`, minted from the directory.
fn Directory.read_code(self, mut driver: Driver, alloc: mem::Alloc) {
    let code = self.own_view(mut driver.minted, grant: CODE_GRANT, prefix: "/sys/code", branch: "main", rights: store::service::Rights.reading(), moniker: ident::Moniker(text: driver.moniker.text), principal: ident::Principal(text: text::Fixed[64].of("system")), alloc)
    match mut driver.hosted.extract() {
        Some(described) => {
            var reading = take described.into_contents()
            reading.code = code
            driver.hosted = Some(mem::Heap.of(alloc).boxed(take reading))
        }
        None => {
        }
    }
    match mut driver.job.extract() {
        Some(job) => {
            var reading = take job.into_contents()
            reading.code = code
            driver.job = Some(mem::Heap.of(alloc).boxed(take reading))
        }
        None => {
        }
    }
} Directory.read_code

/// Keeps a copy of `encoded`, the encoding of the protocol schema the bundle gives for the instance's component.
fn Driver.described_hosted(mut self, encoded: Slice[u8]) {
    let Some(described) = mut self.hosted.extract() else {
        return
    }
    var hosted = take described.into_contents()
    var kept = mem::Bytes.empty(self.alloc)
    mut kept.append(encoded)
    hosted.served = Some(take kept)
    self.hosted = Some(mem::Heap.of(self.alloc).boxed(take hosted))
} Driver.described_hosted

/// The protocol schema the bundle of the instance's component gives for it, when it serves the instance's protocol; `None` for a component of the kernel image or before an incarnation told it.
fn Driver.served_schema(self) -> Option[sys::ProtocolSchema] {
    let Some(described) = self.hosted else {
        return None
    }
    let hosted = described.contents()
    let Some(encoded) = hosted.served else {
        return None
    }
    let Ok(schema) = attempt mem::wire::Codec[sys::ProtocolSchema].decode(Untrusted.of(encoded.view()), alloc: self.alloc) else {
        return None
    }
    if schema.hash != hosted.protocol {
        return None
    }
    return Some(take schema)
} Driver.served_schema

/// What the first task of a start of the instance's domain runs the bundle's component from; `None` for a component of the kernel image.
fn Driver.bundled(self) -> Option[mem::Box[Bundled]] {
    let Some(described) = self.hosted else {
        return None
    }
    let hosted = described.contents()
    return Some(mem::Heap.of(self.alloc).boxed(Bundled(code: hosted.code, bundle: self.spec.bundle, entry: text::String.of(hosted.entry.as_str(), alloc: self.alloc), protocol: hosted.protocol, operations: names_in(hosted.operations, alloc: self.alloc))))
} Driver.bundled

/// What the first task of the domain of an instance of a bundle's component runs it from: a View of `/sys/code` reading the image of the bundle of code hash `bundle`, `None` while `store` has no endpoint, the name of the entry it exports the component under, the protocol it serves and the names of its operations by number.
struct Bundled {
    code: Option[store::service::View]
    bundle: ident::HashValue
    entry: text::String
    protocol: sys::ProtocolHash
    operations: mem::List[text::String]
} Bundled

/// What an instance of a bundle's component takes from its driver, `serving`, with the protocol its component serves, the names of its operations by number, and the executor and allocator of its domain.
pub fn Hosting.of(
    take serving: Serving,
    protocol: sys::ProtocolHash,
    take operations: mem::List[text::String],
    exec: task::Executor,
    alloc: mem::Alloc,
    ) -> Hosting {
    let syncing = mem::Shared.of(core::atomic::AtomicBool.of(false), alloc)
    let pending = Pending(replies: mem::Shared.of(hw::SpinLock.of(mem::Bounded[Handed, QUEUED_REPLIES].empty()), alloc), signal: mem::Shared.of(hw::Signal[Unit].empty(), alloc), keeps: serving.keeping.is_some(), syncing: syncing.share(), alloc: alloc)
    let replies = pending.replies.share()
    let signal = pending.signal.share()
    return Hosting(serving: take serving, protocol: protocol, operations: take operations, served: None, exec: exec, alloc: alloc, replier: sys::Minter[Replier, Pending, u8].of(take pending, alloc), replies: take replies, signal: take signal, syncing: take syncing)
} Hosting.of

/// Keeps `served`, the protocol schema the bundle gives for the component, for the driver.
pub fn Hosting.describe(mut self, served: Option[sys::ProtocolSchema]) {
    let Some(schema) = served else {
        return
    }
    var bytes = mem::Bytes.empty(self.alloc)
    mem::wire::Codec[sys::ProtocolSchema].encode(schema, out: mut bytes)
    self.served = Some(take bytes)
} Hosting.describe

/// The runner capability the component hands its replies and summaries through, denied once revoked.
pub fn Hosting.runner(self) -> sys::Runner {
    return match attempt sys::Runner.served(self.replier.mint(0)) {
        Ok(runner) => runner
        Err(_) => sys::Runner.denied()
    }
} Hosting.runner

/// The state the instance restores with its schema, `None` for a start; a later call gives `None`.
pub fn Hosting.take_checkpoint(mut self) -> Option[nanos::Checkpoint] {
    let Some(saved) = mut self.serving.restore.extract() else {
        return None
    }
    let os::Checkpoint(number: _, incarnation: _, bundle: _, schema: schema, time: _, state: state) = saved
    return Some(nanos::Checkpoint(schema: mem::wire::SchemaHash(bytes: schema.bytes), bytes: take state))
} Hosting.take_checkpoint

/// Revokes the runner capability of an instance the kernel never held.
pub fn Hosting.close(take self) {
    let Hosting(serving: _, protocol: _, operations: _, served: _, exec: _, alloc: _, replier: replier, replies: _, signal: _, syncing: _) = self
    take replier.close()
} Hosting.close

/// Runs the instance `instance` of the bundle's component as `Driven.run` runs one of the kernel image: resumes it, ends it at once when its health is not `Healthy`, then serves what its driver delivers, one call at a time, suspending it after the time without a message the driver sets and keeping its checkpoints. Told to stop, it handles every message that waits, keeps a checkpoint when the state is dirty, and ends the instance. Orders for its holder are refused. How the instance ended, or the trap that abandoned its domain.
pub fn Hosting.run(take self, take instance: nanos::Instance) -> Result[Ended, sys::Trap] fails task::Cancelled uses wait {
    let Hosting(serving: serving, protocol: protocol, operations: operations, served: served, exec: exec, alloc: alloc, replier: replier, replies: replies, signal: signal, syncing: syncing) = self
    defer take replier.close()
    let Serving(deliveries: deliveries, reports: reports, marks: marks, incarnation: incarnation, clock: clock, abandoner: _, suspend_ms: suspend_ms, keeping: keeping, restore: restore, revival: _, updated: updated, replay: replay, config: _, forking: _, recorder: recorder) = serving
    var held = instance
    defer take held.abandon()
    let steps = mem::Shared.of(Steps(begun: core::atomic::AtomicU64.of(0), done: core::atomic::AtomicU64.of(0), wanted: core::atomic::AtomicU64.of(0), deadline: core::atomic::AtomicU64.of(os::NO_DEADLINE), posted: hw::SpinLock.of(None), operations: take operations), alloc)
    let task::Channel(sender: finished, receiver: finishes) = task::Channel[u64].bounded(1, alloc)
    let telling = Telling(reports: reports.split(), marks: marks.split(), steps: steps.share(), finished: take finished, clock: clock, incarnation: incarnation, recorder: take recorder, alloc: alloc)
    let restored: Option[u64] = match restore {
        Some(saved) => Some(saved.number)
        None => None
    }
    let began = try await begin_replayed(mut held, take replay, restored: restored.is_some(), updated, exec, telling, alloc)
    if began {
        match served {
            Some(encoded) => try await tell(reports, incarnation, report: Report.Described(schema: take encoded))
            None => {
            }
        }
        try await tell(reports, incarnation, report: Report.Running(from: started_from(restored, revival: false, updated), operations: names_in(steps.contents().operations, alloc)))
        let inbox = held.inbox()
        let quiet = mem::Shared.of(core::atomic::AtomicU64.of(u64.widen(suspend_ms)), alloc)
        let probe = mem::Shared.of(core::atomic::AtomicBool.of(false), alloc)
        var given = Some(HostedGiven(deliveries: take deliveries, finishes: take finishes))
        var due_at = epoch_after(keeping, clock)
        let looped = attempt await task::scope(exec, body: fn[mut held, mut given, mut due_at](s: task::Scope) fails Stopping uses wait {
            let Some(HostedGiven(deliveries: receiver, finishes: finishing)) = mut given.extract() else {
                return
            }
            let sending = reports.split()
            let counted = steps.share()
            let setting = quiet.share()
            let probing = probe.share()
            discard s.spawn(fn[take receiver, take finishing, take sending, take counted, take setting, take probing]() fails Stopping uses wait limits stack 40_960 {
                try await dispatch_hosted(inbox, deliveries: take receiver, steps: counted, finishes: take finishing, reports: sending, incarnation, quiet: setting, probe: probing, alloc)
            })
            let answering = reports.split()
            let queued = replies.share()
            let ringing = signal.share()
            discard s.spawn(fn[take answering, take queued, take ringing]() fails task::Cancelled uses wait limits stack 16_384 {
                try await hand_over(queued, signal: ringing, reports: answering, incarnation)
            })
            match attempt await hold_hosted(mut held, keeping, mut due_at, syncing: syncing.contents(), quiet: quiet.contents(), probe: probe.contents(), updated, protocol, telling) {
                Ok(_) => {
                }
                Err(nanos::InstanceError.Ended) => fail Stopping.Ended
                Err(nanos::InstanceError.Cancelled(cancelled)) => fail Stopping.Cancelled(take cancelled)
            }
        })
        match looped {
            Err(Stopping.Cancelled(cancelled)) => fail cancelled
            Err(Stopping.Asked(hand: hand)) => {
                match attempt await stop_hosted(mut held, keeping, dirty: due_at.is_some(), hand, protocol, telling) {
                    Err(nanos::InstanceError.Cancelled(cancelled)) => fail cancelled
                    else => {
                    }
                }
            }
            else => {
            }
        }
    }
    undefer held
    return match try await take held.end() {
        nanos::Ended.Returned(_) or nanos::Ended.Cancelled or nanos::Ended.Abandoned => Ok(match began {
            true => Ended.Stopped
            false => Ended.Unhealthy
        })
        nanos::Ended.Failed(_) => Ok(Ended.EnvIncomplete)
        nanos::Ended.Undecodable => Ok(Ended.CheckpointUndecodable)
        nanos::Ended.Trapped(trap) => Err(take trap)
    }
} Hosting.run

/// What the dispatcher of a bundle's instance takes: the calls its driver delivers and the counts of finished steps the holder signals.
struct HostedGiven {
    deliveries: task::Receiver[Delivery]
    finishes: task::Receiver[u64]
} HostedGiven

/// Calls the instance's `resume`, with reason `Updated` for an update and `Restored` when it restored a checkpoint, starts its keyed tasks and asks its health; whether it is healthy.
fn begin_hosted(mut instance: nanos::Instance, restored: bool, updated: bool, telling: Telling) -> bool fails nanos::InstanceError uses wait {
    let started = match restored {
        true => sys::ResumeReason.Restored
        false => sys::ResumeReason.Started
    }
    let reason = resumed_for(started, revival: false, updated)
    let resuming = telling.begin(call: SystemCall.Resume)
    try await mut instance.resumed(reason)
    telling.end_system(resuming)
    discard try await mut instance.start_keyed()
    let probing = telling.begin(call: SystemCall.Health)
    let health = try await mut instance.health()
    telling.end_system(probing)
    return match health {
        sys::HealthReply.Healthy => true
        sys::HealthReply.Unhealthy(_) => false
    }
} begin_hosted

/// Serves each call delivered to the instance through `inbox`, one at a time and in order, until told to stop, keeping in `quiet` the time without a message after which it is suspended, setting `probe` for each health probe ordered and refusing each other order for its holder.
fn dispatch_hosted(
    inbox: nanos::Inbox,
    take deliveries: task::Receiver[Delivery],
    steps: mem::Shared[Steps],
    take finishes: task::Receiver[u64],
    reports: task::Sender[Input],
    incarnation: u64,
    quiet: mem::Shared[core::atomic::AtomicU64],
    probe: mem::Shared[core::atomic::AtomicBool],
    alloc: mem::Alloc,
    ) fails Stopping uses wait {
    var receiver = deliveries
    var signals = finishes
    loop {
        let Some(delivery) = try await mut receiver.receive() else {
            fail Stopping.Asked(hand: false)
        }
        match delivery {
            Delivery.Call(id: id, hash: hash, encoded: encoded, request: request, header: header, deadline: deadline) => {
                let counts = steps.contents()
                counts.deadline.store(deadline)
                let work = header.dispatched(deadline).handled_by(os::Header.current().sender)
                counts.post(Some(Posted(header: work.carried(), taken: Taken.encoded(header, encoding: encoded.bytes.view(), request, operation: counts.operation_of(encoded.bytes.view(), alloc)))))
                var call = Some(take encoded)
                let outcome = attempt await sys::run_headed(work.carried(), body: fn[mut call]() -> Option[sys::Encoded] fails sys::CallError[Never] uses wait {
                    let Some(given) = mut call.extract() else {
                        return None
                    }
                    return try await inbox.call(hash, request: id, encoding: take given, alloc)
                })
                counts.post(None)
                try await settle_call(take outcome, id, request, steps: counts, mut signals, reports, incarnation)
                counts.deadline.store(os::NO_DEADLINE)
            }
            Delivery.SuspendAfter(ms: ms) => quiet.contents().store(u64.widen(ms))
            Delivery.Hold(order: order) => {
                match order {
                    HolderOrder.Health => probe.contents().store(true)
                    else => try await take order.refuse()
                }
            }
            Delivery.Stop(hand: hand) => fail Stopping.Asked(hand: hand)
        }
    }
} dispatch_hosted

/// Holds the instance until its domain ends or the task is cancelled: waits for its messages, suspending it after `quiet` without one, and calls their handlers. With `keeping`, a checkpoint falls due at `due_at`, an epoch after the first handler call since the last checkpoint or the failure of one, at once when a handler asked for one through `syncing`, and is kept once the instance is idle.
fn hold_hosted(
    mut instance: nanos::Instance,
    keeping: Option[Keeping],
    mut due_at: Option[u64],
    syncing: core::atomic::AtomicBool,
    quiet: core::atomic::AtomicU64,
    probe: core::atomic::AtomicBool,
    updated: bool,
    protocol: sys::ProtocolHash,
    telling: Telling,
    ) fails nanos::InstanceError uses wait {
    let clock = telling.clock
    loop {
        if syncing.swap(false) {
            due_at = Some(now(clock))
        }
        if probe.swap(false) {
            let probing = telling.begin(call: SystemCall.Health)
            let health = try await mut instance.health()
            telling.end_system(probing)
            let healthy = match health {
                sys::HealthReply.Healthy => true
                sys::HealthReply.Unhealthy(_) => false
            }
            match attempt await telling.tell(report: Report.Health(healthy: healthy)) {
                Err(cancelled) => fail nanos::InstanceError.Cancelled(take cancelled)
                Ok(_) => {
                }
            }
        }
        match first keeping {
            Some(kept) if due_at.is_some() => {
                let until_due = due_at.value_or(0).saturating_sub(now(clock))
                let bound = match updated {
                    true => until_due.min(PROBED_WAIT_NS)
                    false => until_due
                }
                let arrived = try await task::within_ns(clock, ns: bound, body: fn() fails nanos::InstanceError uses wait {
                    try await instance.incoming()
                })
                if arrived.is_none() and not try await instance.ready() {
                    if bound == until_due {
                        due_at = try await due_after_keeping(instance, kept, keeping, telling)
                    }
                    continue
                }
            }
            else => {
                if updated {
                    let arrived = try await task::within_ns(clock, ns: PROBED_WAIT_NS, body: fn() fails nanos::InstanceError uses wait {
                        try await instance.incoming()
                    })
                    if arrived.is_none() {
                        continue
                    }
                } else {
                    try await idle_hosted(mut instance, quiet, telling)
                }
            }
        }
        if try await step_hosted(mut instance, protocol, telling) and due_at.is_none() {
            due_at = epoch_after(keeping, clock)
        }
    }
} hold_hosted

/// Keeps a checkpoint of the idle instance as `kept` asks, and gives when the next is due: none once one is kept, an epoch after now when it failed.
fn due_after_keeping(instance: nanos::Instance, kept: Keeping, keeping: Option[Keeping], telling: Telling) -> Option[u64] fails nanos::InstanceError uses wait {
    return match try await keep_hosted(instance, keeping: kept, telling) {
        true => None
        false => epoch_after(keeping, clock: telling.clock)
    }
} due_after_keeping

/// Waits until a message waits for the instance; once it has had none for the time `quiet` holds, never when 0, suspends it until its next message and then wakes it, telling the driver of both.
fn idle_hosted(mut instance: nanos::Instance, quiet: core::atomic::AtomicU64, telling: Telling) fails nanos::InstanceError uses wait {
    let clock = telling.clock
    loop {
        let ms = quiet.load()
        if ms == 0 {
            try await instance.incoming()
            return
        }
        let arrived = try await task::within(clock, ms, body: fn() fails nanos::InstanceError uses wait {
            try await instance.incoming()
        })
        if arrived.is_some() {
            return
        }
        if quiet.load() != 0 {
            break
        }
    }
    let suspending = telling.begin(call: SystemCall.Suspend)
    try await mut instance.suspend()
    telling.end_system(suspending)
    try await telling.tell(report: Report.Suspended)
    try await instance.incoming()
    let waking = telling.begin(call: SystemCall.Wake)
    try await mut instance.wake()
    telling.end_system(waking)
    try await telling.tell(report: Report.Woken)
} idle_hosted

/// Calls the handlers of every message waiting for the instance, starting the keyed tasks they spawn and counting each step for the dispatcher; tells the watchdog when they begin and how long they took, and returns whether it called any.
fn step_hosted(mut instance: nanos::Instance, protocol: sys::ProtocolHash, telling: Telling) -> bool fails nanos::InstanceError uses wait {
    try await mark(telling.marks, marked: Mark.Began)
    let started = now(telling.clock)
    let counts = telling.steps.contents()
    try await arm_hosted(instance, telling)
    var handled = false
    loop {
        discard counts.begun.fetch_add(1)
        let stepping = now(telling.clock)
        telling.begin_step(stepping)
        let stepped = try await recorded_hosted_step(mut instance, protocol, telling)
        match stepped {
            true => telling.end_taken(stepping, taken: counts.claimed())
            false => telling.end_step(stepping, stepped: None)
        }
        try await telling.count_step()
        if not stepped {
            break
        }
        handled = true
        discard try await mut instance.start_keyed()
    }
    try await mark(telling.marks, marked: Mark.Took(ns: now(telling.clock).saturating_sub(started)))
    match telling.armed() {
        Some(recorder) => {
            if try await recorder.rebase_due() {
                let base = try await state_of(instance)
                try await recorder.rebase(base)
            }
        }
        None => {
        }
    }
    return handled
} step_hosted

/// Has the instance handle the inputs `replay` gives, as the old code of a revert, then resumes it and probes its health; whether it runs healthy, `false` once it ended.
fn begin_replayed(
    mut instance: nanos::Instance,
    take replay: Option[mem::List[os::RecordedInput]],
    restored: bool,
    updated: bool,
    exec: task::Executor,
    telling: Telling,
    alloc: mem::Alloc,
    ) -> bool fails task::Cancelled uses wait {
    match replay {
        Some(inputs) => {
            match attempt await replay_hosted(mut instance, take inputs, exec, telling, alloc) {
                Ok(_) => {
                }
                Err(nanos::InstanceError.Cancelled(cancelled)) => fail cancelled
                Err(nanos::InstanceError.Ended) => return false
            }
        }
        None => {
        }
    }
    return match attempt await begin_hosted(mut instance, restored, updated, telling) {
        Ok(healthy) => healthy
        Err(nanos::InstanceError.Cancelled(cancelled)) => fail cancelled
        Err(nanos::InstanceError.Ended) => false
    }
} begin_replayed

/// Has the instance handle each input of `inputs` in order before it resumes, as the old code of a revert: posts each from a task of a scope and steps the instance until it handled it, dropping the messages its handler sent the component and the keyed tasks it spawned; tells the driver before each which it replays, then how many it replayed.
fn replay_hosted(
    mut instance: nanos::Instance,
    take inputs: mem::List[os::RecordedInput],
    exec: task::Executor,
    telling: Telling,
    alloc: mem::Alloc,
    ) fails nanos::InstanceError uses wait {
    let inbox = instance.inbox()
    var count: u64 = 0
    try await task::scope(exec, body: fn[mut instance, take inputs, mut count](s: task::Scope) fails nanos::InstanceError uses wait {
        for input in inputs {
            try await telling.tell(report: Report.Replaying(seq: input.seq))
            var encoding = sys::Encoded.empty(alloc)
            mut encoding.bytes.append(input.encoded.view())
            let hash = input.hash
            discard s.spawn(fn[take encoding]() fails task::Cancelled uses wait limits stack 16_384 {
                discard attempt await inbox.call(hash, request: REPLAYED_REQUEST, take encoding, alloc)
            })
            loop {
                try await instance.incoming()
                if try await mut instance.step() {
                    break
                }
            }
            loop {
                let Some(_) = try await mut instance.take_sent() else {
                    break
                }
            }
            for held in try await instance.held() {
                discard try await mut instance.drop_held(held.key)
            }
            count += 1
        }
        s.cancel()
    })
    try await telling.tell(report: Report.ReplayDone(replayed: count))
} replay_hosted

/// Arms the flight recorder as an order left in it asks, from the quiescent state of the instance.
fn arm_hosted(instance: nanos::Instance, telling: Telling) fails nanos::InstanceError uses wait {
    let Some(recorder) = telling.recorder else {
        return
    }
    let Some(Ordered(bundle: bundle, period: period, tape: tape)) = try await recorder.take_order() else {
        return
    }
    let base = try await state_of(instance)
    try await recorder.arm(base, bundle, period, take tape)
} arm_hosted

/// Steps the instance, an armed flight recorder recording the message the step handles, a call of the protocol `protocol`, with the clock and random reads its handler took; whether it handled one.
fn recorded_hosted_step(mut instance: nanos::Instance, protocol: sys::ProtocolHash, telling: Telling) -> bool fails nanos::InstanceError uses wait {
    let Some(recorder) = telling.armed() else {
        return try await mut instance.step()
    }
    let Some(tape) = try await recorder.tape() else {
        return try await mut instance.step()
    }
    let seq = recorder.next_seq()
    tape.record()
    let stepped = try await mut instance.step_encoded()
    let recorded = tape.recorded(telling.alloc)
    let Some(nanos::Stepped(handled: _, encoding: encoding)) = stepped else {
        return false
    }
    try await recorder.take_input(os::RecordedInput(seq: seq, hash: protocol, encoded: take encoding.bytes, recorded: take recorded))
    return true
} recorded_hosted_step

/// A copy of the quiescent state of the instance with its schema.
fn state_of(instance: nanos::Instance) -> os::StateCopy fails nanos::InstanceError uses wait {
    let nanos::Checkpoint(schema: schema, bytes: bytes) = try await instance.checkpoint()
    return os::StateCopy(schema: ident::HashValue(bytes: schema.bytes), state: take bytes)
} state_of

/// Keeps the quiescent state of the instance as its next checkpoint, telling the driver when that fails; whether it was kept. A checkpoint kept becomes the base of the armed flight recorder's recording, or ends its period, which the driver is told.
fn keep_hosted(instance: nanos::Instance, keeping: Keeping, telling: Telling) -> bool fails nanos::InstanceError uses wait {
    let base = try await state_of(instance)
    var bytes = mem::Bytes.empty(telling.alloc)
    mut bytes.append(base.state.view())
    if not try await keep_checkpoint(keeping, take bytes, schema: mem::wire::SchemaHash(bytes: base.schema.bytes), telling) {
        return false
    }
    match telling.armed() {
        Some(recorder) => {
            if try await recorder.checkpointed(base) {
                try await telling.tell(report: Report.RecordingEnded)
            }
        }
        None => {
        }
    }
    return true
} keep_hosted

/// Ends the instance's service once told to stop: handles every message that waits, keeps a checkpoint when the state is `dirty` or it handled one, hands the driver the encoding of the state when `hand`, then tells the driver it ends.
fn stop_hosted(
    mut instance: nanos::Instance,
    keeping: Option[Keeping],
    dirty: bool,
    hand: bool,
    protocol: sys::ProtocolHash,
    telling: Telling,
    ) fails nanos::InstanceError uses wait {
    let handled = try await step_hosted(mut instance, protocol, telling)
    match first keeping {
        Some(kept) if handled or dirty => {
            discard try await keep_hosted(instance, keeping: kept, telling)
        }
        else => {
        }
    }
    if hand {
        let nanos::Checkpoint(schema: schema, bytes: state) = try await instance.checkpoint()
        try await telling.tell(report: Report.Handed(state: take state, schema: ident::HashValue(bytes: schema.bytes)))
    }
    try await telling.tell(report: Report.Ending)
} stop_hosted
