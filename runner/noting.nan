//! The clock and random source of a fork, which note whether its handlers read the clock or drew random values: its clock reads the instant the fork was made, its sleeps return at once, and its draws are zeros.

/// What a fork's sources reach: the runner's clock reading when the fork was made, and whether a handler read the clock or drew random values since the note was last cleared.
struct ForkReads {
    at_ns: u64
    taken: mem::Shared[core::atomic::AtomicBool]
} ForkReads

/// The clock and random source of a fork.
pub open struct Noting {
} Noting

impl Noting: sys::Kind[ForkReads, u8]

impl Noting: sys::ClockService

impl Noting: sys::RandomService

/// A fork's clock and random source, the note they keep, and the root entry that revokes them when it closes.
linear struct ForkSources {
    root: sys::Minter[Noting, ForkReads, u8]
    clock: sys::Clock
    random: sys::Random
    taken: mem::Shared[core::atomic::AtomicBool]
} ForkSources

/// A fork's clock and random source, its clock reading what `clock` reads now, noting their use in `taken`; `None` once revoked.
fn ForkSources.of(clock: sys::Clock, take taken: mem::Shared[core::atomic::AtomicBool], alloc: mem::Alloc) -> Option[ForkSources] {
    let at_ns = match attempt clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
    let root = sys::Minter[Noting, ForkReads, u8].of(ForkReads(at_ns: at_ns, taken: taken.share()), alloc)
    let source = root.mint(0)
    let served = attempt sys::Clock.served(source)
    let drawn = attempt sys::Random.served(source)
    let Ok(noting_clock) = served else {
        take root.close()
        return None
    }
    let Ok(noting_random) = drawn else {
        take root.close()
        return None
    }
    return Some(ForkSources(root: take root, clock: noting_clock, random: noting_random, taken: take taken))
} ForkSources.of

/// Revokes the sources.
fn ForkSources.close(take self) {
    let ForkSources(root: root, clock: _, random: _, taken: _) = self
    take root.close()
} ForkSources.close

/// The same reading and note.
fn ForkReads.share(self) -> ForkReads {
    return ForkReads(at_ns: self.at_ns, taken: self.taken.share())
} ForkReads.share

pub fn Noting.elapsed_ns(self) -> u64 limits stack 1_024 {
    let Some(reads) = sys::reach(self, body: fn(reads: ForkReads, record: u8) => reads.share()) else {
        return 0
    }
    reads.taken.contents().store(true)
    return reads.at_ns
} Noting.elapsed_ns

pub fn Noting.sleep_ns(self, ns: u64) limits stack 1_024 {
} Noting.sleep_ns

pub fn Noting.fill(self, mut buf: SliceMut[u8]) limits stack 4_096 {
    let Some(reads) = sys::reach(self, body: fn(reads: ForkReads, record: u8) => reads.share()) else {
        return
    }
    reads.taken.contents().store(true)
    for at in 0..<buf.len() {
        buf[at] = 0
    }
} Noting.fill

test fork_sources_note_clock_reads_and_draws for Noting.fill {
    let world = testing::world()
    let Some(sources) = ForkSources.of(world.clock, taken: mem::Shared.of(core::atomic::AtomicBool.of(false), alloc: world.alloc), alloc: world.alloc) else {
        expect false
        return
    }
    defer take sources.close()
    let untouched = sources.taken.contents().load()
    let first_read = attempt sources.clock.elapsed_ns()
    let second_read = attempt sources.clock.elapsed_ns()
    let read = sources.taken.contents().swap(false)
    var drawn = Array[u8, 3].filled(7)
    discard attempt sources.random.fill(mut drawn.view_mut())
    let noted = sources.taken.contents().load()
    expect not untouched and read and noted and first_read == second_read and drawn[0] == 0 and drawn[2] == 0
} fork_sources_note_clock_reads_and_draws
