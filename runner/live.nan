//! What the runner publishes of each instance at `/live/instances/<moniker>`, whenever what it shows changes, and the gauges of the running incarnations, which the board reads at request time.

/// What a driver publishes of its instance besides its lifecycle and specification: the code of its last fault, the summary its component last published, the counts of each, the commit of the desired value its reconciler last brought it to, when what it shows last changed, and what it last showed.
struct Showing {
    fault: Option[text::String]
    faults: u64
    summary: Option[mem::Bytes]
    summaries: u64
    desired: u64
    since: ident::WallTime
    shown: Option[Shown]
} Showing

/// What a published record of an instance follows: its lifecycle, whether its specification has it stopped, its restarts in the period, the counts of its faults and summaries, the commit of its desired value, and its CPU reservation.
struct Shown derives Copy, Eq {
    lifecycle: Option[os::Lifecycle]
    stopped: bool
    restarts: usize
    faults: u64
    summaries: u64
    desired: u64
    reservation: Option[os::CpuReservation]
} Shown

/// What a driver shows of an instance before its first start.
fn Showing.none() -> Showing {
    return Showing(fault: None, faults: 0, summary: None, summaries: 0, desired: 0, since: ident::WallTime.unknown(), shown: None)
} Showing.none

/// Notes the fault of code `code`.
fn Showing.faulted(mut self, take code: text::String) {
    self.fault = Some(take code)
    self.faults += 1
} Showing.faulted

/// Notes the summary the component published.
fn Showing.summarize(mut self, take bytes: mem::Bytes) {
    self.summary = Some(take bytes)
    self.summaries += 1
} Showing.summarize

/// Publishes the record of the instance when what it shows changed since the driver last published it.
fn Shared.show(self, mut driver: Driver) fails task::Cancelled uses wait {
    let alloc = self.config.alloc
    let reservation = match driver.reservation {
        Some(admitted) => Some(os::CpuReservation(cpu: admitted.cpu, ppm: u32.fit(admitted.reservation.ppm)))
        None => None
    }
    let seen = Shown(lifecycle: driver.lifecycle, stopped: driver.spec.stopped, restarts: driver.restarts.times.len(), faults: driver.showing.faults, summaries: driver.showing.summaries, desired: driver.showing.desired, reservation: reservation)
    if driver.showing.shown == Some(seen) {
        return
    }
    if lifecycle_changed(driver.showing.shown, seen) {
        driver.showing.since = self.config.wall.now(self.config.clock)
    }
    driver.showing.shown = Some(seen)
    let state = driver.lifecycle.value_or(os::Lifecycle.Stopped)
    let fault = match driver.showing.fault {
        Some(code) => Some(text::String.of(code.as_str(), alloc))
        None => None
    }
    let summary = match driver.showing.summary {
        Some(bytes) => Some(copied(bytes.view(), alloc))
        None => None
    }
    let record = os::LiveInstance(state: state, status: os::ReconcileStatus(state: reconciled(state, stopped: driver.spec.stopped, fault: driver.showing.fault, alloc), desired: driver.showing.desired, since: driver.showing.since), bundle: driver.spec.bundle, space: text::String.of("shared", alloc), durability: driver.spec.durability, restarts: u32.fit(driver.restarts.times.len()), fault: take fault, intake: u32.saturate(driver.queue.len()), memory: os::Usage(charged: 0, limit: driver.spec.budget.limit, peak: 0), cpu_ns: 0, reservation: reservation, probation: None, summary: take summary, as_of: now(self.config.clock))
    try await os::publish(self.postings, path: instance_path(driver.moniker, alloc).as_str(), type: "os::LiveInstance", value: record, alloc)
} Shared.show

/// Where the gauges of the accounts are read, each through its watch, and what was folded into each account from outside it, by account number.
pub open struct Gauges derives Send {
    watches: task::Cown[mem::Map[text::String, task::Sender[Mark]]]
    folds: task::Cown[mem::Map[u32, Folded]]
} Gauges

/// What was folded into an account from outside it: the time its messages took to handle in other instances, and the bytes drivers read and wrote for it.
struct Folded derives Copy {
    ns: u64
    read_bytes: u64
    written_bytes: u64
} Folded

/// Nothing folded.
const UNFOLDED: Folded = Folded(ns: 0, read_bytes: 0, written_bytes: 0)

/// What was folded since `base` was.
fn Folded.since(self, base: Folded) -> Folded {
    return Folded(ns: self.ns.saturating_sub(base.ns), read_bytes: self.read_bytes.saturating_sub(base.read_bytes), written_bytes: self.written_bytes.saturating_sub(base.written_bytes))
} Folded.since

pub fn Gauges.empty(alloc: mem::Alloc) -> Gauges {
    return Gauges(watches: task::Cown.of(mem::Map.empty(alloc), alloc), folds: task::Cown.of(mem::Map.empty(alloc), alloc))
} Gauges.empty

pub fn Gauges.share(self) -> Gauges {
    return Gauges(watches: self.watches.share(), folds: self.folds.share())
} Gauges.share

/// Folds `ns` that a message of the account `account` took to handle into that account, unless it is the account of a session not open.
fn Gauges.fold(self, account: u32, ns: u64) fails task::Cancelled uses wait {
    let folds = self.folds.share()
    await when mut folds {
        match folded_into(folds, account) {
            Some(held) => {
                discard mut folds.insert(account, value: Folded(ns: held.ns.saturating_add(ns), read_bytes: held.read_bytes, written_bytes: held.written_bytes))
            }
            None => {
            }
        }
    }
} Gauges.fold

/// Folds the bytes of each transfer `transfers` brings into its account, unless that is the account of a session not open, until the transfers end.
pub fn Gauges.keep_transfers(self, take transfers: task::Receiver[os::Transfer]) fails task::Cancelled uses wait {
    let folds = self.folds.share()
    var receiver = transfers
    loop {
        let Some(transfer) = try await mut receiver.receive() else {
            return
        }
        await when mut folds {
            match folded_into(folds, account: transfer.account) {
                Some(held) => {
                    let folded = match transfer.written {
                        true => Folded(ns: held.ns, read_bytes: held.read_bytes, written_bytes: held.written_bytes.saturating_add(transfer.bytes))
                        false => Folded(ns: held.ns, read_bytes: held.read_bytes.saturating_add(transfer.bytes), written_bytes: held.written_bytes)
                    }
                    discard mut folds.insert(transfer.account, value: folded)
                }
                None => {
                }
            }
        }
    }
} Gauges.keep_transfers

test transfers_fold_into_their_accounts_unless_closed_sessions for Gauges.keep_transfers {
    let world = testing::world()
    let gauges = Gauges.empty(world.alloc)
    let session = os::SESSION_ACCOUNTS | 1
    try await gauges.open_folds(session)
    let task::Channel(sender: transferring, receiver: transfers) = task::Channel[os::Transfer].bounded(4, alloc: world.alloc)
    let minted = os::MintedMeter.of(take transferring, alloc: world.alloc)
    let meter = minted.mint()
    let read = meter.charge(account: session, bytes: 4_096, written: false)
    let written = meter.charge(account: session, bytes: 512, written: true)
    let instance = meter.charge(account: 7, bytes: 1_024, written: true)
    let closed = meter.charge(account: os::SESSION_ACCOUNTS | 2, bytes: 8, written: false)
    take minted.close()
    let stale = meter.charge(account: 7, bytes: 1, written: false)
    try await gauges.keep_transfers(take transfers)
    let in_session = try await gauges.folded(session)
    let in_instance = try await gauges.folded(7)
    let in_closed = try await gauges.folded(os::SESSION_ACCOUNTS | 2)
    expect read and written and instance and closed and not stale
    expect in_session.read_bytes == 4_096 and in_session.written_bytes == 512 and in_instance.written_bytes == 1_024 and in_instance.read_bytes == 0 and in_closed.read_bytes == 0
} transfers_fold_into_their_accounts_unless_closed_sessions

/// What `folds` holds of the account `account`, nothing for an instance's account it holds none of yet, `None` for the account of a session not open.
fn folded_into(folds: mem::Map[u32, Folded], account: u32) -> Option[Folded] {
    return match first folds.get(account) {
        Some(held) => Some(held)
        None if (account & os::SESSION_ACCOUNTS) == 0 => Some(UNFOLDED)
        None => None
    }
} folded_into

/// Opens the account `account` of a session to folds, with nothing folded into it.
fn Gauges.open_folds(self, account: u32) fails task::Cancelled uses wait {
    let folds = self.folds.share()
    await when mut folds {
        discard mut folds.insert(account, value: UNFOLDED)
    }
} Gauges.open_folds

/// Closes the account `account` of a session to folds.
fn Gauges.end_folds(self, account: u32) fails task::Cancelled uses wait {
    let folds = self.folds.share()
    await when mut folds {
        discard mut folds.remove(account)
    }
} Gauges.end_folds

/// What was folded into the account `account` so far.
fn Gauges.folded(self, account: u32) -> Folded fails task::Cancelled uses wait {
    let folds = self.folds.share()
    return await when folds => folds.get(account).value_or(UNFOLDED)
} Gauges.folded

/// The gauge of the running incarnation of the instance `instance`, `None` when none runs.
pub fn Gauges.read(self, instance: Str, alloc: mem::Alloc) -> Option[os::Gauge] fails task::Cancelled uses wait {
    let watches = self.watches.share()
    let key = text::String.of(instance, alloc)
    let found = await when watches => match watches.get(key) {
        Some(watch) => Some(watch.split())
        None => None
    }
    let Some(watch) = found else {
        return None
    }
    let task::Channel(sender: reply, receiver: answered) = task::Channel[os::Gauge].bounded(1, alloc)
    match first attempt await watch.send(Mark.Read(reply: take reply)) {
        Ok(_) => {
        }
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return None
    }
    var receiver = answered
    return try await mut receiver.receive()
} Gauges.read

/// What the cells of the running incarnations are charged: those split from the pool, and those split from reserved regions.
pub closed struct Charges derives Copy, Eq {
    pub pooled: u64
    pub reserved: u64
} Charges

/// The charges of the cells of the incarnations running now.
pub fn Gauges.charges(self, alloc: mem::Alloc) -> Charges fails task::Cancelled uses wait {
    var charges = Charges(pooled: 0, reserved: 0)
    for instance in try await self.instances(alloc) {
        let Some(gauge) = try await self.read(instance.as_str(), alloc) else {
            continue
        }
        if gauge.reserved {
            charges.reserved += gauge.memory.charged
        } else {
            charges.pooled += gauge.memory.charged
        }
    }
    return charges
} Gauges.charges

/// The instances with a running incarnation, in name order.
pub fn Gauges.instances(self, alloc: mem::Alloc) -> mem::List[text::String] fails task::Cancelled uses wait {
    let watches = self.watches.share()
    return await when watches => names_of(watches, alloc)
} Gauges.instances

fn names_of(watches: mem::Map[text::String, task::Sender[Mark]], alloc: mem::Alloc) -> mem::List[text::String] {
    var names = mem::List[text::String].empty(alloc)
    for watched in watches {
        mut names.push(text::String.of(watched.key().as_str(), alloc))
    }
    return names
} names_of

/// Has the gauge of the account `account` read through `watch`.
fn Gauges.watch(self, account: Str, take watch: task::Sender[Mark], alloc: mem::Alloc) fails task::Cancelled uses wait {
    let watches = self.watches.share()
    let key = text::String.of(account, alloc)
    var given = Some(take watch)
    await when mut watches {
        match mut given.extract() {
            Some(sender) => {
                discard mut watches.insert(take key, value: take sender)
            }
            None => {
            }
        }
    }
} Gauges.watch

/// Forgets the gauge of the account `account`.
fn Gauges.unwatch(self, account: Str, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let watches = self.watches.share()
    let key = text::String.of(account, alloc)
    await when mut watches {
        discard mut watches.remove(key)
    }
} Gauges.unwatch

/// Withdraws the record of the deleted instance `moniker`.
fn Shared.unshow(self, moniker: ident::Moniker) fails task::Cancelled uses wait {
    try await os::post(self.postings, posting: os::Posting.Withdraw(path: instance_path(moniker, alloc: self.config.alloc)))
} Shared.unshow

/// Whether `seen` shows another lifecycle or stop than `before`.
fn lifecycle_changed(before: Option[Shown], seen: Shown) -> bool {
    let Some(shown) = before else {
        return true
    }
    return shown.lifecycle != seen.lifecycle or shown.stopped != seen.stopped
} lifecycle_changed

/// The reconciliation an instance in `state` shows: converged when running or hibernated, or stopped as its specification asks; failed when failed, with the code of its last fault; converging otherwise.
fn reconciled(state: os::Lifecycle, stopped: bool, fault: Option[text::String], alloc: mem::Alloc) -> os::ReconcileState {
    return match state {
        os::Lifecycle.Running or os::Lifecycle.Hibernated => os::ReconcileState.Converged
        os::Lifecycle.Stopped => match stopped {
            true => os::ReconcileState.Converged
            false => os::ReconcileState.Converging
        }
        os::Lifecycle.Failed => os::ReconcileState.Failed(code: match fault {
            Some(code) => text::String.of(code.as_str(), alloc)
            None => text::String.of("instance.failed", alloc)
        }, detail: text::String.empty(alloc))
        else => os::ReconcileState.Converging
    }
} reconciled

/// The path of the record of the instance `moniker`.
fn instance_path(moniker: ident::Moniker, alloc: mem::Alloc) -> text::String {
    var path = text::String.of("/live/instances/", alloc)
    mut path.append(moniker.text.as_str())
    return path
} instance_path

fn copied(bytes: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    var copy = mem::Bytes.empty(alloc)
    mut copy.append(bytes)
    return copy
} copied
