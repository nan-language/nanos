//! The MADT, the table of the interrupt controllers and processors.

const MADT_ENTRIES: usize = 44

/// The MADT when each of its interrupt controller entries lies inside it and holds at least its type and length.
pub validator fn check_madt(raw: Untrusted[Slice[u8]]) fails TableError {
    let bytes = raw.inspect()
    try check_header(bytes, signature: Signature.Madt, minimum: MADT_ENTRIES)
    var at = MADT_ENTRIES
    while at < bytes.len() {
        if bytes.len() - at < 2 {
            fail TableError.Entry
        }
        let length = usize.widen(bytes[at + 1])
        if length < 2 or length > bytes.len() - at {
            fail TableError.Entry
        }
        at += length
    }
} check_madt

/// The type of a MADT interrupt source override, which routes an ISA interrupt.
const SOURCE_OVERRIDE: u8 = 2

/// Where an ISA interrupt arrives: its global system interrupt, and the trigger and polarity its override sets, `None` where the ISA bus's conform.
pub closed struct IsaRoute derives Copy, Eq {
    pub line: u32
    pub edge: Option[bool]
    pub active_low: Option[bool]
} IsaRoute

/// The routes of the 16 ISA interrupts of a MADT that `check_madt` accepts: each to the global system interrupt of its number, unless an interrupt source override routes it.
pub validator fn isa_routes(raw: Untrusted[Slice[u8]]) -> Array[IsaRoute, 16] {
    var routes = Array[IsaRoute, 16].filled(IsaRoute(line: 0, edge: None, active_low: None))
    for at in 0..<16usize {
        routes[at] = IsaRoute(line: u32.truncate(at), edge: None, active_low: None)
    }
    let bytes = raw.inspect()
    var at = MADT_ENTRIES
    while at + 2 <= bytes.len() {
        let length = usize.widen(bytes[at + 1])
        if length < 2 or length > bytes.len() - at {
            return routes
        }
        if bytes[at] == SOURCE_OVERRIDE and length >= 10 and bytes[at + 2] == 0 and bytes[at + 3] < 16 {
            let flags = bytes.u16_le(at + 8)
            routes[usize.widen(bytes[at + 3])] = IsaRoute(line: bytes.u32_le(at + 4), edge: set_flag(flags >> 2, set: 1, cleared: 3), active_low: set_flag(flags, set: 3, cleared: 1))
        }
        at += length
    }
    return routes
} isa_routes

/// What the two low bits of override flags set: true at `set`, false at `cleared`, `None` where they conform to the bus.
fn set_flag(flags: u16, set: u16, cleared: u16) -> Option[bool] {
    let field = flags & 3
    if field == set {
        return Some(true)
    }
    if field == cleared {
        return Some(false)
    }
    return None
} set_flag

/// A MADT holding a local APIC entry for each id of `apics`, then `tail` as a last entry.
fn sample_madt(apics: Slice[u8], tail: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    var body = mem::Bytes.zeroed(8, alloc)
    mut body.view_mut().write_u32_le(0, value: 0xFEE0_0000)
    for id in apics {
        let entry = Array[u8, 8].filled(0)
        var local = entry
        local[1] = 8
        local[3] = id
        local[4] = 1
        mut body.append(local.view())
    }
    mut body.append(tail)
    return sample_table(Signature.Madt, body: body.view(), alloc)
} sample_madt

fn madt_outcome(table: mem::Bytes) -> Result[Unit, TableError] {
    return attempt check_madt(Untrusted.of(table.view()))
} madt_outcome

test madt_entries_lie_inside for check_madt {
    let alloc = testing::world().alloc
    let valid = madt_outcome(sample_madt(apics: b"\x00\x01\x02\x03", tail: b"", alloc))
    expect valid == Ok(Unit)
    let truncated = madt_outcome(sample_madt(apics: b"\x00", tail: b"\x09\x10\x00\x00", alloc))
    expect truncated == Err(TableError.Entry)
    let empty_entry = madt_outcome(sample_madt(apics: b"\x00", tail: b"\x01\x00", alloc))
    expect empty_entry == Err(TableError.Entry)
    let lone_byte = madt_outcome(sample_madt(apics: b"", tail: b"\x00", alloc))
    expect lone_byte == Err(TableError.Entry)
} madt_entries_lie_inside

test overrides_route_isa_interrupts for isa_routes {
    let alloc = testing::world().alloc
    let timer_and_sci = b"\x02\x0A\x00\x00\x02\x00\x00\x00\x00\x00\x02\x0A\x00\x09\x09\x00\x00\x00\x0D\x00"
    let table = sample_madt(apics: b"\x00", tail: timer_and_sci, alloc)
    let routes = isa_routes(Untrusted.of(table.view()))
    expect routes[0] == IsaRoute(line: 2, edge: None, active_low: None)
    expect routes[9] == IsaRoute(line: 9, edge: Some(false), active_low: Some(false))
    expect routes[3] == IsaRoute(line: 3, edge: None, active_low: None)
} overrides_route_isa_interrupts
