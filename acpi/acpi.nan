//! The ACPI tables NaN OS reads, each through its validator.

const HEADER_BYTES: usize = 36

/// Why a table fails its validator.
pub closed enum TableError derives Copy, Eq, Render {
    /// Shorter than its header or than its type requires, or with a length that differs from its bytes.
    Length
    Signature
    Checksum
    /// An entry that runs past the table or is shorter than its type requires.
    Entry
} TableError

/// The tables the core copies at its start: those its start sequence reads, and those holding the AML namespace `devices` reads.
pub closed enum Signature derives Copy, Eq {
    Madt
    Fadt
    Srat
    Dsdt
    Ssdt
    Spcr
} Signature

/// The four bytes a table's header holds for its type.
pub fn Signature.bytes(self) -> Array[u8, 4] {
    let text = match self {
        Signature.Madt => b"APIC"
        Signature.Fadt => b"FACP"
        Signature.Srat => b"SRAT"
        Signature.Dsdt => b"DSDT"
        Signature.Ssdt => b"SSDT"
        Signature.Spcr => b"SPCR"
    }
    var bytes = Array[u8, 4].filled(0)
    mut bytes.view_mut().copy_from(text)
    return bytes
} Signature.bytes

/// Checks the header of a table of type `signature` holding at least `minimum` bytes: its signature, a length equal to its bytes and a checksum making its bytes sum to 0 modulo 256.
fn check_header(bytes: Slice[u8], signature: Signature, minimum: usize) fails TableError {
    if bytes.len() < HEADER_BYTES or bytes.len() < minimum or usize.widen(bytes.u32_le(4)) != bytes.len() {
        fail TableError.Length
    }
    let expected = signature.bytes()
    let Some(found) = bytes.prefix(4) else {
        fail TableError.Length
    }
    if found != expected.view() {
        fail TableError.Signature
    }
    var sum: u8 = 0
    for byte in bytes {
        sum = sum.wrapping_add(byte)
    }
    if sum != 0 {
        fail TableError.Checksum
    }
} check_header

/// The FADT when it holds at least the 116 bytes of its first revision.
pub validator fn check_fadt(raw: Untrusted[Slice[u8]]) fails TableError {
    try check_header(raw.inspect(), signature: Signature.Fadt, minimum: 116)
} check_fadt

/// Where the FADT's byte naming the RTC's century register lies.
const CENTURY_AT: usize = 108

/// The CMOS index of the RTC's century register that the FADT names, 0 when it names none.
pub validator fn rtc_century(raw: Untrusted[Slice[u8]]) -> u8 fails TableError {
    let bytes = raw.inspect()
    try check_header(bytes, signature: Signature.Fadt, minimum: 116)
    return bytes[CENTURY_AT]
} rtc_century

/// A table of `signature` built from `body`, its checksum set.
fn sample_table(signature: Signature, body: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    var table = mem::Bytes.zeroed(HEADER_BYTES + body.len(), alloc)
    var bytes = mut table.view_mut()
    let name = signature.bytes()
    for i in 0..<4usize {
        bytes[i] = name[i]
    }
    mut bytes.write_u32_le(4, value: u32.fit(HEADER_BYTES + body.len()))
    bytes[8] = 1
    for i in 0..<body.len() {
        bytes[HEADER_BYTES + i] = body[i]
    }
    var sum: u8 = 0
    for byte in bytes.view() {
        sum = sum.wrapping_add(byte)
    }
    bytes[9] = 0u8.wrapping_sub(sum)
    return table
} sample_table

fn fadt_outcome(table: mem::Bytes) -> Result[Unit, TableError] {
    return attempt check_fadt(Untrusted.of(table.view()))
} fadt_outcome

test fadts_are_checked for check_fadt {
    let alloc = testing::world().alloc
    let body = Array[u8, 80].filled(0)
    let valid = fadt_outcome(sample_table(Signature.Fadt, body: body.view(), alloc))
    expect valid == Ok(Unit)
    let short_body = Array[u8, 40].filled(0)
    let short = fadt_outcome(sample_table(Signature.Fadt, body: short_body.view(), alloc))
    expect short == Err(TableError.Length)
    let madt = fadt_outcome(sample_table(Signature.Madt, body: body.view(), alloc))
    expect madt == Err(TableError.Signature)
    var altered = sample_table(Signature.Fadt, body: body.view(), alloc)
    altered[40] = 1
    let corrupt = fadt_outcome(altered)
    expect corrupt == Err(TableError.Checksum)
    var lengthened = sample_table(Signature.Fadt, body: body.view(), alloc)
    mut lengthened.view_mut().write_u32_le(4, value: 200)
    let long = fadt_outcome(lengthened)
    expect long == Err(TableError.Length)
} fadts_are_checked

test the_fadt_names_the_rtc_century_register for rtc_century {
    let alloc = testing::world().alloc
    var body = Array[u8, 80].filled(0)
    body[CENTURY_AT - HEADER_BYTES] = 0x32
    let named = sample_table(Signature.Fadt, body: body.view(), alloc)
    let century = attempt rtc_century(Untrusted.of(named.view()))
    let short_body = Array[u8, 40].filled(0)
    let short = sample_table(Signature.Fadt, body: short_body.view(), alloc)
    let missing = attempt rtc_century(Untrusted.of(short.view()))
    expect century == Ok(0x32)
    expect missing == Err(TableError.Length)
} the_fadt_names_the_rtc_century_register
