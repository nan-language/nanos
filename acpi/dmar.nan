//! The DMAR, the table describing Intel VT-d's DMA remapping units.

/// Where the DMAR's remapping structures start, and the types of a remapping unit's structure and of a reserved memory region's.
const DMAR_STRUCTURES: usize = 48

const REMAPPING_UNIT: u16 = 0

const RESERVED_MEMORY: u16 = 1

/// The bytes of a remapping unit's structure up to its register base.
const UNIT_BYTES: usize = 16

/// The DMAR flag stating that the platform remaps interrupts.
const INTERRUPT_REMAPPING: u8 = 0x01

/// What the DMAR describes: the register base of each remapping unit, whether it reserves memory regions for devices, and whether the platform remaps interrupts.
pub closed struct Dmar {
    pub units: mem::List[u64]
    pub reserved: bool
    pub interrupt_remapping: bool
} Dmar

/// The DMAR when each of its remapping structures lies inside it, a remapping unit's holding its register base.
pub validator fn Dmar.read(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Dmar fails TableError {
    let bytes = raw.inspect()
    try check_header(bytes, signature: Signature.Dmar, minimum: DMAR_STRUCTURES)
    var units = mem::List[u64].empty(alloc)
    var reserved = false
    var at = DMAR_STRUCTURES
    while at < bytes.len() {
        if bytes.len() - at < 4 {
            fail TableError.Entry
        }
        let kind = bytes.u16_le(at)
        let length = usize.widen(bytes.u16_le(at + 2))
        if length < 4 or length > bytes.len() - at {
            fail TableError.Entry
        }
        if kind == REMAPPING_UNIT {
            if length < UNIT_BYTES {
                fail TableError.Entry
            }
            mut units.push(bytes.u64_le(at + 8))
        } else if kind == RESERVED_MEMORY {
            reserved = true
        }
        at += length
    }
    return Dmar(units: take units, reserved: reserved, interrupt_remapping: (bytes[HEADER_BYTES + 1] & INTERRUPT_REMAPPING) != 0)
} Dmar.read

/// A DMAR body of `structures` after its host address width and flags `flags`.
fn sample_dmar(flags: u8, structures: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    var body = mem::Bytes.zeroed(DMAR_STRUCTURES - HEADER_BYTES, alloc)
    body[0] = 47
    body[1] = flags
    mut body.append(structures)
    return sample_table(Signature.Dmar, body: body.view(), alloc)
} sample_dmar

test the_dmar_lists_its_units_reserved_regions_and_interrupt_remapping for Dmar.read {
    let alloc = testing::world().alloc
    var structures = Array[u8, 40].filled(0)
    structures[2] = 16
    structures[10] = 0xD9
    structures[11] = 0xFE
    structures[16] = 1
    structures[18] = 24
    let table = sample_dmar(flags: INTERRUPT_REMAPPING, structures: structures.view(), alloc)
    let Ok(dmar) = attempt Dmar.read(Untrusted.of(table.view()), alloc) else {
        expect false
        return
    }
    expect dmar.units.len() == 1 and dmar.units[0] == 0xFED9_0000
    expect dmar.reserved and dmar.interrupt_remapping
    var overrun = Array[u8, 16].filled(0)
    overrun[2] = 32
    let long = sample_dmar(flags: 0, structures: overrun.view(), alloc)
    let overrunning = attempt Dmar.read(Untrusted.of(long.view()), alloc)
    expect overrunning.is_err()
} the_dmar_lists_its_units_reserved_regions_and_interrupt_remapping
