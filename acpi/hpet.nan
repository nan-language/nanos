//! The HPET table: where the high precision event timer's registers lie.

/// The bytes of the table through the fields NaN OS reads.
const HPET_BYTES: usize = 56

/// The address space of the registers' generic address structure, and the address it holds.
const SPACE_AT: usize = 40

const ADDRESS_AT: usize = 44

/// The address space id of system memory.
const SYSTEM_MEMORY: u8 = 0

/// The physical address of the HPET's registers, which the table places in system memory.
pub validator fn hpet_base(raw: Untrusted[Slice[u8]]) -> u64 fails TableError {
    let bytes = raw.inspect()
    try check_header(bytes, signature: Signature.Hpet, minimum: HPET_BYTES)
    if bytes[SPACE_AT] != SYSTEM_MEMORY {
        fail TableError.Entry
    }
    return bytes.u64_le(ADDRESS_AT)
} hpet_base

fn hpet_outcome(table: mem::Bytes) -> Result[u64, TableError] {
    return attempt hpet_base(Untrusted.of(table.view()))
} hpet_outcome

test hpet_registers_lie_in_system_memory for hpet_base {
    let alloc = testing::world().alloc
    var body = Array[u8, 20].filled(0)
    mut body.view_mut().write_u64_le(ADDRESS_AT - 36, value: 0xFED0_0000)
    let found = hpet_outcome(sample_table(Signature.Hpet, body: body.view(), alloc))
    expect found == Ok(0xFED0_0000)
    body[SPACE_AT - 36] = 1
    let ports = hpet_outcome(sample_table(Signature.Hpet, body: body.view(), alloc))
    expect ports == Err(TableError.Entry)
    let short_body = Array[u8, 8].filled(0)
    let short = hpet_outcome(sample_table(Signature.Hpet, body: short_body.view(), alloc))
    expect short == Err(TableError.Length)
} hpet_registers_lie_in_system_memory
