//! What the kernel tells `keys` at each of its starts.

/// A capability telling `keys` what the kernel knows of its start.
pub open struct Start {
} Start

impl Start: sys::Kind[Told, u8]

impl Start: sys::Crossing

/// What the kernel tells `keys` at a start: the owner key the loader keeps, whether its checkpoints are kept, which they are not when it starts before `store`, and whether it runs in its isolated space.
pub closed struct Told derives Copy, Encode {
    pub owner: Option[Array[u8, 32]]
    pub kept: bool
    pub isolated: bool
} Told

/// The operation through which `keys` in its isolated space reads what the kernel told.
const CROSS_TOLD: u64 = 0

/// The root entry of the `Start` capability of one start, revoked when it closes.
pub open linear struct MintedStart derives Send {
    minter: sys::Minter[Start, Told, u8]
} MintedStart

/// A root entry telling `told`.
pub fn MintedStart.of(told: Told, alloc: mem::Alloc) -> MintedStart {
    return MintedStart(minter: sys::Minter[Start, Told, u8].of(told, alloc))
} MintedStart.of

pub fn MintedStart.mint(self) -> Start {
    return self.minter.mint(0)
} MintedStart.mint

/// Revokes the capability of this root entry.
pub fn MintedStart.close(take self) {
    let MintedStart(minter: minter) = self
    take minter.close()
} MintedStart.close

/// What the kernel told, `None` once the capability is stale.
pub fn Start.told(self, alloc: mem::Alloc) -> Option[Told] {
    let reached = sys::reach(self, body: fn(state: Told, record: u8) => state)
    if reached.is_some() {
        return reached
    }
    let Ok(given) = attempt os::invoked_bare(sys::Handle.of(self), operation: CROSS_TOLD, args: b"", alloc) else {
        return None
    }
    return match attempt mem::wire::Codec[Told].decode(Untrusted.of(given.view()), alloc) {
        Ok(told) => Some(told)
        Err(_) => None
    }
} Start.told

/// The encoding of what the kernel told, for `keys` in its isolated space.
pub fn Start.invoke(
    self,
    operation: u64,
    args: Untrusted[Slice[u8]],
    handles: Slice[sys::Handle],
    alloc: mem::Alloc,
    ) -> sys::Encoded fails sys::CrossError limits stack 4_096 {
    if operation != CROSS_TOLD or handles.len() > 0 {
        fail sys::CrossError.Refused
    }
    let Some(told) = sys::reach(self, body: fn(state: Told, record: u8) => state) else {
        fail sys::CrossError.Revoked(sys::Revoked.Stale)
    }
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[Told].encode(told, out: mut bytes)
    return os::bare_answer(take bytes, alloc)
} Start.invoke

/// Tells at once, as `invoke` does.
pub fn Start.call(
    self,
    operation: u64,
    args: Untrusted[Slice[u8]],
    handles: Slice[sys::Handle],
    alloc: mem::Alloc,
    ) -> sys::Encoded fails sys::CrossError limits stack 4_096 {
    return try self.invoke(operation, args, handles, alloc)
} Start.call
