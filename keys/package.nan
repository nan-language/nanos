//! What the `keys` instance serves, its Env, what the kernel tells it at its start, and the work behind its operations: the machine's keys sealed with the TPM or held in software, the principals' keys, and the signatures they verify.

package keys {
    language 1
    targets any
    dep crypto "../crypto"
    dep devices "../devices"
    dep ident "../ident"
    dep journal "../journal"
    dep os "../os"
    dep store "../store"
    allow capability in keys
    allow validate in devices, ident, journal, keys, os, store
} keys
