//! The `boot` instance: each boot recorded in `/sys/boot` and `/live/boot`.

package generations {
    language 1
    targets any
    dep bootfmt "../bootfmt"
    dep devices "../devices"
    dep ident "../ident"
    dep journal "../journal"
    dep os "../os"
    dep store "../store"
    allow validate in bootfmt, devices, generations, ident, journal, os, store
} generations
