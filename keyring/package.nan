//! The `keyring` program: the `keys` instance as the bundle the generation ships, which the core runs alone in the isolated space `keys`.

package keyring {
    language 1
    targets x86_64-nanos
    entry Keyring
    dep crypto "../crypto"
    dep ident "../ident"
    dep journal "../journal"
    dep keys "../keys"
    dep os "../os"
    dep store "../store"
    allow validate in ident, journal, keyring, keys, os, store
} keyring
