//! The `keys` instance: the link, audit and keyring master keys it generates from the kernel's entropy and keeps in its checkpoint, encrypted under a key the TPM seals or in plaintext without one, the principal records it writes at enrollment, rotation and revocation, and the signatures it verifies against them.

/// The key of the keyed task bringing `/sys/principals/owner` to the loader's owner key.
const OWNING: u64 = 1

/// The key of the keyed task publishing what `keys` tells of the machine's security.
const SHOWING: u64 = 2

/// The keys of the keyed tasks sealing the machine's keys and unsealing them.
const KEEPING: u64 = 3

const UNSEALING: u64 = 4

/// The key of the keyed task serving a request, plus its number.
const SERVING: u64 = 0x1_0000_0000

/// The type of the part of `/live/security` `keys` publishes.
const KEYS_SECURITY_TYPE: Str = "os::KeysSecurity"

/// The state of `keys`, its checkpoint: the machine's keys as it keeps them, once generated.
pub closed struct Keyring derives Encode {
    pub kept: Option[keys::Kept]
} Keyring

impl Keyring: sys::Component[keys::Env, keys::Keys]

impl Keyring: sys::Resume[keys::Env, keys::Keys]

pub fn Keyring.start(mut env: keys::Env) -> Keyring = Keyring(kept: None)

/// Once its checkpoints are kept: generates the machine's keys when it holds none and keeps them, seals keys it holds in plaintext on a machine with a TPM, unseals the keys it holds sealed, publishes its part of `/live/security`, and brings the owner's record to the loader's owner key.
pub fn Keyring.resume(mut self, reason: sys::ResumeReason, mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) {
    if not env.kept {
        return
    }
    mut self.hold(mut env, mut cx)
    let principals = env.principals
    let events = env.events
    let owner = env.owner
    let alloc = env.alloc
    mut cx.spawn(key: OWNING, run: fn(out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
        try await keys::own(principals, events, owner, alloc)
    })
} Keyring.resume

/// Holds the machine's keys: those it generates when it keeps none, those it keeps in plaintext, sealed anew on a machine with a TPM, or, from a keyed task, those the TPM unseals.
fn Keyring.hold(mut self, mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) {
    let Some(kept) = self.kept else {
        mut self.keep(keys::generated(env.random), mut env, mut cx)
        return
    }
    let copy = kept.copied(env.alloc)
    match copy {
        keys::Kept.Plain(held) => {
            if env.tpm.is_some() {
                mut self.keep(held, mut env, mut cx)
                return
            }
            env.held = Some(held)
            mut self.show(mut env, mut cx)
        }
        keys::Kept.Sealed(blob: _, nonce: _, keys: _) => {
            let tpm = env.tpm
            let alloc = env.alloc
            mut cx.spawn(key: UNSEALING, run: fn[take copy](out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
                try await keys::unseal(out, kept: take copy, tpm, alloc)
            })
        }
    }
} Keyring.hold

/// Holds `held` and keeps it: sealed by the TPM from a keyed task, the checkpoint taking it once sealed, or in plaintext at once without a TPM.
fn Keyring.keep(mut self, held: keys::Held, mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) {
    env.held = Some(held)
    let Some(tpm) = env.tpm else {
        self.kept = Some(keys::Kept.Plain(held))
        discard attempt mut cx.sync()
        mut self.show(mut env, mut cx)
        return
    }
    let random = env.random
    let alloc = env.alloc
    mut cx.spawn(key: KEEPING, run: fn(out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
        try await keys::keep(out, held, tpm, random, alloc)
    })
} Keyring.keep

/// Takes the form in which the checkpoint keeps the machine's keys, has it checkpointed at once, and publishes its part of `/live/security`.
fn Keyring.stored(mut self, take kept: keys::Kept, mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) {
    self.kept = Some(take kept)
    discard attempt mut cx.sync()
    mut self.show(mut env, mut cx)
} Keyring.stored

/// Holds the machine's keys the TPM unsealed, and publishes its part of `/live/security`; without them `keys` serves nothing that needs them.
fn Keyring.unsealed(mut self, take held: Option[keys::Held], mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) {
    env.held = held
    mut self.show(mut env, mut cx)
} Keyring.unsealed

pub fn Keyring.verify(
    mut self,
    take principal: ident::Principal,
    take kind: text::String,
    take subject: ident::HashValue,
    take signature: ident::Signature,
    take former: bool,
    mut env: keys::Env,
    mut cx: sys::Cx[keys::Keys],
    ) fails keys::KeysFailure {
    let principals = env.principals
    let alloc = env.alloc
    let Some(request) = mut cx.postpone() else {
        fail keys::KeysFailure.Unavailable
    }
    mut cx.spawn(key: SERVING + request, run: fn[take principal, take kind](out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
        let outcome = try await keys::verify(principals, principal, kind: kind.as_str(), subject, signature, former, alloc)
        discard attempt await keys::answer(out, request, reply: keys::reply_of(outcome, alloc))
    })
    fail keys::KeysFailure.Unavailable
} Keyring.verify

pub fn Keyring.verify_key(
    mut self,
    take principal: ident::Principal,
    take kind: text::String,
    take key: Array[u8, 32],
    take former: bool,
    mut env: keys::Env,
    mut cx: sys::Cx[keys::Keys],
    ) fails keys::KeysFailure {
    let principals = env.principals
    let alloc = env.alloc
    let Some(request) = mut cx.postpone() else {
        fail keys::KeysFailure.Unavailable
    }
    mut cx.spawn(key: SERVING + request, run: fn[take principal, take kind](out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
        let outcome = try await keys::verify_key(principals, principal, kind: kind.as_str(), key, former, alloc)
        discard attempt await keys::answer(out, request, reply: keys::reply_of(outcome, alloc))
    })
    fail keys::KeysFailure.Unavailable
} Keyring.verify_key

pub fn Keyring.enroll(
    mut self,
    take principal: ident::Principal,
    take key: Array[u8, 32],
    mut env: keys::Env,
    mut cx: sys::Cx[keys::Keys],
    ) fails keys::KeysFailure {
    if not env.kept {
        fail keys::KeysFailure.Unavailable
    }
    if not keys::enrollable(principal) {
        fail keys::KeysFailure.InvalidOperand
    }
    let principals = env.principals
    let data = env.data
    let alloc = env.alloc
    let Some(request) = mut cx.postpone() else {
        fail keys::KeysFailure.Unavailable
    }
    mut cx.spawn(key: SERVING + request, run: fn[take principal](out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
        let outcome = try await keys::enroll(principals, data, take principal, key, alloc)
        discard attempt await keys::answer(out, request, reply: keys::reply_of(outcome, alloc))
    })
    fail keys::KeysFailure.Unavailable
} Keyring.enroll

pub fn Keyring.issue(mut self, take child: ident::Principal, mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) -> keys::Issued fails keys::KeysFailure {
    if not env.kept {
        fail keys::KeysFailure.Unavailable
    }
    let seed = keys::drawn(env.random)
    return keys::Issued(key: core::crypto::SecretKey.of_seed(seed).public_key().bytes, seed: seed)
} Keyring.issue

/// The envelope of a secret record: its secret id, a random nonce, and the XChaCha20-Poly1305 sealing of `value` under its node key, with the secret id and `schema` as associated data.
pub fn Keyring.seal_secret(
    mut self,
    take secret: u64,
    take seed: Array[u8, 32],
    take schema: ident::HashValue,
    take value: mem::Bytes,
    mut env: keys::Env,
    mut cx: sys::Cx[keys::Keys],
    ) -> mem::Bytes fails store::service::Failure {
    let Some(held) = env.held else {
        fail store::service::Failure.Denied
    }
    if self.kept.is_none() {
        fail store::service::Failure.Denied
    }
    let alloc = env.alloc
    var nonce = Array[u8, 24].filled(0)
    discard attempt env.random.fill(mut nonce.view_mut())
    var envelope = mem::Bytes.empty(alloc)
    for at in 0..<8u32 {
        mut envelope.push(u8.truncate(secret >> (8 * at)))
    }
    var aad = mem::Bytes.empty(alloc)
    mut aad.append(envelope.view())
    mut aad.append(schema.bytes.view())
    mut envelope.append(nonce.view())
    mut envelope.append(crypto::seal(keys::node_key(held.master, seed, secret, alloc), nonce, aad: aad.view(), plain: value.view(), alloc).view())
    return envelope
} Keyring.seal_secret

/// A new volume key and its sealing by the TPM, from a keyed task; `store.locked` without a TPM.
pub fn Keyring.volume_key(mut self, mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) -> store::service::VolumeKey fails store::service::Failure {
    let Some(tpm) = env.tpm else {
        fail store::service::Failure.Locked
    }
    let random = env.random
    let alloc = env.alloc
    let Some(request) = mut cx.postpone() else {
        fail store::service::Failure.Locked
    }
    mut cx.spawn(key: SERVING + request, run: fn(out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
        let reply = try await keys::volume_key(tpm, random, alloc)
        discard attempt await keys::answer(out, request, take reply)
    })
    fail store::service::Failure.Locked
} Keyring.volume_key

/// The volume key the TPM unseals of `sealed`, from a keyed task; `store.locked` without a TPM.
pub fn Keyring.open_volume(mut self, take sealed: mem::Bytes, mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) -> Array[u8, 32] fails store::service::Failure {
    let Some(tpm) = env.tpm else {
        fail store::service::Failure.Locked
    }
    let alloc = env.alloc
    let Some(request) = mut cx.postpone() else {
        fail store::service::Failure.Locked
    }
    mut cx.spawn(key: SERVING + request, run: fn[take sealed](out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
        let reply = try await keys::open_volume(tpm, take sealed, alloc)
        discard attempt await keys::answer(out, request, take reply)
    })
    fail store::service::Failure.Locked
} Keyring.open_volume

pub fn Keyring.rotate(mut self, take rotation: keys::Rotation, mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) fails keys::KeysFailure {
    if not env.kept {
        fail keys::KeysFailure.Unavailable
    }
    let events = env.events
    let alloc = env.alloc
    match rotation {
        keys::Rotation.Principal(principal: principal, key: key) => {
            let principals = env.principals
            let Some(request) = mut cx.postpone() else {
                fail keys::KeysFailure.Unavailable
            }
            mut cx.spawn(key: SERVING + request, run: fn[take principal](out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
                let outcome = try await keys::rotate(principals, principal: ident::Principal(text: principal.text), key, alloc)
                if outcome.is_ok() {
                    try await events.emit("auth.key-rotated", severity: journal::Severity.Notice, payload: keys::KeyRotated.Principal(take principal), alloc)
                }
                discard attempt await keys::answer(out, request, reply: keys::reply_of(outcome, alloc))
            })
            fail keys::KeysFailure.Unavailable
        }
        keys::Rotation.Link => {
            let Some(held) = env.held else {
                fail keys::KeysFailure.Unavailable
            }
            mut self.keep(keys::Held(link_static: keys::drawn(env.random), link_identity: keys::drawn(env.random), audit: held.audit, master: held.master), mut env, mut cx)
            mut self.rotated(keys::KeyRotated.Link, mut env, mut cx)
        }
        keys::Rotation.Audit => {
            let Some(held) = env.held else {
                fail keys::KeysFailure.Unavailable
            }
            mut self.keep(keys::Held(link_static: held.link_static, link_identity: held.link_identity, audit: keys::drawn(env.random), master: held.master), mut env, mut cx)
            mut self.rotated(keys::KeyRotated.Audit, mut env, mut cx)
        }
    }
} Keyring.rotate

pub fn Keyring.revoke(mut self, take principal: ident::Principal, mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) fails keys::KeysFailure {
    if not env.kept {
        fail keys::KeysFailure.Unavailable
    }
    let principals = env.principals
    let events = env.events
    let alloc = env.alloc
    let Some(request) = mut cx.postpone() else {
        fail keys::KeysFailure.Unavailable
    }
    mut cx.spawn(key: SERVING + request, run: fn[take principal](out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
        let outcome = try await keys::revoke(principals, principal: ident::Principal(text: principal.text), alloc)
        if outcome.is_ok() {
            try await events.emit("auth.key-revoked", severity: journal::Severity.Notice, payload: keys::KeyRevoked(principal: take principal), alloc)
        }
        discard attempt await keys::answer(out, request, reply: keys::reply_of(outcome, alloc))
    })
    fail keys::KeysFailure.Unavailable
} Keyring.revoke

fn Keyring.answered(
    mut self,
    take request: u64,
    take reply: sys::Encoded,
    mut env: keys::Env,
    mut cx: sys::Cx[keys::Keys],
    ) {
    discard attempt mut cx.reply(request, reply)
    mut cx.cancel(key: SERVING + request)
} Keyring.answered

/// Emits `auth.key-rotated` naming `rotated` and publishes the new public keys.
fn Keyring.rotated(mut self, take rotated: keys::KeyRotated, mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) {
    mut self.show(mut env, mut cx)
    let events = env.events
    let alloc = env.alloc
    mut cx.spawn(key: SERVING, run: fn[take rotated](out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
        try await events.emit("auth.key-rotated", severity: journal::Severity.Notice, payload: rotated, alloc)
    })
} Keyring.rotated

/// Publishes the part of `/live/security` `keys` tells once it holds and keeps the machine's keys: whether it runs in its isolated space, whether the TPM seals its keys, and the public halves of the link key.
fn Keyring.show(mut self, mut env: keys::Env, mut cx: sys::Cx[keys::Keys]) {
    let alloc = env.alloc
    let identity = match env.held {
        Some(held) => core::crypto::SecretKey.of_seed(held.link_identity).public_key().bytes
        None => return
    }
    let storage = match self.kept {
        Some(kept) => kept.storage()
        None => return
    }
    var ed25519 = mem::Bytes.empty(alloc)
    mut ed25519.append(identity.view())
    let space = match env.isolated {
        true => os::KeysSpace.Isolated
        false => os::KeysSpace.Unconfined
    }
    let part = os::KeysSecurity(keys: space, key_storage: storage, link_keys: os::LinkKeys(x25519: mem::Bytes.empty(alloc), ed25519: take ed25519))
    let live = env.live
    mut cx.spawn(key: SHOWING, run: fn[take part](out: sys::Outbox[keys::Keys]) fails task::Cancelled uses wait limits stack 32_768 {
        try await live.publish(type: KEYS_SECURITY_TYPE, value: part, alloc)
    })
} Keyring.show
