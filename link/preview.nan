//! Previews: a plan's tree steps applied, one commit each, to a preview branch forked from the head of the plan's branch through a View acting for the plan's principal in its session, and the commands of its other steps read; its effect set computed and decided by the policy; the branch deleted at the end.

/// A session open when a preview starts: its id, its principal and the instances on its transport's path.
pub closed struct OpenSession derives Encode {
    pub session: ident::SessionId
    pub principal: ident::Principal
    pub path: mem::List[ident::Moniker]
} OpenSession

/// What a preview needs: the steps and options, the principal and the session previewing, what the principal holds, the configuration of plans, the session's taint, the sessions open, whether values are JSON, and the UTC time.
pub closed struct Planning derives Encode {
    pub steps: mem::List[Written]
    pub options: Options
    pub principal: ident::Principal
    pub session: ident::SessionId
    pub holding: Holding
    pub plans: PlanConfig
    pub taint: mem::List[ident::OriginLabel]
    pub open: mem::List[OpenSession]
    pub json: bool
    pub now_utc: i64
} Planning

/// The part of a plan one commit applies: its number, the writes of each of its steps in order, the nodes they read, the instances it activates, and the commands of its steps.
pub closed struct SpanWork derives Encode {
    pub span: u32
    pub steps: mem::List[StepWrites]
    pub reads: mem::List[NodeRead]
    pub activations: mem::List[Activation]
    pub commands: mem::List[InstanceStep]
} SpanWork

/// The writes of a step of a span, in order: a tree step's, or those the run of a command's message makes.
pub closed struct StepWrites derives Encode {
    pub step: u32
    pub writes: mem::List[store::Write]
} StepWrites

/// A plan a preview kept: its hash, its record, the work of its spans, the subjects the policy decides, and the records printing its effect set.
pub closed struct Previewed derives Encode {
    pub hash: ident::HashValue
    pub plan: Plan
    pub spans: mem::List[SpanWork]
    pub subjects: mem::List[policy::Subject]
    pub records: mem::List[Record]
} Previewed

/// What a preview gives: the plan it kept, or the failure ending it.
pub closed enum Preview derives Encode {
    Kept(Previewed)
    Failed(Failure)
} Preview

/// A step previewed: its number, the commits of the preview branch before and after it, what it made of the tree, and the command it makes.
pub closed struct Stepped derives Encode {
    pub step: u32
    pub before: ident::CommitId
    pub after: ident::CommitId
    pub made: Made
    pub command: Option[InstanceStep]
} Stepped

/// Previews the plan `asked` writes through `tree`, describing the instances its commands name through `control`, deciding it with `oversight`.
pub fn preview(
    take asked: Planning,
    tree: store::service::View,
    control: os::Control,
    oversight: os::Port[policy::Oversight],
    alloc: mem::Alloc,
    ) -> Preview fails task::Cancelled uses wait {
    let target = asked.options.branch.as_str()
    let acting = match first attempt await acting_on(tree, branch: target, principal: ident::Principal(text: asked.principal.text), session: asked.session, origins: labels_of(asked.taint, alloc), alloc) {
        Ok(view) => view
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => return Preview.Failed(Failure.of(failed.code().as_str(), subject: target, alloc))
    }
    let branched = match first attempt await acting.preview(alloc) {
        Ok(made) => made
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => return Preview.Failed(Failure.of(failed.code().as_str(), subject: target, alloc))
    }
    let store::service::Branched(branch: branch, view: forked) = branched
    let outcome = try await preview_on(asked, tree, planned: acting, forked, branch: branch.name.as_str(), base: branch.head, control, oversight, alloc)
    match attempt await acting.delete_branch(text::String.of(branch.name.as_str(), alloc), alloc) {
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
    return outcome
} preview

/// Applies each tree step of `asked` to the preview branch `branch` through `forked`, its head at `base`, and reads the command of each other step through `planned`, a View of the plan's branch, and `control`, running its message on a fork of its instance there, then computes the plan's effect set, reading what it reserves through the link's View `tree`.
fn preview_on(
    asked: Planning,
    tree: store::service::View,
    planned: store::service::View,
    forked: store::service::View,
    branch: Str,
    base: ident::CommitId,
    control: os::Control,
    oversight: os::Port[policy::Oversight],
    alloc: mem::Alloc,
    ) -> Preview fails task::Cancelled uses wait {
    var stepped = mem::List[Stepped].empty(alloc)
    var forking = MessageRuns.none(alloc)
    var head = base
    var index: u32 = 0
    for written in asked.steps {
        index += 1
        match written.step {
            Step.Call(moniker: _, operation: _, arguments: _) or Step.Redeliver(moniker: _, seq: _) or Step.RestoreCheckpoint(moniker: _, number: _) => {
                var commanded = match try await command_of(written, step: index, view: planned, control, holding: asked.holding, now_utc: asked.now_utc, alloc) {
                    Ok(found) => found
                    Err(failure) => return Preview.Failed(take failure)
                }
                let Ran(before: before, writes: writes, after: after) = match try await message_run(mut commanded, view: forked, branch, head, control, mut forking, alloc) {
                    Ok(found) => found
                    Err(failure) => return Preview.Failed(take failure)
                }
                mut stepped.push(Stepped(step: index, before: before, after: after, made: Made(writes: take writes, reads: mem::List.empty(alloc)), command: Some(take commanded)))
                head = after
                continue
            }
            else => {
            }
        }
        let made = match try await materialize(written, view: forked, branch: asked.options.branch.as_str(), holding: asked.holding, now_utc: asked.now_utc, json: asked.json, base, alloc) {
            Ok(found) => found
            Err(failure) => return Preview.Failed(take failure)
        }
        var after = head
        if made.writes.len() > 0 {
            let Some(writes) = duplicate(made.writes, alloc) else {
                return Preview.Failed(Failure.of("store.corrupt", subject: written.text.as_str(), alloc))
            }
            let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: None, plan: None, intent: None)
            after = match first attempt await forked.commit(take transaction, typed: true, alloc) {
                Ok(done) => done.number
                Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
                Err(failed) => return Preview.Failed(Failure.of(failed.code().as_str(), subject: written.text.as_str(), alloc))
            }
        }
        mut stepped.push(Stepped(step: index, before: head, after: after, made: take made, command: None))
        head = after
    }
    return try await effects_of(asked, tree, planned, forked, branch, base, mut stepped, forked_runs: take forking.runs, control, oversight, alloc)
} preview_on

/// A View of the branch `branch` with the subtree and rights of `tree`, acting for `principal` in `session` and stamping `origins`.
pub fn acting_on(
    tree: store::service::View,
    branch: Str,
    take principal: ident::Principal,
    session: ident::SessionId,
    take origins: mem::List[ident::OriginLabel],
    alloc: mem::Alloc,
    ) -> store::service::View fails store::service::ViewError uses wait {
    if branch == RUNNING_BRANCH {
        return try await tree.acting(take principal, session, take origins, alloc)
    }
    let store::service::Branched(branch: _, view: reached) = try await tree.on_branch(text::String.of(branch, alloc), alloc)
    return try await reached.acting(take principal, session, take origins, alloc)
} acting_on

/// A copy of `value`, through its encoding.
pub fn duplicate[T: Encode](value: T, alloc: mem::Alloc) -> Option[T] {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[T].encode(value, out: mut bytes)
    return match attempt mem::wire::Codec[T].decode(Untrusted.of(bytes.view()), alloc) {
        Ok(copy) => Some(take copy)
        Err(_) => None
    }
} duplicate
