//! Chapter 14's records: reversibility, the effect set a preview computes, the previewed plan its hash names, the outbox, the plan lifecycle and timed plans.

/// The class of an effect, named by what undoes it, ordered `None` < `Recorded` < `Restorable` < `Irreversible`.
pub closed enum Reversibility derives Copy, Eq, Encode {
    None
    Recorded
    Restorable
    Irreversible(kinds: IrreversibleKinds)
} Reversibility

pub closed struct IrreversibleKinds derives Copy, Eq, Encode {
    pub emit: bool
    pub actuate: bool
    pub erase: bool
    pub spend: bool
} IrreversibleKinds

impl Reversibility: Render

/// Its name, an irreversible class as `irreversible{`, its kinds in the order `emit`, `actuate`, `erase`, `spend` separated by `,`, then `}`.
pub fn Reversibility.render(self, mut out: core::Renderer) {
    match self {
        Reversibility.None => mut out.write("none")
        Reversibility.Recorded => mut out.write("recorded")
        Reversibility.Restorable => mut out.write("restorable")
        Reversibility.Irreversible(kinds: kinds) => {
            mut out.write("irreversible{")
            var separated = false
            if kinds.emit {
                mut out.write("emit")
                separated = true
            }
            if kinds.actuate {
                if separated {
                    mut out.write(",")
                }
                mut out.write("actuate")
                separated = true
            }
            if kinds.erase {
                if separated {
                    mut out.write(",")
                }
                mut out.write("erase")
                separated = true
            }
            if kinds.spend {
                if separated {
                    mut out.write(",")
                }
                mut out.write("spend")
            }
            mut out.write("}")
        }
    }
} Reversibility.render

/// The rank of the class in the order of classes, irreversible classes sharing the highest.
fn Reversibility.rank(self) -> u8 {
    return match self {
        Reversibility.None => 0
        Reversibility.Recorded => 1
        Reversibility.Restorable => 2
        Reversibility.Irreversible(kinds: _) => 3
    }
} Reversibility.rank

/// The join of two classes: the greater, the union of their kinds for two irreversible ones.
pub fn Reversibility.join(self, other: Reversibility) -> Reversibility
    example Reversibility.Recorded.join(Reversibility.Restorable) == Reversibility.Restorable
    example Reversibility.Irreversible(kinds: IrreversibleKinds(emit: true, actuate: false, erase: false, spend: false)).join(Reversibility.Irreversible(kinds: IrreversibleKinds(emit: false, actuate: false, erase: true, spend: false))) == Reversibility.Irreversible(kinds: IrreversibleKinds(emit: true, actuate: false, erase: true, spend: false))
{
    match self {
        Reversibility.Irreversible(kinds: mine) => match other {
            Reversibility.Irreversible(kinds: theirs) => return Reversibility.Irreversible(kinds: IrreversibleKinds(emit: mine.emit or theirs.emit, actuate: mine.actuate or theirs.actuate, erase: mine.erase or theirs.erase, spend: mine.spend or theirs.spend))
            else => return self
        }
        else => {
        }
    }
    if other.rank() > self.rank() {
        return other
    }
    return self
} Reversibility.join

/// Whether the class is irreversible.
pub fn Reversibility.is_irreversible(self) -> bool = self.rank() == 3

/// What a preview computes: the plan's base and branch, each step's effect, the delta, the activations, widenings, deliveries and faults, the approvals the policy requires, the transport cuts, the previewing session's taint, and the costs.
pub closed struct EffectSet derives Render, Encode {
    pub base: ident::CommitId
    pub branch: text::String
    pub steps: mem::List[StepEffect]
    pub delta: mem::List[NodeChange]
    pub activations: mem::List[Activation]
    pub widenings: mem::List[Widening]
    pub deliveries: mem::List[Delivery]
    pub faults: mem::List[Fault]
    pub approvals: mem::List[ApprovalNeed]
    pub cuts: mem::List[TransportCut]
    /// The origin labels of the previewing session's taint.
    pub taint: mem::List[ident::OriginLabel]
    pub costs: Costs
} EffectSet

pub closed struct StepEffect derives Render, Encode {
    pub step: u32
    pub span: u32
    pub class: Reversibility
    pub basis: Basis
    /// The encoded reply of a `call` step.
    pub reply: Option[mem::Bytes]
} StepEffect

pub closed enum Basis derives Copy, Eq, Render, Encode {
    Observed
    Declared
} Basis

pub closed struct NodeChange derives Render, Encode {
    pub path: ident::Path
    pub step: u32
    /// Content hashes; `None` where the node is absent.
    pub before: Option[ident::HashValue]
    pub after: Option[ident::HashValue]
} NodeChange

pub closed struct Activation derives Render, Encode {
    pub moniker: ident::Moniker
    pub step: u32
    pub kind: ActivationKind
    pub migration: Option[Migration]
    /// The expected intake pause.
    pub pause_ms: u32
    /// The CPU the instance's reservation gets.
    pub cpu: Option[u32]
} Activation

pub closed enum ActivationKind derives Copy, Eq, Render, Encode {
    Start
    Stop
    Restart
    Update
    Rebuild
    Reboot
} ActivationKind

pub closed enum Migration derives Copy, Eq, Render, Encode {
    Identical
    Additive
    Migrated
} Migration

pub closed struct Widening derives Render, Encode {
    pub holder: ident::Principal
    pub step: u32
    pub authority: text::String
    /// The CPU the reservation of a `Session` grant gets.
    pub cpu: Option[u32]
} Widening

pub closed struct Delivery derives Render, Encode {
    pub step: u32
    pub kind: DeliveryKind
    /// The principal, or the instance as `inst.<moniker>`, whose authority performs it.
    pub issuer: ident::Principal
    /// `<moniker>.<operation>`, or `<capability kind>.<operation>`.
    pub target: text::String
    /// The code hash of the bundle that handles a `Message` delivery, its target's, or runs a `Spawn` delivery, its issuer's; `None` for a `Capability` delivery.
    pub code: Option[ident::HashValue]
    /// The host and port of an `Egress` delivery; else empty.
    pub destination: text::String
    pub size_bytes: u64
    pub blake3: ident::HashValue
    pub class: Reversibility
} Delivery

pub closed enum DeliveryKind derives Copy, Eq, Render, Encode {
    Message
    Capability
    Spawn
} DeliveryKind

pub closed struct Fault derives Render, Encode {
    pub moniker: ident::Moniker
    pub step: u32
    pub kind: FaultKind
    pub report: text::String
} Fault

pub closed enum FaultKind derives Copy, Eq, Render, Encode {
    Trap
    Unhealthy
    Opaque
} FaultKind

pub closed struct ApprovalNeed derives Render, Encode {
    /// The index of the deciding rule in `/sys/policy`.
    pub rule: u32
    pub decision: text::String
    pub reason: text::String
    pub approvers: mem::List[text::String]
} ApprovalNeed

pub closed struct TransportCut derives Render, Encode {
    pub session: ident::SessionId
    pub principal: ident::Principal
    pub step: u32
} TransportCut

pub closed struct Costs derives Copy, Eq, Render, Encode {
    pub cpu_ns: u64
    pub memory_bytes: i64
    pub store_bytes: u64
    pub energy_mj: u64
} Costs

/// A previewed plan, which its plan hash names.
pub closed struct Plan derives Render, Encode {
    pub principal: ident::Principal
    /// The canonical text of each step.
    pub steps: mem::List[text::String]
    pub options: PlanOptions
    pub effects: EffectSet
    pub inputs: RecordedInputs
} Plan

pub closed struct PlanOptions derives Render, Encode {
    pub intent: Option[text::String]
    pub confirm_within_s: Option[u32]
    pub health_s: u32
} PlanOptions

pub closed struct RecordedInputs derives Render, Encode {
    pub reads: mem::List[NodeRead]
    pub live: mem::List[LiveRead]
    pub values: mem::List[RecordedValue]
} RecordedInputs

pub closed struct NodeRead derives Render, Encode {
    pub path: ident::Path
    /// The commit that last wrote the node; `#0` when it is absent.
    pub commit: ident::CommitId
} NodeRead

pub closed struct LiveRead derives Render, Encode {
    pub path: ident::Path
    pub hash: ident::HashValue
} LiveRead

pub closed struct RecordedValue derives Render, Encode {
    pub step: u32
    pub source: ValueSource
    pub value: mem::Bytes
} RecordedValue

pub closed enum ValueSource derives Copy, Eq, Render, Encode {
    Store
    Clock
    Random
    Capability
} ValueSource

/// Whether a step of the span numbered `span` changes a node of the delta.
pub fn EffectSet.changes_span(self, span: u32) -> bool {
    for change in self.delta {
        if self.steps.position(fn(each: StepEffect) => each.step == change.step and each.span == span).is_some() {
            return true
        }
    }
    return false
} EffectSet.changes_span

/// The plan's hash: the hash of kind `plan` of the encoding of the plan with every cost zero.
pub fn Plan.hashed(mut self, alloc: mem::Alloc) -> ident::HashValue {
    let costs = self.effects.costs
    self.effects.costs = Costs(cpu_ns: 0, memory_bytes: 0, store_bytes: 0, energy_mj: 0)
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[Plan].encode(self, out: mut bytes)
    self.effects.costs = costs
    return ident::HashValue.of_object(ident::Kind.Plan, bytes: bytes.view())
} Plan.hashed

/// The read-set hash: the hash of kind `read-set` of the encoding of the plan's reads.
pub fn Plan.read_set_hash(self, alloc: mem::Alloc) -> ident::HashValue {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[mem::List[NodeRead]].encode(self.inputs.reads, out: mut bytes)
    return ident::HashValue.of_object(ident::Kind.ReadSet, bytes: bytes.view())
} Plan.read_set_hash

/// The status of an outbox entry.
pub closed enum DeliveryStatus derives Copy, Eq, Render, Encode {
    Held
    Delivering
    Delivered
    Failed
    Cancelled
} DeliveryStatus

/// An irreversible delivery of a committed span, at `/sys/outbox/<plan short hash>-<span>-<n>`.
pub closed struct OutboxEntry derives Render, Encode {
    pub plan: ident::HashValue
    pub span: u32
    pub delivery: Delivery
    pub key: text::String
    /// The encoded message or capability arguments; empty for a spawn.
    pub payload: mem::Bytes
    pub status: DeliveryStatus
    pub attempts: u32
    pub reply: Option[mem::Bytes]
} OutboxEntry

pub closed enum PlanState derives Copy, Eq, Render, Encode {
    Previewed
    AwaitingApproval
    Scheduled
    Applying
    HealthWindow
    Applied
    Reverted
    Denied
    Expired
    Failed
} PlanState

/// The payload of the `plan.<state>` events and of `plan.delivered`.
pub closed struct PlanEvent derives Render, Encode {
    pub plan: ident::HashValue
    pub state: PlanState
    pub span: u32
    pub commit: Option[ident::CommitId]
    /// The outbox entry of a `plan.delivered` event.
    pub entry: Option[text::String]
    pub code: Option[text::String]
} PlanEvent

/// The record of `/live/plans/<hash>`.
pub closed struct LivePlan derives Render, Encode {
    pub state: PlanState
    pub span: u32
    pub commits: mem::List[ident::CommitId]
    /// The end of the running health window or confirmation wait.
    pub until: Option[ident::WallTime]
    /// The plan's outbox entries.
    pub deliveries: mem::List[text::String]
    pub as_of: u64
} LivePlan

/// A plan scheduled by `apply --when`, at `/sys/schedule/<plan short hash>`.
pub closed struct TimedPlan derives Render, Encode {
    pub plan: ident::HashValue
    pub principal: ident::Principal
    pub at: ident::WallTime
    pub key: text::String
} TimedPlan

/// Whether the state ends a plan's lifecycle.
pub fn PlanState.ended(self) -> bool {
    return match self {
        PlanState.Applied or PlanState.Reverted or PlanState.Denied or PlanState.Expired or PlanState.Failed => true
        else => false
    }
} PlanState.ended

/// The kind of the event a transition to the state emits.
pub fn PlanState.event_kind(self) -> text::Fixed[32] {
    let kind = match self {
        PlanState.Previewed => "plan.previewed"
        PlanState.AwaitingApproval => "plan.awaiting-approval"
        PlanState.Scheduled => "plan.scheduled"
        PlanState.Applying => "plan.applying"
        PlanState.HealthWindow => "plan.health-window"
        PlanState.Applied => "plan.applied"
        PlanState.Reverted => "plan.reverted"
        PlanState.Denied => "plan.denied"
        PlanState.Expired => "plan.expired"
        PlanState.Failed => "plan.failed"
    }
    return text::Fixed[32].of(kind)
} PlanState.event_kind

test spans_change_the_nodes_their_steps_change for EffectSet.changes_span {
    let alloc = testing::world().alloc
    var steps = mem::List[StepEffect].empty(alloc)
    mut steps.push(StepEffect(step: 1, span: 1, class: Reversibility.Restorable, basis: Basis.Observed, reply: None))
    mut steps.push(StepEffect(step: 2, span: 2, class: Reversibility.Restorable, basis: Basis.Observed, reply: None))
    var delta = mem::List[NodeChange].empty(alloc)
    mut delta.push(NodeChange(path: ident::Path(text: text::String.of("/data/a", alloc)), step: 2, before: None, after: None))
    let effects = EffectSet(base: ident::CommitId(number: 9), branch: text::String.of("main", alloc), steps: take steps, delta: take delta, activations: mem::List.empty(alloc), widenings: mem::List.empty(alloc), deliveries: mem::List.empty(alloc), faults: mem::List.empty(alloc), approvals: mem::List.empty(alloc), cuts: mem::List.empty(alloc), taint: mem::List.empty(alloc), costs: Costs(cpu_ns: 0, memory_bytes: 0, store_bytes: 0, energy_mj: 0))
    expect not effects.changes_span(span: 1) and effects.changes_span(span: 2)
} spans_change_the_nodes_their_steps_change
