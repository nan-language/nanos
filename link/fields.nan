//! Fields of values in canonical rendering and in JSON: the text of a field, a projection onto fields, comparisons of fields with literals, and a field's value replaced.

/// A range of bytes of a text.
pub closed struct Span derives Copy, Eq {
    pub start: usize
    pub end: usize
} Span

/// The value of the field `path`, names joined by `.`, of the construction text `text`, `None` when it has none.
pub fn field_span(text: Str, path: Str) -> Option[Span] {
    var span = Span(start: 0, end: text.byte_len())
    var start: usize = 0
    let names = path.as_bytes()
    for at in 0..=names.len() {
        if at < names.len() and names[at] != b'.' {
            continue
        }
        let Some(name) = path.slice_bytes(start, end: at) else {
            return None
        }
        let Some(value) = text.slice_bytes(span.start, end: span.end) else {
            return None
        }
        let Some(inner) = top_field(value, name) else {
            return None
        }
        span = Span(start: span.start + inner.start, end: span.start + inner.end)
        start = at + 1
    }
    return Some(span)
} field_span

/// The value of the field `name` at the top level of the parentheses of the construction text `text`.
fn top_field(text: Str, name: Str) -> Option[Span] {
    let bytes = text.as_bytes()
    let Some(open) = text.find("(") else {
        return None
    }
    var depth: u32 = 0
    var quoted: u8 = 0
    var escaped = false
    var item = open + 1
    for at in (open + 1)..<bytes.len() {
        let byte = bytes[at]
        if quoted != 0 {
            if escaped {
                escaped = false
            } else if byte == b'\\' {
                escaped = true
            } else if byte == quoted {
                quoted = 0
            }
            continue
        }
        if byte == b'"' or byte == b'\'' {
            quoted = byte
        } else if byte == b'(' or byte == b'[' or byte == b'{' {
            depth += 1
        } else if (byte == b')' or byte == b']' or byte == b'}') and depth > 0 {
            depth -= 1
        } else if depth == 0 and (byte == b',' or byte == b')') {
            match labelled(text, item: Span(start: item, end: at), name) {
                Some(value) => return Some(value)
                None => {
                }
            }
            item = at + 2
            if byte == b')' {
                return None
            }
        }
    }
    return None
} top_field

/// The value of the item `item` of a construction text when it is `name: value`.
fn labelled(text: Str, item: Span, name: Str) -> Option[Span] {
    let label_end = item.start + name.byte_len()
    if label_end + 2 > item.end {
        return None
    }
    let Some(label) = text.slice_bytes(item.start, end: label_end) else {
        return None
    }
    let Some(colon) = text.slice_bytes(label_end, end: label_end + 2) else {
        return None
    }
    if label != name or colon != ": " {
        return None
    }
    return Some(Span(start: label_end + 2, end: item.end))
} labelled

/// The construction text `text` keeping only the fields `fields`: its name, then each field as `name: value`, in the order given.
pub fn projected(text: Str, fields: mem::List[text::String], alloc: mem::Alloc) -> text::String {
    var written = text::String.empty(alloc)
    let bytes = text.as_bytes()
    for byte in bytes {
        if byte == b'(' {
            break
        }
        mut written.push(char.checked_from_bits(u32.widen(byte)).value_or('?'))
    }
    mut written.push('(')
    var leading = true
    for field in fields {
        let Some(span) = field_span(text, path: field.as_str()) else {
            continue
        }
        let Some(value) = text.slice_bytes(span.start, end: span.end) else {
            continue
        }
        if not leading {
            mut written.append(", ")
        }
        leading = false
        mut written.append(field.as_str())
        mut written.append(": ")
        mut written.append(value)
    }
    mut written.push(')')
    return written
} projected

/// The order of two field values in canonical rendering: numerically when both are integers, else by their text.
pub fn compare_values(left: Str, right: Str) -> core::Ordering {
    match integer_of(left) {
        Some(a) => match integer_of(right) {
            Some(b) => return a.compare(b)
            None => {
            }
        }
        None => {
        }
    }
    return left.as_bytes().cmp(right.as_bytes())
} compare_values

/// Whether the field value `value` compares as `comparator` says with `literal`, a variant naming its type or not.
pub fn holds(value: Str, comparator: Comparator, literal: Str) -> bool {
    return match comparator {
        Comparator.Equal => same(value, literal)
        Comparator.Different => not same(value, literal)
        Comparator.Less => compare_values(value, right: literal) == core::Ordering.Less
        Comparator.LessOrEqual => compare_values(value, right: literal) != core::Ordering.Greater
        Comparator.Greater => compare_values(value, right: literal) == core::Ordering.Greater
        Comparator.GreaterOrEqual => compare_values(value, right: literal) != core::Ordering.Less
        Comparator.Prefix => contained(value, literal, at_start: true)
        Comparator.Contains => contained(value, literal, at_start: false)
    }
} holds

/// Whether two values in canonical rendering are equal, a literal naming a variant without its type matching it.
fn same(value: Str, literal: Str) -> bool {
    if compare_values(value, right: literal) == core::Ordering.Equal {
        return true
    }
    let bytes = value.as_bytes()
    return value.ends_with(literal) and bytes.len() > literal.byte_len() and bytes[bytes.len() - literal.byte_len() - 1] == b'.'
} same

/// Whether the text of `value`, without a text literal's quotes, holds the text of `literal` at its start or anywhere.
fn contained(value: Str, literal: Str, at_start: bool) -> bool {
    let outer = inner_span(value)
    let inner = inner_span(literal)
    let Some(text) = value.slice_bytes(outer.start, end: outer.end) else {
        return false
    }
    let Some(part) = literal.slice_bytes(inner.start, end: inner.end) else {
        return false
    }
    if at_start {
        return text.starts_with(part)
    }
    return text.find(part).is_some()
} contained

/// The span of `text` without the quotes of a text literal.
fn inner_span(text: Str) -> Span {
    if text.byte_len() >= 2 and text.starts_with("\"") and text.ends_with("\"") {
        return Span(start: 1, end: text.byte_len() - 1)
    }
    return Span(start: 0, end: text.byte_len())
} inner_span

/// An integer by its sign and magnitude.
struct Integer derives Copy, Eq {
    negative: bool
    magnitude: u64
} Integer

fn Integer.compare(self, other: Integer) -> core::Ordering {
    if self.negative != other.negative {
        return match self.negative {
            true => core::Ordering.Less
            false => core::Ordering.Greater
        }
    }
    let order = self.magnitude.cmp(other.magnitude)
    if not self.negative {
        return order
    }
    return match order {
        core::Ordering.Less => core::Ordering.Greater
        core::Ordering.Greater => core::Ordering.Less
        core::Ordering.Equal => core::Ordering.Equal
    }
} Integer.compare

/// The integer `text` writes in decimal, `None` for any other text.
fn integer_of(text: Str) -> Option[Integer] {
    let bytes = text.as_bytes()
    if bytes.len() == 0 {
        return None
    }
    let negative = bytes[0] == b'-'
    var start: usize = 0
    if negative {
        start = 1
    }
    if start >= bytes.len() or bytes.len() - start > 20 {
        return None
    }
    var magnitude: u64 = 0
    for at in start..<bytes.len() {
        let byte = bytes[at]
        if byte < b'0' or byte > b'9' {
            return None
        }
        let Some(scaled) = magnitude.checked_mul(10) else {
            return None
        }
        let Some(added) = scaled.checked_add(u64.widen(byte - b'0')) else {
            return None
        }
        magnitude = added
    }
    return Some(Integer(negative: negative, magnitude: magnitude))
} integer_of

test fields_of_renderings_compare_and_project for field_span {
    let alloc = testing::world().alloc
    let text = "Event(time_ns: 3127000000, source: app.feeds, kind: \"instance.failed\", severity: Severity.Error, payload: InstanceFailed(code: \"a, b\", restarts: 5))"
    let Some(restarts) = field_span(text, path: "payload.restarts") else {
        expect false
        return
    }
    expect text.slice_bytes(restarts.start, end: restarts.end) == Some("5")
    let Some(severity) = field_span(text, path: "severity") else {
        expect false
        return
    }
    let Some(level) = text.slice_bytes(severity.start, end: severity.end) else {
        expect false
        return
    }
    expect holds(level, comparator: Comparator.Equal, literal: "Error")
    var fields = mem::List[text::String].empty(alloc)
    mut fields.push(text::String.of("kind", alloc))
    mut fields.push(text::String.of("time_ns", alloc))
    let narrowed = projected(text, fields, alloc)
    expect narrowed.as_str() == "Event(kind: \"instance.failed\", time_ns: 3127000000)"
    expect compare_values("41000000000", right: "9") == core::Ordering.Greater
} fields_of_renderings_compare_and_project

/// The value of the member `path`, names joined by `.`, of the JSON object `json`, `None` when it has none.
pub fn json_field_span(json: Str, path: Str) -> Option[Span] {
    var span = Span(start: 0, end: json.byte_len())
    var start: usize = 0
    let names = path.as_bytes()
    for at in 0..=names.len() {
        if at < names.len() and names[at] != b'.' {
            continue
        }
        let Some(name) = path.slice_bytes(start, end: at) else {
            return None
        }
        let Some(inner) = json_member(json, within: span, name) else {
            return None
        }
        span = inner
        start = at + 1
    }
    return Some(span)
} json_field_span

/// The value of the member `name` of the JSON object lying at `within` in `json`.
fn json_member(json: Str, within: Span, name: Str) -> Option[Span] {
    let bytes = json.as_bytes()
    var at = json_blank(bytes, from: within.start, end: within.end)
    if at >= within.end or bytes[at] != b'{' {
        return None
    }
    at += 1
    while at < within.end {
        at = json_blank(bytes, from: at, end: within.end)
        if at >= within.end or bytes[at] != b'"' {
            return None
        }
        let key_end = json_value_end(bytes, from: at, end: within.end)
        let Some(key) = json.slice_bytes(at + 1, end: key_end.saturating_sub(1)) else {
            return None
        }
        at = json_blank(bytes, from: key_end, end: within.end)
        if at >= within.end or bytes[at] != b':' {
            return None
        }
        let value_start = json_blank(bytes, from: at + 1, end: within.end)
        let value_end = json_value_end(bytes, from: value_start, end: within.end)
        if key == name {
            return Some(Span(start: value_start, end: value_end))
        }
        at = json_blank(bytes, from: value_end, end: within.end)
        if at >= within.end or bytes[at] != b',' {
            return None
        }
        at += 1
    }
    return None
} json_member

/// The first byte from `from` on that is no JSON whitespace.
fn json_blank(bytes: Slice[u8], from: usize, end: usize) -> usize {
    var at = from
    while at < end and (bytes[at] == b' ' or bytes[at] == b'\n' or bytes[at] == b'\r' or bytes[at] == b'\t') {
        at += 1
    }
    return at
} json_blank

/// The end of the JSON value starting at `from`: past its closing quote, bracket or brace, or before the delimiter ending a scalar.
fn json_value_end(bytes: Slice[u8], from: usize, end: usize) -> usize {
    var depth: u32 = 0
    var quoted = false
    var escaped = false
    var at = from
    while at < end {
        let byte = bytes[at]
        if quoted {
            if escaped {
                escaped = false
            } else if byte == b'\\' {
                escaped = true
            } else if byte == b'"' {
                quoted = false
                if depth == 0 {
                    return at + 1
                }
            }
            at += 1
            continue
        }
        if byte == b'"' {
            quoted = true
        } else if byte == b'{' or byte == b'[' {
            depth += 1
        } else if byte == b'}' or byte == b']' {
            if depth == 0 {
                return at
            }
            depth -= 1
            if depth == 0 {
                return at + 1
            }
        } else if depth == 0 and byte == b',' {
            return at
        }
        at += 1
    }
    return at
} json_value_end

/// `json` with the value of its member `path` replaced by `value`, `None` when it has no such member.
pub fn json_spliced(json: Str, path: Str, value: Str, alloc: mem::Alloc) -> Option[text::String] {
    let Some(span) = json_field_span(json, path) else {
        return None
    }
    let Some(head) = json.slice_bytes(0, end: span.start) else {
        return None
    }
    let Some(tail) = json.slice_bytes(span.end, end: json.byte_len()) else {
        return None
    }
    var spliced = text::String.of(head, alloc)
    mut spliced.append(value)
    mut spliced.append(tail)
    return Some(take spliced)
} json_spliced

test json_members_are_found_and_replaced for json_spliced {
    let alloc = testing::world().alloc
    let json = "{\"budget\":{\"limit\":3,\"names\":[\"a,b\",\"c\"]},\"stopped\":false, \"plans\": {\"health_s\": 30}}"
    let stopped = json_spliced(json, path: "stopped", value: "true", alloc)
    let health = json_spliced(json, path: "plans.health_s", value: "0", alloc)
    let missing = json_spliced(json, path: "plans.keep_s", value: "0", alloc)
    let spliced_stop = match stopped {
        Some(text) => text.as_str() == "{\"budget\":{\"limit\":3,\"names\":[\"a,b\",\"c\"]},\"stopped\":true, \"plans\": {\"health_s\": 30}}"
        None => false
    }
    let nested = match health {
        Some(text) => text.as_str().ends_with("{\"health_s\": 0}}")
        None => false
    }
    expect spliced_stop and nested and missing.is_none()
} json_members_are_found_and_replaced
