//! The `link` instance: the protocol through which agents and humans reach the system, served on the serial and port transports.

/// The keys of the keyed tasks: the serial transport's reader, the one reading the facts of the ready record, the one handing lines to `console`, the one reading the principals' grants, the one telling the journal and `/live` of sessions, the one reverting the plans a restart interrupted, and those answering requests and writing to each connection, plus the slot of each.
const READING: u64 = 1

const OPENING: u64 = 3

const CONSOLING: u64 = 4

const GRANTING: u64 = 5

const NOTIFYING: u64 = 6

const RECOVERING: u64 = 7

const ANSWERING: u64 = 0x1_0000_0000

const WRITING: u64 = 0x4_0000_0000

/// The most requests running at once, each keeping the slot its keyed task's key names.
const MOST_RUNNING: u64 = 256

/// What `link` serves: the connections of resident agents, the messages of the store's subscriptions, and those of its own keyed tasks and timers.
pub protocol LinkSession {
    /// Opens a connection whose blocks go to `client`, a port of `LinkClient`, for the calling instance, whose earlier connection is lost.
    pub fn open(client: os::PortHandle) -> u64 fails Refusal limits traceless
    /// Takes one request line on the calling instance's connection.
    pub fn send(line: text::String) limits irreversible(emit, actuate, erase, spend)
    /// A commit changed nodes below a subscription's prefix.
    pub fn changed(subscription: u64, commit: ident::CommitId, paths: mem::List[ident::Path], more: u64) limits traceless
    /// An append to a stream below a subscription's prefix.
    pub fn appended(subscription: u64, path: ident::Path, seq: u64) limits traceless
    /// Commits a subscription could not be told of.
    pub fn lost(subscription: u64, commits: u64) limits traceless
    /// What a line received on serial gives.
    fn received(received: Received) limits traceless
    /// The connection numbered `connection` took the block it was given, or is lost.
    fn written(connection: u64, lost: bool) limits traceless
    /// `console` took the line it was handed.
    fn handed() limits traceless
    /// The facts the link reads at its start.
    fn opened(facts: Facts) limits traceless
    /// The request numbered `number` ended with the block `block`.
    fn responded(number: u64, block: Block) limits traceless
    /// The `hello` numbered `number` goes on.
    fn hello_step(number: u64, step: HelloStep) limits traceless
    /// The request numbered `number` has run for `LinkConfig.pending_ms`.
    fn due(number: u64) limits traceless
    /// The watch numbered `number` started as `start` says.
    fn watching(number: u64, start: WatchStart) limits traceless
    /// The matches of the watch numbered `number` up to the cursor `cursor`, as the block `block`, and whether the read stopped at the backlog.
    fn delivered(number: u64, block: Block, cursor: u64, full: bool) limits traceless
    /// The watch numbered `number` has matches to deliver.
    fn push_due(number: u64) limits traceless
    /// What the principals holding sessions hold, read after `/sys/grants` or `/sys/principals` changed.
    fn granted(holdings: mem::List[Holding]) limits traceless
    /// The session numbered `session` may have reached its end.
    fn session_due(session: u64) limits traceless
    /// The journal and `/live` took the notice at the head of the queue.
    fn notified() limits traceless
    /// The `plan` numbered `number` ended its preview as `outcome` says.
    fn previewed(number: u64, outcome: Preview) limits traceless
    /// The plan the `apply` numbered `number` applies went on as `moved` says.
    fn plan_moved(number: u64, moved: Moved) limits traceless
} LinkSession

/// What a resident agent serves for the blocks of its connection.
pub protocol LinkClient {
    /// One block, its lines ending in LF.
    pub fn block(text: text::String) limits traceless
} LinkClient

/// Why `LinkSession.open` refuses a connection: the link holds its most connections, or the client is no port of `LinkClient`.
pub closed enum Refusal derives Copy, Eq, Render, Encode {
    SessionLimit
    InvalidClient
} Refusal

/// The ready record.
pub closed struct LinkReady derives Encode {
    pub version: u32
    pub mode: text::String
    pub generation: u64
    pub claimed: bool
    /// The cursor of the `events` stream.
    pub cursor: ident::Cursor
    /// The hash of the link's Ed25519 identity public key.
    pub key: ident::HashValue
} LinkReady

/// The facts the link read at its start: the ready record, the boot counter, the console role's driver, and the subscriptions telling it of changes to `/sys/grants` and `/sys/principals`.
pub closed struct Facts derives Encode {
    pub ready: LinkReady
    pub boot: u64
    pub console: Option[ident::Moniker]
    pub grants: Option[u64]
    pub principals: Option[u64]
} Facts

/// The Env of `link`: the console UART, its View of the tree, its ports to `keys`, to `console` and to `policy`, the port the store tells its subscriptions through, its source of events, where it publishes `/live/sessions` and `/live/plans`, the names of the instances calling it, the kernel's entropy, the clocks, its configuration, the clients of its port connections, the uploads under way and its cell.
pub open struct Env derives Send {
    console: os::Port[devices::Console]
    tree: store::service::View
    keys: os::Port[keys::Keys]
    attendant: os::Port[console::Console]
    oversight: os::Port[policy::Oversight]
    control: os::Control
    own: os::PortHandle
    events: journal::Source
    live: os::Live
    plans_live: os::Live
    callers: os::Callers
    random: sys::Random
    clock: sys::Clock
    wall: ident::Wall
    config: LinkConfig
    clients: mem::List[Client]
    uploads: mem::List[Upload]
    alloc: mem::Alloc
} Env

/// A request running: its number, the slot its keyed task's key names, its connection and its session, 0 for none, its id, verb and first operand, how its blocks are cut, whether its `pending` block went out, and for `hello` the principal it names and the session it resumes.
pub closed struct Running derives Encode {
    pub number: u64
    pub slot: u64
    pub connection: u64
    pub session: u64
    pub id: text::Fixed[32]
    pub verb: text::Fixed[16]
    pub operand: text::String
    pub cut: Cut
    pub pending: bool
    pub principal: Option[ident::Principal]
    pub resume: Option[u64]
    pub keyed: Option[Keyed]
} Running

/// The state of `link`: its configuration, the facts read at its start, its connections and the number of the next, the requests running and the number of the next, the sessions open and the number of the next, what the principals holding them hold and what their sessions spent and gained, whether their grants are being read and whether they changed meanwhile, the watches, when the ready record went out, the console lines waiting for `console` and whether one is being handed over, the notices waiting for the journal and `/live` and whether one is being told, the plans it keeps, and the results of the latest mutating requests of each session.
pub closed struct Linker derives Encode {
    pub config: LinkConfig
    pub facts: Option[Facts]
    pub connections: mem::List[Connection]
    pub next_connection: u64
    pub running: mem::List[Running]
    pub next: u64
    pub sessions: mem::List[Session]
    pub next_session: u64
    pub holdings: mem::List[Holding]
    pub tallies: mem::List[Tally]
    pub granting: bool
    pub stale: bool
    pub watches: mem::List[Watch]
    pub ready_ns: u64
    pub lines: mem::List[text::String]
    pub consoling: bool
    pub notices: mem::List[Notice]
    pub notifying: bool
    pub plans: mem::List[KeptPlan]
    pub results: mem::List[KeptResult]
} Linker

impl Linker: sys::Component[Env, LinkSession]

impl Linker: sys::Resume[Env, LinkSession]

pub fn Env.of(
    console: os::Port[devices::Console],
    tree: store::service::View,
    keys: os::Port[keys::Keys],
    attendant: os::Port[console::Console],
    oversight: os::Port[policy::Oversight],
    control: os::Control,
    own: os::PortHandle,
    events: journal::Source,
    live: os::Live,
    plans_live: os::Live,
    callers: os::Callers,
    random: sys::Random,
    clock: sys::Clock,
    wall: ident::Wall,
    config: LinkConfig,
    alloc: mem::Alloc,
    ) -> Env {
    return Env(console: console, tree: tree, keys: keys, attendant: attendant, oversight: oversight, control: control, own: own, events: events, live: live, plans_live: plans_live, callers: callers, random: random, clock: clock, wall: wall, config: config, clients: mem::List.empty(alloc), uploads: mem::List.empty(alloc), alloc: alloc)
} Env.of

pub fn Linker.start(mut env: Env) -> Linker {
    let alloc = env.alloc
    var connections = mem::List[Connection].empty(alloc)
    mut connections.push(Connection.of(SERIAL_CONNECTION, transport: Transport.Serial, opener: 0, slot: 0, alloc))
    return Linker(config: env.config, facts: None, connections: take connections, next_connection: SERIAL_CONNECTION + 1, running: mem::List.empty(alloc), next: 1, sessions: mem::List.empty(alloc), next_session: 1, holdings: mem::List.empty(alloc), tallies: mem::List.empty(alloc), granting: false, stale: false, watches: mem::List.empty(alloc), ready_ns: 0, lines: mem::List.empty(alloc), consoling: false, notices: mem::List.empty(alloc), notifying: false, plans: mem::List.empty(alloc), results: mem::List.empty(alloc))
} Linker.start

/// Listens on serial, reads the facts of the ready record and subscribes to the grants and principals, and once started reverts each span commit that awaited its confirmation when `link` stopped.
pub fn Linker.resume(mut self, reason: sys::ResumeReason, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    let console = env.console
    let tree = env.tree
    let own = env.own
    let alloc = env.alloc
    mut cx.spawn(key: READING, run: fn(out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 32_768 {
        try await read_serial(console, out, alloc)
    })
    mut cx.spawn(key: OPENING, run: fn(out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 32_768 {
        let facts = try await facts_of(tree, own, alloc)
        discard attempt await out.opened(take facts)
    })
    if reason == sys::ResumeReason.Started {
        mut cx.spawn(key: RECOVERING, run: fn(out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 32_768 {
            try await recover_plans(tree, alloc)
        })
    }
} Linker.resume

/// Writes the ready record to each connection, ahead of any block.
fn Linker.opened(mut self, take facts: Facts, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    self.facts = Some(take facts)
    self.ready_ns = now_ns(env.clock)
    for at in 0..<self.connections.len() {
        let block = self.ready_block(env.alloc)
        mut self.connections[at].output.insert(0, value: take block)
    }
    mut self.summarize(mut env, mut cx)
    for at in 0..<self.connections.len() {
        mut self.write(self.connections[at].number, mut env, mut cx)
    }
} Linker.opened

/// The ready record's block.
fn Linker.ready_block(self, alloc: mem::Alloc) -> mem::Bytes {
    var block = Block.of(Verdict.Ok, id: "0", verb: "link", operand: "", alloc)
    let Some(facts) = self.facts else {
        return block.text(self.cut(budget: self.config.budget, alloc), alloc)
    }
    let ready = facts.ready
    var record = Record.of("link", alloc)
    mut record.field("version", value: Dyn[Render].view(ready.version))
    mut record.text("mode", value: ready.mode.as_str(), alloc)
    mut record.field("generation", value: Dyn[Render].view(ready.generation))
    mut record.field("claimed", value: Dyn[Render].view(ready.claimed))
    mut record.field("cursor", value: Dyn[Render].view(ready.cursor))
    mut record.hash("key", value: ready.key)
    mut block.records.push(take record)
    return block.text(self.cut(budget: self.config.budget, alloc), alloc)
} Linker.ready_block

fn Linker.responded(
    mut self,
    take number: u64,
    take block: Block,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let Some(at) = self.running.position(fn(each: Running) => each.number == number) else {
        return
    }
    let done = mut self.running.remove(at)
    mut env.forget_upload(number)
    mut self.keep_result(done, block, alloc: env.alloc)
    mut self.deliver(connection: done.connection, session: done.session, take block, cut: done.cut, mut env, mut cx)
} Linker.responded

/// Answers `pending` for a request still running.
fn Linker.due(mut self, take number: u64, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    let alloc = env.alloc
    let Some(at) = self.running.position(fn(each: Running) => each.number == number) else {
        return
    }
    var block = self.running[at].block(Verdict.Pending, alloc)
    mut block.records.push(self.pending_record(number, alloc))
    self.running[at].pending = true
    let connection = self.running[at].connection
    let session = self.running[at].session
    mut self.answer(connection, session, take block, mut env, mut cx)
} Linker.due

/// Reads the request `text` received on the connection numbered `connection` and runs it.
fn Linker.request(
    mut self,
    connection: u64,
    text: Str,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    match Request.read(text, alloc) {
        Read.Refused(id: id, verb: verb, operand: operand, failure: failure) => mut self.answer(connection, session: 0, block: failed_block(id: id.as_str(), verb: verb.as_str(), operand: operand.as_str(), take failure, alloc), mut env, mut cx)
        Read.Request(request) => mut self.run(connection, take request, mut env, mut cx)
    }
} Linker.request

/// Runs `request` of the connection numbered `connection`: refuses it when the session rules, the session's budget or its authority do, else answers it, at once or from a keyed task, which answers `pending` past `pending_ms`.
fn Linker.run(
    mut self,
    connection: u64,
    take request: Request,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    let session = match self.session_for(connection, request, alloc) {
        Ok(number) => number
        Err(failure) => {
            mut self.answer(connection, session: 0, block: refusal(request, take failure, alloc), mut env, mut cx)
            return
        }
    }
    match self.refused(connection, session, request, now_utc: now_utc_ns(env.wall, clock: env.clock), alloc) {
        Some(failure) => {
            mut self.answer(connection, session, block: refusal(request, take failure, alloc), mut env, mut cx)
            return
        }
        None => {
        }
    }
    let Some(slot) = self.free_slot() else {
        mut self.answer(connection, session, block: refusal(request, failure: Failure.of("budget.exhausted", subject: "requests", alloc), alloc), mut env, mut cx)
        return
    }
    let number = self.next
    self.next += 1
    let cut = self.cut_for(request, budget: self.budget_of(session), alloc)
    mut self.running.push(Running(number: number, slot: slot, connection: connection, session: session, id: request.id, verb: request.verb, operand: first_operand(request, alloc), cut: take cut, pending: false, principal: None, resume: None, keyed: None))
    match mut self.keyed_request(request, session, mut env, mut cx) {
        true => {
        }
        false => return
    }
    match request.verb.as_str() {
        "watch" => mut self.watch(take request, number, mut env, mut cx)
        "cancel" => mut self.cancel(take request, number, mut env, mut cx)
        "hello" => mut self.hello(request, number, mut env, mut cx)
        "plan" => mut self.plan(take request, number, mut env, mut cx)
        "undo" => mut self.undo(take request, number, mut env, mut cx)
        "put" => mut self.put(take request, number, mut env, mut cx)
        "apply" => mut self.apply(take request, number, mut env, mut cx)
        "confirm" => mut self.confirm(take request, number, mut env, mut cx)
        else => mut self.spawn_answer(take request, number, slot, session, mut env, mut cx)
    }
} Linker.run

/// Has a keyed task answer the request numbered `number` through the link's View, within the budget of its session.
fn Linker.spawn_answer(
    mut self,
    take request: Request,
    number: u64,
    slot: u64,
    session: u64,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    let tree = env.tree
    let budget = self.budget_of(session)
    let reader = self.principal_of_session(session)
    mut cx.spawn(key: ANSWERING + slot, run: fn[take request, take reader](out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 65_536 {
        let block = try await answer(request, tree, budget, reader, alloc)
        discard attempt await out.responded(number, take block)
    })
    mut cx.after(ms: u64.widen(self.config.pending_ms), send: LinkSession.due(number: number))
} Linker.spawn_answer

/// The failure of a request the rules refuse once its session is known: an id pending on its connection, a flag of the wrong form, a session's spent output budget, or a path its authority does not let it read.
fn Linker.refused(
    self,
    connection: u64,
    session: u64,
    request: Request,
    now_utc: i64,
    alloc: mem::Alloc,
    ) -> Option[Failure] {
    if self.running.position(fn(each: Running) => each.connection == connection and each.id == request.id).is_some() or self.watching_id(connection, id: request.id.as_str()) {
        return Some(Failure.of("request.duplicate-id", subject: request.id.as_str(), alloc))
    }
    match flag_failure(request, alloc) {
        Some(failure) => return Some(take failure)
        None => {
        }
    }
    if session == 0 or request.verb.as_str() == "hello" {
        return None
    }
    if self.attention_spent(session) {
        return Some(Failure.of("budget.attention", subject: session_text(session).as_str(), alloc))
    }
    for path in read_paths(request, alloc) {
        if not self.reads(session, path: path.as_str(), now_utc) {
            return Some(Failure.of("auth.denied", subject: path.as_str(), alloc).expecting("tree.read", found: "no grant covering the path", alloc))
        }
    }
    return None
} Linker.refused

/// Whether a watch of a session on the connection numbered `connection` has the id `id`.
fn Linker.watching_id(self, connection: u64, id: Str) -> bool {
    for watch in self.watches {
        if watch.id.as_str() != id {
            continue
        }
        match self.sessions.position(fn(each: Session) => each.number == watch.session) {
            Some(at) => {
                if self.sessions[at].connection == Some(connection) {
                    return true
                }
            }
            None => {
            }
        }
    }
    return false
} Linker.watching_id

/// The failure of a `--budget` or `--skip` of the wrong form.
fn flag_failure(request: Request, alloc: mem::Alloc) -> Option[Failure] {
    match request.flag("budget") {
        Some(units) => {
            if number_of(units).value_or(0) < 100 {
                return Some(Failure.of("request.invalid-flag", subject: "--budget", alloc).expecting("at least 100 units", found: units, alloc))
            }
        }
        None => {
        }
    }
    match request.flag("skip") {
        Some(count) => {
            if number_of(count).is_none() {
                return Some(Failure.of("request.invalid-flag", subject: "--skip", alloc).expecting("a number of records", found: count, alloc))
            }
        }
        None => {
        }
    }
    return None
} flag_failure

/// The lowest slot no request running holds, `None` when `MOST_RUNNING` run.
fn Linker.free_slot(self) -> Option[u64] {
    for slot in 0..<MOST_RUNNING {
        if self.running.position(fn(each: Running) => each.slot == slot).is_none() {
            return Some(slot)
        }
    }
    return None
} Linker.free_slot

/// The principal of the session numbered `session`, `system` for none.
fn Linker.principal_of_session(self, session: u64) -> ident::Principal {
    return match self.sessions.position(fn(each: Session) => each.number == session) {
        Some(at) => ident::Principal(text: self.sessions[at].principal.text)
        None => ident::Principal(text: text::Fixed[64].of("system"))
    }
} Linker.principal_of_session

/// The key of the keyed task answering the request numbered `number`.
fn Linker.key_of(self, number: u64) -> u64 {
    return match self.running.position(fn(each: Running) => each.number == number) {
        Some(at) => ANSWERING + self.running[at].slot
        None => ANSWERING + MOST_RUNNING
    }
} Linker.key_of

/// Answers the request running at `at` with `block`.
fn Linker.respond(
    mut self,
    at: usize,
    take block: Block,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let done = mut self.running.remove(at)
    mut self.keep_result(done, block, alloc: env.alloc)
    mut self.deliver(connection: done.connection, session: done.session, take block, cut: done.cut, mut env, mut cx)
} Linker.respond

/// Sends `block` to the connection numbered `connection`, cut to the budget of the session numbered `session`.
fn Linker.answer(
    mut self,
    connection: u64,
    session: u64,
    take block: Block,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    let cut = self.cut(budget: self.budget_of(session), alloc)
    mut self.deliver(connection, session, take block, cut, mut env, mut cx)
} Linker.answer

/// How the blocks no request names the rest of are cut under `budget`.
fn Linker.cut(self, budget: os::SessionBudget, alloc: mem::Alloc) -> Cut {
    return Cut(budget: budget.response_units, sized: budget.output_units.is_some(), skip: 0, rest: text::String.empty(alloc), fields: mem::List.empty(alloc), json: false)
} Linker.cut

/// How the blocks of `request` are cut and written: its `--budget`, `--skip`, `--fields` and `--json`, the session's budget `budget` otherwise.
fn Linker.cut_for(self, request: Request, budget: os::SessionBudget, alloc: mem::Alloc) -> Cut {
    var cut = request_cut(request, budget, alloc)
    cut.rest = rest_of(request, alloc)
    return cut
} Linker.cut_for
