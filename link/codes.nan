//! The code catalogue: each failure code of the specification with its section and meaning, which `describe <code>` prints.

/// The record `describe <code>` prints for `code`, `code <code>, section` with its meaning on a continuation line; `None` for no such code.
pub fn code_record(code: Str, alloc: mem::Alloc) -> Option[Record] {
    let bytes = CATALOGUE.as_bytes()
    var start: usize = 0
    for at in 0..=bytes.len() {
        if at < bytes.len() and bytes[at] != b'\n' {
            continue
        }
        let Some(line) = CATALOGUE.slice_bytes(start, end: at) else {
            return None
        }
        start = at + 1
        let Some(record) = catalogued(line, code, alloc) else {
            continue
        }
        return Some(take record)
    }
    return None
} code_record

/// The record of the catalogue line `line`, `<code>|<section>|<meaning>`, when it names `code`.
fn catalogued(line: Str, code: Str, alloc: mem::Alloc) -> Option[Record] {
    if not line.starts_with(code) or line.byte_len() <= code.byte_len() or line.as_bytes()[code.byte_len()] != b'|' {
        return None
    }
    let Some(rest) = line.slice_bytes(code.byte_len() + 1, end: line.byte_len()) else {
        return None
    }
    let Some(bar) = rest.find("|") else {
        return None
    }
    let Some(section) = rest.slice_bytes(0, end: bar) else {
        return None
    }
    let Some(meaning) = rest.slice_bytes(bar + 1, end: rest.byte_len()) else {
        return None
    }
    var record = Record.of("code", alloc)
    mut record.words(code)
    mut record.text("section", value: section, alloc)
    mut record.line(meaning, alloc)
    return Some(take record)
} catalogued

/// The codes of the catalogue nearest `name` by edit distance, at most 3, nearest first.
pub fn nearest_codes(name: Str, alloc: mem::Alloc) -> mem::List[text::String] {
    return nearest(name, among: catalogued_codes(alloc), alloc)
} nearest_codes

/// The codes of the catalogue.
pub fn catalogued_codes(alloc: mem::Alloc) -> mem::List[text::String] {
    var codes = mem::List[text::String].empty(alloc)
    let bytes = CATALOGUE.as_bytes()
    var start: usize = 0
    for at in 0..=bytes.len() {
        if at < bytes.len() and bytes[at] != b'\n' {
            continue
        }
        let Some(line) = CATALOGUE.slice_bytes(start, end: at) else {
            continue
        }
        start = at + 1
        let Some(bar) = line.find("|") else {
            continue
        }
        let Some(code) = line.slice_bytes(0, end: bar) else {
            continue
        }
        mut codes.push(text::String.of(code, alloc))
    }
    return codes
} catalogued_codes

/// The at most 3 names among `among` nearest to `name` by edit distance, nearest first.
pub fn nearest(name: Str, among: mem::List[text::String], alloc: mem::Alloc) -> mem::List[text::String] {
    var ranked = mem::List[Ranked].empty(alloc)
    for candidate in among {
        mut ranked.push(Ranked(distance: edit_distance(name, b: candidate.as_str(), alloc), code: text::String.of(candidate.as_str(), alloc)))
    }
    mut ranked.sort_by(fn(left: Ranked, right: Ranked) => left.distance.cmp(right.distance))
    var closest = mem::List[text::String].empty(alloc)
    for each in take ranked {
        if closest.len() >= 3 {
            break
        }
        mut closest.push(take each.code)
    }
    return closest
} nearest

/// A name with its edit distance from another.
struct Ranked {
    distance: usize
    code: text::String
} Ranked

/// The Levenshtein distance between the bytes of `a` and of `b`.
pub fn edit_distance(a: Str, b: Str, alloc: mem::Alloc) -> usize {
    let left = a.as_bytes()
    let right = b.as_bytes()
    var row = mem::List[usize].empty(alloc)
    for at in 0..=right.len() {
        mut row.push(at)
    }
    for i in 1..=left.len() {
        var diagonal = row[0]
        row[0] = i
        for j in 1..=right.len() {
            let above = row[j]
            var cost: usize = 1
            if left[i - 1] == right[j - 1] {
                cost = 0
            }
            var best = diagonal + cost
            if above + 1 < best {
                best = above + 1
            }
            if row[j - 1] + 1 < best {
                best = row[j - 1] + 1
            }
            row[j] = best
            diagonal = above
        }
    }
    return row[right.len()]
} edit_distance

