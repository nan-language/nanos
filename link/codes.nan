test codes_name_their_section_and_meaning for code_record {
    let alloc = testing::world().alloc
    let Some(record) = code_record("link.session-limit", alloc) else {
        expect false
        return
    }
    expect record.header.as_str() == " link.session-limit, section: \"18-link Sessions\""
    let prefix = code_record("link.session", alloc)
    expect prefix.is_none()
} codes_name_their_section_and_meaning
