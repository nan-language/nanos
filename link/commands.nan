//! Commands: the work of `call`, `redeliver` and `restore-checkpoint` steps, which the runner carries out through the link's `Control` once their span commits, and the deliveries they make.

/// What a step has the runner do to an instance once its span commits.
pub closed enum Command derives Encode {
    /// Calls an operation with the call the step's message encodes, through the protocol of hash `hash`: a request whose replies `reply` reads, or a one-way call when `None`.
    Call(hash: sys::ProtocolHash, reply: Option[mem::wire::NamedSchema])
    /// Delivers the instance's dead letter `seq` again, a call of the protocol of hash `hash`.
    Redeliver(seq: u64, hash: sys::ProtocolHash)
    /// Restarts the instance from a copy of its checkpoint `number`.
    Restore(number: u64)
} Command

/// A step's command to an instance: its step, the instance and the bundle it runs, the command, the operation a call or a redelivery reaches with the message it sends, its class, the operation's declared class for those, and what a forked run of its message foresaw.
pub closed struct InstanceStep derives Encode {
    pub step: u32
    pub moniker: ident::Moniker
    pub code: ident::HashValue
    pub command: Command
    pub operation: text::String
    pub message: mem::Bytes
    pub class: Reversibility
    pub foreseen: Option[Foreseen]
} InstanceStep

/// What a forked run of a step's message foresaw: the encoding of the reply to a call, the messages the handler sent the instance and the classes of the keyed tasks it spawned.
pub closed struct Foreseen derives Encode {
    pub reply: Option[mem::Bytes]
    pub sent: mem::List[os::HeldOutput]
    pub spawns: mem::List[sys::Reversibility]
} Foreseen

/// The command the step `written`, numbered `step`, makes, the instance it names described through `control` and its `/state` read through `view`; `request.unknown-name` for an instance `control` does not know.
pub fn command_of(
    written: Written,
    step: u32,
    view: store::service::View,
    control: os::Control,
    holding: Holding,
    now_utc: i64,
    alloc: mem::Alloc,
    ) -> Result[InstanceStep, Failure] fails task::Cancelled uses wait {
    let moniker = match written.step {
        Step.Call(moniker: named, operation: _, arguments: _) or Step.Redeliver(moniker: named, seq: _) or Step.RestoreCheckpoint(moniker: named, number: _) => ident::Moniker(text: named.text)
        else => return Err(Failure.of("request.invalid-operand", subject: written.text.as_str(), alloc).expecting("a call, redeliver or restore-checkpoint step", found: written.text.as_str(), alloc))
    }
    let described = match first attempt await control.describe(ident::Moniker(text: moniker.text), alloc) {
        Ok(found) => found
        Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
        Err(os::ControlError.Missing) => return Err(Failure.of("request.unknown-name", subject: moniker.text.as_str(), alloc).expecting("an instance's moniker", found: moniker.text.as_str(), alloc))
        Err(failed) => return Err(Failure.of(failed.code().as_str(), subject: moniker.text.as_str(), alloc))
    }
    let os::Described(schema: schema, bundle: bundle) = described
    let named = Named(step: step, text: text::String.of(written.text.as_str(), alloc), moniker: take moniker, code: bundle)
    return match written.step {
        Step.Call(moniker: _, operation: operation, arguments: arguments) => call_command(take named, schema, operation: operation.as_str(), arguments: arguments.as_str(), holding, now_utc, alloc)
        Step.Redeliver(moniker: _, seq: seq) => try await redeliver_command(take named, schema, seq, view, holding, now_utc, alloc)
        Step.RestoreCheckpoint(moniker: _, number: number) => try await restore_command(take named, number, view, holding, now_utc, alloc)
        else => Err(Failure.of("request.invalid-operand", subject: written.text.as_str(), alloc))
    }
} command_of

/// A step naming an instance: its number and text, the instance and the bundle it runs.
struct Named {
    step: u32
    text: text::String
    moniker: ident::Moniker
    code: ident::HashValue
} Named

/// The call of `operation` with `arguments` the step `named` makes, of the protocol `schema`: `auth.denied` unless `holding` lets its principal call the operation at the UTC time `now_utc`, `request.unknown-name` for an operation the protocol lacks, and the failures of encoding its arguments.
fn call_command(
    take named: Named,
    schema: sys::ProtocolSchema,
    operation: Str,
    arguments: Str,
    holding: Holding,
    now_utc: i64,
    alloc: mem::Alloc,
    ) -> Result[InstanceStep, Failure] {
    if not holding.calls(named.moniker, operation, now_utc) {
        return Err(denied(target_of(named.moniker, operation, alloc).as_str(), right: "port", alloc))
    }
    let Some(at) = schema.operations.position(fn(each: sys::OperationSchema) => each.name.as_str() == operation) else {
        var expected = text::String.of("an operation of the instance's protocol among:", alloc)
        for each in schema.operations {
            mut expected.push(' ')
            mut expected.append(each.name.as_str())
        }
        return Err(Failure.of("request.unknown-name", subject: operation, alloc).expecting(expected.as_str(), found: operation, alloc))
    }
    let declared = schema.operations[at]
    let message = match encoded_call(declared, arguments, alloc) {
        Ok(bytes) => bytes
        Err(failure) => return Err(take failure)
    }
    let Named(step: step, text: _, moniker: moniker, code: code) = named
    return Ok(InstanceStep(step: step, moniker: take moniker, code: code, command: Command.Call(hash: schema.hash, reply: reply_schema(declared, alloc)), operation: text::String.of(operation, alloc), message: take message, class: declared_class(declared.class), foreseen: None))
} call_command

/// The redelivery of the dead letter `seq` the step `named` makes, its operation of the protocol `schema`: `auth.denied` unless `holding` lets its principal call the operation at the UTC time `now_utc`; `instance.no-dead-letter` and `instance.dead-letter-empty` for a letter the instance does not keep or that holds no message.
fn redeliver_command(
    take named: Named,
    schema: sys::ProtocolSchema,
    seq: u64,
    view: store::service::View,
    holding: Holding,
    now_utc: i64,
    alloc: mem::Alloc,
    ) -> Result[InstanceStep, Failure] fails task::Cancelled uses wait {
    let Some(node) = try await kept_node(view, moniker: named.moniker, dir: "dead", number: seq, alloc) else {
        return Err(Failure.of("instance.no-dead-letter", subject: named.text.as_str(), alloc))
    }
    let Some(raw) = node.value else {
        return Err(Failure.of("instance.no-dead-letter", subject: named.text.as_str(), alloc))
    }
    let letter = match attempt mem::wire::Codec[os::DeadLetter].decode(raw.view(), alloc) {
        Ok(found) => found
        Err(_) => return Err(Failure.of("store.corrupt", subject: named.text.as_str(), alloc))
    }
    let os::DeadLetter(seq: _, incarnation: _, time: _, header: _, sender: _, operation: operation, message: message, kind: _, report: _, redeliveries: _) = letter
    let Some(sent) = message else {
        return Err(Failure.of("instance.dead-letter-empty", subject: named.text.as_str(), alloc))
    }
    if not holding.calls(named.moniker, operation: operation.as_str(), now_utc) {
        return Err(denied(target_of(named.moniker, operation: operation.as_str(), alloc).as_str(), right: "port", alloc))
    }
    let Some(declared) = schema.operations.position(fn(each: sys::OperationSchema) => each.name.as_str() == operation.as_str()) else {
        return Err(Failure.of("request.unknown-name", subject: operation.as_str(), alloc).expecting("an operation of the instance's protocol", found: operation.as_str(), alloc))
    }
    let class = declared_class(schema.operations[declared].class)
    let Named(step: step, text: _, moniker: moniker, code: code) = named
    return Ok(InstanceStep(step: step, moniker: take moniker, code: code, command: Command.Redeliver(seq: seq, hash: schema.hash), operation: take operation, message: take sent, class: class, foreseen: None))
} redeliver_command

/// The restore of the checkpoint `number` the step `named` makes: `auth.denied` unless `holding` lets its principal restart the instance at the UTC time `now_utc`, `instance.no-checkpoint` for a checkpoint the instance does not keep.
fn restore_command(
    take named: Named,
    number: u64,
    view: store::service::View,
    holding: Holding,
    now_utc: i64,
    alloc: mem::Alloc,
    ) -> Result[InstanceStep, Failure] fails task::Cancelled uses wait {
    if not holding.controls(named.moniker, right: os::Right.Lifecycle, now_utc) {
        return Err(denied(named.moniker.text.as_str(), right: "instance.lifecycle", alloc))
    }
    let checkpoint_node = try await kept_node(view, moniker: named.moniker, dir: "checkpoint", number, alloc)
    if checkpoint_node.is_none() {
        return Err(Failure.of("instance.no-checkpoint", subject: named.text.as_str(), alloc))
    }
    let Named(step: step, text: _, moniker: moniker, code: code) = named
    return Ok(InstanceStep(step: step, moniker: take moniker, code: code, command: Command.Restore(number: number), operation: text::String.empty(alloc), message: mem::Bytes.empty(alloc), class: Reversibility.Restorable, foreseen: None))
} restore_command

/// The node `/state/<moniker>/<dir>/<number>` through `view`, `None` when the instance does not keep it.
fn kept_node(
    view: store::service::View,
    moniker: ident::Moniker,
    dir: Str,
    number: u64,
    alloc: mem::Alloc,
    ) -> Option[store::Node] fails task::Cancelled uses wait {
    var path = text::String.of("/state/", alloc)
    mut path.append(moniker.text.as_str())
    mut path.push('/')
    mut path.append(dir)
    mut path.push('/')
    mut path.write(Dyn[Render].view(number), budget: 24)
    return match try await node_at(view, path: path.as_str(), alloc) {
        Ok(found) => found
        Err(_) => None
    }
} kept_node

/// `<moniker>.<operation>`, the target of a delivery.
pub fn target_of(moniker: ident::Moniker, operation: Str, alloc: mem::Alloc) -> text::String {
    var target = text::String.of(moniker.text.as_str(), alloc)
    mut target.push('.')
    mut target.append(operation)
    return target
} target_of

/// The class an operation's limits clause states.
fn declared_class(class: sys::Reversibility) -> Reversibility {
    return match class {
        sys::Reversibility.Traceless => Reversibility.None
        sys::Reversibility.Recorded => Reversibility.Recorded
        sys::Reversibility.Restorable => Reversibility.Restorable
        sys::Reversibility.Irreversible(emit: emit, actuate: actuate, erase: erase, spend: spend) => Reversibility.Irreversible(kinds: IrreversibleKinds(emit: emit, actuate: actuate, erase: erase, spend: spend))
    }
} declared_class

/// The delivery a call or a redelivery makes, which `issuer` makes; none for a restore.
pub fn InstanceStep.delivery(self, issuer: ident::Principal, alloc: mem::Alloc) -> Option[Delivery] {
    match self.command {
        Command.Restore(number: _) => return None
        else => {
        }
    }
    return Some(Delivery(step: self.step, kind: DeliveryKind.Message, issuer: ident::Principal(text: issuer.text), target: target_of(self.moniker, operation: self.operation.as_str(), alloc), code: Some(self.code), destination: text::String.empty(alloc), size_bytes: u64.widen(self.message.len()), blake3: ident::HashValue.of_content(self.message.view()), class: self.class))
} InstanceStep.delivery

/// Whether the step sends the instance a message: a call or a redelivery.
pub fn InstanceStep.messages(self) -> bool {
    return match self.command {
        Command.Restore(number: _) => false
        else => true
    }
} InstanceStep.messages

/// The class a forked run of the step's message foresaw, `None` without one: the join of the classes of the messages the handler sent the instance and of the keyed tasks it spawned, `none` without either.
pub fn InstanceStep.foreseen_class(self) -> Option[Reversibility] {
    let Some(foreseen) = self.foreseen else {
        return None
    }
    var class = Reversibility.None
    for output in foreseen.sent {
        class = class.join(declared_class(output.class))
    }
    for spawned in foreseen.spawns {
        class = class.join(self.spawned_class(spawned))
    }
    return Some(class)
} InstanceStep.foreseen_class

/// The class of a keyed task of class `spawned` the handler of the step's operation spawns: joined with the class the operation declares, which bounds what its handler starts, as the calls a task makes through ports state no class.
fn InstanceStep.spawned_class(self, spawned: sys::Reversibility) -> Reversibility = declared_class(spawned).join(self.class)

/// The deliveries the instance makes, under its own principal `inst.<moniker>`, of the messages and keyed tasks a forked run of the step's message foresaw its handler holding, those of class above `none`.
pub fn InstanceStep.held_deliveries(self, alloc: mem::Alloc) -> mem::List[Delivery] {
    var deliveries = mem::List[Delivery].empty(alloc)
    let Some(foreseen) = self.foreseen else {
        return deliveries
    }
    var name = text::Fixed[64].of("inst.")
    mut name.append(self.moniker.text.as_str())
    let issuer = ident::Principal(text: name)
    for output in foreseen.sent {
        let class = declared_class(output.class)
        if class == Reversibility.None {
            continue
        }
        mut deliveries.push(Delivery(step: self.step, kind: DeliveryKind.Message, issuer: ident::Principal(text: issuer.text), target: target_of(self.moniker, operation: output.operation.as_str(), alloc), code: Some(self.code), destination: text::String.empty(alloc), size_bytes: u64.widen(output.encoded.len()), blake3: ident::HashValue.of_content(output.encoded.view()), class: class))
    }
    for spawned in foreseen.spawns {
        let class = self.spawned_class(spawned)
        if class == Reversibility.None {
            continue
        }
        mut deliveries.push(Delivery(step: self.step, kind: DeliveryKind.Spawn, issuer: ident::Principal(text: issuer.text), target: target_of(self.moniker, operation: self.operation.as_str(), alloc), code: Some(self.code), destination: text::String.empty(alloc), size_bytes: 0, blake3: ident::HashValue.of_content(b""), class: class))
    }
    return deliveries
} InstanceStep.held_deliveries

/// The call a fork of the instance handles for the message of a call or a redelivery; `None` for a restore.
pub fn InstanceStep.fork_call(self, alloc: mem::Alloc) -> Option[os::ForkCall] {
    let hash = match self.command {
        Command.Call(hash: hash, reply: _) or Command.Redeliver(seq: _, hash: hash) => hash
        Command.Restore(number: _) => return None
    }
    var encoded = mem::Bytes.empty(alloc)
    mut encoded.append(self.message.view())
    return Some(os::ForkCall(hash: hash, encoded: take encoded))
} InstanceStep.fork_call

/// The canonical rendering of `raw`, the reply to the request a call step makes; `None` for any other step.
pub fn InstanceStep.reply_text(self, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[text::String] {
    let Command.Call(hash: _, reply: Some(reply)) = self.command else {
        return None
    }
    return Some(reply_text(reply, raw, alloc))
} InstanceStep.reply_text

/// Has the runner carry out the command of `commanded` through `control`: the encoding of the reply to a request; none once a one-way call or a dead letter is in the instance's intake or the restored instance runs; the code of its failure.
pub fn carried_out(commanded: InstanceStep, control: os::Control, alloc: mem::Alloc) -> Result[Option[mem::Bytes], text::Fixed[32]] fails task::Cancelled uses wait {
    let moniker = ident::Moniker(text: commanded.moniker.text)
    match commanded.command {
        Command.Call(hash: hash, reply: reply) => {
            var encoded = sys::Encoded.empty(alloc)
            mut encoded.bytes.append(commanded.message.view())
            return match first attempt await control.call(take moniker, hash, take encoded, request: reply.is_some(), alloc) {
                Ok(replied) => match reply.is_some() {
                    true => Ok(Some(take replied.bytes))
                    false => Ok(None)
                }
                Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
                Err(failed) => Err(failed.code())
            }
        }
        Command.Redeliver(seq: seq, hash: _) => return match first attempt await control.redeliver(take moniker, seq, alloc) {
            Ok(_) => Ok(None)
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            Err(failed) => Err(failed.code())
        }
        Command.Restore(number: number) => return match first attempt await control.restore(take moniker, number, alloc) {
            Ok(os::Lifecycle.Failed) => Err(text::Fixed[32].of("instance.failed"))
            Ok(_) => Ok(None)
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            Err(failed) => Err(failed.code())
        }
    }
} carried_out
