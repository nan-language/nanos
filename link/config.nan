//! The link's configuration, `/sys/config/link`.

/// The configuration of plans.
pub closed struct PlanConfig derives Copy, Eq, Render, Encode {
    pub health_s: u32
    pub confirm_s: u32
    pub preview_bytes: u32
    pub keep_s: u32
    pub activation_ms: u32
    pub grace_s: u32
    pub key_results: u32
} PlanConfig

/// The configuration of `link`.
pub closed struct LinkConfig derives Copy, Eq, Render, Encode {
    pub budget: os::SessionBudget
    pub pending_ms: u32
    pub challenge_s: u32
    pub detach_s: u32
    pub sessions: u32
    pub principal_sessions: u32
    pub push_ms: u32
    pub backlog: u32
    pub plans: PlanConfig
} LinkConfig

/// The configuration chapter 18 gives by default.
pub fn LinkConfig.default_of() -> LinkConfig {
    let budget = os::SessionBudget(output_units: None, response_units: 4_000, query_records: 100_000, query_bytes: 67_108_864, previews: 4, cpu_ms: None, memory_bytes: None, egress_bytes: None, energy_mj: None, infer_tokens: None, infer_micros: None)
    let plans = PlanConfig(health_s: 30, confirm_s: 120, preview_bytes: 1_048_576, keep_s: 3_600, activation_ms: 1_000, grace_s: 3_600, key_results: 1_024)
    return LinkConfig(budget: budget, pending_ms: 100, challenge_s: 60, detach_s: 600, sessions: 16, principal_sessions: 16, push_ms: 100, backlog: 1_024, plans: plans)
} LinkConfig.default_of
