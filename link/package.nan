//! The `link` instance: the protocol agents and humans reach the system through.

package link {
    language 1
    targets any
    dep admission "../admission"
    dep bootfmt "../bootfmt"
    dep clock "../clock"
    dep code "../code"
    dep console "../console"
    dep devices "../devices"
    dep ident "../ident"
    dep journal "../journal"
    dep keys "../keys"
    dep os "../os"
    dep policy "../policy"
    dep power "../power"
    dep store "../store"
    dep supervisor "../supervisor"
    allow validate in admission, bootfmt, clock, code, console, devices, ident, journal, keys, link, os, policy, power, store, supervisor
} link
