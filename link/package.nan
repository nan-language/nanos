//! The `link` instance: the protocol agents and humans reach the system through.

package link {
    language 1
    targets any
    dep bootfmt "../bootfmt"
    dep clock "../clock"
    dep console "../console"
    dep devices "../devices"
    dep ident "../ident"
    dep journal "../journal"
    dep keys "../keys"
    dep os "../os"
    dep policy "../policy"
    dep power "../power"
    dep store "../store"
    allow validate in bootfmt, clock, console, devices, ident, journal, keys, link, os, policy, power, store
} link
