//! The `run` step: a job of an admitted program bundle, from a `JobSpec` construction literal.

/// The command of the `run` step `written`, numbered `step`, starting the job the `JobSpec` construction literal `literal` describes, or its JSON when `json`, for the plan's principal `principal`: `schema.invalid` for text that is no `JobSpec`; `auth.denied` unless `holding` lets the principal spawn the job at the UTC time `now_utc`; `instance.moniker-taken` for a moniker whose subtree of `/state` `view` holds; `store.not-found` when `view` holds no admission record for its bundle, and `request.invalid-operand` for one admitting no program; `place.unavailable` for a job placed isolated on a machine without `user-mode`. Its class is the one its program's digest declares.
pub fn run_command(
    written: Written,
    step: u32,
    literal: Str,
    json: bool,
    view: store::service::View,
    principal: ident::Principal,
    holding: Holding,
    now_utc: i64,
    alloc: mem::Alloc,
    ) -> Result[InstanceStep, Failure] fails task::Cancelled uses wait {
    let message = match decode_value("os::JobSpec", text: literal, json, alloc) {
        Decoded.Bytes(bytes: bytes, schema: _) => bytes
        Decoded.Invalid(error) => return Err(invalid(literal, type: "os::JobSpec", error, alloc))
        Decoded.Unknown => return Err(Failure.of("request.invalid-operand", subject: literal, alloc).expecting("a JobSpec construction literal", found: literal, alloc))
    }
    let Ok(spec) = attempt mem::wire::Codec[os::JobSpec].decode(Untrusted.of(message.view()), alloc) else {
        return Err(Failure.of("request.invalid-operand", subject: literal, alloc).expecting("a JobSpec construction literal", found: literal, alloc))
    }
    let moniker = match spec.moniker {
        Some(ident::Moniker(text: named)) => ident::Moniker(text: named)
        None => ident::Moniker(text: text::Fixed[59].of(os::JOBS))
    }
    if not holding.controls(moniker, right: os::Right.Spawn, now_utc) {
        return Err(denied(moniker.text.as_str(), right: "spawn", alloc))
    }
    for granted in spec.grants {
        if not holding.holds(granted.value(), now_utc) {
            var name = text::String.of("g", alloc)
            mut name.write(Dyn[Render].view(granted.value()), budget: 20)
            return Err(denied(name.as_str(), right: "grant", alloc))
        }
    }
    if spec.moniker.is_some() {
        var subtree = text::String.of("/state/", alloc)
        mut subtree.append(moniker.text.as_str())
        match try await node_at(view, path: subtree.as_str(), alloc) {
            Ok(Some(_)) => return Err(Failure.of("instance.moniker-taken", subject: moniker.text.as_str(), alloc))
            Ok(None) => {
            }
            Err(failure) => return Err(take failure)
        }
    }
    let record = match try await admission_at(view, bundle: spec.bundle, alloc) {
        Ok(found) => found
        Err(failure) => return Err(take failure)
    }
    let Some(program) = record.program else {
        return Err(Failure.of("request.invalid-operand", subject: spec.bundle.full_form().as_str(), alloc).expecting("the code hash of a program bundle", found: "a component bundle", alloc))
    }
    let space = os::Space.of(ident::Principal(text: principal.text), placement: spec.placement, shared: record.shared, provenance: record.provenance)
    if space != os::Space.Shared and not try await isolating(view, alloc) {
        return Err(Failure.of("place.unavailable", subject: moniker.text.as_str(), alloc).expecting("a job the shared space may run", found: "a job placed isolated on a machine without user-mode", alloc))
    }
    return Ok(InstanceStep(step: step, moniker: take moniker, code: spec.bundle, command: Command.Run(principal: ident::Principal(text: principal.text)), operation: text::String.of("main", alloc), message: take message, class: declared_class(program.class), foreseen: None))
} run_command

/// Whether `/live/security` through `view` tells of isolated spaces on the machine.
fn isolating(view: store::service::View, alloc: mem::Alloc) -> bool fails task::Cancelled uses wait {
    return match try await Records[os::LiveSecurity].at(view, path: "/live/security", alloc) {
        Some(security) => security.isolated_spaces
        None => false
    }
} isolating

/// The admission record of the bundle of code hash `bundle` through `view`: `store.not-found` when there is none.
fn admission_at(view: store::service::View, bundle: ident::HashValue, alloc: mem::Alloc) -> Result[code::Admission, Failure] fails task::Cancelled uses wait {
    var path = text::String.of("/sys/code/", alloc)
    mut path.append(bundle.full_form().as_str())
    mut path.append("/admission")
    let node = match try await node_at(view, path: path.as_str(), alloc) {
        Ok(Some(found)) => found
        Ok(None) => return Err(Failure.of("store.not-found", subject: path.as_str(), alloc).expecting("the code hash of an admitted bundle", found: path.as_str(), alloc))
        Err(failure) => return Err(take failure)
    }
    let Some(raw) = node.value else {
        return Err(Failure.of("store.corrupt", subject: path.as_str(), alloc))
    }
    return match attempt mem::wire::Codec[code::Admission].decode(raw.view(), alloc) {
        Ok(record) => Ok(take record)
        Err(_) => Err(Failure.of("store.corrupt", subject: path.as_str(), alloc))
    }
} admission_at
