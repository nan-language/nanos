//! The `run` step: a job of an admitted program bundle, from a `JobSpec` construction literal.

/// The command of the `run` step `written`, numbered `step`, starting the job the `JobSpec` construction literal `literal` describes, or its JSON when `json`, for the plan's principal `principal`: `schema.invalid` for text that is no `JobSpec`; `auth.denied` unless `holding` lets the principal spawn the job at the UTC time `now_utc`; `store.not-found` when `view` holds no admission record for its bundle, and `request.invalid-operand` for one admitting no program; `place.unavailable` unless the job may run in the shared space. Its class is the one its program's digest declares.
pub fn run_command(
    written: Written,
    step: u32,
    literal: Str,
    json: bool,
    view: store::service::View,
    principal: ident::Principal,
    holding: Holding,
    now_utc: i64,
    alloc: mem::Alloc,
    ) -> Result[InstanceStep, Failure] fails task::Cancelled uses wait {
    let message = match decode_value("os::JobSpec", text: literal, json, alloc) {
        Decoded.Bytes(bytes: bytes, schema: _) => bytes
        Decoded.Invalid(error) => return Err(invalid(literal, type: "os::JobSpec", error, alloc))
        Decoded.Unknown => return Err(Failure.of("request.invalid-operand", subject: literal, alloc).expecting("a JobSpec construction literal", found: literal, alloc))
    }
    let Ok(spec) = attempt mem::wire::Codec[os::JobSpec].decode(Untrusted.of(message.view()), alloc) else {
        return Err(Failure.of("request.invalid-operand", subject: literal, alloc).expecting("a JobSpec construction literal", found: literal, alloc))
    }
    let moniker = match spec.moniker {
        Some(ident::Moniker(text: named)) => ident::Moniker(text: named)
        None => ident::Moniker(text: text::Fixed[59].of(os::JOBS))
    }
    if not holding.controls(moniker, right: os::Right.Spawn, now_utc) {
        return Err(denied(moniker.text.as_str(), right: "spawn", alloc))
    }
    var path = text::String.of("/sys/code/", alloc)
    mut path.append(spec.bundle.full_form().as_str())
    mut path.append("/admission")
    let record = match try await admission_at(view, path: path.as_str(), alloc) {
        Ok(found) => found
        Err(failure) => return Err(take failure)
    }
    let Some(program) = record.program else {
        return Err(Failure.of("request.invalid-operand", subject: path.as_str(), alloc).expecting("the code hash of a program bundle", found: "a component bundle", alloc))
    }
    let governing = principal.text.as_str() == "system" or principal.text.as_str() == "owner"
    if not (record.shared and governing and spec.placement != os::Placement.Isolated) {
        return Err(Failure.of("place.unavailable", subject: moniker.text.as_str(), alloc).expecting("a job the shared space may run", found: "a job placed isolated", alloc))
    }
    return Ok(InstanceStep(step: step, moniker: take moniker, code: spec.bundle, command: Command.Run(principal: ident::Principal(text: principal.text)), operation: text::String.of("main", alloc), message: take message, class: declared_class(program.class), foreseen: None))
} run_command

/// The admission record at `path` through `view`: `store.not-found` when there is none.
fn admission_at(view: store::service::View, path: Str, alloc: mem::Alloc) -> Result[code::Admission, Failure] fails task::Cancelled uses wait {
    let node = match try await node_at(view, path, alloc) {
        Ok(Some(found)) => found
        Ok(None) => return Err(Failure.of("store.not-found", subject: path, alloc).expecting("the code hash of an admitted bundle", found: path, alloc))
        Err(failure) => return Err(take failure)
    }
    let Some(raw) = node.value else {
        return Err(Failure.of("store.corrupt", subject: path, alloc))
    }
    return match attempt mem::wire::Codec[code::Admission].decode(raw.view(), alloc) {
        Ok(record) => Ok(take record)
        Err(_) => Err(Failure.of("store.corrupt", subject: path, alloc))
    }
} admission_at
