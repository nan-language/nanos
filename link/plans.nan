//! Plans: the `plan` verb previewing plans from keyed tasks, the plans the link keeps by their hash, their lifecycle states, events and records at `/live/plans`.

/// A plan the link keeps: its hash, its record, the work of its spans, the subjects the policy decides, the session that previewed it, its state, the span it reached, the commits of its spans, the replies to the requests of its call steps, the outbox entries that ended, the end of the running health window or confirmation wait, the request key and the request number it applies under, the code it ended with, and when it was previewed and ended in monotonic time.
pub closed struct KeptPlan derives Encode {
    pub hash: ident::HashValue
    pub plan: Plan
    pub spans: mem::List[SpanWork]
    pub subjects: mem::List[policy::Subject]
    pub session: u64
    pub state: PlanState
    pub span: u32
    pub commits: mem::List[ident::CommitId]
    pub replies: mem::List[StepReply]
    pub ended: mem::List[EndedEntry]
    pub until: Option[ident::WallTime]
    pub key: Option[text::String]
    pub applying: Option[u64]
    pub code: Option[text::String]
    pub previewed_ns: u64
    pub ended_ns: Option[u64]
} KeptPlan

/// An outbox entry of a plan and the status it ended in.
pub closed struct EndedEntry derives Encode {
    pub entry: text::String
    pub status: DeliveryStatus
} EndedEntry

/// The encoding of the reply to the request of a call step.
pub closed struct StepReply derives Encode {
    pub step: u32
    pub reply: mem::Bytes
} StepReply

/// `plan <steps>`: a keyed task previews the steps for the session's principal.
fn Linker.plan(
    mut self,
    take request: Request,
    number: u64,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let list = match request.operands.get(0) {
        Some(word) => text::String.of(word.as_str(), alloc: env.alloc)
        None => text::String.empty(env.alloc)
    }
    let steps = steps_of(list.as_str(), alloc: env.alloc)
    mut self.preview_steps(take request, take steps, number, undone: None, mut env, mut cx)
} Linker.plan

/// `call <moniker> <op>(<args>)`: a keyed task previews the one-step plan of that call for the session's principal, and the plan applies at once under the request's key, answering as `apply` does with its reply first.
fn Linker.call(
    mut self,
    take request: Request,
    number: u64,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    var written = text::String.of("call ", alloc)
    mut written.append(request.operand_text(alloc).as_str())
    var steps: Result[mem::List[Written], Failure] = Ok(mem::List.empty(alloc))
    match step_of(written.as_str(), alloc) {
        Ok(step) => {
            var single = mem::List[Written].empty(alloc)
            mut single.push(take step)
            steps = Ok(take single)
        }
        Err(failure) => {
            steps = Err(take failure)
        }
    }
    mut self.preview_steps(take request, take steps, number, undone: None, mut env, mut cx)
} Linker.call

/// `undo <commit or plan>`: a keyed task previews the inverse plan: `revert <commit>`, or the reverts of a plan's span commits, newest first, with an `irreversible` record for each delivered outbox entry of the plan.
fn Linker.undo(
    mut self,
    take request: Request,
    number: u64,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let steps = self.inverse_steps(request, alloc: env.alloc)
    let undone = self.undone_plan(request, alloc: env.alloc)
    mut self.preview_steps(take request, take steps, number, undone, mut env, mut cx)
} Linker.undo

/// The hash of the plan the operand of `undo` names, `None` for a commit.
fn Linker.undone_plan(self, request: Request, alloc: mem::Alloc) -> Option[ident::HashValue] {
    let Some(word) = request.operands.get(0) else {
        return None
    }
    if ident::CommitId.of_text(word.as_str()).is_some() {
        return None
    }
    return match self.plan_named(word.as_str(), alloc) {
        Ok(at) => Some(self.plans[at].hash)
        Err(_) => None
    }
} Linker.undone_plan

/// The inverse steps of the commit or the kept plan `request` names.
fn Linker.inverse_steps(self, request: Request, alloc: mem::Alloc) -> Result[mem::List[Written], Failure] {
    let operand = match request.operands.get(0) {
        Some(word) => text::String.of(word.as_str(), alloc)
        None => text::String.empty(alloc)
    }
    var commits = mem::List[ident::CommitId].empty(alloc)
    match ident::CommitId.of_text(operand.as_str()) {
        Some(commit) => mut commits.push(commit)
        None => {
            let plan_at = match self.plan_named(operand.as_str(), alloc) {
                Ok(found) => found
                Err(failure) => return Err(take failure)
            }
            for commit in self.plans[plan_at].commits {
                mut commits.insert(0, value: commit)
            }
        }
    }
    if commits.len() == 0 {
        return Err(Failure.of("request.invalid-operand", subject: operand.as_str(), alloc).expecting("a commit, or a plan that committed", found: operand.as_str(), alloc))
    }
    var steps = mem::List[Written].empty(alloc)
    for commit in commits {
        var text = text::String.of("revert ", alloc)
        mut text.write(Dyn[Render].view(commit), budget: 32)
        match step_of(text.as_str(), alloc) {
            Ok(written) => mut steps.push(take written)
            Err(failure) => return Err(take failure)
        }
    }
    return Ok(take steps)
} Linker.inverse_steps

/// Has a keyed task preview `steps`, the steps `request` gives or their failure, for the session's principal, at most `SessionBudget.previews` previews of its sessions running at once; the preview of the inverse of the plan `undone` adds what no undo reaches of it.
fn Linker.preview_steps(
    mut self,
    take request: Request,
    take steps: Result[mem::List[Written], Failure],
    number: u64,
    undone: Option[ident::HashValue],
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    let Some(at) = self.running.position(fn(each: Running) => each.number == number) else {
        return
    }
    let session = self.running[at].session
    let slot = self.running[at].slot
    let asked = match steps {
        Ok(found) => self.planning(request, steps: take found, session, now_utc: now_utc_ns(env.wall, clock: env.clock), alloc)
        Err(failure) => Err(take failure)
    }
    let planned = match asked {
        Ok(made) => made
        Err(failure) => {
            let block = self.running[at].failed(take failure, alloc)
            mut self.respond(at, take block, mut env, mut cx)
            return
        }
    }
    let tree = env.tree
    let control = env.control
    let oversight = env.oversight
    mut cx.spawn(key: ANSWERING + slot, run: fn[take planned](out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 131_072 {
        var outcome = try await preview(take planned, tree, control, oversight, alloc)
        match undone {
            Some(plan) => {
                outcome = try await irreversible_added(take outcome, undone: plan, tree, alloc)
            }
            None => {
            }
        }
        discard attempt await out.previewed(number, take outcome)
    })
    mut cx.after(ms: u64.widen(self.config.pending_ms), send: LinkSession.due(number: number))
} Linker.preview_steps

/// `outcome` with, when it kept a plan, an `irreversible` record for each outbox entry of the plan `undone` that `tree` holds delivered.
fn irreversible_added(take outcome: Preview, undone: ident::HashValue, tree: store::service::View, alloc: mem::Alloc) -> Preview fails task::Cancelled uses wait {
    match outcome {
        Preview.Kept(previewed) => {
            var shown = previewed
            let records = try await irreversible_records(tree, plan: undone, alloc)
            for record in take records {
                mut shown.records.push(take record)
            }
            return Preview.Kept(take shown)
        }
        Preview.Failed(failure) => return Preview.Failed(take failure)
    }
} irreversible_added

/// What the preview of `steps` for `request` in the session numbered `session` needs: the steps and the request's options, the session's principal and what it holds, its taint, and the sessions open; refused without a session, with options of the wrong form, or while the principal's sessions run their most previews.
fn Linker.planning(
    self,
    request: Request,
    take steps: mem::List[Written],
    session: u64,
    now_utc: i64,
    alloc: mem::Alloc,
    ) -> Result[Planning, Failure] {
    let Some(at) = self.sessions.position(fn(each: Session) => each.number == session) else {
        return Err(Failure.of("auth.denied", subject: request.verb.as_str(), alloc).expecting("a session", found: "none", alloc))
    }
    let options = match options_of(request, plans: self.config.plans, alloc) {
        Ok(found) => found
        Err(failure) => return Err(take failure)
    }
    let principal = self.sessions[at].principal
    var previewing: u32 = 0
    for running in self.running {
        let verb = running.verb.as_str()
        let previews = (verb == "plan" or verb == "undo" or verb == "call") and self.plans.position(fn(each: KeptPlan) => each.applying == Some(running.number)).is_none()
        if not previews or (running.session == session and running.id == request.id) {
            continue
        }
        match self.sessions.position(fn(each: Session) => each.number == running.session) {
            Some(other) => {
                if self.sessions[other].principal == principal {
                    previewing += 1
                }
            }
            None => {
            }
        }
    }
    if previewing >= self.budget_of(session).previews {
        return Err(Failure.of("budget.previews", subject: principal.text.as_str(), alloc).expecting("fewer previews running", found: "the principal's most", alloc))
    }
    let holding = match self.holdings.position(fn(each: Holding) => each.principal == principal) {
        Some(held) => match duplicate(self.holdings[held], alloc) {
            Some(copy) => copy
            None => Holding(principal: ident::Principal(text: principal.text), grants: mem::List.empty(alloc), keyed: false)
        }
        None => Holding(principal: ident::Principal(text: principal.text), grants: mem::List.empty(alloc), keyed: false)
    }
    let taint = self.taint_of(principal, alloc)
    var open = mem::List[OpenSession].empty(alloc)
    for each in self.sessions {
        var path = mem::List[ident::Moniker].empty(alloc)
        for moniker in each.path {
            mut path.push(ident::Moniker(text: moniker.text))
        }
        mut open.push(OpenSession(session: ident::SessionId(boot: self.boot(), number: each.number), principal: ident::Principal(text: each.principal.text), path: take path))
    }
    return Ok(Planning(steps: take steps, options: take options, principal: ident::Principal(text: principal.text), session: ident::SessionId(boot: self.boot(), number: session), holding: take holding, plans: self.config.plans, taint: take taint, open: take open, json: request.has("json-in"), now_utc: now_utc))
} Linker.planning

/// Answers the `plan` numbered `number` with its effect set, keeping the plan, or with the failure ending its preview; the plan of a `call` applies at once under its key.
fn Linker.previewed(
    mut self,
    take number: u64,
    take outcome: Preview,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    let Some(at) = self.running.position(fn(each: Running) => each.number == number) else {
        return
    }
    let previewed = match outcome {
        Preview.Kept(made) => made
        Preview.Failed(failure) => {
            let block = self.running[at].failed(take failure, alloc)
            mut self.respond(at, take block, mut env, mut cx)
            return
        }
    }
    let Previewed(hash: hash, plan: plan, spans: spans, subjects: subjects, records: records) = previewed
    let session = self.running[at].session
    let calling = self.running[at].verb.as_str() == "call"
    if not calling {
        var block = self.running[at].block(Verdict.Ok, alloc)
        for record in take records {
            mut block.records.push(take record)
        }
        mut self.respond(at, take block, mut env, mut cx)
    }
    let now = now_ns(env.clock)
    mut self.forget_plans(now, mut env, mut cx)
    if self.plans.position(fn(each: KeptPlan) => each.hash == hash).is_none() {
        mut self.plans.push(KeptPlan(hash: hash, plan: take plan, spans: take spans, subjects: take subjects, session: session, state: PlanState.Previewed, span: 0, commits: mem::List.empty(alloc), replies: mem::List.empty(alloc), ended: mem::List.empty(alloc), until: None, key: None, applying: None, code: None, previewed_ns: now, ended_ns: None))
        mut self.announce(self.plans.len() - 1, mut env, mut cx)
    }
    if not calling {
        return
    }
    let Some(plan_at) = self.plans.position(fn(each: KeptPlan) => each.hash == hash) else {
        return
    }
    if self.plans[plan_at].state != PlanState.Previewed {
        let block = self.running[at].failed(Failure.of("plan.busy", subject: hash.short_form().as_str(), alloc), alloc)
        mut self.respond(at, take block, mut env, mut cx)
        return
    }
    self.plans[plan_at].key = match self.running[at].keyed {
        Some(keyed) => Some(text::String.of(keyed.key.as_str(), alloc))
        None => None
    }
    mut self.start_applying(plan_at, at, scheduled: None, mut env, mut cx)
} Linker.previewed

/// Emits the event of the state of the plan kept at `at` and publishes its record at `/live/plans`.
fn Linker.announce(mut self, at: usize, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    let alloc = env.alloc
    let held = self.plans[at]
    var commit: Option[ident::CommitId] = None
    var commits = mem::List[ident::CommitId].empty(alloc)
    for each in held.commits {
        commit = Some(each)
        mut commits.push(each)
    }
    let code = match held.code {
        Some(text) => Some(text::String.of(text.as_str(), alloc))
        None => None
    }
    let event = PlanEvent(plan: held.hash, state: held.state, span: held.span, commit: commit, entry: None, code: take code)
    let record = LivePlan(state: held.state, span: held.span, commits: take commits, until: held.until, deliveries: outbox_entries(held, alloc), as_of: now_ns(env.clock))
    let hash = held.hash
    let kind = held.state.event_kind()
    mut self.notify(Notice.Plan(kind: kind, event: take event), mut env, mut cx)
    mut self.notify(Notice.PlanLive(plan: hash, record: take record), mut env, mut cx)
} Linker.announce

/// The ids of the outbox entries of the spans the plan `held` committed.
fn outbox_entries(held: KeptPlan, alloc: mem::Alloc) -> mem::List[text::String] {
    var entries = mem::List[text::String].empty(alloc)
    for span in held.spans {
        if usize.widen(span.span) > held.commits.len() {
            break
        }
        var n: usize = 0
        for commanded in span.commands {
            if commanded.class.is_irreversible() {
                n += 1
                mut entries.push(entry_id(held.hash, span: span.span, n, alloc))
            }
        }
    }
    return entries
} outbox_entries

/// Emits `plan.failed` for each plan `link`'s restart interrupted, as `events` tell.
fn Linker.interrupted(mut self, take events: mem::List[PlanEvent], mut env: Env, mut cx: sys::Cx[LinkSession]) {
    for event in take events {
        let kind = match event.entry.is_some() {
            true => text::Fixed[32].of("plan.delivered")
            false => PlanState.Failed.event_kind()
        }
        mut self.notify(Notice.Plan(kind: kind, event: take event), mut env, mut cx)
    }
} Linker.interrupted

/// Emits `plan.delivered` for the outbox entry `entry` of the plan kept at `at`.
fn Linker.announce_delivery(
    mut self,
    at: usize,
    take entry: text::String,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let held = self.plans[at]
    var commit: Option[ident::CommitId] = None
    for each in held.commits {
        commit = Some(each)
    }
    let event = PlanEvent(plan: held.hash, state: held.state, span: held.span, commit: commit, entry: Some(take entry), code: None)
    mut self.notify(Notice.Plan(kind: text::Fixed[32].of("plan.delivered"), event: take event), mut env, mut cx)
} Linker.announce_delivery

/// Forgets the plans kept past `PlanConfig.keep_s` since their preview while previewed, or since their end once ended, withdrawing their records at `/live/plans`.
fn Linker.forget_plans(mut self, now: u64, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    let keep_ns = u64.widen(self.config.plans.keep_s) * 1_000_000_000
    var at: usize = 0
    while at < self.plans.len() {
        let since = match self.plans[at].ended_ns {
            Some(ended) => ended
            None => match self.plans[at].state == PlanState.Previewed {
                true => self.plans[at].previewed_ns
                false => now
            }
        }
        if now.saturating_sub(since) <= keep_ns {
            at += 1
            continue
        }
        let gone = mut self.plans.remove(at)
        mut self.notify(Notice.PlanWithdrawn(plan: gone.hash), mut env, mut cx)
    }
} Linker.forget_plans

/// The plan kept whose short or full hash `text` writes, `request.unknown-name` when none or `request.ambiguous` when several match.
fn Linker.plan_named(self, text: Str, alloc: mem::Alloc) -> Result[usize, Failure] {
    let Some(named) = ident::HashText.parse(text) else {
        return Err(Failure.of("request.invalid-operand", subject: text, alloc).expecting("a plan's short or full hash", found: text, alloc))
    }
    var found: Option[usize] = None
    for at in 0..<self.plans.len() {
        if not named.names(self.plans[at].hash) {
            continue
        }
        if found.is_some() {
            return Err(Failure.of("request.ambiguous", subject: text, alloc))
        }
        found = Some(at)
    }
    return match found {
        Some(at) => Ok(at)
        None => Err(Failure.of("request.unknown-name", subject: text, alloc).expecting("a plan previewed in the last hour", found: text, alloc))
    }
} Linker.plan_named

/// The request key of `request` in the session numbered `session`: its `--key`, else the session in its `s<b>.<n>` form, `.` and the request id.
fn Linker.key_of_request(self, request: Request, session: u64, alloc: mem::Alloc) -> Result[text::String, Failure] {
    match request.flag("key") {
        Some(key) => {
            if key.byte_len() == 0 or key.byte_len() > 64 {
                return Err(Failure.of("request.invalid-flag", subject: "--key", alloc).expecting("1 to 64 characters of [A-Za-z0-9_.-]", found: key, alloc))
            }
            for byte in key.as_bytes() {
                let allowed = (byte >= b'a' and byte <= b'z') or (byte >= b'A' and byte <= b'Z') or (byte >= b'0' and byte <= b'9') or byte == b'_' or byte == b'.' or byte == b'-'
                if not allowed {
                    return Err(Failure.of("request.invalid-flag", subject: "--key", alloc).expecting("1 to 64 characters of [A-Za-z0-9_.-]", found: key, alloc))
                }
            }
            return Ok(text::String.of(key, alloc))
        }
        None => {
        }
    }
    var key = text::String.of("s", alloc)
    mut key.write(Dyn[Render].view(self.boot()), budget: 24)
    mut key.push('.')
    mut key.write(Dyn[Render].view(session), budget: 24)
    mut key.push('.')
    mut key.append(request.id.as_str())
    return Ok(take key)
} Linker.key_of_request

/// `apply <plan>`: a keyed task applies the plan the session's principal previewed, under the request's key; a plan applying under another key fails with `plan.busy`, and one whose lifecycle ended with `plan.ended`, or with its final records under the key it applied with.
fn Linker.apply(
    mut self,
    take request: Request,
    number: u64,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    let Some(at) = self.running.position(fn(each: Running) => each.number == number) else {
        return
    }
    let started = mut self.applying(request, at, alloc)
    let plan_at = match started {
        Ok(found) => found
        Err(failure) => {
            let block = self.running[at].failed(take failure, alloc)
            mut self.respond(at, take block, mut env, mut cx)
            return
        }
    }
    if self.plans[plan_at].state.ended() {
        let block = self.final_block(plan_at, at, alloc)
        mut self.respond(at, take block, mut env, mut cx)
        return
    }
    let scheduled = match request.flag("when") {
        Some(written) => match scheduled_time(written, now: env.wall.now(env.clock)) {
            Some(time) => Some(time)
            None => {
                let block = self.running[at].failed(Failure.of("request.invalid-flag", subject: "--when", alloc).expecting("an RFC 3339 UTC time or +<n>s", found: written, alloc), alloc)
                mut self.respond(at, take block, mut env, mut cx)
                return
            }
        }
        None => None
    }
    mut self.start_applying(plan_at, at, scheduled, mut env, mut cx)
} Linker.apply

/// Has a keyed task apply the plan kept at `plan_at` for the request running at `at`, at the wall time `scheduled` when it is timed.
fn Linker.start_applying(
    mut self,
    plan_at: usize,
    at: usize,
    scheduled: Option[ident::WallTime],
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    let number = self.running[at].number
    let slot = self.running[at].slot
    let session = ident::SessionId(boot: self.boot(), number: self.running[at].session)
    let Some(applying) = self.applying_work(plan_at, number, session, scheduled, alloc) else {
        let block = self.running[at].failed(Failure.of("store.corrupt", subject: "plan", alloc), alloc)
        mut self.respond(at, take block, mut env, mut cx)
        return
    }
    self.plans[plan_at].state = match scheduled {
        Some(_) => PlanState.Scheduled
        None => PlanState.Applying
    }
    self.plans[plan_at].until = scheduled
    self.plans[plan_at].applying = Some(number)
    mut self.announce(plan_at, mut env, mut cx)
    let tree = env.tree
    let control = env.control
    let oversight = env.oversight
    let clocks = Clocks(clock: env.clock, wall: env.wall)
    mut cx.spawn(key: ANSWERING + slot, run: fn[take applying](out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 65_536 {
        try await apply_plan(take applying, tree, control, oversight, clocks, out, alloc)
    })
    mut cx.after(ms: u64.widen(self.config.pending_ms), send: LinkSession.due(number: number))
} Linker.start_applying

/// The kept plan the `apply` running at `at` names, its key set, once the rules of apply let it go on: a plan of the session's principal, previewed and not applying, or ended under this key.
fn Linker.applying(mut self, request: Request, at: usize, alloc: mem::Alloc) -> Result[usize, Failure] {
    let session = self.running[at].session
    let Some(session_at) = self.sessions.position(fn(each: Session) => each.number == session) else {
        return Err(Failure.of("auth.denied", subject: "apply", alloc).expecting("a session", found: "none", alloc))
    }
    let operand = match request.operands.get(0) {
        Some(word) => text::String.of(word.as_str(), alloc)
        None => text::String.empty(alloc)
    }
    let plan_at = match self.plan_named(operand.as_str(), alloc) {
        Ok(found) => found
        Err(failure) => return Err(take failure)
    }
    if self.plans[plan_at].plan.principal != self.sessions[session_at].principal {
        return Err(Failure.of("plan.foreign", subject: operand.as_str(), alloc))
    }
    let key = match self.key_of_request(request, session, alloc) {
        Ok(made) => made
        Err(failure) => return Err(take failure)
    }
    let same_key = match self.plans[plan_at].key {
        Some(held) => held.as_str() == key.as_str()
        None => false
    }
    let state = self.plans[plan_at].state
    if state.ended() {
        if not same_key {
            return Err(Failure.of("plan.ended", subject: operand.as_str(), alloc))
        }
        return Ok(plan_at)
    }
    if state != PlanState.Previewed {
        return Err(Failure.of("plan.busy", subject: operand.as_str(), alloc))
    }
    self.plans[plan_at].key = Some(take key)
    return Ok(plan_at)
} Linker.applying

/// What applying the plan kept at `plan_at` for the `apply` numbered `number` in `session` needs, at the wall time `scheduled` when it is timed.
fn Linker.applying_work(
    self,
    plan_at: usize,
    number: u64,
    session: ident::SessionId,
    scheduled: Option[ident::WallTime],
    alloc: mem::Alloc,
    ) -> Option[Applying] {
    let held = self.plans[plan_at]
    let Some(plan) = duplicate(held.plan, alloc) else {
        return None
    }
    let Some(spans) = duplicate(held.spans, alloc) else {
        return None
    }
    let Some(subjects) = duplicate(held.subjects, alloc) else {
        return None
    }
    let key = match held.key {
        Some(text) => text::String.of(text.as_str(), alloc)
        None => text::String.empty(alloc)
    }
    return Some(Applying(number: number, hash: held.hash, plan: take plan, session: session, spans: take spans, subjects: take subjects, key: take key, scheduled: scheduled, activation_ms: self.config.plans.activation_ms))
} Linker.applying_work

/// Follows the plan the `apply` numbered `number` applies: a committed span moves it into its health window, and its end gives the `apply` its final block.
fn Linker.plan_moved(
    mut self,
    take number: u64,
    take moved: Moved,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    let Some(plan_at) = self.plans.position(fn(each: KeptPlan) => each.applying == Some(number)) else {
        return
    }
    match moved {
        Moved.Committed(span: span, commit: commit, until: until) => {
            self.plans[plan_at].state = PlanState.HealthWindow
            self.plans[plan_at].span = span
            mut self.plans[plan_at].commits.push(commit)
            self.plans[plan_at].until = until
            mut self.announce(plan_at, mut env, mut cx)
        }
        Moved.Replied(step: step, reply: reply) => mut self.plans[plan_at].replies.push(StepReply(step: step, reply: take reply))
        Moved.Delivered(entry: entry, status: status) => {
            if status != DeliveryStatus.Cancelled {
                mut self.announce_delivery(plan_at, entry: text::String.of(entry.as_str(), alloc), mut env, mut cx)
            }
            mut self.plans[plan_at].ended.push(EndedEntry(entry: take entry, status: status))
        }
        Moved.Ended(state: state, code: code) => {
            self.plans[plan_at].state = state
            self.plans[plan_at].code = code
            self.plans[plan_at].until = None
            self.plans[plan_at].applying = None
            if state.ended() {
                self.plans[plan_at].ended_ns = Some(now_ns(env.clock))
            }
            mut self.announce(plan_at, mut env, mut cx)
            let Some(at) = self.running.position(fn(each: Running) => each.number == number) else {
                return
            }
            let block = self.final_block(plan_at, at, alloc)
            mut self.respond(at, take block, mut env, mut cx)
        }
    }
} Linker.plan_moved

/// The final block of the request running at `at` for the plan kept at `plan_at`: for a `call`, a `reply <step>, value` record per reply to its requests; a `span <n>, commit` record per span committed, a `delivery <entry>, status` record per outbox entry that ended, and `plan <hash>, state`, failed with the plan's code unless it applied.
fn Linker.final_block(self, plan_at: usize, at: usize, alloc: mem::Alloc) -> Block {
    let held = self.plans[plan_at]
    let verdict = match held.state == PlanState.Applied {
        true => Verdict.Ok
        false => Verdict.Failed
    }
    var block = self.running[at].block(verdict, alloc)
    if self.running[at].verb.as_str() == "call" {
        for replied in held.replies {
            match reply_record(held, replied, alloc) {
                Some(record) => mut block.records.push(take record)
                None => {
                }
            }
        }
    }
    match held.code {
        Some(code) => {
            var subject = text::String.empty(alloc)
            mut subject.append(held.hash.short_form().as_str())
            mut block.records.push(Failure.of(code.as_str(), subject: subject.as_str(), alloc).record(alloc))
        }
        None => {
        }
    }
    var span: u32 = 1
    for commit in held.commits {
        var record = Record.of("span", alloc)
        mut record.subject(Dyn[Render].view(span))
        mut record.field("commit", value: Dyn[Render].view(commit))
        mut block.records.push(take record)
        span += 1
    }
    for ended in held.ended {
        var record = Record.of("delivery", alloc)
        mut record.subject(Dyn[Render].view(Rendered(text: text::String.of(ended.entry.as_str(), alloc))))
        mut record.field("status", value: Dyn[Render].view(ended.status))
        mut block.records.push(take record)
    }
    var summary = Record.of("plan", alloc)
    mut summary.subject(Dyn[Render].view(held.hash))
    mut summary.hashes.push(Hashed(short: held.hash.short_form(), full: held.hash.full_form()))
    mut summary.field("state", value: Dyn[Render].view(held.state))
    mut block.records.push(take summary)
    return block
} Linker.final_block

/// `reply <step>, value` of the reply `replied` to a request of the plan `held`, rendered as a value of its operation's reply type.
fn reply_record(held: KeptPlan, replied: StepReply, alloc: mem::Alloc) -> Option[Record] {
    for span in held.spans {
        for commanded in span.commands {
            if commanded.step != replied.step {
                continue
            }
            let Some(rendered) = commanded.reply_text(raw: Untrusted.of(replied.reply.view()), alloc) else {
                return None
            }
            var record = Record.of("reply", alloc)
            mut record.subject(Dyn[Render].view(replied.step))
            mut record.rendered("value", rendered: rendered.as_str(), alloc)
            return Some(take record)
        }
    }
    return None
} reply_record

/// The `pending` record of the request numbered `number`: the state of the plan it applies, its span, the commit of that span and the end of its window, or `running`.
fn Linker.pending_record(self, number: u64, alloc: mem::Alloc) -> Record {
    var record = Record.of("pending", alloc)
    let Some(plan_at) = self.plans.position(fn(each: KeptPlan) => each.applying == Some(number)) else {
        mut record.words("running")
        return record
    }
    let held = self.plans[plan_at]
    mut record.subject(Dyn[Render].view(held.state))
    if held.span > 0 {
        mut record.field("span", value: Dyn[Render].view(held.span))
    }
    for commit in held.commits {
        if held.commits.len() == usize.widen(held.span) {
            mut record.field("commit", value: Dyn[Render].view(commit))
        }
    }
    match held.until {
        Some(until) => mut record.field("until", value: Dyn[Render].view(until))
        None => {
        }
    }
    return record
} Linker.pending_record

/// `confirm <commit>`: a keyed task commits the deletion of the record at `/sys/plans` of the plan of the session's principal whose provisional span commit it names, which lets its apply go on; `plan.not-provisional` for any other commit.
fn Linker.confirm(
    mut self,
    take request: Request,
    number: u64,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    let Some(at) = self.running.position(fn(each: Running) => each.number == number) else {
        return
    }
    let session = self.running[at].session
    let found = self.provisional(request, session, alloc)
    let plan_at = match found {
        Ok(index) => index
        Err(failure) => {
            let block = self.running[at].failed(take failure, alloc)
            mut self.respond(at, take block, mut env, mut cx)
            return
        }
    }
    let key = match self.key_of_request(request, session, alloc) {
        Ok(made) => made
        Err(failure) => {
            let block = self.running[at].failed(take failure, alloc)
            mut self.respond(at, take block, mut env, mut cx)
            return
        }
    }
    let hash = self.plans[plan_at].hash
    let principal = ident::Principal(text: self.plans[plan_at].plan.principal.text)
    let block = self.running[at].block(Verdict.Ok, alloc)
    let commit = match ident::CommitId.of_text(self.running[at].operand.as_str()) {
        Some(named) => named
        None => ident::CommitId(number: 0)
    }
    let slot = self.running[at].slot
    let tree = env.tree
    let acting_session = ident::SessionId(boot: self.boot(), number: session)
    let origins = self.taint_of(principal, alloc)
    mut cx.spawn(key: ANSWERING + slot, run: fn[take key, take principal, take origins, take block](out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 32_768 {
        let answered = try await confirmed_plan(hash, commit, take principal, session: acting_session, take origins, take key, take block, tree, alloc)
        discard attempt await out.responded(number, block: take answered)
    })
    mut cx.after(ms: u64.widen(self.config.pending_ms), send: LinkSession.due(number: number))
} Linker.confirm

/// The plan kept of the session's principal whose provisional span commit `request` names.
fn Linker.provisional(self, request: Request, session: u64, alloc: mem::Alloc) -> Result[usize, Failure] {
    let operand = match request.operands.get(0) {
        Some(word) => text::String.of(word.as_str(), alloc)
        None => text::String.empty(alloc)
    }
    let Some(commit) = ident::CommitId.of_text(operand.as_str()) else {
        return Err(Failure.of("request.invalid-operand", subject: operand.as_str(), alloc).expecting("a commit #<n>", found: operand.as_str(), alloc))
    }
    let Some(session_at) = self.sessions.position(fn(each: Session) => each.number == session) else {
        return Err(Failure.of("auth.denied", subject: "confirm", alloc).expecting("a session", found: "none", alloc))
    }
    for at in 0..<self.plans.len() {
        let held = self.plans[at]
        let awaiting = held.state == PlanState.HealthWindow and held.plan.options.confirm_within_s.is_some()
        let names = held.commits.position(fn(each: ident::CommitId) => each == commit).is_some()
        if awaiting and names and held.plan.principal == self.sessions[session_at].principal {
            return Ok(at)
        }
    }
    return Err(Failure.of("plan.not-provisional", subject: operand.as_str(), alloc))
} Linker.provisional

/// Commits the deletion of the record at `/sys/plans` of the plan `hash` through a View acting for `principal` in `session` with the origin labels `origins`, under `key`, giving `block` with its `confirmed` record, or failed with the store's code.
fn confirmed_plan(
    hash: ident::HashValue,
    commit: ident::CommitId,
    take principal: ident::Principal,
    session: ident::SessionId,
    take origins: mem::List[ident::OriginLabel],
    take key: text::String,
    take block: Block,
    tree: store::service::View,
    alloc: mem::Alloc,
    ) -> Block fails task::Cancelled uses wait {
    var reply_block = block
    let acting = match first attempt await tree.acting(take principal, session, take origins, alloc) {
        Ok(view) => view
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => {
            reply_block.verdict = Verdict.Failed
            mut reply_block.records.push(Failure.of(failed.code().as_str(), subject: "confirm", alloc).record(alloc))
            return reply_block
        }
    }
    var writes = mem::List[store::Write].empty(alloc)
    mut writes.push(store::Write.Delete(path: plan_path(hash, alloc)))
    let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: Some(take key), plan: Some(hash), intent: None)
    match first attempt await acting.commit(take transaction, typed: true, alloc) {
        Ok(_) => {
            var record = Record.of("confirmed", alloc)
            mut record.subject(Dyn[Render].view(commit))
            mut record.hash("plan", value: hash)
            mut reply_block.records.push(take record)
        }
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => {
            reply_block.verdict = Verdict.Failed
            mut reply_block.records.push(Failure.of(failed.code().as_str(), subject: "confirm", alloc).record(alloc))
        }
    }
    return reply_block
} confirmed_plan

/// Answers the `cancel` running at `at` when `named` names a plan the link keeps: a plan of the session's principal awaiting approval or scheduled ends `failed` with `plan.cancelled`, its scheduled apply ending, and a keyed task deletes its records at `/sys/schedule` and `/sys/plans` before the answer; any other fails with `request.not-cancellable`; false when it names no plan kept.
fn Linker.cancel_plan(
    mut self,
    named: Str,
    at: usize,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) -> bool {
    let alloc = env.alloc
    let Ok(plan_at) = self.plan_named(named, alloc) else {
        return false
    }
    let session = self.running[at].session
    let owned = match self.sessions.position(fn(each: Session) => each.number == session) {
        Some(session_at) => self.sessions[session_at].principal == self.plans[plan_at].plan.principal
        None => false
    }
    let state = self.plans[plan_at].state
    if not owned or (state != PlanState.AwaitingApproval and state != PlanState.Scheduled) {
        let block = self.running[at].failed(Failure.of("request.not-cancellable", subject: named, alloc).expecting("a plan of the session's principal awaiting approval or scheduled", found: named, alloc), alloc)
        mut self.respond(at, take block, mut env, mut cx)
        return true
    }
    self.plans[plan_at].state = PlanState.Failed
    self.plans[plan_at].code = Some(text::String.of("plan.cancelled", alloc))
    self.plans[plan_at].ended_ns = Some(now_ns(env.clock))
    self.plans[plan_at].until = None
    mut self.announce(plan_at, mut env, mut cx)
    let hash = self.plans[plan_at].hash
    let cancel_number = self.running[at].number
    let slot = self.running[at].slot
    let principal = ident::Principal(text: self.plans[plan_at].plan.principal.text)
    let acting_session = ident::SessionId(boot: self.boot(), number: session)
    var block = self.running[at].block(Verdict.Ok, alloc)
    var record = Record.of("cancelled", alloc)
    mut record.words(named)
    mut block.records.push(take record)
    match self.plans[plan_at].applying {
        Some(applying) => {
            self.plans[plan_at].applying = None
            match self.running.position(fn(each: Running) => each.number == applying) {
                Some(apply_at) => {
                    mut cx.cancel(key: ANSWERING + self.running[apply_at].slot)
                    let final_block = self.final_block(plan_at, at: apply_at, alloc)
                    mut self.respond(apply_at, block: take final_block, mut env, mut cx)
                }
                None => {
                }
            }
        }
        None => {
        }
    }
    let tree = env.tree
    let origins = self.taint_of(principal, alloc)
    mut cx.spawn(key: ANSWERING + slot, run: fn[take principal, take origins, take block](out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 32_768 {
        let answered = try await unscheduled(hash, take principal, session: acting_session, take origins, take block, tree, alloc)
        discard attempt await out.responded(number: cancel_number, block: take answered)
    })
    return true
} Linker.cancel_plan

/// Deletes the records at `/sys/schedule` and `/sys/plans` of the plan `hash` through a View acting for `principal` in `session` with the origin labels `origins`, giving `block`, or failed with the store's code.
fn unscheduled(
    hash: ident::HashValue,
    take principal: ident::Principal,
    session: ident::SessionId,
    take origins: mem::List[ident::OriginLabel],
    take block: Block,
    tree: store::service::View,
    alloc: mem::Alloc,
    ) -> Block fails task::Cancelled uses wait {
    var reply_block = block
    let acting = match first attempt await tree.acting(take principal, session, take origins, alloc) {
        Ok(view) => view
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => {
            reply_block.verdict = Verdict.Failed
            mut reply_block.records.push(Failure.of(failed.code().as_str(), subject: "cancel", alloc).record(alloc))
            return reply_block
        }
    }
    var writes = mem::List[store::Write].empty(alloc)
    for path in take scheduling_paths(hash, alloc) {
        match try await node_at(acting, path: path.text.as_str(), alloc) {
            Ok(Some(_)) => mut writes.push(store::Write.Delete(path: take path))
            else => {
            }
        }
    }
    if writes.len() == 0 {
        return reply_block
    }
    let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: None, plan: Some(hash), intent: None)
    match first attempt await acting.commit(take transaction, typed: true, alloc) {
        Ok(_) => {
        }
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => {
            reply_block.verdict = Verdict.Failed
            mut reply_block.records.push(Failure.of(failed.code().as_str(), subject: "cancel", alloc).record(alloc))
        }
    }
    return reply_block
} unscheduled

/// The wall time `--when` writes: RFC 3339 UTC, or `+<n>s` from `now`.
fn scheduled_time(written: Str, now: ident::WallTime) -> Option[ident::WallTime] {
    if written.starts_with("+") and written.ends_with("s") and written.byte_len() > 2 {
        let Some(amount) = written.slice_bytes(1, end: written.byte_len() - 1) else {
            return None
        }
        let Some(seconds) = number_of(amount) else {
            return None
        }
        let Some(delay) = i64.checked_fit(seconds) else {
            return None
        }
        return Some(ident::WallTime(utc_ns: now.utc_ns.saturating_add(delay.saturating_mul(1_000_000_000)), uncertainty_ns: now.uncertainty_ns))
    }
    return ident::WallTime.of_text(written)
} scheduled_time

test timed_plans_take_utc_times_or_seconds_from_now for scheduled_time {
    let now = ident::WallTime(utc_ns: 1_000_000_000_000, uncertainty_ns: 5)
    let later = scheduled_time("+30s", now)
    let utc = scheduled_time("2026-10-29T12:00:00Z", now)
    let wrong = scheduled_time("+30m", now)
    expect later == Some(ident::WallTime(utc_ns: 1_030_000_000_000, uncertainty_ns: 5))
    expect utc.is_some() and wrong.is_none()
} timed_plans_take_utc_times_or_seconds_from_now
