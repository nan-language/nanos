//! Apply: a previewed plan's spans committed in order through a View acting for its principal, each validated against the plan's read set once its replays gave what its forks foresaw, its commands to instances holding resources below the point of no return carried out, its activations awaited, its health window watched with revert by blame, a provisional span's confirmation awaited, and its irreversible deliveries made through the outbox.

/// How long an activation may take to converge before its health window starts anyway.
const CONVERGE_MS: u64 = 30_000

/// How often an apply looks at the instances it activated and at the confirmation of a provisional span.
const POLL_MS: u64 = 250

/// What applying a plan needs: the request applying it, its hash and record, the principal and session previewing it, the work of its spans, the subjects the policy decides, the request key it applies under, the wall time it is scheduled at when timed, and the time its spans' instances have to pause.
pub closed struct Applying derives Encode {
    pub number: u64
    pub hash: ident::HashValue
    pub plan: Plan
    pub session: ident::SessionId
    pub spans: mem::List[SpanWork]
    pub subjects: mem::List[policy::Subject]
    pub key: text::String
    pub scheduled: Option[ident::WallTime]
    pub activation_ms: u32
} Applying

/// How an apply goes on: a span committed, its health window or confirmation running until `until`; the encoding of the reply to the request of a call step; an outbox entry ended `Delivered`, `Failed` or `Cancelled`; or the plan ended in `state`, with the code of its failure.
pub closed enum Moved derives Encode {
    Committed(span: u32, commit: ident::CommitId, until: Option[ident::WallTime])
    Replied(step: u32, reply: mem::Bytes)
    Delivered(entry: text::String, status: DeliveryStatus)
    Ended(state: PlanState, code: Option[text::String])
} Moved

/// The clocks an apply waits by.
pub closed struct Clocks derives Copy {
    pub clock: sys::Clock
    pub wall: ident::Wall
} Clocks

/// Applies the plan `applying` names through `tree`, carrying out its commands through `control`, the policy deciding it again through `oversight`, telling `moves` of each span it commits, each outbox entry it delivers, and its end.
pub fn apply_plan(
    take applying: Applying,
    tree: store::service::View,
    control: os::Control,
    oversight: os::Port[policy::Oversight],
    clocks: Clocks,
    moves: task::Sender[Moved],
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    let outcome = try await applied(applying, tree, control, oversight, clocks, moves, alloc)
    discard attempt await moves.send(take outcome)
} apply_plan

/// Applies the plan `applying` names as `apply_plan` does, as a domain on the account `charge` opens and drawing through its cell, telling `out` of how it goes on, and of its failure when the core opens no account or when it traps.
fn apply_charged(
    take applying: Applying,
    take charge: Charge,
    tree: store::service::View,
    control: os::Control,
    oversight: os::Port[policy::Oversight],
    clocks: Clocks,
    out: sys::Outbox[LinkSession],
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    let number = applying.number
    let account = match try await open_account(take charge, alloc) {
        Ok(open) => open
        Err(failure) => {
            discard attempt await out.plan_moved(number, moved: finish_as(PlanState.Failed, code: failure.code.as_str(), alloc))
            return
        }
    }
    var held = Some(take applying)
    var trap: Option[sys::TrapKind] = None
    try await task::scope(account.exec, body: fn[mut held, mut trap](s: task::Scope) fails task::Cancelled uses wait {
        let Some(plan) = mut held.extract() else {
            return
        }
        let task::Channel(sender: moves, receiver: moving) = task::Channel[Moved].bounded(1, alloc)
        let running = s.spawn(fn[take plan, take moves]() -> Option[sys::TrapKind] fails task::Cancelled uses wait limits stack 8_192 {
            return match try await sys::Domain.run(fn[take plan, take moves]() fails task::Cancelled uses wait limits stack 65_536 {
                try await apply_plan(take plan, tree, control, oversight, clocks, moves, alloc: account.alloc)
            }, exec: account.exec, alloc: account.alloc) {
                Ok(_) => None
                Err(caught) => Some(caught.kind())
            }
        })
        var receiver = moving
        loop {
            let Some(moved) = try await mut receiver.receive() else {
                break
            }
            discard attempt await out.plan_moved(number, take moved)
        }
        trap = try await take running.join()
    })
    match trap {
        Some(kind) => {
            discard attempt await out.plan_moved(number, moved: finish_as(PlanState.Failed, code: trapped(kind, verb: "apply", alloc).code.as_str(), alloc))
        }
        None => {
        }
    }
} apply_charged

/// The end of applying `applying`.
fn applied(
    applying: Applying,
    tree: store::service::View,
    control: os::Control,
    oversight: os::Port[policy::Oversight],
    clocks: Clocks,
    moves: task::Sender[Moved],
    alloc: mem::Alloc,
    ) -> Moved fails task::Cancelled uses wait {
    let acting = match first attempt await acting_on(tree, branch: applying.plan.effects.branch.as_str(), principal: ident::Principal(text: applying.plan.principal.text), session: applying.session, origins: labels_of(applying.plan.effects.taint, alloc), alloc) {
        Ok(view) => view
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => return finish_as(PlanState.Failed, code: failed.code().as_str(), alloc)
    }
    let Some(subjects) = duplicate(applying.subjects, alloc) else {
        return finish_as(PlanState.Failed, code: "store.corrupt", alloc)
    }
    match try await decided(take subjects, at_apply: true, oversight, alloc) {
        Ok(approvals) => {
            if approvals.position(fn(approval: ApprovalNeed) => approval.decision.as_str() == "ask").is_some() {
                return finish_as(PlanState.AwaitingApproval, code: "policy.approval-required", alloc)
            }
        }
        Err(failure) => {
            let state = match failure.code.as_str() == "policy.denied" {
                true => PlanState.Denied
                false => PlanState.Failed
            }
            return finish_as(state, code: failure.code.as_str(), alloc)
        }
    }
    match applying.scheduled {
        Some(at) => {
            match try await schedule(applying, at, acting, alloc) {
                Some(code) => return finish_as(PlanState.Failed, code: code.as_str(), alloc)
                None => {
                }
            }
            let now = clocks.wall.now(clocks.clock)
            let due_ns = at.utc_ns.saturating_sub(now.utc_ns.saturating_sub(i64.saturate(now.uncertainty_ns)))
            if due_ns > 0 {
                try await clocks.clock.sleep_ns(u64.saturate(due_ns))
            }
        }
        None => {
        }
    }
    var commits = mem::List[ident::CommitId].empty(alloc)
    for span in applying.spans {
        let commit = match try await replayed_commit(applying, span, earlier: commits, acting, control, clocks, alloc) {
            Ok(done) => done
            Err(code) => return finish_as(PlanState.Failed, code: code.as_str(), alloc)
        }
        mut commits.push(commit)
        match try await committed_span(applying, span, commit, acting, control, clocks, moves, alloc) {
            Some(ended) => return ended
            None => {
            }
        }
    }
    return Moved.Ended(state: PlanState.Applied, code: None)
} applied

/// Follows the span `span` of `applying` once `commit` committed it: tells `out` of the commit and the end of its window and of the replies its replays gave, carries out its other commands below the point of no return through `control`, telling `out` of their replies, awaits its activations, watches its health window and awaits its confirmation, then delivers its outbox; the end of the plan when one of them ends it.
fn committed_span(
    applying: Applying,
    span: SpanWork,
    commit: ident::CommitId,
    acting: store::service::View,
    control: os::Control,
    clocks: Clocks,
    moves: task::Sender[Moved],
    alloc: mem::Alloc,
    ) -> Option[Moved] fails task::Cancelled uses wait {
    let watched = span.activations.position(fn(activation: Activation) => activation.kind != ActivationKind.Stop).is_some()
    let health_s = match watched {
        true => applying.plan.options.health_s
        false => 0
    }
    let confirm_s = applying.plan.options.confirm_within_s.value_or(0)
    let window_s = match health_s > confirm_s {
        true => health_s
        false => confirm_s
    }
    let started = clocks.wall.now(clocks.clock)
    var until: Option[ident::WallTime] = None
    if window_s > 0 {
        until = Some(ident::WallTime(utc_ns: started.utc_ns.saturating_add(i64.widen(window_s) * 1_000_000_000), uncertainty_ns: started.uncertainty_ns))
    }
    discard attempt await moves.send(Moved.Committed(span: span.span, commit: commit, until: until))
    for commanded in span.commands {
        match commanded.foreseen {
            Some(foreseen) => {
                match commanded.command {
                    Command.Call(hash: _, reply: Some(_)) => {
                        match foreseen.reply {
                            Some(bytes) => {
                                discard attempt await moves.send(Moved.Replied(step: commanded.step, reply: copied_bytes(bytes, alloc)))
                            }
                            None => {
                            }
                        }
                    }
                    else => {
                    }
                }
                continue
            }
            None => {
            }
        }
        if commanded.class.is_irreversible() {
            continue
        }
        match try await carried_out(commanded, control, alloc) {
            Ok(Some(reply)) => {
                discard attempt await moves.send(Moved.Replied(step: commanded.step, reply: take reply))
            }
            Ok(None) => {
            }
            Err(code) => return Some(finish_as(PlanState.Failed, code: code.as_str(), alloc))
        }
    }
    try await converged(tree_activations(span, alloc), commit, tree: acting, clocks, alloc)
    if health_s > 0 and not try await healthy(span.activations, window_s: health_s, tree: acting, clocks, alloc) {
        return Some(try await reverted(applying, span, commit, acting, control, code: "plan.unhealthy", moves, alloc))
    }
    if confirm_s > 0 and not try await confirmed(applying.hash, within_s: confirm_s, tree: acting, clocks, alloc) {
        return Some(try await reverted(applying, span, commit, acting, control, code: "plan.unconfirmed", moves, alloc))
    }
    return match try await deliver_outbox(applying, span, control, acting, clocks, moves, alloc) {
        Some(code) => Some(finish_as(PlanState.Failed, code: code.as_str(), alloc))
        None => None
    }
} committed_span

/// The activations of `span` its tree steps make, which `supervisor` carries out.
fn tree_activations(span: SpanWork, alloc: mem::Alloc) -> mem::List[Activation] {
    var activations = mem::List[Activation].empty(alloc)
    for activation in span.activations {
        if span.commands.position(fn(commanded: InstanceStep) => commanded.step == activation.step).is_some() {
            continue
        }
        mut activations.push(Activation(moniker: ident::Moniker(text: activation.moniker.text), step: activation.step, kind: activation.kind, migration: activation.migration, pause_ms: activation.pause_ms, cpu: activation.cpu))
    }
    return activations
} tree_activations

/// Commits `writes` of the plan `applying` through `acting`, giving the store's code when that fails.
fn commit_writes(applying: Applying, take writes: mem::List[store::Write], acting: store::service::View, alloc: mem::Alloc) -> Option[text::String] fails task::Cancelled uses wait {
    let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: None, plan: Some(applying.hash), intent: None)
    return match first attempt await acting.commit(take transaction, typed: true, alloc) {
        Ok(_) => None
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => Some(text::String.of(failed.code().as_str(), alloc))
    }
} commit_writes

/// The end of an apply in `state` with the code `code`.
fn finish_as(state: PlanState, code: Str, alloc: mem::Alloc) -> Moved {
    return Moved.Ended(state: state, code: Some(text::String.of(code, alloc)))
} finish_as

/// Commits the span `span` of `applying` through `acting`, the span commits `earlier` before it, under the request key `<key>.<span>`: the writes of its steps, a `Held` outbox entry per irreversible delivery, the plan's record when the span is provisional, and the plan's reads, each at its recorded commit or at the commit of the earlier span that wrote it; `plan.stale` when one changed since the preview.
pub fn commit_span(
    applying: Applying,
    span: SpanWork,
    earlier: mem::List[ident::CommitId],
    acting: store::service::View,
    alloc: mem::Alloc,
    ) -> Result[ident::CommitId, text::String] fails task::Cancelled uses wait {
    var all = mem::List[store::Write].empty(alloc)
    for each in span.steps {
        let Some(writes) = duplicate(each.writes, alloc) else {
            return Err(text::String.of("store.corrupt", alloc))
        }
        for write in take writes {
            mut all.push(take write)
        }
    }
    if applying.scheduled.is_some() and span.span == 1 {
        for path in take scheduling_paths(applying.hash, alloc) {
            mut all.push(store::Write.Delete(path: take path))
        }
    }
    for write in take entries_in(applying, span: span.span, entries: outbox_of(applying, span, alloc), from: 0, status: DeliveryStatus.Held, alloc) {
        mut all.push(take write)
    }
    if applying.plan.options.confirm_within_s.is_some() {
        var bytes = mem::Bytes.empty(alloc)
        mem::wire::Codec[Plan].encode(applying.plan, out: mut bytes)
        mut all.push(store::Write.Put(path: plan_path(applying.hash, alloc), value: store::Value.Record(type: store::TypeRef.of("link::Plan", schema: mem::wire::Codec[Plan].schema_hash(), alloc), bytes: take bytes, secret: false)))
    }
    var reads = mem::List[store::Read].empty(alloc)
    for read in span.reads {
        mut reads.push(store::Read(path: ident::Path(text: text::String.of(read.path.text.as_str(), alloc)), version: expected_version(applying, read, span: span.span, earlier), scope: store::Scope.Node))
    }
    var key = text::String.of(applying.key.as_str(), alloc)
    mut key.push('.')
    mut key.write(Dyn[Render].view(span.span), budget: 12)
    let intent = match applying.plan.options.intent {
        Some(text) => Some(text::String.of(text.as_str(), alloc))
        None => None
    }
    let transaction = store::Transaction(base: None, reads: take reads, expects: mem::List.empty(alloc), writes: take all, key: Some(take key), plan: Some(applying.hash), intent: take intent)
    return match first attempt await acting.commit(take transaction, typed: true, alloc) {
        Ok(done) => Ok(done.number)
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(store::service::ViewError.Failed(store::service::Failure.ConflictRead)) or Err(store::service::ViewError.Failed(store::service::Failure.ConflictWrite)) or Err(store::service::ViewError.Failed(store::service::Failure.ConflictExpect)) => Err(text::String.of("plan.stale", alloc))
        Err(failed) => Err(text::String.of(failed.code().as_str(), alloc))
    }
} commit_span

/// The code `plan.stale` when a node of the read set of `applying`, as `acting` reads it, is not at the version the span numbered `span` expects after the span commits `earlier`, or the code of the failing read.
pub fn stale_read(
    applying: Applying,
    span: u32,
    earlier: mem::List[ident::CommitId],
    acting: store::service::View,
    alloc: mem::Alloc,
    ) -> Option[text::String] fails task::Cancelled uses wait {
    for read in applying.plan.inputs.reads {
        let found = match first attempt await acting.get(ident::Path(text: text::String.of(read.path.text.as_str(), alloc)), at: None, alloc) {
            Ok(node) => store::Version.Commit(node.version)
            Err(store::service::ViewError.Failed(store::service::Failure.NotFound)) => store::Version.Absent
            Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
            Err(failed) => return Some(text::String.of(failed.code().as_str(), alloc))
        }
        if found != expected_version(applying, read, span, earlier) {
            return Some(text::String.of("plan.stale", alloc))
        }
    }
    return None
} stale_read

/// The version the node `read` of the read set of `applying` has when the span numbered `span` commits after the span commits `earlier`: the commit of the latest earlier span writing it, else its recorded commit, or none for `#0`.
fn expected_version(applying: Applying, read: NodeRead, span: u32, earlier: mem::List[ident::CommitId]) -> store::Version {
    return match latest_writer(applying, path: read.path, before: span) {
        Some(at) => store::Version.Commit(earlier[at])
        None => match read.commit.number {
            0 => store::Version.Absent
            else => store::Version.Commit(read.commit)
        }
    }
} expected_version

/// The index among the spans of `applying` of the latest span before the span numbered `before` that writes `path`.
fn latest_writer(applying: Applying, path: ident::Path, before: u32) -> Option[usize] {
    var found: Option[usize] = None
    for at in 0..<applying.spans.len() {
        if applying.spans[at].span >= before {
            continue
        }
        for each in applying.spans[at].steps {
            for write in each.writes {
                if write_names(write, path) {
                    found = Some(at)
                }
            }
        }
    }
    return found
} latest_writer

/// Whether `write` writes the node at `path`.
fn write_names(write: store::Write, path: ident::Path) -> bool {
    return match write {
        store::Write.Put(path: written, value: _) or store::Write.Add(path: written, value: _) => written == path
        store::Write.Delete(path: written) => written == path
        else => false
    }
} write_names

/// `/sys/plans/<hash>`, where a plan awaiting its confirmation keeps its record.
pub fn plan_path(hash: ident::HashValue, alloc: mem::Alloc) -> ident::Path {
    var path = text::String.of("/sys/plans/", alloc)
    mut path.append(hash.short_form().as_str())
    return ident::Path(text: take path)
} plan_path

/// The record of `/live/instances/<moniker>`.
fn live_instance(tree: store::service::View, moniker: ident::Moniker, alloc: mem::Alloc) -> Option[os::LiveInstance] fails task::Cancelled uses wait {
    var path = text::String.of("/live/instances/", alloc)
    mut path.append(moniker.text.as_str())
    return try await Records[os::LiveInstance].at(tree, path: path.as_str(), alloc)
} live_instance

/// Waits until each instance `activations` activates has been brought to the desired state of the commit `commit`, or `CONVERGE_MS` passed.
fn converged(
    activations: mem::List[Activation],
    commit: ident::CommitId,
    tree: store::service::View,
    clocks: Clocks,
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    var waited: u64 = 0
    for activation in activations {
        loop {
            let reached = match try await live_instance(tree, moniker: activation.moniker, alloc) {
                Some(live) => live.status.desired >= commit.number
                None => activation.kind == ActivationKind.Stop
            }
            if reached or waited >= CONVERGE_MS {
                break
            }
            try await clocks.clock.sleep(POLL_MS)
            waited += POLL_MS
        }
    }
} converged

/// Whether the instances `activations` activates, other than those it stops, stay healthy for `window_s` seconds: none enters `failed`, restarts after a trap or goes missing.
fn healthy(
    activations: mem::List[Activation],
    window_s: u32,
    tree: store::service::View,
    clocks: Clocks,
    alloc: mem::Alloc,
    ) -> bool fails task::Cancelled uses wait {
    var watched = mem::List[ident::Moniker].empty(alloc)
    var restarts = mem::List[u32].empty(alloc)
    for activation in activations {
        if activation.kind == ActivationKind.Stop {
            continue
        }
        let Some(live) = try await live_instance(tree, moniker: activation.moniker, alloc) else {
            return false
        }
        mut watched.push(ident::Moniker(text: activation.moniker.text))
        mut restarts.push(live.restarts)
    }
    let window_ms = u64.widen(window_s) * 1_000
    var waited: u64 = 0
    while waited < window_ms {
        for at in 0..<watched.len() {
            let Some(live) = try await live_instance(tree, moniker: watched[at], alloc) else {
                return false
            }
            if live.state == os::Lifecycle.Failed or live.restarts > restarts[at] {
                return false
            }
        }
        try await clocks.clock.sleep(POLL_MS)
        waited += POLL_MS
    }
    return true
} healthy

/// Whether `confirm` deletes the plan's record at `/sys/plans` within `within_s` seconds.
fn confirmed(
    hash: ident::HashValue,
    within_s: u32,
    tree: store::service::View,
    clocks: Clocks,
    alloc: mem::Alloc,
    ) -> bool fails task::Cancelled uses wait {
    let path = plan_path(hash, alloc)
    let deadline_ms = u64.widen(within_s) * 1_000
    var waited: u64 = 0
    loop {
        match try await node_at(tree, path: path.text.as_str(), alloc) {
            Ok(None) => return true
            else => {
            }
        }
        if waited >= deadline_ms {
            return false
        }
        try await clocks.clock.sleep(POLL_MS)
        waited += POLL_MS
    }
} confirmed

/// Reverts the commit `commit` of the span `span` of `applying` as revert by blame does, its outbox entries then `Cancelled`, which `out` hears of, and what its replays keep dropped through `control`, the plan ending `reverted` with `code`, or `failed` with `conflict.revert` when a later commit changed what it restores.
fn reverted(
    applying: Applying,
    span: SpanWork,
    commit: ident::CommitId,
    acting: store::service::View,
    control: os::Control,
    code: Str,
    moves: task::Sender[Moved],
    alloc: mem::Alloc,
    ) -> Moved fails task::Cancelled uses wait {
    match first attempt await acting.revert(commit, dry_run: false, alloc) {
        Ok(_) => {
        }
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => return finish_as(PlanState.Failed, code: failed.code().as_str(), alloc)
    }
    try await dropped(span, control, alloc)
    let entries = outbox_of(applying, span, alloc)
    let cancelled = entries_in(applying, span: span.span, entries, from: 0, status: DeliveryStatus.Cancelled, alloc)
    if cancelled.len() > 0 {
        match try await commit_writes(applying, writes: take cancelled, acting, alloc) {
            Some(failed) => return finish_as(PlanState.Failed, code: failed.as_str(), alloc)
            None => {
            }
        }
        try await told_cancelled(applying, span: span.span, from: 1, through: entries.len(), moves, alloc)
    }
    return finish_as(PlanState.Reverted, code, alloc)
} reverted

/// Reverts, as revert by blame does, on the running branch through `tree` and on each other branch but preview and job branches, the commit that last wrote each plan's record at `/sys/plans`, a span commit awaiting its confirmation or a timed plan's schedule, whose apply ended with `link`'s restart; gives the event of each such plan's failure with `plan.interrupted`.
pub fn recover_plans(tree: store::service::View, alloc: mem::Alloc) -> mem::List[PlanEvent] fails task::Cancelled uses wait {
    var interrupted = mem::List[PlanEvent].empty(alloc)
    try await recovered_on(tree, mut interrupted, alloc)
    let branches = try await other_branches(tree, alloc)
    for name in take branches {
        match first attempt await tree.on_branch(take name, alloc) {
            Ok(store::service::Branched(branch: _, view: reached)) => try await recovered_on(reached, mut interrupted, alloc)
            Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
            Err(_) => {
            }
        }
    }
    return interrupted
} recover_plans

/// The names of the branches `/history/branches` lists through `tree`, but the running branch and preview and job branches.
fn other_branches(tree: store::service::View, alloc: mem::Alloc) -> mem::List[text::String] fails task::Cancelled uses wait {
    var names = mem::List[text::String].empty(alloc)
    var prefixes = mem::List[text::String].empty(alloc)
    mut prefixes.push(text::String.empty(alloc))
    while prefixes.len() > 0 {
        let prefix = mut prefixes.remove(0)
        var path = text::String.of("/history/branches", alloc)
        if prefix.byte_len() > 0 {
            mut path.push('/')
            mut path.append(prefix.as_str())
        }
        let listing = match first attempt await tree.list(ident::Path(text: take path), after: None, limit: 256, alloc) {
            Ok(found) => found
            Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
            Err(_) => continue
        }
        for entry in listing.entries {
            var name = text::String.of(prefix.as_str(), alloc)
            if name.byte_len() > 0 {
                mut name.push('/')
            }
            mut name.append(entry.name.as_str())
            match entry.kind {
                store::NodeKind.Dir => {
                    if name.as_str() != "preview" and name.as_str() != "job" {
                        mut prefixes.push(take name)
                    }
                }
                else => {
                    if name.as_str() != RUNNING_BRANCH {
                        mut names.push(take name)
                    }
                }
            }
        }
    }
    return names
} other_branches

/// Reverts through `view` the commit that last wrote each plan's record at `/sys/plans` of its branch, adding the event of each such plan's failure with `plan.interrupted` to `interrupted`.
fn recovered_on(view: store::service::View, mut interrupted: mem::List[PlanEvent], alloc: mem::Alloc) fails task::Cancelled uses wait {
    let listing = match first attempt await view.list(ident::Path(text: text::String.of("/sys/plans", alloc)), after: None, limit: 256, alloc) {
        Ok(found) => found
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return
    }
    for entry in listing.entries {
        var path = text::String.of("/sys/plans/", alloc)
        mut path.append(entry.name.as_str())
        let writers = match first attempt await view.history(ident::Path(text: take path), before: None, limit: 1, alloc) {
            Ok(found) => found
            Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
            Err(_) => continue
        }
        let Some(written) = writers.get(0) else {
            continue
        }
        let Some(plan) = written.plan else {
            continue
        }
        match attempt await view.revert(written.number, dry_run: false, alloc) {
            Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
        mut interrupted.push(PlanEvent(plan: plan, state: PlanState.Failed, span: span_of_key(written.key), commit: Some(written.number), entry: None, code: Some(text::String.of("plan.interrupted", alloc))))
    }
} recovered_on

/// The span a commit of a plan's apply commits under the request key `<key>.<span>`, 0 for none.
fn span_of_key(key: Option[text::String]) -> u32 {
    let Some(written) = key else {
        return 0
    }
    let text = written.as_str()
    var cut: usize = 0
    for at in 0..<text.byte_len() {
        if text.as_bytes()[at] == b'.' {
            cut = at + 1
        }
    }
    let Some(last) = text.slice_bytes(cut, end: text.byte_len()) else {
        return 0
    }
    return u32.saturate(number_of(last).value_or(0))
} span_of_key

/// `/sys/schedule/<short hash>` and `/sys/plans/<short hash>`, where a timed plan keeps its schedule and its record until it applies.
pub fn scheduling_paths(hash: ident::HashValue, alloc: mem::Alloc) -> mem::List[ident::Path] {
    var paths = mem::List[ident::Path].empty(alloc)
    var scheduled = text::String.of("/sys/schedule/", alloc)
    mut scheduled.append(hash.short_form().as_str())
    mut paths.push(ident::Path(text: take scheduled))
    mut paths.push(plan_path(hash, alloc))
    return paths
} scheduling_paths

/// Commits, under the request key of `applying`, its `TimedPlan` at `/sys/schedule` and its record at `/sys/plans` through `acting`, giving the store's code when that fails.
fn schedule(applying: Applying, at: ident::WallTime, acting: store::service::View, alloc: mem::Alloc) -> Option[text::String] fails task::Cancelled uses wait {
    var timed = mem::Bytes.empty(alloc)
    mem::wire::Codec[TimedPlan].encode(TimedPlan(plan: applying.hash, principal: ident::Principal(text: applying.plan.principal.text), at: at, key: text::String.of(applying.key.as_str(), alloc)), out: mut timed)
    var record = mem::Bytes.empty(alloc)
    mem::wire::Codec[Plan].encode(applying.plan, out: mut record)
    var paths = scheduling_paths(applying.hash, alloc)
    var writes = mem::List[store::Write].empty(alloc)
    let plan_record = mut paths.remove(1)
    let schedule_record = mut paths.remove(0)
    mut writes.push(store::Write.Put(path: take schedule_record, value: store::Value.Record(type: store::TypeRef.of("link::TimedPlan", schema: mem::wire::Codec[TimedPlan].schema_hash(), alloc), bytes: take timed, secret: false)))
    mut writes.push(store::Write.Put(path: take plan_record, value: store::Value.Record(type: store::TypeRef.of("link::Plan", schema: mem::wire::Codec[Plan].schema_hash(), alloc), bytes: take record, secret: false)))
    var key = text::String.of(applying.key.as_str(), alloc)
    mut key.append(".0")
    let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: Some(take key), plan: Some(applying.hash), intent: None)
    return match first attempt await acting.commit(take transaction, typed: true, alloc) {
        Ok(_) => None
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => Some(text::String.of(failed.code().as_str(), alloc))
    }
} schedule
