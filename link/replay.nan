//! Replays at apply: the instances a span activates or messages paused within the plan's activation time, each of its steps whose message a fork foresaw replayed on its instance, on a branch holding the span's earlier steps, and compared with its fork; then the span committed and the instances resumed, what the replays keep released but what the outbox delivers.

/// Commits the span `span` of `applying` through `acting`, after the span commits `earlier`, once the plan's read set holds as the span expects, the instances it activates or messages are paused through `control`, within the plan's activation time by `clocks`, and each of its steps whose message a fork foresaw is replayed on its instance giving what its fork foresaw; then resumes them, releasing what the replays keep but what the outbox delivers. The commit, or the code of the failure, after which nothing of the span is committed and nothing the replays keep is released: `plan.stale` when a node of the read set changed, `plan.activation-timeout` when the instances do not pause in time, `plan.diverged` when a replay gives otherwise than its fork.
pub fn replayed_commit(
    applying: Applying,
    span: SpanWork,
    earlier: mem::List[ident::CommitId],
    acting: store::service::View,
    control: os::Control,
    clocks: Clocks,
    alloc: mem::Alloc,
    ) -> Result[ident::CommitId, text::String] fails task::Cancelled uses wait {
    match try await stale_read(applying, span: span.span, earlier, acting, alloc) {
        Some(code) => return Err(take code)
        None => {
        }
    }
    let targets = targets_of(span, alloc)
    let paused = try await task::within(clocks.clock, ms: u64.widen(applying.activation_ms), body: fn() fails task::Cancelled uses wait {
        for target in targets {
            match attempt await control.pause(ident::Moniker(text: target.text), alloc) {
                Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
                else => {
                }
            }
        }
    })
    if paused.is_none() {
        try await resumed(targets, control, alloc)
        return Err(text::String.of("plan.activation-timeout", alloc))
    }
    let committed: Result[ident::CommitId, text::String] = match try await replayed_span(span, acting, control, alloc) {
        Some(code) => Err(take code)
        None => try await commit_span(applying, span, earlier, acting, alloc)
    }
    if committed.is_err() {
        try await dropped(span, control, alloc)
    }
    try await resumed(targets, control, alloc)
    if committed.is_ok() {
        try await released(applying, span, control, alloc)
    }
    return committed
} replayed_commit

/// The instances `span` activates or sends a message, in moniker order, but those an apply never pauses.
fn targets_of(span: SpanWork, alloc: mem::Alloc) -> mem::List[ident::Moniker] {
    var targets = mem::List[ident::Moniker].empty(alloc)
    for activation in span.activations {
        add_target(mut targets, moniker: activation.moniker)
    }
    for commanded in span.commands {
        if commanded.messages() {
            add_target(mut targets, moniker: commanded.moniker)
        }
    }
    mut targets.sort_by(fn(left: ident::Moniker, right: ident::Moniker) => left.text.as_str().as_bytes().cmp(right.text.as_str().as_bytes()))
    return targets
} targets_of

/// Adds `moniker` to `targets` unless they hold it or it is `link` or `store`, which an apply never pauses as it answers and commits through them.
fn add_target(mut targets: mem::List[ident::Moniker], moniker: ident::Moniker) {
    let name = moniker.text.as_str()
    if name == "link" or name == "store" or targets.position(fn(known: ident::Moniker) => known == moniker).is_some() {
        return
    }
    mut targets.push(ident::Moniker(text: moniker.text))
} add_target

/// Replays through `control` each step of `span` whose message a fork foresaw, on a preview branch `acting` makes from the head of `main`, which holds the writes of the span's other steps before it and is deleted at the end; the code of the failure, `plan.diverged` when a replay gives otherwise than its fork.
fn replayed_span(span: SpanWork, acting: store::service::View, control: os::Control, alloc: mem::Alloc) -> Option[text::String] fails task::Cancelled uses wait {
    if span.commands.position(fn(commanded: InstanceStep) => commanded.foreseen.is_some()).is_none() {
        return None
    }
    let branched = match first attempt await acting.preview(alloc) {
        Ok(made) => made
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => return Some(text::String.of(failed.code().as_str(), alloc))
    }
    let store::service::Branched(branch: branch, view: view) = branched
    let outcome = try await replayed_steps(span, branch: branch.name.as_str(), base: branch.head, view, control, alloc)
    match attempt await acting.delete_branch(text::String.of(branch.name.as_str(), alloc), alloc) {
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
    return outcome
} replayed_span

/// Replays through `control` each step of `span` whose message a fork foresaw on the branch `branch` through `view`, from its commit `base`, committing there first the writes of each other step before it; the code of the first failure.
fn replayed_steps(
    span: SpanWork,
    branch: Str,
    base: ident::CommitId,
    view: store::service::View,
    control: os::Control,
    alloc: mem::Alloc,
    ) -> Option[text::String] fails task::Cancelled uses wait {
    var head = base
    for each in span.steps {
        match span.commands.position(fn(commanded: InstanceStep) => commanded.step == each.step and commanded.foreseen.is_some()) {
            Some(at) => {
                match try await replayed_step(span.commands[at], view, branch, head, control, alloc) {
                    Ok(after) => {
                        head = after
                    }
                    Err(code) => return Some(take code)
                }
            }
            None => {
                if each.writes.len() > 0 {
                    let Some(writes) = duplicate(each.writes, alloc) else {
                        return Some(text::String.of("store.corrupt", alloc))
                    }
                    let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: None, plan: None, intent: None)
                    head = match first attempt await view.commit(take transaction, typed: true, alloc) {
                        Ok(done) => done.number
                        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
                        Err(failed) => return Some(text::String.of(failed.code().as_str(), alloc))
                    }
                }
            }
        }
    }
    return None
} replayed_steps

/// Replays the step `commanded`, whose message a fork foresaw, on its paused instance through `control`, its Views of `main` reaching the branch `branch`, whose head is `head` through `view`; the branch's head after the replay's writes, or the code of the failure, `plan.diverged` when its reply, the messages and keyed tasks it keeps or its writes differ from its fork's.
fn replayed_step(
    commanded: InstanceStep,
    view: store::service::View,
    branch: Str,
    head: ident::CommitId,
    control: os::Control,
    alloc: mem::Alloc,
    ) -> Result[ident::CommitId, text::String] fails task::Cancelled uses wait {
    let Some(foreseen) = commanded.foreseen else {
        return Ok(head)
    }
    let Some(call) = commanded.fork_call(alloc) else {
        return Ok(head)
    }
    let redelivery = match commanded.command {
        Command.Redeliver(seq: seq, hash: _) => Some(seq)
        else => None
    }
    let Some(recorded) = duplicate(foreseen.recorded, alloc) else {
        return Err(text::String.of("store.corrupt", alloc))
    }
    let given = match first attempt await control.replay(ident::Moniker(text: commanded.moniker.text), take call, redelivery, branch: text::String.of(branch, alloc), take recorded, alloc) {
        Ok(found) => found
        Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => return Err(text::String.of(failed.code().as_str(), alloc))
    }
    let Ran(before: _, writes: writes, after: after) = match try await ran_on(view, branch, before: head, alloc) {
        Ok(found) => found
        Err(failure) => return Err(text::String.of(failure.code.as_str(), alloc))
    }
    if not same_run(foreseen, given, writes) {
        return Err(text::String.of("plan.diverged", alloc))
    }
    return Ok(after)
} replayed_step

/// Whether a replay that gave `given` and wrote `writes` gave what its fork foresaw in `foreseen`: the same reply, the same messages by operation, class and encoding, keyed tasks of the same classes, and the same writes.
fn same_run(foreseen: Foreseen, given: os::Replayed, writes: mem::List[store::Write]) -> bool {
    if foreseen.reply != given.reply or foreseen.spawns != given.spawns or foreseen.writes != writes or foreseen.sent.len() != given.sent.len() {
        return false
    }
    for at in 0..<given.sent.len() {
        let expected = foreseen.sent[at]
        let sent = given.sent[at]
        if expected.operation.as_str() != sent.operation.as_str() or expected.class != sent.class or expected.encoded != sent.encoded {
            return false
        }
    }
    return true
} same_run

/// Releases through `control` what the replays of `span`'s steps keep on their instances, but the messages and keyed tasks the outbox entries of `span` of `applying` deliver.
fn released(applying: Applying, span: SpanWork, control: os::Control, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let entries = outbox_of(applying, span, alloc)
    for moniker in replayed_instances(span, alloc) {
        var staying = mem::List[os::Kept].empty(alloc)
        for entry in entries {
            match entry.kept {
                Some(item) => {
                    if entry.commanded.moniker == moniker {
                        mut staying.push(item)
                    }
                }
                None => {
                }
            }
        }
        match attempt await control.release(ident::Moniker(text: moniker.text), kept: take staying, alloc) {
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
    }
} released

/// Drops through `control` what the replays of `span`'s steps keep on their instances.
pub fn dropped(span: SpanWork, control: os::Control, alloc: mem::Alloc) fails task::Cancelled uses wait {
    for moniker in replayed_instances(span, alloc) {
        match attempt await control.discard_kept(ident::Moniker(text: moniker.text), alloc) {
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
    }
} dropped

/// Resumes through `control` each instance of `targets`.
fn resumed(targets: mem::List[ident::Moniker], control: os::Control, alloc: mem::Alloc) fails task::Cancelled uses wait {
    for target in targets {
        match attempt await control.resume(ident::Moniker(text: target.text), alloc) {
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
    }
} resumed

/// The instances `span`'s steps whose message a fork foresaw name, once each.
fn replayed_instances(span: SpanWork, alloc: mem::Alloc) -> mem::List[ident::Moniker] {
    var instances = mem::List[ident::Moniker].empty(alloc)
    for commanded in span.commands {
        if commanded.foreseen.is_some() and instances.position(fn(known: ident::Moniker) => known == commanded.moniker).is_none() {
            mut instances.push(ident::Moniker(text: commanded.moniker.text))
        }
    }
    return instances
} replayed_instances
