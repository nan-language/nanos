//! Notices: what the link tells the journal and `/live` of its sessions, in order, one at a time.

/// A notice: an event of a session, a rejected `hello`, a session's record at `/live/sessions`, or its withdrawal; an event of a plan, its record at `/live/plans`, or its withdrawal.
pub closed enum Notice derives Encode {
    Event(kind: text::Fixed[32], event: SessionEvent)
    Rejected(HelloRejected)
    Live(session: u64, record: LiveSession)
    Withdrawn(session: u64)
    Plan(kind: text::Fixed[32], event: PlanEvent)
    PlanLive(plan: ident::HashValue, record: LivePlan)
    PlanWithdrawn(plan: ident::HashValue)
} Notice

/// Queues `notice` behind those waiting.
fn Linker.notify(mut self, take notice: Notice, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    mut self.notices.push(take notice)
    mut self.tell(mut env, mut cx)
} Linker.notify

/// Has a keyed task tell the notice at the head of the queue, once none is being told.
fn Linker.tell(mut self, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    if self.notifying or self.notices.len() == 0 {
        return
    }
    let notice = mut self.notices.remove(0)
    self.notifying = true
    let events = env.events
    let live = env.live
    let plans_live = env.plans_live
    let alloc = env.alloc
    mut cx.spawn(key: NOTIFYING, run: fn[take notice](out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 32_768 {
        try await told(take notice, events, live, plans_live, alloc)
        discard attempt await out.notified()
    })
} Linker.tell

fn Linker.notified(mut self, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    self.notifying = false
    mut self.tell(mut env, mut cx)
} Linker.notified

/// Emits the event of `notice` through `events`, or publishes or withdraws its record through `live` or `plans_live`.
fn told(take notice: Notice, events: journal::Source, live: os::Live, plans_live: os::Live, alloc: mem::Alloc) fails task::Cancelled uses wait {
    match notice {
        Notice.Event(kind: kind, event: event) => try await events.emit(kind.as_str(), severity: journal::Severity.Info, payload: event, alloc)
        Notice.Rejected(rejected) => try await events.emit("link.hello-rejected", severity: journal::Severity.Warn, payload: rejected, alloc)
        Notice.Live(session: session, record: record) => try await live.publish_below(below: session_text(session).as_str(), value: os::published("link::LiveSession", value: record, alloc), alloc)
        Notice.Withdrawn(session: session) => try await live.withdraw_below(below: session_text(session).as_str(), alloc)
        Notice.Plan(kind: kind, event: event) => try await events.emit(kind.as_str(), severity: journal::Severity.Info, payload: event, alloc)
        Notice.PlanLive(plan: plan, record: record) => try await plans_live.publish_below(below: plan.short_form().as_str(), value: os::published("link::LivePlan", value: record, alloc), alloc)
        Notice.PlanWithdrawn(plan: plan) => try await plans_live.withdraw_below(below: plan.short_form().as_str(), alloc)
    }
} told
