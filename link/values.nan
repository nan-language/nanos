//! Values: the canonical rendering of the records the tree holds, by the canonical path of their type.

/// Renders the values of `T`.
pub open struct Renders[T: Encode and Render] {
} Renders

/// The canonical rendering of `raw` as a value of `T`, `None` when it does not decode as one.
pub fn Renders.text(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[text::String] {
    let Ok(value) = attempt mem::wire::Codec[T].decode(raw, alloc) else {
        return None
    }
    var rendered = text::String.empty(alloc)
    mut rendered.write(Dyn[Render].view(value), budget: 1_048_576)
    return Some(take rendered)
} Renders.text

/// The canonical rendering of `raw`, a value of the type of canonical path `type`; for a type the link does not hold or bytes that do not decode as it, the type and the size.
pub fn render_value(type: Str, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> text::String {
    let rendered = match type {
        "os::InstanceSpec" => Renders[os::InstanceSpec].text(raw, alloc)
        "os::Grant" => Renders[os::Grant].text(raw, alloc)
        "os::PrincipalRecord" => Renders[os::PrincipalRecord].text(raw, alloc)
        "os::Checkpoint" => Renders[os::Checkpoint].text(raw, alloc)
        "os::DeadLetter" => Renders[os::DeadLetter].text(raw, alloc)
        "os::LiveStatus" => Renders[os::LiveStatus].text(raw, alloc)
        "os::LiveInstance" => Renders[os::LiveInstance].text(raw, alloc)
        "os::Account" => Renders[os::Account].text(raw, alloc)
        "os::LiveCpu" => Renders[os::LiveCpu].text(raw, alloc)
        "os::LiveSecurity" => Renders[os::LiveSecurity].text(raw, alloc)
        "os::KeysSecurity" => Renders[os::KeysSecurity].text(raw, alloc)
        "os::LiveBoot" => Renders[os::LiveBoot].text(raw, alloc)
        "os::Machine" => Renders[os::Machine].text(raw, alloc)
        "bootfmt::BootState" => Renders[bootfmt::BootState].text(raw, alloc)
        "clock::ClockConfig" => Renders[clock::ClockConfig].text(raw, alloc)
        "power::PowerConfig" => Renders[power::PowerConfig].text(raw, alloc)
        "policy::PolicyConfig" => Renders[policy::PolicyConfig].text(raw, alloc)
        "policy::SignedPolicy" => Renders[policy::SignedPolicy].text(raw, alloc)
        "journal::JournalConfig" => Renders[journal::JournalConfig].text(raw, alloc)
        "journal::Event" => Renders[journal::Event].text(raw, alloc)
        "journal::FaultRecord" => Renders[journal::FaultRecord].text(raw, alloc)
        "journal::LogRecord" => Renders[journal::LogRecord].text(raw, alloc)
        "journal::MetricSample" => Renders[journal::MetricSample].text(raw, alloc)
        "journal::TraceRecord" => Renders[journal::TraceRecord].text(raw, alloc)
        "store::Branch" => Renders[store::Branch].text(raw, alloc)
        "store::CommitMeta" => Renders[store::CommitMeta].text(raw, alloc)
        "store::service::StoreConfig" => Renders[store::service::StoreConfig].text(raw, alloc)
        "store::service::LiveStore" => Renders[store::service::LiveStore].text(raw, alloc)
        "devices::LiveDevice" => Renders[devices::LiveDevice].text(raw, alloc)
        "devices::BlockInfo" => Renders[devices::BlockInfo].text(raw, alloc)
        "devices::Partition" => Renders[devices::Partition].text(raw, alloc)
        "link::LinkConfig" => Renders[LinkConfig].text(raw, alloc)
        "link::LiveSession" => Renders[LiveSession].text(raw, alloc)
        else => None
    }
    return match rendered {
        Some(text) => text
        None => opaque(type, size: raw.byte_len(), alloc)
    }
} render_value

/// The canonical rendering of `raw` as a value of `T` when `schema` is the schema hash of `T`.
pub fn Renders.matching(schema: ident::HashValue, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[text::String] {
    if schema.bytes != mem::wire::Codec[T].schema_hash().bytes {
        return None
    }
    return Renders[T].text(raw, alloc)
} Renders.matching

/// The canonical rendering of an event's payload by the payload type of its schema hash; for a type the link does not hold, the schema's short form and the size.
pub fn render_payload(payload: journal::Payload, alloc: mem::Alloc) -> text::String {
    let raw = Untrusted.of(payload.bytes.view())
    var rendered = journal_payload(payload.schema, raw, alloc)
    if rendered.is_none() {
        rendered = base_payload(payload.schema, raw, alloc)
    }
    return match rendered {
        Some(text) => text
        None => opaque(payload.schema.short_form().as_str(), size: payload.bytes.len(), alloc)
    }
} render_payload

/// The rendering of a payload of a kind the core and the runner record, when `schema` names one.
fn journal_payload(schema: ident::HashValue, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[text::String] {
    var rendered: Option[text::String] = None
    if rendered.is_none() {
        rendered = Renders[journal::InstanceStarted].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::InstanceStopped].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::InstanceTrapped].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::IntegrityFault].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::InstanceFailed].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::SlowHandler].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::CheckpointFailed].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::GrantsRevoked].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::DeviceEvent].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::StoreMounted].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::StoreCorruption].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::StoreDeviceFailed].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::HistoryThinned].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::WritesRefused].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::BootStarted].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::CandidateFailed].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::Lost].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::KindRefused].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::ElidedPayload].matching(schema, raw, alloc)
    }
    return rendered
} journal_payload

/// The rendering of a payload of a kind a base instance emits, when `schema` names one.
fn base_payload(schema: ident::HashValue, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[text::String] {
    var rendered: Option[text::String] = None
    if rendered.is_none() {
        rendered = Renders[keys::KeyRotated].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[keys::KeyRevoked].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[keys::OwnerMismatch].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[policy::PolicyChanged].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[policy::PolicyInvalid].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[SessionEvent].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[HelloRejected].matching(schema, raw, alloc)
    }
    return rendered
} base_payload

/// `<type>(<n> bytes)`, what a value of a type the link does not hold renders as.
fn opaque(type: Str, size: usize, alloc: mem::Alloc) -> text::String {
    var text = text::String.of(type, alloc)
    mut text.push('(')
    mut text.write(Dyn[Render].view(size), budget: 24)
    mut text.append(" bytes)")
    return text
} opaque
