//! Values: the canonical rendering of the records the tree holds, by the canonical path of their type.

/// Renders the values of `T`.
pub open struct Renders[T: Encode and Render] {
} Renders

/// The canonical rendering of `raw` as a value of `T`, `None` when it does not decode as one.
pub fn Renders.text(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[text::String] {
    let Ok(value) = attempt mem::wire::Codec[T].decode(raw, alloc) else {
        return None
    }
    var rendered = text::String.empty(alloc)
    mut rendered.write(Dyn[Render].view(value), budget: 1_048_576)
    return Some(take rendered)
} Renders.text

/// A witness of the record type `T` a dispatch on its canonical path reaches.
pub open struct Typed[T: Encode and Render] {
} Typed

/// What a dispatch on the canonical path of a record type does with the type.
pub interface TypeWork {
    fn work[T: Encode and Render](mut self, typed: Typed[T]) limits traceless
} TypeWork

/// The canonical paths of the record types the link holds, each followed by a line feed.
const HELD_TYPES: Str = "os::InstanceSpec\nos::Grant\nos::PrincipalRecord\nos::Checkpoint\nos::DeadLetter\nos::LiveStatus\nos::LiveInstance\nos::Account\nos::LiveCpu\nos::MemorySummary\nos::LiveSecurity\nos::KeysSecurity\nos::LiveBoot\nos::Machine\nbootfmt::BootState\nclock::ClockConfig\npower::PowerConfig\npolicy::PolicyConfig\npolicy::SignedPolicy\njournal::JournalConfig\njournal::Event\njournal::FaultRecord\njournal::LogRecord\njournal::MetricSample\njournal::TraceRecord\nstore::Branch\nstore::CommitMeta\nstore::service::StoreConfig\nstore::service::LiveStore\ndevices::LiveDevice\ndevices::BlockInfo\ndevices::Partition\nlink::LinkConfig\nlink::LiveSession\nlink::Plan\nlink::LivePlan\nlink::OutboxEntry\nlink::TimedPlan\n"

/// Has `work` work on the record type of canonical path `type`, one of `HELD_TYPES`, false for a type the link does not hold.
pub fn on_type[W: TypeWork](type: Str, mut work: W) -> bool {
    match type {
        "os::InstanceSpec" => mut work.work(Typed[os::InstanceSpec]())
        "os::Grant" => mut work.work(Typed[os::Grant]())
        "os::PrincipalRecord" => mut work.work(Typed[os::PrincipalRecord]())
        "os::Checkpoint" => mut work.work(Typed[os::Checkpoint]())
        "os::DeadLetter" => mut work.work(Typed[os::DeadLetter]())
        "os::LiveStatus" => mut work.work(Typed[os::LiveStatus]())
        "os::LiveInstance" => mut work.work(Typed[os::LiveInstance]())
        "os::Account" => mut work.work(Typed[os::Account]())
        "os::LiveCpu" => mut work.work(Typed[os::LiveCpu]())
        "os::MemorySummary" => mut work.work(Typed[os::MemorySummary]())
        "os::LiveSecurity" => mut work.work(Typed[os::LiveSecurity]())
        "os::KeysSecurity" => mut work.work(Typed[os::KeysSecurity]())
        "os::LiveBoot" => mut work.work(Typed[os::LiveBoot]())
        "os::Machine" => mut work.work(Typed[os::Machine]())
        "bootfmt::BootState" => mut work.work(Typed[bootfmt::BootState]())
        "clock::ClockConfig" => mut work.work(Typed[clock::ClockConfig]())
        "power::PowerConfig" => mut work.work(Typed[power::PowerConfig]())
        "policy::PolicyConfig" => mut work.work(Typed[policy::PolicyConfig]())
        "policy::SignedPolicy" => mut work.work(Typed[policy::SignedPolicy]())
        "journal::JournalConfig" => mut work.work(Typed[journal::JournalConfig]())
        "journal::Event" => mut work.work(Typed[journal::Event]())
        "journal::FaultRecord" => mut work.work(Typed[journal::FaultRecord]())
        "journal::LogRecord" => mut work.work(Typed[journal::LogRecord]())
        "journal::MetricSample" => mut work.work(Typed[journal::MetricSample]())
        "journal::TraceRecord" => mut work.work(Typed[journal::TraceRecord]())
        "store::Branch" => mut work.work(Typed[store::Branch]())
        "store::CommitMeta" => mut work.work(Typed[store::CommitMeta]())
        "store::service::StoreConfig" => mut work.work(Typed[store::service::StoreConfig]())
        "store::service::LiveStore" => mut work.work(Typed[store::service::LiveStore]())
        "devices::LiveDevice" => mut work.work(Typed[devices::LiveDevice]())
        "devices::BlockInfo" => mut work.work(Typed[devices::BlockInfo]())
        "devices::Partition" => mut work.work(Typed[devices::Partition]())
        "link::LinkConfig" => mut work.work(Typed[LinkConfig]())
        "link::LiveSession" => mut work.work(Typed[LiveSession]())
        "link::Plan" => mut work.work(Typed[Plan]())
        "link::LivePlan" => mut work.work(Typed[LivePlan]())
        "link::OutboxEntry" => mut work.work(Typed[OutboxEntry]())
        "link::TimedPlan" => mut work.work(Typed[TimedPlan]())
        else => return false
    }
    return true
} on_type

/// Renders bytes as the value of the type a dispatch reaches.
struct Rendering {
    raw: Untrusted[mem::Bytes]
    rendered: Option[text::String]
    alloc: mem::Alloc
} Rendering

impl Rendering: TypeWork

fn Rendering.work[T: Encode and Render](mut self, typed: Typed[T]) {
    self.rendered = Renders[T].text(self.raw.view(), alloc: self.alloc)
} Rendering.work

/// The canonical rendering of `raw`, a value of the type of canonical path `type`; for a type the link does not hold or bytes that do not decode as it, the type and the size.
pub fn render_value(type: Str, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> text::String {
    var rendering = Rendering(raw: raw.copy_prefix(raw.byte_len(), alloc), rendered: None, alloc: alloc)
    discard on_type(type, work: mut rendering)
    return match rendering.rendered {
        Some(text) => text
        None => opaque(type, size: raw.byte_len(), alloc)
    }
} render_value

/// What decoding a value written as text gives: its encoding and its type's schema hash, the failure of text that is no value of its type, or nothing for a type the link does not hold.
pub closed enum Decoded {
    Bytes(bytes: mem::Bytes, schema: mem::wire::SchemaHash)
    Invalid(core::DecodeError)
    Unknown
} Decoded

/// Decodes text as the value of the type a dispatch reaches: a construction literal, or JSON when `json`.
struct Parsing {
    text: text::String
    json: bool
    decoded: Decoded
    alloc: mem::Alloc
} Parsing

impl Parsing: TypeWork

fn Parsing.work[T: Encode and Render](mut self, typed: Typed[T]) {
    let raw = Untrusted.of(self.text.as_str().as_bytes())
    let read = match self.json {
        true => attempt text::json::Codec[T].decode(raw, alloc: self.alloc)
        false => attempt text::construction::Codec[T].decode(raw, alloc: self.alloc)
    }
    match read {
        Ok(value) => {
            var bytes = mem::Bytes.empty(self.alloc)
            mem::wire::Codec[T].encode(value, out: mut bytes)
            self.decoded = Decoded.Bytes(bytes: take bytes, schema: mem::wire::Codec[T].schema_hash())
        }
        Err(error) => {
            self.decoded = Decoded.Invalid(error)
        }
    }
} Parsing.work

/// The encoding of the value of the type of canonical path `type` that `text` writes, as a construction literal, or as JSON when `json`.
pub fn decode_value(type: Str, text: Str, json: bool, alloc: mem::Alloc) -> Decoded {
    var parsing = Parsing(text: text::String.of(text, alloc), json: json, decoded: Decoded.Unknown, alloc: alloc)
    discard on_type(type, work: mut parsing)
    return parsing.decoded
} decode_value

/// Writes the JSON of a value of the type a dispatch reaches.
struct Jsoning {
    raw: Untrusted[mem::Bytes]
    json: Option[text::String]
    alloc: mem::Alloc
} Jsoning

impl Jsoning: TypeWork

fn Jsoning.work[T: Encode and Render](mut self, typed: Typed[T]) {
    let Ok(value) = attempt mem::wire::Codec[T].decode(self.raw.view(), alloc: self.alloc) else {
        return
    }
    var json = text::String.empty(self.alloc)
    text::json::Codec[T].encode(value, out: mut json)
    self.json = Some(take json)
} Jsoning.work

/// The JSON of `raw`, a value of the type of canonical path `type`, `None` for a type the link does not hold or bytes that do not decode as it.
pub fn json_of_value(type: Str, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[text::String] {
    var jsoning = Jsoning(raw: raw.copy_prefix(raw.byte_len(), alloc), json: None, alloc: alloc)
    discard on_type(type, work: mut jsoning)
    return jsoning.json
} json_of_value

/// The canonical path of the record type the link holds whose name the construction literal `text` starts with, `None` when it starts with none or several share that name.
pub fn type_named_by(text: Str, alloc: mem::Alloc) -> Option[text::String] {
    var name_end: usize = 0
    for byte in text.as_bytes() {
        if not ((byte >= b'a' and byte <= b'z') or (byte >= b'A' and byte <= b'Z') or (byte >= b'0' and byte <= b'9') or byte == b'_') {
            break
        }
        name_end += 1
    }
    let Some(name) = text.slice_bytes(0, end: name_end) else {
        return None
    }
    if name_end == 0 {
        return None
    }
    var found: Option[text::String] = None
    var start: usize = 0
    let held = HELD_TYPES.as_bytes()
    for at in 0..<held.len() {
        if held[at] != b'\n' {
            continue
        }
        let Some(path) = HELD_TYPES.slice_bytes(start, end: at) else {
            return None
        }
        start = at + 1
        let named = path.byte_len() > name_end + 2 and path.ends_with(name) and path.as_bytes()[path.byte_len() - name_end - 1] == b':'
        if not named {
            continue
        }
        if found.is_some() {
            return None
        }
        found = Some(text::String.of(path, alloc))
    }
    return found
} type_named_by

/// The canonical rendering of `raw` as a value of `T` when `schema` is the schema hash of `T`.
pub fn Renders.matching(schema: ident::HashValue, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[text::String] {
    if schema.bytes != mem::wire::Codec[T].schema_hash().bytes {
        return None
    }
    return Renders[T].text(raw, alloc)
} Renders.matching

/// The canonical rendering of an event's payload by the payload type of its schema hash; for a type the link does not hold, the schema's short form and the size.
pub fn render_payload(payload: journal::Payload, alloc: mem::Alloc) -> text::String {
    let raw = Untrusted.of(payload.bytes.view())
    var rendered = journal_payload(payload.schema, raw, alloc)
    if rendered.is_none() {
        rendered = base_payload(payload.schema, raw, alloc)
    }
    return match rendered {
        Some(text) => text
        None => opaque(payload.schema.short_form().as_str(), size: payload.bytes.len(), alloc)
    }
} render_payload

/// The rendering of a payload of a kind the core and the runner record, when `schema` names one.
fn journal_payload(schema: ident::HashValue, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[text::String] {
    var rendered: Option[text::String] = None
    if rendered.is_none() {
        rendered = Renders[journal::InstanceStarted].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::InstanceStopped].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::InstanceHibernated].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::InstanceTrapped].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::IntegrityFault].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::InstanceFailed].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::SlowHandler].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::CheckpointFailed].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::GrantsRevoked].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::DeviceEvent].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::StoreMounted].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::StoreCorruption].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::StoreDeviceFailed].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::HistoryThinned].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::WritesRefused].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::BootStarted].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::CandidateFailed].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::Lost].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::KindRefused].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[journal::ElidedPayload].matching(schema, raw, alloc)
    }
    return rendered
} journal_payload

/// The rendering of a payload of a kind a base instance emits, when `schema` names one.
fn base_payload(schema: ident::HashValue, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[text::String] {
    var rendered: Option[text::String] = None
    if rendered.is_none() {
        rendered = Renders[keys::KeyRotated].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[keys::KeyRevoked].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[keys::OwnerMismatch].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[policy::PolicyChanged].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[policy::PolicyInvalid].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[SessionEvent].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[HelloRejected].matching(schema, raw, alloc)
    }
    if rendered.is_none() {
        rendered = Renders[PlanEvent].matching(schema, raw, alloc)
    }
    return rendered
} base_payload

/// `<type>(<n> bytes)`, what a value of a type the link does not hold renders as.
fn opaque(type: Str, size: usize, alloc: mem::Alloc) -> text::String {
    var text = text::String.of(type, alloc)
    mut text.push('(')
    mut text.write(Dyn[Render].view(size), budget: 24)
    mut text.append(" bytes)")
    return text
} opaque

test values_decode_by_their_type_and_types_follow_their_names for decode_value {
    let alloc = testing::world().alloc
    let defaults = LinkConfig.default_of()
    var rendered = text::String.empty(alloc)
    mut rendered.write(Dyn[Render].view(defaults), budget: 4_096)
    let Decoded.Bytes(bytes: bytes, schema: _) = decode_value("link::LinkConfig", text: rendered.as_str(), json: false, alloc) else {
        expect false
        return
    }
    let back = render_value("link::LinkConfig", raw: Untrusted.of(bytes.view()), alloc)
    expect back.as_str() == rendered.as_str()
    let rejected = match decode_value("link::LinkConfig", text: "LinkConfig(pending_ms: 3)", json: false, alloc) {
        Decoded.Invalid(_) => true
        else => false
    }
    let unknown = match decode_value("app::Feeds", text: "Feeds()", json: false, alloc) {
        Decoded.Unknown => true
        else => false
    }
    expect rejected and unknown
    let clock = type_named_by("ClockConfig(source: Rtc)", alloc)
    let feeds = type_named_by("Feeds(batch: 1)", alloc)
    let nameless = type_named_by("(1)", alloc)
    let named_clock = match clock {
        Some(path) => path.as_str() == "clock::ClockConfig"
        None => false
    }
    expect named_clock
    expect feeds.is_none() and nameless.is_none()
    var count: usize = 0
    var start: usize = 0
    let held = HELD_TYPES.as_bytes()
    for at in 0..<held.len() {
        if held[at] != b'\n' {
            continue
        }
        var reached = Reached(any: false)
        let Some(path) = HELD_TYPES.slice_bytes(start, end: at) else {
            expect false
            return
        }
        if on_type(path, work: mut reached) and reached.any {
            count += 1
        }
        start = at + 1
    }
    expect count == 38
} values_decode_by_their_type_and_types_follow_their_names

/// Notes that a dispatch reached a type.
struct Reached {
    any: bool
} Reached

impl Reached: TypeWork

fn Reached.work[T: Encode and Render](mut self, typed: Typed[T]) {
    self.any = true
} Reached.work
