//! Rights of plans: whether a principal's grants cover each step of its plans, and the `auth.denied` failure naming the right a step needs.

/// Whether the holding's grants let its plans write the node at `path` of the branch `branch` at the UTC time `now_utc`: a `Machine` grant; below `/data`, a `Tree` grant of that branch or of every branch with `write` whose prefix holds it; a specification `/sys/instances/<m>`, an `Instance` grant with `spawn` covering `m`; a configuration record `/sys/config/<m>`, one with `update` covering `m`.
pub fn Holding.writes(self, path: Str, branch: Str, now_utc: i64) -> bool {
    for held in self.grants {
        if not held.live(now_utc) {
            continue
        }
        let covered = match held.grant.object {
            os::Object.Machine => true
            os::Object.Tree(prefix: prefix, branch: granted) => held.grant.rights.contains(os::Right.Write) and (granted.as_str() == branch or granted.as_str() == "*") and path_below(path, prefix: "/data") and path_below(path, prefix: prefix.text.as_str())
            os::Object.Instance(prefix: prefix) => match instance_named(path, dir: "/sys/instances/") {
                Some(moniker) => held.grant.rights.contains(os::Right.Spawn) and os::is_under(moniker, prefix)
                None => match instance_named(path, dir: "/sys/config/") {
                    Some(configured) => held.grant.rights.contains(os::Right.Update) and os::is_under(configured, prefix)
                    None => false
                }
            }
            else => false
        }
        if covered {
            return true
        }
    }
    return false
} Holding.writes

/// Whether the holding's grants let its holder's Views write the node at `path` of `main` at the UTC time `now_utc`: a `Machine` grant, or a `Tree` grant of `main` with `write` or `admin` whose prefix holds it.
pub fn Holding.view_writes(self, path: Str, now_utc: i64) -> bool {
    for held in self.grants {
        if not held.live(now_utc) {
            continue
        }
        let covered = match held.grant.object {
            os::Object.Machine => true
            os::Object.Tree(prefix: prefix, branch: branch) => (held.grant.rights.contains(os::Right.Write) or held.grant.rights.contains(os::Right.Admin)) and (branch.as_str() == "main" or branch.as_str() == "*") and path_below(path, prefix: prefix.text.as_str())
            else => false
        }
        if covered {
            return true
        }
    }
    return false
} Holding.view_writes

/// Whether the holding's grants give `right` over the instance `moniker` at the UTC time `now_utc`: a `Machine` grant, or an `Instance` grant with `right` whose prefix covers it.
pub fn Holding.controls(self, moniker: ident::Moniker, right: os::Right, now_utc: i64) -> bool {
    for held in self.grants {
        if not held.live(now_utc) {
            continue
        }
        let covered = match held.grant.object {
            os::Object.Machine => true
            os::Object.Instance(prefix: prefix) => held.grant.rights.contains(right) and os::is_under(moniker, prefix)
            else => false
        }
        if covered {
            return true
        }
    }
    return false
} Holding.controls

/// Whether the holding's grants let its plans call the operation `operation` of the instance `moniker` at the UTC time `now_utc`: a `Machine` grant, or a `Port` grant covering the instance and the operation.
pub fn Holding.calls(self, moniker: ident::Moniker, operation: Str, now_utc: i64) -> bool {
    for held in self.grants {
        if not held.live(now_utc) {
            continue
        }
        let covered = match held.grant.object {
            os::Object.Machine => true
            os::Object.Port(prefix: prefix, operations: operations) => os::is_under(moniker, prefix) and (operations.len() == 0 or names_operation(operations, operation))
            else => false
        }
        if covered {
            return true
        }
    }
    return false
} Holding.calls

/// Whether the holding's principal is the owner or holds a `Machine` grant at the UTC time `now_utc`.
pub fn Holding.governs(self, now_utc: i64) -> bool {
    if self.principal.text.as_str() == "owner" {
        return true
    }
    for held in self.grants {
        if not held.live(now_utc) {
            continue
        }
        match held.grant.object {
            os::Object.Machine => return true
            else => {
            }
        }
    }
    return false
} Holding.governs

/// Whether `operations` holds the operation named `operation`.
fn names_operation(operations: mem::Set[text::String], operation: Str) -> bool {
    for name in operations {
        if name.as_str() == operation {
            return true
        }
    }
    return false
} names_operation

/// The instance whose node directly below `dir` the path `path` is.
fn instance_named(path: Str, dir: Str) -> Option[ident::Moniker] {
    if not path.starts_with(dir) {
        return None
    }
    let Some(rest) = path.slice_bytes(dir.byte_len(), end: path.byte_len()) else {
        return None
    }
    if rest.find("/").is_some() {
        return None
    }
    return moniker_of(rest)
} instance_named

/// The failure of a step needing `right` on `subject`, which no grant of the plan's principal confers.
pub fn denied(subject: Str, right: Str, alloc: mem::Alloc) -> Failure {
    return Failure.of("auth.denied", subject, alloc).expecting(right, found: "no grant conferring it", alloc)
} denied

/// The right a write of the node at `path` needs.
pub fn write_right(path: Str) -> text::Fixed[16] {
    if path.starts_with("/sys/instances/") {
        return text::Fixed[16].of("instance.spawn")
    }
    if path.starts_with("/sys/config/") {
        return text::Fixed[16].of("instance.update")
    }
    if path_below(path, prefix: "/data") {
        return text::Fixed[16].of("tree.write")
    }
    return text::Fixed[16].of("machine")
} write_right

test plans_write_what_their_grants_cover for Holding.writes {
    let alloc = testing::world().alloc
    var grants = mem::List[Held].empty(alloc)
    var data_rights = mem::Set[os::Right].empty(alloc)
    discard mut data_rights.insert(os::Right.Write)
    mut grants.push(Held(number: 4, grant: os::Grant(holder: ident::Principal(text: text::Fixed[64].of("agent.ops")), object: os::Object.Tree(prefix: ident::Path(text: text::String.of("/data/agent.ops", alloc)), branch: text::String.of("main", alloc)), rights: take data_rights, caveats: os::Caveats.none(), parent: Some(1), granted_by: ident::CommitId(number: 3))))
    var app_rights = mem::Set[os::Right].empty(alloc)
    discard mut app_rights.insert(os::Right.Update)
    discard mut app_rights.insert(os::Right.Lifecycle)
    mut grants.push(Held(number: 5, grant: os::Grant(holder: ident::Principal(text: text::Fixed[64].of("agent.ops")), object: os::Object.Instance(prefix: ident::Moniker(text: text::Fixed[59].of("app"))), rights: take app_rights, caveats: os::Caveats.none(), parent: Some(1), granted_by: ident::CommitId(number: 3))))
    let holding = Holding(principal: ident::Principal(text: text::Fixed[64].of("agent.ops")), grants: take grants, keyed: true)
    expect holding.writes("/data/agent.ops/notes", branch: "main", now_utc: 0) and not holding.writes("/data/other", branch: "main", now_utc: 0) and not holding.writes("/data/agent.ops/notes", branch: "feature", now_utc: 0)
    expect holding.writes("/sys/config/app.feeds", branch: "main", now_utc: 0) and not holding.writes("/sys/instances/app.feeds", branch: "main", now_utc: 0)
    expect not holding.writes("/sys/policy", branch: "main", now_utc: 0) and not holding.writes("/sys/config/link", branch: "main", now_utc: 0)
    expect holding.controls(ident::Moniker(text: text::Fixed[59].of("app.feeds")), right: os::Right.Lifecycle, now_utc: 0)
    expect not holding.controls(ident::Moniker(text: text::Fixed[59].of("store")), right: os::Right.Lifecycle, now_utc: 0)
    expect not holding.governs(now_utc: 0) and write_right("/sys/instances/app").as_str() == "instance.spawn"
} plans_write_what_their_grants_cover
