//! Charges: what the work of a session's requests runs on, a domain on the session's account drawing through its cell, the budgets its principal's sessions consume, and the failures of that work.

/// What opens the account of a session: the core's accounts, the session's number and principal, and the share and the budget of the grant it opened under.
struct Charge {
    accounts: os::Accounts
    session: u64
    principal: ident::Principal
    share: os::Share
    budget: os::SessionBudget
} Charge

/// What opens the account of the session numbered `session` through `accounts`: its principal's `Session` grant's share and budget, else the default share and `LinkConfig.budget`.
fn Linker.charge_of(self, session: u64, accounts: os::Accounts) -> Charge {
    let principal = self.principal_of_session(session)
    let share = match self.holdings.position(fn(each: Holding) => each.principal == principal) {
        Some(at) => self.holdings[at].share()
        None => os::Share.default_of()
    }
    return Charge(accounts: accounts, session: session, principal: take principal, share: share, budget: self.budget_of(session))
} Linker.charge_of

/// Opens the account of the session `charge` names when it is not open; `budget.memory-pressure` when the core opens none, and `budget.exhausted` once its principal's sessions spent the CPU time or the energy of their budget.
fn open_account(take charge: Charge, alloc: mem::Alloc) -> Result[os::SessionAccount, Failure] fails task::Cancelled uses wait {
    let Charge(accounts: accounts, session: session, principal: principal, share: share, budget: budget) = charge
    let Some(opened) = try await accounts.open(session, take principal, share, memory_bytes: budget.memory_bytes, alloc) else {
        return Err(Failure.of("budget.memory-pressure", subject: session_text(session).as_str(), alloc))
    }
    return match exhausted(budget, consumed: opened.consumed, alloc) {
        Some(failure) => Err(take failure)
        None => Ok(opened.account)
    }
} open_account

/// `budget.exhausted` naming the first of `budget`'s CPU time and energy that `consumed` spent, `None` while neither is.
fn exhausted(budget: os::SessionBudget, consumed: os::Consumed, alloc: mem::Alloc) -> Option[Failure] {
    let cpu = match budget.cpu_ms {
        Some(ms) => consumed.cpu_ns >= ms.saturating_mul(1_000_000)
        None => false
    }
    if cpu {
        return Some(Failure.of("budget.exhausted", subject: "cpu_ms", alloc))
    }
    let energy = match budget.energy_mj {
        Some(mj) => consumed.energy_mj >= mj
        None => false
    }
    if energy {
        return Some(Failure.of("budget.exhausted", subject: "energy_mj", alloc))
    }
    return None
} exhausted

/// The header of a session's work on `account`: the running work's, charged to the session's account.
fn work_header(account: os::SessionAccount) -> sys::Header {
    return os::Header.current().charged_to(account.number).carried()
} work_header

/// What the work of a session's request takes away: its principal, origin labels and request key, and the block it answers in.
struct Owned {
    principal: ident::Principal
    origins: mem::List[ident::OriginLabel]
    key: text::String
    block: Block
} Owned

/// The failure of the work of `verb` that trapped with `kind`: `budget.exhausted` naming `memory_bytes` when its session's cell ran out, else the trap's code.
fn trapped(kind: sys::TrapKind, verb: Str, alloc: mem::Alloc) -> Failure {
    let code = match kind {
        sys::TrapKind.Exhausted => return Failure.of("budget.exhausted", subject: "memory_bytes", alloc)
        sys::TrapKind.Bounds => "trap.bounds"
        sys::TrapKind.Overflow => "trap.overflow"
        sys::TrapKind.DivisionByZero => "trap.division-by-zero"
        sys::TrapKind.Shift => "trap.shift"
        sys::TrapKind.Conversion => "trap.conversion"
        sys::TrapKind.StaleHandle => "trap.stale-handle"
        sys::TrapKind.Predicate => "trap.predicate"
        sys::TrapKind.Requires => "trap.requires"
        sys::TrapKind.Ensures => "trap.ensures"
        sys::TrapKind.Expect => "trap.expect"
        sys::TrapKind.Todo => "trap.todo"
        sys::TrapKind.StackOverflow => "trap.stack-overflow"
        sys::TrapKind.DuplicateAccess => "trap.duplicate-access"
        sys::TrapKind.Poisoned => "trap.poisoned"
        sys::TrapKind.Exception => "trap.exception"
        sys::TrapKind.Abandoned => "trap.abandoned"
    }
    return Failure.of(code, subject: verb, alloc)
} trapped

/// `block` holding `failure`, as the `failed` block of its request.
fn Block.failing(take self, take failure: Failure, alloc: mem::Alloc) -> Block {
    var block = self
    block.verdict = Verdict.Failed
    mut block.records.push(failure.record(alloc))
    return block
} Block.failing

/// A request fails once its principal's sessions spent the CPU time of their budget, then their energy; an unlimited budget is never spent.
test budgets_are_exhausted_once_consumed for exhausted {
    let world = testing::world()
    let unlimited = os::SessionBudget(output_units: None, response_units: 4_000, query_records: 100_000, query_bytes: 67_108_864, previews: 4, cpu_ms: None, memory_bytes: None, egress_bytes: None, energy_mj: None, infer_tokens: None, infer_micros: None)
    var limited = unlimited
    limited.cpu_ms = Some(5)
    limited.energy_mj = Some(10)
    let short = os::Consumed(cpu_ns: 4_999_999, energy_mj: 9)
    let cpu_spent = os::Consumed(cpu_ns: 5_000_000, energy_mj: 10)
    let energy_spent = os::Consumed(cpu_ns: 0, energy_mj: 10)
    let never = exhausted(unlimited, consumed: cpu_spent, alloc: world.alloc)
    let not_yet = exhausted(limited, consumed: short, alloc: world.alloc)
    let cpu = exhausted(limited, consumed: cpu_spent, alloc: world.alloc)
    let energy = exhausted(limited, consumed: energy_spent, alloc: world.alloc)
    expect never.is_none() and not_yet.is_none()
    expect match cpu {
        Some(failure) => failure.code.as_str() == "budget.exhausted" and failure.subject.as_str() == "cpu_ms"
        None => false
    }
    expect match energy {
        Some(failure) => failure.subject.as_str() == "energy_mj"
        None => false
    }
} budgets_are_exhausted_once_consumed
