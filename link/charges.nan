//! Charges: what the work of a session's requests runs on, a domain on the session's account drawing through its cell, and the failures of that work.

/// What opens the account of a session: the core's accounts, the session's number and principal, and the share and the memory of the grant it opened under.
struct Charge {
    accounts: os::Accounts
    session: u64
    principal: ident::Principal
    share: os::Share
    memory_bytes: Option[u64]
} Charge

/// What opens the account of the session numbered `session` through `accounts`: its principal's `Session` grant's share and memory, else the default share and `LinkConfig.budget`'s memory.
fn Linker.charge_of(self, session: u64, accounts: os::Accounts) -> Charge {
    let principal = self.principal_of_session(session)
    let share = match self.holdings.position(fn(each: Holding) => each.principal == principal) {
        Some(at) => self.holdings[at].share()
        None => os::Share.default_of()
    }
    return Charge(accounts: accounts, session: session, principal: take principal, share: share, memory_bytes: self.budget_of(session).memory_bytes)
} Linker.charge_of

/// Opens the account of the session `charge` names when it is not open; `budget.memory-pressure` when the core opens none.
fn open_account(take charge: Charge, alloc: mem::Alloc) -> Result[os::SessionAccount, Failure] fails task::Cancelled uses wait {
    let Charge(accounts: accounts, session: session, principal: principal, share: share, memory_bytes: memory_bytes) = charge
    return match try await accounts.open(session, take principal, share, memory_bytes, alloc) {
        Some(account) => Ok(account)
        None => Err(Failure.of("budget.memory-pressure", subject: session_text(session).as_str(), alloc))
    }
} open_account

/// The failure of the work of `verb` that trapped with `kind`: `budget.exhausted` naming `memory_bytes` when its session's cell ran out, else the trap's code.
fn trapped(kind: sys::TrapKind, verb: Str, alloc: mem::Alloc) -> Failure {
    let code = match kind {
        sys::TrapKind.Exhausted => return Failure.of("budget.exhausted", subject: "memory_bytes", alloc)
        sys::TrapKind.Bounds => "trap.bounds"
        sys::TrapKind.Overflow => "trap.overflow"
        sys::TrapKind.DivisionByZero => "trap.division-by-zero"
        sys::TrapKind.Shift => "trap.shift"
        sys::TrapKind.Conversion => "trap.conversion"
        sys::TrapKind.StaleHandle => "trap.stale-handle"
        sys::TrapKind.Predicate => "trap.predicate"
        sys::TrapKind.Requires => "trap.requires"
        sys::TrapKind.Ensures => "trap.ensures"
        sys::TrapKind.Expect => "trap.expect"
        sys::TrapKind.Todo => "trap.todo"
        sys::TrapKind.StackOverflow => "trap.stack-overflow"
        sys::TrapKind.DuplicateAccess => "trap.duplicate-access"
        sys::TrapKind.Poisoned => "trap.poisoned"
        sys::TrapKind.Exception => "trap.exception"
        sys::TrapKind.Abandoned => "trap.abandoned"
    }
    return Failure.of(code, subject: verb, alloc)
} trapped

/// `block` holding `failure`, as the `failed` block of its request.
fn Block.failing(take self, take failure: Failure, alloc: mem::Alloc) -> Block {
    var block = self
    block.verdict = Verdict.Failed
    mut block.records.push(failure.record(alloc))
    return block
} Block.failing
