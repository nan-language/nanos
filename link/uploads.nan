//! Uploads: `put` streaming the bytes of its data lines, gathered into pieces, into a draft of the store, then committing the blob at its path.

/// The bytes of data lines an upload gathers into each piece its keyed task appends, and the pieces it holds before the task appends them; one more fails it.
const UPLOAD_PIECE_BYTES: usize = 16_384

const UPLOAD_PIECES: usize = 16

/// An upload under way: the `put` it serves, where its pieces go, the bytes gathered into the next piece, and the bytes its data lines are still to bring.
pub open struct Upload derives Send {
    number: u64
    pieces: task::Sender[mem::Bytes]
    gathered: mem::Bytes
    left: u64
} Upload

/// What a `put` uploads: its path, its size and the blob id, in a short or full form, its bytes must have, the principal and session it acts for, the origin labels of its commit, `upload.<session>` among the session's taint, and its request key.
pub closed struct Putting derives Encode {
    pub path: ident::Path
    pub size: u64
    pub blake3: text::String
    pub principal: ident::Principal
    pub session: ident::SessionId
    pub origins: mem::List[ident::OriginLabel]
    pub key: text::String
} Putting

/// `put <path> <size> <blake3>`: a keyed task appends the data lines that follow to a draft of the store, closes it into the blob of id `<blake3>` and commits the blob at the path, `request.hash-mismatch` when the bytes have another id.
fn Linker.put(
    mut self,
    take request: Request,
    number: u64,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    let Some(at) = self.running.position(fn(each: Running) => each.number == number) else {
        return
    }
    let putting = match self.putting(request, at, now_utc: now_utc_ns(env.wall, clock: env.clock), alloc) {
        Ok(made) => made
        Err(failure) => {
            let block = self.running[at].failed(take failure, alloc)
            mut self.respond(at, take block, mut env, mut cx)
            return
        }
    }
    let task::Channel(sender: pieces, receiver: arriving) = task::Channel[mem::Bytes].bounded(UPLOAD_PIECES, alloc)
    mut env.uploads.push(Upload(number: number, pieces: take pieces, gathered: mem::Bytes.empty(alloc), left: putting.size))
    let block = self.running[at].block(Verdict.Ok, alloc)
    let failed = self.running[at].block(Verdict.Failed, alloc)
    let slot = self.running[at].slot
    let tree = env.tree
    let charge = self.charge_of(self.running[at].session, accounts: env.accounts)
    mut cx.spawn(key: ANSWERING + slot, run: fn[take putting, take arriving, take block, take charge, take failed](out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 16_384 {
        let answered = match try await open_account(take charge, alloc) {
            Ok(account) => match try await sys::Domain.run(fn[take putting, take arriving, take block]() -> Option[Block] fails task::Cancelled uses wait limits stack 32_768 {
                var given = Some(Uploading(putting: take putting, pieces: take arriving, block: take block))
                return try await sys::run_headed(work_header(account), body: fn[mut given]() -> Option[Block] fails task::Cancelled uses wait {
                    let Some(Uploading(putting: upload, pieces: incoming, block: reply)) = mut given.extract() else {
                        return None
                    }
                    return Some(try await uploaded(putting: take upload, pieces: take incoming, block: take reply, tree, alloc: account.alloc))
                })
            }, exec: account.exec, alloc: account.alloc) {
                Ok(Some(given)) => given
                Ok(None) => take failed.failing(trapped(sys::TrapKind.Abandoned, verb: "put", alloc), alloc)
                Err(trap) => take failed.failing(trapped(trap.kind(), verb: "put", alloc), alloc)
            }
            Err(failure) => take failed.failing(take failure, alloc)
        }
        discard attempt await out.responded(number, block: take answered)
    })
} Linker.put

/// What the work of a `put` takes away: what it uploads, the pieces arriving, and the block it answers in.
struct Uploading {
    putting: Putting
    pieces: task::Receiver[mem::Bytes]
    block: Block
} Uploading

/// What the `put` running at `at` uploads, once its operands are a path, a size of at most `MOST_PUT_BYTES` and a blob id, and the session's principal may write the path.
fn Linker.putting(
    self,
    request: Request,
    at: usize,
    now_utc: i64,
    alloc: mem::Alloc,
    ) -> Result[Putting, Failure] {
    let session = self.running[at].session
    let Some(session_at) = self.sessions.position(fn(each: Session) => each.number == session) else {
        return Err(Failure.of("auth.denied", subject: "put", alloc).expecting("a session", found: "none", alloc))
    }
    if request.operands.len() != 3 {
        return Err(Failure.of("request.invalid-operand", subject: "put", alloc).expecting("put <path> <size> <blake3>", found: self.running[at].operand.as_str(), alloc))
    }
    let Some(path) = path_of(request.operands[0].as_str(), alloc) else {
        return Err(Failure.of("request.invalid-operand", subject: request.operands[0].as_str(), alloc).expecting("a path", found: request.operands[0].as_str(), alloc))
    }
    let Some(size) = number_of(request.operands[1].as_str()) else {
        return Err(Failure.of("request.invalid-operand", subject: request.operands[1].as_str(), alloc).expecting("a size in bytes", found: request.operands[1].as_str(), alloc))
    }
    if size > MOST_PUT_BYTES {
        return Err(Failure.of("request.too-large", subject: request.operands[1].as_str(), alloc).expecting("at most 64 MiB", found: request.operands[1].as_str(), alloc))
    }
    if ident::HashText.parse(request.operands[2].as_str()).is_none() {
        return Err(Failure.of("request.invalid-operand", subject: request.operands[2].as_str(), alloc).expecting("a blob id", found: request.operands[2].as_str(), alloc))
    }
    let principal = self.sessions[session_at].principal
    let writes = match self.holdings.position(fn(each: Holding) => each.principal == principal) {
        Some(held) => self.holdings[held].writes(path.text.as_str(), branch: RUNNING_BRANCH, now_utc)
        None => false
    }
    if not writes {
        return Err(denied(path.text.as_str(), right: write_right(path.text.as_str()).as_str(), alloc))
    }
    let key = match self.key_of_request(request, session, alloc) {
        Ok(made) => made
        Err(failure) => return Err(take failure)
    }
    let acting = ident::SessionId(boot: self.boot(), number: session)
    var origins = self.taint_of(principal, alloc)
    mut origins.push(upload_label(acting))
    return Ok(Putting(path: take path, size: size, blake3: text::String.of(request.operands[2].as_str(), alloc), principal: ident::Principal(text: principal.text), session: acting, origins: take origins, key: take key))
} Linker.putting

/// `upload.<session>`, the origin label of the blobs `put` uploads in `session`.
fn upload_label(session: ident::SessionId) -> ident::OriginLabel {
    var label = text::Fixed[260].of("upload.")
    mut label.write(Dyn[Render].view(session), budget: 32)
    return ident::OriginLabel(text: label)
} upload_label

/// Gathers the bytes of a data line received on the connection numbered `connection` into the next piece of the upload of its `put`, passing on each piece they complete; an upload without room for a piece fails.
fn Linker.upload(mut self, connection: u64, take bytes: mem::Bytes, mut env: Env) {
    let Some(at) = self.running.position(fn(each: Running) => each.connection == connection and each.verb.as_str() == "put") else {
        return
    }
    let number = self.running[at].number
    let Some(upload) = env.uploads.position(fn(each: Upload) => each.number == number) else {
        return
    }
    let Some(piece) = mut env.uploads[upload].gather(bytes.view(), alloc: env.alloc) else {
        return
    }
    match env.uploads[upload].pieces.offer(take piece) {
        Some(_) => {
            discard mut env.uploads.remove(upload)
        }
        None => {
        }
    }
} Linker.upload

/// The piece `line` completes: the bytes gathered with it once they hold `UPLOAD_PIECE_BYTES` or the last the `put` expects, none before.
fn Upload.gather(mut self, line: Slice[u8], alloc: mem::Alloc) -> Option[mem::Bytes] {
    mut self.gathered.append(line)
    self.left = self.left.saturating_sub(u64.widen(line.len()))
    if self.gathered.len() < UPLOAD_PIECE_BYTES and self.left > 0 {
        return None
    }
    var piece = mem::Bytes.empty(alloc)
    mut piece.append(self.gathered.view())
    mut self.gathered.truncate(0)
    return Some(take piece)
} Upload.gather

/// Forgets the upload of the `put` numbered `number`, ending its data.
fn Env.forget_upload(mut self, number: u64) {
    mut self.uploads.retain(fn(each: Upload) => each.number != number)
} Env.forget_upload

/// Uploads the bytes `pieces` brings into a draft through a View acting for the principal of `putting`, closes it into a blob, which must have the id `putting` names, and commits it at its path, giving `block` with its `blob` record, or failed with the store's code.
fn uploaded(
    take putting: Putting,
    take pieces: task::Receiver[mem::Bytes],
    take block: Block,
    tree: store::service::View,
    alloc: mem::Alloc,
    ) -> Block fails task::Cancelled uses wait {
    var answered = block
    let failure = match try await stored(putting, take pieces, tree, alloc) {
        Ok(stored_blob) => {
            var record = Record.of("blob", alloc)
            mut record.subject(Dyn[Render].view(putting.path))
            mut record.field("size_bytes", value: Dyn[Render].view(putting.size))
            mut record.hash("blake3", value: stored_blob.id)
            mut record.field("commit", value: Dyn[Render].view(stored_blob.commit))
            mut record.field("origin", value: Dyn[Render].view(upload_label(putting.session)))
            mut answered.records.push(take record)
            return answered
        }
        Err(failed) => failed
    }
    answered.verdict = Verdict.Failed
    mut answered.records.push(failure.record(alloc))
    return answered
} uploaded

/// A blob stored: its id and the commit writing it at its path.
pub closed struct StoredBlob derives Copy {
    pub id: ident::HashValue
    pub commit: ident::CommitId
} StoredBlob

/// The blob `putting` uploads from `pieces`, `request.hash-mismatch` when its id is not the one `putting` names.
fn stored(putting: Putting, take pieces: task::Receiver[mem::Bytes], tree: store::service::View, alloc: mem::Alloc) -> Result[StoredBlob, Failure] fails task::Cancelled uses wait {
    let subject = putting.path.text.as_str()
    let acting = match first attempt await tree.acting(ident::Principal(text: putting.principal.text), session: putting.session, origins: labels_of(putting.origins, alloc), alloc) {
        Ok(view) => view
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => return Err(Failure.of(failed.code().as_str(), subject, alloc))
    }
    let draft = match first attempt await acting.draft(alloc) {
        Ok(number) => number
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => return Err(Failure.of(failed.code().as_str(), subject, alloc))
    }
    var receiver = pieces
    var received: u64 = 0
    while received < putting.size {
        let Some(piece) = try await mut receiver.receive() else {
            return Err(Failure.of("request.too-large", subject, alloc).expecting("the data lines of the put", found: "an upload without room for them", alloc))
        }
        received = received.saturating_add(u64.widen(piece.len()))
        if received > putting.size {
            return Err(Failure.of("request.hash-mismatch", subject, alloc).expecting("the bytes the size names", found: "more bytes", alloc))
        }
        match first attempt await acting.draft_append(draft, bytes: take piece, alloc) {
            Ok(_) => {
            }
            Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
            Err(failed) => return Err(Failure.of(failed.code().as_str(), subject, alloc))
        }
    }
    let named = ident::HashText.parse(putting.blake3.as_str())
    let expected = match named {
        Some(ident::HashText.Full(hash)) => Some(hash)
        else => None
    }
    let closed = match first attempt await acting.draft_close(draft, expected, alloc) {
        Ok(found) => found
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(store::service::ViewError.Failed(store::service::Failure.HashMismatch)) => return Err(Failure.of("request.hash-mismatch", subject, alloc))
        Err(failed) => return Err(Failure.of(failed.code().as_str(), subject, alloc))
    }
    let identified = match named {
        Some(text) => text.names(closed.id)
        None => false
    }
    if not identified {
        return Err(Failure.of("request.hash-mismatch", subject, alloc).expecting(putting.blake3.as_str(), found: closed.id.short_form().as_str(), alloc))
    }
    var writes = mem::List[store::Write].empty(alloc)
    mut writes.push(store::Write.Put(path: ident::Path(text: text::String.of(subject, alloc)), value: store::Value.Blob(closed.id)))
    let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: Some(text::String.of(putting.key.as_str(), alloc)), plan: None, intent: None)
    return match first attempt await acting.commit(take transaction, typed: true, alloc) {
        Ok(done) => Ok(StoredBlob(id: closed.id, commit: done.number))
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => Err(Failure.of(failed.code().as_str(), subject, alloc))
    }
} stored

test uploads_pass_their_data_on_in_pieces_and_the_rest_with_the_last_line for Upload.gather {
    let alloc = testing::world().alloc
    let task::Channel(sender: pieces, receiver: _) = task::Channel[mem::Bytes].bounded(1, alloc)
    var upload = Upload(number: 1, pieces: take pieces, gathered: mem::Bytes.empty(alloc), left: u64.widen(UPLOAD_PIECE_BYTES) + 3)
    let bulk = mem::Bytes.zeroed(UPLOAD_PIECE_BYTES - 1, alloc)
    let gathering = mut upload.gather(bulk.view(), alloc)
    expect gathering.is_none()
    let Some(full) = mut upload.gather(b"ab", alloc) else {
        expect false
        return
    }
    expect full.len() == UPLOAD_PIECE_BYTES + 1
    let Some(last) = mut upload.gather(b"cd", alloc) else {
        expect false
        return
    }
    expect last.view() == b"cd" and upload.left == 0
} uploads_pass_their_data_on_in_pieces_and_the_rest_with_the_last_line
