//! Connections: the transports' streams of lines, the serial console's and each a resident agent opens through `LinkSession.open`, with the blocks waiting for each.

/// The number of the serial transport's one connection.
const SERIAL_CONNECTION: u64 = 1

/// The most connections open at once, each keeping the slot its writer's key names.
const MOST_CONNECTIONS: u64 = 64

/// A connection: its number, its transport, the slot in the runner's table of the instance that opened it, 0 on serial, the slot its writer's key names, the request being gathered from the lines sent on it, the blocks waiting for it and whether one is being written, and the challenge of its latest `hello`.
pub closed struct Connection derives Encode {
    pub number: u64
    pub transport: Transport
    pub opener: u32
    pub slot: u64
    pub gathered: Gathered
    pub output: mem::List[mem::Bytes]
    pub writing: bool
    pub challenge: Option[Challenge]
} Connection

/// The client of a port connection: the port its blocks go to.
pub open struct Client derives Send {
    connection: u64
    port: os::Port[LinkClient]
} Client

pub fn Connection.of(
    number: u64,
    transport: Transport,
    opener: u32,
    slot: u64,
    alloc: mem::Alloc,
    ) -> Connection {
    return Connection(number: number, transport: transport, opener: opener, slot: slot, gathered: Gathered.empty(alloc), output: mem::List.empty(alloc), writing: false, challenge: None)
} Connection.of

/// Opens a port connection for the calling instance, the ready record its first block.
pub fn Linker.open(mut self, take client: os::PortHandle, mut env: Env, mut cx: sys::Cx[LinkSession]) -> u64 fails Refusal {
    let Some(port) = os::Port[LinkClient].of(client) else {
        fail Refusal.InvalidClient
    }
    let opener = os::Header.current().caller
    match self.connections.position(fn(each: Connection) => each.transport == Transport.Port and each.opener == opener) {
        Some(at) => mut self.lose(self.connections[at].number, mut env, mut cx)
        None => {
        }
    }
    let Some(slot) = self.free_connection_slot() else {
        fail Refusal.SessionLimit
    }
    let number = self.next_connection
    self.next_connection += 1
    var connection = Connection.of(number, transport: Transport.Port, opener, slot, alloc: env.alloc)
    if self.facts.is_some() {
        mut connection.output.push(self.ready_block(env.alloc))
    }
    mut self.connections.push(take connection)
    mut env.clients.push(Client(connection: number, port: port))
    mut self.write(number, mut env, mut cx)
    return number
} Linker.open

/// Gathers `line` into the request of the calling instance's connection, running the request once it ends.
pub fn Linker.send(mut self, take line: text::String, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    let alloc = env.alloc
    let opener = os::Header.current().caller
    let Some(at) = self.connections.position(fn(each: Connection) => each.transport == Transport.Port and each.opener == opener) else {
        return
    }
    let number = self.connections[at].number
    let gathering = mut self.connections[at].gathered.add(Untrusted.of(line.as_bytes()), alloc)
    match gathering {
        Gathering.Ended(text) => mut self.request(number, text: text.as_str(), mut env, mut cx)
        Gathering.Continued => {
        }
        Gathering.Data(bytes) => mut self.upload(connection: number, take bytes, mut env)
        Gathering.Failed(code: code) => mut self.answer(number, session: 0, block: failed_block(id: "-", verb: "-", operand: "", failure: Failure.of(code.as_str(), subject: "-", alloc), alloc), mut env, mut cx)
    }
} Linker.send

fn Linker.received(mut self, take received: Received, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    let alloc = env.alloc
    match received {
        Received.Request(text) => mut self.request(SERIAL_CONNECTION, text: text.as_str(), mut env, mut cx)
        Received.Refused(code: code) => mut self.answer(SERIAL_CONNECTION, session: 0, block: failed_block(id: "-", verb: "-", operand: "", failure: Failure.of(code.as_str(), subject: "-", alloc), alloc), mut env, mut cx)
        Received.Data(bytes) => mut self.upload(connection: SERIAL_CONNECTION, take bytes, mut env)
        Received.Console(text) => {
            mut self.lines.push(take text)
            mut self.hand(mut env, mut cx)
        }
    }
} Linker.received

/// Hands `console` the console line `line`, without its leading `console `.
fn hand_over(attendant: os::Port[console::Console], line: Str, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let Some(rest) = line.slice_bytes(8, end: line.byte_len()) else {
        return
    }
    var call = sys::Encoded.empty(alloc)
    sys::Wire[console::Console].line(mut call, text: text::String.of(rest, alloc))
    match attempt await attendant.post(take call) {
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} hand_over

/// Has a keyed task hand the next console line waiting to `console`, once none is being handed over.
fn Linker.hand(mut self, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    if self.consoling or self.lines.len() == 0 {
        return
    }
    let text = mut self.lines.remove(0)
    self.consoling = true
    let attendant = env.attendant
    let alloc = env.alloc
    mut cx.spawn(key: CONSOLING, run: fn[take text](out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 16_384 {
        try await hand_over(attendant, line: text.as_str(), alloc)
        discard attempt await out.handed()
    })
} Linker.hand

fn Linker.handed(mut self, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    self.consoling = false
    mut self.hand(mut env, mut cx)
} Linker.handed

fn Linker.written(
    mut self,
    take connection: u64,
    take lost: bool,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let Some(at) = self.connections.position(fn(each: Connection) => each.number == connection) else {
        return
    }
    self.connections[at].writing = false
    if lost {
        mut self.lose(connection, mut env, mut cx)
        return
    }
    mut self.write(connection, mut env, mut cx)
} Linker.written

/// Has a keyed task write the next block waiting for the connection numbered `number`, once the ready record went out and no write is under way: to the console UART on serial, as a `LinkClient.block` to its client on the port transport.
fn Linker.write(mut self, number: u64, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    let Some(at) = self.connections.position(fn(each: Connection) => each.number == number) else {
        return
    }
    if self.connections[at].writing or self.facts.is_none() or self.connections[at].output.len() == 0 {
        return
    }
    let alloc = env.alloc
    let key = WRITING + self.connections[at].slot
    if self.connections[at].transport == Transport.Serial {
        let data = mut self.connections[at].output.remove(0)
        self.connections[at].writing = true
        let console = env.console
        mut cx.spawn(key: key, run: fn[take data](out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 16_384 {
            try await write_serial(console, take data, alloc)
            discard attempt await out.written(connection: number, lost: false)
        })
        return
    }
    let Some(client) = env.clients.position(fn(each: Client) => each.connection == number) else {
        return
    }
    let port = env.clients[client].port
    let data = mut self.connections[at].output.remove(0)
    self.connections[at].writing = true
    mut cx.spawn(key: key, run: fn[take data](out: sys::Outbox[LinkSession]) fails task::Cancelled uses wait limits stack 16_384 {
        let taken = try await post_block(port, take data, alloc)
        discard attempt await out.written(connection: number, lost: not taken)
    })
} Linker.write

/// Posts the block `data` to `port`, giving whether the client took it.
fn post_block(port: os::Port[LinkClient], take data: mem::Bytes, alloc: mem::Alloc) -> bool fails task::Cancelled uses wait {
    let Ok(text) = attempt text::String.try_from_utf8(data.view(), alloc) else {
        return true
    }
    var call = sys::Encoded.empty(alloc)
    sys::Wire[LinkClient].block(mut call, take text)
    return match attempt await port.post(take call) {
        Ok(_) => true
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        else => false
    }
} post_block

/// Loses the port connection numbered `number`: its client goes and its sessions detach.
fn Linker.lose(mut self, number: u64, mut env: Env, mut cx: sys::Cx[LinkSession]) {
    let Some(at) = self.connections.position(fn(each: Connection) => each.number == number) else {
        return
    }
    let lost = mut self.connections.remove(at)
    mut cx.cancel(key: WRITING + lost.slot)
    match env.clients.position(fn(each: Client) => each.connection == number) {
        Some(client) => {
            discard mut env.clients.remove(client)
        }
        None => {
        }
    }
    for index in 0..<self.sessions.len() {
        if self.sessions[index].connection == Some(number) {
            mut self.detach(index, mut env, mut cx)
        }
    }
} Linker.lose

/// The lowest writer slot no connection holds, the serial connection holding slot 0, `None` when `MOST_CONNECTIONS` are open.
fn Linker.free_connection_slot(self) -> Option[u64] {
    for slot in 1..<MOST_CONNECTIONS {
        if self.connections.position(fn(each: Connection) => each.slot == slot).is_none() {
            return Some(slot)
        }
    }
    return None
} Linker.free_connection_slot

/// Delivers `block` of the session numbered `session`, 0 for none, cut by `cut`: a `taint` record ends it when the untrusted content it shows grows its principal's taint, its units count against its principal's output budget, and it goes to the connection numbered `connection` while that is open, else to the session's connection, waiting in the session while it is detached.
fn Linker.deliver(
    mut self,
    connection: u64,
    session: u64,
    take block: Block,
    cut: Cut,
    mut env: Env,
    mut cx: sys::Cx[LinkSession],
    ) {
    let alloc = env.alloc
    var sent = block
    let labels = sent.labels(cut, alloc)
    match mut self.taint(session, origins: labels, alloc) {
        Some(record) => mut sent.records.push(take record)
        None => {
        }
    }
    let bytes = sent.text(cut, alloc)
    mut self.spend(session, units: u64.widen((bytes.len() + 3) / 4), alloc)
    var target = connection
    if self.connections.position(fn(each: Connection) => each.number == connection).is_none() {
        let Some(at) = self.sessions.position(fn(each: Session) => each.number == session) else {
            return
        }
        let Some(current) = self.sessions[at].connection else {
            mut self.sessions[at].queued.push(take bytes)
            return
        }
        target = current
    }
    let Some(at) = self.connections.position(fn(each: Connection) => each.number == target) else {
        return
    }
    mut self.connections[at].output.push(take bytes)
    mut self.write(target, mut env, mut cx)
} Linker.deliver
