//! TPM 2.0 commands, each in the byte form a TPM takes.

/// The tags of commands and responses without and with an authorization area.
const TAG_NO_SESSIONS: u16 = 0x8001

const TAG_SESSIONS: u16 = 0x8002

const CC_CREATE_PRIMARY: u32 = 0x0000_0131

const CC_NV_READ: u32 = 0x0000_014E

const CC_CREATE: u32 = 0x0000_0153

const CC_LOAD: u32 = 0x0000_0157

const CC_UNSEAL: u32 = 0x0000_015E

const CC_FLUSH_CONTEXT: u32 = 0x0000_0165

const CC_START_AUTH_SESSION: u32 = 0x0000_0176

const CC_GET_RANDOM: u32 = 0x0000_017B

const CC_PCR_READ: u32 = 0x0000_017E

const CC_POLICY_PCR: u32 = 0x0000_017F

const CC_POLICY_GET_DIGEST: u32 = 0x0000_0189

/// The owner hierarchy, the password session and the handle naming nothing.
const OWNER: u32 = 0x4000_0001

const PASSWORD: u32 = 0x4000_0009

const NULL_HANDLE: u32 = 0x4000_0007

/// The algorithms NaN OS names.
const SHA256: u16 = 0x000B

const AES: u16 = 0x0006

const KEYEDHASH: u16 = 0x0008

const NULL_ALGORITHM: u16 = 0x0010

const ECC: u16 = 0x0023

const CFB: u16 = 0x0043

const NIST_P256: u16 = 0x0003

/// The session types: a policy session, and a trial one, which only computes its policy digest.
const POLICY_SESSION: u8 = 0x01

const TRIAL_SESSION: u8 = 0x03

/// The attributes of the storage key: fixedTPM, fixedParent, sensitiveDataOrigin, userWithAuth, noDA, restricted and decrypt.
const STORAGE_ATTRIBUTES: u32 = 0x0003_0472

/// The attributes of a sealed data object: fixedTPM, fixedParent and noDA, and userWithAuth when no policy binds it.
const SEALED_ATTRIBUTES: u32 = 0x0000_0412

const USER_WITH_AUTH: u32 = 0x0000_0040

/// The PCRs of a TPM of the PC Client profile.
pub const PCR_COUNT: u8 = 24

/// The most bytes a sealed data object holds.
pub const MOST_SEALED: usize = 128

/// The most bytes one NV read moves.
pub const MOST_NV: u16 = 512

/// A command as it is written, its size set once its last field is.
struct Command {
    bytes: mem::Bytes
} Command

fn Command.of(tag: u16, code: u32, alloc: mem::Alloc) -> Command {
    var command = Command(bytes: mem::Bytes.empty(alloc))
    mut command.put_u16(tag)
    mut command.put_u32(0)
    mut command.put_u32(code)
    return command
} Command.of

fn Command.put_u8(mut self, value: u8) {
    mut self.bytes.push(value)
} Command.put_u8

fn Command.put_u16(mut self, value: u16) {
    mut self.bytes.push(u8.truncate(value >> 8))
    mut self.bytes.push(u8.truncate(value))
} Command.put_u16

fn Command.put_u32(mut self, value: u32) {
    mut self.put_u16(u16.truncate(value >> 16))
    mut self.put_u16(u16.truncate(value))
} Command.put_u32

/// A sized buffer: its length, then its bytes.
fn Command.sized(mut self, data: Slice[u8])
    requires data.len() <= 0xFFFF
{
    mut self.put_u16(u16.fit(data.len()))
    mut self.bytes.append(data)
} Command.sized

/// The authorization area of one session: `session`, with no nonce, continued, and no HMAC or password.
fn Command.authorize(mut self, session: u32) {
    mut self.put_u32(9)
    mut self.put_u32(session)
    mut self.put_u16(0)
    mut self.put_u8(0x01)
    mut self.put_u16(0)
} Command.authorize

/// The PCR selection naming the SHA-256 PCRs whose bits `pcrs` sets.
fn Command.selection(mut self, pcrs: u32) {
    mut self.put_u32(1)
    mut self.put_u16(SHA256)
    mut self.put_u8(3)
    mut self.put_u8(u8.truncate(pcrs))
    mut self.put_u8(u8.truncate(pcrs >> 8))
    mut self.put_u8(u8.truncate(pcrs >> 16))
} Command.selection

fn Command.done(take self) -> mem::Bytes {
    let Command(bytes: written) = self
    var bytes = written
    let size = u32.fit(bytes.len())
    mut bytes.view_mut().write_u32_be(2, value: size)
    return bytes
} Command.done

/// TPM2_GetRandom of `count` bytes.
pub fn get_random(count: u16, alloc: mem::Alloc) -> mem::Bytes {
    var command = Command.of(TAG_NO_SESSIONS, code: CC_GET_RANDOM, alloc)
    mut command.put_u16(count)
    return take command.done()
} get_random

/// TPM2_PCR_Read of the SHA-256 value of PCR `pcr`.
pub fn pcr_read(pcr: u8, alloc: mem::Alloc) -> mem::Bytes
    requires pcr < PCR_COUNT
{
    var command = Command.of(TAG_NO_SESSIONS, code: CC_PCR_READ, alloc)
    let selected: u32 = 1
    mut command.selection(selected << u32.widen(pcr))
    return take command.done()
} pcr_read

/// TPM2_NV_Read of `count` bytes at `offset` of NV index `index`, authorized by its empty authorization value.
pub fn nv_read(index: u32, offset: u16, count: u16, alloc: mem::Alloc) -> mem::Bytes {
    var command = Command.of(TAG_SESSIONS, code: CC_NV_READ, alloc)
    mut command.put_u32(index)
    mut command.put_u32(index)
    mut command.authorize(PASSWORD)
    mut command.put_u16(count)
    mut command.put_u16(offset)
    return take command.done()
} nv_read

/// TPM2_CreatePrimary of the owner hierarchy's storage key: ECC on NIST P-256, restricted to decrypting, its children's seeds protected by AES-128 in CFB mode. The TPM derives the same key from this template each time.
pub fn create_primary(alloc: mem::Alloc) -> mem::Bytes {
    var command = Command.of(TAG_SESSIONS, code: CC_CREATE_PRIMARY, alloc)
    mut command.put_u32(OWNER)
    mut command.authorize(PASSWORD)
    mut command.put_u16(4)
    mut command.put_u16(0)
    mut command.put_u16(0)
    var public = Command(bytes: mem::Bytes.empty(alloc))
    mut public.put_u16(ECC)
    mut public.put_u16(SHA256)
    mut public.put_u32(STORAGE_ATTRIBUTES)
    mut public.put_u16(0)
    mut public.put_u16(AES)
    mut public.put_u16(128)
    mut public.put_u16(CFB)
    mut public.put_u16(NULL_ALGORITHM)
    mut public.put_u16(NIST_P256)
    mut public.put_u16(NULL_ALGORITHM)
    mut public.put_u16(0)
    mut public.put_u16(0)
    mut command.sized(public.bytes.view())
    mut command.put_u16(0)
    mut command.put_u32(0)
    return take command.done()
} create_primary

/// TPM2_Create, under the storage key `parent`, of a sealed data object holding `secret`, authorized by the policy digest `policy` when given, else by an empty authorization value.
pub fn create_sealed(parent: u32, secret: Slice[u8], policy: Option[Array[u8, 32]], alloc: mem::Alloc) -> mem::Bytes
    requires secret.len() <= MOST_SEALED
{
    var command = Command.of(TAG_SESSIONS, code: CC_CREATE, alloc)
    mut command.put_u32(parent)
    mut command.authorize(PASSWORD)
    mut command.put_u16(u16.fit(secret.len() + 4))
    mut command.put_u16(0)
    mut command.sized(secret)
    var public = Command(bytes: mem::Bytes.empty(alloc))
    mut public.put_u16(KEYEDHASH)
    mut public.put_u16(SHA256)
    match policy {
        Some(digest) => {
            mut public.put_u32(SEALED_ATTRIBUTES)
            mut public.sized(digest.view())
        }
        None => {
            mut public.put_u32(SEALED_ATTRIBUTES | USER_WITH_AUTH)
            mut public.put_u16(0)
        }
    }
    mut public.put_u16(NULL_ALGORITHM)
    mut public.put_u16(0)
    mut command.sized(public.bytes.view())
    mut command.put_u16(0)
    mut command.put_u32(0)
    return take command.done()
} create_sealed

/// TPM2_Load, under the storage key `parent`, of the object whose sized public and private areas TPM2_Create returned.
pub fn load(parent: u32, object: Object, alloc: mem::Alloc) -> mem::Bytes {
    var command = Command.of(TAG_SESSIONS, code: CC_LOAD, alloc)
    mut command.put_u32(parent)
    mut command.authorize(PASSWORD)
    mut command.bytes.append(object.private.view())
    mut command.bytes.append(object.public.view())
    return take command.done()
} load

/// TPM2_StartAuthSession of an unbound and unsalted session hashing with SHA-256: a policy session, or a trial one when `trial`.
pub fn start_session(trial: bool, alloc: mem::Alloc) -> mem::Bytes {
    var command = Command.of(TAG_NO_SESSIONS, code: CC_START_AUTH_SESSION, alloc)
    mut command.put_u32(NULL_HANDLE)
    mut command.put_u32(NULL_HANDLE)
    let nonce = Array[u8, 32].filled(0)
    mut command.sized(nonce.view())
    mut command.put_u16(0)
    let kind = match trial {
        true => TRIAL_SESSION
        false => POLICY_SESSION
    }
    mut command.put_u8(kind)
    mut command.put_u16(NULL_ALGORITHM)
    mut command.put_u16(SHA256)
    return take command.done()
} start_session

/// TPM2_PolicyPCR extending the policy of session `session` with the current values of the SHA-256 PCRs whose bits `pcrs` sets.
pub fn policy_pcr(session: u32, pcrs: u32, alloc: mem::Alloc) -> mem::Bytes {
    var command = Command.of(TAG_NO_SESSIONS, code: CC_POLICY_PCR, alloc)
    mut command.put_u32(session)
    mut command.put_u16(0)
    mut command.selection(pcrs)
    return take command.done()
} policy_pcr

/// TPM2_PolicyGetDigest of session `session`.
pub fn policy_get_digest(session: u32, alloc: mem::Alloc) -> mem::Bytes {
    var command = Command.of(TAG_NO_SESSIONS, code: CC_POLICY_GET_DIGEST, alloc)
    mut command.put_u32(session)
    return take command.done()
} policy_get_digest

/// TPM2_Unseal of the loaded object `item`, authorized by the policy session `session`, or by its empty authorization value without one.
pub fn unseal(item: u32, session: Option[u32], alloc: mem::Alloc) -> mem::Bytes {
    var command = Command.of(TAG_SESSIONS, code: CC_UNSEAL, alloc)
    mut command.put_u32(item)
    mut command.authorize(session.value_or(PASSWORD))
    return take command.done()
} unseal

/// TPM2_FlushContext of the object or session `handle`.
pub fn flush(handle: u32, alloc: mem::Alloc) -> mem::Bytes {
    var command = Command.of(TAG_NO_SESSIONS, code: CC_FLUSH_CONTEXT, alloc)
    mut command.put_u32(handle)
    return take command.done()
} flush

test commands_carry_their_size_and_code for get_random {
    let alloc = testing::world().alloc
    let random = get_random(32, alloc)
    expect random.view() == b"\x80\x01\x00\x00\x00\x0c\x00\x00\x01\x7b\x00\x20"
    let read = pcr_read(8, alloc)
    expect read.view() == b"\x80\x01\x00\x00\x00\x14\x00\x00\x01\x7e\x00\x00\x00\x01\x00\x0b\x03\x00\x01\x00"
    let nv = nv_read(0x0180_4E00, offset: 0, count: 8, alloc)
    expect nv.view() == b"\x80\x02\x00\x00\x00\x23\x00\x00\x01\x4e\x01\x80\x4e\x00\x01\x80\x4e\x00\x00\x00\x00\x09\x40\x00\x00\x09\x00\x00\x01\x00\x00\x00\x08\x00\x00"
} commands_carry_their_size_and_code
