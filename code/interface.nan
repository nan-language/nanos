//! The running kernel's interface file, which the core gives through a capability, and the packages of the kernel's final closure it lists.

/// A capability reading the running kernel's interface file.
pub open struct Interface {
} Interface

impl Interface: sys::Kind[Kernel, u8]

/// The running kernel's interface file and the packages it lists, both empty when the kernel has none.
struct Kernel {
    file: mem::Shared[mem::Bytes]
    packages: mem::Shared[mem::List[Listed]]
} Kernel

/// A package an interface file lists: its name and the hash of its code root.
struct Listed {
    name: mem::Bytes
    code_root: ident::HashValue
} Listed

/// The root entry of the interface capabilities the core mints, revoked when it closes.
pub open linear struct MintedInterface derives Send {
    minter: sys::Minter[Interface, Kernel, u8]
} MintedInterface

/// The interface capabilities of the kernel of interface hash `support`, reading `file` when it is that kernel's interface file and none otherwise.
pub validator fn MintedInterface.of(file: Untrusted[Slice[u8]], support: ident::HashValue, alloc: mem::Alloc) -> MintedInterface {
    var held = mem::Bytes.empty(alloc)
    var packages = mem::List[Listed].empty(alloc)
    if ident::HashValue.of_untrusted(file) == support {
        match read_part(file.inspect(), key: PACKAGES_PART, body: fn(part: Slice[u8]) => listed_in(part, alloc)) {
            Some(listed) => {
                mut held.append(file.inspect())
                packages = listed
            }
            None => {
            }
        }
    }
    return MintedInterface(minter: sys::Minter[Interface, Kernel, u8].of(Kernel(file: mem::Shared.of(take held, alloc), packages: mem::Shared.of(take packages, alloc)), alloc))
} MintedInterface.of

pub fn MintedInterface.mint(self) -> Interface {
    return self.minter.mint(0)
} MintedInterface.mint

/// Revokes every capability of this root entry.
pub fn MintedInterface.close(take self) {
    let MintedInterface(minter: minter) = self
    take minter.close()
} MintedInterface.close

/// A copy of the interface file drawn through `alloc`, empty when the kernel has none or the capability is revoked.
pub fn Interface.file(self, alloc: mem::Alloc) -> mem::Bytes {
    var copy = mem::Bytes.empty(alloc)
    match sys::reach(self, body: fn(kernel: Kernel, record: u8) => kernel.file.share()) {
        Some(shared) => mut copy.append(shared.contents().view())
        None => {
        }
    }
    return copy
} Interface.file

/// Whether the interface file lists the package `name` with the code root `code_root`.
pub fn Interface.lists(self, name: Str, code_root: ident::HashValue) -> bool {
    let Some(packages) = sys::reach(self, body: fn(kernel: Kernel, record: u8) => kernel.packages.share()) else {
        return false
    }
    for listed in packages.contents() {
        if listed.code_root == code_root and listed.name.view() == name.as_bytes() {
            return true
        }
    }
    return false
} Interface.lists

/// The packages the packages part `part` of an interface file lists, in its order; `None` when it does not decode.
fn listed_in(part: Slice[u8], alloc: mem::Alloc) -> Option[mem::List[Listed]] {
    let Some(count) = uvar_at(part, at: 0) else {
        return None
    }
    var listed = mem::List[Listed].empty(alloc)
    var at = count.end
    for _ in 0..<count.value {
        let Some(name) = bytes_at(part, at) else {
            return None
        }
        let Some(root) = bytes_at(part, at: name.end) else {
            return None
        }
        let Some(named) = copy_of(part, span: name, alloc) else {
            return None
        }
        let Some(rooted) = part.split_at(root.start) else {
            return None
        }
        let Some(hashed) = rooted.tail.prefix(root.end - root.start) else {
            return None
        }
        let Some(code_root) = hash_of(hashed) else {
            return None
        }
        mut listed.push(Listed(name: take named, code_root: code_root))
        at = root.end
    }
    return Some(take listed)
} listed_in

test interfaces_list_the_packages_of_the_kernels_file_only for MintedInterface.of {
    let alloc = testing::world().alloc
    let root = ident::HashValue.of_content(b"root of os")
    var packages = mem::Bytes.empty(alloc)
    push_uvar(mut packages, value: 1)
    push_bytes(mut packages, bytes: b"os")
    push_bytes(mut packages, bytes: root.bytes.view())
    let file = interface_file_of(ident::HashValue.of_content(b"toolchain"), level: b"", packages: packages.view(), alloc)
    let kernels = MintedInterface.of(Untrusted.of(file.view()), support: ident::HashValue.of_content(file.view()), alloc)
    defer take kernels.close()
    let others = MintedInterface.of(Untrusted.of(file.view()), support: ident::HashValue.of_content(b"another kernel"), alloc)
    defer take others.close()
    let kernel = kernels.mint()
    let other = others.mint()
    let listed = kernel.lists("os", code_root: root)
    let read = kernel.file(alloc)
    let rerooted = kernel.lists("os", code_root: ident::HashValue.of_content(b"root of ident"))
    let renamed = kernel.lists("ident", code_root: root)
    let elsewhere = other.lists("os", code_root: root)
    let unread = other.file(alloc)
    expect listed and read.view() == file.view() and not rerooted and not renamed
    expect not elsewhere and unread.len() == 0
} interfaces_list_the_packages_of_the_kernels_file_only
