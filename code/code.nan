//! Bundle files: a closure's artefacts beside the images lowered from them, with their check certificate and signatures, and the hashes naming them.

/// A bundle's closure: the name of its root package and the code root hash of each package, in byte order.
pub closed struct CodeId derives Encode {
    pub root: text::String
    pub code_roots: mem::List[ident::HashValue]
} CodeId

/// The content of a bundle file: the name of its root package, one artefact per package of its closure, std included, in byte order of code root hash, the images lowered from them, a builder's check certificate and the bundle signatures.
pub closed struct Bundle derives Encode {
    pub root: text::String
    pub artefacts: mem::List[mem::Bytes]
    pub images: mem::List[Image]
    pub certificate: Option[Certificate]
    pub signatures: mem::List[Signed]
} Bundle

/// An image of a bundle: the codegen level it was lowered at, the toolchain that lowered it, the support-routine table it imports, and its bytes.
pub closed struct Image derives Encode {
    pub level: Level
    pub toolchain: ident::HashValue
    pub support: ident::HashValue
    pub bytes: mem::Bytes
} Image

/// A codegen level: the x86-64 microarchitecture levels 1 to 4, Armv8.0-A, and Armv8.2-A with the dot product instructions.
pub closed enum Level derives Copy, Eq, Ord, Render, Encode {
    X86v1
    X86v2
    X86v3
    X86v4
    Armv80
    Armv82
} Level

/// A bundle signature with its signer.
pub closed struct Signed derives Encode {
    pub principal: ident::Principal
    pub signature: ident::Signature
} Signed

/// A check certificate: `builder` checked with `toolchain` the closure of code hash `code`, finding no error, and lowered the images whose blob ids `images` lists; `signature` is `builder`'s.
pub closed struct Certificate derives Encode {
    pub builder: ident::Principal
    pub code: ident::HashValue
    pub toolchain: ident::HashValue
    pub images: mem::List[ident::HashValue]
    pub signature: ident::Signature
} Certificate

/// What a bundle build wrote, as a bundle without certificate or signatures, with the code hash of its closure.
pub closed struct Made {
    pub bundle: Bundle
    pub code: ident::HashValue
} Made

/// The bundle hash of the bundle: the hash of kind `bundle` of its encoding with `signatures` empty, which it holds again after.
pub fn Bundle.hash(mut self, alloc: mem::Alloc) -> ident::HashValue {
    var held = mem::List[Signed].empty(alloc)
    loop {
        let Some(signed) = mut self.signatures.pop() else {
            break
        }
        mut held.push(take signed)
    }
    var encoded = mem::Bytes.empty(alloc)
    mem::wire::Codec[Bundle].encode(self, out: mut encoded)
    loop {
        let Some(signed) = mut held.pop() else {
            break
        }
        mut self.signatures.push(take signed)
    }
    return ident::HashValue.of_object(ident::Kind.Bundle, bytes: encoded.view())
} Bundle.hash

/// The code hash of the closure: the hash of kind `code` of its encoding.
pub fn CodeId.hash(self, alloc: mem::Alloc) -> ident::HashValue {
    var encoded = mem::Bytes.empty(alloc)
    mem::wire::Codec[CodeId].encode(self, out: mut encoded)
    return ident::HashValue.of_object(ident::Kind.Code, bytes: encoded.view())
} CodeId.hash

/// The certificate by `builder`, signed with its key `key`, stating that it checked with `toolchain` the closure of code hash `code` and lowered the images of blob ids `images`.
pub fn Certificate.of(
    take builder: ident::Principal,
    code: ident::HashValue,
    toolchain: ident::HashValue,
    take images: mem::List[ident::HashValue],
    key: core::crypto::SecretKey,
    alloc: mem::Alloc,
    ) -> Certificate {
    var certificate = Certificate(builder: take builder, code: code, toolchain: toolchain, images: take images, signature: ident::Signature(bytes: Array[u8, 64].filled(0)))
    let object = certificate.object(alloc)
    certificate.signature = ident::Signature(bytes: key.sign(object.bytes.view()).bytes)
    return certificate
} Certificate.of

/// The object the certificate's signature signs: the hash of kind `certificate` of its encoding with a signature of zero bytes.
pub fn Certificate.object(self, alloc: mem::Alloc) -> ident::HashValue {
    var images = mem::List[ident::HashValue].empty(alloc)
    for image in self.images {
        mut images.push(image)
    }
    let unsigned = Certificate(builder: ident::Principal(text: self.builder.text), code: self.code, toolchain: self.toolchain, images: take images, signature: ident::Signature(bytes: Array[u8, 64].filled(0)))
    var encoded = mem::Bytes.empty(alloc)
    mem::wire::Codec[Certificate].encode(unsigned, out: mut encoded)
    return ident::HashValue.of_object(ident::Kind.Certificate, bytes: encoded.view())
} Certificate.object
