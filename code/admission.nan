//! Admission records: what admitting a bundle found, at `/sys/code/<hash>/admission`.

pub closed struct Admission derives Render, Encode {
    pub root: text::String
    pub packages: mem::List[Package]
    pub components: mem::List[Component]
    pub program: Option[Program]
    /// The closure summary's entries.
    pub authority: mem::List[text::String]
    pub escapes: mem::List[Escape]
    pub contributions: mem::List[Contribution]
    pub provenance: os::Provenance
    /// Whether placement conditions 1 and 2 hold.
    pub shared: bool
    pub check: CodeCheck
    pub image: Lowered
    pub admitted: ident::CommitId
} Admission

pub closed struct Package derives Render, Encode {
    pub name: text::String
    pub code_root: ident::HashValue
    pub authors: mem::List[ident::Principal]
    /// The principals of its verified review signatures.
    pub reviewers: mem::List[ident::Principal]
} Package

pub closed struct Component derives Render, Encode {
    /// The canonical path of its state type.
    pub state: text::String
    pub schema: ident::HashValue
    /// The protocol hash of its messages.
    pub protocol: ident::HashValue
    pub operations: mem::List[Operation]
    pub env: mem::List[Field]
    /// The canonical path of its configuration type.
    pub config: Option[text::String]
} Component

pub closed struct Operation derives Render, Encode {
    pub name: text::String
    /// NaN's digest line.
    pub digest: text::String
    /// Its declared bound.
    pub reversibility: text::String
} Operation

pub closed struct Field derives Render, Encode {
    pub name: text::String
    /// The canonical path of the capability type.
    pub kind: text::String
    /// For a port.
    pub protocol: Option[ident::HashValue]
    pub optional: bool
} Field

/// The schema hashes of a typed `main`'s input and result, and the reversibility class its digest declares.
pub closed struct Program derives Render, Encode {
    pub input: Option[ident::HashValue]
    pub output: Option[ident::HashValue]
    pub class: sys::Reversibility
} Program

pub closed struct Escape derives Render, Encode {
    pub item: text::String
    /// Its ledger kind.
    pub kind: text::String
    pub sealers: mem::List[ident::Principal]
} Escape

pub closed struct Contribution derives Render, Encode {
    /// The registry's canonical path.
    pub table: text::String
    /// The rendered key.
    pub key: text::String
    pub replaces: bool
} Contribution

pub closed enum CodeCheck derives Render, Encode {
    Verified(toolchain: ident::HashValue)
    Certified(builder: ident::Principal, toolchain: ident::HashValue)
} CodeCheck

/// The payload of `code.admitted`.
pub closed struct Admitted derives Render, Encode {
    pub code: ident::HashValue
    pub root: text::String
    pub provenance: os::Provenance
    pub shared: bool
    pub check: CodeCheck
} Admitted

pub closed struct Lowered derives Render, Encode {
    pub level: Level
    pub toolchain: ident::HashValue
    pub support: ident::HashValue
    /// The image's blob id.
    pub image: ident::HashValue
    pub code_bytes: u64
} Lowered

/// The operation `schema` describes, with no digest line, its bound as a `limits` clause writes it.
pub fn Operation.of_schema(schema: sys::OperationSchema, alloc: mem::Alloc) -> Operation {
    var bound = text::String.empty(alloc)
    match schema.class {
        sys::Reversibility.Traceless => mut bound.append("traceless")
        sys::Reversibility.Recorded => mut bound.append("recorded")
        sys::Reversibility.Restorable => mut bound.append("restorable")
        sys::Reversibility.Irreversible(emit: emit, actuate: actuate, erase: erase, spend: spend) => {
            mut bound.append("irreversible(")
            add_kind(mut bound, name: "emit", present: emit)
            add_kind(mut bound, name: "actuate", present: actuate)
            add_kind(mut bound, name: "erase", present: erase)
            add_kind(mut bound, name: "spend", present: spend)
            mut bound.push(')')
        }
    }
    return Operation(name: text::String.of(schema.name.as_str(), alloc), digest: text::String.empty(alloc), reversibility: take bound)
} Operation.of_schema

/// Appends the kind `name` of an irreversible bound to `bound` when `present`, after a `, ` unless it is the first.
fn add_kind(mut bound: text::String, name: Str, present: bool) {
    if not present {
        return
    }
    if not bound.as_str().ends_with("(") {
        mut bound.append(", ")
    }
    mut bound.append(name)
} add_kind

test operations_write_their_bound_as_a_limits_clause for Operation.of_schema {
    let alloc = testing::world().alloc
    let spending = Operation.of_schema(sys::OperationSchema(name: text::String.of("pay", alloc), class: sys::Reversibility.Irreversible(emit: true, actuate: false, erase: false, spend: true), parameters: mem::List.empty(alloc), result: None, failure: None), alloc)
    let reading = Operation.of_schema(sys::OperationSchema(name: text::String.of("get", alloc), class: sys::Reversibility.Traceless, parameters: mem::List.empty(alloc), result: None, failure: None), alloc)
    expect spending.name.as_str() == "pay" and spending.reversibility.as_str() == "irreversible(emit, spend)" and spending.digest.as_str() == ""
    expect reading.reversibility.as_str() == "traceless"
} operations_write_their_bound_as_a_limits_clause
