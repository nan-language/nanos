//! Admission records: what admitting a bundle found, at `/sys/code/<hash>/admission`.

pub closed struct Admission derives Render, Encode {
    pub root: text::String
    pub packages: mem::List[Package]
    pub components: mem::List[Component]
    pub program: Option[Program]
    /// The closure summary's entries.
    pub authority: mem::List[text::String]
    pub escapes: mem::List[Escape]
    pub contributions: mem::List[Contribution]
    pub provenance: os::Provenance
    /// Whether placement conditions 1 and 2 hold.
    pub shared: bool
    pub check: CodeCheck
    pub image: Lowered
    pub admitted: ident::CommitId
} Admission

pub closed struct Package derives Render, Encode {
    pub name: text::String
    pub code_root: ident::HashValue
    pub authors: mem::List[ident::Principal]
    /// The principals of its verified review signatures.
    pub reviewers: mem::List[ident::Principal]
} Package

pub closed struct Component derives Render, Encode {
    /// The canonical path of its state type.
    pub state: text::String
    pub schema: ident::HashValue
    /// The protocol hash of its messages.
    pub protocol: ident::HashValue
    pub operations: mem::List[Operation]
    pub env: mem::List[Field]
    /// The canonical path of its configuration type.
    pub config: Option[text::String]
} Component

pub closed struct Operation derives Render, Encode {
    pub name: text::String
    /// NaN's digest line.
    pub digest: text::String
    /// Its declared bound.
    pub reversibility: text::String
} Operation

pub closed struct Field derives Render, Encode {
    pub name: text::String
    /// The canonical path of the capability type.
    pub kind: text::String
    /// For a port.
    pub protocol: Option[ident::HashValue]
    pub optional: bool
} Field

/// The schema hashes of a typed `main`'s input and result, and the reversibility class its digest declares.
pub closed struct Program derives Render, Encode {
    pub input: Option[ident::HashValue]
    pub output: Option[ident::HashValue]
    pub class: sys::Reversibility
} Program

pub closed struct Escape derives Render, Encode {
    pub item: text::String
    /// Its ledger kind.
    pub kind: text::String
    pub sealers: mem::List[ident::Principal]
} Escape

pub closed struct Contribution derives Render, Encode {
    /// The registry's canonical path.
    pub table: text::String
    /// The rendered key.
    pub key: text::String
    pub replaces: bool
} Contribution

pub closed enum CodeCheck derives Render, Encode {
    Verified(toolchain: ident::HashValue)
    Certified(builder: ident::Principal, toolchain: ident::HashValue)
} CodeCheck

/// The payload of `code.admitted`.
pub closed struct Admitted derives Render, Encode {
    pub code: ident::HashValue
    pub root: text::String
    pub provenance: os::Provenance
    pub shared: bool
    pub check: CodeCheck
} Admitted

pub closed struct Lowered derives Render, Encode {
    pub level: Level
    pub toolchain: ident::HashValue
    pub support: ident::HashValue
    /// The image's blob id.
    pub image: ident::HashValue
    pub code_bytes: u64
} Lowered
