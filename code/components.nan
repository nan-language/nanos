//! Component bundles: the components a root lists as its entries, described from the API snapshots, schema trees and protocols its bundle's artefacts record.

/// The key of a code root's interface, the API snapshot of each module.
const INTERFACE_PART: u64 = 3

/// The key of a code root's protocols, absent when it declares none.
const PROTOCOLS_PART: u64 = 11

/// An item an API snapshot describes: its canonical path, the lines of its text, and the digest line it gives for a nanos target, if any.
pub closed struct Snapshot {
    pub path: text::String
    pub text: mem::List[text::String]
    pub digest: Option[text::String]
} Snapshot

/// A protocol a code root declares: its canonical path, its protocol hash, and the names of its operations.
pub closed struct Protocol {
    pub path: text::String
    pub hash: ident::HashValue
    pub operations: mem::List[text::String]
} Protocol

/// Where an item lies among a bundle's artefacts: its artefact's position and its own there.
struct Found derives Copy {
    artefact: usize
    item: usize
} Found

/// The components the entries of `root` name, each the state of a component of its root module, described from `artefacts`, the bundle's, `root` among them; `None` when an entry names no such component or its description is missing.
pub fn components_of(root: Artefact, artefacts: mem::List[Artefact], alloc: mem::Alloc) -> Option[mem::List[Component]] {
    var components = mem::List[Component].empty(alloc)
    for entry in root.entries {
        let Some(described) = component_of(root, entry: entry.as_str(), artefacts, alloc) else {
            return None
        }
        mut components.push(take described)
    }
    return Some(take components)
} components_of

/// The component whose state is the entry `entry` of `root`'s root module.
fn component_of(root: Artefact, entry: Str, artefacts: mem::List[Artefact], alloc: mem::Alloc) -> Option[Component] {
    let home = root.name.as_str()
    let state = within(entry, home, alloc)
    var implementing = text::String.of(home, alloc)
    mut implementing.append("::impl[")
    mut implementing.append(state.as_str())
    mut implementing.append(": sys::Component]")
    let Some(implemented) = snapshot_named(artefacts, path: implementing.as_str()) else {
        return None
    }
    let Some(line) = artefacts[implemented.artefact].snapshots[implemented.item].text.get(0) else {
        return None
    }
    let Some(arguments) = bracketed(line.as_str(), after: "sys::Component[", alloc) else {
        return None
    }
    let Some(comma) = top_level_comma(arguments.as_str()) else {
        return None
    }
    let env_path = within(excerpt(arguments.as_str(), start: 0, end: comma, alloc).as_str(), home, alloc)
    let protocol_path = within(excerpt(arguments.as_str(), start: comma + 2, end: arguments.byte_len(), alloc).as_str(), home, alloc)
    let Some(tree) = root.trees.position(fn(each: Tree) => each.path.as_str() == state.as_str()) else {
        return None
    }
    let Some(served) = protocol_named(artefacts, path: protocol_path.as_str()) else {
        return None
    }
    let Some(declared) = snapshot_named(artefacts, path: protocol_path.as_str()) else {
        return None
    }
    let protocol = artefacts[served.artefact].protocols[served.item]
    var operations = mem::List[Operation].empty(alloc)
    for name in protocol.operations {
        var handler = text::String.of(state.as_str(), alloc)
        mut handler.push('.')
        mut handler.append(name.as_str())
        var digest = text::String.empty(alloc)
        match snapshot_named(artefacts, path: handler.as_str()) {
            Some(handling) => {
                match artefacts[handling.artefact].snapshots[handling.item].digest {
                    Some(written) => mut digest.append(written.as_str())
                    None => {
                    }
                }
            }
            None => {
            }
        }
        mut operations.push(Operation(name: text::String.of(name.as_str(), alloc), digest: take digest, reversibility: bound_of(artefacts[declared.artefact].snapshots[declared.item], operation: name.as_str(), alloc)))
    }
    let Some(env) = snapshot_named(artefacts, path: env_path.as_str()) else {
        return None
    }
    let Some(fields) = fields_of(artefacts[env.artefact].snapshots[env.item], home, artefacts, alloc) else {
        return None
    }
    let earlier = root.earlier_of(state.as_str(), alloc)
    let flexible = root.flexible(state.as_str())
    return Some(Component(state: take state, schema: root.trees[tree].schema, protocol: protocol.hash, operations: take operations, env: take fields, config: None, earlier: take earlier, flexible: flexible))
} component_of

/// The Env fields the struct `env` declares, each with the capability type it holds: a port with the hash of the protocol it reaches, and an `Option` as optional; `None` for a line that declares no field.
fn fields_of(env: Snapshot, home: Str, artefacts: mem::List[Artefact], alloc: mem::Alloc) -> Option[mem::List[Field]] {
    var fields = mem::List[Field].empty(alloc)
    let count = env.text.len()
    if count < 2 {
        return None
    }
    for at in 1..<(count - 1) {
        let line = env.text[at].as_str()
        var start: usize = 0
        while start < line.byte_len() and line.as_bytes()[start] == b' ' {
            start += 1
        }
        if excerpt(line, start, end: line.byte_len(), alloc).starts_with("pub ") {
            start += 4
        }
        let declared = excerpt(line, start, end: line.byte_len(), alloc)
        let Some(colon) = declared.as_str().find(": ") else {
            return None
        }
        let name = excerpt(declared.as_str(), start: 0, end: colon, alloc)
        var typed = excerpt(declared.as_str(), start: colon + 2, end: declared.byte_len(), alloc)
        let optional = typed.as_str().starts_with("Option[")
        if optional {
            let Some(inner) = bracketed(typed.as_str(), after: "Option[", alloc) else {
                return None
            }
            typed = inner
        }
        var protocol: Option[ident::HashValue] = None
        var kind = within(typed.as_str(), home, alloc)
        match bracketed(typed.as_str(), after: "os::Port[", alloc) {
            Some(reached) => {
                let Some(served) = protocol_named(artefacts, path: within(reached.as_str(), home, alloc).as_str()) else {
                    return None
                }
                protocol = Some(artefacts[served.artefact].protocols[served.item].hash)
                kind = text::String.of("os::Port", alloc)
            }
            None => {
            }
        }
        mut fields.push(Field(name: take name, kind: take kind, protocol: protocol, optional: optional))
    }
    return Some(take fields)
} fields_of

/// The bound the protocol `declared` states for its operation `operation`, as its `limits` clause writes it.
fn bound_of(declared: Snapshot, operation: Str, alloc: mem::Alloc) -> text::String {
    var lead = text::String.of("pub fn ", alloc)
    mut lead.append(operation)
    mut lead.push('(')
    for line in declared.text {
        let written = line.as_str()
        let Some(at) = written.find(lead.as_str()) else {
            continue
        }
        let Some(bound) = written.find(" limits ") else {
            continue
        }
        if bound > at {
            return excerpt(written, start: bound + 8, end: written.byte_len(), alloc)
        }
    }
    return text::String.empty(alloc)
} bound_of

/// A copy of the bytes `start` to `end` of `whole`, empty when they do not bound characters of it.
fn excerpt(whole: Str, start: usize, end: usize, alloc: mem::Alloc) -> text::String {
    let Some(sliced) = whole.slice_bytes(start, end) else {
        return text::String.empty(alloc)
    }
    return text::String.of(sliced, alloc)
} excerpt

/// The canonical path the name `name` written in the root module of the package `home` has.
fn within(name: Str, home: Str, alloc: mem::Alloc) -> text::String {
    if name.find("::").is_some() {
        return text::String.of(name, alloc)
    }
    var path = text::String.of(home, alloc)
    mut path.append("::")
    mut path.append(name)
    return path
} within

/// What `text` holds between the end of `after` and the bracket closing it, `None` when `text` does not hold `after`.
fn bracketed(text: Str, after: Str, alloc: mem::Alloc) -> Option[text::String] {
    let Some(at) = text.find(after) else {
        return None
    }
    let start = at + after.byte_len()
    let bytes = text.as_bytes()
    var depth: usize = 1
    for index in start..<bytes.len() {
        if bytes[index] == b'[' {
            depth += 1
        } else if bytes[index] == b']' {
            depth -= 1
            if depth == 0 {
                return Some(excerpt(text, start, end: index, alloc))
            }
        }
    }
    return None
} bracketed

/// The offset of the first `, ` of `text` outside brackets.
fn top_level_comma(text: Str) -> Option[usize] {
    let bytes = text.as_bytes()
    var depth: usize = 0
    for index in 0..<bytes.len() {
        if bytes[index] == b'[' {
            depth += 1
        } else if bytes[index] == b']' and depth > 0 {
            depth -= 1
        } else if bytes[index] == b',' and depth == 0 and index + 1 < bytes.len() and bytes[index + 1] == b' ' {
            return Some(index)
        }
    }
    return None
} top_level_comma

/// Where the item of canonical path `path` an API snapshot of `artefacts` describes lies.
fn snapshot_named(artefacts: mem::List[Artefact], path: Str) -> Option[Found] {
    for at in 0..<artefacts.len() {
        match artefacts[at].snapshots.position(fn(each: Snapshot) => each.path.as_str() == path) {
            Some(item) => return Some(Found(artefact: at, item: item))
            None => {
            }
        }
    }
    return None
} snapshot_named

/// Where the protocol of canonical path `path` a code root of `artefacts` declares lies.
fn protocol_named(artefacts: mem::List[Artefact], path: Str) -> Option[Found] {
    for at in 0..<artefacts.len() {
        match artefacts[at].protocols.position(fn(each: Protocol) => each.path.as_str() == path) {
            Some(item) => return Some(Found(artefact: at, item: item))
            None => {
            }
        }
    }
    return None
} protocol_named

/// The items the API snapshots of the interface filling `span` of `bytes` describe, a list of pairs of a module's name and its snapshot's text.
fn snapshots_in(bytes: Slice[u8], span: Span, alloc: mem::Alloc) -> mem::List[Snapshot] fails core::DecodeError {
    let Some(count) = uvar_at(bytes, at: span.start) else {
        fail core::DecodeError.Invalid
    }
    var snapshots = mem::List[Snapshot].empty(alloc)
    var at = count.end
    for _ in 0..<count.value {
        let module = try form_at(bytes, at)
        let written = try form_at(bytes, at: module.end)
        if written.end > span.end {
            fail core::DecodeError.Invalid
        }
        let text = try text_in(bytes, span: Span(start: module.end, end: written.end), alloc)
        try read_snapshot(text.as_str(), mut snapshots, alloc)
        at = written.end
    }
    if at != span.end {
        fail core::DecodeError.Invalid
    }
    return snapshots
} snapshots_in

/// Adds to `snapshots` the items the API snapshot `written` describes: each `item` line starts one, its `text` lines give its text, and a `digest` line for a nanos target its digest.
fn read_snapshot(written: Str, mut snapshots: mem::List[Snapshot], alloc: mem::Alloc) fails core::DecodeError {
    let bytes = written.as_bytes()
    var start: usize = 0
    while start < bytes.len() {
        var end = start
        while end < bytes.len() and bytes[end] != b'\n' {
            end += 1
        }
        let line = excerpt(written, start, end, alloc)
        start = end + 1
        let shown = line.as_str()
        if shown.starts_with("item ") {
            let Some(path) = try unquoted(shown, from: 5, alloc) else {
                fail core::DecodeError.Invalid
            }
            mut snapshots.push(Snapshot(path: take path, text: mem::List.empty(alloc), digest: None))
            continue
        }
        let last = snapshots.len()
        if last == 0 {
            continue
        }
        if shown.starts_with("text ") {
            let Some(texted) = try unquoted(shown, from: 5, alloc) else {
                fail core::DecodeError.Invalid
            }
            mut snapshots.at_mut(last - 1).text.push(take texted)
        } else if shown.starts_with("digest ") {
            let Some(space) = excerpt(shown, start: 7, end: shown.byte_len(), alloc).find(" ") else {
                fail core::DecodeError.Invalid
            }
            if excerpt(shown, start: 7, end: 7 + space, alloc).ends_with("-nanos") {
                let Some(digest) = try unquoted(shown, from: 8 + space, alloc) else {
                    fail core::DecodeError.Invalid
                }
                snapshots[last - 1].digest = Some(take digest)
            }
        }
    }
} read_snapshot

/// The text the quoted string at offset `from` of `line` writes, its `\"`, `\\`, `\n` and `\t` escapes undone; `None` for no quoted string there.
fn unquoted(line: Str, from: usize, alloc: mem::Alloc) -> Option[text::String] fails core::DecodeError {
    let bytes = line.as_bytes()
    if from + 1 >= bytes.len() or bytes[from] != b'"' {
        return None
    }
    var out = mem::Bytes.empty(alloc)
    var at = from + 1
    while at < bytes.len() {
        let byte = bytes[at]
        if byte == b'"' {
            return Some(try text_of(out.view(), alloc))
        }
        if byte == b'\\' and at + 1 < bytes.len() {
            at += 1
            mut out.push(match bytes[at] {
                b'n' => b'\n'
                b't' => b'\t'
                else => bytes[at]
            })
        } else {
            mut out.push(byte)
        }
        at += 1
    }
    return None
} unquoted

/// The protocols the part filling `span` of `bytes` lists: each its canonical path, its protocol hash, and its operations, a list of pairs of a name and an operation hash.
fn protocols_in(bytes: Slice[u8], span: Span, alloc: mem::Alloc) -> mem::List[Protocol] fails core::DecodeError {
    let Some(count) = uvar_at(bytes, at: span.start) else {
        fail core::DecodeError.Invalid
    }
    var protocols = mem::List[Protocol].empty(alloc)
    var at = count.end
    for _ in 0..<count.value {
        let path = try form_at(bytes, at)
        let hashed = try form_at(bytes, at: path.end)
        let Some(listed) = uvar_at(bytes, at: hashed.end) else {
            fail core::DecodeError.Invalid
        }
        var operations = mem::List[text::String].empty(alloc)
        var next = listed.end
        for _ in 0..<listed.value {
            let name = try form_at(bytes, at: next)
            let operation = try form_at(bytes, at: name.end)
            mut operations.push(try text_in(bytes, span: Span(start: next, end: name.end), alloc))
            next = operation.end
        }
        if next > span.end {
            fail core::DecodeError.Invalid
        }
        mut protocols.push(Protocol(path: try text_in(bytes, span: Span(start: at, end: path.end), alloc), hash: try hash_in(bytes, span: Span(start: path.end, end: hashed.end)), operations: take operations))
        at = next
    }
    if at != span.end {
        fail core::DecodeError.Invalid
    }
    return protocols
} protocols_in

/// The API snapshot of the module of a counter component: its state, handlers, protocol, Env and implementation.
const COUNTER_SNAPSHOT: Str = "nan api 1\nitem \"counter::Counter\"\ntext \"pub closed struct Counter derives Encode {\"\ntext \"    pub count: u64\"\ntext \"} Counter\"\nitem \"counter::Counter.add\"\ndigest x86_64-nanos \"effects recorded | authority sys::Log | may-trap yes | terminates\"\nitem \"counter::Counter.total\"\ndigest aarch64-nanos \"effects none\"\ndigest x86_64-nanos \"effects none | authority none | may-trap no | terminates\"\nitem \"counter::Counting\"\ntext \"pub protocol Counting {\"\ntext \"    pub fn add(amount: u32) -> u64 limits recorded\"\ntext \"    pub fn total() -> u64 limits traceless\"\ntext \"} Counting\"\ndoc add \"ael7geassq6oxs53ic6njsdnoly324qeh4puic73kjc7xiowbgvgyv5\" \"Adds.\"\nitem \"counter::Env\"\ntext \"pub closed struct Env {\"\ntext \"    pub log: sys::Log\"\ntext \"    pub peer: Option[os::Port[Counting]]\"\ntext \"} Env\"\nitem \"counter::impl[counter::Counter: sys::Component]\"\ntext \"impl Counter: sys::Component[Env, Counting]\"\n"

test component_entries_are_described_from_the_snapshots_trees_and_protocols_of_their_root for components_of {
    let alloc = testing::world().alloc
    let counting = ident::HashValue.of_content(b"Counting")
    var modules = uvar_of(1, alloc)
    push_bytes(mut modules, bytes: b"counter")
    push_bytes(mut modules, bytes: COUNTER_SNAPSHOT.as_bytes())
    var declared = uvar_of(1, alloc)
    push_bytes(mut declared, bytes: b"counter::Counting")
    push_bytes(mut declared, bytes: counting.bytes.view())
    push_uvar(mut declared, value: 2)
    push_bytes(mut declared, bytes: b"add")
    push_bytes(mut declared, bytes: ident::HashValue.of_content(b"add").bytes.view())
    push_bytes(mut declared, bytes: b"total")
    push_bytes(mut declared, bytes: ident::HashValue.of_content(b"total").bytes.view())
    let Ok(snapshots) = attempt snapshots_in(modules.view(), span: Span(start: 0, end: modules.len()), alloc) else {
        expect false
        return
    }
    let Ok(protocols) = attempt protocols_in(declared.view(), span: Span(start: 0, end: declared.len()), alloc) else {
        expect false
        return
    }
    var entries = mem::List[text::String].empty(alloc)
    mut entries.push(text::String.of("Counter", alloc))
    var trees = mem::List[Tree].empty(alloc)
    mut trees.push(Tree(path: text::String.of("counter::Counter", alloc), schema: ident::HashValue.of_content(b"tree of Counter"), encoding: mem::Bytes.empty(alloc)))
    var artefacts = mem::List[Artefact].empty(alloc)
    mut artefacts.push(Artefact(code_root: ident::HashValue.of_content(b"counter"), name: text::String.of("counter", alloc), targets: mem::List.empty(alloc), entries: take entries, required: mem::List.empty(alloc), escapes: mem::List.empty(alloc), authority: mem::List.empty(alloc), main: None, trees: take trees, snapshots: take snapshots, protocols: take protocols, earlier: mem::List.empty(alloc), seals: mem::List.empty(alloc), publisher: None, authors: mem::List.empty(alloc)))
    let Some(components) = components_of(artefacts[0], artefacts, alloc) else {
        expect false
        return
    }
    expect components.len() == 1 and components[0].state.as_str() == "counter::Counter" and components[0].schema == ident::HashValue.of_content(b"tree of Counter") and components[0].protocol == counting and components[0].config.is_none()
    let operations = components[0].operations
    expect operations.len() == 2 and operations[0].name.as_str() == "add" and operations[0].reversibility.as_str() == "recorded" and operations[0].digest.as_str() == "effects recorded | authority sys::Log | may-trap yes | terminates"
    expect operations[1].name.as_str() == "total" and operations[1].reversibility.as_str() == "traceless" and operations[1].digest.as_str() == "effects none | authority none | may-trap no | terminates"
    let env = components[0].env
    expect env.len() == 2 and env[0].name.as_str() == "log" and env[0].kind.as_str() == "sys::Log" and env[0].protocol.is_none() and not env[0].optional
    expect env[1].name.as_str() == "peer" and env[1].kind.as_str() == "os::Port" and env[1].protocol == Some(counting) and env[1].optional
    mut artefacts.at_mut(0).entries.push(text::String.of("Env", alloc))
    let undescribed = components_of(artefacts[0], artefacts, alloc)
    expect undescribed.is_none()
} component_entries_are_described_from_the_snapshots_trees_and_protocols_of_their_root
