//! The genesis record of a kernel image: its base components with their protocols and state schemas, their specifications and grants, the admission records of its bundle and jobs, and the configuration a fresh store starts with.

package genesis {
    language 1
    targets any
    dep admission "../admission"
    dep clock "../clock"
    dep code "../code"
    dep console "../console"
    dep devices "../devices"
    dep drivers "../drivers"
    dep fat "../fat"
    dep generations "../generations"
    dep ident "../ident"
    dep journal "../journal"
    dep keys "../keys"
    dep link "../link"
    dep os "../os"
    dep policy "../policy"
    dep power "../power"
    dep selftest "../jobs/selftest"
    dep store "../store"
    dep supervisor "../supervisor"
    allow confined in drivers
    allow contribute devices::drivers in drivers
    allow device in drivers
    allow validate in admission, clock, code, console, devices, drivers, fat, generations, ident, journal, keys, link, os, policy, power, selftest, store, supervisor
} genesis
