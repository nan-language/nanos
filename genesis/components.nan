//! The base components the kernel image holds: their canonical paths, the protocols they own and serve, their state schemas and the configuration record types their Envs take.

/// The canonical paths of the base components.
pub const SUPERVISOR: Str = "supervisor::Supervision"

pub const DEVICES: Str = "devices::Manager"

pub const VIEW: Str = "devices::View"

pub const FAT: Str = "fat::Files"

pub const VIRTIO_RNG: Str = "drivers::virtio::Rng"

pub const VIRTIO_BLK: Str = "drivers::virtio::Blk"

pub const NVME: Str = "drivers::nvme::Nvme"

pub const AML_EVALUATOR: Str = "devices::aml::Evaluator"

pub const UART_DRIVER: Str = "drivers::uart::Uart"

pub const CMOS_DRIVER: Str = "drivers::cmos::Cmos"

pub const AHCI: Str = "drivers::ahci::Ahci"

pub const TPM_CRB: Str = "drivers::crb::Crb"

pub const STORE_SERVICE: Str = "store::service::Service"

pub const JOURNAL: Str = "journal::Recorder"

pub const KEYS: Str = "keyring::Keyring"

/// The entry the `keyring` bundle exports `keys` under.
pub const KEYRING_ENTRY: Str = "Keyring"

/// The memory limit of `keys`.
pub const KEYS_MEMORY: u64 = 16_777_216

pub const POLICY: Str = "policy::Overseer"

pub const GENERATIONS: Str = "generations::Boot"

pub const TIMEKEEPER: Str = "clock::Timekeeper"

pub const POWER: Str = "power::Powering"

pub const LINKER: Str = "link::Linker"

pub const DESK: Str = "console::Desk"

pub const ADMISSION: Str = "admission::Admitter"

/// The canonical paths of the record types genesis writes besides specifications.
const GRANT_TYPE: Str = "os::Grant"

pub const BOOT_STATE_TYPE: Str = "bootfmt::BootState"

const STORE_CONFIG_TYPE: Str = "store::service::StoreConfig"

const PRINCIPAL_RECORD_TYPE: Str = "os::PrincipalRecord"

const JOURNAL_CONFIG_TYPE: Str = "journal::JournalConfig"

const SIGNED_POLICY_TYPE: Str = "policy::SignedPolicy"

const CLOCK_CONFIG_TYPE: Str = "clock::ClockConfig"

const POWER_CONFIG_TYPE: Str = "power::PowerConfig"

const LINK_CONFIG_TYPE: Str = "link::LinkConfig"

const POLICY_CONFIG_TYPE: Str = "policy::PolicyConfig"

const SUPERVISOR_CONFIG_TYPE: Str = "supervisor::SupervisorConfig"

/// The memory limit of `store`, whose engine keeps index nodes of 16 KiB in memory.
const STORE_LIMIT: u64 = 67_108_864

/// The memory limit of `admission`, which holds a bundle blob, its decoding and its artefacts read, and the workspace of a check of its sources with the toolchain's cache.
const ADMISSION_LIMIT: u64 = 268_435_456

/// The root package of the base bundle.
const BASE_ROOT: Str = "kernel"

pub fn protocols(component: Str) -> Option[os::Protocols] {
    if component == SUPERVISOR {
        return Some(os::Protocols(own: sys::Wire[supervisor::Supervisor].hash(), serves: Some(sys::Wire[store::service::Watcher].hash())))
    }
    if component == DEVICES {
        return Some(os::Protocols(own: sys::Wire[devices::Devices].hash(), serves: None))
    }
    if component == VIEW {
        return Some(os::Protocols(own: sys::Wire[devices::VolumeView].hash(), serves: Some(sys::Wire[devices::Block].hash())))
    }
    if component == FAT {
        return Some(os::Protocols(own: sys::Wire[fat::FatFiles].hash(), serves: Some(sys::Wire[devices::Fat].hash())))
    }
    if component == VIRTIO_RNG {
        return Some(os::Protocols(own: sys::Wire[drivers::virtio::RngDevice].hash(), serves: Some(sys::Wire[devices::Entropy].hash())))
    }
    if component == VIRTIO_BLK {
        return Some(os::Protocols(own: sys::Wire[drivers::virtio::BlkDevice].hash(), serves: Some(sys::Wire[devices::Block].hash())))
    }
    if component == NVME {
        return Some(os::Protocols(own: sys::Wire[drivers::nvme::NvmeDevice].hash(), serves: Some(sys::Wire[devices::Block].hash())))
    }
    if component == AML_EVALUATOR {
        return Some(os::Protocols(own: sys::Wire[devices::aml::Aml].hash(), serves: None))
    }
    if component == UART_DRIVER {
        return Some(os::Protocols(own: sys::Wire[drivers::uart::UartDevice].hash(), serves: Some(sys::Wire[devices::Console].hash())))
    }
    if component == CMOS_DRIVER {
        return Some(os::Protocols(own: sys::Wire[drivers::cmos::CmosDevice].hash(), serves: Some(sys::Wire[devices::Rtc].hash())))
    }
    if component == AHCI {
        return Some(os::Protocols(own: sys::Wire[drivers::ahci::AhciDevice].hash(), serves: Some(sys::Wire[devices::Block].hash())))
    }
    if component == TPM_CRB {
        return Some(os::Protocols(own: sys::Wire[drivers::crb::CrbDevice].hash(), serves: Some(sys::Wire[devices::Tpm].hash())))
    }
    if component == STORE_SERVICE {
        return Some(os::Protocols(own: sys::Wire[store::service::Store].hash(), serves: None))
    }
    if component == JOURNAL {
        return Some(os::Protocols(own: sys::Wire[journal::Journal].hash(), serves: None))
    }
    if component == KEYS {
        return Some(os::Protocols(own: sys::Wire[keys::Keys].hash(), serves: Some(sys::Wire[store::service::Sealing].hash())))
    }
    if component == POLICY {
        return Some(os::Protocols(own: sys::Wire[policy::Oversight].hash(), serves: Some(sys::Wire[store::service::Watcher].hash())))
    }
    if component == GENERATIONS {
        return Some(os::Protocols(own: sys::Wire[generations::Generations].hash(), serves: None))
    }
    if component == TIMEKEEPER {
        return Some(os::Protocols(own: sys::Wire[clock::Timekeeping].hash(), serves: None))
    }
    if component == POWER {
        return Some(os::Protocols(own: sys::Wire[power::Power].hash(), serves: None))
    }
    if component == LINKER {
        return Some(os::Protocols(own: sys::Wire[link::LinkSession].hash(), serves: Some(sys::Wire[store::service::Watcher].hash())))
    }
    if component == DESK {
        return Some(os::Protocols(own: sys::Wire[console::Console].hash(), serves: None))
    }
    if component == ADMISSION {
        return Some(os::Protocols(own: sys::Wire[admission::Admitting].hash(), serves: None))
    }
    return None
} protocols

/// The protocol schema each base component serves.
pub fn schema(component: Str, alloc: mem::Alloc) -> Option[sys::ProtocolSchema] {
    if component == SUPERVISOR {
        return Some(sys::Wire[supervisor::Supervisor].schema(alloc))
    }
    if component == DEVICES {
        return Some(sys::Wire[devices::Devices].schema(alloc))
    }
    if component == VIEW {
        return Some(sys::Wire[devices::VolumeView].schema(alloc))
    }
    if component == FAT {
        return Some(sys::Wire[fat::FatFiles].schema(alloc))
    }
    if component == VIRTIO_RNG {
        return Some(sys::Wire[drivers::virtio::RngDevice].schema(alloc))
    }
    if component == VIRTIO_BLK {
        return Some(sys::Wire[drivers::virtio::BlkDevice].schema(alloc))
    }
    if component == NVME {
        return Some(sys::Wire[drivers::nvme::NvmeDevice].schema(alloc))
    }
    if component == AML_EVALUATOR {
        return Some(sys::Wire[devices::aml::Aml].schema(alloc))
    }
    if component == UART_DRIVER {
        return Some(sys::Wire[drivers::uart::UartDevice].schema(alloc))
    }
    if component == CMOS_DRIVER {
        return Some(sys::Wire[drivers::cmos::CmosDevice].schema(alloc))
    }
    if component == AHCI {
        return Some(sys::Wire[drivers::ahci::AhciDevice].schema(alloc))
    }
    if component == TPM_CRB {
        return Some(sys::Wire[drivers::crb::CrbDevice].schema(alloc))
    }
    if component == STORE_SERVICE {
        return Some(sys::Wire[store::service::Store].schema(alloc))
    }
    if component == JOURNAL {
        return Some(sys::Wire[journal::Journal].schema(alloc))
    }
    if component == KEYS {
        return Some(sys::Wire[keys::Keys].schema(alloc))
    }
    if component == POLICY {
        return Some(sys::Wire[policy::Oversight].schema(alloc))
    }
    if component == GENERATIONS {
        return Some(sys::Wire[generations::Generations].schema(alloc))
    }
    if component == TIMEKEEPER {
        return Some(sys::Wire[clock::Timekeeping].schema(alloc))
    }
    if component == POWER {
        return Some(sys::Wire[power::Power].schema(alloc))
    }
    if component == LINKER {
        return Some(sys::Wire[link::LinkSession].schema(alloc))
    }
    if component == DESK {
        return Some(sys::Wire[console::Console].schema(alloc))
    }
    if component == ADMISSION {
        return Some(sys::Wire[admission::Admitting].schema(alloc))
    }
    return None
} schema

/// The schema tree of each base component's state.
pub fn base_states(alloc: mem::Alloc) -> mem::List[code::Tree] {
    var states = mem::List[code::Tree].empty(alloc)
    mut states.push(code::Tree.of(SUPERVISOR, schema: mem::wire::Codec[supervisor::Supervision].schema(alloc), alloc))
    mut states.push(code::Tree.of(DEVICES, schema: mem::wire::Codec[devices::Manager].schema(alloc), alloc))
    mut states.push(code::Tree.of(VIEW, schema: mem::wire::Codec[devices::View].schema(alloc), alloc))
    mut states.push(code::Tree.of(FAT, schema: mem::wire::Codec[fat::Files].schema(alloc), alloc))
    mut states.push(code::Tree.of(VIRTIO_RNG, schema: mem::wire::Codec[drivers::virtio::Rng].schema(alloc), alloc))
    mut states.push(code::Tree.of(VIRTIO_BLK, schema: mem::wire::Codec[drivers::virtio::Blk].schema(alloc), alloc))
    mut states.push(code::Tree.of(NVME, schema: mem::wire::Codec[drivers::nvme::Nvme].schema(alloc), alloc))
    mut states.push(code::Tree.of(AML_EVALUATOR, schema: mem::wire::Codec[devices::aml::Evaluator].schema(alloc), alloc))
    mut states.push(code::Tree.of(UART_DRIVER, schema: mem::wire::Codec[drivers::uart::Uart].schema(alloc), alloc))
    mut states.push(code::Tree.of(CMOS_DRIVER, schema: mem::wire::Codec[drivers::cmos::Cmos].schema(alloc), alloc))
    mut states.push(code::Tree.of(AHCI, schema: mem::wire::Codec[drivers::ahci::Ahci].schema(alloc), alloc))
    mut states.push(code::Tree.of(TPM_CRB, schema: mem::wire::Codec[drivers::crb::Crb].schema(alloc), alloc))
    mut states.push(code::Tree.of(STORE_SERVICE, schema: mem::wire::Codec[store::service::Service].schema(alloc), alloc))
    mut states.push(code::Tree.of(JOURNAL, schema: mem::wire::Codec[journal::Recorder].schema(alloc), alloc))
    mut states.push(code::Tree.of(POLICY, schema: mem::wire::Codec[policy::Overseer].schema(alloc), alloc))
    mut states.push(code::Tree.of(GENERATIONS, schema: mem::wire::Codec[generations::Boot].schema(alloc), alloc))
    mut states.push(code::Tree.of(TIMEKEEPER, schema: mem::wire::Codec[clock::Timekeeper].schema(alloc), alloc))
    mut states.push(code::Tree.of(POWER, schema: mem::wire::Codec[power::Powering].schema(alloc), alloc))
    mut states.push(code::Tree.of(LINKER, schema: mem::wire::Codec[link::Linker].schema(alloc), alloc))
    mut states.push(code::Tree.of(DESK, schema: mem::wire::Codec[console::Desk].schema(alloc), alloc))
    mut states.push(code::Tree.of(ADMISSION, schema: mem::wire::Codec[admission::Admitter].schema(alloc), alloc))
    return states
} base_states

/// The canonical path of the configuration record type the component's Env takes: `journal`'s, `policy`'s, `clock`'s, `power`'s and `link`'s.
pub fn config_type(component: Str) -> Option[text::Fixed[32]] {
    if component == JOURNAL {
        return Some(text::Fixed[32].of(JOURNAL_CONFIG_TYPE))
    }
    if component == POLICY {
        return Some(text::Fixed[32].of(POLICY_CONFIG_TYPE))
    }
    if component == TIMEKEEPER {
        return Some(text::Fixed[32].of(CLOCK_CONFIG_TYPE))
    }
    if component == POWER {
        return Some(text::Fixed[32].of(POWER_CONFIG_TYPE))
    }
    if component == LINKER {
        return Some(text::Fixed[32].of(LINK_CONFIG_TYPE))
    }
    return None
} config_type
