//! The admission records genesis writes at `/sys/code/<hash>`: the base bundle's and the base jobs'.

const SELFTEST_JOB: Str = "selftest"

const SCRUB_JOB: Str = "scrub"

const REPLAY_JOB: Str = "replay"

/// The root package of the `nan` job.
pub const NAN_JOB: Str = "nan"

/// A kernel image as its generation's records name it: its blob id, which is its base bundle's code hash, the hash of the support routines it exports, and the bytes its loadable segments span.
pub closed struct Image derives Copy, Eq {
    pub bundle: ident::HashValue
    pub support: ident::HashValue
    pub bytes: u64
} Image

/// The admission record of the base bundle, typed: each base component with its state schema, protocol, operations' bounds and configuration type.
fn Image.admission(self, alloc: mem::Alloc) -> store::service::TypedValue {
    var components = mem::List[code::Component].empty(alloc)
    for state in base_states(alloc) {
        mut components.push(component_of(state.path.as_str(), state: state.schema, alloc))
    }
    return self.record(root: BASE_ROOT, take components, program: None, alloc)
} Image.admission

/// The admission record of a closure of the kernel image rooted at `root`, exporting `components` or the program `program`, provenance `vendor`, shared, and its image the kernel image, lowered at the base set of x86_64; what only the build's artefacts tell is empty, the toolchain hash `HashValue.zero`.
fn Image.record(
    self,
    root: Str,
    take components: mem::List[code::Component],
    take program: Option[code::Program],
    alloc: mem::Alloc,
    ) -> store::service::TypedValue {
    let unknown = ident::HashValue.zero()
    let record = code::Admission(
        root: text::String.of(root, alloc),
        packages: mem::List.empty(alloc),
        components: take components,
        program: take program,
        authority: mem::List.empty(alloc),
        escapes: mem::List.empty(alloc),
        contributions: mem::List.empty(alloc),
        provenance: os::Provenance.Vendor,
        shared: true,
        check: code::CodeCheck.Verified(toolchain: unknown),
        image: code::Lowered(level: code::Level.X86v1, toolchain: unknown, support: self.support, image: self.bundle, code_bytes: self.bytes),
        admitted: ident::CommitId(number: 0),
    )
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[code::Admission].encode(record, out: mut bytes)
    return store::service::TypedValue(type: store::TypeRef.of(code::ADMISSION_TYPE, schema: mem::wire::Codec[code::Admission].schema_hash(), alloc), bytes: take bytes)
} Image.record

/// The base component of state type `component` and state schema `state` as the kernel image runs it.
fn component_of(component: Str, state: ident::HashValue, alloc: mem::Alloc) -> code::Component {
    var protocol = ident::HashValue.zero()
    var operations = mem::List[code::Operation].empty(alloc)
    match schema(component, alloc) {
        Some(served) => {
            protocol = ident::HashValue(bytes: served.hash.bytes)
            for operation in served.operations {
                mut operations.push(code::Operation.of_schema(operation, alloc))
            }
        }
        None => {
        }
    }
    let config = match config_type(component) {
        Some(name) => Some(text::String.of(name.as_str(), alloc))
        None => None
    }
    return code::Component(state: text::String.of(component, alloc), schema: state, protocol: protocol, operations: take operations, env: mem::List.empty(alloc), config: take config, earlier: mem::List.empty(alloc), flexible: false)
} component_of

/// The code hashes of the base jobs, the `nan` job's when the machine runs it.
pub closed struct Jobs derives Copy, Eq {
    pub selftest: ident::HashValue
    pub scrub: ident::HashValue
    pub replay: ident::HashValue
    pub nan: Option[ident::HashValue]
} Jobs

/// The code hashes of the base jobs of the base bundle of code hash `bundle`, with the `nan` job of the toolchain whose tree hash is `tree` when there is one.
pub fn Jobs.of(bundle: ident::HashValue, tree: Option[ident::HashValue], alloc: mem::Alloc) -> Jobs {
    let nan = match tree {
        Some(closure) => Some(toolchain_code(bundle, tree: closure, alloc))
        None => None
    }
    return Jobs(selftest: job_code(SELFTEST_JOB, bundle, alloc), scrub: job_code(SCRUB_JOB, bundle, alloc), replay: job_code(REPLAY_JOB, bundle, alloc), nan: nan)
} Jobs.of

/// The code hash of the `nan` job: that of the closure rooted at `nan` whose code roots are the base bundle's code hash `bundle` and the toolchain's tree hash `tree`, in byte order.
fn toolchain_code(bundle: ident::HashValue, tree: ident::HashValue, alloc: mem::Alloc) -> ident::HashValue {
    var roots = mem::List[ident::HashValue].empty(alloc)
    if tree < bundle {
        mut roots.push(tree)
        mut roots.push(bundle)
    } else {
        mut roots.push(bundle)
        mut roots.push(tree)
    }
    return code::CodeId(root: text::String.of(NAN_JOB, alloc), code_roots: take roots).hash(alloc)
} toolchain_code

/// The code hash of the base job `name`: that of the closure rooted at `name` whose one code root is the base bundle's code hash `bundle`.
fn job_code(name: Str, bundle: ident::HashValue, alloc: mem::Alloc) -> ident::HashValue {
    var roots = mem::List[ident::HashValue].empty(alloc)
    mut roots.push(bundle)
    return code::CodeId(root: text::String.of(name, alloc), code_roots: take roots).hash(alloc)
} job_code

/// The admission records of the base jobs, by code hash.
fn Image.job_admissions(self, jobs: Jobs, alloc: mem::Alloc) -> mem::Map[ident::HashValue, store::service::TypedValue] {
    var records = mem::Map[ident::HashValue, store::service::TypedValue].empty(alloc)
    discard mut records.insert(jobs.selftest, value: self.record(root: SELFTEST_JOB, components: mem::List.empty(alloc), program: Some(program_of(input: mem::wire::Codec[Unit].schema_hash(), output: mem::wire::Codec[mem::List[selftest::Check]].schema_hash())), alloc))
    discard mut records.insert(jobs.scrub, value: self.record(root: SCRUB_JOB, components: mem::List.empty(alloc), program: Some(program_of(input: mem::wire::Codec[Unit].schema_hash(), output: mem::wire::Codec[store::ScrubReport].schema_hash())), alloc))
    discard mut records.insert(jobs.replay, value: self.record(root: REPLAY_JOB, components: mem::List.empty(alloc), program: Some(program_of(input: mem::wire::Codec[journal::ReplayRequest].schema_hash(), output: mem::wire::Codec[journal::ReplayReport].schema_hash())), alloc))
    match jobs.nan {
        Some(code) => {
            let input = mem::wire::Codec[code::NanRequest].schema_hash()
            let output = mem::wire::Codec[code::NanReport].schema_hash()
            let program = code::Program(input: Some(ident::HashValue(bytes: input.bytes)), output: Some(ident::HashValue(bytes: output.bytes)), class: sys::Reversibility.Recorded, host: false)
            discard mut records.insert(code, value: self.record(root: NAN_JOB, components: mem::List.empty(alloc), program: Some(take program), alloc))
        }
        None => {
        }
    }
    return records
} Image.job_admissions

/// The program of a base job, of input schema `input` and output schema `output`, which leaves no trace.
fn program_of(input: mem::wire::SchemaHash, output: mem::wire::SchemaHash) -> code::Program {
    return code::Program(input: Some(ident::HashValue(bytes: input.bytes)), output: Some(ident::HashValue(bytes: output.bytes)), class: sys::Reversibility.Traceless, host: false)
} program_of
