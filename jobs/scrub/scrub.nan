//! The `scrub` job: has the store verify its checksums and blob identities.

/// Why a scrub gave no report: no View granted as `tree`, the store's failure, or a cancellation.
pub closed enum Unscrubbed derives Render {
    Ungranted
    Failed(code: text::Fixed[32])
    Cancelled(task::Cancelled) from
} Unscrubbed

/// What the store found verifying its volume through the View of the job's grant `tree`, which needs `admin`.
pub fn main(take world: nanos::World, take input: Unit) -> store::ScrubReport fails Unscrubbed uses wait {
    let Ok(tree) = attempt nanos::Cap[store::service::View].get(world.caps, key: "tree") else {
        fail Unscrubbed.Ungranted
    }
    return match first attempt await tree.scrub(world.alloc) {
        Ok(report) => report
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(failed) => fail Unscrubbed.Failed(code: failed.code())
    }
} main
