//! The `selftest` job: checks of the machine's consistency.

package selftest {
    language 1
    targets x86_64-nanos
    entry main
    dep ident "../../ident"
    dep keys "../../keys"
    dep os "../../os"
    dep policy "../../policy"
    dep store "../../store"
    allow validate in ident, keys, os, policy, selftest, store
} selftest
