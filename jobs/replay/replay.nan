//! The `replay` job: re-runs a recorded input of an instance on forks of it.

/// Why a replay gave no report: no `Control` granted as `control` or no View as `tree`, the code of what failed, or a cancellation.
pub closed enum Unreplayed derives Render {
    Ungranted
    Failed(code: text::Fixed[32])
    Cancelled(task::Cancelled) from
} Unreplayed

/// Re-runs the recorded input `input` names through the `Control` of the job's grant `control`, the forks' store reads reaching a branch the View of its grant `tree` makes.
pub fn main(take world: nanos::World, take input: journal::ReplayRequest) -> journal::ReplayReport fails Unreplayed uses wait {
    let Ok(control) = attempt nanos::Cap[os::Control].get(world.caps, key: "control") else {
        fail Unreplayed.Ungranted
    }
    let Ok(tree) = attempt nanos::Cap[store::service::View].get(world.caps, key: "tree") else {
        fail Unreplayed.Ungranted
    }
    return match try await journal::replay_input(control, view: tree, request: input, alloc: world.alloc) {
        Ok(report) => report
        Err(code) => fail Unreplayed.Failed(code: code)
    }
} main
