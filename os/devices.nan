//! Device claims: the capability a driver's Env is built from, naming the device of its `Device` grant.

/// The claim on the device at a bus path that a `Device` grant confers.
pub open struct Device {
} Device

impl Device: sys::Kind[Claim, u8]

/// The root entry the claims of one grant and instance derive from, revoked when it closes.
pub open linear struct MintedDevice derives Send {
    minter: sys::Minter[Device, Claim, u8]
} MintedDevice

struct Claim {
    path: text::String
} Claim

/// A root entry of claims on the device at `path`.
pub fn MintedDevice.of(path: Str, alloc: mem::Alloc) -> MintedDevice {
    return MintedDevice(minter: sys::Minter[Device, Claim, u8].of(Claim(path: text::String.of(path, alloc)), alloc))
} MintedDevice.of

pub fn MintedDevice.mint(self) -> Device {
    return self.minter.mint(0)
} MintedDevice.mint

/// Revokes every claim of this root entry.
pub fn MintedDevice.close(take self) {
    let MintedDevice(minter: minter) = self
    take minter.close()
} MintedDevice.close

/// The bus path of the claimed device, `None` once the claim is revoked.
pub fn Device.path(self, alloc: mem::Alloc) -> Option[text::String] {
    return sys::reach(self, body: fn(state: Claim, record: u8) => text::String.of(state.path.as_str(), alloc))
} Device.path

test claims_name_their_device_until_revoked for Device.path {
    let alloc = testing::world().alloc
    let minted = MintedDevice.of("pci/0000.00.03.0", alloc)
    let claim = minted.mint()
    let before = claim.path(alloc)
    take minted.close()
    let after = claim.path(alloc)
    expect before.is_some() and after.is_none()
} claims_name_their_device_until_revoked
