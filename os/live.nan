//! `/live`: the records its providers publish there, what the core's board holding them takes, and the `Live` capability through which `store` reads them and a provider publishes below its own path.

/// A record published below `/live`: its type's canonical name and schema hash, and its encoding.
pub closed struct Published {
    pub type: text::String
    pub schema: mem::wire::SchemaHash
    pub bytes: mem::Bytes
} Published

/// A child of a node of `/live`: its name, the type of the record it holds, and whether nodes lie below it.
pub closed struct LiveEntry {
    pub name: text::String
    pub type: Option[text::String]
    pub parent: bool
} LiveEntry

/// What the board takes: a record published at a path, the withdrawal of the one at a path, the record at a path, or the children of a path after a name, at most `limit`.
pub closed enum Posting {
    Publish(path: text::String, record: Published)
    Withdraw(path: text::String)
    Get(path: text::String, reply: task::Sender[Option[Published]])
    List(path: text::String, after: Option[text::String], limit: u32, reply: task::Sender[mem::List[LiveEntry]])
} Posting

/// What an incarnation has used, as of its reading: the messages queued for it, its cell, the CPU time charged to its account, and its account's CPU class; the bundle it runs and its number; its handler calls, by run time in 32 buckets, bucket 0 below 1 µs and bucket k from 2^(k−1) to 2^k µs; and the abandonments of its instance's incarnations so far.
pub closed struct Gauge derives Copy, Eq {
    pub intake: u32
    pub memory: Usage
    pub cpu_ns: u64
    pub class: CpuClass
    pub bundle: ident::HashValue
    pub incarnation: u64
    pub messages: u64
    pub latency: Array[u64, 32]
    pub traps: u64
} Gauge

/// A capability on the board: reading every node of `/live`, and publishing the records below its own path.
pub open struct Live {
} Live

impl Live: sys::Kind[Board, u8]

/// Where a `Live` capability's postings go, and the path below which it publishes.
struct Board {
    postings: task::Sender[Posting]
    own: text::String
} Board

/// The root entry the `Live` capabilities of one provider derive from, revoked when it closes.
pub open linear struct MintedLive derives Send {
    minter: sys::Minter[Live, Board, u8]
} MintedLive

/// A root entry of capabilities posting to `postings` and publishing below `own`.
pub fn MintedLive.of(postings: task::Sender[Posting], own: Str, alloc: mem::Alloc) -> MintedLive {
    return MintedLive(minter: sys::Minter[Live, Board, u8].of(Board(postings: postings.split(), own: text::String.of(own, alloc)), alloc))
} MintedLive.of

pub fn MintedLive.mint(self) -> Live {
    return self.minter.mint(0)
} MintedLive.mint

/// Revokes every capability of this root entry.
pub fn MintedLive.close(take self) {
    let MintedLive(minter: minter) = self
    take minter.close()
} MintedLive.close

/// The record at `path`, `None` when none is published there or the capability is stale.
pub fn Live.get(self, path: Str, alloc: mem::Alloc) -> Option[Published] fails task::Cancelled uses wait {
    let Some(postings) = sys::reach(self, body: fn(state: Board, record: u8) => state.postings.split()) else {
        return None
    }
    let task::Channel(sender: reply, receiver: replies) = task::Channel[Option[Published]].bounded(1, alloc)
    try await post(postings, posting: Posting.Get(path: text::String.of(path, alloc), reply: take reply))
    var receiver = replies
    let Some(found) = try await mut receiver.receive() else {
        return None
    }
    return found
} Live.get

/// The children of `path` named after `after`, at most `limit`; none when the capability is stale.
pub fn Live.list(
    self,
    path: Str,
    take after: Option[text::String],
    limit: u32,
    alloc: mem::Alloc,
    ) -> mem::List[LiveEntry] fails task::Cancelled uses wait {
    let Some(postings) = sys::reach(self, body: fn(state: Board, record: u8) => state.postings.split()) else {
        return mem::List.empty(alloc)
    }
    let task::Channel(sender: reply, receiver: replies) = task::Channel[mem::List[LiveEntry]].bounded(1, alloc)
    try await post(postings, posting: Posting.List(path: text::String.of(path, alloc), after: take after, limit: limit, reply: take reply))
    var receiver = replies
    let Some(found) = try await mut receiver.receive() else {
        return mem::List.empty(alloc)
    }
    return found
} Live.list

/// Publishes `value` of the type named `type` as the record at the capability's own path; nothing once it is stale.
pub fn Live.publish[T: Encode](self, type: Str, value: T, alloc: mem::Alloc) fails task::Cancelled uses wait {
    try await self.publish_below(below: "", value: published(type, value, alloc), alloc)
} Live.publish

/// Publishes `value` at `below`, a path relative to the capability's own; nothing once it is stale.
pub fn Live.publish_below(self, below: Str, take value: Published, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let Some(postings) = sys::reach(self, body: fn(state: Board, record: u8) => state.postings.split()) else {
        return
    }
    let Some(path) = self.path_below(below, alloc) else {
        return
    }
    try await post(postings, posting: Posting.Publish(path: take path, record: take value))
} Live.publish_below

/// Withdraws the record at `below`, a path relative to the capability's own; nothing once it is stale.
pub fn Live.withdraw_below(self, below: Str, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let Some(postings) = sys::reach(self, body: fn(state: Board, record: u8) => state.postings.split()) else {
        return
    }
    let Some(path) = self.path_below(below, alloc) else {
        return
    }
    try await post(postings, posting: Posting.Withdraw(path: take path))
} Live.withdraw_below

/// The path `below` names relative to the capability's own, `None` once it is stale.
fn Live.path_below(self, below: Str, alloc: mem::Alloc) -> Option[text::String] {
    return sys::reach(self, body: fn(state: Board, record: u8) -> text::String {
        var path = text::String.of(state.own.as_str(), alloc)
        if below.byte_len() > 0 {
            mut path.push('/')
            mut path.append(below)
        }
        return path
    })
} Live.path_below

/// Posts `value` of the type named `type` as the record at `path`.
pub fn publish[T: Encode](
    postings: task::Sender[Posting],
    path: Str,
    type: Str,
    value: T,
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    try await post(postings, posting: Posting.Publish(path: text::String.of(path, alloc), record: published(type, value, alloc)))
} publish

/// The record of `value`, of the type named `type`.
pub fn published[T: Encode](type: Str, value: T, alloc: mem::Alloc) -> Published {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[T].encode(value, out: mut bytes)
    return Published(type: text::String.of(type, alloc), schema: mem::wire::Codec[T].schema_hash(), bytes: take bytes)
} published

/// Posts `posting` to the board; nothing once it no longer listens.
pub fn post(postings: task::Sender[Posting], take posting: Posting) fails task::Cancelled uses wait {
    match attempt await postings.send(take posting) {
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} post

/// The state of an instance's reconciliation, `failed` with the code and the detail of its failure.
pub closed enum ReconcileState derives Eq, Render, Encode {
    Converged
    Converging
    Failed(code: text::String, detail: text::String)
} ReconcileState

/// How far a reconciled node is from its desired value: its state, the commit of the desired value it acts on, and the time of its last change.
pub closed struct ReconcileStatus derives Eq, Render, Encode {
    pub state: ReconcileState
    pub desired: u64
    pub since: ident::WallTime
} ReconcileStatus

/// A cell's charge, limit and peak in bytes.
pub closed struct Usage derives Copy, Eq, Render, Encode {
    pub charged: u64
    pub limit: u64
    pub peak: u64
} Usage

/// The record of an account below `/live/accounts`: its CPU time, wakeups, I/O bytes and energy, whether its energy budget is spent, its CPU class, and its cell's charge, highest charge and limit.
pub closed struct Account derives Eq, Render, Encode {
    pub cpu_ns: u64
    pub wakeups: u64
    pub io_bytes: u64
    pub energy_mj: u64
    pub throttled: bool
    pub class: CpuClass
    pub charge: u64
    pub peak: u64
    pub limit: u64
    pub as_of: u64
} Account

/// The record of `/live/instances/<moniker>`.
pub closed struct LiveInstance derives Eq, Render, Encode {
    pub state: Lifecycle
    pub status: ReconcileStatus
    pub bundle: ident::HashValue
    pub space: text::String
    pub durability: Durability
    pub restarts: u32
    pub fault: Option[text::String]
    pub intake: u32
    pub memory: Usage
    pub cpu_ns: u64
