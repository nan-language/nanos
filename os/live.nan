pub closed enum BootMode derives Copy, Eq, Render, Encode {
    Normal
    Trial
    Recovery
    Dev
} BootMode

/// The record of `/live/status`.
pub closed struct LiveStatus derives Eq, Render, Encode {
    pub generation: u64
    pub mode: BootMode
    pub claimed: bool
    pub uptime: u64
    pub time: ident::WallTime
    pub instances: InstanceCounts
    pub approvals: u32
