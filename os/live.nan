} LiveStatus

/// The time a CPU spent on work of each CPU class, on interrupt and core work, and idle, in nanoseconds.
pub closed struct CpuTime derives Copy, Eq, Render, Encode {
    pub normal: u64
    pub background: u64
    pub latency: u64
    pub interrupts: u64
    pub idle: u64
} CpuTime

/// The record of a CPU below `/live/cpus`: whether it runs, its package, core, last-level cache and NUMA node, the CPUs on its core, its time, the work queued on it, the idle state it rests in, empty while it runs work, its frequency, and the rests it left.
pub closed struct LiveCpu derives Eq, Render, Encode {
    pub online: bool
    pub package_id: u32
    pub core: u32
    pub llc: u32
    pub node: u32
    pub siblings: mem::List[u32]
    pub time: CpuTime
    pub run_queue: u32
    pub idle_state: text::String
    pub frequency_mhz: u32
    pub wakeups: u64
    pub as_of: u64
} LiveCpu

/// Whether the loader keeps an anti-rollback floor.
pub closed enum Rollback derives Copy, Eq, Render, Encode {
    Protected
    Unprotected
} Rollback

pub closed enum LoaderBuild derives Copy, Eq, Render, Encode {
    Production
    Development
} LoaderBuild

/// Whether DMA is confined to the buffers a device's driver maps.
pub closed enum Confinement derives Copy, Eq, Render, Encode {
    Confined
    Unconfined
} Confinement

/// Whether `keys` runs alone in an isolated space.
pub closed enum KeysSpace derives Copy, Eq, Render, Encode {
    Isolated
    Unconfined
} KeysSpace

/// Where `keys` keeps its keys at rest: sealed with the TPM, or in plaintext in its checkpoint.
pub closed enum KeyStorage derives Copy, Eq, Render, Encode {
    Tpm
    Software
} KeyStorage

pub closed enum AuditChain derives Copy, Eq, Render, Encode {
    Intact
    Broken
} AuditChain

pub closed enum VolumeCipher derives Copy, Eq, Render, Encode {
    Encrypted
    Plain
} VolumeCipher

/// The public halves of the link key.
pub closed struct LinkKeys derives Eq, Render, Encode {
    pub x25519: mem::Bytes
    pub ed25519: mem::Bytes
} LinkKeys

/// The record of `/live/security`, each field's protected value the first its type names, `secure_boot`, `measured` and `isolated_spaces` protected when true.
pub closed struct LiveSecurity derives Eq, Render, Encode {
    pub rollback: Rollback
    pub loader: LoaderBuild
    pub secure_boot: bool
    pub measured: bool
    pub dma: Confinement
    pub isolated_spaces: bool
    pub keys: KeysSpace
    pub key_storage: KeyStorage
    pub link_keys: LinkKeys
    pub audit: AuditChain
    pub audit_key: mem::Bytes
    pub volume: VolumeCipher
    pub as_of: u64
} LiveSecurity

/// The part of `/live/security` `keys` publishes: where it runs, where it keeps its keys and the public halves of the link key.
pub closed struct KeysSecurity derives Eq, Render, Encode {
    pub keys: KeysSpace
    pub key_storage: KeyStorage
    pub link_keys: LinkKeys
} KeysSecurity

/// Whether the boot before this one ended after its health gate.
pub closed enum PreviousBoot derives Copy, Eq, Render, Encode {
    Healthy
    Unhealthy
} PreviousBoot

/// The record of `/live/boot`: the generation booted, its mode, the slot it booted from, the boot counter, the loader's version, the floor, the time-stamp counter at the loader's entry and at the kernel's with its frequency, the hash of the support routines the kernel image exports, how the previous boot ended, and the candidates the loader gave up with their codes.
pub closed struct LiveBoot derives Eq, Render, Encode {
    pub generation: u64
    pub mode: BootMode
    pub slot: Option[text::String]
    pub boot_counter: u64
    pub loader: u32
    pub floor: u64
    pub loader_entry: u64
    pub kernel_entry: u64
    pub counter_hz: u64
    pub support: ident::HashValue
    pub previous: PreviousBoot
    pub failures: mem::List[text::String]
    pub as_of: u64
} LiveBoot

/// The names of the fields away from their protected value, in field order.
pub fn LiveSecurity.exposures(self, alloc: mem::Alloc) -> mem::List[text::String] {
    var names = mem::List[text::String].empty(alloc)
    if self.rollback != Rollback.Protected {
        mut names.push(text::String.of("rollback", alloc))
    }
    if self.loader != LoaderBuild.Production {
        mut names.push(text::String.of("loader", alloc))
    }
    if not self.secure_boot {
        mut names.push(text::String.of("secure_boot", alloc))
    }
    if not self.measured {
        mut names.push(text::String.of("measured", alloc))
    }
    if self.dma != Confinement.Confined {
        mut names.push(text::String.of("dma", alloc))
    }
    if not self.isolated_spaces {
        mut names.push(text::String.of("isolated_spaces", alloc))
    }
    if self.keys != KeysSpace.Isolated {
        mut names.push(text::String.of("keys", alloc))
    }
    if self.key_storage != KeyStorage.Tpm {
        mut names.push(text::String.of("key_storage", alloc))
    }
    if self.audit != AuditChain.Intact {
        mut names.push(text::String.of("audit", alloc))
    }
    if self.volume != VolumeCipher.Encrypted {
        mut names.push(text::String.of("volume", alloc))
    }
    return names
} LiveSecurity.exposures

