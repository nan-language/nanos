//! CPU reservations: the part of a CPU the reservation of a `latency` share takes, and the CPU it is admitted on.

/// The millionths of a CPU the reservations admitted on it may take together.
pub const ADMISSIBLE_PPM: u64 = 800_000

/// The reservation admitted for an instance's `latency` share: the CPU it was admitted on and the millionths of it it takes.
pub closed struct CpuReservation derives Copy, Eq, Render, Encode {
    pub cpu: u32
    pub ppm: u32
} CpuReservation

/// The millionths of a CPU the reservation of the share takes: its runtime in each period, none outside the `latency` class.
pub fn Share.reserved_ppm(self) -> u64 {
    if self.class != CpuClass.Latency or self.period_us == 0 {
        return 0
    }
    return u64.widen(self.runtime_us) * 1_000_000 / u64.widen(self.period_us)
} Share.reserved_ppm

/// The CPU a reservation of `ppm` millionths of a CPU is admitted on when the reservations admitted on each CPU take `used` millionths of it: the one they take the least of, the lowest numbered on ties, provided they then take at most 80% of it; `None` when no CPU holds it.
pub fn admitting_cpu(used: Slice[u64], ppm: u64) -> Option[u32] {
    var chosen: Option[usize] = None
    for cpu in 0..<used.len() {
        let lighter = match chosen {
            Some(best) => used[cpu] < used[best]
            None => true
        }
        if lighter {
            chosen = Some(cpu)
        }
    }
    let Some(cpu) = chosen else {
        return None
    }
    if used[cpu].saturating_add(ppm) > ADMISSIBLE_PPM {
        return None
    }
    return Some(u32.truncate(u64.widen(cpu)))
} admitting_cpu

/// A reservation goes to the least used CPU, the lowest numbered on ties, when that CPU's reservations then take at most 80% of it.
test reservations_go_to_the_least_used_cpu_within_80_percent for admitting_cpu {
    var used = Array[u64, 2].filled(0)
    expect admitting_cpu(used.view(), ppm: 500_000) == Some(0)
    used[0] = 500_000
    expect admitting_cpu(used.view(), ppm: 300_000) == Some(1)
    used[1] = 700_000
    expect admitting_cpu(used.view(), ppm: 300_000) == Some(0) and admitting_cpu(used.view(), ppm: 400_000).is_none()
    expect admitting_cpu(Array[u64, 0].filled(0).view(), ppm: 1).is_none()
} reservations_go_to_the_least_used_cpu_within_80_percent
