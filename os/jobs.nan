//! Jobs: what a `run` step starts a job from, at `/state/<moniker>/job`, and what it ended with, at `/state/<moniker>/result`.

/// A job's specification: `branch` is `main` and `keep_h` 24 when absent.
pub closed struct JobSpec derives Render, Encode {
    pub moniker: Option[ident::Moniker]
    pub bundle: ident::HashValue
    pub input: mem::Bytes
    pub args: mem::List[mem::Bytes]
    pub environment: mem::Map[mem::Bytes, mem::Bytes]
    pub stdin: Option[ident::HashValue]
    pub wiring: mem::Map[text::String, Wire]
    pub grants: mem::Map[text::String, u64]
    pub budget: Budget
    pub share: Share
    pub placement: Placement
    pub handlers: Limits
    pub restart: Restart
    pub branch: Option[text::String]
    pub deadline_s: Option[u32]
    pub keep_h: Option[u32]
} JobSpec

/// How a job ended: the encoding of its result, the rendering of its failure, its trap report, what cancelled it (`cancel`, `deadline`, `freeze` or `stop`), or the machine stopping while it ran.
pub closed enum JobOutcome derives Render, Encode {
    Returned(bytes: mem::Bytes)
    Failed(text: text::String)
    Trapped(text: text::String)
    Cancelled(reason: text::String)
    Interrupted
} JobOutcome

/// What a job ended with: its outcome, a host-compatible entry's exit status, the commit merging its branch or the code of the merge that failed, the serial executor's seed, its times and the CPU time charged to it.
pub closed struct JobResult derives Render, Encode {
    pub outcome: JobOutcome
    pub status: Option[u8]
    pub commit: Option[ident::CommitId]
    pub commit_failure: Option[text::String]
    pub seed: Option[u64]
    pub started: ident::WallTime
    pub ended: ident::WallTime
    pub cpu_ns: u64
} JobResult

/// The moniker of the jobs whose spec names none, before the runner numbers them.
pub const JOBS: Str = "job"

/// The component of jobs: the `main` of their bundle.
pub const JOB_COMPONENT: Str = "nanos::job"

/// The hours a job's subtree of `/state` is kept after its end when its specification sets none.
const KEPT_HOURS: u32 = 24

/// What the runner keeps of a job's specification beside the specification of its instance: the specification's encoding, and whether it names the job's moniker, the encoding of its entry's input, the branch its writes commit to, the hours its subtree of `/state` is kept after its end, and its deadline.
pub closed struct JobOrder {
    pub record: mem::Bytes
    pub named: bool
    pub input: mem::Bytes
    pub branch: text::String
    pub keep_h: u32
    pub deadline_s: Option[u32]
} JobOrder

/// What the runner keeps of the job beside the specification of its instance.
fn JobSpec.order(self, alloc: mem::Alloc) -> JobOrder {
    var record = mem::Bytes.empty(alloc)
    mem::wire::Codec[JobSpec].encode(self, out: mut record)
    var input = mem::Bytes.empty(alloc)
    mut input.append(self.input.view())
    return JobOrder(record: take record, named: self.moniker.is_some(), input: take input, branch: text::String.of(self.target(), alloc), keep_h: self.keep_h.value_or(KEPT_HOURS), deadline_s: self.deadline_s)
} JobSpec.order

/// The specification of the instance running the job, acting for `principal`: of component `nanos::job`, volatile, never lazy and started, with the job's bundle, wiring, grants, budget, share, placement, handler limits and restarts.
fn JobSpec.instance(take self, take principal: ident::Principal, alloc: mem::Alloc) -> InstanceSpec {
    let JobSpec(moniker: _, bundle: bundle, input: _, args: _, environment: _, stdin: _, wiring: wiring, grants: grants, budget: budget, share: share, placement: placement, handlers: handlers, restart: restart, branch: _, deadline_s: _, keep_h: _) = self
    return InstanceSpec(
        principal: take principal,
        bundle: bundle,
        component: text::String.of(JOB_COMPONENT, alloc),
        wiring: take wiring,
        grants: take grants,
        budget: budget,
        share: share,
        placement: placement,
        durability: Durability(class: DurabilityClass.Volatile, epoch_s: None, max_bytes: 1_048_576),
        restart: restart,
        handlers: handlers,
        lazy: false,
        stopped: false,
    )
} JobSpec.instance

/// The branch the job's writes commit to.
pub proj fn JobSpec.target(self) -> Str {
    return match self.branch {
        Some(branch) => branch.as_str()
        None => "main"
    }
} JobSpec.target
