//! Meters: the capability through which a driver charges the bytes of each transfer it performs to the account of the message that requested it.

/// A capability charging transfers' bytes to accounts.
pub open struct Meter {
} Meter

impl Meter: sys::Kind[Metering, u8]

/// Where the transfers of the capabilities of one root entry go.
struct Metering {
    transfers: task::Sender[Transfer]
} Metering

/// The root entry of the `Meter` capabilities the core mints, revoked when it closes.
pub open linear struct MintedMeter derives Send {
    minter: sys::Minter[Meter, Metering, u8]
} MintedMeter

/// The bytes a transfer moved for the account numbered `account`: read from its device, or written to it when `written`.
pub closed struct Transfer derives Copy, Eq {
    pub account: u32
    pub bytes: u64
    pub written: bool
} Transfer

/// A root entry of meters sending their transfers to `transfers`, which end once it closes.
pub fn MintedMeter.of(take transfers: task::Sender[Transfer], alloc: mem::Alloc) -> MintedMeter {
    return MintedMeter(minter: sys::Minter[Meter, Metering, u8].of(Metering(transfers: take transfers), alloc))
} MintedMeter.of

pub fn MintedMeter.mint(self) -> Meter {
    return self.minter.mint(0)
} MintedMeter.mint

pub fn MintedMeter.close(take self) {
    let MintedMeter(minter: minter) = self
    take minter.close()
} MintedMeter.close

/// Charges `bytes` moved by a transfer, a write when `written`, to the account numbered `account`; whether the core took the charge, which it drops while its queue of transfers is full and once the capability is stale.
pub fn Meter.charge(self, account: u32, bytes: u64, written: bool) -> bool {
    let Some(left) = sys::reach(self, body: fn(state: Metering, record: u8) => state.transfers.offer(Transfer(account: account, bytes: bytes, written: written))) else {
        return false
    }
    return left.is_none()
} Meter.charge
