//! Ports: capabilities sending the calls of one protocol to one instance, within the credit of the port minted for their sender.

/// A port of protocol P.
pub open struct Port[P: sys::Protocol] derives Copy, Send {
    handle: PortHandle
} Port

/// The capability behind every port, whatever its protocol.
pub open struct PortHandle {
} PortHandle

impl PortHandle: sys::Kind[Route, u8]

impl PortHandle: sys::Crossing

/// The operations through which the kernel holding a port carries out the calls of the port an isolated space holds in its place: posting, offering and calling.
const CROSS_POST: u64 = 0

const CROSS_OFFER: u64 = 1

const CROSS_REQUEST: u64 = 2

/// A call through a port of an isolated space: the hash of its protocol and its bytes.
struct Crossed derives Encode {
    hash: sys::ProtocolHash
    bytes: mem::Bytes
} Crossed

/// What the kernel answers for a call it carried out in place of a capability an isolated space holds: the reply's bytes, `Taken` for a one-way call in its instance's intake, `Declined` for an offer the credit left refused, or why the call failed.
pub closed enum Relayed derives Eq, Encode {
    Replied(mem::Bytes)
    Taken
    Declined
    Revoked
    Stopped
    ServerStopped
    Reset
    Unplugged
    Malformed
} Relayed

/// A minted port: the root entry its ports derive from, revoked when it closes.
pub open linear struct MintedPort derives Send {
    minter: sys::Minter[PortHandle, Route, u8]
    root: PortHandle
} MintedPort

/// Whether an instance takes calls: closed while it is stopped, failed, removed or stopping other than to restart.
pub open struct Gate derives Send {
    open: mem::Shared[core::atomic::AtomicU8]
} Gate

/// A call on its way to an instance's handlers, with the header of the work that sent it.
pub closed struct Call {
    pub hash: sys::ProtocolHash
    pub encoded: sys::Encoded
    pub reply: Option[task::Sender[Answer]]
    pub lease: Lease
    pub header: Header
} Call

/// How an instance's runner answers a request: a driver's request pending when its domain ends fails as reset, or as unplugged when its device left.
pub closed enum Answer {
    Replied(sys::Encoded)
    Malformed
    Stopped
    ServerStopped
    Reset
    Unplugged
} Answer

/// The credit a call holds until its runner releases it.
pub open struct Lease derives Send {
    credits: task::Cown[Credits]
    request: bool
} Lease

pub closed enum PortError[E: Send] derives Render {
    Failed(E)
    Revoked
    Stopped
    ServerStopped
    Reset
    Unplugged
    Malformed
    Cancelled(task::Cancelled) from
} PortError

/// The code of a port's failure for a request that did not reach its handler, `call.failed` for one that did and failed.
pub fn PortError.code(self) -> text::Fixed[32] {
    let code = match self {
        PortError.Failed(_) => "call.failed"
        PortError.Revoked => "port.revoked"
        PortError.Stopped => "port.stopped"
        PortError.ServerStopped => "port.server-stopped"
        PortError.Reset => "device.reset"
        PortError.Unplugged => "device.unplugged"
        PortError.Malformed => "port.malformed"
        PortError.Cancelled(_) => "task.cancelled"
    }
    return text::Fixed[32].of(code)
} PortError.code

/// The protocols an instance serves: its own, and the client protocol whose calls its own schema serves, if any.
pub closed struct Protocols derives Copy, Eq {
    pub own: sys::ProtocolHash
    pub serves: Option[sys::ProtocolHash]
} Protocols

/// Where a minted port's calls go: the target's intake, gate and protocols, the operations it may call, every one when `None`, its credit, and the monotonic clock on which its senders' deadlines are read.
struct Route {
    intake: task::Sender[Call]
    gate: Gate
    protocols: Protocols
    operations: Option[mem::Set[text::String]]
    credits: task::Cown[Credits]
    clock: sys::Clock
    alloc: mem::Alloc
} Route

/// The credit a minted port has left, and the senders waiting for some.
struct Credits {
    messages: u16
    calls: u16
    waiting_messages: mem::List[task::Sender[Unit]]
    waiting_calls: mem::List[task::Sender[Unit]]
} Credits

/// What a call through a port needs from its minted port.
struct Reached {
    intake: task::Sender[Call]
    credits: task::Cown[Credits]
    clock: sys::Clock
    alloc: mem::Alloc
} Reached

enum Refusal {
    Unreached
    Revoked
    Stopped
} Refusal

/// A gate, closed.
pub fn Gate.of(alloc: mem::Alloc) -> Gate {
    return Gate(open: mem::Shared.of(core::atomic::AtomicU8.of(0), alloc))
} Gate.of

pub fn Gate.share(self) -> Gate {
    return Gate(open: self.open.share())
} Gate.share

pub fn Gate.set(self, open: bool) {
    if open {
        self.open.contents().store(1)
    } else {
        self.open.contents().store(0)
    }
} Gate.set

pub fn Gate.is_open(self) -> bool {
    return self.open.contents().load() == 1
} Gate.is_open

/// A port minted for one sender: its calls of the operations `operations` names, all when `None`, go to `intake` while `gate` is open, under `credit`, to an instance serving `protocols`, each carrying its sending task's deadline as `clock` reads it.
pub fn MintedPort.of(
    intake: task::Sender[Call],
    gate: Gate,
    protocols: Protocols,
    take operations: Option[mem::Set[text::String]],
    credit: Credit,
    clock: sys::Clock,
    alloc: mem::Alloc,
    ) -> MintedPort {
    let credits = task::Cown.of(Credits(messages: credit.messages, calls: credit.calls, waiting_messages: mem::List.empty(alloc), waiting_calls: mem::List.empty(alloc)), alloc)
    let route = Route(intake: intake.split(), gate: gate.share(), protocols: protocols, operations: take operations, credits: take credits, clock: clock, alloc: alloc)
    let minter = sys::Minter[PortHandle, Route, u8].of(take route, alloc)
    let root = minter.mint(0)
    return MintedPort(minter: take minter, root: root)
} MintedPort.of

pub fn MintedPort.handle(self) -> PortHandle = self.root

/// Revokes every port of this minted port.
pub fn MintedPort.close(take self) {
    let MintedPort(minter: minter, root: _) = self
    take minter.close()
} MintedPort.close

/// The port of protocol P a handle gives, `None` when it is stale or its instance serves neither P nor P's calls; in an isolated space, which reaches no instance, every live handle gives one, and each call through it is refused as revoked when its instance serves neither.
pub fn Port.of(handle: PortHandle) -> Option[Port[P]] {
    let wanted = sys::Wire[P].hash()
    let serves = sys::reach(handle, body: fn(state: Route, record: u8) => state.protocols.own == wanted or state.protocols.serves == Some(wanted))
    let given = match serves {
        Some(served) => served
        None => sys::Handle.of(handle).crosses()
    }
    if not given {
        return None
    }
    return Some(Port[P](handle: handle))
} Port.of

/// Posts the one-way call `call`, waiting for credit, and returns once it is in the instance's intake.
pub fn Port.post(self, take call: sys::Encoded, alloc: mem::Alloc) fails PortError[Never] uses wait {
    try await self.handle.post(sys::Wire[P].hash(), take call, alloc)
} Port.post

/// Posts the one-way call `call` of the protocol of hash `hash` through this handle, waiting for credit, and returns once it is in the instance's intake.
pub fn PortHandle.post(self, hash: sys::ProtocolHash, take call: sys::Encoded, alloc: mem::Alloc) fails PortError[Never] uses wait {
    match self.reach(hash, encoded: call.bytes.view()) {
        Ok(reached) => try await reached.post(hash, take call)
        Err(Refusal.Unreached) => {
            let answer = try await self.relayed(CROSS_POST, hash, take call, alloc)
            try settled(try relayed_of(answer, alloc))
        }
        Err(Refusal.Revoked) => fail PortError.Revoked
        Err(Refusal.Stopped) => fail PortError.Stopped
    }
} PortHandle.post

/// Posts the one-way call `call` of the protocol of hash `hash` through a port this kernel holds, as `post` does; a port an isolated space holds is refused as revoked.
pub fn PortHandle.post_held(self, hash: sys::ProtocolHash, take call: sys::Encoded) fails PortError[Never] uses wait {
    match first self.reach(hash, encoded: call.bytes.view()) {
        Ok(reached) => try await reached.post(hash, take call)
        Err(Refusal.Stopped) => fail PortError.Stopped
        Err(_) => fail PortError.Revoked
    }
} PortHandle.post_held

/// Posts the one-way call `call` when the port has a message's credit left, giving whether it did, once it is in the instance's intake.
pub fn Port.offer(self, take call: sys::Encoded, alloc: mem::Alloc) -> bool fails PortError[Never] uses wait {
    let hash = sys::Wire[P].hash()
    return match self.handle.reach(hash, encoded: call.bytes.view()) {
        Ok(reached) => try await reached.offer(hash, take call)
        Err(Refusal.Unreached) => {
            let answer = try await self.handle.relayed(CROSS_OFFER, hash, take call, alloc)
            let relayed = try relayed_of(answer, alloc)
            if relayed == Relayed.Declined {
                return false
            }
            try settled(relayed)
            return true
        }
        Err(Refusal.Revoked) => fail PortError.Revoked
        Err(Refusal.Stopped) => fail PortError.Stopped
    }
} Port.offer

/// Calls the request `call`, waiting for credit, and gives its reply, which `reply` decodes.
pub fn Port.call[R: Send, E: Send](self, take call: sys::Encoded, reply: sys::Reply[R, E], alloc: mem::Alloc) -> R fails PortError[E] uses wait {
    let encoded = match first attempt await self.handle.request(sys::Wire[P].hash(), take call, alloc) {
        Ok(answered) => answered
        Err(PortError.Cancelled(cancelled)) => fail cancelled
        Err(PortError.Revoked) => fail PortError.Revoked
        Err(PortError.Stopped) => fail PortError.Stopped
        Err(PortError.ServerStopped) => fail PortError.ServerStopped
        Err(PortError.Reset) => fail PortError.Reset
        Err(PortError.Unplugged) => fail PortError.Unplugged
        Err(_) => fail PortError.Malformed
    }
    return match attempt reply.decode(Untrusted.of(encoded.bytes.view()), handles: encoded.handles.view(), alloc) {
        Ok(result) => result
        Err(sys::CallError.Failed(failure)) => fail PortError.Failed(take failure)
        else => fail PortError.Malformed
    }
} Port.call

/// Calls the request `call` of the protocol of hash `hash` through this handle, waiting for credit, and gives the encoding of its reply; a handle whose instance serves no protocol of that hash refuses it as revoked.
pub fn PortHandle.request(self, hash: sys::ProtocolHash, take call: sys::Encoded, alloc: mem::Alloc) -> sys::Encoded fails PortError[Never] uses wait {
    let reached = match self.reach(hash, encoded: call.bytes.view()) {
        Ok(given) => given
        Err(Refusal.Unreached) => return try replied(try await self.relayed(CROSS_REQUEST, hash, take call, alloc), alloc)
        Err(Refusal.Revoked) => fail PortError.Revoked
        Err(Refusal.Stopped) => fail PortError.Stopped
    }
    return try await reached.request(hash, take call, alloc)
} PortHandle.request

/// Calls the request `call` of the protocol of hash `hash` through a port this kernel holds, as `request` does; a port an isolated space holds is refused as revoked.
pub fn PortHandle.request_held(self, hash: sys::ProtocolHash, take call: sys::Encoded, alloc: mem::Alloc) -> sys::Encoded fails PortError[Never] uses wait {
    let reached = match first self.reach(hash, encoded: call.bytes.view()) {
        Ok(given) => given
        Err(Refusal.Stopped) => fail PortError.Stopped
        Err(_) => fail PortError.Revoked
    }
    return try await reached.request(hash, take call, alloc)
} PortHandle.request_held

/// The answer the kernel holding this port gives `call` of the protocol of hash `hash`, which it carries out as the operation `operation` for a port of an isolated space, the capabilities of the call crossing beside its bytes.
fn PortHandle.relayed(
    self,
    operation: u64,
    hash: sys::ProtocolHash,
    take call: sys::Encoded,
    alloc: mem::Alloc,
    ) -> sys::Encoded fails PortError[Never] uses wait {
    let sys::Encoded(bytes: sent, handles: handles) = call
    var args = mem::Bytes.empty(alloc)
    mem::wire::Codec[Crossed].encode(Crossed(hash: hash, bytes: take sent), out: mut args)
    return match first attempt await sys::Handle.of(self).call(operation, args: args.view(), handles: handles.view(), alloc) {
        Ok(given) => given
        Err(sys::CrossError.Cancelled(cancelled)) => fail cancelled
        Err(sys::CrossError.Revoked(_)) => fail PortError.Revoked
        Err(sys::CrossError.Refused) => fail PortError.Malformed
    }
} PortHandle.relayed

/// What the kernel answered for a call it carried out in place of a capability an isolated space holds, as `answer` encodes it.
fn relayed_of(answer: sys::Encoded, alloc: mem::Alloc) -> Relayed fails PortError[Never] {
    return match attempt mem::wire::Codec[Relayed].decode(Untrusted.of(answer.bytes.view()), alloc) {
        Ok(relayed) => relayed
        Err(_) => fail PortError.Malformed
    }
} relayed_of

/// The failure of a one-way call whose answer is `relayed`, nothing when its instance took it.
fn settled(relayed: Relayed) fails PortError[Never] {
    match relayed {
        Relayed.Taken => {
        }
        Relayed.Revoked => fail PortError.Revoked
        Relayed.Stopped => fail PortError.Stopped
        Relayed.ServerStopped => fail PortError.ServerStopped
        Relayed.Reset => fail PortError.Reset
        Relayed.Unplugged => fail PortError.Unplugged
        else => fail PortError.Malformed
    }
} settled

/// The reply the answer `answer` of the kernel carrying out a call in place of a capability an isolated space holds gives, with the capabilities that crossed beside it, or the failure of the call.
pub fn replied(take answer: sys::Encoded, alloc: mem::Alloc) -> sys::Encoded fails PortError[Never] {
    let relayed = try relayed_of(answer, alloc)
    let sys::Encoded(bytes: _, handles: handles) = answer
    return match relayed {
        Relayed.Replied(bytes) => sys::Encoded(bytes: take bytes, handles: take handles)
        Relayed.Revoked => fail PortError.Revoked
        Relayed.Stopped => fail PortError.Stopped
        Relayed.ServerStopped => fail PortError.ServerStopped
        Relayed.Reset => fail PortError.Reset
        Relayed.Unplugged => fail PortError.Unplugged
        else => fail PortError.Malformed
    }
} replied

/// Has nothing to do at once: a port of an isolated space only calls.
pub fn PortHandle.invoke(
    self,
    operation: u64,
    args: Untrusted[Slice[u8]],
    handles: Slice[sys::Handle],
    alloc: mem::Alloc,
    ) -> sys::Encoded fails sys::CrossError limits stack 4_096 {
    fail sys::CrossError.Refused
} PortHandle.invoke

/// Carries out, in place of the port an isolated space holds, the operation `operation` on the call its arguments encode with the capabilities `handles` names: posting it, offering it or calling it, and answers what came of it, with the capabilities of its reply.
pub fn PortHandle.call(
    self,
    operation: u64,
    args: Untrusted[Slice[u8]],
    handles: Slice[sys::Handle],
    alloc: mem::Alloc,
    ) -> sys::Encoded fails sys::CrossError uses wait limits stack 4_096 {
    let Ok(crossed) = attempt mem::wire::Codec[Crossed].decode(args, alloc) else {
        fail sys::CrossError.Refused
    }
    let Crossed(hash: hash, bytes: bytes) = crossed
    var call = sys::Encoded(bytes: take bytes, handles: mem::List.empty(alloc))
    for handle in handles {
        mut call.handles.push(handle)
    }
    let reached = match self.reach(hash, encoded: call.bytes.view()) {
        Ok(given) => given
        Err(Refusal.Unreached) => fail sys::CrossError.Revoked(sys::Revoked.Stale)
        Err(Refusal.Revoked) => return Relayed.Revoked.answer(alloc)
        Err(Refusal.Stopped) => return Relayed.Stopped.answer(alloc)
    }
    let relayed = match operation {
        CROSS_POST => match first attempt await reached.post(hash, take call) {
            Ok(_) => Relayed.Taken
            Err(PortError.Cancelled(cancelled)) => fail cancelled
            Err(failure) => Relayed.of_failure(failure)
        }
        CROSS_OFFER => match first attempt await reached.offer(hash, take call) {
            Ok(true) => Relayed.Taken
            Ok(false) => Relayed.Declined
            Err(PortError.Cancelled(cancelled)) => fail cancelled
            Err(failure) => Relayed.of_failure(failure)
        }
        CROSS_REQUEST => match first attempt await reached.request(hash, take call, alloc) {
            Ok(reply) => return Relayed.answered(take reply, alloc)
            Err(PortError.Cancelled(cancelled)) => fail cancelled
            Err(failure) => Relayed.of_failure(failure)
        }
        else => fail sys::CrossError.Refused
    }
    return take relayed.answer(alloc)
} PortHandle.call

/// This answer, with no capability beside it.
pub fn Relayed.answer(take self, alloc: mem::Alloc) -> sys::Encoded {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[Relayed].encode(self, out: mut bytes)
    return sys::Encoded(bytes: take bytes, handles: mem::List.empty(alloc))
} Relayed.answer

/// The answer of a call whose reply is `reply`, the capabilities of the reply beside it.
pub fn Relayed.answered(take reply: sys::Encoded, alloc: mem::Alloc) -> sys::Encoded {
    let sys::Encoded(bytes: bytes, handles: handles) = reply
    let sys::Encoded(bytes: answer, handles: _) = Relayed.Replied(take bytes).answer(alloc)
    return sys::Encoded(bytes: take answer, handles: take handles)
} Relayed.answered

/// The answer of a call through a port that failed with `failure`.
pub fn Relayed.of_failure(failure: PortError[Never]) -> Relayed {
    return match failure {
        PortError.Revoked => Relayed.Revoked
        PortError.Stopped => Relayed.Stopped
        PortError.ServerStopped => Relayed.ServerStopped
        PortError.Reset => Relayed.Reset
        PortError.Unplugged => Relayed.Unplugged
        else => Relayed.Malformed
    }
} Relayed.of_failure

/// Posts `call` of the protocol of hash `hash` once the port has a message's credit, giving it back when its instance takes it.
fn Reached.post(self, hash: sys::ProtocolHash, take call: sys::Encoded) fails PortError[Never] uses wait {
    let lease = try await Lease.acquire(self.credits, request: false, alloc: self.alloc)
    let header = Header.sent(request: false, capabilities: call.handles.len() > 0, deadline_ns: task::deadline_ns(self.clock))
    match attempt await self.intake.send(Call(hash: hash, encoded: take call, reply: None, lease: take lease, header: header)) {
        Ok(_) => {
        }
        Err(task::SendError.Closed) => fail PortError.Stopped
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
    }
} Reached.post

/// Posts `call` of the protocol of hash `hash` when the port has a message's credit left, giving whether it did.
fn Reached.offer(self, hash: sys::ProtocolHash, take call: sys::Encoded) -> bool fails PortError[Never] uses wait {
    var granted = false
    let credits = self.credits
    await when mut credits {
        granted = mut credits.take_one(request: false)
    }
    if not granted {
        return false
    }
    let header = Header.sent(request: false, capabilities: call.handles.len() > 0, deadline_ns: task::deadline_ns(self.clock))
    return match attempt await self.intake.send(Call(hash: hash, encoded: take call, reply: None, lease: Lease(credits: credits.share(), request: false), header: header)) {
        Ok(_) => true
        Err(task::SendError.Closed) => fail PortError.Stopped
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
    }
} Reached.offer

/// Calls `call` of the protocol of hash `hash` once the port has a call's credit, and gives the encoding of its reply.
fn Reached.request(self, hash: sys::ProtocolHash, take call: sys::Encoded, alloc: mem::Alloc) -> sys::Encoded fails PortError[Never] uses wait {
    let lease = try await Lease.acquire(self.credits, request: true, alloc)
    let task::Channel(sender: answer, receiver: answers) = task::Channel[Answer].bounded(1, alloc)
    let header = Header.sent(request: true, capabilities: call.handles.len() > 0, deadline_ns: task::deadline_ns(self.clock))
    match attempt await self.intake.send(Call(hash: hash, encoded: take call, reply: Some(take answer), lease: take lease, header: header)) {
        Ok(_) => {
        }
        Err(task::SendError.Closed) => fail PortError.Stopped
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
    }
    var receiver = answers
    let Some(answered) = try await mut receiver.receive() else {
        fail PortError.ServerStopped
    }
    return match answered {
        Answer.Replied(encoded) => encoded
        Answer.Malformed => fail PortError.Malformed
        Answer.Stopped => fail PortError.Stopped
        Answer.ServerStopped => fail PortError.ServerStopped
        Answer.Reset => fail PortError.Reset
        Answer.Unplugged => fail PortError.Unplugged
    }
} Reached.request

/// What a call `encoded` of the protocol of hash `hash` through this handle needs: unreached when the handle is stale or held in an isolated space, refused as revoked when its instance serves no protocol of that hash or it lacks the call's operation, or as stopped when the instance takes no calls.
fn PortHandle.reach(self, hash: sys::ProtocolHash, encoded: Slice[u8]) -> Result[Reached, Refusal] {
    let reached = sys::reach(self, body: fn(state: Route, record: u8) -> Result[Reached, Refusal] {
        let served = state.protocols.own == hash or state.protocols.serves == Some(hash)
        if not served or not allows(state.operations, encoded) {
            return Err(Refusal.Revoked)
        }
        if not state.gate.is_open() {
            return Err(Refusal.Stopped)
        }
        return Ok(Reached(intake: state.intake.split(), credits: state.credits.share(), clock: state.clock, alloc: state.alloc))
    })
    let Some(outcome) = reached else {
        return Err(Refusal.Unreached)
    }
    return outcome
} PortHandle.reach

/// Whether `operations` holds the operation whose call `encoded` is, every operation when `None`: a call's encoding is a `mem::wire` variant keyed by its operation's name, after the name's length in one byte.
fn allows(operations: Option[mem::Set[text::String]], encoded: Slice[u8]) -> bool {
    let Some(names) = operations else {
        return true
    }
    if encoded.len() == 0 or encoded[0] >= 0x80 {
        return false
    }
    let Some(parts) = encoded.split_at(1) else {
        return false
    }
    let Some(name) = parts.tail.prefix(usize.widen(encoded[0])) else {
        return false
    }
    for allowed in names {
        if allowed.as_bytes() == name {
            return true
        }
    }
    return false
} allows

/// Waits until the minted port has a message's credit left, or a call's when `request`, and takes it.
fn Lease.acquire(credits: task::Cown[Credits], request: bool, alloc: mem::Alloc) -> Lease fails task::Cancelled uses wait {
    var granted = false
    await when mut credits {
        granted = mut credits.take_one(request)
    }
    if not granted {
        let task::Channel(sender: waiter, receiver: wakes) = task::Channel[Unit].bounded(1, alloc)
        var held = Some(take waiter)
        await when mut credits {
            granted = mut credits.take_one(request)
            if not granted {
                match mut held.extract() {
                    Some(registered) => mut credits.wait(request, waiter: take registered)
                    None => {
                    }
                }
            }
        }
        if not granted {
            var woken = wakes
            discard try await mut woken.receive()
        }
    }
    return Lease(credits: credits.share(), request: request)
} Lease.acquire

/// Gives the credit back to the minted port: to the first sender still waiting for it, else to the port.
/// A lease of no port's credit, for a message the runner itself queues.
pub fn Lease.free(alloc: mem::Alloc) -> Lease {
    let credits = Credits(messages: 0, calls: 0, waiting_messages: mem::List.empty(alloc), waiting_calls: mem::List.empty(alloc))
    return Lease(credits: task::Cown.of(take credits, alloc), request: false)
} Lease.free

pub fn Lease.release(take self) fails task::Cancelled uses wait {
    let Lease(credits: credits, request: request) = self
    loop {
        var next: Option[task::Sender[Unit]] = None
        await when mut credits {
            next = mut credits.hand_over(request)
        }
        let Some(waiter) = next else {
            return
        }
        if (attempt await waiter.send(Unit)).is_ok() {
            return
        }
    }
} Lease.release

fn Credits.take_one(mut self, request: bool) -> bool {
    if request and self.calls > 0 {
        self.calls -= 1
        return true
    }
    if not request and self.messages > 0 {
        self.messages -= 1
        return true
    }
    return false
} Credits.take_one

fn Credits.wait(mut self, request: bool, take waiter: task::Sender[Unit]) {
    if request {
        mut self.waiting_calls.push(take waiter)
    } else {
        mut self.waiting_messages.push(take waiter)
    }
} Credits.wait

/// The first sender waiting for this credit, which takes it, or `None` once the credit has returned to the port.
fn Credits.hand_over(mut self, request: bool) -> Option[task::Sender[Unit]] {
    if request {
        if self.waiting_calls.len() > 0 {
            return Some(mut self.waiting_calls.remove(0))
        }
        self.calls += 1
        return None
    }
    if self.waiting_messages.len() > 0 {
        return Some(mut self.waiting_messages.remove(0))
    }
    self.messages += 1
    return None
} Credits.hand_over

protocol Pinging {
    pub fn ping() limits traceless
} Pinging

test offers_take_the_credit_left_and_refuse_once_it_is_spent for Port.offer {
    let world = testing::world()
    let alloc = world.alloc
    let task::Channel(sender: intake, receiver: calls) = task::Channel[Call].bounded(4, alloc)
    let gate = Gate.of(alloc)
    gate.set(open: true)
    let minted = MintedPort.of(intake, gate: gate.share(), protocols: Protocols(own: sys::Wire[Pinging].hash(), serves: None), operations: None, credit: Credit(messages: 1, calls: 1), clock: world.clock, alloc)
    defer take minted.close()
    let Some(port) = Port[Pinging].of(minted.handle()) else {
        expect false
        return
    }
    var opening = sys::Encoded.empty(alloc)
    sys::Wire[Pinging].ping(mut opening)
    let taken = try await port.offer(call: take opening, alloc)
    var second = sys::Encoded.empty(alloc)
    sys::Wire[Pinging].ping(mut second)
    let refused = try await port.offer(call: take second, alloc)
    expect taken and not refused
    var receiver = calls
    let Some(Call(hash: _, encoded: _, reply: _, lease: lease, header: _)) = try await mut receiver.receive() else {
        expect false
        return
    }
    try await take lease.release()
    var third = sys::Encoded.empty(alloc)
    sys::Wire[Pinging].ping(mut third)
    let again = try await port.offer(call: take third, alloc)
    expect again
} offers_take_the_credit_left_and_refuse_once_it_is_spent

test ports_carry_out_the_calls_of_isolated_spaces_their_kernels_relay for PortHandle.call {
    let world = testing::world()
    let alloc = world.alloc
    let task::Channel(sender: intake, receiver: calls) = task::Channel[Call].bounded(4, alloc)
    let gate = Gate.of(alloc)
    gate.set(open: true)
    let protocols = Protocols(own: sys::Wire[Pinging].hash(), serves: None)
    let minted = MintedPort.of(intake.split(), gate: gate.share(), protocols, operations: None, credit: Credit(messages: 1, calls: 1), clock: world.clock, alloc)
    defer take minted.close()
    let gone = MintedPort.of(intake, gate: gate.share(), protocols, operations: None, credit: Credit(messages: 1, calls: 1), clock: world.clock, alloc)
    let stale = gone.handle()
    take gone.close()
    var ping = sys::Encoded.empty(alloc)
    sys::Wire[Pinging].ping(mut ping)
    let sent = ping.bytes.len()
    var args = mem::Bytes.empty(alloc)
    mem::wire::Codec[Crossed].encode(Crossed(hash: sys::Wire[Pinging].hash(), bytes: take ping.bytes), out: mut args)
    let passed = Array[sys::Handle, 1].filled(sys::Handle.of(world.log))
    let Ok(answer) = attempt await sys::Handle.of(minted.handle()).call(CROSS_POST, args: args.view(), handles: passed.view(), alloc) else {
        expect false
        return
    }
    let Ok(relayed) = attempt mem::wire::Codec[Relayed].decode(Untrusted.of(answer.bytes.view()), alloc) else {
        expect false
        return
    }
    var receiver = calls
    let Some(Call(hash: _, encoded: posted, reply: _, lease: lease, header: _)) = try await mut receiver.receive() else {
        expect false
        return
    }
    try await take lease.release()
    expect relayed == Relayed.Taken and posted.bytes.len() == sent and posted.handles.len() == 1
    let none = mem::List[sys::Handle].empty(alloc)
    let undecodable = attempt await sys::Handle.of(minted.handle()).call(CROSS_REQUEST, args: b"", handles: none.view(), alloc)
    expect undecodable.is_err()
    var late = sys::Encoded.empty(alloc)
    sys::Wire[Pinging].ping(mut late)
    let revoked = match attempt await stale.post(sys::Wire[Pinging].hash(), call: take late, alloc) {
        Err(PortError.Revoked) => true
        else => false
    }
    expect revoked
} ports_carry_out_the_calls_of_isolated_spaces_their_kernels_relay

test replies_of_relayed_calls_keep_their_capabilities for replied {
    let world = testing::world()
    let alloc = world.alloc
    var reply = sys::Encoded.empty(alloc)
    mut reply.bytes.append(b"total")
    mut reply.handles.push(sys::Handle.of(world.log))
    let Ok(back) = attempt replied(Relayed.answered(take reply, alloc), alloc) else {
        expect false
        return
    }
    let refused = match attempt replied(Relayed.Stopped.answer(alloc), alloc) {
        Err(PortError.Stopped) => true
        else => false
    }
    expect back.bytes.view() == b"total" and back.handles.len() == 1 and refused
} replies_of_relayed_calls_keep_their_capabilities
