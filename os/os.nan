//! The records instances and the core share, and the capability kinds through which instances act.

/// What runs as an instance and how: `/sys/instances/<moniker>`.
pub closed struct InstanceSpec derives Render, Encode {
    pub principal: ident::Principal
    pub bundle: ident::HashValue
    pub component: text::String
    pub wiring: mem::Map[text::String, Wire]
    pub grants: mem::Map[text::String, u64]
    pub budget: Budget
    pub share: Share
    pub placement: Placement
    pub durability: Durability
    pub restart: Restart
    pub handlers: Limits
    pub lazy: bool
    pub stopped: bool
} InstanceSpec

/// An instance's memory limit in bytes, and whether a region is set aside for it.
pub closed struct Budget derives Copy, Eq, Render, Encode {
    pub limit: u64 where limit >= 65_536 and limit % 65_536 == 0
    pub reserved: bool
} Budget

pub closed enum CpuClass derives Copy, Eq, Render, Encode {
    Latency
    Normal
    Background
} CpuClass

/// An account's entitlement to CPU time and energy.
pub closed struct Share derives Copy, Eq, Render, Encode {
    pub class: CpuClass
    pub weight: u16 where weight >= 1 and weight <= 10_000
    pub runtime_us: u32
    pub period_us: u32
    pub energy_mj_per_h: u64
    invariant runtime_us <= period_us
    invariant (class != CpuClass.Latency) or (period_us >= 1_000 and period_us <= 1_000_000 and runtime_us >= 50)
} Share

pub closed enum Placement derives Copy, Eq, Render, Encode {
    Auto
    Isolated
} Placement

pub closed enum DurabilityClass derives Copy, Eq, Render, Encode {
    Volatile
    Checkpointed
} DurabilityClass

pub closed struct Durability derives Copy, Eq, Render, Encode {
    pub class: DurabilityClass
    pub epoch_s: Option[u32]
    pub max_bytes: u64
} Durability

pub closed enum RestartPolicy derives Copy, Eq, Render, Encode {
    Permanent
    Transient
    Temporary
} RestartPolicy

/// What follows an instance's end, and the window that bounds its restarts.
pub closed struct Restart derives Copy, Eq, Render, Encode {
    pub policy: RestartPolicy
    pub intensity: u32
    pub period_s: u32
} Restart

/// The bounds of handler calls: a call of `slow_ms` or more is slow, one past `handler_s` is abandoned.
pub closed struct Limits derives Copy, Eq, Render, Encode {
    pub slow_ms: u32
    pub handler_s: u32
} Limits

/// The port an Env field receives.
pub closed struct Wire derives Render, Encode {
    pub target: Target
    pub operations: Option[mem::List[text::String]]
    pub credit: Credit
} Wire

pub closed enum Target derives Render, Encode {
    Instance(ident::Moniker)
    Role(Role)
} Target

/// A device a base instance needs, which a wire may name in place of an instance: the driver or volume view `devices` assigns it.
pub closed enum Role derives Copy, Eq, Ord, Render, Encode {
    Console
    BootVolume
    StoreVolume
    Entropy
    Nic
    Rtc
    Tpm
} Role

/// What one sender may have in flight through one minted port.
pub closed struct Credit derives Copy, Eq, Render, Encode {
    pub messages: u16 where messages >= 1 and messages <= 4_096
    pub calls: u16 where calls >= 1 and calls <= 4_096
} Credit

/// An instance's lifecycle state.
pub closed enum Lifecycle derives Copy, Eq, Render, Encode {
    Stopped
    Starting
    Running
    Hibernated
    Stopping
    Failed
} Lifecycle

/// The specification of an instance of `component` acting for `principal`, every other field at its default.
pub fn InstanceSpec.of(take principal: ident::Principal, bundle: ident::HashValue, component: Str, alloc: mem::Alloc) -> InstanceSpec {
    return InstanceSpec(
        principal: take principal,
        bundle: bundle,
        component: text::String.of(component, alloc),
        wiring: mem::Map.empty(alloc),
        grants: mem::Map.empty(alloc),
        budget: Budget(limit: 16_777_216, reserved: false),
        share: Share(class: CpuClass.Normal, weight: 100, runtime_us: 0, period_us: 0, energy_mj_per_h: 0),
        placement: Placement.Auto,
        durability: Durability(class: DurabilityClass.Volatile, epoch_s: None, max_bytes: 1_048_576),
        restart: Restart(policy: RestartPolicy.Permanent, intensity: 5, period_s: 60),
        handlers: Limits(slow_ms: 50, handler_s: 10),
        lazy: false,
        stopped: false,
    )
} InstanceSpec.of

/// A wire to the instance `moniker` reaching every operation, with the default credit.
pub fn Wire.to(take moniker: ident::Moniker) -> Wire = Wire(target: Target.Instance(take moniker), operations: None, credit: Credit(messages: 64, calls: 64))

/// The message a handler call was handling when its domain was abandoned: `/state/<moniker>/dead/<seq>`.
pub closed struct DeadLetter derives Render, Encode {
    pub seq: u64
    pub incarnation: u64
    pub time: ident::WallTime
    pub header: Array[u8, 24]
    pub sender: Option[ident::Moniker]
    pub operation: text::String
    pub message: Option[mem::Bytes]
    pub kind: text::String
    pub report: text::String
    pub redeliveries: mem::List[Redelivery]
} DeadLetter

/// A redelivery of a dead letter: its cause, and whether it was handled or became another dead letter.
pub closed struct Redelivery derives Render, Encode {
    pub cause: ident::Cause
    pub outcome: Redelivered
} Redelivery

pub closed enum Redelivered derives Copy, Eq, Render, Encode {
    Handled
    Dead(seq: u64)
} Redelivered

/// An instance's encoded state, taken at quiescence: `/state/<moniker>/checkpoint/<number>`.
pub closed struct Checkpoint derives Render, Encode {
    pub number: u64
    pub incarnation: u64
    pub bundle: ident::HashValue
    pub schema: ident::HashValue
    pub time: ident::WallTime
    pub state: mem::Bytes
} Checkpoint
