//! Placement: the space an instance runs in.

/// Where an instance runs: the shared space, the isolated space of a principal and a provenance class, or the isolated space of its own a base instance runs alone in.
pub closed enum Space derives Eq, Render, Encode {
    Shared
    Isolated(principal: ident::Principal, provenance: Provenance)
    Alone(moniker: ident::Moniker)
} Space

/// The space of an instance acting for `principal` under the spec's `placement`, whose bundle is of the provenance class `provenance` and placed in the shared space by admission when `shared`: the shared space only when admission placed the bundle there, the instance acts for `system` or `owner` and its spec does not ask for isolation, else the isolated space of its principal and class.
pub fn Space.of(take principal: ident::Principal, placement: Placement, shared: bool, provenance: Provenance) -> Space {
    let governing = principal.text.as_str() == "system" or principal.text.as_str() == "owner"
    if shared and governing and placement != Placement.Isolated {
        return Space.Shared
    }
    return Space.Isolated(principal: take principal, provenance: provenance)
} Space.of

/// The space's name in `/live`: `shared`, `<principal>/<class>`, or the moniker of the instance alone in it.
pub fn Space.name(self, alloc: mem::Alloc) -> text::String {
    return text::String.of(self.key().as_str(), alloc)
} Space.name

/// The space's whole name, which no other space has.
pub fn Space.key(self) -> text::Fixed[80] {
    var key = text::Fixed[80].empty()
    match self {
        Space.Shared => mut key.append(SHARED_SPACE)
        Space.Isolated(principal: principal, provenance: provenance) => {
            mut key.append(principal.text.as_str())
            mut key.append(class_of(provenance).as_str())
        }
        Space.Alone(moniker: moniker) => mut key.append(moniker.text.as_str())
    }
    return key
} Space.key

/// The space's name cut to 32 bytes, as events carry it.
pub fn Space.label(self) -> text::Fixed[32] {
    var label = text::Fixed[32].empty()
    match self {
        Space.Shared => mut label.append(SHARED_SPACE)
        Space.Isolated(principal: principal, provenance: provenance) => {
            cut_into(mut label, text: principal.text.as_str())
            cut_into(mut label, text: class_of(provenance).as_str())
        }
        Space.Alone(moniker: moniker) => cut_into(mut label, text: moniker.text.as_str())
    }
    return label
} Space.label

const SHARED_SPACE: Str = "shared"

/// The suffix naming a provenance class in a space's name.
fn class_of(provenance: Provenance) -> text::Fixed[16] {
    return text::Fixed[16].of(match provenance {
        Provenance.Vendor => "/vendor"
        Provenance.Reviewed => "/reviewed"
        Provenance.Agent => "/agent"
    })
} class_of

/// Appends to `label` the chars of `text` that fit.
fn cut_into(mut label: text::Fixed[32], text: Str) {
    for c in text {
        if c.utf8_len() > label.room() {
            return
        }
        mut label.push(c)
    }
} cut_into

test instances_run_shared_only_when_admission_their_principal_and_their_spec_allow_it for Space.of {
    let alloc = testing::world().alloc
    let reviewed = Space.of(ident::Principal(text: text::Fixed[64].of("owner")), placement: Placement.Auto, shared: true, provenance: Provenance.Reviewed)
    let asked = Space.of(ident::Principal(text: text::Fixed[64].of("owner")), placement: Placement.Isolated, shared: true, provenance: Provenance.Reviewed)
    let acting = Space.of(ident::Principal(text: text::Fixed[64].of("agent.ops")), placement: Placement.Auto, shared: true, provenance: Provenance.Vendor)
    let unshared = Space.of(ident::Principal(text: text::Fixed[64].of("owner")), placement: Placement.Auto, shared: false, provenance: Provenance.Agent)
    let asked_name = asked.name(alloc)
    let acting_name = acting.name(alloc)
    let unshared_name = unshared.name(alloc)
    let reviewed_name = reviewed.name(alloc)
    expect reviewed == Space.Shared and reviewed_name.as_str() == "shared"
    expect asked_name.as_str() == "owner/reviewed"
    expect acting_name.as_str() == "agent.ops/vendor"
    expect unshared_name.as_str() == "owner/agent"
    let long = Space.of(ident::Principal(text: text::Fixed[64].of("agent.reviewer-of-the-long-running-jobs")), placement: Placement.Auto, shared: true, provenance: Provenance.Agent)
    expect reviewed.label().as_str() == "shared" and unshared.label().as_str() == "owner/agent" and long.label().as_str() == "agent.reviewer-of-the-long-runni"
    let alone = Space.Alone(moniker: ident::Moniker(text: text::Fixed[59].of("keys")))
    let alone_name = alone.name(alloc)
    expect alone_name.as_str() == "keys" and alone.label().as_str() == "keys"
} instances_run_shared_only_when_admission_their_principal_and_their_spec_allow_it

test spaces_sharing_a_label_keep_keys_of_their_own for Space.key {
    let running = Space.Isolated(principal: ident::Principal(text: text::Fixed[64].of("agent.reviewer-of-the-long-running-jobs")), provenance: Provenance.Agent)
    let building = Space.Isolated(principal: ident::Principal(text: text::Fixed[64].of("agent.reviewer-of-the-long-running-builds")), provenance: Provenance.Agent)
    expect running.label() == building.label() and running.key() != building.key()
    expect running.key().as_str() == "agent.reviewer-of-the-long-running-jobs/agent"
} spaces_sharing_a_label_keep_keys_of_their_own
