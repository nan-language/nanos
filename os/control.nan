//! Control: the capability over the instances under a moniker, whose orders the runner carries out.

/// A capability over the instances its grant covers.
pub open struct Control {
} Control

impl Control: sys::Kind[Orders, ControlRights]

/// What a `Control` capability may do: read lifecycles; start, stop and restart instances; and create and delete instances, mint ports to them and assign them roles.
pub layout ControlRights: u8 {
    read: bit 0
    lifecycle: bit 1
    spawn: bit 2
    reserved: rest
} ControlRights

/// The root entry the `Control` capabilities of one grant and instance derive from, revoked when it closes.
pub open linear struct MintedControl derives Send {
    minter: sys::Minter[Control, Orders, ControlRights]
} MintedControl

pub closed enum Action {
    Start
    Stop
    Restart
    Read
    /// Creates the instance from `spec`, with `grants` held by it, each keyed by the Env field it fills and descending from the grant of the `Control` ordering it.
    Create(spec: InstanceSpec, grants: mem::Map[text::String, Grant])
    /// Stops the instance and removes its specification, its grants, the ports minted to it and the roles it holds; a driver's pending requests fail as unplugged when `unplugged`.
    Delete(unplugged: bool)
    /// The instance's lifecycle once it differs from `seen`.
    Changed(seen: Option[Lifecycle])
    /// Mints a port to the instance with the credit `credit`, revoked when the instance is deleted.
    Port(credit: Credit)
    /// Makes the instance the holder of `role`.
    Assign(role: Role)
} Action

/// An order to the runner: what to do with which instance, the grant of the `Control` ordering it, and where its outcome goes.
pub closed struct Order {
    pub action: Action
    pub moniker: ident::Moniker
    pub grant: Option[u64]
    pub done: task::Sender[Result[Outcome, ControlError]]
} Order

/// What an order gives: the instance's lifecycle, a port, or nothing.
pub closed enum Outcome {
    Lifecycle(Lifecycle)
    Port(PortHandle)
    Done
} Outcome

pub closed enum ControlError derives Render {
    Revoked
    Denied
    Missing
    Exists
    Invalid
    Cancelled(task::Cancelled) from
} ControlError

/// Where a minted `Control` sends its orders, the grant it derives from, and the instances it covers: every one when `None`, else those named the prefix or below it.
struct Orders {
    runner: task::Sender[Order]
    grant: Option[u64]
    prefix: Option[ident::Moniker]
} Orders

pub fn ControlRights.of(rights: mem::Set[Right]) -> ControlRights {
    return ControlRights(read: rights.contains(Right.Read), lifecycle: rights.contains(Right.Lifecycle), spawn: rights.contains(Right.Spawn), reserved: 0)
} ControlRights.of

/// A `Control` root entry of the grant `grant`, none for the core's, sending orders to `runner` over the instances `prefix` covers.
pub fn MintedControl.of(runner: task::Sender[Order], grant: Option[u64], take prefix: Option[ident::Moniker], alloc: mem::Alloc) -> MintedControl {
    return MintedControl(minter: sys::Minter[Control, Orders, ControlRights].of(Orders(runner: runner.split(), grant: grant, prefix: take prefix), alloc))
} MintedControl.of

pub fn MintedControl.mint(self, rights: ControlRights) -> Control {
    return self.minter.mint(rights)
} MintedControl.mint

/// Revokes every `Control` of this root entry.
pub fn MintedControl.close(take self) {
    let MintedControl(minter: minter) = self
    take minter.close()
} MintedControl.close

/// Creates the instance `moniker` from its specification, or clears its `stopped`, and gives its lifecycle once it runs, hibernates or fails.
pub fn Control.start(self, take moniker: ident::Moniker, alloc: mem::Alloc) -> Lifecycle fails ControlError uses wait {
    return try await self.lifecycle_after(Action.Start, take moniker, alloc)
} Control.start

/// Stops the instance `moniker` and gives its lifecycle once it has stopped.
pub fn Control.stop(self, take moniker: ident::Moniker, alloc: mem::Alloc) -> Lifecycle fails ControlError uses wait {
    return try await self.lifecycle_after(Action.Stop, take moniker, alloc)
} Control.stop

/// Restarts the instance `moniker` and gives its lifecycle once it runs again or fails.
pub fn Control.restart(self, take moniker: ident::Moniker, alloc: mem::Alloc) -> Lifecycle fails ControlError uses wait {
    return try await self.lifecycle_after(Action.Restart, take moniker, alloc)
} Control.restart

/// The lifecycle of the instance `moniker`.
pub fn Control.lifecycle(self, take moniker: ident::Moniker, alloc: mem::Alloc) -> Lifecycle fails ControlError uses wait {
    return try await self.lifecycle_after(Action.Read, take moniker, alloc)
} Control.lifecycle

/// Creates the instance `moniker` from `spec`, `stopped` until started, with `grants` held by it, each keyed by the Env field it fills; `spec.grants` gains their numbers.
pub fn Control.create(
    self,
    take moniker: ident::Moniker,
    take spec: InstanceSpec,
    take grants: mem::Map[text::String, Grant],
    alloc: mem::Alloc,
    ) fails ControlError uses wait {
    discard try await self.order(Action.Create(spec: take spec, grants: take grants), take moniker, alloc)
} Control.create

/// Stops and removes the instance `moniker`.
pub fn Control.delete(self, take moniker: ident::Moniker, alloc: mem::Alloc) fails ControlError uses wait {
    discard try await self.order(Action.Delete(unplugged: false), take moniker, alloc)
} Control.delete

/// Stops and removes the driver `moniker` of a device that left, its pending requests failing as unplugged.
pub fn Control.unplug(self, take moniker: ident::Moniker, alloc: mem::Alloc) fails ControlError uses wait {
    discard try await self.order(Action.Delete(unplugged: true), take moniker, alloc)
} Control.unplug

/// The lifecycle of the instance `moniker` once it differs from `seen`.
pub fn Control.changed(self, take moniker: ident::Moniker, seen: Option[Lifecycle], alloc: mem::Alloc) -> Lifecycle fails ControlError uses wait {
    return try await self.lifecycle_after(Action.Changed(seen: seen), take moniker, alloc)
} Control.changed

/// The handle of a port to the instance `moniker` with the credit `credit`, stale once the instance is deleted.
pub fn Control.port(self, take moniker: ident::Moniker, credit: Credit, alloc: mem::Alloc) -> PortHandle fails ControlError uses wait {
    let Outcome.Port(handle) = try await self.order(Action.Port(credit: credit), take moniker, alloc) else {
        fail ControlError.Invalid
    }
    return handle
} Control.port

/// Makes the instance `moniker` the holder of `role`.
pub fn Control.assign(self, role: Role, take moniker: ident::Moniker, alloc: mem::Alloc) fails ControlError uses wait {
    discard try await self.order(Action.Assign(role: role), take moniker, alloc)
} Control.assign

fn Control.lifecycle_after(self, take action: Action, take moniker: ident::Moniker, alloc: mem::Alloc) -> Lifecycle fails ControlError uses wait {
    let Outcome.Lifecycle(lifecycle) = try await self.order(take action, take moniker, alloc) else {
        fail ControlError.Invalid
    }
    return lifecycle
} Control.lifecycle_after

fn Control.order(self, take action: Action, take moniker: ident::Moniker, alloc: mem::Alloc) -> Outcome fails ControlError uses wait {
    let reached = sys::reach(self, body: fn(state: Orders, record: ControlRights) -> Option[Ordering] {
        if not (record.permits(action) and covers(state.prefix, moniker)) {
            return None
        }
        return Some(Ordering(runner: state.runner.split(), grant: state.grant))
    })
    let Some(permitted) = reached else {
        fail ControlError.Revoked
    }
    let Some(Ordering(runner: runner, grant: grant)) = permitted else {
        fail ControlError.Denied
    }
    let task::Channel(sender: done, receiver: outcome) = task::Channel[Result[Outcome, ControlError]].bounded(1, alloc)
    match attempt await runner.send(Order(action: take action, moniker: take moniker, grant: grant, done: take done)) {
        Ok(_) => {
        }
        Err(task::SendError.Closed) => fail ControlError.Revoked
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
    }
    var receiver = outcome
    let Some(result) = try await mut receiver.receive() else {
        fail ControlError.Revoked
    }
    return match result {
        Ok(given) => given
        Err(failure) => fail failure
    }
} Control.order

/// What an order through a `Control` needs from its root entry.
struct Ordering {
    runner: task::Sender[Order]
    grant: Option[u64]
} Ordering

fn ControlRights.permits(self, action: Action) -> bool {
    return match action {
        Action.Read or Action.Changed(seen: _) => self.read
        Action.Start or Action.Stop or Action.Restart => self.lifecycle
        else => self.spawn
    }
} ControlRights.permits

fn covers(prefix: Option[ident::Moniker], moniker: ident::Moniker) -> bool {
    let Some(head) = prefix else {
        return true
    }
    return is_under(moniker, prefix: head)
} covers
