//! Headers: what a piece of work carries of its cause, deadline and account, as the header of the message that started it and as the `sys::Header` of each task doing it.

/// The deadline of work that has none.
pub const NO_DEADLINE: u64 = 0xFFFF_FFFF_FFFF_FFFF

/// The bit of a header's cause marking it traced.
const TRACED: u64 = 0x8000_0000_0000_0000

/// The header of a piece of work: its cause, bit 63 set when traced and 0 for the core's own work, its deadline in monotonic nanoseconds, the account its handling is charged to, the slot of the instance or the number of the session that caused it, 0 for the core's own work, the flags of the message carrying it, the slot in the runner's table of the instance doing it, 0 for the core, and, for the handling of a call, the slot of the instance that sent it. Its first 24 bytes are the header of the message carrying it.
pub layout Header: bytes 32 le {
    cause: u64 at 0
    deadline: u64 at 8
    account: u32 at 16
    flags: Flags at 20
    sender: u32 at 24
    caller: u32 at 28
} Header

/// The flags of a message: a request, an encoded payload, capability arguments, a dead letter delivered again.
pub layout Flags: u32 le {
    request: bit 0
    encoded: bit 1
    capabilities: bit 2
    redelivered: bit 3
    reserved: rest
} Flags

/// The header of the work the running task does: the one its runner gave it, else the core's.
pub fn Header.current() -> Header {
    return match sys::current_header() {
        Some(given) => Header.from_bits(given.bytes)
        None => Header.of_work(cause: 0, slot: 0)
    }
} Header.current

/// The header of work of the cause `cause`, as a header holds it, done by the instance of slot `slot` and charged to its account, with no deadline.
pub fn Header.of_work(cause: u64, slot: u32) -> Header {
    return Header(cause: cause, deadline: NO_DEADLINE, account: slot, flags: Flags.from_bits(0), sender: slot, caller: 0)
} Header.of_work

/// This work charged to the account `account`.
pub fn Header.charged_to(self, account: u32) -> Header {
    var header = self
    header.account = account
    return header
} Header.charged_to

/// The header of a call the running task sends: its work's, flagged a request when `request` and holding capability arguments when `capabilities`.
pub fn Header.sent(request: bool, capabilities: bool) -> Header {
    var header = Header.current()
    header.flags = Flags(request: request, encoded: true, capabilities: capabilities, redelivered: false, reserved: 0)
    return header
} Header.sent

/// The header of a dead letter of the cause `cause`, as a header holds it, that the runner delivers again: an encoded one-way message flagged redelivered, from the core.
pub fn Header.redelivered(cause: u64) -> Header {
    var header = Header.of_work(cause, slot: 0)
    header.flags = Flags(request: false, encoded: true, capabilities: false, redelivered: true, reserved: 0)
    return header
} Header.redelivered

/// The header of the work handling a message of this header in the instance of slot `slot`, naming its sender as the caller.
pub fn Header.handled_by(self, slot: u32) -> Header {
    return Header(cause: self.cause, deadline: self.deadline, account: self.account, flags: Flags.from_bits(0), sender: slot, caller: self.sender)
} Header.handled_by

/// The `sys::Header` a task doing this work carries.
pub fn Header.carried(self) -> sys::Header = sys::Header(bytes: self.to_bits())

/// Whether the work's cause is traced.
pub fn Header.traced(self) -> bool = (self.cause & TRACED) != 0

/// The work's cause without its traced bit.
pub fn Header.named_cause(self) -> ident::Cause = ident::Cause(bits: self.cause & (TRACED - 1))

/// The cause opened under this header's cause: `cause`, traced when this header's is.
pub fn Header.child(self, cause: ident::Cause) -> u64 = cause.bits | (self.cause & TRACED)

test calls_carry_the_work_of_their_task for Header.sent {
    let work = Header.of_work(cause: ident::Cause.of(3, number: 9).bits | TRACED, slot: 4)
    let sent = try await sys::run_headed(work.carried(), body: fn() -> Header {
        return Header.sent(request: true, capabilities: false)
    })
    expect sent.cause == work.cause and sent.sender == 4 and sent.deadline == NO_DEADLINE
    expect sent.flags.request and sent.flags.encoded and not sent.flags.capabilities
    expect Header.current().cause == 0 and Header.current().sender == 0
    let handled = sent.handled_by(7)
    expect handled.traced() and handled.sender == 7 and handled.caller == 4 and not handled.flags.request
    expect handled.child(ident::Cause.of(3, number: 10)) == (ident::Cause.of(3, number: 10).bits | TRACED)
    expect handled.named_cause() == ident::Cause.of(3, number: 9)
} calls_carry_the_work_of_their_task
