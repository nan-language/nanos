//! What the crossing kinds of NaN OS whose operations pass no capability share: their answers, and their calls from an isolated space.

/// The answer of an operation of a crossing kind that gives bytes alone.
pub fn bare_answer(take bytes: mem::Bytes, alloc: mem::Alloc) -> sys::Encoded {
    return sys::Encoded(bytes: take bytes, handles: mem::List.empty(alloc))
} bare_answer

/// The bytes the kernel holding the capability of `handle` answers its waiting operation `operation` on `args` with, passing no capability; an answer carrying capabilities is refused.
pub fn called_bare(handle: sys::Handle, operation: u64, args: Slice[u8], alloc: mem::Alloc) -> mem::Bytes fails sys::CrossError uses wait {
    let none = mem::List[sys::Handle].empty(alloc)
    let sys::Encoded(bytes: bytes, handles: handles) = try await handle.call(operation, args, handles: none.view(), alloc)
    if handles.len() > 0 {
        fail sys::CrossError.Refused
    }
    return bytes
} called_bare

/// The bytes the kernel holding the capability of `handle` answers its operation `operation` on `args` with at once, passing no capability; an answer carrying capabilities is refused.
pub fn invoked_bare(handle: sys::Handle, operation: u64, args: Slice[u8], alloc: mem::Alloc) -> mem::Bytes fails sys::CrossError {
    let none = mem::List[sys::Handle].empty(alloc)
    let sys::Encoded(bytes: bytes, handles: handles) = try handle.invoke(operation, args, handles: none.view(), alloc)
    if handles.len() > 0 {
        fail sys::CrossError.Refused
    }
    return bytes
} invoked_bare
