//! Accounts: the capability through which `link` has the core open and close the account and the cell that the work of each session runs on.

/// A capability opening, finding and closing the accounts of sessions.
pub open struct Accounts {
} Accounts

impl Accounts: sys::Kind[Opening, u8]

/// Where the orders of the capabilities of one root entry go.
struct Opening {
    orders: task::Sender[AccountOrder]
} Opening

/// The root entry of the `Accounts` capabilities the core mints, revoked when it closes.
pub open linear struct MintedAccounts derives Send {
    minter: sys::Minter[Accounts, Opening, u8]
} MintedAccounts

/// What the work of a session runs on: the executor of its account and the allocator of its cell.
pub closed struct SessionAccount derives Copy {
    pub exec: task::Executor
    pub alloc: mem::Alloc
} SessionAccount

/// What the core does with the account of the session numbered `session`: open it for `principal` with the share `share`, the principal's sessions drawing through one cell of `memory_bytes`, the size of its pool when `None`; give it, `None` when it is not open; or close it; or close the account of every session.
pub closed enum AccountOrder {
    Open(session: u64, principal: ident::Principal, share: Share, memory_bytes: Option[u64], done: task::Sender[Option[SessionAccount]])
    Find(session: u64, done: task::Sender[Option[SessionAccount]])
    Close(session: u64, done: task::Sender[Unit])
    Reset(done: task::Sender[Unit])
} AccountOrder

/// A root entry of accounts capabilities sending their orders to `orders`.
pub fn MintedAccounts.of(orders: task::Sender[AccountOrder], alloc: mem::Alloc) -> MintedAccounts {
    return MintedAccounts(minter: sys::Minter[Accounts, Opening, u8].of(Opening(orders: orders.split()), alloc))
} MintedAccounts.of

pub fn MintedAccounts.mint(self) -> Accounts {
    return self.minter.mint(0)
} MintedAccounts.mint

pub fn MintedAccounts.close(take self) {
    let MintedAccounts(minter: minter) = self
    take minter.close()
} MintedAccounts.close

/// Opens the account of the session numbered `session` of `principal` with the share `share`, the principal's sessions drawing through one cell of `memory_bytes`, the size of its pool when `None`; `None` when the core opens none, every pool being at its top pressure level, or once the capability is stale.
pub fn Accounts.open(
    self,
    session: u64,
    take principal: ident::Principal,
    share: Share,
    memory_bytes: Option[u64],
    alloc: mem::Alloc,
    ) -> Option[SessionAccount] fails task::Cancelled uses wait {
    let task::Channel(sender: done, receiver: outcome) = task::Channel[Option[SessionAccount]].bounded(1, alloc)
    if not try await self.order(AccountOrder.Open(session: session, principal: take principal, share: share, memory_bytes: memory_bytes, done: take done)) {
        return None
    }
    var receiver = outcome
    let received = try await mut receiver.receive()
    return received.value_or(None)
} Accounts.open

/// The account of the session numbered `session`, `None` when it is not open.
pub fn Accounts.find(self, session: u64, alloc: mem::Alloc) -> Option[SessionAccount] fails task::Cancelled uses wait {
    let task::Channel(sender: done, receiver: outcome) = task::Channel[Option[SessionAccount]].bounded(1, alloc)
    if not try await self.order(AccountOrder.Find(session: session, done: take done)) {
        return None
    }
    var receiver = outcome
    let received = try await mut receiver.receive()
    return received.value_or(None)
} Accounts.find

/// Closes the account of the session numbered `session`: no task starts on it any more, and its cell gives no more memory.
pub fn Accounts.close(self, session: u64, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let task::Channel(sender: done, receiver: outcome) = task::Channel[Unit].bounded(1, alloc)
    if not try await self.order(AccountOrder.Close(session: session, done: take done)) {
        return
    }
    var receiver = outcome
    discard try await mut receiver.receive()
} Accounts.close

/// Closes the account of every session.
pub fn Accounts.reset(self, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let task::Channel(sender: done, receiver: outcome) = task::Channel[Unit].bounded(1, alloc)
    if not try await self.order(AccountOrder.Reset(done: take done)) {
        return
    }
    var receiver = outcome
    discard try await mut receiver.receive()
} Accounts.reset

/// Sends `order` to the core; whether it took it.
fn Accounts.order(self, take order: AccountOrder) -> bool fails task::Cancelled uses wait {
    let Some(orders) = sys::reach(self, body: fn(state: Opening, record: u8) => state.orders.split()) else {
        return false
    }
    return match attempt await orders.send(take order) {
        Ok(_) => true
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        Err(task::SendError.Closed) => false
    }
} Accounts.order
