//! Grants: records conferring authority on a holder, from which the core mints capabilities.

/// A grant at `/sys/grants/g<n>`.
pub closed struct Grant derives Encode {
    pub holder: ident::Principal
    pub object: Object
    pub rights: mem::Set[Right]
    pub caveats: Caveats
    pub parent: Option[u64]
    pub granted_by: ident::CommitId
} Grant

pub closed struct Caveats derives Encode {
    pub budget: Option[u64]
    pub expires_utc_ns: Option[i64]
    pub ask: bool
} Caveats

/// What a grant reaches.
pub closed enum Object derives Encode {
    Machine
    Tree(prefix: ident::Path, branch: text::String)
    Instance(prefix: ident::Moniker)
    Port(prefix: ident::Moniker, operations: mem::Set[text::String])
    Clock
    Random
    Device(path: text::String)
} Object

pub closed enum Right derives Copy, Eq, Ord, Encode {
    Read
    Write
    Admin
    SecretRead
    Lifecycle
    Update
    Spawn
    Parallel
    Fine
    Enroll
} Right

/// Caveats that bound nothing.
pub fn Caveats.none() -> Caveats = Caveats(budget: None, expires_utc_ns: None, ask: false)

/// Whether the grant reaches the instance `moniker`: a `Machine` grant, or an `Instance` or `Port` grant whose prefix names it or a supervisor of it.
pub fn Grant.covers(self, moniker: ident::Moniker) -> bool {
    return match self.object {
        Object.Machine => true
        Object.Instance(prefix: prefix) => is_under(moniker, prefix)
        Object.Port(prefix: prefix, operations: _) => is_under(moniker, prefix)
        Object.Tree(prefix: _, branch: _) or Object.Clock or Object.Random or Object.Device(path: _) => false
    }
} Grant.covers

/// The operations the grant's ports may send to the instances it covers, every operation when `None`.
pub fn Grant.operations(self, alloc: mem::Alloc) -> Option[mem::Set[text::String]] {
    let Object.Port(prefix: _, operations: operations) = self.object else {
        return None
    }
    if operations.len() == 0 {
        return None
    }
    var copied = mem::Set[text::String].empty(alloc)
    for operation in operations {
        discard mut copied.insert(text::String.of(operation.as_str(), alloc))
    }
    return Some(take copied)
} Grant.operations

/// Whether `moniker` is `prefix` or a moniker below it.
pub fn is_under(moniker: ident::Moniker, prefix: ident::Moniker) -> bool {
    let name = moniker.text.as_bytes()
    let head = prefix.text.as_bytes()
    let Some(start) = name.prefix(head.len()) else {
        return false
    }
    return start == head and (name.len() == head.len() or name[head.len()] == b'.')
} is_under

fn named(text: Str) -> ident::Moniker {
    return ident::Moniker(text: text::Fixed[59].of(text))
} named

test prefixes_cover_their_descendants for is_under {
    expect is_under(named("app"), prefix: named("app"))
    expect is_under(named("app.mail"), prefix: named("app"))
    expect not is_under(named("apps"), prefix: named("app"))
    expect not is_under(named("app"), prefix: named("app.mail"))
} prefixes_cover_their_descendants
