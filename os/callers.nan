//! Callers: the capability naming the instance that sent a call by the slot its handler's header gives.

/// A capability naming instances by their slots in the runner's table.
pub open struct Callers {
} Callers

impl Callers: sys::Kind[Names, u8]

/// The monikers the core noted for the slots of the runner's table.
struct Names {
    monikers: task::Cown[mem::Map[u32, ident::Moniker]]
} Names

/// The root entry of the callers capabilities the core mints, revoked when it closes.
pub open linear struct MintedCallers derives Send {
    minter: sys::Minter[Callers, Names, u8]
} MintedCallers

pub fn MintedCallers.of(take monikers: task::Cown[mem::Map[u32, ident::Moniker]], alloc: mem::Alloc) -> MintedCallers {
    return MintedCallers(minter: sys::Minter[Callers, Names, u8].of(Names(monikers: take monikers), alloc))
} MintedCallers.of

pub fn MintedCallers.mint(self) -> Callers {
    return self.minter.mint(0)
} MintedCallers.mint

pub fn MintedCallers.close(take self) {
    let MintedCallers(minter: minter) = self
    take minter.close()
} MintedCallers.close

/// The moniker of the instance of slot `slot`, `None` for the core's slot 0, for a slot naming none and once the capability is stale.
pub fn Callers.moniker_of(self, slot: u32) -> Option[ident::Moniker] fails task::Cancelled uses wait {
    if slot == 0 {
        return None
    }
    let Some(monikers) = sys::reach(self, body: fn(state: Names, record: u8) => state.monikers.share()) else {
        return None
    }
    var found: Option[ident::Moniker] = None
    await when monikers {
        match monikers.get(slot) {
            Some(moniker) => {
                found = Some(ident::Moniker(text: moniker.text))
            }
            None => {
            }
        }
    }
    return found
} Callers.moniker_of

test callers_name_the_instances_of_their_slots for Callers.moniker_of {
    let alloc = testing::world().alloc
    var monikers = mem::Map[u32, ident::Moniker].empty(alloc)
    discard mut monikers.insert(3, value: ident::Moniker(text: text::Fixed[59].of("app.feeds")))
    let minted = MintedCallers.of(task::Cown.of(take monikers, alloc), alloc)
    defer take minted.close()
    let callers = minted.mint()
    let feeds = try await callers.moniker_of(3)
    let unnamed = try await callers.moniker_of(4)
    let core = try await callers.moniker_of(0)
    expect feeds == Some(ident::Moniker(text: text::Fixed[59].of("app.feeds"))) and unnamed.is_none() and core.is_none()
} callers_name_the_instances_of_their_slots
