//! The repetition count and adaptive proportion tests of NIST SP 800-90B §4.4 on an entropy source's raw bytes, assessed at one bit of entropy per byte.

/// The repetition count test's cutoff: 1 + ⌈20 ÷ H⌉ for H = 1.
const REPETITION_CUTOFF: u32 = 21

/// The adaptive proportion test's window and cutoff for non-binary samples at H = 1: 1 + the binomial critical value of 512 samples at p = 2^-H for α = 2^-20.
const PROPORTION_WINDOW: u32 = 512

const PROPORTION_CUTOFF: u32 = 311

/// The state of both tests over the bytes seen so far.
pub closed struct SourceTests derives Copy, Eq, Encode {
    pub last: u8
    pub run: u32
    pub anchor: u8
    pub matched: u32
    pub sampled: u32
} SourceTests

pub fn SourceTests.fresh() -> SourceTests = SourceTests(last: 0, run: 0, anchor: 0, matched: 0, sampled: 0)

/// Feeds one byte to both tests, false once either fails.
pub fn SourceTests.sample(mut self, byte: u8) -> bool {
    if self.run > 0 and byte == self.last {
        self.run += 1
    } else {
        self.last = byte
        self.run = 1
    }
    if self.sampled == 0 {
        self.anchor = byte
        self.matched = 1
    } else if byte == self.anchor {
        self.matched += 1
    }
    self.sampled += 1
    if self.sampled == PROPORTION_WINDOW {
        self.sampled = 0
    }
    return self.run < REPETITION_CUTOFF and self.matched < PROPORTION_CUTOFF
} SourceTests.sample

test stuck_sources_fail_the_repetition_count_test for SourceTests.sample {
    var tests = SourceTests.fresh()
    var passed = true
    for _ in 0..<20u32 {
        passed = passed and mut tests.sample(7)
    }
    let twenty_first = mut tests.sample(7)
    expect passed and not twenty_first
} stuck_sources_fail_the_repetition_count_test

test biased_sources_fail_the_adaptive_proportion_test for SourceTests.sample {
    var tests = SourceTests.fresh()
    var failed = false
    for at in 0..<512u32 {
        let byte = match at % 5 {
            4 => 1u8
            else => 0u8
        }
        if not mut tests.sample(byte) {
            failed = true
        }
    }
    var varied = SourceTests.fresh()
    var held = true
    for at in 0..<2_048u32 {
        held = held and mut varied.sample(u8.truncate(at * 37))
    }
    expect failed and held
} biased_sources_fail_the_adaptive_proportion_test
