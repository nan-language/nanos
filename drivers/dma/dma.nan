//! The buffers a device reaches: an internal device's mapped once, when made; an external device's mapped at each submission and unmapped at its completion.

/// Buffers of a device in its DMA space `space`, each reached through `at` and `at_mut` while mapped: from when they are made for an internal device, from each submission to its completion for an external one.
pub open linear struct Buffers[T: AnyBits and Send] derives Send {
    mapped: mem::List[hw::DmaShared[T]]
    unmapped: mem::List[mem::Box[T]]
    space: hw::IoSpace
    external: bool
} Buffers

/// The buffers holding `contents` in `space`, mapped now unless the device is `external`.
pub fn Buffers.of(take contents: mem::List[mem::Box[T]], space: hw::IoSpace, external: bool, alloc: mem::Alloc) -> Buffers[T] {
    var buffers = Buffers(mapped: mem::List[hw::DmaShared[T]].empty(alloc), unmapped: take contents, space: space, external: external)
    mut buffers.map()
    return buffers
} Buffers.of

/// Maps the buffers of an external device for a submission.
pub fn Buffers.submit(mut self) {
    mut self.map()
} Buffers.submit

/// Unmaps the buffers of an external device at the completion of its submission, once the IOMMU no longer translates them.
pub fn Buffers.complete(mut self) {
    if not self.external {
        return
    }
    while self.mapped.len() > 0 {
        let buffer = mut self.mapped.remove(0)
        mut self.unmapped.push(take buffer.into_box())
    }
} Buffers.complete

/// Unmaps the buffers once the device no longer uses them.
pub fn Buffers.release(take self) {
    let Buffers(mapped: mapped, unmapped: _, space: _, external: _) = self
    for buffer in take mapped {
        discard take buffer.into_box()
    }
} Buffers.release

/// The `index`th buffer, mapped.
pub proj fn Buffers.at(self, index: usize) -> hw::DmaShared[T] {
    return self.mapped[index]
} Buffers.at

pub proj fn Buffers.at_mut(mut self, index: usize) -> hw::DmaShared[T] {
    return mut self.mapped.at_mut(index)
} Buffers.at_mut

fn Buffers.map(mut self) {
    while self.unmapped.len() > 0 {
        let contents = mut self.unmapped.remove(0)
        mut self.mapped.push(hw::DmaShared.of(take contents, space: self.space))
    }
} Buffers.map
