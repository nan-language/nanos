//! The base drivers: one module per driver family, each contributing its `drivers` entries.

package drivers {
    language 1
    targets any
    dep devices "../devices"
    dep os "../os"
    dep tpm "../tpm"
    allow confined in ahci, dma, nvme, virtio
    allow device in cmos, crb, uart
    allow validate in ahci, crb, devices, nvme, os, tpm, uart, virtio
} drivers
