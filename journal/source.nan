//! Sources: the capabilities through which an instance emits its events to `journal`, each naming its instance and the principal it acts for.

/// A capability emitting events as one instance.
pub open struct Source {
} Source

impl Source: sys::Kind[Emitting, u8]

impl Source: sys::Crossing

/// The operation through which the kernel holding a source emits for the source an isolated space holds in its place: posting a `Journal` call that carries the source as its one capability.
const CROSS_EMIT: u64 = 0

/// What a source reaches: the port of `journal`, its instance and the principal the instance acts for.
struct Emitting {
    journal: os::PortHandle
    instance: ident::Moniker
    principal: ident::Principal
} Emitting

/// The instance a source names and the principal it acts for.
pub closed struct Emitter {
    pub instance: ident::Moniker
    pub principal: ident::Principal
} Emitter

/// The root entry of the sources of one instance, revoked when it closes.
pub open linear struct MintedSource derives Send {
    minter: sys::Minter[Source, Emitting, u8]
} MintedSource

/// A root entry of sources naming `instance`, which acts for `principal`, emitting through `journal`'s port.
pub fn MintedSource.of(journal: os::PortHandle, take instance: ident::Moniker, take principal: ident::Principal, alloc: mem::Alloc) -> MintedSource {
    return MintedSource(minter: sys::Minter[Source, Emitting, u8].of(Emitting(journal: journal, instance: take instance, principal: take principal), alloc))
} MintedSource.of

pub fn MintedSource.mint(self) -> Source {
    return self.minter.mint(0)
} MintedSource.mint

/// Revokes every source of this root entry.
pub fn MintedSource.close(take self) {
    let MintedSource(minter: minter) = self
    take minter.close()
} MintedSource.close

/// The instance the source names and its principal, `None` once it is stale.
pub fn Source.emitter(self) -> Option[Emitter] {
    return sys::reach(self, body: fn(state: Emitting, record: u8) => Emitter(instance: ident::Moniker(text: state.instance.text), principal: ident::Principal(text: state.principal.text)))
} Source.emitter

/// Emits the event of kind `kind` and severity `severity` whose payload is `payload`, once `journal` has credit for it; nothing once the source is stale or `journal` takes no calls. A source of an isolated space has the kernel holding it emit the event.
pub fn Source.emit[T: Encode](
    self,
    kind: Str,
    severity: Severity,
    payload: T,
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    var call = sys::Encoded.empty(alloc)
    sys::Wire[Journal].emit(mut call, source: self, kind: text::String.of(kind, alloc), severity, payload: payload_of(payload, alloc))
    let Some(handle) = sys::reach(self, body: fn(state: Emitting, record: u8) => state.journal) else {
        var args = mem::Bytes.empty(alloc)
        mem::wire::Codec[mem::Bytes].encode(call.bytes, out: mut args)
        match attempt await sys::Handle.of(self).call(CROSS_EMIT, args: args.view(), alloc) {
            Err(sys::CrossError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
        return
    }
    try await posted(handle, take call, alloc)
} Source.emit

/// Posts `call` to `journal` through its port `handle`; nothing when `journal` takes no calls.
fn posted(handle: os::PortHandle, take call: sys::Encoded, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let Some(port) = os::Port[Journal].of(handle) else {
        return
    }
    match attempt await port.post(take call, alloc) {
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} posted

/// Has nothing to do at once: a source of an isolated space only emits.
pub fn Source.invoke(self, operation: u64, args: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::Bytes fails sys::CrossError limits stack 4_096 {
    fail sys::CrossError.Refused
} Source.invoke

/// Posts to `journal`, in place of the source an isolated space holds, the `Journal` call whose bytes its arguments encode, with this source as the call's capability.
pub fn Source.call(self, operation: u64, args: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::Bytes fails sys::CrossError uses wait limits stack 4_096 {
    let Some(handle) = sys::reach(self, body: fn(state: Emitting, record: u8) => state.journal) else {
        fail sys::CrossError.Revoked(sys::Revoked.Stale)
    }
    if operation != CROSS_EMIT {
        fail sys::CrossError.Refused
    }
    let Ok(bytes) = attempt mem::wire::Codec[mem::Bytes].decode(args, alloc) else {
        fail sys::CrossError.Refused
    }
    var call = sys::Encoded(bytes: take bytes, handles: mem::List.empty(alloc))
    mut call.handles.push(sys::Handle.of(self))
    try await posted(handle, take call, alloc)
    return mem::Bytes.empty(alloc)
} Source.call
