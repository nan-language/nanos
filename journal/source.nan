//! Sources: the capabilities through which an instance emits its events to `journal`, each naming its instance and the principal it acts for.

/// A capability emitting events as one instance.
pub open struct Source {
} Source

impl Source: sys::Kind[Emitting, u8]

/// What a source reaches: the port of `journal`, its instance and the principal the instance acts for.
struct Emitting {
    journal: os::PortHandle
    instance: ident::Moniker
    principal: ident::Principal
} Emitting

/// The instance a source names and the principal it acts for.
pub closed struct Emitter {
    pub instance: ident::Moniker
    pub principal: ident::Principal
} Emitter

/// The root entry of the sources of one instance, revoked when it closes.
pub open linear struct MintedSource derives Send {
    minter: sys::Minter[Source, Emitting, u8]
} MintedSource

/// A root entry of sources naming `instance`, which acts for `principal`, emitting through `journal`'s port.
pub fn MintedSource.of(journal: os::PortHandle, take instance: ident::Moniker, take principal: ident::Principal, alloc: mem::Alloc) -> MintedSource {
    return MintedSource(minter: sys::Minter[Source, Emitting, u8].of(Emitting(journal: journal, instance: take instance, principal: take principal), alloc))
} MintedSource.of

pub fn MintedSource.mint(self) -> Source {
    return self.minter.mint(0)
} MintedSource.mint

/// Revokes every source of this root entry.
pub fn MintedSource.close(take self) {
    let MintedSource(minter: minter) = self
    take minter.close()
} MintedSource.close

/// The instance the source names and its principal, `None` once it is stale.
pub fn Source.emitter(self) -> Option[Emitter] {
    return sys::reach(self, body: fn(state: Emitting, record: u8) => Emitter(instance: ident::Moniker(text: state.instance.text), principal: ident::Principal(text: state.principal.text)))
} Source.emitter

/// Emits the event of kind `kind` and severity `severity` whose payload is `payload`, once `journal` has credit for it; nothing once the source is stale or `journal` takes no calls.
pub fn Source.emit[T: Encode](
    self,
    kind: Str,
    severity: Severity,
    payload: T,
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    let Some(handle) = sys::reach(self, body: fn(state: Emitting, record: u8) => state.journal) else {
        return
    }
    let Some(port) = os::Port[Journal].of(handle) else {
        return
    }
    var call = sys::Encoded.empty(alloc)
    sys::Wire[Journal].emit(mut call, source: self, kind: text::String.of(kind, alloc), severity, payload: payload_of(payload, alloc))
    match attempt await port.post(take call) {
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} Source.emit
