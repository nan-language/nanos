//! Logging: the log capability of an instance's world, which offers each record to the core, counting the records the core has no room for.

/// A capability through which an instance's `sys::Log` hands its records to `journal`.
pub open struct Logging {
} Logging

impl Logging: sys::Kind[Logger, u8]

impl Logging: sys::LogService

/// What a log capability reaches: where its records go, the instance it names, the records that found no room since one last did, and the cell its records are drawn from.
struct Logger {
    records: task::Sender[Logged]
    instance: ident::Moniker
    dropped: mem::Shared[core::atomic::AtomicU64]
    alloc: mem::Alloc
} Logger

/// A record the instance `source` logged in work of the cause `cause`, as a header holds it, and how many of its records found no room before it.
pub closed struct Logged {
    pub source: ident::Moniker
    pub level: LogLevel
    pub cause: u64
    pub message: text::String
    pub value: text::String
    pub lost: u64
} Logged

/// The root entry of the log capabilities of one instance, revoked when it closes.
pub open linear struct MintedLogging derives Send {
    minter: sys::Minter[Logging, Logger, u8]
} MintedLogging

/// A root entry of log capabilities naming `instance`, handing their records to `records` from `alloc`.
pub fn MintedLogging.of(records: task::Sender[Logged], take instance: ident::Moniker, alloc: mem::Alloc) -> MintedLogging {
    let logger = Logger(records: records.split(), instance: take instance, dropped: mem::Shared.of(core::atomic::AtomicU64.of(0), alloc), alloc: alloc)
    return MintedLogging(minter: sys::Minter[Logging, Logger, u8].of(take logger, alloc))
} MintedLogging.of

pub fn MintedLogging.mint(self) -> Logging {
    return self.minter.mint(0)
} MintedLogging.mint

/// Revokes every log capability of this root entry.
pub fn MintedLogging.close(take self) {
    let MintedLogging(minter: minter) = self
    take minter.close()
} MintedLogging.close

/// Hands the record to the core, or counts it lost when the core has no room for it; nothing once the capability is stale.
pub fn Logging.log(self, level: sys::LogLevel, message: Str, value: Str) limits stack 4_096 {
    let Some(logger) = sys::reach(self, body: fn(state: Logger, record: u8) => state.share()) else {
        return
    }
    let alloc = logger.alloc
    let lost = logger.dropped.contents().swap(0)
    match logger.records.offer(Logged(source: ident::Moniker(text: logger.instance.text), level: LogLevel.of(level), cause: os::Header.current().cause, message: text::String.of(message, alloc), value: text::String.of(value, alloc), lost: lost)) {
        Some(_) => {
            discard logger.dropped.contents().fetch_add(lost.saturating_add(1))
        }
        None => {
        }
    }
} Logging.log

fn Logger.share(self) -> Logger {
    return Logger(records: self.records.split(), instance: ident::Moniker(text: self.instance.text), dropped: self.dropped.share(), alloc: self.alloc)
} Logger.share

/// The entry of `/journal/log` of the logged record, under the origin label `principal.inst.<source>`, of the cause `system` when it was logged in the core's own work.
pub fn Logged.entry(take self, system: ident::Cause) -> LogRecord {
    let Logged(source: source, level: level, cause: cause, message: message, value: value, lost: _) = self
    var label = text::Fixed[260].of("principal.inst.")
    mut label.append(source.text.as_str())
    return LogRecord(source: take source, level: level, cause: cause_of(cause, system), message: take message, value: take value, origin: ident::OriginLabel(text: label))
} Logged.entry

/// The level a `sys::Log` record has.
pub fn LogLevel.of(level: sys::LogLevel) -> LogLevel {
    return match level {
        sys::LogLevel.Info => LogLevel.Info
        sys::LogLevel.Warn => LogLevel.Warn
        sys::LogLevel.Error => LogLevel.Error
    }
} LogLevel.of

test logs_reach_the_core_and_count_what_finds_no_room for Logging.log {
    let alloc = testing::world().alloc
    let task::Channel(sender: records, receiver: received) = task::Channel[Logged].bounded(1, alloc)
    let minted = MintedLogging.of(records, instance: ident::Moniker(text: text::Fixed[59].of("fat")), alloc)
    defer take minted.close()
    let Ok(log) = attempt sys::Log.served(minted.mint()) else {
        expect false
        return
    }
    log.warn("slow", value: 12u32)
    log.info("dropped", value: 0u32)
    var receiver = received
    let Some(earlier) = try await mut receiver.receive() else {
        expect false
        return
    }
    let working = ident::Cause.of(boot: 1, number: 5)
    try await sys::run_headed(os::Header.of_work(cause: working.bits, slot: 3).carried(), body: fn() {
        log.error("after", value: 0u32)
    })
    let Some(later) = try await mut receiver.receive() else {
        expect false
        return
    }
    expect earlier.message.as_str() == "slow" and earlier.value.as_str() == "12" and earlier.level == LogLevel.Warn and earlier.lost == 0 and earlier.source.text.as_str() == "fat"
    expect later.message.as_str() == "after" and later.level == LogLevel.Error and later.lost == 1
    let system = ident::Cause.of(boot: 1, number: 1)
    let entry = take earlier.entry(system)
    let caused = take later.entry(system)
    expect entry.origin.text.as_str() == "principal.inst.fat" and entry.cause == system and caused.cause == working
} logs_reach_the_core_and_count_what_finds_no_room
