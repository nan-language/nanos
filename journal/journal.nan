//! The journal: events and the kernel image's kind table, the records of the streams of `/journal`, and the `journal` instance appending to them.

/// How grave an event is, from detail to a breach of integrity or security.
pub closed enum Severity derives Copy, Eq, Ord, Render, Encode {
    Debug
    Info
    Notice
    Warn
    Error
    Critical
} Severity

/// The `mem::wire` encoding of an event kind's payload record, with its schema hash.
pub closed struct Payload derives Render, Encode {
    pub schema: ident::HashValue
    pub bytes: mem::Bytes
} Payload

/// An entry of `/journal/events`: when it happened in monotonic time, the instance that emitted it or that a core event concerns, its kind, severity, cause and the cause's principal, and its payload.
pub closed struct Event derives Render, Encode {
    pub time_ns: u64
    pub source: ident::Moniker
    pub kind: text::String
    pub severity: Severity
    pub cause: ident::Cause
    pub principal: ident::Principal
    pub payload: Payload
} Event

pub closed enum LogLevel derives Copy, Eq, Render, Encode {
    Info
    Warn
    Error
} LogLevel

/// An entry of `/journal/log`: a record an instance's `sys::Log` wrote, its value rendered, and the origin label the link renders its texts under.
pub closed struct LogRecord derives Render, Encode {
    pub source: ident::Moniker
    pub level: LogLevel
    pub cause: ident::Cause
    pub message: text::String
    pub value: text::String
    pub origin: ident::OriginLabel
} LogRecord

/// An entry of `/journal/faults`, `f<n>`: the instance and incarnation that trapped or faulted, the trap kind, its report, the dead letter it left and its cause.
pub closed struct FaultRecord derives Render, Encode {
    pub moniker: ident::Moniker
    pub incarnation: u64
    pub kind: text::String
    pub report: text::String
    pub dead_letter: Option[u64]
    pub cause: ident::Cause
} FaultRecord

/// What opened a cause.
pub closed enum CauseKind derives Copy, Eq, Render, Encode {
    Request
    Schedule
    Start
    Connection
    System
} CauseKind

/// An entry of `/journal/traces` for a cause the core opened: the cause, what opened it, its parent, the session and principal it acts for, its subject, and when it opened.
pub closed struct CauseRecord derives Render, Encode {
    pub cause: ident::Cause
    pub kind: CauseKind
    pub parent: Option[ident::Cause]
    pub session: Option[ident::SessionId]
    pub principal: ident::Principal
    pub subject: text::String
    pub time: ident::WallTime
} CauseRecord

/// A session traced until it expires.
pub closed struct TracedSession derives Copy, Eq, Render, Encode {
    pub session: ident::SessionId
    pub expires: ident::WallTime
} TracedSession

/// An instance whose handler calls are traced until it expires.
pub closed struct TracedInstance derives Eq, Render, Encode {
    pub moniker: ident::Moniker
    pub expires: ident::WallTime
} TracedInstance

/// The configuration of `journal`, `/sys/config/journal`: whether `debug` events are committed, how long each stream keeps its entries, the share of the store's capacity `/journal` holds, the tracing of causes, sessions and instances, the bound of a flight recording and the delay of an audit anchor.
pub closed struct JournalConfig derives Eq, Render, Encode {
    pub keep_debug: bool
    pub events_h: u32
    pub log_h: u32
    pub traces_h: u32
    pub faults_h: u32
    pub audit_h: u32
    pub max_pct: u8 where max_pct <= 100
    pub metrics_h: u32
    pub trace_every: u32
    pub trace_sessions: mem::List[TracedSession]
    pub trace_instances: mem::List[TracedInstance]
    pub recording_bytes: u64
    pub anchor_delay_s: u32
} JournalConfig

/// The configuration chapter 17 gives by default.
pub fn JournalConfig.default_of(alloc: mem::Alloc) -> JournalConfig {
    return JournalConfig(
        keep_debug: false,
        events_h: 720,
        log_h: 168,
        traces_h: 168,
        faults_h: 2_160,
        audit_h: 9_600,
        max_pct: 10,
        metrics_h: 2_160,
        trace_every: 100,
        trace_sessions: mem::List.empty(alloc),
        trace_instances: mem::List.empty(alloc),
        recording_bytes: 4_194_304,
        anchor_delay_s: 10,
    )
} JournalConfig.default_of
