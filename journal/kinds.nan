//! The kernel image's kind table: the records of the core rings, the index there of each kind the core and the runner write, and the event each record gives, its payload decoded from the record's argument and continuations.

/// A record of a core ring: when its event happened, its cause, its source's slot in the runner's table, 0 for the core, its kind's index in the kind table, its severity from 0 for `debug`, its flags and the first 8 bytes of its payload.
pub layout RingRecord: bytes 32 le {
    time: u64 at 0
    cause: u64 at 8
    source: u32 at 16
    kind: u16 at 20
    severity: u8 at 22
    flags: u8 at 23
    argument: u64 at 24
} RingRecord

/// The flag of a record that a continuation record follows.
pub const CONTINUED: u8 = 0x01

/// The bits of a record's cause that name it, bit 63 marking it traced.
const CAUSE_BITS: u64 = 0x7FFF_FFFF_FFFF_FFFF

pub const STARTED: u16 = 0

pub const STOPPED: u16 = 1

/// `instance.trapped`, its continuation holding the trap's kind.
pub const TRAPPED: u16 = 2

pub const FAILED: u16 = 3

pub const SLOW_HANDLER: u16 = 4

pub const INTEGRITY: u16 = 5

/// `auth.revoked`, its continuation holding its reason: 0 a revocation, 1 an expiry.
pub const REVOKED: u16 = 6

/// The kinds of device events, in the order of `devices::EventKind`, their continuation holding the device's bus path.
pub const DEVICE_ADDED: u16 = 7

pub const DEVICE_REMOVED: u16 = 8

pub const DEVICE_TABLE_INVALID: u16 = 9

pub const DEVICE_BOUND: u16 = 10

pub const DEVICE_UNBOUND: u16 = 11

pub const DEVICE_CUT_OFF: u16 = 12

pub const DEVICE_FAILED: u16 = 13

pub const DEVICE_SUSPENDED: u16 = 14

pub const DEVICE_RESUMED: u16 = 15

pub const DEVICE_INTERRUPT_STORM: u16 = 16

/// The kinds of the store's events, in the order of `store::Event`.
pub const STORE_MOUNTED: u16 = 17

pub const STORE_CORRUPTION: u16 = 18

pub const STORE_DEVICE_FAILED: u16 = 19

pub const STORE_HISTORY_THINNED: u16 = 20

pub const STORE_WRITES_REFUSED: u16 = 21

/// `instance.checkpoint-failed`, its continuation holding the failure's code.
pub const CHECKPOINT_FAILED: u16 = 22

/// A record of a core ring as the core drained it: the record, its continuations, and the instance its slot names, `supervisor` for the core's.
pub closed struct CoreRecord {
    pub record: RingRecord
    pub more: mem::List[RingRecord]
    pub source: ident::Moniker
} CoreRecord

/// The payload of `instance.started`: the incarnation, and the checkpoint it restored.
pub closed struct InstanceStarted derives Encode {
    pub incarnation: u64
    pub checkpoint: Option[u64]
} InstanceStarted

/// The payload of `instance.stopped`.
pub closed struct InstanceStopped derives Encode {
    pub abandoned: bool
} InstanceStopped

/// The payload of `instance.trapped`: the incarnation and the trap's kind.
pub closed struct InstanceTrapped derives Encode {
    pub incarnation: u64
    pub trap: text::String
} InstanceTrapped

/// The payload of `fault.integrity`.
pub closed struct IntegrityFault derives Encode {
    pub incarnation: u64
} IntegrityFault

/// The payload of `instance.failed`: the restarts in the period.
pub closed struct InstanceFailed derives Encode {
    pub restarts: u32
} InstanceFailed

/// The payload of `instance.slow-handler`: the handler call's duration.
pub closed struct SlowHandler derives Encode {
    pub ns: u64
} SlowHandler

/// The payload of `instance.checkpoint-failed`: the failure's code and the bytes of the encoding.
pub closed struct CheckpointFailed derives Encode {
    pub code: text::String
    pub bytes: u64
} CheckpointFailed

pub closed enum RevokedFor derives Copy, Eq, Encode {
    Revoke
    Expiry
    Principal
} RevokedFor

/// The payload of `auth.revoked`: the grants revoked and why.
pub closed struct GrantsRevoked derives Encode {
    pub grants: mem::List[u64]
    pub reason: RevokedFor
} GrantsRevoked

/// The payload of a device event: the device's bus path and the event's argument.
pub closed struct DeviceEvent derives Encode {
    pub path: text::String
    pub argument: u64
} DeviceEvent

/// The payload of `store.mounted`: the log bytes the mount replayed.
pub closed struct StoreMounted derives Encode {
    pub replayed: u64
} StoreMounted

/// The payload of `store.corruption`: the address of the corrupt structure.
pub closed struct StoreCorruption derives Encode {
    pub address: u64
} StoreCorruption

/// The payload of `store.device-failed`.
pub closed struct StoreDeviceFailed derives Encode {
} StoreDeviceFailed

/// The payload of `store.history-thinned`: the commits thinned.
pub closed struct HistoryThinned derives Encode {
    pub commits: u64
} HistoryThinned

/// The payload of `store.writes-refused`: the free bytes.
pub closed struct WritesRefused derives Encode {
    pub free: u64
} WritesRefused

/// The payload of `journal.lost`: the CPU whose ring dropped events, or the source whose events exceeded its rate, and how many were lost.
pub closed struct Lost derives Encode {
    pub cpu: Option[u32]
    pub source: Option[ident::Moniker]
    pub count: u64
} Lost

/// The name of the kind of index `kind` in the kind table.
pub fn kind_name(kind: u16) -> text::Fixed[32] {
    return text::Fixed[32].of(match kind {
        STARTED => "instance.started"
        STOPPED => "instance.stopped"
        TRAPPED => "instance.trapped"
        FAILED => "instance.failed"
        SLOW_HANDLER => "instance.slow-handler"
        INTEGRITY => "fault.integrity"
        REVOKED => "auth.revoked"
        DEVICE_ADDED => "device.added"
        DEVICE_REMOVED => "device.removed"
        DEVICE_TABLE_INVALID => "device.table-invalid"
        DEVICE_BOUND => "device.bound"
        DEVICE_UNBOUND => "device.unbound"
        DEVICE_CUT_OFF => "device.cut-off"
        DEVICE_FAILED => "device.failed"
        DEVICE_SUSPENDED => "device.suspended"
        DEVICE_RESUMED => "device.resumed"
        DEVICE_INTERRUPT_STORM => "device.interrupt-storm"
        STORE_MOUNTED => "store.mounted"
        STORE_CORRUPTION => "store.corruption"
        STORE_DEVICE_FAILED => "store.device-failed"
        STORE_HISTORY_THINNED => "store.history-thinned"
        STORE_WRITES_REFUSED => "store.writes-refused"
        CHECKPOINT_FAILED => "instance.checkpoint-failed"
        else => "unknown"
    })
} kind_name

/// The severity a record's code gives, from 0 for `debug` up to 5 for `critical`.
pub fn Severity.of_code(code: u8) -> Severity {
    return match code {
        0 => Severity.Debug
        1 => Severity.Info
        2 => Severity.Notice
        3 => Severity.Warn
        4 => Severity.Error
        else => Severity.Critical
    }
} Severity.of_code

/// The severity's name in lower case.
pub fn Severity.name(self) -> text::Fixed[8] {
    return text::Fixed[8].of(match self {
        Severity.Debug => "debug"
        Severity.Info => "info"
        Severity.Notice => "notice"
        Severity.Warn => "warn"
        Severity.Error => "error"
        Severity.Critical => "critical"
    })
} Severity.name

/// Whether the record has a continuation after it.
pub fn RingRecord.continued(self) -> bool = (self.flags & CONTINUED) != 0

/// The event the record gives, of the system cause `system` unless the record names its own, acting for `system`.
pub fn CoreRecord.event(self, system: ident::Cause, alloc: mem::Alloc) -> Event {
    let record = self.record
    var cause = system
    if record.cause != 0 {
        cause = ident::Cause(bits: record.cause & CAUSE_BITS)
    }
    return Event(time_ns: record.time, source: ident::Moniker(text: self.source.text), kind: text::String.of(kind_name(record.kind).as_str(), alloc), severity: Severity.of_code(record.severity), cause: cause, principal: ident::Principal(text: text::Fixed[64].of("system")), payload: self.payload(alloc))
} CoreRecord.event

/// The payload the record's argument and continuations give its kind.
fn CoreRecord.payload(self, alloc: mem::Alloc) -> Payload {
    let kind = self.record.kind
    let argument = self.record.argument
    let more = self.continuation()
    if kind >= DEVICE_ADDED and kind <= DEVICE_INTERRUPT_STORM {
        return payload_of(DeviceEvent(path: text_of(more, alloc), argument: argument), alloc)
    }
    return match kind {
        STARTED => payload_of(InstanceStarted(incarnation: argument, checkpoint: number_of(more)), alloc)
        STOPPED => payload_of(InstanceStopped(abandoned: argument == 1), alloc)
        TRAPPED => payload_of(InstanceTrapped(incarnation: argument, trap: text_of(more, alloc)), alloc)
        INTEGRITY => payload_of(IntegrityFault(incarnation: argument), alloc)
        FAILED => payload_of(InstanceFailed(restarts: u32.saturate(argument)), alloc)
        SLOW_HANDLER => payload_of(SlowHandler(ns: argument), alloc)
        CHECKPOINT_FAILED => payload_of(CheckpointFailed(code: text_of(more, alloc), bytes: argument), alloc)
        REVOKED => payload_of(revocation(argument, more, alloc), alloc)
        STORE_MOUNTED => payload_of(StoreMounted(replayed: argument), alloc)
        STORE_CORRUPTION => payload_of(StoreCorruption(address: argument), alloc)
        STORE_HISTORY_THINNED => payload_of(HistoryThinned(commits: argument), alloc)
        STORE_WRITES_REFUSED => payload_of(WritesRefused(free: argument), alloc)
        else => payload_of(StoreDeviceFailed(), alloc)
    }
} CoreRecord.payload

/// The bytes of the record's first continuation, `None` when it has none.
fn CoreRecord.continuation(self) -> Option[Array[u8, 32]] {
    if not self.record.continued() {
        return None
    }
    return match self.more.get(0) {
        Some(next) => Some(next.to_bits())
        None => None
    }
} CoreRecord.continuation

/// The payload of the revocation of the grant `grant` for the reason its continuation holds.
fn revocation(grant: u64, more: Option[Array[u8, 32]], alloc: mem::Alloc) -> GrantsRevoked {
    var grants = mem::List[u64].empty(alloc)
    mut grants.push(grant)
    let reason = match first more {
        Some(bytes) if bytes[0] == 1 => RevokedFor.Expiry
        else => RevokedFor.Revoke
    }
    return GrantsRevoked(grants: take grants, reason: reason)
} revocation

/// The payload of `value`, with its type's schema hash.
pub fn payload_of[T: Encode](value: T, alloc: mem::Alloc) -> Payload {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[T].encode(value, out: mut bytes)
    return Payload(schema: ident::HashValue(bytes: mem::wire::Codec[T].schema_hash().bytes), bytes: take bytes)
} payload_of

/// The number the first 8 bytes of a continuation hold, least significant first.
fn number_of(more: Option[Array[u8, 32]]) -> Option[u64] {
    let Some(bytes) = more else {
        return None
    }
    var number: u64 = 0
    var at: usize = 8
    while at > 0 {
        at -= 1
        number = (number << 8) | u64.widen(bytes[at])
    }
    return Some(number)
} number_of

/// The text a continuation holds up to its first zero byte, its other bytes than printable ASCII written `?`.
fn text_of(more: Option[Array[u8, 32]], alloc: mem::Alloc) -> text::String {
    var text = text::String.empty(alloc)
    let Some(bytes) = more else {
        return text
    }
    for byte in bytes {
        if byte == 0 {
            break
        }
        if byte < 0x20 or byte > 0x7E {
            mut text.push('?')
        } else {
            mut text.push(char.checked_from_bits(u32.widen(byte)).value_or('?'))
        }
    }
    return text
} text_of

test core_records_give_their_kinds_events for CoreRecord.event {
    let alloc = testing::world().alloc
    var path = Array[u8, 32].filled(0)
    path[0] = b'p'
    path[1] = b'c'
    path[2] = b'i'
    var more = mem::List[RingRecord].empty(alloc)
    mut more.push(RingRecord.from_bits(path))
    let bound = CoreRecord(record: RingRecord(time: 5, cause: 0, source: 0, kind: DEVICE_BOUND, severity: 1, flags: CONTINUED, argument: 3), more: take more, source: ident::Moniker(text: text::Fixed[59].of("supervisor")))
    let system = ident::Cause.of(boot: 2, number: 1)
    let event = bound.event(system, alloc)
    expect event.kind.as_str() == "device.bound" and event.severity == Severity.Info and event.cause == system and event.time_ns == 5
    let Ok(device) = attempt mem::wire::Codec[DeviceEvent].decode(Untrusted.of(event.payload.bytes.view()), alloc) else {
        expect false
        return
    }
    expect device.path.as_str() == "pci" and device.argument == 3
} core_records_give_their_kinds_events
