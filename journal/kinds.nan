//! The kernel image's kind table: the records of the core rings, the index there of each kind the core and the runner write, and the event each record gives, its payload decoded from the record's argument and continuations.

/// A record of a core ring: when its event happened, its cause, its source's slot in the runner's table, 0 for the core, its kind's index in the kind table, its severity from 0 for `debug`, its flags and the first 8 bytes of its payload.
pub layout RingRecord: bytes 32 le {
    time: u64 at 0
    cause: u64 at 8
    source: u32 at 16
    kind: u16 at 20
    severity: u8 at 22
    flags: u8 at 23
    argument: u64 at 24
} RingRecord

/// The flag of a record that a continuation record follows.
pub const CONTINUED: u8 = 0x01

/// The bits of a record's cause that name it, bit 63 marking it traced.
pkg const CAUSE_BITS: u64 = 0x7FFF_FFFF_FFFF_FFFF

pub const STARTED: u16 = 0

pub const STOPPED: u16 = 1

/// `instance.trapped`, its continuation holding the trap's kind.
pub const TRAPPED: u16 = 2

pub const FAILED: u16 = 3

pub const SLOW_HANDLER: u16 = 4

pub const INTEGRITY: u16 = 5

/// `auth.revoked`, its continuation holding its reason: 0 a revocation, 1 an expiry.
pub const REVOKED: u16 = 6

/// The kinds of device events, in the order of `devices::EventKind`, their continuation holding the device's bus path.
pub const DEVICE_ADDED: u16 = 7

pub const DEVICE_REMOVED: u16 = 8

pub const DEVICE_TABLE_INVALID: u16 = 9

pub const DEVICE_BOUND: u16 = 10

pub const DEVICE_UNBOUND: u16 = 11

pub const DEVICE_CUT_OFF: u16 = 12

pub const DEVICE_FAILED: u16 = 13

pub const DEVICE_SUSPENDED: u16 = 14

pub const DEVICE_RESUMED: u16 = 15

pub const DEVICE_INTERRUPT_STORM: u16 = 16

/// The kinds of the store's events, in the order of `store::Event`.
pub const STORE_MOUNTED: u16 = 17

pub const STORE_CORRUPTION: u16 = 18

pub const STORE_DEVICE_FAILED: u16 = 19

pub const STORE_HISTORY_THINNED: u16 = 20

pub const STORE_WRITES_REFUSED: u16 = 21

/// `instance.checkpoint-failed`, its continuation holding the failure's code.
pub const CHECKPOINT_FAILED: u16 = 22

/// `boot.started`, its argument the generation and its continuation holding the handoff record's mode and slot in bytes 0 and 1, its flags in bytes 4 to 7 and the boot counter in bytes 8 to 15.
pub const BOOT_STARTED: u16 = 23

/// `boot.candidate-failed`, its argument the generation and its continuation holding the loader's code.
pub const BOOT_CANDIDATE_FAILED: u16 = 24

/// The byte of an `instance.started` continuation marking a revival.
pub const REVIVAL_MARK: usize = 8

/// `instance.hibernated`, its argument the bytes of the image.
pub const HIBERNATED: u16 = 25

/// `instance.job-ended`, its argument the commit merging the job's branch, 0 for none, and its continuation holding the name of the outcome's kind.
pub const JOB_ENDED: u16 = 26

/// The kinds whose payload fills their argument and two continuations, as `Wide` lays it out.
pub const CODE_LOADED: u16 = 27

pub const CODE_UNLOADED: u16 = 28

pub const UPDATE_STARTED: u16 = 29

pub const UPDATE_PASSED: u16 = 30

pub const UPDATE_REVERTED: u16 = 31

/// The payload bytes of a record of a kind of two continuations: its argument's 8 bytes, least significant first, then the bytes of each continuation.
pub closed struct Wide derives Copy {
    pub bytes: Array[u8, 72]
} Wide

/// A record of a core ring as the core drained it: the record, its continuations, the instance its slot names, `supervisor` for the core's, and for a span the instance that sent the call, `None` for the core.
pub closed struct CoreRecord {
    pub record: RingRecord
    pub more: mem::List[RingRecord]
    pub source: ident::Moniker
    pub sender: Option[ident::Moniker]
} CoreRecord

/// The payload of `instance.started`: the incarnation, and what it started from.
pub closed struct InstanceStarted derives Render, Encode {
    pub incarnation: u64
    pub from: StartedFrom
} InstanceStarted

/// What a start began from: the component's start, the checkpoint `number` it restored, a revival from its hibernation image, or an update from the old code's encoding of its state.
pub closed enum StartedFrom derives Copy, Eq, Render, Encode {
    Start
    Checkpoint(number: u64)
    Revival
    Update
} StartedFrom

/// The payload of `instance.hibernated`: the bytes of its image.
pub closed struct InstanceHibernated derives Render, Encode {
    pub bytes: u64
} InstanceHibernated

/// The payload of `instance.job-ended`: the kind of the job's outcome, and the commit merging its branch.
pub closed struct JobEnded derives Render, Encode {
    pub outcome: text::String
    pub commit: Option[ident::CommitId]
} JobEnded

/// The payload of `code.loaded`: the bundle's code hash, the space it was loaded into and its code bytes.
pub closed struct CodeLoaded derives Render, Encode {
    pub code: ident::HashValue
    pub space: text::String
    pub code_bytes: u64
} CodeLoaded

/// The payload of `code.unloaded`: the bundle's code hash and the space it left.
pub closed struct CodeUnloaded derives Render, Encode {
    pub code: ident::HashValue
    pub space: text::String
} CodeUnloaded

/// How an update moves an instance's state: unchanged, additive over a `flexible` type, or through the new bundle's `migrate`.
pub closed enum MigrationClass derives Copy, Eq, Render, Encode {
    Identical
    Additive
    Migrated
} MigrationClass

/// The payload of `update.started`: the instance, its old and new code hash, and the update's migration class.
pub closed struct UpdateStarted derives Render, Encode {
    pub moniker: ident::Moniker
    pub old: ident::HashValue
    pub new: ident::HashValue
    pub class: MigrationClass
} UpdateStarted

/// What ended a probation without a revert: its bounds, its recording's bound, a stop or a restart.
pub closed enum ProbationEnd derives Copy, Eq, Render, Encode {
    Bounds
    Recording
    Stop
    Restart
} ProbationEnd

/// The payload of `update.passed`: the instance, its code hash, the messages it handled during probation, and what ended it.
pub closed struct UpdatePassed derives Render, Encode {
    pub moniker: ident::Moniker
    pub code: ident::HashValue
    pub messages: u64
    pub ended: ProbationEnd
} UpdatePassed

/// Why an update was reverted: a trap of the new code, a failed health check, a latency regression, the revert of another update of its commit, or the code aborting it.
pub closed enum RevertReason derives Copy, Eq {
    Trapped(kind: sys::TrapKind)
    Unhealthy
    Regression
    Grouped
    DecodeFailed
    ActivationTimeout
    EnvIncomplete
    NoImage
    Malformed
} RevertReason

/// The payload of `update.reverted`: the instance, its old and new code hash, the reason's code, and the recorded inputs the revert replayed and dead-lettered.
pub closed struct UpdateReverted derives Render, Encode {
    pub moniker: ident::Moniker
    pub old: ident::HashValue
    pub new: ident::HashValue
    pub reason: text::String
    pub replayed: u64
    pub dead_lettered: u64
} UpdateReverted

/// The payload of `instance.stopped`.
pub closed struct InstanceStopped derives Render, Encode {
    pub abandoned: bool
} InstanceStopped

/// The payload of `instance.trapped`: the incarnation and the trap's kind.
pub closed struct InstanceTrapped derives Render, Encode {
    pub incarnation: u64
    pub trap: text::String
} InstanceTrapped

/// The payload of `fault.integrity`.
pub closed struct IntegrityFault derives Render, Encode {
    pub incarnation: u64
} IntegrityFault

/// The payload of `instance.failed`: the restarts in the period.
pub closed struct InstanceFailed derives Render, Encode {
    pub restarts: u32
} InstanceFailed

/// The payload of `instance.slow-handler`: the handler call's duration.
pub closed struct SlowHandler derives Render, Encode {
    pub ns: u64
} SlowHandler

/// The payload of `instance.checkpoint-failed`: the failure's code and the bytes of the encoding.
pub closed struct CheckpointFailed derives Render, Encode {
    pub code: text::String
    pub bytes: u64
} CheckpointFailed

pub closed enum RevokedFor derives Copy, Eq, Render, Encode {
    Revoke
    Expiry
    Principal
} RevokedFor

/// The payload of `auth.revoked`: the grants revoked and why.
pub closed struct GrantsRevoked derives Render, Encode {
    pub grants: mem::List[u64]
    pub reason: RevokedFor
} GrantsRevoked

/// The payload of a device event: the device's bus path and the event's argument.
pub closed struct DeviceEvent derives Render, Encode {
    pub path: text::String
    pub argument: u64
} DeviceEvent

/// The payload of `store.mounted`: the log bytes the mount replayed.
pub closed struct StoreMounted derives Render, Encode {
    pub replayed: u64
} StoreMounted

/// The payload of `store.corruption`: the address of the corrupt structure.
pub closed struct StoreCorruption derives Render, Encode {
    pub address: u64
} StoreCorruption

/// The payload of `store.device-failed`.
pub closed struct StoreDeviceFailed derives Render, Encode {
} StoreDeviceFailed

/// The payload of `store.history-thinned`: the commits thinned.
pub closed struct HistoryThinned derives Render, Encode {
    pub commits: u64
} HistoryThinned

/// The payload of `store.writes-refused`: the free bytes.
pub closed struct WritesRefused derives Render, Encode {
    pub free: u64
} WritesRefused

/// The payload of `boot.started`: the mode, the generation, the slot, the boot counter and the flags, as the handoff record gives them.
pub closed struct BootStarted derives Render, Encode {
    pub mode: u8
    pub generation: u64
    pub slot: u8
    pub boot_counter: u64
    pub flags: u32
} BootStarted

/// The payload of `boot.candidate-failed`: the generation and the loader's code.
pub closed struct CandidateFailed derives Render, Encode {
    pub generation: u64
    pub code: text::String
} CandidateFailed

/// The payload of `journal.lost`: the CPU whose ring dropped events, or the source whose events exceeded its rate, and how many were lost.
pub closed struct Lost derives Render, Encode {
    pub cpu: Option[u32]
    pub source: Option[ident::Moniker]
    pub count: u64
} Lost

/// The name of the kind of index `kind` in the kind table.
pub fn kind_name(kind: u16) -> text::Fixed[32] {
    return text::Fixed[32].of(match kind {
        STARTED => "instance.started"
        STOPPED => "instance.stopped"
        TRAPPED => "instance.trapped"
        FAILED => "instance.failed"
        SLOW_HANDLER => "instance.slow-handler"
        INTEGRITY => "fault.integrity"
        REVOKED => "auth.revoked"
        DEVICE_ADDED => "device.added"
        DEVICE_REMOVED => "device.removed"
        DEVICE_TABLE_INVALID => "device.table-invalid"
        DEVICE_BOUND => "device.bound"
        DEVICE_UNBOUND => "device.unbound"
        DEVICE_CUT_OFF => "device.cut-off"
        DEVICE_FAILED => "device.failed"
        DEVICE_SUSPENDED => "device.suspended"
        DEVICE_RESUMED => "device.resumed"
        DEVICE_INTERRUPT_STORM => "device.interrupt-storm"
        STORE_MOUNTED => "store.mounted"
        STORE_CORRUPTION => "store.corruption"
        STORE_DEVICE_FAILED => "store.device-failed"
        STORE_HISTORY_THINNED => "store.history-thinned"
        STORE_WRITES_REFUSED => "store.writes-refused"
        CHECKPOINT_FAILED => "instance.checkpoint-failed"
        BOOT_STARTED => "boot.started"
        BOOT_CANDIDATE_FAILED => "boot.candidate-failed"
        HIBERNATED => "instance.hibernated"
        JOB_ENDED => "instance.job-ended"
        CODE_LOADED => "code.loaded"
        CODE_UNLOADED => "code.unloaded"
        UPDATE_STARTED => "update.started"
        UPDATE_PASSED => "update.passed"
        UPDATE_REVERTED => "update.reverted"
        else => "unknown"
    })
} kind_name

/// The severity a record's code gives, from 0 for `debug` up to 5 for `critical`.
pub fn Severity.of_code(code: u8) -> Severity {
    return match code {
        0 => Severity.Debug
        1 => Severity.Info
        2 => Severity.Notice
        3 => Severity.Warn
        4 => Severity.Error
        else => Severity.Critical
    }
} Severity.of_code

/// The severity's name in lower case.
pub fn Severity.name(self) -> text::Fixed[8] {
    return text::Fixed[8].of(match self {
        Severity.Debug => "debug"
        Severity.Info => "info"
        Severity.Notice => "notice"
        Severity.Warn => "warn"
        Severity.Error => "error"
        Severity.Critical => "critical"
    })
} Severity.name

/// Whether the record has a continuation after it.
pub fn RingRecord.continued(self) -> bool = (self.flags & CONTINUED) != 0

/// The continuations a continued record of kind `kind` has: two for the kinds `Wide` lays out, one otherwise.
pub fn continuations(kind: u16) -> usize {
    if kind >= CODE_LOADED and kind <= UPDATE_REVERTED {
        return 2
    }
    return 1
} continuations

/// The argument the payload's first 8 bytes give.
pub fn Wide.argument(self) -> u64 {
    var argument: u64 = 0
    var at: usize = 8
    while at > 0 {
        at -= 1
        argument = (argument << 8) | u64.widen(self.bytes[at])
    }
    return argument
} Wide.argument

/// The continuation holding the payload's bytes from `8 + 32 * index`.
pub fn Wide.continuation(self, index: usize) -> RingRecord {
    var part = Array[u8, 32].filled(0)
    for at in 0..<32usize {
        part[at] = self.bytes[8 + 32 * index + at]
    }
    return RingRecord.from_bits(part)
} Wide.continuation

/// The payload of `code.loaded` or `code.unloaded` of the bundle `code` in the shared space, of `code_bytes` code bytes: those bytes, the hash, then the space's name.
pub fn Wide.of_code(code: ident::HashValue, code_bytes: u64) -> Wide {
    var wide = Wide(bytes: Array[u8, 72].filled(0))
    mut wide.put_number(at: 0, value: code_bytes)
    mut wide.put_hash(at: 8, hash: code)
    var at: usize = 41
    for byte in SHARED_SPACE.as_bytes() {
        wide.bytes[at] = byte
        at += 1
    }
    return wide
} Wide.of_code

/// The payload of `update.started` from `old` to `new` of migration class `class`: the class in its first byte, then both hashes.
pub fn Wide.of_start(old: ident::HashValue, new: ident::HashValue, class: MigrationClass) -> Wide {
    var wide = Wide(bytes: Array[u8, 72].filled(0))
    wide.bytes[0] = match class {
        MigrationClass.Identical => 0
        MigrationClass.Additive => 1
        MigrationClass.Migrated => 2
    }
    mut wide.put_hash(at: 1, hash: old)
    mut wide.put_hash(at: 34, hash: new)
    return wide
} Wide.of_start

/// The payload of `update.passed` of the bundle `code` after `messages` messages, ended by `ended`: the messages, the hash, then the end.
pub fn Wide.of_pass(code: ident::HashValue, messages: u64, ended: ProbationEnd) -> Wide {
    var wide = Wide(bytes: Array[u8, 72].filled(0))
    mut wide.put_number(at: 0, value: messages)
    mut wide.put_hash(at: 8, hash: code)
    wide.bytes[41] = match ended {
        ProbationEnd.Bounds => 0
        ProbationEnd.Recording => 1
        ProbationEnd.Stop => 2
        ProbationEnd.Restart => 3
    }
    return wide
} Wide.of_pass

/// The payload of `update.reverted` from `new` back to `old` for `reason`, having replayed `replayed` recorded inputs and dead-lettered `dead_lettered`: the reason and its trap kind, both counts in two bytes each, then both hashes.
pub fn Wide.of_revert(
    old: ident::HashValue,
    new: ident::HashValue,
    reason: RevertReason,
    replayed: u64,
    dead_lettered: u64,
    ) -> Wide {
    var wide = Wide(bytes: Array[u8, 72].filled(0))
    wide.bytes[0] = reason.number()
    wide.bytes[1] = match reason {
        RevertReason.Trapped(kind: kind) => u8.truncate(trap_number(Some(kind)))
        else => 0
    }
    let replays = u16.saturate(replayed)
    let deaths = u16.saturate(dead_lettered)
    wide.bytes[2] = u8.truncate(replays)
    wide.bytes[3] = u8.truncate(replays >> 8)
    wide.bytes[4] = u8.truncate(deaths)
    wide.bytes[5] = u8.truncate(deaths >> 8)
    mut wide.put_hash(at: 6, hash: old)
    mut wide.put_hash(at: 39, hash: new)
    return wide
} Wide.of_revert

/// The payload bytes of the record and its continuations.
pkg fn CoreRecord.wide(self) -> Wide {
    var wide = Wide(bytes: Array[u8, 72].filled(0))
    mut wide.put_number(at: 0, value: self.record.argument)
    for index in 0..<2usize {
        let Some(next) = self.more.get(index) else {
            break
        }
        let bits = next.to_bits()
        for at in 0..<32usize {
            wide.bytes[8 + 32 * index + at] = bits[at]
        }
    }
    return wide
} CoreRecord.wide

fn Wide.put_number(mut self, at: usize, value: u64) {
    for index in 0..<8usize {
        self.bytes[at + index] = u8.truncate(value >> u32.truncate(8 * index))
    }
} Wide.put_number

fn Wide.put_hash(mut self, at: usize, hash: ident::HashValue) {
    for index in 0..<33usize {
        self.bytes[at + index] = hash.bytes[index]
    }
} Wide.put_hash

fn Wide.hash(self, at: usize) -> ident::HashValue {
    var bytes = Array[u8, 33].filled(0)
    for index in 0..<33usize {
        bytes[index] = self.bytes[at + index]
    }
    return ident::HashValue(bytes: bytes)
} Wide.hash

fn Wide.count(self, at: usize) -> u64 {
    return u64.widen(self.bytes[at]) | (u64.widen(self.bytes[at + 1]) << 8)
} Wide.count

/// The name of the space the payload's bytes from 41 hold.
fn Wide.space(self, alloc: mem::Alloc) -> text::String {
    var space = text::String.empty(alloc)
    for at in 41..<72usize {
        let byte = self.bytes[at]
        if byte == 0 {
            break
        }
        mut space.push(char.checked_from_bits(u32.widen(byte)).value_or('?'))
    }
    return space
} Wide.space

/// The name of the only space bundles load into until isolated spaces are built.
const SHARED_SPACE: Str = "shared"

/// The reason's number in `update.reverted`'s payload.
fn RevertReason.number(self) -> u8 {
    return match self {
        RevertReason.Trapped(kind: _) => 1
        RevertReason.Unhealthy => 2
        RevertReason.Regression => 3
        RevertReason.DecodeFailed => 4
        RevertReason.ActivationTimeout => 5
        RevertReason.EnvIncomplete => 6
        RevertReason.NoImage => 7
        RevertReason.Malformed => 8
        RevertReason.Grouped => 9
    }
} RevertReason.number

/// The code of the reason numbered `number`, of trap kind `trap` for a trap.
fn reason_code(number: u8, trap: u8) -> text::Fixed[32] {
    if number == 1 {
        return match trap_kind(u16.widen(trap)) {
            Some(kind) => trap_code(kind)
            None => text::Fixed[32].of("trap.abandoned")
        }
    }
    return text::Fixed[32].of(match number {
        2 => "unhealthy"
        3 => "regression"
        9 => "grouped"
        4 => "update.decode-failed"
        5 => "plan.activation-timeout"
        6 => "instance.env-incomplete"
        7 => "code.no-image"
        else => "code.malformed"
    })
} reason_code

/// The event the record gives, acting for `system`.
pub fn CoreRecord.event(self, system: ident::Cause, alloc: mem::Alloc) -> Event {
    let record = self.record
    return Event(time_ns: record.time, source: ident::Moniker(text: self.source.text), kind: text::String.of(kind_name(record.kind).as_str(), alloc), severity: Severity.of_code(record.severity), cause: self.cause(system), principal: ident::Principal(text: text::Fixed[64].of("system")), payload: self.payload(alloc))
} CoreRecord.event

/// The fault record of a trap or an integrity fault, `None` for a record of another kind.
pub fn CoreRecord.fault(self, system: ident::Cause, alloc: mem::Alloc) -> Option[FaultRecord] {
    let kind = match self.record.kind {
        TRAPPED => text_of(self.continuation(), alloc)
        INTEGRITY => text::String.of("fault.integrity", alloc)
        else => return None
    }
    return Some(FaultRecord(moniker: ident::Moniker(text: self.source.text), incarnation: self.record.argument, kind: take kind, report: text::String.empty(alloc), dead_letter: None, cause: self.cause(system)))
} CoreRecord.fault

/// The cause the record names, `system` when it names none.
pkg fn CoreRecord.cause(self, system: ident::Cause) -> ident::Cause = cause_of(self.record.cause, system)

/// The cause `bits` names as a header holds it, `system` for the core's own work.
pkg fn cause_of(bits: u64, system: ident::Cause) -> ident::Cause {
    if bits == 0 {
        return system
    }
    return ident::Cause(bits: bits & CAUSE_BITS)
} cause_of

/// The payload the record's argument and continuations give its kind.
fn CoreRecord.payload(self, alloc: mem::Alloc) -> Payload {
    let kind = self.record.kind
    let argument = self.record.argument
    let more = self.continuation()
    if kind >= DEVICE_ADDED and kind <= DEVICE_INTERRUPT_STORM {
        return payload_of(DeviceEvent(path: text_of(more, alloc), argument: argument), alloc)
    }
    return match kind {
        STARTED => payload_of(InstanceStarted(incarnation: argument, from: started_from(more)), alloc)
        HIBERNATED => payload_of(InstanceHibernated(bytes: argument), alloc)
        JOB_ENDED => payload_of(JobEnded(outcome: text_of(more, alloc), commit: match argument {
            0 => None
            else => Some(ident::CommitId(number: argument))
        }), alloc)
        STOPPED => payload_of(InstanceStopped(abandoned: argument == 1), alloc)
        TRAPPED => payload_of(InstanceTrapped(incarnation: argument, trap: text_of(more, alloc)), alloc)
        INTEGRITY => payload_of(IntegrityFault(incarnation: argument), alloc)
        FAILED => payload_of(InstanceFailed(restarts: u32.saturate(argument)), alloc)
        SLOW_HANDLER => payload_of(SlowHandler(ns: argument), alloc)
        CHECKPOINT_FAILED => payload_of(CheckpointFailed(code: text_of(more, alloc), bytes: argument), alloc)
        REVOKED => payload_of(revocation(argument, more, alloc), alloc)
        STORE_MOUNTED => payload_of(StoreMounted(replayed: argument), alloc)
        STORE_CORRUPTION => payload_of(StoreCorruption(address: argument), alloc)
        STORE_HISTORY_THINNED => payload_of(HistoryThinned(commits: argument), alloc)
        STORE_WRITES_REFUSED => payload_of(WritesRefused(free: argument), alloc)
        BOOT_STARTED => payload_of(started_of(generation: argument, more), alloc)
        BOOT_CANDIDATE_FAILED => payload_of(CandidateFailed(generation: argument, code: text_of(more, alloc)), alloc)
        CODE_LOADED => payload_of(CodeLoaded(code: self.wide().hash(at: 8), space: self.wide().space(alloc), code_bytes: argument), alloc)
        CODE_UNLOADED => payload_of(CodeUnloaded(code: self.wide().hash(at: 8), space: self.wide().space(alloc)), alloc)
        UPDATE_STARTED => payload_of(UpdateStarted(moniker: ident::Moniker(text: self.source.text), old: self.wide().hash(at: 1), new: self.wide().hash(at: 34), class: match self.wide().bytes[0] {
            1 => MigrationClass.Additive
            2 => MigrationClass.Migrated
            else => MigrationClass.Identical
        }), alloc)
        UPDATE_PASSED => payload_of(UpdatePassed(moniker: ident::Moniker(text: self.source.text), code: self.wide().hash(at: 8), messages: argument, ended: match self.wide().bytes[41] {
            1 => ProbationEnd.Recording
            2 => ProbationEnd.Stop
            3 => ProbationEnd.Restart
            else => ProbationEnd.Bounds
        }), alloc)
        UPDATE_REVERTED => payload_of(UpdateReverted(moniker: ident::Moniker(text: self.source.text), old: self.wide().hash(at: 6), new: self.wide().hash(at: 39), reason: text::String.of(reason_code(number: self.wide().bytes[0], trap: self.wide().bytes[1]).as_str(), alloc), replayed: self.wide().count(at: 2), dead_lettered: self.wide().count(at: 4)), alloc)
        else => payload_of(StoreDeviceFailed(), alloc)
    }
} CoreRecord.payload

/// The bytes of the record's first continuation, `None` when it has none.
pkg fn CoreRecord.continuation(self) -> Option[Array[u8, 32]] {
    if not self.record.continued() {
        return None
    }
    return match self.more.get(0) {
        Some(next) => Some(next.to_bits())
        None => None
    }
} CoreRecord.continuation

/// The payload of the revocation of the grant `grant` for the reason its continuation holds.
fn revocation(grant: u64, more: Option[Array[u8, 32]], alloc: mem::Alloc) -> GrantsRevoked {
    var grants = mem::List[u64].empty(alloc)
    mut grants.push(grant)
    let reason = match first more {
        Some(bytes) if bytes[0] == 1 => RevokedFor.Expiry
        else => RevokedFor.Revoke
    }
    return GrantsRevoked(grants: take grants, reason: reason)
} revocation

/// The payload of `boot.started` of the generation `generation` that its continuation gives.
fn started_of(generation: u64, more: Option[Array[u8, 32]]) -> BootStarted {
    let bytes = more.value_or(Array[u8, 32].filled(0))
    var flags: u32 = 0
    var counter: u64 = 0
    var at: usize = 16
    while at > 8 {
        at -= 1
        counter = (counter << 8) | u64.widen(bytes[at])
    }
    while at > 4 {
        at -= 1
        flags = (flags << 8) | u32.widen(bytes[at])
    }
    return BootStarted(mode: bytes[0], generation: generation, slot: bytes[1], boot_counter: counter, flags: flags)
} started_of

/// The payload of `value`, with its type's schema hash.
pub fn payload_of[T: Encode](value: T, alloc: mem::Alloc) -> Payload {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[T].encode(value, out: mut bytes)
    return Payload(schema: ident::HashValue(bytes: mem::wire::Codec[T].schema_hash().bytes), bytes: take bytes)
} payload_of

/// The number the first 8 bytes of a continuation hold, least significant first.
pkg fn number_of(more: Option[Array[u8, 32]]) -> Option[u64] {
    let Some(bytes) = more else {
        return None
    }
    var number: u64 = 0
    var at: usize = 8
    while at > 0 {
        at -= 1
        number = (number << 8) | u64.widen(bytes[at])
    }
    return Some(number)
} number_of

/// What an `instance.started` began from, which its continuation holds: none for a start, the number of the checkpoint it restored in bytes 0 to 7, or a revival marked by byte 8.
fn started_from(more: Option[Array[u8, 32]]) -> StartedFrom {
    let Some(bytes) = more else {
        return StartedFrom.Start
    }
    if bytes[REVIVAL_MARK] != 0 {
        return StartedFrom.Revival
    }
    return StartedFrom.Checkpoint(number: number_of(more).value_or(0))
} started_from

/// The text a continuation holds up to its first zero byte, its other bytes than printable ASCII written `?`.
fn text_of(more: Option[Array[u8, 32]], alloc: mem::Alloc) -> text::String {
    var text = text::String.empty(alloc)
    let Some(bytes) = more else {
        return text
    }
    for byte in bytes {
        if byte == 0 {
            break
        }
        if byte < 0x20 or byte > 0x7E {
            mut text.push('?')
        } else {
            mut text.push(char.checked_from_bits(u32.widen(byte)).value_or('?'))
        }
    }
    return text
} text_of

test core_records_give_their_kinds_events for CoreRecord.event {
    let alloc = testing::world().alloc
    var path = Array[u8, 32].filled(0)
    path[0] = b'p'
    path[1] = b'c'
    path[2] = b'i'
    var more = mem::List[RingRecord].empty(alloc)
    mut more.push(RingRecord.from_bits(path))
    let bound = CoreRecord(record: RingRecord(time: 5, cause: 0, source: 0, kind: DEVICE_BOUND, severity: 1, flags: CONTINUED, argument: 3), more: take more, source: ident::Moniker(text: text::Fixed[59].of("supervisor")), sender: None)
    let system = ident::Cause.of(boot: 2, number: 1)
    let event = bound.event(system, alloc)
    expect event.kind.as_str() == "device.bound" and event.severity == Severity.Info and event.cause == system and event.time_ns == 5
    let Ok(device) = attempt mem::wire::Codec[DeviceEvent].decode(Untrusted.of(event.payload.bytes.view()), alloc) else {
        expect false
        return
    }
    expect device.path.as_str() == "pci" and device.argument == 3
} core_records_give_their_kinds_events

test wide_records_carry_two_code_hashes_through_their_continuations for Wide.of_revert {
    let alloc = testing::world().alloc
    var old = Array[u8, 33].filled(0x11)
    old[0] = 0x01
    var new = Array[u8, 33].filled(0x22)
    new[0] = 0x01
    let wide = Wide.of_revert(old: ident::HashValue(bytes: old), new: ident::HashValue(bytes: new), reason: RevertReason.Trapped(kind: sys::TrapKind.Expect), replayed: 7, dead_lettered: 1)
    var more = mem::List[RingRecord].empty(alloc)
    mut more.push(wide.continuation(0))
    mut more.push(wide.continuation(1))
    let reverted = CoreRecord(record: RingRecord(time: 5, cause: 0, source: 4, kind: UPDATE_REVERTED, severity: 4, flags: CONTINUED, argument: wide.argument()), more: take more, source: ident::Moniker(text: text::Fixed[59].of("counter")), sender: None)
    let event = reverted.event(ident::Cause.of(boot: 2, number: 1), alloc)
    let Ok(payload) = attempt mem::wire::Codec[UpdateReverted].decode(Untrusted.of(event.payload.bytes.view()), alloc) else {
        expect false
        return
    }
    expect event.kind.as_str() == "update.reverted" and continuations(UPDATE_REVERTED) == 2
    expect payload.moniker.text.as_str() == "counter" and payload.old == ident::HashValue(bytes: old) and payload.new == ident::HashValue(bytes: new)
    expect payload.reason.as_str() == "trap.expect" and payload.replayed == 7 and payload.dead_lettered == 1
    let start = Wide.of_start(old: ident::HashValue(bytes: old), new: ident::HashValue(bytes: new), class: MigrationClass.Additive)
    var opening = mem::List[RingRecord].empty(alloc)
    mut opening.push(start.continuation(0))
    mut opening.push(start.continuation(1))
    let opened = CoreRecord(record: RingRecord(time: 5, cause: 0, source: 4, kind: UPDATE_STARTED, severity: 2, flags: CONTINUED, argument: start.argument()), more: take opening, source: ident::Moniker(text: text::Fixed[59].of("counter")), sender: None).event(ident::Cause.of(boot: 2, number: 1), alloc)
    let Ok(begun) = attempt mem::wire::Codec[UpdateStarted].decode(Untrusted.of(opened.payload.bytes.view()), alloc) else {
        expect false
        return
    }
    expect begun.old == ident::HashValue(bytes: old) and begun.new == ident::HashValue(bytes: new) and begun.class == MigrationClass.Additive
} wide_records_carry_two_code_hashes_through_their_continuations

test traps_give_fault_records_and_boots_their_system_cause for CoreRecord.fault {
    let alloc = testing::world().alloc
    var trap = Array[u8, 32].filled(0)
    let named = "trap.exhausted".as_bytes()
    for at in 0..<named.len() {
        trap[at] = named[at]
    }
    var more = mem::List[RingRecord].empty(alloc)
    mut more.push(RingRecord.from_bits(trap))
    let system = ident::Cause.of(boot: 2, number: 1)
    let faulting = CoreRecord(record: RingRecord(time: 5, cause: 0, source: 4, kind: TRAPPED, severity: 4, flags: CONTINUED, argument: 3), more: take more, source: ident::Moniker(text: text::Fixed[59].of("fat")), sender: None)
    let wall = ident::Wall(at: ident::WallTime(utc_ns: 1_000, uncertainty_ns: 0), since_ns: 0)
    let booting = CoreRecord(record: RingRecord(time: 2_000_000_000, cause: 0, source: 0, kind: BOOT_STARTED, severity: 1, flags: 0, argument: 7), more: mem::List.empty(alloc), source: ident::Moniker(text: text::Fixed[59].of("supervisor")), sender: None)
    let Some(fault) = faulting.fault(system, alloc) else {
        expect false
        return
    }
    let Some(TraceRecord.Cause(opened)) = booting.trace(system, wall, alloc) else {
        expect false
        return
    }
    let unfaulted = booting.fault(system, alloc)
    let unopened = faulting.trace(system, wall, alloc)
    expect fault.moniker.text.as_str() == "fat" and fault.incarnation == 3 and fault.kind.as_str() == "trap.exhausted" and fault.cause == system and fault.dead_letter.is_none()
    expect opened.kind == CauseKind.System and opened.cause == system and opened.subject.as_str() == "7" and opened.time.utc_ns == 2_000_001_000 and opened.time.uncertainty_ns == 100_000
    expect unfaulted.is_none() and unopened.is_none()
} traps_give_fault_records_and_boots_their_system_cause
