//! The streams of `/journal`: their entry types, and the retention each takes from the configuration and the share of the store's capacity `/journal` holds.

/// What the streams of `/journal` keep as a configuration sets it: the hours of each, and the share of the store's capacity `/journal` holds in percent.
pub closed struct Retention derives Copy, Eq {
    pub events_h: u32
    pub log_h: u32
    pub traces_h: u32
    pub faults_h: u32
    pub max_pct: u8
} Retention

/// What the streams keep under this configuration.
pub fn JournalConfig.retention(self) -> Retention = Retention(events_h: self.events_h, log_h: self.log_h, traces_h: self.traces_h, faults_h: self.faults_h, max_pct: self.max_pct)

/// A stream of `/journal`.
pub closed enum Kept derives Copy, Eq {
    Events
    Log
    Traces
    Faults
} Kept

/// The streams of `/journal`, in the order it declares them.
pub fn Kept.every(alloc: mem::Alloc) -> mem::List[Kept] {
    var every = mem::List[Kept].empty(alloc)
    mut every.push(Kept.Events)
    mut every.push(Kept.Log)
    mut every.push(Kept.Traces)
    mut every.push(Kept.Faults)
    return every
} Kept.every

/// The stream's name below `/journal`.
pub fn Kept.name(self) -> text::Fixed[8] {
    return text::Fixed[8].of(match self {
        Kept.Events => "events"
        Kept.Log => "log"
        Kept.Traces => "traces"
        Kept.Faults => "faults"
    })
} Kept.name

/// The stream's share of what `/journal` holds, in percent.
fn Kept.share_pct(self) -> u64 {
    return match self {
        Kept.Events => 25
        Kept.Log => 25
        Kept.Traces => 10
        Kept.Faults => 5
    }
} Kept.share_pct

/// How long the stream keeps an entry under `retention`, in hours.
fn Kept.hours(self, retention: Retention) -> u32 {
    return match self {
        Kept.Events => retention.events_h
        Kept.Log => retention.log_h
        Kept.Traces => retention.traces_h
        Kept.Faults => retention.faults_h
    }
} Kept.hours

/// The type of the stream's entries.
fn Kept.type_of(self, alloc: mem::Alloc) -> store::TypeRef {
    return match self {
        Kept.Events => store::TypeRef.of("journal::Event", schema: mem::wire::Codec[Event].schema_hash(), alloc)
        Kept.Log => store::TypeRef.of("journal::LogRecord", schema: mem::wire::Codec[LogRecord].schema_hash(), alloc)
        Kept.Traces => store::TypeRef.of("journal::CauseRecord", schema: mem::wire::Codec[CauseRecord].schema_hash(), alloc)
        Kept.Faults => store::TypeRef.of("journal::FaultRecord", schema: mem::wire::Codec[FaultRecord].schema_hash(), alloc)
    }
} Kept.type_of

/// The stream's declaration under `retention`: entries kept for its hours and, when the store's capacity `capacity` is known, within its share of the part of it `/journal` holds.
pub fn Kept.declaration(self, retention: Retention, capacity: Option[u64], alloc: mem::Alloc) -> store::Declaration {
    let max_bytes = match capacity {
        Some(bytes) => Some(bytes / 100 * u64.widen(retention.max_pct) / 100 * self.share_pct())
        None => None
    }
    return store::Declaration.Stream(store::StreamDecl(type: self.type_of(alloc), max_age_s: Some(u64.widen(self.hours(retention)) * 3_600), max_bytes: max_bytes))
} Kept.declaration

/// The path of the stream below `/journal`, relative to a View of `/journal`.
pub fn Kept.path(self, alloc: mem::Alloc) -> ident::Path {
    var text = text::String.of("/", alloc)
    mut text.append(self.name().as_str())
    return ident::Path(text: take text)
} Kept.path

/// The nodes `/journal` holds as genesis declares them: the dir and its streams, kept as `retention` sets.
pub fn declarations(retention: Retention, alloc: mem::Alloc) -> mem::Map[ident::Path, store::Declaration] {
    var nodes = mem::Map[ident::Path, store::Declaration].empty(alloc)
    discard mut nodes.insert(ident::Path(text: text::String.of("/journal", alloc)), value: store::Declaration.Dir(store::DirDecl(element: None, ephemeral: false, secret: false, numbered: false, keep: None)))
    for kept in Kept.every(alloc) {
        var text = text::String.of("/journal/", alloc)
        mut text.append(kept.name().as_str())
        discard mut nodes.insert(ident::Path(text: take text), value: kept.declaration(retention, capacity: None, alloc))
    }
    return nodes
} declarations

test streams_keep_their_share_of_the_journal for Kept.declaration {
    let alloc = testing::world().alloc
    let retention = JournalConfig.default_of(alloc).retention()
    let store::Declaration.Stream(events) = Kept.Events.declaration(retention, capacity: Some(1_000_000), alloc) else {
        expect false
        return
    }
    expect events.max_age_s == Some(2_592_000) and events.max_bytes == Some(25_000)
    let store::Declaration.Stream(faults) = Kept.Faults.declaration(retention, capacity: None, alloc) else {
        expect false
        return
    }
    expect faults.max_age_s == Some(7_776_000) and faults.max_bytes.is_none()
    let nodes = declarations(retention, alloc)
    expect nodes.len() == 5
} streams_keep_their_share_of_the_journal
