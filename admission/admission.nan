//! The `admission` instance: it admits the bundle blob a View reads, judging it by chapter 10's steps, and uploads the image it takes as a draft blob; it judges the state schemas of updates; and it removes admitted bundles no instance uses.

/// The keys of the keyed tasks serving requests start here.
const SERVING: u64 = 0x1_0000_0000

/// The children of a dir each listing of it reads.
const PAGE: u32 = 64

/// The bytes one read of the bundle blob takes, and one append of the image's draft gives.
const CHUNK_BYTES: u32 = 1_048_576

/// What `admission` serves.
pub protocol Admitting {
    /// Admits the bundle blob `bundle` reads alone, for the plan of base commit `base`: its admission record, the image it takes uploaded as a draft blob.
    pub fn admit(bundle: store::service::View, base: ident::CommitId) -> code::Admission fails Refusal limits recorded
    /// Removes `/sys/code/<bundle>`: the admission record, bundle and image of the code hash `bundle`, unless a specification or a running instance names it.
    pub fn remove(bundle: ident::HashValue) fails Refusal limits recorded
    /// The migration class of an update of an instance of state type `state` from the bundle of code hash `running` to that of code hash `moving`; `code.schema-incompatible` when the new state schema is not the running one and neither accepts nor migrates from it, or when the base bundle's state schema does not accept the new one of a `checkpointed` instance of a base component.
    pub fn migration(running: ident::HashValue, moving: ident::HashValue, state: text::String, checkpointed: bool) -> code::Migration fails Refusal limits recorded
    /// Whether moving an instance of state type `state` from the bundle of code hash `running` back to that of code hash `moving` keeps its state: the state has one schema in both, the state of `moving` migrates from the running schema, or its tree accepts the running one and it is a flexible struct, which keeps the fields it does not know.
    pub fn keeps(running: ident::HashValue, moving: ident::HashValue, state: text::String) -> bool fails Refusal limits recorded
    /// The keyed task serving request `request` gives its reply.
    fn answered(request: u64, reply: sys::Encoded) limits traceless
} Admitting

/// The Env of `admission`: its View of `/sys/code`, its reading Views of `/sys/instances` and `/live/instances`, its ports to `keys` and `policy`, the machine it judges for and the nanos target of its architecture, the base bundle, and its cell.
pub open struct Env derives Send {
    code: store::service::View
    specs: store::service::View
    running: store::service::View
    keys: os::Port[keys::Keys]
    oversight: os::Port[policy::Oversight]
    machine: Machine
    target: text::Fixed[16]
    base: mem::Shared[Base]
    alloc: mem::Alloc
} Env

/// The base bundle as the kernel image holds it: its code hash and the schema trees of its components' states.
pub closed struct Base {
    pub code: ident::HashValue
    pub states: mem::List[code::Tree]
} Base

/// The state of `admission`: none, each admission running as a keyed task.
pub closed struct Admitter derives Render, Encode {
} Admitter

impl Admitter: sys::Component[Env, Admitting]

pub fn Env.of(
    code: store::service::View,
    specs: store::service::View,
    running: store::service::View,
    keys: os::Port[keys::Keys],
    oversight: os::Port[policy::Oversight],
    machine: Machine,
    target: Str,
    take base: Base,
    alloc: mem::Alloc,
    ) -> Env {
    return Env(code: code, specs: specs, running: running, keys: keys, oversight: oversight, machine: machine, target: text::Fixed[16].of(target), base: mem::Shared.of(take base, alloc), alloc: alloc)
} Env.of

pub fn Admitter.start(mut env: Env) -> Admitter = Admitter()

pub fn Admitter.admit(
    mut self,
    take bundle: store::service::View,
    take base: ident::CommitId,
    mut env: Env,
    mut cx: sys::Cx[Admitting],
    ) -> code::Admission fails Refusal {
    let Some(request) = mut cx.postpone() else {
        fail Refusal.Unavailable
    }
    let judge = Judge(code: env.code, keys: env.keys, oversight: env.oversight, machine: env.machine, target: env.target, alloc: env.alloc)
    let alloc = env.alloc
    mut cx.spawn(key: SERVING + request, run: fn[take bundle](out: sys::Outbox[Admitting]) fails task::Cancelled uses wait limits stack 65_536 {
        let outcome = try await judge.admitted(bundle, base)
        discard attempt await out.answered(request, reply: reply_of(outcome, alloc))
    })
    fail Refusal.Unavailable
} Admitter.admit

pub fn Admitter.remove(mut self, take bundle: ident::HashValue, mut env: Env, mut cx: sys::Cx[Admitting]) fails Refusal {
    let Some(request) = mut cx.postpone() else {
        fail Refusal.Unavailable
    }
    let users = Users(code: env.code, specs: env.specs, running: env.running, alloc: env.alloc)
    let alloc = env.alloc
    mut cx.spawn(key: SERVING + request, run: fn(out: sys::Outbox[Admitting]) fails task::Cancelled uses wait limits stack 32_768 {
        let outcome = try await users.removed(bundle)
        discard attempt await out.answered(request, reply: reply_of(outcome, alloc))
    })
    fail Refusal.Unavailable
} Admitter.remove

pub fn Admitter.migration(
    mut self,
    take running: ident::HashValue,
    take moving: ident::HashValue,
    take state: text::String,
    take checkpointed: bool,
    mut env: Env,
    mut cx: sys::Cx[Admitting],
    ) -> code::Migration fails Refusal {
    let Some(request) = mut cx.postpone() else {
        fail Refusal.Unavailable
    }
    let schemas = Schemas(code: env.code, base: env.base.share(), alloc: env.alloc)
    let alloc = env.alloc
    mut cx.spawn(key: SERVING + request, run: fn[take schemas, take state](out: sys::Outbox[Admitting]) fails task::Cancelled uses wait limits stack 65_536 {
        let outcome = try await schemas.migration(running, moving, state: state.as_str(), checkpointed)
        discard attempt await out.answered(request, reply: reply_of(outcome, alloc))
    })
    fail Refusal.Unavailable
} Admitter.migration

pub fn Admitter.keeps(
    mut self,
    take running: ident::HashValue,
    take moving: ident::HashValue,
    take state: text::String,
    mut env: Env,
    mut cx: sys::Cx[Admitting],
    ) -> bool fails Refusal {
    let Some(request) = mut cx.postpone() else {
        fail Refusal.Unavailable
    }
    let schemas = Schemas(code: env.code, base: env.base.share(), alloc: env.alloc)
    let alloc = env.alloc
    mut cx.spawn(key: SERVING + request, run: fn[take schemas, take state](out: sys::Outbox[Admitting]) fails task::Cancelled uses wait limits stack 65_536 {
        let outcome = try await schemas.keeps(running, moving, state: state.as_str())
        discard attempt await out.answered(request, reply: reply_of(outcome, alloc))
    })
    fail Refusal.Unavailable
} Admitter.keeps

fn Admitter.answered(
    mut self,
    take request: u64,
    take reply: sys::Encoded,
    mut env: Env,
    mut cx: sys::Cx[Admitting],
    ) {
    discard attempt mut cx.reply(request, reply)
    mut cx.cancel(key: SERVING + request)
} Admitter.answered

/// What an admission's keyed task reaches: the Env's View, ports, machine and target.
struct Judge derives Copy {
    code: store::service::View
    keys: os::Port[keys::Keys]
    oversight: os::Port[policy::Oversight]
    machine: Machine
    target: text::Fixed[16]
    alloc: mem::Alloc
} Judge

/// The admission record of the bundle blob `bundle` reads, for the plan of base commit `base`, the image it takes uploaded as a draft blob.
fn Judge.admitted(self, bundle: store::service::View, base: ident::CommitId) -> Result[code::Admission, Refusal] fails task::Cancelled uses wait {
    let alloc = self.alloc
    let blob = match first try await read_blob(bundle, path: ident::Path(text: text::String.of("/", alloc)), alloc) {
        Ok(read) => read
        Err(refusal) => return Err(take refusal)
    }
    let decoded = match first Decoded.of(blob.bytes.view(), target: self.target.as_str(), alloc) {
        Ok(made) => made
        Err(refusal) => return Err(take refusal)
    }
    let former = try await self.holds(code_hash: decoded.code, blob: blob.id)
    let signers = match first decoded.signers(alloc) {
        Ok(listed) => listed
        Err(refusal) => return Err(take refusal)
    }
    for signer in signers {
        match first try await self.verified(signer, former) {
            Some(refusal) => return Err(take refusal)
            None => {
            }
        }
    }
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[policy::Oversight].trust(mut call)
    let trust = match first attempt await self.oversight.call(take call, reply, alloc) {
        Ok(given) => given
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return Err(Refusal.Unavailable)
    }
    let judged = match first decoded.judged(trust, machine: self.machine, admitted: base, alloc) {
        Ok(made) => made
        Err(refusal) => return Err(take refusal)
    }
    let Judged(admission: admission, image: chosen) = judged
    match first try await self.upload(decoded.bundle.images[chosen].bytes.view(), expected: admission.image.image) {
        Some(refusal) => return Err(take refusal)
        None => {
        }
    }
    return Ok(take admission)
} Judge.admitted

/// Whether `/sys/code/<code hash>/bundle` holds the blob `blob`, whose signatures a former key then verifies.
fn Judge.holds(self, code_hash: ident::HashValue, blob: ident::HashValue) -> bool fails task::Cancelled uses wait {
    let alloc = self.alloc
    var path = text::String.of("/", alloc)
    let full = code_hash.full_form()
    mut path.append(full.as_str())
    mut path.append("/bundle")
    return match first attempt await self.code.get(ident::Path(text: take path), at: None, alloc) {
        Ok(node) => node.hash == Some(blob)
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(_) => false
    }
} Judge.holds

/// The refusal `keys` gives `signer`, `None` once it verifies.
fn Judge.verified(self, signer: Signer, former: bool) -> Option[Refusal] fails task::Cancelled uses wait {
    let alloc = self.alloc
    var call = sys::Encoded.empty(alloc)
    let outcome = match signer {
        Signer.Object(principal: principal, kind: kind, subject: subject, signature: signature) => attempt await self.keys.call(take call, reply: sys::Wire[keys::Keys].verify(mut call, principal: ident::Principal(text: principal.text), kind: text::String.of(kind.as_str(), alloc), subject, signature, former), alloc)
        Signer.Key(principal: principal, kind: kind, key: key) => attempt await self.keys.call(take call, reply: sys::Wire[keys::Keys].verify_key(mut call, principal: ident::Principal(text: principal.text), kind: text::String.of(kind.as_str(), alloc), key, former), alloc)
    }
    return match first outcome {
        Ok(_) => None
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        Err(os::PortError.Failed(keys::KeysFailure.BadSignature)) => Some(Refusal.BadSignature(signer: text::String.of(signer.principal().text.as_str(), alloc)))
        Err(_) => Some(Refusal.Unavailable)
    }
} Judge.verified

/// Uploads `image` as a draft blob of the id `expected`, the refusal of the store when it fails.
fn Judge.upload(self, image: Slice[u8], expected: ident::HashValue) -> Option[Refusal] fails task::Cancelled uses wait {
    let alloc = self.alloc
    let draft = match first attempt await self.code.draft(alloc) {
        Ok(opened) => opened
        Err(failure) => return Some(try refusal_of(take failure))
    }
    var at: usize = 0
    while at < image.len() {
        let Some(parts) = image.split_at(at) else {
            return Some(Refusal.Malformed)
        }
        let size = usize.widen(CHUNK_BYTES).min(image.len() - at)
        let Some(chunk) = parts.tail.prefix(size) else {
            return Some(Refusal.Malformed)
        }
        var bytes = mem::Bytes.empty(alloc)
        mut bytes.append(chunk)
        match first attempt await self.code.draft_append(draft, take bytes, alloc) {
            Ok(_) => {
            }
            Err(failure) => return Some(try refusal_of(take failure))
        }
        at += size
    }
    return match first attempt await self.code.draft_close(draft, expected: Some(expected), alloc) {
        Ok(_) => None
        Err(failure) => Some(try refusal_of(take failure))
    }
} Judge.upload

/// What a judgement of state schemas reaches: the Env's View of `/sys/code` and the base bundle.
struct Schemas {
    code: store::service::View
    base: mem::Shared[Base]
    alloc: mem::Alloc
} Schemas

/// Step 8 of an update of an instance of state type `state` from the bundle of code hash `running` to that of code hash `moving`: its migration class, or `code.schema-incompatible`.
fn Schemas.migration(
    self,
    running: ident::HashValue,
    moving: ident::HashValue,
    state: Str,
    checkpointed: bool,
    ) -> Result[code::Migration, Refusal] fails task::Cancelled uses wait {
    let alloc = self.alloc
    let refused = Refusal.SchemaIncompatible(state: text::String.of(state, alloc))
    let was = match first try await self.component(bundle: running, state) {
        Ok(Some(found)) => found
        Ok(None) => return Err(take refused)
        Err(refusal) => return Err(take refusal)
    }
    let now = match first try await self.component(bundle: moving, state) {
        Ok(Some(found)) => found
        Ok(None) => return Err(take refused)
        Err(refusal) => return Err(take refusal)
    }
    if was.schema == now.schema {
        return Ok(code::Migration.Identical)
    }
    let migrates = now.migrations.position(fn(shape: code::Shape) => shape.schema == was.schema).is_some()
    let older = match first try await self.tree(bundle: running, state) {
        Ok(Some(found)) => found
        Ok(None) => return Err(take refused)
        Err(refusal) => return Err(take refusal)
    }
    let newer = match first try await self.tree(bundle: moving, state) {
        Ok(Some(found)) => found
        Ok(None) => return Err(take refused)
        Err(refusal) => return Err(take refusal)
    }
    var base: Option[mem::wire::Schema] = None
    if checkpointed {
        base = self.base_tree(state)
    }
    return judged_schemas(state, running: older, moving: newer, migrates, base, alloc)
} Schemas.migration

/// Whether moving an instance of state type `state` from the bundle of code hash `running` back to that of code hash `moving` keeps its state: one schema, a migration of the state of `moving` from the running schema, or a tree of `moving` accepting the running one on a flexible struct.
fn Schemas.keeps(self, running: ident::HashValue, moving: ident::HashValue, state: Str) -> Result[bool, Refusal] fails task::Cancelled uses wait {
    let was = match first try await self.component(bundle: running, state) {
        Ok(Some(found)) => found
        Ok(None) => return Ok(false)
        Err(refusal) => return Err(take refusal)
    }
    let now = match first try await self.component(bundle: moving, state) {
        Ok(Some(found)) => found
        Ok(None) => return Ok(false)
        Err(refusal) => return Err(take refusal)
    }
    if was.schema == now.schema or now.migrations.position(fn(shape: code::Shape) => shape.schema == was.schema).is_some() {
        return Ok(true)
    }
    if moving == self.base.contents().code {
        return Ok(false)
    }
    let older = match first try await self.tree(bundle: running, state) {
        Ok(Some(found)) => found
        Ok(None) => return Ok(false)
        Err(refusal) => return Err(take refusal)
    }
    let artefact = match first try await self.artefact(bundle: moving, state) {
        Ok(Some(found)) => found
        Ok(None) => return Ok(false)
        Err(refusal) => return Err(take refusal)
    }
    let Some(newer) = artefact.tree(state, alloc: self.alloc) else {
        return Ok(false)
    }
    return Ok(artefact.flexible(state) and newer.accepts(older, alloc: self.alloc))
} Schemas.keeps

/// The component of state type `state` that the admission record of the bundle of code hash `bundle` describes, `None` when no record describes it.
fn Schemas.component(self, bundle: ident::HashValue, state: Str) -> Result[Option[code::Component], Refusal] fails task::Cancelled uses wait {
    let alloc = self.alloc
    let node = match first attempt await self.code.get(code_path(bundle, name: "admission", alloc), at: None, alloc) {
        Ok(found) => found
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return Ok(None)
    }
    let Some(raw) = node.value else {
        return Ok(None)
    }
    let Ok(admission) = attempt mem::wire::Codec[code::Admission].decode(raw.view(), alloc) else {
        return Err(Refusal.Malformed)
    }
    for described in take admission.components {
        if described.state.as_str() == state {
            return Ok(Some(take described))
        }
    }
    return Ok(None)
} Schemas.component

/// The schema tree of the state type `state` in the bundle of code hash `bundle`: the kernel image's for the base bundle, else the one the code root of its package records in the bundle blob; `None` when it has none.
fn Schemas.tree(self, bundle: ident::HashValue, state: Str) -> Result[Option[mem::wire::Schema], Refusal] fails task::Cancelled uses wait {
    if bundle == self.base.contents().code {
        return Ok(self.base_tree(state))
    }
    return match first try await self.artefact(bundle, state) {
        Ok(Some(found)) => Ok(found.tree(state, alloc: self.alloc))
        Ok(None) => Ok(None)
        Err(refusal) => Err(take refusal)
    }
} Schemas.tree

/// The artefact of the package declaring the state type `state` in the bundle blob of the bundle of code hash `bundle`, `None` when it holds none.
fn Schemas.artefact(self, bundle: ident::HashValue, state: Str) -> Result[Option[code::Artefact], Refusal] fails task::Cancelled uses wait {
    let alloc = self.alloc
    let Some(cut) = state.find("::") else {
        return Ok(None)
    }
    let Some(home) = state.as_bytes().prefix(cut) else {
        return Ok(None)
    }
    let blob = match first try await read_blob(self.code, path: code_path(bundle, name: "bundle", alloc), alloc) {
        Ok(read) => read
        Err(refusal) => return Err(take refusal)
    }
    let Ok(decoded) = attempt mem::wire::Codec[code::Bundle].decode(blob.bytes.view(), alloc) else {
        return Err(Refusal.Malformed)
    }
    for each in decoded.artefacts {
        let Some(read) = code::Artefact.read(Untrusted.of(each.view()), alloc) else {
            return Err(Refusal.Malformed)
        }
        if read.name.as_bytes() == home {
            return Ok(Some(take read))
        }
    }
    return Ok(None)
} Schemas.artefact

/// The base bundle's schema tree of the state type `state`, `None` when no base component has it.
fn Schemas.base_tree(self, state: Str) -> Option[mem::wire::Schema] {
    let held = self.base.contents()
    let Some(at) = held.states.position(fn(each: code::Tree) => each.path.as_str() == state) else {
        return None
    }
    return held.states[at].decoded(self.alloc)
} Schemas.base_tree

/// The path of the child `name` of `/sys/code/<bundle>` in the View of `/sys/code`.
fn code_path(bundle: ident::HashValue, name: Str, alloc: mem::Alloc) -> ident::Path {
    var path = text::String.of("/", alloc)
    mut path.append(bundle.full_form().as_str())
    mut path.push('/')
    mut path.append(name)
    return ident::Path(text: take path)
} code_path

/// What a removal's keyed task reaches: the Env's Views of `/sys/code`, `/sys/instances` and `/live/instances`.
struct Users derives Copy {
    code: store::service::View
    specs: store::service::View
    running: store::service::View
    alloc: mem::Alloc
} Users

/// Removes `/sys/code/<bundle>`: `code.in-use` naming the first specification or running instance whose bundle is `bundle`, the store's refusal when the delete fails.
fn Users.removed(self, bundle: ident::HashValue) -> Result[Unit, Refusal] fails task::Cancelled uses wait {
    let alloc = self.alloc
    match first try await self.user(self.specs, bundle, live: false) {
        Ok(Some(moniker)) => return Err(Refusal.InUse(moniker: take moniker))
        Ok(None) => {
        }
        Err(refusal) => return Err(take refusal)
    }
    match first try await self.user(self.running, bundle, live: true) {
        Ok(Some(moniker)) => return Err(Refusal.InUse(moniker: take moniker))
        Ok(None) => {
        }
        Err(refusal) => return Err(take refusal)
    }
    var path = text::String.of("/", alloc)
    mut path.append(bundle.full_form().as_str())
    var writes = mem::List[store::Write].empty(alloc)
    mut writes.push(store::Write.Delete(path: ident::Path(text: take path)))
    let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: None, plan: None, intent: None)
    return match first attempt await self.code.commit(take transaction, typed: false, alloc) {
        Ok(_) => Ok(Unit)
        Err(failure) => Err(try refusal_of(take failure))
    }
} Users.removed

/// The moniker of the first child of `view` naming `bundle`: an `os::InstanceSpec`, or an `os::LiveInstance` when `live`; the store's refusal when the View cannot be read.
fn Users.user(self, view: store::service::View, bundle: ident::HashValue, live: bool) -> Result[Option[text::String], Refusal] fails task::Cancelled uses wait {
    let alloc = self.alloc
    var after: Option[text::String] = None
    loop {
        let listing = match first attempt await view.list(ident::Path(text: text::String.of("/", alloc)), take after, limit: PAGE, alloc) {
            Ok(found) => found
            Err(failure) => return Err(try refusal_of(take failure))
        }
        for entry in listing.entries {
            var path = text::String.of("/", alloc)
            mut path.append(entry.name.as_str())
            let node = match first attempt await view.get(ident::Path(text: take path), at: None, alloc) {
                Ok(found) => found
                Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
                Err(_) => continue
            }
            let Some(raw) = node.value else {
                continue
            }
            if names(raw.view(), bundle, live, alloc) {
                return Ok(Some(text::String.of(entry.name.as_str(), alloc)))
            }
        }
        let Some(next) = listing.next else {
            return Ok(None)
        }
        after = Some(take next)
    }
} Users.user

/// Whether `raw`, an `os::InstanceSpec`, or an `os::LiveInstance` when `live`, names the bundle `bundle`.
fn names(raw: Untrusted[Slice[u8]], bundle: ident::HashValue, live: bool, alloc: mem::Alloc) -> bool {
    if live {
        return match attempt mem::wire::Codec[os::LiveInstance].decode(raw, alloc) {
            Ok(instance) => instance.bundle == bundle
            Err(_) => false
        }
    }
    return match attempt mem::wire::Codec[os::InstanceSpec].decode(raw, alloc) {
        Ok(spec) => spec.bundle == bundle
        Err(_) => false
    }
} names

/// A blob read whole: its id and its bytes.
struct Blob {
    id: ident::HashValue
    bytes: Untrusted[mem::Bytes]
} Blob

/// The blob at `path` in `view`.
fn read_blob(view: store::service::View, path: ident::Path, alloc: mem::Alloc) -> Result[Blob, Refusal] fails task::Cancelled uses wait {
    let node = match first attempt await view.get(ident::Path(text: text::String.of(path.text.as_str(), alloc)), at: None, alloc) {
        Ok(found) => found
        Err(failure) => return Err(try refusal_of(take failure))
    }
    let Some(id) = node.hash else {
        return Err(Refusal.Malformed)
    }
    var bytes = Untrusted.of(mem::Bytes.empty(alloc))
    while u64.widen(bytes.byte_len()) < node.size {
        let read = match first attempt await view.read(ident::Path(text: text::String.of(path.text.as_str(), alloc)), at: Some(node.version), offset: u64.widen(bytes.byte_len()), length: CHUNK_BYTES, alloc) {
            Ok(given) => given
            Err(failure) => return Err(try refusal_of(take failure))
        }
        if read.byte_len() == 0 {
            return Err(Refusal.Malformed)
        }
        mut bytes.append(read.view())
    }
    return Ok(Blob(id: id, bytes: take bytes))
} read_blob

/// The refusal a View's failure `failure` gives, its cancellation failing the task.
fn refusal_of(take failure: store::service::ViewError) -> Refusal fails task::Cancelled {
    return match failure {
        store::service::ViewError.Failed(stored) => Refusal.Store(take stored)
        store::service::ViewError.Cancelled(cancelled) => fail cancelled
        else => Refusal.Unavailable
    }
} refusal_of

fn reply_of[T: Encode](outcome: Result[T, Refusal], alloc: mem::Alloc) -> sys::Encoded {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[Result[T, Refusal]].encode(outcome, out: mut bytes)
    return sys::Encoded(bytes: take bytes, handles: mem::List.empty(alloc))
} reply_of
