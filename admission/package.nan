//! The `admission` instance: admitting bundles by chapter 10's steps.

package admission {
    language 1
    targets any
    dep code "../code"
    dep ident "../ident"
    dep keys "../keys"
    dep os "../os"
    dep policy "../policy"
    dep store "../store"
    allow validate in admission, code, ident, keys, os, policy, store
} admission
