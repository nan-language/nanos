//! The loader's choice among generations: the candidates a boot record lists, in their order, and the floor a boot raises.

/// A boot the loader may make: a generation, its mode, one of [Mode], and the slot it boots from, one of [Slot].
pub closed struct Choice derives Copy, Eq {
    pub generation: u64
    pub mode: u8
    pub slot: u8
} Choice

/// The candidates of step 3: with `recovery`, the recovery list; otherwise the target of `next once`, the `trial` slot, the `good` slots in descending generation order, then the recovery list. The recovery list holds the recovery generation, the generations of the `good` slots, then the others of `directories`, each in descending order. Each generation appears once and no slot `empty` or `bad` ever does; a `trial` slot without tries left is set `bad`, its slot returned.
pub fn BootRecord.choices(mut self, recovery: bool, directories: Slice[u64], alloc: mem::Alloc) -> Listing {
    var listing = Listing(choices: mem::List.empty(alloc), exhausted: None)
    if not recovery {
        let next = self.next_once
        if next == NextOnce.SlotA.to_bits() {
            mut listing.add_slot(mut self, slot: Slot.A)
        } else if next == NextOnce.SlotB.to_bits() {
            mut listing.add_slot(mut self, slot: Slot.B)
        } else if next == NextOnce.Recovery.to_bits() {
            mut listing.add_recovery(self, directories)
        }
        if self.slot_a.state == SlotState.Trial.to_bits() {
            mut listing.add_slot(mut self, slot: Slot.A)
        }
        if self.slot_b.state == SlotState.Trial.to_bits() {
            mut listing.add_slot(mut self, slot: Slot.B)
        }
        for slot in self.good_slots().view() {
            mut listing.add_slot(mut self, slot)
        }
    }
    mut listing.add_recovery(self, directories)
    return listing
} BootRecord.choices

/// The floor step 5 leaves at a `normal` boot of `booting`: the floor request when it exceeds `floor`, is at most `booting` and is the generation of a `good` slot, else `floor`.
pub fn BootRecord.raised_floor(self, floor: u64, booting: u64) -> u64 {
    let request = self.floor_request
    let good = (self.slot_a.state == SlotState.Good.to_bits() and self.slot_a.generation == request) or (self.slot_b.state == SlotState.Good.to_bits() and self.slot_b.generation == request)
    if request > floor and request <= booting and good {
        return request
    }
    return floor
} BootRecord.raised_floor

/// The entry of `slot`, one of slots A and B.
pub fn BootRecord.slot(self, slot: u8) -> SlotEntry {
    if slot == Slot.B.to_bits() {
        return self.slot_b
    }
    return self.slot_a
} BootRecord.slot

/// Sets the entry of `slot`, one of slots A and B.
pub fn BootRecord.set_slot(mut self, slot: u8, held: SlotEntry) {
    if slot == Slot.B.to_bits() {
        self.slot_b = held
    } else {
        self.slot_a = held
    }
} BootRecord.set_slot

/// The `good` slots, the higher generation first.
fn BootRecord.good_slots(self) -> mem::Bounded[Slot, 2] {
    var slots = mem::Bounded[Slot, 2].empty()
    let a = self.slot_a.state == SlotState.Good.to_bits()
    let b = self.slot_b.state == SlotState.Good.to_bits()
    if a and b and self.slot_b.generation > self.slot_a.generation {
        mut slots.push(Slot.B)
        mut slots.push(Slot.A)
    } else {
        if a {
            mut slots.push(Slot.A)
        }
        if b {
            mut slots.push(Slot.B)
        }
    }
    return slots
} BootRecord.good_slots

/// The candidates of a boot record, and the `trial` slot it set `bad` for having no tries left.
pub closed struct Listing {
    pub choices: mem::List[Choice]
    pub exhausted: Option[u8]
} Listing

/// Adds the generation of `slot` in the mode of its state, unless listed: `trial` while it has tries left, the slot set `bad` otherwise, and `normal` when `good`.
fn Listing.add_slot(mut self, mut record: BootRecord, slot: Slot) {
    let held = record.slot(slot.to_bits())
    if held.generation == 0 or self.lists(held.generation) {
        return
    }
    if held.state == SlotState.Trial.to_bits() {
        if held.tries == 0 {
            var bad = held
            bad.state = SlotState.Bad.to_bits()
            mut record.set_slot(slot.to_bits(), held: bad)
            self.exhausted = Some(slot.to_bits())
            return
        }
        mut self.choices.push(Choice(generation: held.generation, mode: Mode.Trial.to_bits(), slot: slot.to_bits()))
    } else if held.state == SlotState.Good.to_bits() {
        mut self.choices.push(Choice(generation: held.generation, mode: Mode.Normal.to_bits(), slot: slot.to_bits()))
    }
} Listing.add_slot

/// Adds the recovery list, in `recovery` mode: the recovery generation, the `good` slots' generations, then those of `directories`, each in descending order and once.
fn Listing.add_recovery(mut self, record: BootRecord, directories: Slice[u64]) {
    mut self.add_recovering(record.recovery_generation)
    for slot in record.good_slots().view() {
        mut self.add_recovering(record.slot(slot.to_bits()).generation)
    }
    var below = 0xFFFF_FFFF_FFFF_FFFFu64
    loop {
        var highest: u64 = 0
        for generation in directories {
            if generation < below and generation > highest {
                highest = generation
            }
        }
        if highest == 0 {
            return
        }
        mut self.add_recovering(highest)
        below = highest
    }
} Listing.add_recovery

fn Listing.add_recovering(mut self, generation: u64) {
    if generation == 0 or self.lists(generation) {
        return
    }
    mut self.choices.push(Choice(generation: generation, mode: Mode.Recovery.to_bits(), slot: Slot.Neither.to_bits()))
} Listing.add_recovering

fn Listing.lists(self, generation: u64) -> bool {
    for choice in self.choices {
        if choice.generation == generation {
            return true
        }
    }
    return false
} Listing.lists

fn record_with(a: SlotEntry, b: SlotEntry, recovery: u64, next: NextOnce) -> BootRecord {
    var record = BootRecord.empty()
    record.slot_a = a
    record.slot_b = b
    record.recovery_generation = recovery
    record.next_once = next.to_bits()
    return record
} record_with

fn sample_entry(generation: u64, state: SlotState, tries: u8) -> SlotEntry = SlotEntry(generation: generation, state: state.to_bits(), tries: tries, reserved: Array[u8, 6].filled(0))

test choices_follow_the_order_of_step_3 for BootRecord.choices {
    let alloc = testing::world().alloc
    var record = record_with(a: sample_entry(5, state: SlotState.Trial, tries: 2), b: sample_entry(4, state: SlotState.Good, tries: 0), recovery: 3, next: NextOnce.SlotA)
    var directories = Array[u64, 3].filled(0)
    directories[0] = 7
    directories[1] = 3
    directories[2] = 2
    let listing = mut record.choices(recovery: false, directories: directories.view(), alloc)
    expect listing.choices.len() == 5 and listing.exhausted.is_none()
    expect listing.choices[0] == Choice(generation: 5, mode: Mode.Trial.to_bits(), slot: Slot.A.to_bits())
    expect listing.choices[1] == Choice(generation: 4, mode: Mode.Normal.to_bits(), slot: Slot.B.to_bits())
    expect listing.choices[2] == Choice(generation: 3, mode: Mode.Recovery.to_bits(), slot: Slot.Neither.to_bits())
    expect listing.choices[3].generation == 7 and listing.choices[4].generation == 2
    var recovering = record
    let listed = mut recovering.choices(recovery: true, directories: directories.view(), alloc)
    expect listed.choices.len() == 4 and listed.choices[0].generation == 3 and listed.choices[1] == Choice(generation: 4, mode: Mode.Recovery.to_bits(), slot: Slot.Neither.to_bits())
} choices_follow_the_order_of_step_3

test exhausted_trials_turn_bad for BootRecord.choices {
    let alloc = testing::world().alloc
    var record = record_with(a: sample_entry(5, state: SlotState.Trial, tries: 0), b: sample_entry(4, state: SlotState.Good, tries: 0), recovery: 4, next: NextOnce.SlotA)
    let listing = mut record.choices(recovery: false, directories: Array[u64, 0].filled(0).view(), alloc)
    expect listing.exhausted == Some(Slot.A.to_bits()) and record.slot_a.state == SlotState.Bad.to_bits()
    expect listing.choices.len() == 1 and listing.choices[0].generation == 4
} exhausted_trials_turn_bad

test floors_rise_to_good_requested_generations for BootRecord.raised_floor {
    var record = record_with(a: sample_entry(5, state: SlotState.Good, tries: 0), b: sample_entry(4, state: SlotState.Bad, tries: 0), recovery: 5, next: NextOnce.Unset)
    record.floor_request = 5
    expect record.raised_floor(floor: 2, booting: 5) == 5
    expect record.raised_floor(floor: 2, booting: 4) == 2
    record.floor_request = 4
    expect record.raised_floor(floor: 2, booting: 5) == 2
} floors_rise_to_good_requested_generations
