//! XXH3-128 with seed 0 of inputs longer than 240 bytes.

const SECRET: Slice[u8] = b"\xb8\xfe\x6c\x39\x23\xa4\x4b\xbe\x7c\x01\x81\x2c\xf7\x21\xad\x1c\xde\xd4\x6d\xe9\x83\x90\x97\xdb\x72\x40\xa4\xa4\xb7\xb3\x67\x1f\xcb\x79\xe6\x4e\xcc\xc0\xe5\x78\x82\x5a\xd0\x7d\xcc\xff\x72\x21\xb8\x08\x46\x74\xf7\x43\x24\x8e\xe0\x35\x90\xe6\x81\x3a\x26\x4c\x3c\x28\x52\xbb\x91\xc3\x00\xcb\x88\xd0\x65\x8b\x1b\x53\x2e\xa3\x71\x64\x48\x97\xa2\x0d\xf9\x4e\x38\x19\xef\x46\xa9\xde\xac\xd8\xa8\xfa\x76\x3f\xe3\x9c\x34\x3f\xf9\xdc\xbb\xc7\xc7\x0b\x4f\x1d\x8a\x51\xe0\x4b\xcd\xb4\x59\x31\xc8\x9f\x7e\xc9\xd9\x78\x73\x64\xea\xc5\xac\x83\x34\xd3\xeb\xc3\xc5\x81\xa0\xff\xfa\x13\x63\xeb\x17\x0d\xdd\x51\xb7\xf0\xda\x49\xd3\x16\x55\x26\x29\xd4\x68\x9e\x2b\x16\xbe\x58\x7d\x47\xa1\xfc\x8f\xf8\xb8\xd1\x7a\xd0\x31\xce\x45\xcb\x3a\x8f\x95\x16\x04\x28\xaf\xd7\xfb\xca\xbb\x4b\x40\x7e"

const PRIME32_1: u64 = 0x9E37_79B1

const PRIME32_2: u64 = 0x85EB_CA77

const PRIME32_3: u64 = 0xC2B2_AE3D

const PRIME64_1: u64 = 0x9E37_79B1_85EB_CA87

const PRIME64_2: u64 = 0xC2B2_AE3D_27D4_EB4F

const PRIME64_3: u64 = 0x1656_67B1_9E37_79F9

const PRIME64_4: u64 = 0x85EB_CA77_C2B2_AE63

const PRIME64_5: u64 = 0x27D4_EB2F_1656_67C5

const MIX_PRIME: u64 = 0x1656_6791_9E37_79F9

const STRIPE_BYTES: usize = 64

const STRIPES_PER_BLOCK: usize = 16

const BLOCK_BYTES: usize = 1_024

/// A 128-bit hash, as its low and high 64 bits.
pkg struct Hash128 derives Copy, Eq {
    pkg low: u64
    pkg high: u64
} Hash128

pkg fn xxh3_128(input: Slice[u8]) -> Hash128
    requires input.len() > 240
{
    var lanes = initial_lanes()
    let blocks = (input.len() - 1) / BLOCK_BYTES
    for block in 0..<blocks {
        for stripe in 0..<STRIPES_PER_BLOCK {
            accumulate(mut lanes, input, at: block * BLOCK_BYTES + stripe * STRIPE_BYTES, key_at: stripe * 8)
        }
        scramble(mut lanes)
    }
    let stripes = (input.len() - 1 - blocks * BLOCK_BYTES) / STRIPE_BYTES
    for stripe in 0..<stripes {
        accumulate(mut lanes, input, at: blocks * BLOCK_BYTES + stripe * STRIPE_BYTES, key_at: stripe * 8)
    }
    accumulate(mut lanes, input, at: input.len() - STRIPE_BYTES, key_at: SECRET.len() - STRIPE_BYTES - 7)
    let len = u64.widen(input.len())
    return Hash128(
        low: merge(lanes, key_at: 11, start: len.wrapping_mul(PRIME64_1)),
        high: merge(lanes, key_at: SECRET.len() - STRIPE_BYTES - 11, start: ~(len.wrapping_mul(PRIME64_2))),
    )
} xxh3_128

fn accumulate(mut lanes: Array[u64, 8], input: Slice[u8], at: usize, key_at: usize) {
    for lane in 0..<8usize {
        let value = input.u64_le(at + 8 * lane)
        let keyed = value ^ SECRET.u64_le(key_at + 8 * lane)
        lanes[lane ^ 1] = lanes[lane ^ 1].wrapping_add(value)
        lanes[lane] = lanes[lane].wrapping_add((keyed & 0xFFFF_FFFF).wrapping_mul(keyed >> 32))
    }
} accumulate

fn scramble(mut lanes: Array[u64, 8]) {
    for lane in 0..<8usize {
        let key = SECRET.u64_le(SECRET.len() - STRIPE_BYTES + 8 * lane)
        lanes[lane] = (lanes[lane] ^ (lanes[lane] >> 47) ^ key).wrapping_mul(PRIME32_1)
    }
} scramble

fn merge(lanes: Array[u64, 8], key_at: usize, start: u64) -> u64 {
    var result = start
    for pair in 0..<4usize {
        let left = lanes[2 * pair] ^ SECRET.u64_le(key_at + 16 * pair)
        let right = lanes[2 * pair + 1] ^ SECRET.u64_le(key_at + 16 * pair + 8)
        let product = left.wide_mul(right)
        result = result.wrapping_add(product.low ^ product.high)
    }
    let mixed = (result ^ (result >> 37)).wrapping_mul(MIX_PRIME)
    return mixed ^ (mixed >> 32)
} merge

fn initial_lanes() -> Array[u64, 8] {
    var lanes = Array[u64, 8].filled(PRIME32_3)
    lanes[1] = PRIME64_1
    lanes[2] = PRIME64_2
    lanes[3] = PRIME64_3
    lanes[4] = PRIME64_4
    lanes[5] = PRIME32_2
    lanes[6] = PRIME64_5
    lanes[7] = PRIME32_1
    return lanes
} initial_lanes

fn hash_of_pattern(len: usize, alloc: mem::Alloc) -> Hash128 {
    var input = mem::Bytes.zeroed(len, alloc)
    for i in 0..<len {
        input[i] = u8.truncate(i % 251)
    }
    return xxh3_128(input.view())
} hash_of_pattern

test long_inputs_hash_as_xxh3_128 for xxh3_128 {
    let alloc = testing::world().alloc
    let len_241 = hash_of_pattern(241, alloc)
    expect len_241 == Hash128(low: 0x02E8_CD95_421C_6D02, high: 0x1DA1_CB61_BCB8_A2A1)
    let len_496 = hash_of_pattern(496, alloc)
    expect len_496 == Hash128(low: 0xDA02_2646_80C1_D2C7, high: 0x687C_0380_557D_E1C0)
    let len_1024 = hash_of_pattern(1_024, alloc)
    expect len_1024 == Hash128(low: 0xE5D7_8BAF_A45B_2AA5, high: 0xD0AC_1F7B_93BF_57B9)
    let len_1025 = hash_of_pattern(1_025, alloc)
    expect len_1025 == Hash128(low: 0xE95C_4228_8F28_186E, high: 0x2882_EBCA_04EC_915C)
    let len_4097 = hash_of_pattern(4_097, alloc)
    expect len_4097 == Hash128(low: 0xB69D_29F1_7D48_293F, high: 0x0F77_B4BC_73E3_337D)
} long_inputs_hash_as_xxh3_128
