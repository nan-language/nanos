//! The boot state: what `/sys/boot` mirrors of the boot record and the boot volume.

/// The state of a boot slot.
pub closed enum SlotCondition derives Copy, Eq, Render, Encode {
    Empty
    Trial
    Good
    Bad
} SlotCondition

/// A slot of the boot record: its name, `a` or `b`, its generation, its state and the tries it has left.
pub closed struct BootSlot derives Render, Encode {
    pub name: text::String
    pub generation: u64
    pub state: SlotCondition
    pub tries_left: u8
} BootSlot

/// A generation on the boot volume: its manifest's fields, its installation time, and the commit pinned for it.
pub closed struct Generation derives Render, Encode {
    pub number: u64
    pub manifest: ident::HashValue
    pub kernel: ident::HashValue
    pub genesis: ident::HashValue
    pub min_loader: u32
    pub store_format: u32
    pub signer: ident::Principal
    pub installed: ident::WallTime
    pub base: ident::CommitId
} Generation

/// The record of `/sys/boot`: the slots, the recovery generation, the anti-rollback floor, the floor raise requested of the loader, 0 for none, and the generations on the boot volume.
pub closed struct BootState derives Render, Encode {
    pub slots: mem::List[BootSlot]
    pub recovery: u64
    pub floor: u64
    pub floor_request: u64
    pub generations: mem::List[Generation]
} BootState

/// The boot state a handoff record tells: the booted slot with its generation and tries, trial in `trial` mode and good otherwise, none in `recovery` and `dev` modes, and the floor.
pub fn BootState.of_handoff(handoff: Handoff, alloc: mem::Alloc) -> BootState {
    var slots = mem::List[BootSlot].empty(alloc)
    let state = match handoff.mode == Mode.Trial.to_bits() {
        true => SlotCondition.Trial
        false => SlotCondition.Good
    }
    if handoff.slot == Slot.A.to_bits() {
        mut slots.push(BootSlot(name: text::String.of("a", alloc), generation: handoff.generation, state: state, tries_left: handoff.tries))
    } else if handoff.slot == Slot.B.to_bits() {
        mut slots.push(BootSlot(name: text::String.of("b", alloc), generation: handoff.generation, state: state, tries_left: handoff.tries))
    }
    return BootState(slots: take slots, recovery: 0, floor: handoff.floor, floor_request: 0, generations: mem::List.empty(alloc))
} BootState.of_handoff
