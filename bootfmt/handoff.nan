//! The handoff record: what the loader passes to the kernel, a 512-byte layout.

const HANDOFF_MAGIC: Slice[u8] = b"NANOSHO1"

const HANDOFF_VERSION: u32 = 1

const HANDOFF_BYTES: u32 = 512

const FAILURE_SLOTS: u8 = 4

pub layout Mode: u8 tags {
    Normal = 0
    Trial = 1
    Recovery = 2
    Dev = 3
} Mode

/// The slot booted, `Neither` in `recovery` and `dev` modes.
pub layout Slot: u8 tags {
    Neither = 0
    A = 1
    B = 2
} Slot

/// The boot volume's partitioning.
pub layout VolumeScheme: u8 tags {
    Unknown = 0
    Mbr = 1
    Gpt = 2
} VolumeScheme

/// The machine conditions the loader detects.
pub layout Conditions: u8 {
    tpm: bit 0
    secure_boot: bit 1
    reserved: rest
} Conditions

pub layout HandoffFlags: u32 le {
    development: bit 0
    record_written: bit 1
    entropy: bit 2
    recovery_requested: bit 3
    floor_in_tpm: bit 4
    floor_in_variable: bit 5
    floor_raised: bit 6
    owner_request_applied: bit 7
    owner_request_refused: bit 8
    loader_request_applied: bit 9
    loader_request_refused: bit 10
    previous_loader_entry: bit 11
    reserved: rest
} HandoffFlags

/// A candidate the loader gave up: its generation, then its code in ASCII, zero-padded.
pub layout Failure: bytes 32 le {
    generation: u64 at 0
    code: Array[u8, 24] at 8
} Failure

/// A handoff record, `mode` one of [Mode], `slot` one of [Slot] and `volume_scheme` one of [VolumeScheme].
pub layout Handoff: bytes 512 le {
    magic: Array[u8, 8] at 0
    version: u32 at 8
    size: u32 at 12
    generation: u64 at 16
    boot_counter: u64 at 24
    floor: u64 at 32
    loader_version: u32 at 40
    flags: HandoffFlags at 44
    volume_partition: u32 at 48
    mode: u8 at 52
    slot: u8 at 53
    tries: u8 at 54
    conditions: Conditions at 55
    failure_count: u8 at 56
    volume_scheme: u8 at 57
    reserved_a: Array[u8, 6] at 58
    volume_signature: Array[u8, 16] at 64
    owner_key: Array[u8, 32] at 80
    recovery_digest: Array[u8, 32] at 112
    manifest_hash: Array[u8, 33] at 144
    kernel_hash: Array[u8, 33] at 177
    genesis_hash: Array[u8, 33] at 210
    loader_hash: Array[u8, 33] at 243
    reserved_b: Array[u8, 4] at 276
    event_log_address: u64 at 280
    event_log_size: u64 at 288
    final_events_address: u64 at 296
    entropy: Array[u8, 64] at 304
    failures: Array[Failure, 4] at 368
    entry_counter: u64 at 496
    reserved_c: Array[u8, 8] at 504
} Handoff

/// Why a handoff record is invalid.
pub closed enum HandoffError derives Copy, Eq, Render {
    Size
    Magic
    Version
    Value
    Reserved
    Hash
    Failures
} HandoffError

/// A record holding the magic, version and size, every other field zero, for the loader to fill.
pub fn Handoff.empty() -> Handoff {
    var bits = Array[u8, 512].filled(0)
    mut bits.view_mut().write_u32_le(8, value: HANDOFF_VERSION)
    mut bits.view_mut().write_u32_le(12, value: HANDOFF_BYTES)
    var handoff = Handoff.from_bits(bits)
    mut handoff.magic.view_mut().copy_from(HANDOFF_MAGIC)
    return handoff
} Handoff.empty

/// The record when it is valid: the magic, version 1, size 512, defined enumerated values, zero reserved bits, the kernel's and the loader's blob ids, a manifest hash and a genesis hash each zero or a hash, and up to four failures, each a generation and a code, the unused entries zero.
pub validator fn Handoff.read(raw: Untrusted[Slice[u8]]) -> Handoff fails HandoffError {
    let bytes = raw.inspect()
    if bytes.len() != 512 {
        fail HandoffError.Size
    }
    var bits = Array[u8, 512].filled(0)
    mut bits.view_mut().copy_from(bytes)
    let handoff = Handoff.from_bits(bits)
    if handoff.magic.view() != HANDOFF_MAGIC {
        fail HandoffError.Magic
    }
    if handoff.version != HANDOFF_VERSION or handoff.size != HANDOFF_BYTES {
        fail HandoffError.Version
    }
    let modes = Mode.checked_from_bits(handoff.mode).is_some() and Slot.checked_from_bits(handoff.slot).is_some()
    if not modes or VolumeScheme.checked_from_bits(handoff.volume_scheme).is_none() or handoff.failure_count > FAILURE_SLOTS {
        fail HandoffError.Value
    }
    let reserved_bits = handoff.flags.reserved == 0 and handoff.conditions.reserved == 0
    if not (reserved_bits and zero(handoff.reserved_a.view()) and zero(handoff.reserved_b.view()) and zero(handoff.reserved_c.view())) {
        fail HandoffError.Reserved
    }
    if not (is_hash(handoff.kernel_hash) and is_hash(handoff.loader_hash)) {
        fail HandoffError.Hash
    }
    if not ((is_hash(handoff.manifest_hash) or zero(handoff.manifest_hash.view())) and (is_hash(handoff.genesis_hash) or zero(handoff.genesis_hash.view()))) {
        fail HandoffError.Hash
    }
    for i in 0..<handoff.failures.len() {
        let failure = handoff.failures[i]
        let used = i < usize.widen(handoff.failure_count)
        if (used and not is_code(failure.code)) or (not used and (failure.generation != 0 or not zero(failure.code.view()))) {
            fail HandoffError.Failures
        }
    }
    return handoff
} Handoff.read

fn is_hash(bytes: Array[u8, 33]) -> bool = bytes[0] == 0x01

/// Whether `code` holds one or more printable ASCII characters, then only zeros.
fn is_code(code: Array[u8, 24]) -> bool {
    var ended = false
    for byte in code {
        if byte == 0 {
            ended = true
        } else if ended or byte < 0x21 or byte > 0x7E {
            return false
        }
    }
    return code[0] != 0
} is_code

fn dev_handoff() -> Handoff {
    var handoff = Handoff.empty()
    handoff.boot_counter = 1
    handoff.loader_version = 1
    handoff.flags.development = true
    handoff.flags.entropy = true
    handoff.volume_partition = 1
    handoff.mode = Mode.Dev.to_bits()
    handoff.volume_scheme = VolumeScheme.Mbr.to_bits()
    handoff.kernel_hash[0] = 0x01
    handoff.kernel_hash[32] = 0x7F
    handoff.loader_hash[0] = 0x01
    handoff.entropy[63] = 0xA5
    handoff.entry_counter = 0x1234_5678
    return handoff
} dev_handoff

fn read_back(handoff: Handoff) -> Result[Handoff, HandoffError] {
    let bits = handoff.to_bits()
    return attempt Handoff.read(Untrusted.of(bits.view()))
} read_back

test handoff_fields_sit_at_their_offsets for Handoff.empty {
    let bits = dev_handoff().to_bits()
    expect bits.view().prefix(16) == Some(b"NANOSHO1\x01\x00\x00\x00\x00\x02\x00\x00")
    expect bits.view().u64_le(24) == 1
    expect bits.view().u32_le(44) == 0b101
    expect bits[52] == 3
    expect bits[57] == 1
    expect bits[177] == 0x01
    expect bits[209] == 0x7F
    expect bits[367] == 0xA5
    expect bits.view().u64_le(496) == 0x1234_5678
} handoff_fields_sit_at_their_offsets

test valid_handoffs_read_back for Handoff.read {
    let handoff = dev_handoff()
    let read = read_back(handoff)
    expect read == Ok(handoff)
    var failed = handoff
    failed.failure_count = 1
    failed.failures[0].generation = 5
    failed.failures[0].code[0] = b'b'
    let with_failure = read_back(failed)
    expect with_failure == Ok(failed)
} valid_handoffs_read_back

test invalid_handoffs_are_rejected for Handoff.read {
    let handoff = dev_handoff()
    let short = attempt Handoff.read(Untrusted.of(b"NANOSHO1"))
    expect short == Err(HandoffError.Size)
    var magic = handoff
    magic.magic[7] = b'2'
    let bad_magic = read_back(magic)
    expect bad_magic == Err(HandoffError.Magic)
    var version = handoff
    version.version = 2
    let bad_version = read_back(version)
    expect bad_version == Err(HandoffError.Version)
    var mode = handoff
    mode.mode = 4
    let bad_mode = read_back(mode)
    expect bad_mode == Err(HandoffError.Value)
    var flags = handoff
    flags.flags.reserved = 0x1000
    let bad_flags = read_back(flags)
    expect bad_flags == Err(HandoffError.Reserved)
    var kernel = handoff
    kernel.kernel_hash[0] = 0
    let bad_kernel = read_back(kernel)
    expect bad_kernel == Err(HandoffError.Hash)
    var unused = handoff
    unused.failures[3].generation = 1
    let bad_unused = read_back(unused)
    expect bad_unused == Err(HandoffError.Failures)
    var empty_code = handoff
    empty_code.failure_count = 1
    let bad_code = read_back(empty_code)
    expect bad_code == Err(HandoffError.Failures)
} invalid_handoffs_are_rejected
