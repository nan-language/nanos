//! Identity: the hashes of nodes, the entry digests of dirs, their entry hashes cut into runs level by level, and the root hash of a commit.

/// The hash of the node `found` names: the one its entry holds, else computed from its content and, for a dir, its children's.
pkg fn Store.node_hash[D: disk::Device](mut self, device: D, found: Found, alloc: mem::Alloc) -> ident::HashValue fails StoreError uses wait {
    let view = self.view_of(head: found.place.head, tree: found.place.tree, alloc)
    return try await mut self.hash_in(device, snapshot: view, entry: found.entry, tree: found.place.tree, alloc)
} Store.node_hash

/// The present nodes of `tree` of the branch at `head`, as a snapshot.
pkg fn Store.view_of(self, head: usize, tree: u8, alloc: mem::Alloc) -> Snapshot {
    return Snapshot(commit: self.heads[head].branch.head.number, root: self.root_at(head, tree), overlay: mem::Map.empty(alloc), live: true)
} Store.view_of

/// The hash of the node of `entry`, which lies in `tree`, its dir's children read through `snapshot`.
pkg fn Store.hash_in[D: disk::Device](
    mut self,
    device: D,
    snapshot: Snapshot,
    entry: NodeEntry,
    tree: u8,
    alloc: mem::Alloc,
    ) -> ident::HashValue fails StoreError uses wait {
    match try await mut self.known_hash(device, entry, tree, alloc) {
        Some(hash) => return hash
        None => {
        }
    }
    let Content.Dir(id: id, declaration: declaration, digest: _, next: _) = entry.content else {
        fail StoreError.Corrupt
    }
    let digest = try await mut self.digest_in(device, snapshot, dir: id, tree, alloc)
    return dir_hash(declaration.view(), digest, alloc)
} Store.hash_in

/// The hash of the node of `entry` when no entry digest needs computing for it: the one its entry holds, a blob's id, a stream's or an ephemeral dir's from its declaration, a dir's from its declaration and the digest its entry holds, a record's from its type and bytes; `None` for a dir whose entry holds no digest.
fn Store.known_hash[D: disk::Device](
    mut self,
    device: D,
    entry: NodeEntry,
    tree: u8,
    alloc: mem::Alloc,
    ) -> Option[ident::HashValue] fails StoreError uses wait {
    match entry.hash {
        Some(hash) => return Some(hash)
        None => {
        }
    }
    match entry.content {
        Content.Blob(id: id, size: _) => return Some(id)
        Content.Stream(id: _, declaration: declaration, next: _, entries: _, bytes: _) => return Some(ident::HashValue.of_object(ident::Kind.Stream, bytes: declaration.view()))
        Content.Dir(id: _, declaration: declaration, digest: digest, next: _) => {
            let children = try child_dir(entry, tree, alloc)
            if children.tree != tree {
                return Some(ident::HashValue.of_object(ident::Kind.Ephemeral, bytes: declaration.view()))
            }
            return match digest {
                Some(held) => Some(dir_hash(declaration.view(), digest: held, alloc))
                None => None
            }
        }
        else => {
        }
    }
    let type = try await mut self.type_of(device, id: entry.type, alloc)
    var bytes = copied_bytes(type.schema.bytes.view(), alloc)
    let record = try await mut self.record_bytes(device, entry, alloc)
    mut bytes.append(record.view())
    return Some(ident::HashValue.of_object(ident::Kind.Record, bytes: bytes.view()))
} Store.known_hash

/// The hash of a dir of declaration `declaration` and entry digest `digest`.
fn dir_hash(declaration: Slice[u8], digest: ident::HashValue, alloc: mem::Alloc) -> ident::HashValue {
    var bytes = copied_bytes(declaration, alloc)
    mut bytes.append(digest.bytes.view())
    return ident::HashValue.of_object(ident::Kind.Dir, bytes: bytes.view())
} dir_hash

/// A dir whose entry digest is being computed: its children read through the snapshot, the next to hash, the entry hashes of those hashed, and its declaration.
struct Digesting {
    children: mem::List[Child]
    next: usize
    level: mem::List[ident::HashValue]
    declaration: mem::Bytes
} Digesting

/// The entry digest of dir `dir` of `tree` read through `snapshot`: its entry hashes in name order, cut into runs after each hash whose last byte is below 16 and after the last, level by level until one remains. A child dir whose entry holds no digest has its own computed first, the dirs under way waiting on a stack.
pkg fn Store.digest_in[D: disk::Device](
    mut self,
    device: D,
    snapshot: Snapshot,
    dir: u64,
    tree: u8,
    alloc: mem::Alloc,
    ) -> ident::HashValue fails StoreError uses wait {
    var stack = mem::List[Digesting].empty(alloc)
    mut stack.push(Digesting(children: try await mut self.snapshot_children(device, snapshot, dir, alloc), next: 0, level: mem::List.empty(alloc), declaration: mem::Bytes.empty(alloc)))
    loop {
        let Some(top) = mut stack.pop() else {
            fail StoreError.Corrupt
        }
        var digesting = top
        if digesting.next < digesting.children.len() {
            let child = digesting.children[digesting.next]
            let found = try await mut self.known_hash(device, entry: child.entry, tree, alloc)
            match found {
                Some(hash) => {
                    mut digesting.level.push(entry_hash(child.name.view(), kind: child.entry.kind, hash, alloc))
                    digesting.next += 1
                    mut stack.push(take digesting)
                }
                None => {
                    let Content.Dir(id: id, declaration: declaration, digest: _, next: _) = child.entry.content else {
                        fail StoreError.Corrupt
                    }
                    let nested = Digesting(children: try await mut self.snapshot_children(device, snapshot, dir: id, alloc), next: 0, level: mem::List.empty(alloc), declaration: copied_bytes(declaration.view(), alloc))
                    mut stack.push(take digesting)
                    mut stack.push(take nested)
                }
            }
            continue
        }
        let digest = digest_of(digesting.level.view(), alloc)
        let Some(above) = mut stack.pop() else {
            return digest
        }
        var parent = above
        let child = parent.children[parent.next]
        mut parent.level.push(entry_hash(child.name.view(), kind: child.entry.kind, hash: dir_hash(digesting.declaration.view(), digest, alloc), alloc))
        parent.next += 1
        mut stack.push(take parent)
    }
} Store.digest_in

/// The entry hash of a child named `name` of kind `kind` and hash `hash`.
fn entry_hash(name: Slice[u8], kind: u8, hash: ident::HashValue, alloc: mem::Alloc) -> ident::HashValue {
    var bytes = wire_of(text_of(name, alloc), alloc)
    mut bytes.push(kind)
    mut bytes.append(hash.bytes.view())
    return ident::HashValue.of_object(ident::Kind.Entry, bytes: bytes.view())
} entry_hash

/// The entry digest of the entry hashes `level`: the hash of an empty run when there are none, else the runs cut level by level until one remains.
fn digest_of(level: Slice[ident::HashValue], alloc: mem::Alloc) -> ident::HashValue {
    if level.len() == 0 {
        return ident::HashValue.of_object(ident::Kind.Run, bytes: b"")
    }
    var hashes = runs_of_level(level, alloc)
    loop {
        if hashes.len() == 1 {
            return hashes[0]
        }
        hashes = runs_of_level(hashes.view(), alloc)
    }
} digest_of

/// The root hash of the head of the branch at `head`: the hash of a dir of empty declaration holding only its `data` and `sys`.
pub fn Store.root_hash[D: disk::Device](mut self, device: D, branch: Str, alloc: mem::Alloc) -> ident::HashValue fails StoreError uses wait {
    let head = try self.head_named(branch)
    let view = self.view_of(head, tree: TREE_VERSIONED, alloc)
    let digest = try await mut self.digest_in(device, snapshot: view, dir: TOP_DIR, tree: TREE_VERSIONED, alloc)
    var bytes = wire_of(Declaration.Dir(DirDecl(element: None, ephemeral: false, secret: false, numbered: false, keep: None)), alloc)
    mut bytes.append(digest.bytes.view())
    return ident::HashValue.of_object(ident::Kind.Dir, bytes: bytes.view())
} Store.root_hash

/// The wire bytes of the record of `entry`, held inline or in a value record.
pkg fn Store.record_bytes[D: disk::Device](mut self, device: D, entry: NodeEntry, alloc: mem::Alloc) -> mem::Bytes fails StoreError uses wait {
    return match entry.content {
        Content.Inline(bytes) => copied_bytes(bytes.view(), alloc)
        Content.Value(bytes) => try await mut self.value_bytes(device, pointer: bytes.view(), alloc)
        else => fail StoreError.Kind
    }
} Store.record_bytes

/// The bytes of the value record a pointer names by its item.
fn Store.value_bytes[D: disk::Device](mut self, device: D, pointer: Slice[u8], alloc: mem::Alloc) -> mem::Bytes fails StoreError uses wait {
    let Some(named) = disk::Pointer.of_bytes(pointer) else {
        fail StoreError.Corrupt
    }
    let entry = match attempt await mut self.index.item_entry(device, item: named.target, alloc) {
        Ok(Some(found)) => found
        Ok(None) => fail StoreError.Corrupt
        Err(failure) => fail StoreError.of_tree(take failure)
    }
    let record = match attempt await log::read_record(device, address: entry.address, pointer: named, alloc) {
        Ok(Some(found)) => found
        Ok(None) => fail StoreError.Corrupt
        Err(failure) => fail StoreError.of_log(take failure)
    }
    return accepted_bytes(record.payload.view(), alloc)
} Store.value_bytes

/// The hashes of one level of runs: each run of hashes, cut after each hash whose last byte is below 16 and after the last, hashed as `run`, a line feed and its hashes.
fn runs_of_level(hashes: Slice[ident::HashValue], alloc: mem::Alloc) -> mem::List[ident::HashValue] {
    var level = mem::List[ident::HashValue].empty(alloc)
    var run = mem::Bytes.empty(alloc)
    for at in 0..<hashes.len() {
        mut run.append(hashes[at].bytes.view())
        if hashes[at].bytes[32] < 16 or at + 1 == hashes.len() {
            mut level.push(ident::HashValue.of_object(ident::Kind.Run, bytes: run.view()))
            mut run.truncate(0)
        }
    }
    return level
} runs_of_level

/// The text a name's bytes spell, empty when they are not UTF-8.
fn text_of(name: Slice[u8], alloc: mem::Alloc) -> text::String {
    return match attempt text::String.try_from_utf8(name, alloc) {
        Ok(text) => text
        Err(_) => text::String.empty(alloc)
    }
} text_of
