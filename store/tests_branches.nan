//! Tests of branches, reads at past commits, history, diffs, reverts and merges.

fn level_on(
    mut store: Store,
    device: disk::MemoryVolume,
    branch: Str,
    text: Str,
    alloc: mem::Alloc,
    ) -> u32 fails StoreError uses wait {
    let node = try await mut store.get(device, branch, path: path_of(text, alloc), now: at_second(100), alloc)
    let Some(value) = node.value else {
        return 0
    }
    return read_level(value.view(), alloc)
} level_on

fn level_then(
    mut store: Store,
    device: disk::MemoryVolume,
    text: Str,
    at: u64,
    alloc: mem::Alloc,
    ) -> u32 fails StoreError uses wait {
    let node = try await mut store.get_at(device, branch: "main", path: path_of(text, alloc), at: ident::CommitId(number: at), now: at_second(100), alloc)
    let Some(value) = node.value else {
        return 0
    }
    return read_level(value.view(), alloc)
} level_then

fn commit_on(
    mut store: Store,
    device: disk::MemoryVolume,
    branch: Str,
    take writes: mem::List[Write],
    alloc: mem::Alloc,
    ) -> Committed fails StoreError uses wait {
    return try await mut store.commit(device, branch, transaction: blind(take writes, alloc), stamp: system_stamp(alloc), now: at_second(20), alloc)
} commit_on

test past_commits_read_through_snapshots for Store.get_at {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/data/x", level: 1, alloc), alloc), alloc)
    try await mut store.index_flush(device, now: at_second(21), alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/data/x", level: 2, alloc), alloc), alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/data/y", level: 3, alloc), alloc), alloc)
    let flushed = try await level_then(mut store, device, text: "/data/x", at: 2, alloc)
    let between = try await level_then(mut store, device, text: "/data/x", at: 3, alloc)
    expect flushed == 1 and between == 2
    let absent = attempt await mut store.get_at(device, branch: "main", path: path_of("/data/y", alloc), at: ident::CommitId(number: 3), now: at_second(30), alloc)
    expect absent.is_err()
    let unversioned = attempt await mut store.get_at(device, branch: "main", path: path_of("/state/x", alloc), at: ident::CommitId(number: 3), now: at_second(30), alloc)
    let refused = match unversioned {
        Err(StoreError.Unversioned) => true
        else => false
    }
    expect refused
    let changes = try await mut store.history(device, branch: "main", path: path_of("/data/x", alloc), before: None, limit: 10, now: at_second(30), alloc)
    expect changes.len() == 2 and changes[0].number.number == 3 and changes[1].number.number == 2
} past_commits_read_through_snapshots

test branches_share_their_fork_then_diverge for Store.branch {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/data/x", level: 1, alloc), alloc), alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/data/x", level: 2, alloc), alloc), alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/data/y", level: 3, alloc), alloc), alloc)
    let owner = ident::Principal(text: text::Fixed[64].of("agent.ops"))
    discard try await mut store.branch(device, name: "feature", from: "main", at: None, by: owner, expires: None, system: false, now: at_second(30), alloc)
    discard try await mut store.branch(device, name: "old", from: "main", at: Some(ident::CommitId(number: 3)), by: owner, expires: None, system: false, now: at_second(30), alloc)
    discard try await commit_on(mut store, device, branch: "feature", writes: single(put("/data/x", level: 5, alloc), alloc), alloc)
    let on_main = try await level_on(mut store, device, branch: "main", text: "/data/x", alloc)
    let on_feature = try await level_on(mut store, device, branch: "feature", text: "/data/x", alloc)
    let on_old = try await level_on(mut store, device, branch: "old", text: "/data/x", alloc)
    expect on_main == 2 and on_feature == 5 and on_old == 2
    let old_y = attempt await mut store.get(device, branch: "old", path: path_of("/data/y", alloc), now: at_second(30), alloc)
    expect old_y.is_err()
    let reserved = attempt await mut store.branch(device, name: "job/x", from: "main", at: None, by: owner, expires: None, system: false, now: at_second(30), alloc)
    let taken = attempt await mut store.branch(device, name: "feature", from: "main", at: None, by: owner, expires: None, system: false, now: at_second(30), alloc)
    expect reserved.is_err() and taken.is_err()
    try await mut store.delete_branch(device, name: "old", now: at_second(31), alloc)
    var mounted = try await Store.mount(device, volume_id: Array[u8, 16].filled(9), now: at_second(32), alloc)
    let kept = try await level_on(mut mounted, device, branch: "feature", text: "/data/x", alloc)
    let main_kept = try await level_on(mut mounted, device, branch: "main", text: "/data/x", alloc)
    expect kept == 5 and main_kept == 2
    let deleted = attempt mounted.branch_named("old", alloc)
    expect deleted.is_err()
} branches_share_their_fork_then_diverge

fn put_setting(text: Str, level: u32, label: Str, alloc: mem::Alloc) -> Write {
    return Write.Put(path: path_of(text, alloc), value: setting(level, label, alloc))
} put_setting

validator fn read_label(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> text::String {
    return match attempt mem::wire::Codec[Setting].decode(raw, alloc) {
        Ok(found) => found.label
        Err(_) => text::String.empty(alloc)
    }
} read_label

fn label_on(
    mut store: Store,
    device: disk::MemoryVolume,
    branch: Str,
    text: Str,
    alloc: mem::Alloc,
    ) -> text::String fails StoreError uses wait {
    let node = try await mut store.get(device, branch, path: path_of(text, alloc), now: at_second(100), alloc)
    let Some(value) = node.value else {
        return text::String.empty(alloc)
    }
    return read_label(value.view(), alloc)
} label_on

test diffs_list_edits_in_path_order for Store.diff {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    var opening = mem::List[Write].empty(alloc)
    mut opening.push(put("/data/a", level: 1, alloc))
    mut opening.push(put("/data/b", level: 2, alloc))
    discard try await commit_on(mut store, device, branch: "main", writes: take opening, alloc)
    var second = mem::List[Write].empty(alloc)
    mut second.push(put("/data/a", level: 3, alloc))
    mut second.push(Write.Delete(path: path_of("/data/b", alloc)))
    mut second.push(put("/data/c", level: 4, alloc))
    discard try await commit_on(mut store, device, branch: "main", writes: take second, alloc)
    let edits = try await mut store.diff(device, from: Point.Commit(branch: text::String.of("main", alloc), commit: ident::CommitId(number: 2)), to: Point.Head(text::String.of("main", alloc)), path: path_of("/data", alloc), alloc)
    expect edits.len() == 3
    expect edits[0].path.text.as_str() == "/data/a" and edits[0].change == Change.Changed and edits[0].fields.len() == 1
    expect edits[0].fields[0].field.as_str() == "level"
    expect edits[1].path.text.as_str() == "/data/b" and edits[1].change == Change.Removed
    expect edits[2].path.text.as_str() == "/data/c" and edits[2].change == Change.Added
    let none = try await mut store.diff(device, from: Point.Head(text::String.of("main", alloc)), to: Point.Head(text::String.of("main", alloc)), path: path_of("/", alloc), alloc)
    expect none.len() == 0
} diffs_list_edits_in_path_order

test reverts_restore_what_a_commit_changed for Store.revert {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/data/x", level: 1, alloc), alloc), alloc)
    var changing = mem::List[Write].empty(alloc)
    mut changing.push(put("/data/x", level: 2, alloc))
    mut changing.push(put("/data/y/new", level: 5, alloc))
    let changed = try await commit_on(mut store, device, branch: "main", writes: take changing, alloc)
    let dry = try await mut store.revert(device, branch: "main", commit: changed.number, dry_run: true, stamp: system_stamp(alloc), now: at_second(30), alloc)
    let Reverted.Writes(writes) = dry else {
        expect false
        return
    }
    expect writes.len() == 2
    discard try await mut store.revert(device, branch: "main", commit: changed.number, dry_run: false, stamp: system_stamp(alloc), now: at_second(31), alloc)
    let level = try await level_on(mut store, device, branch: "main", text: "/data/x", alloc)
    expect level == 1
    let gone = attempt await mut store.get(device, branch: "main", path: path_of("/data/y", alloc), now: at_second(32), alloc)
    expect gone.is_err()
    let later = try await commit_on(mut store, device, branch: "main", writes: single(put("/data/z", level: 1, alloc), alloc), alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/data/z", level: 2, alloc), alloc), alloc)
    let refused = attempt await mut store.revert(device, branch: "main", commit: later.number, dry_run: false, stamp: system_stamp(alloc), now: at_second(33), alloc)
    let conflicted = match refused {
        Err(StoreError.ConflictRevert(conflicts)) => conflicts.len() == 1
        else => false
    }
    expect conflicted
} reverts_restore_what_a_commit_changed

test merges_take_each_sides_changes for Store.merge {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put_setting("/data/shared", level: 1, label: "a", alloc), alloc), alloc)
    let owner = ident::Principal(text: text::Fixed[64].of("agent.ops"))
    discard try await mut store.branch(device, name: "feature", from: "main", at: None, by: owner, expires: None, system: false, now: at_second(30), alloc)
    var on_main = mem::List[Write].empty(alloc)
    mut on_main.push(put("/data/main-only", level: 1, alloc))
    mut on_main.push(put_setting("/data/shared", level: 1, label: "main", alloc))
    discard try await commit_on(mut store, device, branch: "main", writes: take on_main, alloc)
    var on_feature = mem::List[Write].empty(alloc)
    mut on_feature.push(put("/data/feature-only/deep", level: 2, alloc))
    mut on_feature.push(put_setting("/data/shared", level: 9, label: "a", alloc))
    discard try await commit_on(mut store, device, branch: "feature", writes: take on_feature, alloc)
    discard try await mut store.merge(device, target: "main", source: "feature", takes: mem::List.empty(alloc), fast_forward: true, stamp: system_stamp(alloc), now: at_second(31), alloc)
    let level = try await level_on(mut store, device, branch: "main", text: "/data/shared", alloc)
    let label = try await label_on(mut store, device, branch: "main", text: "/data/shared", alloc)
    let deep = try await level_on(mut store, device, branch: "main", text: "/data/feature-only/deep", alloc)
    let kept = try await level_on(mut store, device, branch: "main", text: "/data/main-only", alloc)
    expect level == 9 and label.as_str() == "main" and deep == 2 and kept == 1
    discard try await commit_on(mut store, device, branch: "main", writes: single(put_setting("/data/shared", level: 10, label: "main", alloc), alloc), alloc)
    discard try await commit_on(mut store, device, branch: "feature", writes: single(put_setting("/data/shared", level: 20, label: "a", alloc), alloc), alloc)
    let clash = attempt await mut store.merge(device, target: "main", source: "feature", takes: mem::List.empty(alloc), fast_forward: true, stamp: system_stamp(alloc), now: at_second(32), alloc)
    let field = match clash {
        Err(StoreError.ConflictMerge(conflicts)) => conflicts.len() == 1 and conflicts[0].field == Some(text::String.of("level", alloc))
        else => false
    }
    expect field
    var takes = mem::List[Take].empty(alloc)
    mut takes.push(Take(path: path_of("/data/shared", alloc), side: Side.Source))
    discard try await mut store.merge(device, target: "main", source: "feature", take takes, fast_forward: true, stamp: system_stamp(alloc), now: at_second(33), alloc)
    let taken = try await level_on(mut store, device, branch: "main", text: "/data/shared", alloc)
    expect taken == 20
} merges_take_each_sides_changes

test fast_forwards_move_the_target for Store.merge {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    let owner = ident::Principal(text: text::Fixed[64].of("agent.ops"))
    discard try await mut store.branch(device, name: "ahead", from: "main", at: None, by: owner, expires: None, system: false, now: at_second(30), alloc)
    let made = try await commit_on(mut store, device, branch: "ahead", writes: single(put("/data/x", level: 4, alloc), alloc), alloc)
    let merged = try await mut store.merge(device, target: "main", source: "ahead", takes: mem::List.empty(alloc), fast_forward: true, stamp: system_stamp(alloc), now: at_second(31), alloc)
    expect merged.number == made.number
    let level = try await level_on(mut store, device, branch: "main", text: "/data/x", alloc)
    expect level == 4
} fast_forwards_move_the_target

test previews_take_numbers_and_job_branches_are_replaced for Store.preview {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    let system = system_stamp(alloc).principal
    let first_preview = try await mut store.preview(device, from: "main", by: system, now: at_second(30), alloc)
    let second_preview = try await mut store.preview(device, from: "main", by: system, now: at_second(30), alloc)
    expect first_preview.name.as_str() == "preview/1" and second_preview.name.as_str() == "preview/2"
    try await mut store.delete_branch(device, name: "preview/2", now: at_second(31), alloc)
    var mounted = try await Store.mount(device, volume_id: Array[u8, 16].filled(9), now: at_second(32), alloc)
    let third_preview = try await mut mounted.preview(device, from: "main", by: system, now: at_second(33), alloc)
    expect third_preview.name.as_str() == "preview/3"
    discard try await mut mounted.branch(device, name: "job/app", from: "main", at: None, by: system, expires: None, system: true, now: at_second(34), alloc)
    discard try await commit_on(mut mounted, device, branch: "job/app", writes: single(put("/data/x", level: 4, alloc), alloc), alloc)
    discard try await mut mounted.branch(device, name: "job/app", from: "main", at: None, by: system, expires: None, system: true, now: at_second(35), alloc)
    let replaced = attempt await mut mounted.get(device, branch: "job/app", path: path_of("/data/x", alloc), now: at_second(36), alloc)
    expect replaced.is_err()
} previews_take_numbers_and_job_branches_are_replaced

/// The path change commit `number` recorded for the versioned node at `text` on `main`, 0 for none.
fn change_at(
    mut store: Store,
    device: disk::MemoryVolume,
    text: Str,
    number: u64,
    alloc: mem::Alloc,
    ) -> u8 fails StoreError uses wait {
    let segments = path_of(text, alloc).segments(alloc)
    let resolution = try await mut store.resolve(device, head: 0, segments: segments.view(), now: at_second(100), alloc)
    let last = segments.len() - 1
    let write = LogWrite(tree: TREE_VERSIONED, dir: resolution.dir_of(last), name: copied_bytes(segments[last].view(), alloc), entry: None)
    return match try await mut store.catalog_get(device, key: path_change_key(write, number, alloc).view(), alloc) {
        Some(bytes) => change_of(Untrusted.of(bytes.view()), alloc)
        None => 0
    }
} change_at

test path_changes_tell_creations_changes_and_deletions for Store.record_change {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    let made = try await commit_on(mut store, device, branch: "main", writes: single(put("/data/x", level: 1, alloc), alloc), alloc)
    let edited = try await commit_on(mut store, device, branch: "main", writes: single(put("/data/x", level: 2, alloc), alloc), alloc)
    let removed = try await commit_on(mut store, device, branch: "main", writes: single(Write.Delete(path: path_of("/data/x", alloc)), alloc), alloc)
    var twice = mem::List[Write].empty(alloc)
    mut twice.push(put("/data/y", level: 1, alloc))
    mut twice.push(put("/data/y", level: 2, alloc))
    let made_twice = try await commit_on(mut store, device, branch: "main", writes: take twice, alloc)
    var fleeting = mem::List[Write].empty(alloc)
    mut fleeting.push(put("/data/z", level: 1, alloc))
    mut fleeting.push(Write.Delete(path: path_of("/data/z", alloc)))
    let made_fleeting = try await commit_on(mut store, device, branch: "main", writes: take fleeting, alloc)
    let creation = try await change_at(mut store, device, text: "/data/x", number: made.number.number, alloc)
    let second = try await change_at(mut store, device, text: "/data/x", number: edited.number.number, alloc)
    let third = try await change_at(mut store, device, text: "/data/x", number: removed.number.number, alloc)
    let merged = try await change_at(mut store, device, text: "/data/y", number: made_twice.number.number, alloc)
    let cancelled = try await change_at(mut store, device, text: "/data/z", number: made_fleeting.number.number, alloc)
    expect creation == CHANGE_CREATED and second == CHANGE_CHANGED and third == CHANGE_DELETED
    expect merged == CHANGE_CREATED and cancelled == 0
} path_changes_tell_creations_changes_and_deletions

/// A record whose map has signed keys, whose zigzag wire bytes order unlike their values.
struct Limits derives Eq, Render, Encode {
    by_level: mem::Map[i32, u32]
} Limits

fn put_limits(text: Str, take by_level: mem::Map[i32, u32], alloc: mem::Alloc) -> Write {
    let value = Value.Record(type: TypeRef.of("store::Limits", schema: mem::wire::Codec[Limits].schema_hash(), alloc), bytes: wire_of(Limits(by_level: take by_level), alloc), secret: false)
    return Write.Put(path: path_of(text, alloc), value: take value)
} put_limits

/// The map of `-20` to `low`, when given, `-5` to `middle` and `3` to `high`.
fn levels(low: Option[u32], middle: u32, high: u32, alloc: mem::Alloc) -> mem::Map[i32, u32] {
    var by_level = mem::Map[i32, u32].empty(alloc)
    match low {
        Some(value) => {
            discard mut by_level.insert(-20, value)
        }
        None => {
        }
    }
    discard mut by_level.insert(-5, value: middle)
    discard mut by_level.insert(3, value: high)
    return by_level
} levels

validator fn read_limits(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[Limits] {
    return match attempt mem::wire::Codec[Limits].decode(raw, alloc) {
        Ok(found) => Some(take found)
        Err(_) => None
    }
} read_limits

/// The canonical bytes of what decodes as `Limits`.
fn limits_canonical(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails mem::wire::DecodeFailure limits terminates {
    return try mem::wire::Codec[Limits].canonical_located(raw, alloc)
} limits_canonical

test maps_merge_entry_by_entry_in_key_order for Store.merge {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    mut store.know("store::Limits", schema: mem::wire::Codec[Limits].schema(alloc), decoder: Decoder(schema: mem::wire::Codec[Limits].schema_hash(), canonical: limits_canonical), alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put_limits("/data/limits", by_level: levels(low: None, middle: 1, high: 1, alloc), alloc), alloc), alloc)
    discard try await mut store.branch(device, name: "feature", from: "main", at: None, by: system_stamp(alloc).principal, expires: None, system: false, now: at_second(30), alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put_limits("/data/limits", by_level: levels(low: None, middle: 2, high: 1, alloc), alloc), alloc), alloc)
    discard try await commit_on(mut store, device, branch: "feature", writes: single(put_limits("/data/limits", by_level: levels(low: Some(1), middle: 1, high: 7, alloc), alloc), alloc), alloc)
    discard try await mut store.merge(device, target: "main", source: "feature", takes: mem::List.empty(alloc), fast_forward: true, stamp: system_stamp(alloc), now: at_second(31), alloc)
    let node = try await mut store.get(device, branch: "main", path: path_of("/data/limits", alloc), now: at_second(32), alloc)
    let Some(bytes) = node.value else {
        expect false
        return
    }
    let Some(merged) = read_limits(bytes.view(), alloc) else {
        expect false
        return
    }
    expect merged.by_level.len() == 3 and merged.by_level.get(-20) == Some(1) and merged.by_level.get(-5) == Some(2) and merged.by_level.get(3) == Some(7)
} maps_merge_entry_by_entry_in_key_order

test branch_heads_keep_what_they_reach_out_of_history for Store.history_in_use {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    discard try await put_large(mut store, device, text: "/data/x", level: 1, stamp: system_stamp(alloc), alloc)
    try await mut store.index_flush(device, now: at_second(20), alloc)
    discard try await mut store.branch(device, name: "feature", from: "main", at: None, by: system_stamp(alloc).principal, expires: None, system: false, now: at_second(21), alloc)
    discard try await put_large(mut store, device, text: "/data/x", level: 2, stamp: system_stamp(alloc), alloc)
    try await mut store.index_flush(device, now: at_second(22), alloc)
    let shared = store.history_bytes
    try await mut store.delete_branch(device, name: "feature", now: at_second(23), alloc)
    expect shared < 1_048_576 and store.history_bytes > 2_097_152
} branch_heads_keep_what_they_reach_out_of_history

/// The segments below `/history` of `text`.
fn below_history(text: Str, alloc: mem::Alloc) -> mem::List[mem::Bytes] {
    return path_of(text, alloc).segments(alloc)
} below_history

validator fn commit_number(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> u64 {
    return match attempt mem::wire::Codec[CommitMeta].decode(raw, alloc) {
        Ok(meta) => meta.number.number
        Err(_) => 0
    }
} commit_number

validator fn pin_count(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> usize {
    return match attempt mem::wire::Codec[mem::List[Pin]].decode(raw, alloc) {
        Ok(pins) => pins.len()
        Err(_) => 0
    }
} pin_count

test history_reads_commits_branches_and_pins for Store.history_listing {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/data/x", level: 1, alloc), alloc), alloc)
    let owner = ident::Principal(text: text::Fixed[64].of("owner"))
    discard try await mut store.branch(device, name: "job/x", from: "main", at: None, by: owner, expires: None, system: true, now: at_second(30), alloc)
    try await mut store.pin(device, branch: "main", commit: ident::CommitId(number: 2), by: owner, note: None, now: at_second(31), alloc)
    let top = try await mut store.history_listing(device, segments: below_history("/", alloc).view(), after: None, limit: 8, alloc)
    expect top.entries.len() == 3 and top.entries[1].name.as_str() == "commits"
    let opening = try await mut store.history_listing(device, segments: below_history("/commits", alloc).view(), after: None, limit: 1, alloc)
    let Some(next) = opening.next else {
        expect false
        return
    }
    let second = try await mut store.history_listing(device, segments: below_history("/commits", alloc).view(), after: Some(take next), limit: 8, alloc)
    expect opening.entries[0].name.as_str() == "1" and second.entries.len() == 1 and second.entries[0].name.as_str() == "2"
    let commit = try await mut store.history_node(device, path: path_of("/history/commits/2", alloc), segments: below_history("/commits/2", alloc).view(), alloc)
    let Some(meta) = commit.value else {
        expect false
        return
    }
    let number = commit_number(meta.view(), alloc)
    expect commit.kind == NodeKind.Record and number == 2
    let branches = try await mut store.history_listing(device, segments: below_history("/branches", alloc).view(), after: None, limit: 8, alloc)
    expect branches.entries.len() == 2 and branches.entries[0].name.as_str() == "job" and branches.entries[0].kind == NodeKind.Dir and branches.entries[1].kind == NodeKind.Record
    let job = try await mut store.history_node(device, path: path_of("/history/branches/job/x", alloc), segments: below_history("/branches/job/x", alloc).view(), alloc)
    expect job.kind == NodeKind.Record and job.version.number == 2
    let pins = try await mut store.history_node(device, path: path_of("/history/pins/2", alloc), segments: below_history("/pins/2", alloc).view(), alloc)
    let Some(held) = pins.value else {
        expect false
        return
    }
    let count = pin_count(held.view(), alloc)
    expect count == 2
    let missing = attempt await mut store.history_node(device, path: path_of("/history/commits/9", alloc), segments: below_history("/commits/9", alloc).view(), alloc)
    expect missing.is_err()
} history_reads_commits_branches_and_pins

test reverts_read_past_thinned_unrecorded_parents for Store.revert {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/data/x", level: 1, alloc), alloc), alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/state/x", level: 1, alloc), alloc), alloc)
    let changed = try await commit_on(mut store, device, branch: "main", writes: single(put("/data/x", level: 2, alloc), alloc), alloc)
    discard try await commit_on(mut store, device, branch: "main", writes: single(put("/state/x", level: 2, alloc), alloc), alloc)
    try await mut store.index_flush(device, now: at_second(32), alloc)
    let system = system_stamp(alloc).principal
    let preview = try await mut store.preview(device, from: "main", by: system, now: at_second(33), alloc)
    let dry = try await mut store.revert(device, branch: preview.name.as_str(), commit: changed.number, dry_run: true, stamp: system_stamp(alloc), now: at_second(34), alloc)
    let Reverted.Writes(writes) = dry else {
        expect false
        return
    }
    expect writes.len() == 1
    discard try await mut store.revert(device, branch: "main", commit: changed.number, dry_run: false, stamp: system_stamp(alloc), now: at_second(35), alloc)
    let level = try await level_on(mut store, device, branch: "main", text: "/data/x", alloc)
    expect level == 1
} reverts_read_past_thinned_unrecorded_parents
