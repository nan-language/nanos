pub fn Service.subscribe(
    mut self,
    take view: View,
    take prefix: ident::Path,
    take since: ident::CommitId,
    take port: os::PortHandle,
    mut env: Env,
    mut cx: sys::Cx[Store],
    ) -> u64 fails Failure {
    let subscription = self.next_subscription
    self.next_subscription += 1
    fail mut self.queue(view, job: Job.Subscribe(subscription: subscription, prefix: take prefix, since: since, port: port), mut env, mut cx)
} Service.subscribe

