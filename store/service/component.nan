pub fn Service.merge(
    mut self,
    take view: View,
    take source: View,
    take takes: mem::List[store::Take],
    mut env: Env,
    mut cx: sys::Cx[Store],
    ) -> store::Committed fails Failure {
    let Some(from) = source.scoped(env.alloc) else {
        fail Failure.Revoked
    }
    fail mut self.queue(view, job: Job.Merge(source: take from, takes: take takes), mut env, mut cx)
} Service.merge

