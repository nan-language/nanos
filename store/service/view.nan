//! Views: the capabilities through which instances reach the store, each a subtree of one branch with its rights, held for a principal and the instance writing through it.

/// A View of the store.
pub open struct View {
} View

impl View: sys::Kind[Scope, Reach]

/// The bytes of the path a View's record holds below its root entry's subtree.
const BELOW_BYTES: usize = 240

/// What a View may do: read; write, which covers commits, appends, drafts, reverts and erasures; admin, which covers branches, merges, pins, scrubs and collections; read the plaintext of secret records; and own, which writes the nodes below `/sys` and `/state` that their owning operations write.
pub layout Rights: u8 {
    read: bit 0
    write: bit 1
    admin: bit 2
    secret_read: bit 3
    own: bit 4
    reserved: rest
} Rights

/// What a View reaches: the store's port, the subtree and branch of its grant, the principal on whose authority it acts, the instance or session writing through it, and the origin labels stamped on its commits.
struct Scope {
    store: os::PortHandle
    prefix: ident::Path
    branch: text::String
    principal: ident::Principal
    instance: Option[ident::Moniker]
    session: Option[ident::SessionId]
    origins: mem::List[ident::OriginLabel]
} Scope

/// What a View reaches within its root entry's scope: its rights, the commit it reads as of when `dated` is 1, and the path below the scope's subtree it is narrowed to, the first `length` bytes of `below`, each segment led by `/`.
layout Reach: bytes 256 le {
    rights: Rights at 0
    dated: u8 at 1
    length: u8 at 2
    reserved: Array[u8, 5] at 3
    as_of: u64 at 8
    below: Array[u8, 240] at 16
} Reach

/// The root entry the Views of one grant and holder derive from, revoked when it closes.
pub open linear struct MintedView derives Send {
    minter: sys::Minter[View, Scope, Reach]
} MintedView

/// Why a call through a View failed: the store's failure, a stale View, or a store that does not take calls.
pub closed enum ViewError {
    Failed(Failure)
    Revoked
    Unreachable
    Cancelled(task::Cancelled) from
} ViewError

/// The code of the failure: the store's, `port.revoked` for a stale View, `port.server-stopped` for a store that does not take calls, `task.cancelled` for a cancelled call.
pub fn ViewError.code(self) -> text::Fixed[32] {
    return match self {
        ViewError.Failed(failure) => failure.code()
        ViewError.Revoked => text::Fixed[32].of("port.revoked")
        ViewError.Unreachable => text::Fixed[32].of("port.server-stopped")
        ViewError.Cancelled(_) => text::Fixed[32].of("task.cancelled")
    }
} ViewError.code

/// Every right.
pub fn Rights.all() -> Rights = Rights(read: true, write: true, admin: true, secret_read: true, own: true, reserved: 0)

/// Reading alone.
pub fn Rights.reading() -> Rights = Rights(read: true, write: false, admin: false, secret_read: false, own: false, reserved: 0)

/// The rights of a `Tree` grant's rights `rights`: read, write, admin and secret-read as it holds them.
pub fn Rights.of(rights: mem::Set[os::Right]) -> Rights {
    return Rights(read: rights.contains(os::Right.Read), write: rights.contains(os::Right.Write), admin: rights.contains(os::Right.Admin), secret_read: rights.contains(os::Right.SecretRead), own: false, reserved: 0)
} Rights.of

/// A root entry of Views of the subtree `prefix` of `branch` through the store's port `store`, acting for `principal`, written through by `instance`.
pub fn MintedView.of(
    store: os::PortHandle,
    take prefix: ident::Path,
    branch: Str,
    take principal: ident::Principal,
    take instance: Option[ident::Moniker],
    alloc: mem::Alloc,
    ) -> MintedView {
    return MintedView.of_writer(store, take prefix, branch, take principal, take instance, session: None, origins: mem::List.empty(alloc), alloc)
} MintedView.of

/// A root entry of Views of the subtree `prefix` of `branch` through the store's port `store`, acting for `principal`, written through by `instance` or in `session`, stamping `origins` on its commits.
fn MintedView.of_writer(
    store: os::PortHandle,
    take prefix: ident::Path,
    branch: Str,
    take principal: ident::Principal,
    take instance: Option[ident::Moniker],
    session: Option[ident::SessionId],
    take origins: mem::List[ident::OriginLabel],
    alloc: mem::Alloc,
    ) -> MintedView {
    let scope = Scope(store: store, prefix: take prefix, branch: text::String.of(branch, alloc), principal: take principal, instance: take instance, session: session, origins: take origins)
    return MintedView(minter: sys::Minter[View, Scope, Reach].of(take scope, alloc))
} MintedView.of_writer

/// A View of the whole subtree with `rights`, reading at the head.
pub fn MintedView.mint(self, rights: Rights) -> View {
    return self.minter.mint(Reach(rights: rights, dated: 0, length: 0, reserved: Array[u8, 5].filled(0), as_of: 0, below: Array[u8, 240].filled(0)))
} MintedView.mint

/// Revokes every View of this root entry.
pub fn MintedView.close(take self) {
    let MintedView(minter: minter) = self
    take minter.close()
} MintedView.close

/// A View of the same subtree reading alone.
pub fn View.read_only(self) -> View fails sys::Revoked {
    return try sys::derive(self, narrow: fn(state: Scope, record: Reach) -> Reach {
        var narrowed = record
        narrowed.rights = Rights(read: record.rights.read, write: false, admin: false, secret_read: false, own: false, reserved: 0)
        return narrowed
    })
} View.read_only

/// A View of the subtree at `path` within this View's, with its rights and its commit; `store.too-large` when the paths it is narrowed to pass `BELOW_BYTES`.
pub fn View.below(self, take path: ident::Path, alloc: mem::Alloc) -> View fails ViewError {
    let Some(length) = sys::reach(self, body: fn(state: Scope, record: Reach) => record.length) else {
        fail ViewError.Revoked
    }
    var added = mem::Bytes.empty(alloc)
    for segment in take path.segments(alloc) {
        mut added.push(b'/')
        mut added.append(segment.view())
    }
    if usize.widen(length) + added.len() > BELOW_BYTES {
        fail ViewError.Failed(Failure.TooLarge)
    }
    let narrowed = attempt sys::derive(self, narrow: fn(state: Scope, record: Reach) -> Reach {
        var reach = record
        var tail = record.below
        var at = usize.widen(record.length)
        for byte in added.view() {
            if at < BELOW_BYTES {
                tail[at] = byte
                at += 1
            }
        }
        reach.below = tail
        reach.length = u8.truncate(at)
        return reach
    })
    return match narrowed {
        Ok(view) => view
        Err(_) => fail ViewError.Revoked
    }
} View.below

/// A View of the same subtree reading alone as of the commit `commit` of its branch, or as of this View's own commit when that is earlier.
pub fn View.at_commit(self, commit: ident::CommitId) -> View fails sys::Revoked {
    return try sys::derive(self, narrow: fn(state: Scope, record: Reach) -> Reach {
        var narrowed = record
        narrowed.rights = Rights(read: record.rights.read, write: false, admin: false, secret_read: record.rights.secret_read, own: false, reserved: 0)
        if record.dated == 0 or commit.number < record.as_of {
            narrowed.dated = 1
            narrowed.as_of = commit.number
        }
        return narrowed
    })
} View.at_commit

/// The scope a View gives the requests made through it, `None` once it is stale.
fn View.scoped(self, alloc: mem::Alloc) -> Option[Scoped] {
    let reached = sys::reach(self, body: fn(state: Scope, record: Reach) -> Option[Scoped] {
        var segments = state.prefix.segments(alloc)
        var segment = mem::Bytes.empty(alloc)
        var at: usize = 0
        while at < usize.widen(record.length) and at < BELOW_BYTES {
            let byte = record.below[at]
            if byte != b'/' {
                mut segment.push(byte)
            } else if segment.len() > 0 {
                mut segments.push(take segment)
                segment = mem::Bytes.empty(alloc)
            }
            at += 1
        }
        if segment.len() > 0 {
            mut segments.push(take segment)
        }
        let Some(prefix) = ident::Path.of_segments(segments.view(), alloc) else {
            return None
        }
        let instance = match state.instance {
            Some(moniker) => Some(ident::Moniker(text: moniker.text))
            None => None
        }
        let as_of = match record.dated == 1 {
            true => Some(ident::CommitId(number: record.as_of))
            false => None
        }
        return Some(Scoped(store: state.store, prefix: take prefix, branch: text::String.of(state.branch.as_str(), alloc), rights: record.rights.to_bits(), as_of: as_of, principal: ident::Principal(text: state.principal.text), instance: take instance, session: state.session, origins: labels_of(state.origins, alloc), cause: os::Header.current().named_cause()))
    })
    return match reached {
        Some(scoped) => scoped
        None => None
    }
} View.scoped

/// The node at `path` of the View's subtree, as of the commit `at` or at the head.
pub fn View.get(self, take path: ident::Path, at: Option[ident::CommitId], alloc: mem::Alloc) -> store::Node fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].get(mut call, view: self, take path, at)
    return try await self.call(take call, reply, alloc)
} View.get

/// A read-only mapping of at most `length` bytes of the blob at `path` from `offset`, as of the commit `at` or at the head.
pub fn View.map(
    self,
    take path: ident::Path,
    at: Option[ident::CommitId],
    offset: u64,
    length: u32,
    alloc: mem::Alloc,
    ) -> Mapping fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].map(mut call, view: self, take path, at, offset, length)
    return try await self.call(take call, reply, alloc)
} View.map

/// The children of the dir at `path` after the child named `after`, at most `limit`.
pub fn View.list(
    self,
    take path: ident::Path,
    take after: Option[text::String],
    limit: u32,
    alloc: mem::Alloc,
    ) -> store::Listing fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].list(mut call, view: self, take path, at: None, take after, limit)
    return try await self.call(take call, reply, alloc)
} View.list

/// The children of the dir at `path` named from `from` on and, unless `to` is empty, below `to`, at most `limit`, with their values.
pub fn View.scan(
    self,
    take path: ident::Path,
    take from: text::String,
    take to: text::String,
    limit: u32,
    alloc: mem::Alloc,
    ) -> mem::List[store::Node] fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].scan(mut call, view: self, take path, at: None, take from, take to, limit)
    return try await self.call(take call, reply, alloc)
} View.scan

/// Commits `transaction`, whose record values the types' derived encoders wrote when `typed`.
pub fn View.commit(self, take transaction: store::Transaction, typed: bool, alloc: mem::Alloc) -> store::Committed fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].commit(mut call, view: self, take transaction, typed)
    return try await self.call(take call, reply, alloc)
} View.commit

/// Appends `entries` to the stream at `path`, giving the sequence number of the earliest.
pub fn View.append(self, take path: ident::Path, take entries: mem::List[mem::Bytes], alloc: mem::Alloc) -> u64 fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].append(mut call, view: self, take path, take entries)
    return try await self.call(take call, reply, alloc)
} View.append

/// Has the store tell `port` of each commit after `since` changing a node below `prefix`, giving the subscription's number.
pub fn View.subscribe(
    self,
    take prefix: ident::Path,
    since: ident::CommitId,
    port: os::PortHandle,
    alloc: mem::Alloc,
    ) -> u64 fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].subscribe(mut call, view: self, take prefix, since, port)
    return try await self.call(take call, reply, alloc)
} View.subscribe

/// At most `length` bytes of the blob at `path` from `offset`, as of the commit `at` or at the head, its pieces checked against their keys.
pub fn View.read(
    self,
    take path: ident::Path,
    at: Option[ident::CommitId],
    offset: u64,
    length: u32,
    alloc: mem::Alloc,
    ) -> Untrusted[mem::Bytes] fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].read(mut call, view: self, take path, at, offset, length, verify: true)
    return try await self.call(take call, reply, alloc)
} View.read

/// At most `limit` entries of the stream at `path` from sequence number `from`, and how many before `from` it no longer keeps.
pub fn View.read_stream(
    self,
    take path: ident::Path,
    from: u64,
    limit: u32,
    alloc: mem::Alloc,
    ) -> store::StreamRead fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].read_stream(mut call, view: self, take path, from, limit)
    return try await self.call(take call, reply, alloc)
} View.read_stream

/// The commits that changed the node at `path` or below it, before `before` when given, newest first, at most `limit`.
pub fn View.history(
    self,
    take path: ident::Path,
    before: Option[ident::CommitId],
    limit: u32,
    alloc: mem::Alloc,
    ) -> mem::List[store::CommitMeta] fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].history(mut call, view: self, take path, before, limit)
    return try await self.call(take call, reply, alloc)
} View.history

/// The edits from `from` to `to` of the subtree at `path`, in path order.
pub fn View.diff(
    self,
    take from: store::Point,
    take to: store::Point,
    take path: ident::Path,
    alloc: mem::Alloc,
    ) -> mem::List[store::Edit] fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].diff(mut call, view: self, take from, take to, take path)
    return try await self.call(take call, reply, alloc)
} View.diff

/// Ends the subscription `subscription`.
pub fn View.unsubscribe(self, subscription: u64, alloc: mem::Alloc) fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].unsubscribe(mut call, view: self, subscription)
    try await self.call(take call, reply, alloc)
} View.unsubscribe

/// The store's usage.
pub fn View.stats(self, alloc: mem::Alloc) -> LiveStore fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].stats(mut call, view: self)
    return try await self.call(take call, reply, alloc)
} View.stats

/// Creates branch `name` at the commit `at` of the View's branch, or at its head.
pub fn View.branch(self, take name: text::String, at: Option[ident::CommitId], alloc: mem::Alloc) -> Branched fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].branch(mut call, view: self, take name, at)
    return try await self.call(take call, reply, alloc)
} View.branch

/// Creates branch `preview/<n>` at the head of the View's branch.
pub fn View.preview(self, alloc: mem::Alloc) -> Branched fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].preview(mut call, view: self)
    return try await self.call(take call, reply, alloc)
} View.preview

/// Deletes branch `name`, revoking the Views of it.
pub fn View.delete_branch(self, take name: text::String, alloc: mem::Alloc) fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].delete_branch(mut call, view: self, take name)
    try await self.call(take call, reply, alloc)
} View.delete_branch

/// Reverts the commit `commit` of the View's branch, or gives the writes reverting it when `dry_run`.
pub fn View.revert(self, commit: ident::CommitId, dry_run: bool, alloc: mem::Alloc) -> store::Reverted fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].revert(mut call, view: self, commit, dry_run)
    return try await self.call(take call, reply, alloc)
} View.revert

/// A View of the same subtree, branch and rights acting for `principal` in `session`, stamping `origins` on its commits.
pub fn View.acting(
    self,
    take principal: ident::Principal,
    session: ident::SessionId,
    take origins: mem::List[ident::OriginLabel],
    alloc: mem::Alloc,
    ) -> View fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].acting(mut call, view: self, take principal, session, take origins)
    let Acting(view: view) = try await self.call(take call, reply, alloc)
    return view
} View.acting

/// Opens a draft for a blob's bytes, giving its number.
pub fn View.draft(self, alloc: mem::Alloc) -> u64 fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].draft(mut call, view: self)
    return try await self.call(take call, reply, alloc)
} View.draft

/// Appends `bytes` to the draft `draft`.
pub fn View.draft_append(self, draft: u64, take bytes: mem::Bytes, alloc: mem::Alloc) fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].draft_append(mut call, view: self, draft, take bytes)
    try await self.call(take call, reply, alloc)
} View.draft_append

/// Closes the draft `draft` into a blob the store holds, `store.hash-mismatch` when its id is not `expected`.
pub fn View.draft_close(self, draft: u64, expected: Option[ident::HashValue], alloc: mem::Alloc) -> store::Closed fails ViewError uses wait {
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Store].draft_close(mut call, view: self, draft, expected)
    return try await self.call(take call, reply, alloc)
} View.draft_close

/// Calls the store through the port the View holds, with `call` naming the View.
fn View.call[R: Send](self, take call: sys::Encoded, reply: sys::Reply[R, Failure], alloc: mem::Alloc) -> R fails ViewError uses wait {
    let Some(handle) = sys::reach(self, body: fn(state: Scope, record: Reach) => state.store) else {
        fail ViewError.Revoked
    }
    let Some(port) = os::Port[Store].of(handle) else {
        fail ViewError.Unreachable
    }
    return match first attempt await port.call(take call, reply, alloc) {
        Ok(result) => result
        Err(os::PortError.Failed(failure)) => fail ViewError.Failed(take failure)
        Err(os::PortError.Revoked) => fail ViewError.Revoked
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        Err(_) => fail ViewError.Unreachable
    }
} View.call

/// A port reaching no store and a root entry of Views of its `/data` on a branch, for tests.
linear struct TestViews {
    port: os::MintedPort
    root: MintedView
} TestViews

fn TestViews.of(branch: Str, alloc: mem::Alloc) -> TestViews {
    let task::Channel(sender: intake, receiver: unread) = task::Channel[os::Call].bounded(1, alloc)
    discard unread
    let port = os::MintedPort.of(intake, gate: os::Gate.of(alloc), protocols: os::Protocols(own: sys::Wire[Store].hash(), serves: None), operations: None, credit: os::Credit(messages: 1, calls: 1), alloc)
    let root = MintedView.of(store: port.handle(), prefix: ident::Path(text: text::String.of("/data", alloc)), branch, principal: ident::Principal(text: text::Fixed[64].of("owner")), instance: None, alloc)
    return TestViews(port: take port, root: take root)
} TestViews.of

fn TestViews.close(take self) {
    let TestViews(port: port, root: root) = self
    take root.close()
    take port.close()
} TestViews.close

test views_narrow_to_subtrees_and_earlier_commits for View.scoped {
    let alloc = testing::world().alloc
    var views = TestViews.of(branch: "main", alloc)
    defer take views.close()
    let whole = views.root.mint(Rights.all())
    let Ok(notes) = attempt whole.below(ident::Path(text: text::String.of("/agent/notes", alloc)), alloc) else {
        expect false
        return
    }
    let Ok(dated) = attempt notes.at_commit(ident::CommitId(number: 7)) else {
        expect false
        return
    }
    let Ok(later) = attempt dated.at_commit(ident::CommitId(number: 9)) else {
        expect false
        return
    }
    var long = text::String.of("/", alloc)
    for _ in 0..<241u32 {
        mut long.push('a')
    }
    let refused = match attempt whole.below(ident::Path(text: take long), alloc) {
        Err(ViewError.Failed(Failure.TooLarge)) => true
        else => false
    }
    let Some(narrow) = later.scoped(alloc) else {
        expect false
        return
    }
    let Some(top) = whole.scoped(alloc) else {
        expect false
        return
    }
    let rights = Rights.from_bits(narrow.rights)
    expect narrow.prefix.text.as_str() == "/data/agent/notes" and narrow.as_of == Some(ident::CommitId(number: 7))
    expect rights.read and not rights.write and not rights.admin
    expect top.prefix.text.as_str() == "/data" and top.as_of.is_none() and Rights.from_bits(top.rights).write
    expect refused
    let working = ident::Cause.of(2, number: 9)
    let traced = os::Header.of_work(cause: working.bits | 0x8000_0000_0000_0000, slot: 3)
    let Some(caused) = try await sys::run_headed(traced.carried(), body: fn() -> Option[Scoped] {
        return whole.scoped(alloc)
    }) else {
        expect false
        return
    }
    let stamp = caused.stamp(typed: true, alloc)
    expect stamp.cause == working and top.cause == ident::Cause(bits: 0)
} views_narrow_to_subtrees_and_earlier_commits

/// A copy of `labels`.
fn labels_of(labels: mem::List[ident::OriginLabel], alloc: mem::Alloc) -> mem::List[ident::OriginLabel] {
    var copies = mem::List[ident::OriginLabel].empty(alloc)
    for label in labels {
        mut copies.push(ident::OriginLabel(text: label.text))
    }
    return copies
} labels_of
