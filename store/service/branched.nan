//! The Views of branches: the store mints a View of each branch a request creates, holding its root entry until the branch is deleted.

/// A branch's name and the root entry of its Views.
linear struct BranchRoot {
    name: text::String
    root: MintedView
} BranchRoot

/// The root entries of the Views of the branches requests created.
linear struct BranchRoots {
    roots: mem::List[BranchRoot]
} BranchRoots

fn BranchRoots.empty(alloc: mem::Alloc) -> BranchRoots {
    return BranchRoots(roots: mem::List.empty(alloc))
} BranchRoots.empty

/// A View of the branch `name` with the subtree, rights, principal and instance of `scope`.
fn BranchRoots.mint(mut self, scope: Scoped, name: Str, alloc: mem::Alloc) -> View {
    let instance = match scope.instance {
        Some(moniker) => Some(ident::Moniker(text: moniker.text))
        None => None
    }
    let root = MintedView.of(store: scope.store, prefix: ident::Path(text: text::String.of(scope.prefix.text.as_str(), alloc)), branch: name, principal: ident::Principal(text: scope.principal.text), take instance, alloc)
    let view = root.mint(Rights.from_bits(scope.rights))
    mut self.roots.push(BranchRoot(name: text::String.of(name, alloc), root: take root))
    return view
} BranchRoots.mint

/// Revokes the Views of the branch `name`.
fn BranchRoots.revoke(mut self, name: Str) {
    var at: usize = 0
    while at < self.roots.len() {
        if self.roots[at].name.as_str() == name {
            let BranchRoot(name: _, root: root) = mut self.roots.remove(at)
            take root.close()
        } else {
            at += 1
        }
    }
} BranchRoots.revoke

/// Revokes every View of a branch.
fn BranchRoots.close(take self) {
    let BranchRoots(roots: roots) = self
    for held in take roots {
        let BranchRoot(name: _, root: root) = held
        take root.close()
    }
} BranchRoots.close
