//! The `store` instance: the `Store` protocol served through Views, each request handed to one sequencer task that holds the engine on the volume of the `store-volume` role.

/// What `store` serves: the operations of chapter 11 through Views, paths lying within each View's subtree, `/` naming its root; and the messages of its sequencer.
pub protocol Store {
    /// The node at `path`, as of the commit `at` or at the head.
    pub fn get(view: View, path: ident::Path, at: Option[ident::CommitId]) -> store::Node fails Failure limits traceless
    /// The children of the dir at `path` after the child named `after`, at most `limit`.
    pub fn list(
        view: View,
        path: ident::Path,
        at: Option[ident::CommitId],
        after: Option[text::String],
        limit: u32,
        ) -> store::Listing fails Failure limits traceless
    /// The count and bytes of the children of the dir at `path` named from `from` on and, unless `to` is empty, below `to`.
    pub fn count(view: View, path: ident::Path, from: text::String, to: text::String) -> store::Count fails Failure limits traceless
    /// The children of the dir at `path` named from `from` on and, unless `to` is empty, below `to`, at most `limit`, with their values.
    pub fn scan(
        view: View,
        path: ident::Path,
        at: Option[ident::CommitId],
        from: text::String,
        to: text::String,
        limit: u32,
        ) -> mem::List[store::Node] fails Failure limits traceless
    /// At most `length` bytes of the blob at `path` from `offset`, as of the commit `at` or at the head, its pieces checked against their keys when `verify`.
    pub fn read(
        view: View,
        path: ident::Path,
        at: Option[ident::CommitId],
        offset: u64,
        length: u32,
        verify: bool,
        ) -> Untrusted[mem::Bytes] fails Failure limits traceless
    /// A read-only mapping of at most `length` bytes of the blob at `path` from `offset`, as of the commit `at` or at the head, which reads its pieces in place.
    pub fn map(
        view: View,
        path: ident::Path,
        at: Option[ident::CommitId],
        offset: u64,
        length: u32,
        ) -> Mapping fails Failure limits traceless
    pub fn draft(view: View) -> u64 fails Failure limits traceless
    pub fn draft_append(view: View, draft: u64, bytes: mem::Bytes) fails Failure limits traceless
    pub fn draft_close(view: View, draft: u64, expected: Option[ident::HashValue]) -> store::Closed fails Failure limits traceless
    /// Commits `transaction`, whose record values their types' derived encoders wrote when `typed`.
    pub fn commit(view: View, transaction: store::Transaction, typed: bool) -> store::Committed fails Failure limits recorded
    /// Appends `entries` to the stream at `path`, giving the sequence number of the earliest.
    pub fn append(view: View, path: ident::Path, entries: mem::List[mem::Bytes]) -> u64 fails Failure limits traceless
    pub fn read_stream(view: View, path: ident::Path, from: u64, limit: u32) -> store::StreamRead fails Failure limits traceless
    /// Has the store send `port` a `Watcher` message for each commit after `since` that changes a node below `prefix`, giving the subscription's number.
    pub fn subscribe(view: View, prefix: ident::Path, since: ident::CommitId, port: os::PortHandle) -> u64 fails Failure limits traceless
    pub fn unsubscribe(view: View, subscription: u64) fails Failure limits traceless
    /// The commits that changed the node at `path` or below it, before `before` when given, newest first, at most `limit`.
    pub fn history(view: View, path: ident::Path, before: Option[ident::CommitId], limit: u32) -> mem::List[store::CommitMeta] fails Failure limits traceless
    pub fn diff(view: View, from: store::Point, to: store::Point, path: ident::Path) -> mem::List[store::Edit] fails Failure limits traceless
    /// Creates branch `name` at the commit `at` of the View's branch, or at its head, and gives its record and a View of it with the View's subtree and rights.
    pub fn branch(view: View, name: text::String, at: Option[ident::CommitId]) -> Branched fails Failure limits recorded
    pub fn delete_branch(view: View, name: text::String) fails Failure limits irreversible(erase)
    /// Merges the branch of `source` into the View's, taking each side `takes` names for its conflicts.
    pub fn merge(view: View, source: View, takes: mem::List[store::Take]) -> store::Committed fails Failure limits recorded
    pub fn revert(view: View, commit: ident::CommitId, dry_run: bool) -> store::Reverted fails Failure limits recorded
    /// Destroys the key of the secret record at `path`, then deletes it from the View's branch.
    pub fn erase(view: View, path: ident::Path) -> store::Committed fails Failure limits irreversible(erase)
    pub fn pin(view: View, commit: ident::CommitId, note: Option[text::String]) fails Failure limits restorable
    pub fn unpin(view: View, commit: ident::CommitId) fails Failure limits irreversible(erase)
    pub fn scrub(view: View) -> store::ScrubReport fails Failure limits traceless
    pub fn gc(view: View) -> store::Collected fails Failure limits traceless
    pub fn stats(view: View) -> LiveStore fails Failure limits traceless
    fn mounted(failure: Option[Failure]) limits recorded
    fn answered(request: u64, reply: sys::Encoded) limits recorded
} Store

/// What `store` sends the port of a subscription: a commit changing nodes below its prefix, with at most 64 of their paths and the count of the rest; an append to a stream below it; and the commits it could not tell of.
pub protocol Watcher {
    pub fn changed(subscription: u64, commit: ident::CommitId, paths: mem::List[ident::Path], more: u64) limits traceless
    pub fn appended(subscription: u64, path: ident::Path, seq: u64) limits traceless
    pub fn lost(subscription: u64, commits: u64) limits traceless
} Watcher

/// Why a store operation failed, as its reply carries it: a code of the `store`, `schema` and `conflict` families, `request.key-reused`, or a View gone stale.
pub closed enum Failure derives Eq, Render, Encode {
    NotFound
    Erased
    Denied
    Kind
    TooLarge
    Full
    Thinned(retained: u64)
    Unversioned
    HashMismatch
    ReadOnly
    BranchExists
    BranchReserved
    Corrupt
    Io
    NoVolume
    FormatUnsupported
    Locked
    ConflictWrite
    ConflictRead
    ConflictExpect
    ConflictMerge(conflicts: mem::List[store::Conflict])
    ConflictRevert(conflicts: mem::List[store::Conflict])
    SchemaInvalid(path: text::String)
    SchemaMismatch
    SchemaUnknown
    KeyReused
    Revoked
} Failure

/// The store as `/live/store` shows it: where it lies and the store partitions left unused, its bytes of capacity, in use, of history, of agents and free, its format, whether it is encrypted, its latest commit, branches and pins, the log bytes replayed at mount, its latest index flush, free segments and latest scrub.
pub closed struct LiveStore derives Render, Encode {
    pub placement: text::String
    pub others: mem::List[text::String]
    pub capacity: u64
    pub used: u64
    pub history: u64
    pub agents: u64
    pub free: u64
    pub format: u32
    pub encrypted: bool
    pub head: u64
    pub branches: u32
    pub pins: u32
    pub replayed: u64
    pub flushed: ident::WallTime
    pub free_segments: u32
    pub scrub: Option[store::ScrubReport]
    pub as_of: u64
} LiveStore

/// The code of the failure: `store.*`, `schema.*`, `conflict.*`, `request.key-reused`, or `auth.revoked` for a stale View.
pub fn Failure.code(self) -> text::Fixed[32] {
    return text::Fixed[32].of(match self {
        Failure.NotFound => "store.not-found"
        Failure.Denied => "store.denied"
        Failure.Kind => "store.kind"
        Failure.TooLarge => "store.too-large"
        Failure.Full => "store.full"
        Failure.Thinned(retained: _) => "store.thinned"
        Failure.Unversioned => "store.unversioned"
        Failure.Erased => "store.erased"
        Failure.HashMismatch => "store.hash-mismatch"
        Failure.ReadOnly => "store.read-only"
        Failure.BranchExists => "store.branch-exists"
        Failure.BranchReserved => "store.branch-reserved"
        Failure.Corrupt => "store.corrupt"
        Failure.Io => "store.io"
        Failure.NoVolume => "store.no-volume"
        Failure.FormatUnsupported => "store.format-unsupported"
        Failure.Locked => "store.locked"
        Failure.ConflictWrite => "conflict.write"
        Failure.ConflictRead => "conflict.read"
        Failure.ConflictExpect => "conflict.expect"
        Failure.ConflictMerge(conflicts: _) => "conflict.merge"
        Failure.ConflictRevert(conflicts: _) => "conflict.revert"
        Failure.SchemaInvalid(path: _) => "schema.invalid"
        Failure.SchemaMismatch => "schema.mismatch"
        Failure.SchemaUnknown => "schema.unknown"
        Failure.KeyReused => "request.key-reused"
        Failure.Revoked => "auth.revoked"
    })
} Failure.code

/// The failure a store error gives its caller.
pub fn Failure.of(take error: store::StoreError) -> Failure {
    return match error {
        store::StoreError.NotFound => Failure.NotFound
        store::StoreError.Denied => Failure.Denied
        store::StoreError.Kind => Failure.Kind
        store::StoreError.TooLarge => Failure.TooLarge
        store::StoreError.Full => Failure.Full
        store::StoreError.Thinned(retained: retained) => Failure.Thinned(retained: retained)
        store::StoreError.Unversioned => Failure.Unversioned
        store::StoreError.Erased => Failure.Erased
        store::StoreError.HashMismatch => Failure.HashMismatch
        store::StoreError.ReadOnly => Failure.ReadOnly
        store::StoreError.BranchExists => Failure.BranchExists
        store::StoreError.BranchReserved => Failure.BranchReserved
        store::StoreError.Corrupt => Failure.Corrupt
        store::StoreError.Io or store::StoreError.Cancelled(_) => Failure.Io
        store::StoreError.NoVolume => Failure.NoVolume
        store::StoreError.FormatUnsupported => Failure.FormatUnsupported
        store::StoreError.Locked => Failure.Locked
        store::StoreError.ConflictWrite => Failure.ConflictWrite
        store::StoreError.ConflictRead => Failure.ConflictRead
        store::StoreError.ConflictExpect => Failure.ConflictExpect
        store::StoreError.ConflictMerge(conflicts) => Failure.ConflictMerge(conflicts: take conflicts)
        store::StoreError.ConflictRevert(conflicts) => Failure.ConflictRevert(conflicts: take conflicts)
        store::StoreError.SchemaInvalid(mem::wire::DecodeFailure.At(error: _, path: path)) => Failure.SchemaInvalid(path: take path)
        store::StoreError.SchemaMismatch => Failure.SchemaMismatch
        store::StoreError.SchemaUnknown => Failure.SchemaUnknown
        store::StoreError.KeyReused => Failure.KeyReused
    }
} Failure.of
