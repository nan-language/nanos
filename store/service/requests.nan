/// The store's usage as `/live/store` shows it.
fn Sequencer.stats(mut self, scope: Scoped, world: Surroundings) -> Result[LiveStore, Failure] fails task::Cancelled uses wait {
    if (attempt scope.check(need: Need.Read)).is_err() {
        return Err(Failure.Denied)
    }
    let alloc = world.alloc
    let usage = match try settled(attempt await mut self.engine.stats(self.volume, alloc)) {
        Ok(found) => found
        Err(failure) => return Err(take failure)
    }
    let store::Usage(capacity: capacity, used: used, history: history, agents: agents, free: free, format: format, head: head, branches: branches, pins: pins, replayed: replayed, flushed: flushed, free_segments: free_segments, scrub: scrub) = usage
    return Ok(LiveStore(placement: text::String.of("store-volume", alloc), others: mem::List.empty(alloc), capacity: capacity, used: used, history: history, agents: agents, free: free, format: format, encrypted: false, head: head.number, branches: branches, pins: pins, replayed: replayed, flushed: flushed, free_segments: free_segments, scrub: take scrub))
} Sequencer.stats
