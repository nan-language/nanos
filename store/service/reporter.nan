//! The reporter: the capability through which the store tells the core its events, which the core prints until `journal` runs, a failed mount, which halts the kernel, the bytes its blob cache and its index nodes hold, which the memory summary shows, and the grants of `/sys/grants`, which the core holds as its live grants.

/// A capability sending the store's reports to the core.
pub open struct Reporter {
} Reporter

impl Reporter: sys::Kind[Reports, u8]

/// What the store tells the core: an event of its engine, the code of the failure that ended its mount, the bytes its blob cache or its index nodes hold since they last changed, or grants of `/sys/grants`.
pub closed enum Report {
    Event(store::Event)
    MountFailed(code: text::Fixed[32])
    BlobCache(bytes: u64)
    StoreCache(bytes: u64)
    Grants(os::Granted)
} Report

/// Where a reporter's reports go.
struct Reports {
    events: task::Sender[Report]
} Reports

/// The root entry the reporters of the core derive from, revoked when it closes.
pub open linear struct MintedReporter derives Send {
    minter: sys::Minter[Reporter, Reports, u8]
} MintedReporter

/// A root entry of reporters sending to `events`.
pub fn MintedReporter.of(events: task::Sender[Report], alloc: mem::Alloc) -> MintedReporter {
    return MintedReporter(minter: sys::Minter[Reporter, Reports, u8].of(Reports(events: events.split()), alloc))
} MintedReporter.of

pub fn MintedReporter.mint(self) -> Reporter {
    return self.minter.mint(0)
} MintedReporter.mint

/// Revokes every reporter of this root entry.
pub fn MintedReporter.close(take self) {
    let MintedReporter(minter: minter) = self
    take minter.close()
} MintedReporter.close

/// Tells the core of `report`; nothing once the reporter is stale or the core no longer listens.
pub fn Reporter.report(self, take report: Report) fails task::Cancelled uses wait {
    let Some(events) = sys::reach(self, body: fn(state: Reports, record: u8) => state.events.split()) else {
        return
    }
    match attempt await events.send(take report) {
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} Reporter.report

/// Tells the core of `grants`, the grants of `/sys/grants` on `main` by number, `None` for one removed, every grant when `whole`, and waits until its live grants hold them; nothing once the reporter is stale or the core no longer listens.
pub fn Reporter.grants(self, take grants: mem::Map[u64, Option[os::Grant]], whole: bool, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let task::Channel(sender: applied, receiver: held) = task::Channel[Unit].bounded(1, alloc)
    try await self.report(Report.Grants(os::Granted(grants: take grants, whole: whole, applied: take applied)))
    var receiver = held
    discard try await mut receiver.receive()
} Reporter.grants
