//! The reporter: the capability through which the store tells the core its events, which the core prints until `journal` runs, and a failed mount, which halts the kernel.

/// A capability sending the store's reports to the core.
pub open struct Reporter {
} Reporter

impl Reporter: sys::Kind[Reports, u8]

/// What the store tells the core: an event of its engine, or the code of the failure that ended its mount.
pub closed enum Report {
    Event(store::Event)
    MountFailed(code: text::Fixed[32])
} Report

/// Where a reporter's reports go.
struct Reports {
    events: task::Sender[Report]
} Reports

/// The root entry the reporters of the core derive from, revoked when it closes.
pub open linear struct MintedReporter derives Send {
    minter: sys::Minter[Reporter, Reports, u8]
} MintedReporter

/// A root entry of reporters sending to `events`.
pub fn MintedReporter.of(events: task::Sender[Report], alloc: mem::Alloc) -> MintedReporter {
    return MintedReporter(minter: sys::Minter[Reporter, Reports, u8].of(Reports(events: events.split()), alloc))
} MintedReporter.of

pub fn MintedReporter.mint(self) -> Reporter {
    return self.minter.mint(0)
} MintedReporter.mint

/// Revokes every reporter of this root entry.
pub fn MintedReporter.close(take self) {
    let MintedReporter(minter: minter) = self
    take minter.close()
} MintedReporter.close

/// Tells the core of `report`; nothing once the reporter is stale or the core no longer listens.
pub fn Reporter.report(self, take report: Report) fails task::Cancelled uses wait {
    let Some(events) = sys::reach(self, body: fn(state: Reports, record: u8) => state.events.split()) else {
        return
    }
    match attempt await events.send(take report) {
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} Reporter.report
