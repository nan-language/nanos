//! Sealing: the protocol through which `store` has `keys` seal the values of secret records and keep the volume key, and the secrets the store's commits draw on.

/// What `store` asks of `keys`: for a secret record, the envelope of `value`, a record of schema `schema`, sealed as the secret `secret` whose keyring slot holds `seed`; a new volume key; and the volume key a superblock's binding seals.
pub protocol Sealing {
    pub fn seal_secret(secret: u64, seed: Array[u8, 32], schema: ident::HashValue, value: mem::Bytes) -> mem::Bytes fails Failure limits traceless
    pub fn volume_key() -> VolumeKey fails Failure limits traceless
    pub fn open_volume(sealed: mem::Bytes) -> Array[u8, 32] fails Failure limits traceless
} Sealing

/// A volume key, and its sealing by the TPM, which binds it to no PCR.
pub closed struct VolumeKey derives Encode {
    pub key: Array[u8, 32]
    pub sealed: mem::Bytes
} VolumeKey

/// The secrets of the store's commits: seeds from its random source, and envelopes from `keys` through its port, `store.denied` without one, the calls drawn through `transport`.
struct Sealer derives Copy {
    keys: Option[os::Port[Sealing]]
    random: sys::Random
    transport: mem::Alloc
} Sealer

impl Sealer: store::Secrets

fn Sealer.seed(self) -> Array[u8, 32] {
    var seed = Array[u8, 32].filled(0)
    discard attempt self.random.fill(mut seed.view_mut())
    return seed
} Sealer.seed

fn Sealer.seal(
    self,
    secret: u64,
    seed: Array[u8, 32],
    schema: ident::HashValue,
    value: Slice[u8],
    alloc: mem::Alloc,
    ) -> mem::Bytes fails store::StoreError uses wait {
    let Some(port) = self.keys else {
        fail store::StoreError.Denied
    }
    var bytes = mem::Bytes.empty(self.transport)
    mut bytes.append(value)
    var call = sys::Encoded.empty(self.transport)
    let reply = sys::Wire[Sealing].seal_secret(mut call, secret, seed, schema, value: take bytes)
    return match first attempt await port.call(take call, reply, alloc) {
        Ok(envelope) => envelope
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        Err(_) => fail store::StoreError.Denied
    }
} Sealer.seal

/// The volume key `keys` unseals of the binding `sealed`: `store.locked` when it does not, or without `keys`.
fn Sealer.open_volume(self, take sealed: mem::Bytes, alloc: mem::Alloc) -> Array[u8, 32] fails store::StoreError uses wait {
    let Some(port) = self.keys else {
        fail store::StoreError.Locked
    }
    var call = sys::Encoded.empty(self.transport)
    let reply = sys::Wire[Sealing].open_volume(mut call, take sealed)
    return match first attempt await port.call(take call, reply, alloc) {
        Ok(key) => key
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        Err(_) => fail store::StoreError.Locked
    }
} Sealer.open_volume

/// A new volume key and its sealing from `keys`: `store.locked` when the TPM does not seal it, or without `keys`.
fn Sealer.volume_key(self, alloc: mem::Alloc) -> VolumeKey fails store::StoreError uses wait {
    let Some(port) = self.keys else {
        fail store::StoreError.Locked
    }
    var call = sys::Encoded.empty(self.transport)
    let reply = sys::Wire[Sealing].volume_key(mut call)
    return match first attempt await port.call(take call, reply, alloc) {
        Ok(made) => made
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        Err(_) => fail store::StoreError.Locked
    }
} Sealer.volume_key
