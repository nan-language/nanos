//! Sealing: the protocol through which `store` has `keys` seal the values of secret records, and the secrets the store's commits draw on.

/// What `store` asks of `keys` for a secret record: the envelope of `value`, a record of schema `schema`, sealed as the secret `secret` whose keyring slot holds `seed`.
pub protocol Sealing {
    pub fn seal_secret(secret: u64, seed: Array[u8, 32], schema: ident::HashValue, value: mem::Bytes) -> mem::Bytes fails Failure limits traceless
} Sealing

/// The secrets of the store's commits: seeds from its random source, and envelopes from `keys` through its port, `store.denied` without one.
struct Sealer derives Copy {
    keys: Option[os::Port[Sealing]]
    random: sys::Random
} Sealer

impl Sealer: store::Secrets

fn Sealer.seed(self) -> Array[u8, 32] {
    var seed = Array[u8, 32].filled(0)
    discard attempt self.random.fill(mut seed.view_mut())
    return seed
} Sealer.seed

fn Sealer.seal(
    self,
    secret: u64,
    seed: Array[u8, 32],
    schema: ident::HashValue,
    value: Slice[u8],
    alloc: mem::Alloc,
    ) -> mem::Bytes fails store::StoreError uses wait {
    let Some(port) = self.keys else {
        fail store::StoreError.Denied
    }
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(value)
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[Sealing].seal_secret(mut call, secret, seed, schema, value: take bytes)
    return match first attempt await port.call(take call, reply, alloc) {
        Ok(envelope) => envelope
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        Err(_) => fail store::StoreError.Denied
    }
} Sealer.seal
