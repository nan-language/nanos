//! Mappings: read-only views of a range of a blob, which read its pieces in place in the store's blob cache.

/// The mappings the store holds at once, the oldest revoked when another is made.
const MOST_MAPPINGS: usize = 64

/// A read-only view of a range of a blob.
pub open struct Mapping {
} Mapping

impl Mapping: sys::Kind[store::MappedPieces, u8]

/// The length of the range, 0 once the mapping is stale.
pub fn Mapping.len(self) -> u64 {
    return sys::reach(self, body: fn(state: store::MappedPieces, record: u8) => state.length).value_or(0)
} Mapping.len

/// The `length` bytes of the range from `at`, fewer past its end; `None` once the mapping is stale.
pub fn Mapping.read(self, at: u64, length: u32, alloc: mem::Alloc) -> Option[Untrusted[mem::Bytes]] {
    return sys::reach(self, body: fn(state: store::MappedPieces, record: u8) -> Untrusted[mem::Bytes] {
        var out = Untrusted.of(mem::Bytes.empty(alloc))
        if at >= state.length {
            return out
        }
        let piece_bytes = u64.widen(ident::PIECE_BYTES)
        var from = state.start + at
        var left = u64.widen(length)
        if left > state.length - at {
            left = state.length - at
        }
        while left > 0 {
            let index = usize.widen(from / piece_bytes)
            if index >= state.pieces.len() {
                break
            }
            let piece = state.pieces[index].contents()
            let inside = usize.widen(from % piece_bytes)
            let Some(parts) = piece.view().split_at(inside) else {
                break
            }
            var count = parts.tail.byte_len()
            if u64.widen(count) > left {
                count = usize.widen(left)
            }
            let Some(taken) = parts.tail.prefix(count) else {
                break
            }
            mut out.append(taken)
            from += u64.widen(count)
            left -= u64.widen(count)
        }
        return out
    })
} Mapping.read

/// The root entries of the mappings the store made, the oldest first.
linear struct Mappings {
    minters: mem::List[sys::Minter[Mapping, store::MappedPieces, u8]]
} Mappings

fn Mappings.empty(alloc: mem::Alloc) -> Mappings {
    return Mappings(minters: mem::List.empty(alloc))
} Mappings.empty

/// A mapping of `mapped`, revoking the oldest once the store holds `MOST_MAPPINGS`.
fn Mappings.mint(mut self, take mapped: store::MappedPieces, alloc: mem::Alloc) -> Mapping {
    if self.minters.len() >= MOST_MAPPINGS {
        let oldest = mut self.minters.remove(0)
        take oldest.close()
    }
    let minter = sys::Minter[Mapping, store::MappedPieces, u8].of(take mapped, alloc)
    let mapping = minter.mint(0)
    mut self.minters.push(take minter)
    return mapping
} Mappings.mint

/// Revokes every mapping.
fn Mappings.close(take self) {
    let Mappings(minters: minters) = self
    for minter in take minters {
        take minter.close()
    }
} Mappings.close
