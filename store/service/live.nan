//! `/live` as the store serves it: the records the core's board holds, read through the store's `Live` capability, and the store's own record, which it publishes there.

/// The type of the store's record.
const LIVE_STORE_TYPE: Str = "store::service::LiveStore"

/// Publishes the record of `/live/store`.
fn Sequencer.show(mut self, world: Surroundings) fails task::Cancelled uses wait {
    let Ok(record) = try await mut self.live_store(world) else {
        return
    }
    try await world.live.publish(type: LIVE_STORE_TYPE, value: record, alloc: world.alloc)
} Sequencer.show

/// The node at `path` below `/live`: the record published there, else a node with the children records lie at.
fn live_node(world: Surroundings, path: ident::Path) -> Result[store::Node, Failure] fails task::Cancelled uses wait {
    let alloc = world.alloc
    let node = ident::Path(text: text::String.of(path.text.as_str(), alloc))
    match try await world.live.get(path.text.as_str(), alloc) {
        Some(record) => {
            let size = u64.widen(record.bytes.len())
            let declared = store::TypeRef.of(record.type.as_str(), schema: record.schema, alloc)
            return Ok(store::Node(path: take node, kind: store::NodeKind.Record, version: ident::CommitId(number: 0), subtree: None, declared: Some(take declared), hash: None, size: size, next: 0, origins: mem::List.empty(alloc), secret: false, expires: None, declaration: None, value: Some(Untrusted.of(take record.bytes))))
        }
        None => {
        }
    }
    let children = try await world.live.list(path.text.as_str(), after: None, limit: 0xFFFF_FFFF, alloc)
    if children.len() == 0 {
        return Err(Failure.NotFound)
    }
    return Ok(store::Node(path: take node, kind: store::NodeKind.Dir, version: ident::CommitId(number: 0), subtree: None, declared: None, hash: None, size: u64.widen(children.len()), next: 0, origins: mem::List.empty(alloc), secret: false, expires: None, declaration: None, value: None))
} live_node

/// The children of the node at `path` below `/live` named after `after`, at most `limit`: each a record when one is published there, else a dir.
fn live_listing(world: Surroundings, path: ident::Path, take after: Option[text::String], limit: u32) -> Result[store::Listing, Failure] fails task::Cancelled uses wait {
    let alloc = world.alloc
    let found = try await world.live.list(path.text.as_str(), take after, limit: limit.saturating_add(1), alloc)
    if found.len() == 0 {
        return match try await live_node(world, path) {
            Ok(node) => match node.kind {
                store::NodeKind.Dir => Ok(store::Listing(entries: mem::List.empty(alloc), next: None))
                else => Err(Failure.Kind)
            }
            Err(failure) => Err(take failure)
        }
    }
    var entries = mem::List[store::Entry].empty(alloc)
    for child in take found {
        let os::LiveEntry(name: name, type: type, parent: _) = child
        let kind = match type.is_some() {
            true => store::NodeKind.Record
            false => store::NodeKind.Dir
        }
        mut entries.push(store::Entry(name: take name, kind: kind, version: ident::CommitId(number: 0), size: 0, type: take type))
    }
    var next: Option[text::String] = None
    if entries.len() > usize.widen(limit) {
        mut entries.truncate(usize.widen(limit))
        if entries.len() > 0 {
            next = Some(text::String.of(entries[entries.len() - 1].name.as_str(), alloc))
        }
    }
    return Ok(store::Listing(entries: take entries, next: take next))
} live_listing

/// The monotonic time in nanoseconds, 0 through a revoked clock.
fn now_ns(clock: sys::Clock) -> u64 {
    return match attempt clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
} now_ns
