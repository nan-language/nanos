//! Diffs: the edits between a subtree at two points, in path order, each shared subtree skipped by its versions, a record's differing fields with their wire bytes.

/// A point a diff compares: a branch's head, or a retained commit of a branch's line.
pub closed enum Point {
    Head(text::String)
    Commit(branch: text::String, commit: ident::CommitId)
} Point

/// The edits from point `from` to point `to` of the subtree at `path`, in path order.
pub fn Store.diff[D: disk::Device](
    mut self,
    device: D,
    from: Point,
    to: Point,
    path: ident::Path,
    alloc: mem::Alloc,
    ) -> mem::List[Edit] fails StoreError uses wait {
    let old = try await mut self.point_snapshot(device, point: from, alloc)
    let new = try await mut self.point_snapshot(device, point: to, alloc)
    let segments = path.segments(alloc)
    var edits = mem::List[Edit].empty(alloc)
    if segments.len() == 0 {
        try await mut self.diff_dirs(device, old, new, path, before: TOP_DIR, after: TOP_DIR, mut edits, alloc)
        return edits
    }
    let before = try await mut self.snapshot_resolve(device, snapshot: old, segments: segments.view(), alloc)
    let after = try await mut self.snapshot_resolve(device, snapshot: new, segments: segments.view(), alloc)
    try await mut self.diff_entries(device, old, new, path, before, after, mut edits, alloc)
    return edits
} Store.diff

/// The snapshot a point names.
fn Store.point_snapshot[D: disk::Device](mut self, device: D, point: Point, alloc: mem::Alloc) -> Snapshot fails StoreError uses wait {
    var name = text::String.empty(alloc)
    var at: Option[u64] = None
    match point {
        Point.Head(branch) => {
            name = text::String.of(branch.as_str(), alloc)
        }
        Point.Commit(branch: branch, commit: commit) => {
            name = text::String.of(branch.as_str(), alloc)
            at = Some(commit.number)
        }
    }
    let head = try self.head_named(name.as_str())
    let number = at.value_or(self.heads[head].branch.head.number)
    return try await mut self.snapshot(device, head, at: number, alloc)
} Store.point_snapshot

/// Adds the edits between the node at `path` as `before` and as `after`.
fn Store.diff_entries[D: disk::Device](
    mut self,
    device: D,
    old: Snapshot,
    new: Snapshot,
    path: ident::Path,
    before: Option[NodeEntry],
    after: Option[NodeEntry],
    mut edits: mem::List[Edit],
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    let Some(was) = before else {
        let Some(now) = after else {
            return
        }
        let to = try await mut self.hash_in(device, snapshot: new, entry: now, tree: TREE_VERSIONED, alloc)
        mut edits.push(Edit(path: copied_path(path, alloc), change: Change.Added, from: None, to: Some(to), fields: mem::List.empty(alloc)))
        return
    }
    let Some(now) = after else {
        let from = try await mut self.hash_in(device, snapshot: old, entry: was, tree: TREE_VERSIONED, alloc)
        mut edits.push(Edit(path: copied_path(path, alloc), change: Change.Removed, from: Some(from), to: None, fields: mem::List.empty(alloc)))
        return
    }
    if was.version == now.version and was.subtree == now.subtree and was.kind == now.kind {
        return
    }
    let was_dir = try child_dir(was, tree: TREE_VERSIONED, alloc)
    let now_dir = try child_dir(now, tree: TREE_VERSIONED, alloc)
    let both_dirs = was_dir.dir != 0 and now_dir.dir != 0 and was_dir.tree == TREE_VERSIONED and now_dir.tree == TREE_VERSIONED
    if both_dirs and same_declaration(was, now) {
        try await mut self.diff_dirs(device, old, new, path, before: was_dir.dir, after: now_dir.dir, mut edits, alloc)
        return
    }
    let from = try await mut self.hash_in(device, snapshot: old, entry: was, tree: TREE_VERSIONED, alloc)
    let to = try await mut self.hash_in(device, snapshot: new, entry: now, tree: TREE_VERSIONED, alloc)
    if from == to and not both_dirs {
        return
    }
    let fields = try await mut self.field_edits(device, was, now, alloc)
    mut edits.push(Edit(path: copied_path(path, alloc), change: Change.Changed, from: Some(from), to: Some(to), fields: take fields))
    if both_dirs {
        try await mut self.diff_dirs(device, old, new, path, before: was_dir.dir, after: now_dir.dir, mut edits, alloc)
    }
} Store.diff_entries

/// Adds the edits between the children of dir `before` and of dir `after`, in name order.
fn Store.diff_dirs[D: disk::Device](
    mut self,
    device: D,
    old: Snapshot,
    new: Snapshot,
    path: ident::Path,
    before: u64,
    after: u64,
    mut edits: mem::List[Edit],
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    let was = try await mut self.snapshot_children(device, snapshot: old, dir: before, alloc)
    let now = try await mut self.snapshot_children(device, snapshot: new, dir: after, alloc)
    var left: usize = 0
    var right: usize = 0
    while left < was.len() or right < now.len() {
        let take_left = right >= now.len() or (left < was.len() and was[left].name <= now[right].name)
        let take_right = left >= was.len() or (right < now.len() and now[right].name <= was[left].name)
        var before_entry: Option[NodeEntry] = None
        var after_entry: Option[NodeEntry] = None
        var name = mem::Bytes.empty(alloc)
        if take_left {
            before_entry = copied_entry(Some(was[left].entry), alloc)
            name = copied_bytes(was[left].name.view(), alloc)
            left += 1
        }
        if take_right {
            after_entry = copied_entry(Some(now[right].entry), alloc)
            name = copied_bytes(now[right].name.view(), alloc)
            right += 1
        }
        let Some(child) = path.child(name.view(), alloc) else {
            fail StoreError.Corrupt
        }
        try await mut self.diff_entries(device, old, new, path: child, before: before_entry, after: after_entry, mut edits, alloc)
    }
} Store.diff_dirs

/// The differing fields of two records of one record type, each with its wire bytes on both sides.
fn Store.field_edits[D: disk::Device](
    mut self,
    device: D,
    was: NodeEntry,
    now: NodeEntry,
    alloc: mem::Alloc,
    ) -> mem::List[FieldEdit] fails StoreError uses wait {
    var fields = mem::List[FieldEdit].empty(alloc)
    if was.kind != NodeKind.Record.code() or now.kind != NodeKind.Record.code() or was.type != now.type {
        return fields
    }
    let type = try await mut self.type_of(device, id: now.type, alloc)
    if not self.schemas.is_record(type.schema) {
        return fields
    }
    let old_bytes = try await mut self.record_bytes(device, entry: was, alloc)
    let new_bytes = try await mut self.record_bytes(device, entry: now, alloc)
    let Some(old_parts) = record_parts(old_bytes.view(), alloc) else {
        return fields
    }
    let Some(new_parts) = record_parts(new_bytes.view(), alloc) else {
        return fields
    }
    for part in old_parts {
        let after = value_of_key(new_parts.view(), key: part.key.view(), alloc)
        if after != Some(copied_bytes(part.value.view(), alloc)) {
            mut fields.push(FieldEdit(field: text_of_name(part.key.view(), alloc), from: Some(copied_bytes(part.value.view(), alloc)), to: take after))
        }
    }
    for part in new_parts {
        if value_of_key(old_parts.view(), key: part.key.view(), alloc).is_none() {
            mut fields.push(FieldEdit(field: text_of_name(part.key.view(), alloc), from: None, to: Some(copied_bytes(part.value.view(), alloc))))
        }
    }
    return fields
} Store.field_edits

/// The value of the part keyed `key`.
pkg fn value_of_key(parts: Slice[Part], key: Slice[u8], alloc: mem::Alloc) -> Option[mem::Bytes] {
    for part in parts {
        if part.key.view() == key {
            return Some(copied_bytes(part.value.view(), alloc))
        }
    }
    return None
} value_of_key

/// Whether two dir entries hold the same declaration.
pkg fn same_declaration(was: NodeEntry, now: NodeEntry) -> bool {
    let Content.Dir(id: _, declaration: before, digest: _, next: _) = was.content else {
        return false
    }
    let Content.Dir(id: _, declaration: after, digest: _, next: _) = now.content else {
        return false
    }
    return before == after
} same_declaration

pkg fn copied_path(path: ident::Path, alloc: mem::Alloc) -> ident::Path {
    return ident::Path(text: text::String.of(path.text.as_str(), alloc))
} copied_path
