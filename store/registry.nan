//! The schema registry: the types the store knows by schema hash, with their names, schema trees and decoders, by which it checks record writes.

/// The types the store knows by schema hash.
pub open struct Registry {
    types: mem::Map[ident::HashValue, Known]
} Registry

/// A known type: its canonical path, its schema tree and its decoder.
struct Known {
    name: text::String
    schema: mem::wire::Schema
    decoder: Decoder
} Known

/// A type's decoder: its schema hash, and the function giving the canonical bytes of what decodes as the type, failing with the field path where decoding failed, within a stack the machine targets bound.
pub closed struct Decoder derives Copy {
    pub schema: mem::wire::SchemaHash
    pub canonical: fn(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails mem::wire::DecodeFailure limits terminates, stack 65_536
} Decoder

/// How a written type relates to the declared one: the same, an evolution the declared type takes, or one it accepts as it stands.
pkg enum Fit derives Copy, Eq {
    Same
    Takes
    Accepted
} Fit

pub fn Registry.empty(alloc: mem::Alloc) -> Registry {
    return Registry(types: mem::Map.empty(alloc))
} Registry.empty

/// Makes the type of canonical path `name` known by its schema tree and decoder.
pub fn Registry.add(
    mut self,
    name: Str,
    take schema: mem::wire::Schema,
    decoder: Decoder,
    alloc: mem::Alloc,
    ) {
    let Some(hash) = hash_of_schema(decoder.schema) else {
        return
    }
    discard mut self.types.insert(hash, value: Known(name: text::String.of(name, alloc), schema: take schema, decoder: decoder))
} Registry.add

/// The reference to the type of canonical path `name` and schema hash `schema`, as `mem::wire::Codec` gives it.
pub fn TypeRef.of(name: Str, schema: mem::wire::SchemaHash, alloc: mem::Alloc) -> TypeRef {
    let hash = hash_of_schema(schema).value_or(ident::HashValue(bytes: Array[u8, 33].filled(0x01)))
    return TypeRef(name: text::String.of(name, alloc), schema: hash)
} TypeRef.of

/// How `written` fits `declared`: `schema.mismatch` when their names differ, when the registry knows the written schema under another name, or when neither tree accepts the other; `schema.unknown` when a tree it needs is unknown.
pkg fn Registry.fit(self, declared: TypeRef, written: TypeRef, alloc: mem::Alloc) -> Fit fails StoreError {
    if declared.name != written.name {
        fail StoreError.SchemaMismatch
    }
    match self.types.get(written.schema) {
        Some(known) => {
            if known.name != written.name {
                fail StoreError.SchemaMismatch
            }
        }
        None => {
        }
    }
    if declared.schema == written.schema {
        return Fit.Same
    }
    let Some(old) = self.types.get(declared.schema) else {
        fail StoreError.SchemaUnknown
    }
    let Some(new) = self.types.get(written.schema) else {
        fail StoreError.SchemaUnknown
    }
    if new.schema.accepts(old.schema, alloc) {
        return Fit.Takes
    }
    if old.schema.accepts(new.schema, alloc) {
        return Fit.Accepted
    }
    fail StoreError.SchemaMismatch
} Registry.fit

/// The canonical bytes of `raw` as a value of the type of schema `schema`, by its decoder: `schema.unknown` for an unknown schema, `schema.invalid` naming the decoder's failure and the field path where it rejected them.
pkg fn Registry.decode(self, schema: ident::HashValue, raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails StoreError {
    let Some(known) = self.types.get(schema) else {
        fail StoreError.SchemaUnknown
    }
    return match attempt (known.decoder.canonical)(raw, alloc) {
        Ok(canonical) => canonical
        Err(failure) => fail StoreError.SchemaInvalid(take failure)
    }
} Registry.decode

/// Whether the registry knows the type of schema `schema` as a record type.
pkg fn Registry.is_record(self, schema: ident::HashValue) -> bool {
    let Some(known) = self.types.get(schema) else {
        return false
    }
    if known.schema.nodes.len() == 0 {
        return false
    }
    return match known.schema.nodes[0] {
        mem::wire::SchemaNode.Record(open: _, fields: _) => true
        else => false
    }
} Registry.is_record

/// The schema tree of the type of schema `schema`, `schema.unknown` when the registry knows none.
pkg proj fn Registry.schema_of(self, schema: ident::HashValue) -> Option[mem::wire::Schema] {
    return match self.types.get(schema) {
        Some(known) => Some(known.schema)
        None => None
    }
} Registry.schema_of

/// Whether the registry knows the type of schema `schema`.
pkg fn Registry.knows(self, schema: ident::HashValue) -> bool {
    return self.types.contains(schema)
} Registry.knows

fn hash_of_schema(schema: mem::wire::SchemaHash) -> Option[ident::HashValue] {
    if schema.bytes[0] != 0x01 {
        return None
    }
    return Some(ident::HashValue(bytes: schema.bytes))
} hash_of_schema
