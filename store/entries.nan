//! The wire records of the index and the log: node entries and their content, log writes and commit records, and the entries of the catalog.

/// The trees of the index.
pkg const TREE_VERSIONED: u8 = 1

pkg const TREE_UNVERSIONED: u8 = 2

pkg const TREE_MACHINE: u8 = 3

pkg const TREE_CATALOG: u8 = 4

/// The kinds of catalog entries, the first byte of their keys.
pkg const KIND_BRANCH: u8 = 1

pkg const KIND_COMMIT: u8 = 2

pkg const KIND_PIN: u8 = 3

pkg const KIND_REQUEST: u8 = 4

pkg const KIND_STREAM_RUN: u8 = 5

pkg const KIND_BLOB: u8 = 6

pkg const KIND_BLOB_PIECE: u8 = 7

pkg const KIND_PIECE: u8 = 8

pkg const KIND_PATH_CHANGE: u8 = 9

pkg const KIND_SEGMENT: u8 = 11

pkg const KIND_ORIGIN_SET: u8 = 12

pkg const KIND_TYPE: u8 = 13

pkg const KIND_MACHINE: u8 = 14

pkg const KIND_TYPE_LOOKUP: u8 = 15

pkg const KIND_ORIGIN_LOOKUP: u8 = 16

/// The dir id of the top dir.
pkg const TOP_DIR: u64 = 1

/// A node as a tree's leaf holds it.
pkg struct NodeEntry derives Eq, Encode {
    pkg kind: u8
    pkg version: u64
    pkg subtree: u64
    pkg origins: u32
    pkg type: u32
    pkg declared: u32
    pkg secret: u64
    pkg expires: i64
    pkg hash: Option[ident::HashValue]
    pkg held: bool
    pkg content: Content
} NodeEntry

/// What a node holds: record bytes inline or in a value record, a blob, a dir's id, declaration, entry digest and the number its next added child takes, or a stream's id, declaration and entries.
pkg enum Content derives Eq, Encode {
    Inline(mem::Bytes)
    Value(mem::Bytes)
    Blob(id: ident::HashValue, size: u64)
    Dir(id: u64, declaration: mem::Bytes, digest: Option[ident::HashValue], next: u64)
    Stream(id: u64, declaration: mem::Bytes, next: u64, entries: u64, bytes: u64)
} Content

/// A change a commit makes to a tree: the entry of `name` in dir `dir`, `None` deleting it.
pkg struct LogWrite derives Eq, Encode {
    pkg tree: u8
    pkg dir: u64
    pkg name: mem::Bytes
    pkg entry: Option[NodeEntry]
} LogWrite

/// A catalog entry a commit adds or replaces, `None` removing it.
pkg struct CatalogWrite derives Eq, Encode {
    pkg key: mem::Bytes
    pkg value: Option[mem::Bytes]
} CatalogWrite

pkg struct CommitRecord derives Eq, Encode {
    pkg meta: CommitMeta
    pkg writes: mem::List[LogWrite]
    pkg catalog: mem::List[CatalogWrite]
} CommitRecord

pkg struct BranchEntry derives Eq, Encode {
    pkg branch: Branch
    pkg versioned: mem::Bytes
    pkg unversioned: mem::Bytes
} BranchEntry

pkg struct CommitEntry derives Eq, Encode {
    pkg meta: CommitMeta
    pkg record: Option[mem::Bytes]
    pkg tree: Option[mem::Bytes]
} CommitEntry

pkg struct RequestEntry derives Eq, Encode {
    pkg session: Option[ident::SessionId]
    pkg commit: u64
    pkg digest: ident::HashValue
} RequestEntry

pkg struct StreamRun derives Eq, Encode {
    pkg record: mem::Bytes
    pkg count: u32
    pkg bytes: u32
    pkg time: i64
} StreamRun

pkg struct BlobEntry derives Copy, Eq, Encode {
    pkg size: u64
    pkg refcount: u64
} BlobEntry

pkg struct PieceEntry derives Eq, Encode {
    pkg record: mem::Bytes
    pkg refcount: u64
} PieceEntry

pkg struct PathChange derives Copy, Eq, Encode {
    pkg change: u8
} PathChange

pkg struct SegmentEntry derives Copy, Eq, Encode {
    pkg state: u8
    pkg live: u64
    pkg written: i64
} SegmentEntry

pkg struct OriginSet derives Eq, Encode {
    pkg labels: mem::List[ident::OriginLabel]
    pkg refcount: u64
} OriginSet

pkg struct TypeEntry derives Eq, Encode {
    pkg type: TypeRef
    pkg refcount: u64
} TypeEntry

pkg struct BlobMap derives Eq, Encode {
    pkg size: u64
    pkg pieces: mem::Bytes
} BlobMap

/// The kind of a node as its entry holds it.
pkg fn NodeKind.code(self) -> u8 {
    return match self {
        NodeKind.Record => 1
        NodeKind.Blob => 2
        NodeKind.Dir => 3
        NodeKind.Stream => 4
    }
} NodeKind.code

pkg fn NodeKind.of_code(code: u8) -> Option[NodeKind] {
    return match code {
        1 => Some(NodeKind.Record)
        2 => Some(NodeKind.Blob)
        3 => Some(NodeKind.Dir)
        4 => Some(NodeKind.Stream)
        else => None
    }
} NodeKind.of_code

/// The key of the entry of `name` in dir `dir`.
pkg fn entry_key(dir: u64, name: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    var key = mem::Bytes.zeroed(8, alloc)
    mut key.view_mut().write_u64_be(0, value: dir)
    mut key.append(name)
    return key
} entry_key

/// The key prefix of the entries of dir `dir`.
pkg fn dir_prefix(dir: u64, alloc: mem::Alloc) -> mem::Bytes {
    return entry_key(dir, name: b"", alloc)
} dir_prefix

/// The key of a catalog entry of `kind` whose own key is `key`.
pkg fn catalog_key(kind: u8, key: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.push(kind)
    mut bytes.append(key)
    return bytes
} catalog_key

/// The key of a catalog entry of `kind` keyed by a big-endian number of `width` bytes.
pkg fn number_key(kind: u8, number: u64, width: usize, alloc: mem::Alloc) -> mem::Bytes
    requires width == 4 or width == 8
{
    var bytes = mem::Bytes.zeroed(1 + width, alloc)
    bytes[0] = kind
    if width == 4 {
        mut bytes.view_mut().write_u32_be(1, value: u32.truncate(number))
    } else {
        mut bytes.view_mut().write_u64_be(1, value: number)
    }
    return bytes
} number_key

/// The wire bytes of `value`.
pkg fn wire_of[T: Encode](value: T, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[T].encode(value, out: mut bytes)
    return bytes
} wire_of

/// The catalog key of the type lookup of `type`.
pkg fn type_lookup_key(type: TypeRef, alloc: mem::Alloc) -> mem::Bytes {
    var key = catalog_key(KIND_TYPE_LOOKUP, key: type.schema.bytes.view(), alloc)
    mut key.append(type.name.as_bytes())
    return key
} type_lookup_key

/// The catalog key of the origin lookup of the origin set `labels`.
pkg fn origin_lookup_key(labels: Slice[ident::OriginLabel], alloc: mem::Alloc) -> mem::Bytes {
    var list = mem::List[ident::OriginLabel].empty(alloc)
    for label in labels {
        mut list.push(ident::OriginLabel(text: label.text))
    }
    let hash = ident::HashValue.of_content(wire_of(list, alloc).view())
    return catalog_key(KIND_ORIGIN_LOOKUP, key: hash.bytes.view(), alloc)
} origin_lookup_key

pkg fn Branch.copied(self, alloc: mem::Alloc) -> Branch {
    let parent = match self.parent {
        Some(name) => Some(text::String.of(name.as_str(), alloc))
        None => None
    }
    return Branch(name: text::String.of(self.name.as_str(), alloc), head: self.head, fork: self.fork, parent: take parent, created_by: ident::Principal(text: self.created_by.text), expires: self.expires)
} Branch.copied

pkg fn CommitMeta.copied(self, alloc: mem::Alloc) -> CommitMeta {
    return match attempt mem::wire::Codec[CommitMeta].decode(Untrusted.of(wire_of(self, alloc).view()), alloc) {
        Ok(copy) => copy
        Err(_) => self.copied_by_fields(alloc)
    }
} CommitMeta.copied

fn CommitMeta.copied_by_fields(self, alloc: mem::Alloc) -> CommitMeta {
    var parents = mem::List[ident::CommitId].empty(alloc)
    for parent in self.parents {
        mut parents.push(parent)
    }
    var origins = mem::List[ident::OriginLabel].empty(alloc)
    for label in self.origins {
        mut origins.push(ident::OriginLabel(text: label.text))
    }
    let kind = match self.kind {
        CommitKind.Write => CommitKind.Write
        CommitKind.Merge(source: source) => CommitKind.Merge(source: text::String.of(source.as_str(), alloc))
        CommitKind.Revert(of: of) => CommitKind.Revert(of: of)
        CommitKind.Genesis => CommitKind.Genesis
    }
    let instance = match self.instance {
        Some(moniker) => Some(ident::Moniker(text: moniker.text))
        None => None
    }
    return CommitMeta(number: self.number, branch: text::String.of(self.branch.as_str(), alloc), parents: take parents, kind: take kind, principal: ident::Principal(text: self.principal.text), session: self.session, instance: take instance, cause: self.cause, plan: self.plan, intent: copied_text(self.intent, alloc), origins: take origins, key: copied_text(self.key, alloc), time: self.time, recorded: self.recorded, root: self.root)
} CommitMeta.copied_by_fields

pkg fn TypeRef.copied(self, alloc: mem::Alloc) -> TypeRef {
    return TypeRef(name: text::String.of(self.name.as_str(), alloc), schema: self.schema)
} TypeRef.copied

pkg fn decode_branch_entry(take bytes: Slice[u8], alloc: mem::Alloc) -> BranchEntry fails StoreError {
    return match attempt mem::wire::Codec[BranchEntry].decode(Untrusted.of(take bytes), alloc) {
        Ok(value) => value
        Err(_) => fail StoreError.Corrupt
    }
} decode_branch_entry

pkg fn decode_commit_entry(take bytes: Slice[u8], alloc: mem::Alloc) -> CommitEntry fails StoreError {
    return match attempt mem::wire::Codec[CommitEntry].decode(Untrusted.of(take bytes), alloc) {
        Ok(value) => value
        Err(_) => fail StoreError.Corrupt
    }
} decode_commit_entry

pkg fn decode_commit_record(take bytes: Untrusted[Slice[u8]], alloc: mem::Alloc) -> CommitRecord fails StoreError {
    return match attempt mem::wire::Codec[CommitRecord].decode(bytes, alloc) {
        Ok(value) => value
        Err(_) => fail StoreError.Corrupt
    }
} decode_commit_record

