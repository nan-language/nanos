//! The keyring's blocks: 62 slots of secret records each, kept in two copies.

const KEYRING_MAGIC: Slice[u8] = b"NANOSKR1"

/// The first block of each copy of the keyring, and the blocks of a copy.
pub const KEYRING_COPY_0: u64 = 66

pub const KEYRING_COPY_1: u64 = 1_057

pub const KEYRING_BLOCKS: u32 = 991

/// The slots of a keyring block.
pub const SLOTS_PER_BLOCK: usize = 62

const SLOTS_AT: usize = 16

const SLOT_BYTES: usize = 64

/// A slot of the keyring: the secret it holds, 0 for none, its seed, and the commit that created the secret's record.
pub closed struct Slot derives Copy, Eq {
    pub secret: u64
    pub seed: Array[u8, 32]
    pub commit: u64
} Slot

/// A keyring block: the sequence its writes number and its slots.
pub closed struct KeyringBlock derives Eq {
    pub sequence: u64
    pub slots: mem::List[Slot]
} KeyringBlock

pub fn Slot.free() -> Slot = Slot(secret: 0, seed: Array[u8, 32].filled(0), commit: 0)

/// A block of free slots, never written.
pub fn KeyringBlock.empty(alloc: mem::Alloc) -> KeyringBlock {
    var free = mem::List[Slot].empty(alloc)
    for _ in 0..<SLOTS_PER_BLOCK {
        mut free.push(Slot.free())
    }
    return KeyringBlock(sequence: 0, slots: take free)
} KeyringBlock.empty

pub fn KeyringBlock.to_block(self, alloc: mem::Alloc) -> mem::Bytes {
    var block = zero_block(alloc)
    put_bytes(mut block, at: 0, data: KEYRING_MAGIC)
    mut block.view_mut().write_u64_le(8, value: self.sequence)
    var at = SLOTS_AT
    for slot in self.slots {
        mut block.view_mut().write_u64_le(at, value: slot.secret)
        put_bytes(mut block, at: at + 8, data: slot.seed.view())
        mut block.view_mut().write_u64_le(at + 40, value: slot.commit)
        at += SLOT_BYTES
    }
    close_at(mut block, at: CLOSING_CHECKSUM)
    return block
} KeyringBlock.to_block

/// The keyring block a copy's block holds, `None` when the copy is blank or damaged.
pub validator fn KeyringBlock.read(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[KeyringBlock] {
    let bytes = raw.inspect()
    if bytes.len() < BLOCK_BYTES or not has_magic(bytes, magic: KEYRING_MAGIC) or not closes(bytes, at: CLOSING_CHECKSUM) {
        return None
    }
    var held = mem::List[Slot].empty(alloc)
    var at = SLOTS_AT
    for _ in 0..<SLOTS_PER_BLOCK {
        mut held.push(Slot(secret: bytes.u64_le(at), seed: array32(bytes, at: at + 8), commit: bytes.u64_le(at + 40)))
        at += SLOT_BYTES
    }
    return Some(KeyringBlock(sequence: bytes.u64_le(8), slots: take held))
} KeyringBlock.read

test keyring_blocks_read_back_and_refuse_damage for KeyringBlock.read {
    let alloc = testing::world().alloc
    var written = KeyringBlock.empty(alloc)
    written.sequence = 7
    written.slots[3] = Slot(secret: 9, seed: Array[u8, 32].filled(5), commit: 12)
    var bytes = written.to_block(alloc)
    let Some(read) = KeyringBlock.read(Untrusted.of(bytes.view()), alloc) else {
        expect false
        return
    }
    expect read.sequence == 7 and read.slots.len() == SLOTS_PER_BLOCK and read.slots[3] == written.slots[3] and read.slots[4] == Slot.free()
    bytes[100] = 1
    let damaged = KeyringBlock.read(Untrusted.of(bytes.view()), alloc)
    let blank = KeyringBlock.read(Untrusted.of(zero_block(alloc).view()), alloc)
    expect damaged.is_none() and blank.is_none()
} keyring_blocks_read_back_and_refuse_damage
