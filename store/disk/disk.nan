//! The volume as the store lays it out: its blocks, the device it lies on, checksums, superblocks, segment and batch headers, log records, pointers and flush records.

/// The bytes of a store block.
pub const BLOCK_BYTES: usize = 4_096

/// The blocks of a segment; block 0 holds its header.
pub const SEGMENT_BLOCKS: u64 = 2_048

/// The blocks of the head area: superblocks, the flush ring and the keyring, which the store alone writes in place.
pub const HEAD_BLOCKS: u64 = 2_048

/// The blocks of the two superblocks.
pub const SUPERBLOCK_A: u64 = 0

pub const SUPERBLOCK_B: u64 = 65

/// The first block of the flush ring and its slots.
pub const FLUSH_RING: u64 = 1

pub const FLUSH_SLOTS: u64 = 64

/// The format version this store writes and mounts.
pub const FORMAT: u32 = 1

/// The offset of the checksum closing a superblock, a segment header and a flush record.
pub const CLOSING_CHECKSUM: usize = 4_080

/// Why a device operation failed.
pub closed enum DeviceFailure derives Render {
    Io
    Cancelled(task::Cancelled) from
} DeviceFailure

/// The device the volume lies on, in store blocks from the volume's first.
pub interface Device {
    /// The volume's size in blocks.
    fn blocks(self) -> u64
    /// Whether the device discards blocks.
    fn discards(self) -> bool
    fn read(self, block: u64, count: u32, alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails DeviceFailure uses wait
    /// Writes whole blocks from `block`.
    fn write(self, block: u64, take data: mem::Bytes, alloc: mem::Alloc) fails DeviceFailure uses wait
    /// Makes every write before it durable.
    fn flush(self, alloc: mem::Alloc) fails DeviceFailure uses wait
    fn discard_blocks(self, block: u64, count: u32, alloc: mem::Alloc) fails DeviceFailure uses wait
} Device

/// The store's checksum of `bytes`: XXH3-128, its low 64 bits first.
pub fn checksum(bytes: Slice[u8]) -> Array[u8, 16] {
    return ident::xxh3_128(bytes).to_bytes()
} checksum

/// The number of segments a volume of `blocks` blocks holds after its head area.
pub fn segments_of(blocks: u64) -> u32 {
    let whole = blocks / SEGMENT_BLOCKS
    if whole == 0 {
        return 0
    }
    return u32.saturate(whole - 1)
} segments_of

/// The first block of segment `segment`.
pub fn segment_start(segment: u32) -> u64 = u64.widen(segment) * SEGMENT_BLOCKS

/// A block of zeros.
pub fn zero_block(alloc: mem::Alloc) -> mem::Bytes {
    return mem::Bytes.zeroed(BLOCK_BYTES, alloc)
} zero_block

/// Whether the 16 bytes at `at` of `bytes` are the checksum of the bytes before them.
pub fn closes(bytes: Slice[u8], at: usize) -> bool {
    let Some(parts) = bytes.split_at(at) else {
        return false
    }
    let Some(stored) = parts.tail.prefix(16) else {
        return false
    }
    return stored == checksum(parts.head).view()
} closes

/// Writes the checksum of the bytes before `at` at `at`.
pub fn close_at(mut bytes: mem::Bytes, at: usize) {
    let Some(parts) = bytes.view().split_at(at) else {
        return
    }
    let sum = checksum(parts.head)
    for i in 0..<16usize {
        bytes[at + i] = sum[i]
    }
} close_at

/// Whether `bytes` begins with `magic`.
pub fn has_magic(bytes: Slice[u8], magic: Slice[u8]) -> bool {
    return bytes.prefix(magic.len()) == Some(magic)
} has_magic

/// Writes `data` into `bytes` from `at`.
pub fn put_bytes(mut bytes: mem::Bytes, at: usize, data: Slice[u8]) {
    var offset = at
    for byte in data {
        bytes[offset] = byte
        offset += 1
    }
} put_bytes

/// The 16 bytes of `bytes` from `at`, zero where they do not lie within it.
pub fn array16(bytes: Slice[u8], at: usize) -> Array[u8, 16] {
    var out = Array[u8, 16].filled(0)
    if at > bytes.len() or bytes.len() - at < 16 {
        return out
    }
    for i in 0..<16usize {
        out[i] = bytes[at + i]
    }
    return out
} array16

/// The 32 bytes of `bytes` from `at`, zero where they do not lie within it.
pub fn array32(bytes: Slice[u8], at: usize) -> Array[u8, 32] {
    var out = Array[u8, 32].filled(0)
    if at > bytes.len() or bytes.len() - at < 32 {
        return out
    }
    for i in 0..<32usize {
        out[i] = bytes[at + i]
    }
    return out
} array32
