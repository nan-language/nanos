//! The structures of whole blocks: superblocks, segment headers and flush records.

const SUPERBLOCK_MAGIC: Slice[u8] = b"NANOSST1"

const SEGMENT_MAGIC: Slice[u8] = b"NANOSSG1"

const FLUSH_MAGIC: Slice[u8] = b"NANOSFR1"

/// A superblock's fields; the store mounts from the valid copy with the higher `sequence`.
pub closed struct Superblock derives Copy, Eq {
    pub sequence: u64
    pub format: u32
    pub flags: u32
    pub volume_id: Array[u8, 16]
    pub blocks: u64
    pub segments: u32
    pub created: i64
} Superblock

/// What a superblock copy holds: a valid superblock, a damaged one whose magic remains, or none.
pub closed enum Found derives Copy, Eq {
    Valid(Superblock)
    Damaged
    Blank
} Found

/// A segment header: the order in which segments were opened, the volume, the segment itself and the segment the log continues in.
pub closed struct SegmentHeader derives Copy, Eq {
    pub sequence: u64
    pub volume_id: Array[u8, 16]
    pub segment: u32
    pub next: u32
    pub format: u32
} SegmentHeader

/// A flush record: where replay starts, the counters, and the top nodes of the catalog and the item table.
pub closed struct FlushRecord derives Copy, Eq {
    pub flush: u64
    pub batch: u64
    pub segment: u32
    pub block: u32
    pub commit: u64
    pub next_item: u64
    pub next_dir: u64
    pub next_secret: u64
    pub next_stream: u64
    pub time: i64
    pub catalog: Pointer
    pub items: Pointer
} FlushRecord

pub fn Superblock.to_block(self, alloc: mem::Alloc) -> mem::Bytes {
    var block = zero_block(alloc)
    put_bytes(mut block, at: 0, data: SUPERBLOCK_MAGIC)
    mut block.view_mut().write_u64_le(8, value: self.sequence)
    mut block.view_mut().write_u32_le(16, value: self.format)
    mut block.view_mut().write_u32_le(20, value: self.flags)
    put_bytes(mut block, at: 24, data: self.volume_id.view())
    mut block.view_mut().write_u64_le(40, value: self.blocks)
    mut block.view_mut().write_u32_le(48, value: self.segments)
    mut block.view_mut().write_u64_le(56, value: self.created.to_bits())
    close_at(mut block, at: CLOSING_CHECKSUM)
    return block
} Superblock.to_block

/// The superblock a copy's block holds.
pub validator fn Superblock.read(raw: Untrusted[Slice[u8]]) -> Found {
    let bytes = raw.inspect()
    if not has_magic(bytes, magic: SUPERBLOCK_MAGIC) {
        return Found.Blank
    }
    if bytes.len() < BLOCK_BYTES or not closes(bytes, at: CLOSING_CHECKSUM) {
        return Found.Damaged
    }
    return Found.Valid(Superblock(
        sequence: bytes.u64_le(8),
        format: bytes.u32_le(16),
        flags: bytes.u32_le(20),
        volume_id: array16(bytes, at: 24),
        blocks: bytes.u64_le(40),
        segments: bytes.u32_le(48),
        created: i64.from_bits(bytes.u64_le(56)),
    ))
} Superblock.read

pub fn SegmentHeader.to_block(self, alloc: mem::Alloc) -> mem::Bytes {
    var block = zero_block(alloc)
    put_bytes(mut block, at: 0, data: SEGMENT_MAGIC)
    mut block.view_mut().write_u64_le(8, value: self.sequence)
    put_bytes(mut block, at: 16, data: self.volume_id.view())
    mut block.view_mut().write_u32_le(32, value: self.segment)
    mut block.view_mut().write_u32_le(36, value: self.next)
    mut block.view_mut().write_u32_le(40, value: self.format)
    close_at(mut block, at: CLOSING_CHECKSUM)
    return block
} SegmentHeader.to_block

/// The segment header a segment's block 0 holds, `None` when it fails its magic or checksum.
pub validator fn SegmentHeader.read(raw: Untrusted[Slice[u8]]) -> Option[SegmentHeader] {
    let bytes = raw.inspect()
    if bytes.len() < BLOCK_BYTES or not has_magic(bytes, magic: SEGMENT_MAGIC) or not closes(bytes, at: CLOSING_CHECKSUM) {
        return None
    }
    return Some(SegmentHeader(sequence: bytes.u64_le(8), volume_id: array16(bytes, at: 16), segment: bytes.u32_le(32), next: bytes.u32_le(36), format: bytes.u32_le(40)))
} SegmentHeader.read

pub fn FlushRecord.to_block(self, alloc: mem::Alloc) -> mem::Bytes {
    var block = zero_block(alloc)
    put_bytes(mut block, at: 0, data: FLUSH_MAGIC)
    mut block.view_mut().write_u64_le(8, value: self.flush)
    mut block.view_mut().write_u64_le(16, value: self.batch)
    mut block.view_mut().write_u32_le(24, value: self.segment)
    mut block.view_mut().write_u32_le(28, value: self.block)
    mut block.view_mut().write_u64_le(32, value: self.commit)
    mut block.view_mut().write_u64_le(40, value: self.next_item)
    mut block.view_mut().write_u64_le(48, value: self.next_dir)
    mut block.view_mut().write_u64_le(56, value: self.next_secret)
    mut block.view_mut().write_u64_le(64, value: self.next_stream)
    mut block.view_mut().write_u64_le(72, value: self.time.to_bits())
    put_bytes(mut block, at: 80, data: self.catalog.to_bytes().view())
    put_bytes(mut block, at: 112, data: self.items.to_bytes().view())
    close_at(mut block, at: CLOSING_CHECKSUM)
    return block
} FlushRecord.to_block

/// The flush record a ring slot holds, `None` when it fails its magic or checksum.
pub validator fn FlushRecord.read(raw: Untrusted[Slice[u8]]) -> Option[FlushRecord] {
    let bytes = raw.inspect()
    if bytes.len() < BLOCK_BYTES or not has_magic(bytes, magic: FLUSH_MAGIC) or not closes(bytes, at: CLOSING_CHECKSUM) {
        return None
    }
    return Some(FlushRecord(
        flush: bytes.u64_le(8),
        batch: bytes.u64_le(16),
        segment: bytes.u32_le(24),
        block: bytes.u32_le(28),
        commit: bytes.u64_le(32),
        next_item: bytes.u64_le(40),
        next_dir: bytes.u64_le(48),
        next_secret: bytes.u64_le(56),
        next_stream: bytes.u64_le(64),
        time: i64.from_bits(bytes.u64_le(72)),
        catalog: Pointer.of_array(array32(bytes, at: 80)),
        items: Pointer.of_array(array32(bytes, at: 112)),
    ))
} FlushRecord.read

/// The block of the ring slot that flush `flush` writes its record to.
pub fn flush_slot(flush: u64) -> u64
    requires flush > 0
{
    return FLUSH_RING + (flush - 1) % FLUSH_SLOTS
} flush_slot
