//! Space: the free segments the store keeps for itself, history thinned from the oldest commit when a write of a principal other than an agent or a child principal lacks room, collections, and the store's usage.

/// The bytes of a segment.
const SEGMENT_BYTES: u64 = 8_388_608

/// The bytes of the volume's segments.
pkg fn Store.capacity(self) -> u64 = u64.widen(self.superblock.segments).saturating_mul(SEGMENT_BYTES)

/// `pct` percent of the capacity.
pkg fn Store.share_of(self, pct: u8) -> u64 = (self.capacity() / 100).saturating_mul(u64.widen(pct))

/// The bytes only retained commits other than heads reach, agent bytes excepted: values, blobs, versioned nodes and commit records.
pkg fn Store.history_in_use(self) -> u64 = self.history_bytes.saturating_add(self.history_records)

/// The bytes agents and child principals added: what the last index flush counted, what they logged since, and their drafts.
pkg fn Store.agents_in_use(self) -> u64 {
    var drafts: u64 = 0
    for entry in self.drafts.cursor() {
        if entry.value().agent {
            drafts += entry.value().size
        }
    }
    return self.agent_bytes.saturating_add(self.agent_pending).saturating_add(drafts)
} Store.agents_in_use

/// `store.full` when a write of `adding` bytes on `principal`'s authority, an agent's or a child principal's, would raise agent bytes above `agent_pct` of the capacity.
pkg fn Store.check_agent_share(self, adding: u64, principal: ident::Principal) fails StoreError {
    if adding == 0 or not adds_agent_bytes(principal) {
        return
    }
    if self.agents_in_use().saturating_add(adding) > self.share_of(self.retention.agent_pct) {
        fail StoreError.Full
    }
} Store.check_agent_share

/// The bytes the log takes before the store's reserve of free segments, 2 plus 0.5% of all segments: the open segment's room and the free segments beyond the reserve.
pkg fn Store.free_bytes(self) -> u64 {
    let reserve = 2 + self.superblock.segments / 200
    let free = self.log.free_segments()
    if free <= reserve {
        return self.log.room()
    }
    return u64.widen(free - reserve).saturating_mul(SEGMENT_BYTES).saturating_add(self.log.room())
} Store.free_bytes

/// Makes room for `adding` bytes of a write on `principal`'s authority: thins unpinned commits other than heads from the oldest, in rounds of doubling size each followed by cleaning and index flushes, until the room suffices; `store.full` for an agent or a child principal, and with `store.writes-refused` once only pins and heads remain.
pkg fn Store.make_space[D: disk::Device](
    mut self,
    device: D,
    adding: u64,
    principal: ident::Principal,
    now: ident::WallTime,
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    if adds_agent_bytes(principal) {
        fail StoreError.Full
    }
    var most: u64 = 1
    loop {
        let thinned = try await mut self.thin(device, now, tiers: false, most, alloc)
        try await mut self.reclaim(device, now, alloc)
        if self.free_bytes() >= adding {
            return
        }
        if thinned.commits == 0 {
            mut self.events.push(Event.WritesRefused(free: self.free_bytes(), history: self.history_in_use()))
            fail StoreError.Full
        }
        most = most.saturating_mul(2)
    }
} Store.make_space

/// What a collection freed: the commits it thinned and the bytes of the segments it freed.
pub closed struct Collected derives Copy, Eq {
    pub commits: u64
    pub bytes: u64
} Collected

/// Thins every commit no head, pin or retention tier keeps at `now`, and frees the segments left with little live data.
pub fn Store.gc[D: disk::Device](mut self, device: D, now: ident::WallTime, alloc: mem::Alloc) -> Collected fails StoreError uses wait {
    if self.read_only {
        fail StoreError.ReadOnly
    }
    let before = self.log.free_segments()
    let thinned = try await mut self.thin(device, now, tiers: true, most: 0xFFFF_FFFF_FFFF_FFFF, alloc)
    try await mut self.reclaim(device, now, alloc)
    let freed = self.log.free_segments().saturating_sub(before)
    return Collected(commits: thinned.commits, bytes: u64.widen(freed).saturating_mul(SEGMENT_BYTES))
} Store.gc

/// Frees what thinning released: an index flush applies its reference changes, the cleaner empties the segments left with little live data, and two more index flushes free them.
fn Store.reclaim[D: disk::Device](mut self, device: D, now: ident::WallTime, alloc: mem::Alloc) fails StoreError uses wait {
    try await mut self.index_flush(device, now, alloc)
    while try await mut self.clean(device, now, alloc) {
    }
    try await mut self.index_flush(device, now, alloc)
    try await mut self.index_flush(device, now, alloc)
} Store.reclaim

/// Whether writes on `principal`'s authority add agent bytes: an agent's, or a child principal's.
pkg fn adds_agent_bytes(principal: ident::Principal) -> bool {
    let name = principal.text.as_str()
    if name.starts_with("agent.") {
        return true
    }
    if not name.starts_with("human.") {
        return false
    }
    let bytes = name.as_bytes()
    for at in 6..<bytes.len() {
        if bytes[at] == b'.' {
            return true
        }
    }
    return false
} adds_agent_bytes

/// The store's usage, as `LiveStore` reports it: the bytes of its capacity, in use, of history, of agents and free, its format, latest commit, branches and pins, the log bytes replayed at mount, its latest index flush, its free segments and its latest scrub.
pub closed struct Usage {
    pub capacity: u64
    pub used: u64
    pub history: u64
    pub agents: u64
    pub free: u64
    pub format: u32
    pub head: ident::CommitId
    pub branches: u32
    pub pins: u32
    pub replayed: u64
    pub flushed: ident::WallTime
    pub free_segments: u32
    pub scrub: Option[ScrubReport]
} Usage

/// The store's usage now.
pub fn Store.stats[D: disk::Device](mut self, device: D, alloc: mem::Alloc) -> Usage fails StoreError uses wait {
    var used: u64 = 0
    for segment in self.log.segments {
        used += segment.live
    }
    let pins = try await mut self.catalog_scan(device, kind: KIND_PIN, from: b"", limit: 0xFFFF_FFFF, alloc)
    let scrub = match self.scrubbed {
        Some(report) => Some(report.copied(alloc))
        None => None
    }
    return Usage(
        capacity: self.capacity(),
        used: used,
        history: self.history_in_use(),
        agents: self.agents_in_use(),
        free: u64.widen(self.log.free_segments()).saturating_mul(SEGMENT_BYTES).saturating_add(self.log.room()),
        format: self.superblock.format,
        head: ident::CommitId(number: self.counters.commit - 1),
        branches: u32.saturate(self.heads.len()),
        pins: u32.saturate(pins.len()),
        replayed: self.replayed,
        flushed: self.flushed,
        free_segments: self.log.free_segments(),
        scrub: take scrub,
    )
} Store.stats
