//! Wire values read by their schema trees: a record's fields and a map's entries split out of their wire bytes, for merges and diffs to compare them key by key, and values ordered as their types order them.

/// The deepest nesting the reader follows.
const MOST_DEPTH: u32 = 128

/// A field of a wire record, or an entry of a wire map: its key's wire bytes and its value's wire bytes.
pkg struct Part {
    pkg key: mem::Bytes
    pkg value: mem::Bytes
} Part

/// An unsigned value read from wire bytes, and the offset after it.
struct Uvar derives Copy {
    value: u64
    next: usize
} Uvar

/// The fields of the wire record `bytes`, `None` when they are no record of whole fields.
pkg fn record_parts(bytes: Slice[u8], alloc: mem::Alloc) -> Option[mem::List[Part]] {
    let Some(count) = uvar_at(bytes, at: 0) else {
        return None
    }
    var parts = mem::List[Part].empty(alloc)
    var at = count.next
    for _ in 0..<count.value {
        let Some(key_length) = uvar_at(bytes, at) else {
            return None
        }
        let key_end = key_length.next + usize.widen(key_length.value)
        let Some(value_length) = uvar_at(bytes, at: key_end) else {
            return None
        }
        let value_end = value_length.next + usize.widen(value_length.value)
        if value_end > bytes.len() or key_end > bytes.len() {
            return None
        }
        mut parts.push(Part(key: disk::copy_range(bytes, at: key_length.next, count: key_end - key_length.next, alloc), value: disk::copy_range(bytes, at: value_length.next, count: value_end - value_length.next, alloc)))
        at = value_end
    }
    if at != bytes.len() {
        return None
    }
    return Some(take parts)
} record_parts

/// The entries of the wire map `bytes` whose keys and values have schema nodes `key` and `value` of `schema`, `None` when they are no such map.
pkg fn map_parts(
    schema: mem::wire::Schema,
    key: usize,
    value: usize,
    bytes: Slice[u8],
    alloc: mem::Alloc,
    ) -> Option[mem::List[Part]] {
    let Some(count) = uvar_at(bytes, at: 0) else {
        return None
    }
    var parts = mem::List[Part].empty(alloc)
    var at = count.next
    for _ in 0..<count.value {
        let Some(key_end) = skip_value(schema, node: key, bytes, at, alloc) else {
            return None
        }
        let Some(value_end) = skip_value(schema, node: value, bytes, at: key_end, alloc) else {
            return None
        }
        mut parts.push(Part(key: disk::copy_range(bytes, at, count: key_end - at, alloc), value: disk::copy_range(bytes, at: key_end, count: value_end - key_end, alloc)))
        at = value_end
    }
    if at != bytes.len() {
        return None
    }
    return Some(take parts)
} map_parts

/// The wire bytes of a record of `fields`, or a map of entries, whose parts are in key order.
pkg fn joined(parts: Slice[Part], record: bool, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    put_uvar(mut bytes, value: u64.widen(parts.len()))
    for part in parts {
        if record {
            put_uvar(mut bytes, value: u64.widen(part.key.len()))
        }
        mut bytes.append(part.key.view())
        if record {
            put_uvar(mut bytes, value: u64.widen(part.value.len()))
        }
        mut bytes.append(part.value.view())
    }
    return bytes
} joined

/// The offset after the value of schema node `node` at `at` of `bytes`, `None` when it does not lie there whole: the sequences and maps under way wait on a stack, each with the values it has left.
fn skip_value(
    schema: mem::wire::Schema,
    node: usize,
    bytes: Slice[u8],
    at: usize,
    alloc: mem::Alloc,
    ) -> Option[usize] {
    var next = at
    var stack = mem::List[Skipping].empty(alloc)
    var current = Some(Skip(node: node, depth: 0))
    loop {
        match current {
            Some(skip) => {
                current = None
                if skip.depth > MOST_DEPTH or skip.node >= schema.nodes.len() {
                    return None
                }
                let opened = match schema.nodes[skip.node] {
                    mem::wire::SchemaNode.Sequence(element: element, length: _, capacity: _, unique: _) => Some(Skipping(lead: element, follower: None, left: 0, following: false, depth: skip.depth + 1))
                    mem::wire::SchemaNode.Map(key: key, value: value) => Some(Skipping(lead: key, follower: Some(value), left: 0, following: false, depth: skip.depth + 1))
                    else => None
                }
                match opened {
                    Some(many) => {
                        let Some(count) = uvar_at(bytes, at: next) else {
                            return None
                        }
                        next = count.next
                        var frame = many
                        frame.left = count.value
                        mut stack.push(frame)
                    }
                    None => {
                        let Some(end) = flat_end(schema, node: skip.node, bytes, at: next) else {
                            return None
                        }
                        next = end
                    }
                }
            }
            None => {
            }
        }
        let Some(top) = mut stack.pop() else {
            return Some(next)
        }
        var frame = top
        if frame.following {
            frame.following = false
            current = Some(Skip(node: frame.follower.value_or(schema.nodes.len()), depth: frame.depth))
            mut stack.push(frame)
            continue
        }
        if frame.left == 0 {
            continue
        }
        frame.left -= 1
        frame.following = frame.follower.is_some()
        current = Some(Skip(node: frame.lead, depth: frame.depth))
        mut stack.push(frame)
    }
} skip_value

/// A value to skip: its schema node and its depth.
struct Skip derives Copy {
    node: usize
    depth: u32
} Skip

/// A sequence or map a skip goes through: the schema nodes of its lead values and of the follower each map key has, the values left, whether a follower comes next, and the depth of its values.
struct Skipping derives Copy {
    lead: usize
    follower: Option[usize]
    left: u64
    following: bool
    depth: u32
} Skipping

/// The offset after a value of schema node `node` that holds no sequence or map of its own to go through, `None` when it does not lie there whole.
fn flat_end(schema: mem::wire::Schema, node: usize, bytes: Slice[u8], at: usize) -> Option[usize] {
    return match schema.nodes[node] {
        mem::wire::SchemaNode.Bool => bounded(at + 1, bytes)
        mem::wire::SchemaNode.Float(width: _) => bounded(at + 8, bytes)
        mem::wire::SchemaNode.Char or mem::wire::SchemaNode.Unsigned(width: _) or mem::wire::SchemaNode.Signed(width: _) => next_of(uvar_at(bytes, at))
        mem::wire::SchemaNode.Text or mem::wire::SchemaNode.Bytes or mem::wire::SchemaNode.BoundedText(capacity: _) => sized_end(bytes, at)
        mem::wire::SchemaNode.Record(open: _, fields: _) => skip_record(bytes, at)
        mem::wire::SchemaNode.Variant(open: _, variants: _) => skip_variant(bytes, at)
        else => None
    }
} flat_end

/// The offset after a record: its count, then per field its key text and its length-prefixed value.
fn skip_record(bytes: Slice[u8], at: usize) -> Option[usize] {
    let Some(count) = uvar_at(bytes, at) else {
        return None
    }
    var next = count.next
    for _ in 0..<count.value {
        let Some(key_end) = sized_end(bytes, at: next) else {
            return None
        }
        let Some(value_end) = sized_end(bytes, at: key_end) else {
            return None
        }
        next = value_end
    }
    return Some(next)
} skip_record

/// The offset after a variant: its key text, then `0x00`, or `0x01` and its length-prefixed payload.
fn skip_variant(bytes: Slice[u8], at: usize) -> Option[usize] {
    let Some(key_end) = sized_end(bytes, at) else {
        return None
    }
    if key_end >= bytes.len() {
        return None
    }
    if bytes[key_end] == 0 {
        return Some(key_end + 1)
    }
    return sized_end(bytes, at: key_end + 1)
} skip_variant

/// The offset after a length-prefixed value at `at`.
fn sized_end(bytes: Slice[u8], at: usize) -> Option[usize] {
    let Some(length) = uvar_at(bytes, at) else {
        return None
    }
    return bounded(length.next.saturating_add(usize.widen(length.value)), bytes)
} sized_end

fn bounded(end: usize, bytes: Slice[u8]) -> Option[usize] {
    if end > bytes.len() {
        return None
    }
    return Some(end)
} bounded

fn next_of(found: Option[Uvar]) -> Option[usize] {
    return match found {
        Some(read) => Some(read.next)
        None => None
    }
} next_of

/// The LEB128 value at `at` of `bytes`.
fn uvar_at(bytes: Slice[u8], at: usize) -> Option[Uvar] {
    var value: u64 = 0
    var shift: u32 = 0
    var next = at
    loop {
        if next >= bytes.len() or shift > 63 {
            return None
        }
        let byte = bytes[next]
        value = value | (u64.widen(byte & 0x7F) << shift)
        next += 1
        if (byte & 0x80) == 0 {
            return Some(Uvar(value: value, next: next))
        }
        shift += 7
    }
} uvar_at

fn put_uvar(mut bytes: mem::Bytes, value: u64) {
    var rest = value
    loop {
        let low = u8.truncate(rest & 0x7F)
        rest = rest >> 7
        if rest == 0 {
            mut bytes.push(low)
            return
        }
        mut bytes.push(low | 0x80)
    }
} put_uvar

test records_split_and_join_by_their_wire_bytes for record_parts {
    let alloc = testing::world().alloc
    let bytes = wire_of(Setting(level: 300, label: text::String.of("dial", alloc)), alloc)
    let Some(parts) = record_parts(bytes.view(), alloc) else {
        expect false
        return
    }
    expect parts.len() == 2 and parts[0].key.view() == b"label" and parts[1].key.view() == b"level"
    let rejoined = joined(parts.view(), record: true, alloc)
    expect rejoined == bytes
    var map = mem::Map[u32, text::String].empty(alloc)
    discard mut map.insert(1, value: text::String.of("one", alloc))
    discard mut map.insert(2, value: text::String.of("two", alloc))
    let encoded = wire_of(map, alloc)
    let schema = mem::wire::Codec[mem::Map[u32, text::String]].schema(alloc)
    let Some(entries) = map_parts(schema, key: 1, value: 2, bytes: encoded.view(), alloc) else {
        expect false
        return
    }
    expect entries.len() == 2 and entries[1].key.view() == b"\x02" and entries[1].value.view() == b"\x03two"
    let joined_map = joined(entries.view(), record: false, alloc)
    expect joined_map == encoded
} records_split_and_join_by_their_wire_bytes

/// Whether values of schema node `node` have an order: scalars but floats, and sequences, records and variants of ordered values; the nodes left to judge wait on a list.
pkg fn has_order(schema: mem::wire::Schema, node: usize, alloc: mem::Alloc) -> bool {
    var pending = mem::List[Skip].empty(alloc)
    mut pending.push(Skip(node: node, depth: 0))
    loop {
        let Some(next) = mut pending.pop() else {
            return true
        }
        if next.depth > MOST_DEPTH or next.node >= schema.nodes.len() {
            return false
        }
        match schema.nodes[next.node] {
            mem::wire::SchemaNode.Float(width: _) or mem::wire::SchemaNode.Map(key: _, value: _) or mem::wire::SchemaNode.Back(depth: _) => return false
            mem::wire::SchemaNode.Sequence(element: element, length: _, capacity: _, unique: _) => mut pending.push(Skip(node: element, depth: next.depth + 1))
            mem::wire::SchemaNode.Record(open: _, fields: fields) => {
                for field in fields {
                    mut pending.push(Skip(node: field.value, depth: next.depth + 1))
                }
            }
            mem::wire::SchemaNode.Variant(open: _, variants: variants) => {
                for variant in variants {
                    match variant.payload {
                        Some(payload) => mut pending.push(Skip(node: payload, depth: next.depth + 1))
                        None => {
                        }
                    }
                }
            }
            else => {
            }
        }
    }
} has_order

/// The order of the wire values `left` and `right` of schema node `node` as their type orders them: records by their fields in declaration order, variants by their declaration order then payload, sequences element by element; bytes it cannot read compare equal. The comparisons left wait on a stack, the next to decide on top.
pkg fn wire_order(
    schema: mem::wire::Schema,
    node: usize,
    left: Slice[u8],
    right: Slice[u8],
    alloc: mem::Alloc,
    ) -> core::Ordering {
    var pending = mem::List[Comparison].empty(alloc)
    mut pending.push(Comparison.Values(node: node, left: disk::copy_range(left, at: 0, count: left.len(), alloc), right: disk::copy_range(right, at: 0, count: right.len(), alloc), depth: 0))
    loop {
        let Some(next) = mut pending.pop() else {
            return core::Ordering.Equal
        }
        let order = match next {
            Comparison.Decided(decided) => decided
            Comparison.Values(node: compared, left: left_value, right: right_value, depth: depth) => compare_values(schema, node: compared, left: left_value.view(), right: right_value.view(), depth, mut pending, alloc)
        }
        if order != core::Ordering.Equal {
            return order
        }
    }
} wire_order

/// A comparison left to decide: two values of a schema node at a depth, or an order already known.
enum Comparison {
    Values(node: usize, left: mem::Bytes, right: mem::Bytes, depth: u32)
    Decided(core::Ordering)
} Comparison

/// The order of two values that their bytes alone decide, `Equal` for a sequence, record or variant, whose parts it pushes onto `pending` to decide next in order.
fn compare_values(
    schema: mem::wire::Schema,
    node: usize,
    left: Slice[u8],
    right: Slice[u8],
    depth: u32,
    mut pending: mem::List[Comparison],
    alloc: mem::Alloc,
    ) -> core::Ordering {
    if depth > MOST_DEPTH or node >= schema.nodes.len() {
        return core::Ordering.Equal
    }
    return match schema.nodes[node] {
        mem::wire::SchemaNode.Bool => left.cmp(right)
        mem::wire::SchemaNode.Char or mem::wire::SchemaNode.Unsigned(width: _) => uvar_value(left).cmp(uvar_value(right))
        mem::wire::SchemaNode.Signed(width: _) => signed_value(left).cmp(signed_value(right))
        mem::wire::SchemaNode.Text or mem::wire::SchemaNode.Bytes or mem::wire::SchemaNode.BoundedText(capacity: _) => sized_tail(left, alloc).view().cmp(sized_tail(right, alloc).view())
        mem::wire::SchemaNode.Sequence(element: element, length: _, capacity: _, unique: _) => push_sequence(schema, element, left, right, depth, mut pending, alloc)
        mem::wire::SchemaNode.Record(open: _, fields: fields) => push_record(fields: fields.view(), left, right, depth, mut pending, alloc)
        mem::wire::SchemaNode.Variant(open: _, variants: variants) => push_variant(variants: variants.view(), left, right, depth, mut pending, alloc)
        else => core::Ordering.Equal
    }
} compare_values

fn uvar_value(bytes: Slice[u8]) -> u64 {
    return match uvar_at(bytes, at: 0) {
        Some(read) => read.value
        None => 0
    }
} uvar_value

/// The value of a signed integer's zigzag uvar.
fn signed_value(bytes: Slice[u8]) -> i64 {
    let zigzag = uvar_value(bytes)
    let magnitude = zigzag >> 1
    if (zigzag & 1) == 0 {
        return i64.from_bits(magnitude)
    }
    return i64.from_bits(~magnitude)
} signed_value

/// The bytes of a text or byte string after its length.
fn sized_tail(bytes: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    let Some(length) = uvar_at(bytes, at: 0) else {
        return mem::Bytes.empty(alloc)
    }
    let end = usize.widen(length.value).saturating_add(length.next)
    if end > bytes.len() {
        return mem::Bytes.empty(alloc)
    }
    return disk::copy_range(bytes, at: length.next, count: end - length.next, alloc)
} sized_tail

/// Pushes the comparisons of two sequences: element by element, then their counts when every element compared reads; `Equal` when a count does not read.
fn push_sequence(
    schema: mem::wire::Schema,
    element: usize,
    left: Slice[u8],
    right: Slice[u8],
    depth: u32,
    mut pending: mem::List[Comparison],
    alloc: mem::Alloc,
    ) -> core::Ordering {
    let Some(left_count) = uvar_at(left, at: 0) else {
        return core::Ordering.Equal
    }
    let Some(right_count) = uvar_at(right, at: 0) else {
        return core::Ordering.Equal
    }
    var pairs = mem::List[Comparison].empty(alloc)
    var left_at = left_count.next
    var right_at = right_count.next
    var index: u64 = 0
    var read = true
    while index < left_count.value and index < right_count.value {
        let Some(left_end) = skip_value(schema, node: element, bytes: left, at: left_at, alloc) else {
            read = false
            break
        }
        let Some(right_end) = skip_value(schema, node: element, bytes: right, at: right_at, alloc) else {
            read = false
            break
        }
        mut pairs.push(Comparison.Values(node: element, left: disk::copy_range(left, at: left_at, count: left_end - left_at, alloc), right: disk::copy_range(right, at: right_at, count: right_end - right_at, alloc), depth: depth + 1))
        left_at = left_end
        right_at = right_end
        index += 1
    }
    if read {
        mut pending.push(Comparison.Decided(left_count.value.cmp(right_count.value)))
    }
    loop {
        let Some(pair) = mut pairs.pop() else {
            return core::Ordering.Equal
        }
        mut pending.push(take pair)
    }
} push_sequence

/// Pushes the comparisons of two records field by field in declaration order, a field only one side holds ordering that side after; `Equal` when a record does not read.
fn push_record(
    fields: Slice[mem::wire::SchemaField],
    left: Slice[u8],
    right: Slice[u8],
    depth: u32,
    mut pending: mem::List[Comparison],
    alloc: mem::Alloc,
    ) -> core::Ordering {
    let Some(left_parts) = record_parts(left, alloc) else {
        return core::Ordering.Equal
    }
    let Some(right_parts) = record_parts(right, alloc) else {
        return core::Ordering.Equal
    }
    var at = fields.len()
    while at > 0 {
        at -= 1
        let field = fields[at]
        let key = field.key.as_str().as_bytes()
        let left_at = part_index(left_parts.view(), key)
        let right_at = part_index(right_parts.view(), key)
        if left_at < left_parts.len() and right_at < right_parts.len() {
            mut pending.push(Comparison.Values(node: field.value, left: disk::copy_range(left_parts[left_at].value.view(), at: 0, count: left_parts[left_at].value.len(), alloc), right: disk::copy_range(right_parts[right_at].value.view(), at: 0, count: right_parts[right_at].value.len(), alloc), depth: depth + 1))
        } else if left_at < left_parts.len() {
            mut pending.push(Comparison.Decided(core::Ordering.Greater))
        } else if right_at < right_parts.len() {
            mut pending.push(Comparison.Decided(core::Ordering.Less))
        }
    }
    return core::Ordering.Equal
} push_record

/// The index of the part of key `key`, past the last for none.
fn part_index(parts: Slice[Part], key: Slice[u8]) -> usize {
    for at in 0..<parts.len() {
        if parts[at].key.view() == key {
            return at
        }
    }
    return parts.len()
} part_index

/// The order of two variants by their declaration order, pushing the comparison of their payloads when they are the same variant with one.
fn push_variant(
    variants: Slice[mem::wire::SchemaVariant],
    left: Slice[u8],
    right: Slice[u8],
    depth: u32,
    mut pending: mem::List[Comparison],
    alloc: mem::Alloc,
    ) -> core::Ordering {
    let left_index = variant_index(variants, key: sized_tail(left, alloc).view())
    let right_index = variant_index(variants, key: sized_tail(right, alloc).view())
    if left_index != right_index {
        return left_index.cmp(right_index)
    }
    if left_index >= variants.len() {
        return core::Ordering.Equal
    }
    let Some(payload) = variants[left_index].payload else {
        return core::Ordering.Equal
    }
    mut pending.push(Comparison.Values(node: payload, left: variant_payload(left, alloc), right: variant_payload(right, alloc), depth: depth + 1))
    return core::Ordering.Equal
} push_variant

fn variant_index(variants: Slice[mem::wire::SchemaVariant], key: Slice[u8]) -> usize {
    for at in 0..<variants.len() {
        if variants[at].key.as_str().as_bytes() == key {
            return at
        }
    }
    return variants.len()
} variant_index

/// The payload of a wire variant, empty for none.
fn variant_payload(bytes: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    let Some(key_end) = sized_end(bytes, at: 0) else {
        return mem::Bytes.empty(alloc)
    }
    if key_end >= bytes.len() or bytes[key_end] == 0 {
        return mem::Bytes.empty(alloc)
    }
    let Some(end) = sized_end(bytes, at: key_end + 1) else {
        return mem::Bytes.empty(alloc)
    }
    let payload = disk::copy_range(bytes, at: key_end + 1, count: end - key_end - 1, alloc)
    return sized_tail(payload.view(), alloc)
} variant_payload
