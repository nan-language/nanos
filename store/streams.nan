//! Streams: entries appended as runs logged with the commit appending them, read back from a sequence number on, and trimmed below one; a branch that changes a stream another head shares since a fork takes a stream of its own, its runs copied, and a stream no head reaches any more frees its runs.

/// Appends entries to the stream at `segments`, numbering them from its next sequence number.
pkg fn Store.append_entries[D: disk::Device](
    mut self,
    device: D,
    segments: Slice[mem::Bytes],
    entries: Slice[mem::Bytes],
    writing: Writing,
    mut staged: Staged,
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    let resolution = try await mut self.resolve(device, head: writing.head, segments, now: writing.now, alloc)
    let Some(found) = resolution.node() else {
        fail StoreError.NotFound
    }
    let Content.Stream(id: shared, declaration: declared, next: next, entries: count, bytes: size) = found.entry.content else {
        fail StoreError.Kind
    }
    let Declaration.Stream(stream) = try decode_declaration(declared.view(), alloc) else {
        fail StoreError.Corrupt
    }
    let id = try await mut self.own_stream(device, place: found.place, id: shared, writing, mut staged, alloc)
    var run = mem::List[StreamEntry].empty(alloc)
    var added: u64 = 0
    for value in entries {
        if value.len() > MOST_STREAM_ENTRY_BYTES {
            fail StoreError.TooLarge
        }
        var bytes = copied_bytes(value.view(), alloc)
        if not writing.typed {
            let canonical = try self.schemas.decode(stream.type.schema, raw: Untrusted.of(bytes.view()), alloc)
            bytes = accepted_bytes(canonical.view(), alloc)
        }
        added += u64.widen(bytes.len())
        mut run.push(StreamEntry(seq: next + u64.widen(run.len()), time: writing.now, value: take bytes))
    }
    let appended = u64.widen(run.len())
    mut staged.runs.push(PendingRun(stream: id, earliest: next, entries: take run, agent: writing.agent))
    mut staged.streams.push(found.place.copied(alloc))
    var entry = try found.entry.copied(alloc)
    entry.content = Content.Stream(id: id, declaration: copied_bytes(declared.view(), alloc), next: next + appended, entries: count + appended, bytes: size + added)
    mut self.tended.push(Tended(place: found.place.copied(alloc), expires: 0))
    discard try await mut self.change_entry(device, place: found.place.copied(alloc), entry: Some(take entry), versioned: false, mut staged, alloc)
} Store.append_entries

/// Drops the entries of the stream at `segments` below sequence number `below`.
pkg fn Store.trim_stream[D: disk::Device](
    mut self,
    device: D,
    segments: Slice[mem::Bytes],
    below: u64,
    writing: Writing,
    mut staged: Staged,
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    let resolution = try await mut self.resolve(device, head: writing.head, segments, now: writing.now, alloc)
    let Some(found) = resolution.node() else {
        fail StoreError.NotFound
    }
    let Content.Stream(id: shared, declaration: declared, next: next, entries: count, bytes: size) = found.entry.content else {
        fail StoreError.Kind
    }
    let earliest = next - count
    if below <= earliest {
        return
    }
    let cut = match below < next {
        true => below
        false => next
    }
    let dropped = try await mut self.entry_bytes_between(device, stream: shared, from: earliest, to: cut, alloc)
    let id = try await mut self.own_stream(device, place: found.place, id: shared, writing, mut staged, alloc)
    var entry = try found.entry.copied(alloc)
    entry.content = Content.Stream(id: id, declaration: copied_bytes(declared.view(), alloc), next: next, entries: count - (cut - earliest), bytes: size.saturating_sub(dropped))
    mut self.tended.push(Tended(place: found.place.copied(alloc), expires: 0))
    discard try await mut self.change_entry(device, place: found.place.copied(alloc), entry: Some(take entry), versioned: false, mut staged, alloc)
} Store.trim_stream

/// The entries of the stream at `path` of `branch` from sequence number `from` on, at most `limit`, and the count of those requested already dropped.
pub fn Store.read_stream[D: disk::Device](
    mut self,
    device: D,
    branch: Str,
    path: ident::Path,
    from: u64,
    limit: u32,
    now: ident::WallTime,
    alloc: mem::Alloc,
    ) -> StreamRead fails StoreError uses wait {
    let head = try self.head_named(branch)
    let segments = path.segments(alloc)
    let resolution = try await mut self.resolve(device, head, segments: segments.view(), now, alloc)
    let Some(found) = resolution.node() else {
        fail StoreError.NotFound
    }
    let Content.Stream(id: id, declaration: _, next: next, entries: count, bytes: _) = found.entry.content else {
        fail StoreError.Kind
    }
    let earliest = next - count
    let start = match from > earliest {
        true => from
        false => earliest
    }
    var read = StreamRead(entries: mem::List.empty(alloc), lost: earliest.saturating_sub(from))
    let runs = try await mut self.runs_of(device, stream: id, alloc)
    for run in runs {
        if run.earliest + u64.widen(run.run.count) <= start {
            continue
        }
        let held = try await mut self.run_entries(device, run: run.run, alloc)
        for entry in take held {
            if entry.seq >= start and entry.seq < next and read.entries.len() < usize.widen(limit) {
                mut read.entries.push(take entry)
            }
        }
        if read.entries.len() >= usize.widen(limit) {
            break
        }
    }
    return read
} Store.read_stream

/// What a stream read gives: entries in sequence order, and how many requested were already dropped.
pub closed struct StreamRead {
    pub entries: mem::List[StreamEntry]
    pub lost: u64
} StreamRead

/// A run of a stream: its earliest sequence number and its catalog entry.
pkg struct Run {
    pkg earliest: u64
    pkg run: StreamRun
} Run

/// Appends a run of entries to the log as a stream record, and gives its catalog entry's key and value.
pkg fn Store.log_run(mut self, run: PendingRun, time: i64, alloc: mem::Alloc) -> CatalogWrite fails StoreError {
    var key = Array[u8, 32].filled(0)
    mut key.view_mut().write_u64_le(0, value: run.stream)
    mut key.view_mut().write_u64_le(8, value: run.earliest)
    if run.agent {
        key[16] = 1
    }
    let payload = wire_of(run.entries, alloc)
    let placed = match attempt mut self.log.append(disk::RecordKind.Stream, key, payload: payload.view(), time, alloc) {
        Ok(found) => found
        Err(failure) => fail StoreError.of_log(take failure)
    }
    var bytes: u64 = 0
    var newest: i64 = 0
    for entry in run.entries {
        bytes += u64.widen(entry.value.len())
        newest = entry.time.utc_ns
    }
    let entry = StreamRun(record: placed.pointer.to_list(alloc), count: u32.fit(run.entries.len()), bytes: u32.saturate(bytes), time: newest, agent: run.agent)
    return CatalogWrite(key: run_key(run.stream, earliest: run.earliest, alloc), value: Some(wire_of(entry, alloc)))
} Store.log_run

/// The runs of stream `stream` in sequence order.
pkg fn Store.runs_of[D: disk::Device](mut self, device: D, stream: u64, alloc: mem::Alloc) -> mem::List[Run] fails StoreError uses wait {
    let start = run_key(stream, earliest: 1, alloc)
    var prefix = run_key(stream, earliest: 0, alloc)
    mut prefix.truncate(9)
    let leaves = try await mut self.tree_scan(device, root: self.catalog, prefix: prefix.view(), from: start.view(), limit: 0xFFFF_FFFF, alloc)
    var runs = mem::List[Run].empty(alloc)
    for leaf in leaves {
        let run = try decode_stream_run(leaf.value.view(), alloc)
        mut runs.push(Run(earliest: leaf.key.view().u64_be(9), run: take run))
    }
    return runs
} Store.runs_of

/// The entries a run's stream record holds.
pkg fn Store.run_entries[D: disk::Device](mut self, device: D, run: StreamRun, alloc: mem::Alloc) -> mem::List[StreamEntry] fails StoreError uses wait {
    let Some(pointer) = disk::Pointer.of_bytes(run.record.view()) else {
        fail StoreError.Corrupt
    }
    let record = match attempt await log::read_record(device, address: pointer.target, pointer, alloc) {
        Ok(Some(found)) => found
        Ok(None) => fail StoreError.Corrupt
        Err(failure) => fail StoreError.of_log(take failure)
    }
    return match attempt mem::wire::Codec[mem::List[StreamEntry]].decode(record.payload.view(), alloc) {
        Ok(entries) => entries
        Err(_) => fail StoreError.Corrupt
    }
} Store.run_entries

/// The bytes of the entries of stream `stream` from sequence number `from` to `to` exclusive.
fn Store.entry_bytes_between[D: disk::Device](
    mut self,
    device: D,
    stream: u64,
    from: u64,
    to: u64,
    alloc: mem::Alloc,
    ) -> u64 fails StoreError uses wait {
    var total: u64 = 0
    let runs = try await mut self.runs_of(device, stream, alloc)
    for run in runs {
        let end = run.earliest + u64.widen(run.run.count)
        if end <= from or run.earliest >= to {
            continue
        }
        if run.earliest >= from and end <= to {
            total += u64.widen(run.run.bytes)
            continue
        }
        let entries = try await mut self.run_entries(device, run: run.run, alloc)
        for entry in entries {
            if entry.seq >= from and entry.seq < to {
                total += u64.widen(entry.value.len())
            }
        }
    }
    return total
} Store.entry_bytes_between

/// The catalog key of the run of stream `stream` starting at sequence number `earliest`.
pkg fn run_key(stream: u64, earliest: u64, alloc: mem::Alloc) -> mem::Bytes {
    var key = mem::Bytes.zeroed(17, alloc)
    key[0] = KIND_STREAM_RUN
    mut key.view_mut().write_u64_be(1, value: stream)
    mut key.view_mut().write_u64_be(9, value: earliest)
    return key
} run_key

/// The heads whose tree holds stream `id` at `place`.
pkg fn Store.stream_holders[D: disk::Device](
    mut self,
    device: D,
    place: Place,
    id: u64,
    alloc: mem::Alloc,
    ) -> mem::List[usize] fails StoreError uses wait {
    var holders = mem::List[usize].empty(alloc)
    let key = entry_key(place.dir, name: place.name.view(), alloc)
    for at in 0..<self.heads.len() {
        let Some(bytes) = try await mut self.tree_get(device, root: self.root_at(at, tree: place.tree), key: key.view(), alloc) else {
            continue
        }
        let entry = try NodeEntry.decode_from(bytes.view(), alloc)
        match entry.content {
            Content.Stream(id: held, declaration: _, next: _, entries: _, bytes: _) => {
                if held == id {
                    mut holders.push(at)
                }
            }
            else => {
            }
        }
    }
    return holders
} Store.stream_holders

/// The stream id the commit changes the stream at `place`, of id `id`, under: `id`, unless another head holds it too, when the commit takes a new id and copies its runs to it.
fn Store.own_stream[D: disk::Device](
    mut self,
    device: D,
    place: Place,
    id: u64,
    writing: Writing,
    mut staged: Staged,
    alloc: mem::Alloc,
    ) -> u64 fails StoreError uses wait {
    let holders = try await mut self.stream_holders(device, place, id, alloc)
    var shared = false
    for at in holders {
        shared = shared or at != writing.head
    }
    if not shared {
        return id
    }
    let copy = self.counters.stream
    self.counters.stream += 1
    for run in try await mut self.runs_of(device, stream: id, alloc) {
        let entries = try await mut self.run_entries(device, run: run.run, alloc)
        mut staged.runs.push(PendingRun(stream: copy, earliest: run.earliest, entries: take entries, agent: run.run.agent))
    }
    return copy
} Store.own_stream

/// Frees the runs of stream `id`, which no head reaches any more, and its count of what heads reach.
pkg fn Store.free_stream[D: disk::Device](mut self, device: D, id: u64, alloc: mem::Alloc) fails StoreError uses wait {
    for run in try await mut self.runs_of(device, stream: id, alloc) {
        discard try await mut self.catalog_remove(device, key: run_key(id, earliest: run.earliest, alloc).view(), alloc)
        if run.run.agent {
            mut self.count_bytes(history: 0, agents: 0 - i64.widen(run.run.bytes))
        }
        let Some(pointer) = disk::Pointer.of_bytes(run.run.record.view()) else {
            continue
        }
        mut self.log.release(pointer.target, bytes: u64.widen(disk::record_span(pointer.length)))
    }
    discard try await mut self.catalog_remove(device, key: run_key(id, earliest: 0, alloc).view(), alloc)
} Store.free_stream
