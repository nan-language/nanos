//! The store: one versioned, transactional, content-addressed store of records, blobs, dirs and streams on a volume, with commits, branches, merges, history and retention.

/// Why a store operation failed: a code of the `store`, `schema` and `conflict` families, or `request.key-reused`.
pub closed enum StoreError {
    NotFound
    Denied
    Kind
    TooLarge
    Full
    Thinned(retained: u64)
    Unversioned
    HashMismatch
    ReadOnly
    BranchExists
    BranchReserved
    Corrupt
    Io
    NoVolume
    FormatUnsupported
    Locked
    ConflictWrite
    ConflictRead
    ConflictExpect
    ConflictMerge(mem::List[Conflict])
    ConflictRevert(mem::List[Conflict])
    SchemaInvalid(mem::wire::DecodeFailure)
    SchemaMismatch
    SchemaUnknown
    KeyReused
    Cancelled(task::Cancelled) from
} StoreError

/// What the store stamps on a commit from the View and the message carrying it: the principal on whose authority it is made, the session or instance writing it, its cause and origin set, and whether its writes are typed.
pub closed struct Stamp {
    pub principal: ident::Principal
    pub session: Option[ident::SessionId]
    pub instance: Option[ident::Moniker]
    pub cause: ident::Cause
    pub origins: mem::List[ident::OriginLabel]
    pub typed: bool
} Stamp
