//! Commits, branches, pins and retention as the store records them, and the conflicts, takes and edits of merges, reverts and diffs.

pub closed enum CommitKind derives Eq, Encode {
    Write
    Merge(source: text::String)
    Revert(of: ident::CommitId)
    Genesis
} CommitKind

pub closed struct CommitMeta derives Eq, Encode {
    pub number: ident::CommitId
    pub branch: text::String
    pub parents: mem::List[ident::CommitId]
    pub kind: CommitKind
    pub principal: ident::Principal
    pub session: Option[ident::SessionId]
    pub instance: Option[ident::Moniker]
    pub cause: ident::Cause
    pub plan: Option[ident::HashValue]
    pub intent: Option[text::String]
    pub origins: mem::List[ident::OriginLabel]
    pub key: Option[text::String]
    pub time: ident::WallTime
    pub recorded: bool
    pub root: Option[ident::HashValue]
} CommitMeta

pub closed struct Branch derives Eq, Encode {
    pub name: text::String
    pub head: ident::CommitId
    pub fork: ident::CommitId
    pub parent: Option[text::String]
    pub created_by: ident::Principal
    pub expires: Option[ident::WallTime]
} Branch

pub closed enum PinReason derives Copy, Eq, Encode {
    Generation
    Approval
    Plan
    Branch
    Explicit
} PinReason

pub closed struct Pin derives Eq, Encode {
    pub commit: ident::CommitId
    pub reason: PinReason
    pub by: ident::Principal
    pub note: Option[text::String]
} Pin

/// One tier of retention: among commits younger than `age_s`, one per `every_s` seconds, or all when `every_s` is 0.
pub closed struct Tier derives Copy, Eq, Encode {
    pub every_s: u64
    pub age_s: u64
} Tier

pub closed struct Retention derives Eq, Encode {
    pub tiers: mem::List[Tier]
    pub max_pct: u8 where max_pct <= 50
    pub agent_pct: u8 where agent_pct <= 50
} Retention

pub closed enum ConflictKind derives Copy, Eq, Encode {
    Both
    DeleteChange
    KindChange
    TypeChange
    Invalid
} ConflictKind

pub closed struct Conflict derives Eq, Encode {
    pub path: ident::Path
    pub field: Option[text::String]
    pub kind: ConflictKind
    pub base: Option[ident::HashValue]
    pub source: Option[ident::HashValue]
    pub target: Option[ident::HashValue]
} Conflict

pub closed enum Side derives Copy, Eq, Encode {
    Source
    Target
} Side

pub closed struct Take derives Eq, Encode {
    pub path: ident::Path
    pub side: Side
} Take

pub closed enum Change derives Copy, Eq, Encode {
    Added
    Removed
    Changed
} Change

pub closed struct FieldEdit derives Eq, Encode {
    pub field: text::String
    pub from: Option[mem::Bytes]
    pub to: Option[mem::Bytes]
} FieldEdit

pub closed struct Edit derives Eq, Encode {
    pub path: ident::Path
    pub change: Change
    pub from: Option[ident::HashValue]
    pub to: Option[ident::HashValue]
    pub fields: mem::List[FieldEdit]
} Edit

/// The retention of `/sys/config/store` by default: every commit younger than 1 h, one per 10 min younger than 24 h, one per hour younger than 7 days and one per day younger than 90 days, history and agent bytes each holding at most 25% of the capacity.
pub fn Retention.default_of(alloc: mem::Alloc) -> Retention {
    var tiers = mem::List[Tier].empty(alloc)
    mut tiers.push(Tier(every_s: 0, age_s: 3_600))
    mut tiers.push(Tier(every_s: 600, age_s: 86_400))
    mut tiers.push(Tier(every_s: 3_600, age_s: 604_800))
    mut tiers.push(Tier(every_s: 86_400, age_s: 7_776_000))
    return Retention(tiers: take tiers, max_pct: 25, agent_pct: 25)
} Retention.default_of
