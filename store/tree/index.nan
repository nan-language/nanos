//! The index's state: the item table's root, the nodes in memory, and the item changes the next index flush applies; and lookups, inserts and removals in its trees, copying each node more than one tree references.

/// The top bit of the in-memory id of an item-table node not yet written, above every address.
const DIRTY_BIT: u64 = 0x8000_0000_0000_0000

/// Why an index operation failed.
pkg enum TreeFailure derives Render {
    Corrupt
    Full
    TooLarge
    Io
    Cancelled(task::Cancelled) from
} TreeFailure

/// What the index tells of the values of a tree's leaves: that a leaf holding one was copied or freed, or began or ceased to be reached from a branch head; and whether the tree being changed is a head's, whose nodes and values the heads reach.
pkg interface Values {
    fn retain(mut self, tree: u8, value: Slice[u8])
    fn release(mut self, tree: u8, value: Slice[u8])
    fn reach(mut self, tree: u8, value: Slice[u8], delta: i64)
    fn reaches_heads(self) -> bool
} Values

/// A tree: its number and its top node by in-memory id, with the pointer it was last written under.
pkg struct Root derives Copy, Eq {
    pkg tree: u8
    pkg node: u64
    pkg pointer: disk::Pointer
} Root

/// An item table entry: where an item's record lies, its length and kind, the index and catalog entries naming it, those of them that branch heads reach, the tree of a node, 0 for a value, and whether an agent or child principal added the value.
pkg struct ItemEntry derives Copy, Eq, Render, Encode {
    pkg address: u64
    pkg length: u32
    pkg kind: u8
    pkg refcount: u32
    pkg heads: u32
    pkg tree: u8
    pkg agent: bool
} ItemEntry

/// A change to an item's entry that collects until an index flush: a new place for its record, a change of its reference count and of its references from what heads reach, its tree and whether an agent added it, for a node the pointer last naming it, and whether its children and values count it among what heads reach them through.
struct ItemChange derives Copy {
    placed: bool
    address: u64
    length: u32
    kind: u8
    delta: i64
    heads: i64
    described: bool
    agent: bool
    tree: u8
    pointer: disk::Pointer
    reaching: Reaching
} ItemChange

/// Whether a node's children and values count it among the referrers that heads reach: as its entry's references say, or as decided since.
enum Reaching derives Copy, Eq {
    Stored
    Reaches
    Unreached
} Reaching

/// A record whose bytes no structure names any more.
pkg struct Retired derives Copy, Eq {
    pkg address: u64
    pkg length: u32
} Retired

/// The totals of a subtree: the count and value bytes of its leaf entries.
pkg struct Totals derives Copy, Eq {
    pkg count: u64
    pkg bytes: u64
} Totals

/// What changing a node gives its parent: its totals, and the node split from it when it outgrew 16 KiB.
struct Changed {
    totals: Totals
    split: Option[Child]
} Changed

/// What removing a key below a node gives its parent: its totals, and whether it is left without entries.
struct Removed derives Copy {
    totals: Totals
    empty: bool
} Removed

/// The index: the item table's root, the next item id, the nodes in memory by item id and the item table's by address or dirty id, the item changes the next index flush applies, and the records gone stale since the last.
pkg struct Index {
    pkg items: Root
    pkg next_item: u64
    nodes: mem::HashMap[u64, Node]
    table: mem::HashMap[u64, Node]
    next_dirty: u64
    changes: mem::HashMap[u64, ItemChange]
    pkg stale: mem::List[Retired]
    pkg history_change: i64
    pkg agents_change: i64
} Index

/// The index of a volume whose item table's top node `items` names.
pkg fn Index.of(items: Root, next_item: u64, alloc: mem::Alloc) -> Index {
    return Index(items: items, next_item: next_item, nodes: mem::HashMap.empty(seed: 0x5354_4F52, alloc), table: mem::HashMap.empty(seed: 0x5441_424C, alloc), next_dirty: DIRTY_BIT, changes: mem::HashMap.empty(seed: 0x4348_4E47, alloc), stale: mem::List.empty(alloc), history_change: 0, agents_change: 0)
} Index.of

/// The index of an empty volume: an item table of one empty leaf.
pkg fn Index.empty(next_item: u64, alloc: mem::Alloc) -> Index {
    var index = Index.of(Root(tree: ITEM_TABLE, node: 0, pointer: disk::Pointer.none()), next_item, alloc)
    index.items = mut index.new_tree(ITEM_TABLE, alloc)
    return index
} Index.empty

/// A new tree of one empty leaf, which nothing names yet.
pkg fn Index.new_tree(mut self, tree: u8, alloc: mem::Alloc) -> Root {
    let id = mut self.new_node_id(tree)
    discard mut self.keep(tree, id, node: Node.leaf(tree, item: item_of(tree, id), alloc))
    return Root(tree: tree, node: id, pointer: disk::Pointer.none())
} Index.new_tree

/// A new item id.
pkg fn Index.new_item(mut self) -> u64 {
    let item = self.next_item
    self.next_item += 1
    return item
} Index.new_item

/// Records that the record of `item` lies at `address`, its payload `length` bytes of `kind`.
pkg fn Index.place(
    mut self,
    item: u64,
    address: u64,
    length: u32,
    kind: u8,
    ) {
    var change = self.change_of(item)
    change.placed = true
    change.address = address
    change.length = length
    change.kind = kind
    discard mut self.changes.insert(item, value: change)
} Index.place

/// Records that `item` is a node of `tree`, or a value for tree 0, added by an agent or child principal when `agent`.
pkg fn Index.describe(mut self, item: u64, tree: u8, agent: bool) {
    var change = self.change_of(item)
    change.described = true
    change.tree = tree
    change.agent = agent
    discard mut self.changes.insert(item, value: change)
} Index.describe

/// One more referrer that heads reach names `item`, or one fewer for a negative `delta`.
pkg fn Index.reach(mut self, item: u64, delta: i64) {
    var change = self.change_of(item)
    change.heads += delta
    discard mut self.changes.insert(item, value: change)
} Index.reach

/// One more entry names `item`, a new node of `tree` whose children and values count it among what heads reach when `heads`; one more referrer that heads reach too when `heads`.
fn Index.retain_new(mut self, item: u64, tree: u8, heads: bool) {
    var change = self.change_of(item)
    change.delta += 1
    change.tree = tree
    if heads {
        change.heads += 1
        change.reaching = Reaching.Reaches
    } else {
        change.reaching = Reaching.Unreached
    }
    discard mut self.changes.insert(item, value: change)
} Index.retain_new

/// One more entry names `item`.
pkg fn Index.retain(mut self, item: u64) {
    var change = self.change_of(item)
    change.delta += 1
    discard mut self.changes.insert(item, value: change)
} Index.retain

/// One entry fewer names `item`, a node of `tree` that `pointer` names, or for tree 0 a value.
pkg fn Index.release(mut self, item: u64, tree: u8, pointer: disk::Pointer) {
    var change = self.change_of(item)
    change.delta -= 1
    change.tree = tree
    change.pointer = pointer
    discard mut self.changes.insert(item, value: change)
} Index.release

/// The entry of `item` with its pending changes applied, `None` for an item without one.
pkg fn Index.item_entry[D: disk::Device](mut self, device: D, item: u64, alloc: mem::Alloc) -> Option[ItemEntry] fails TreeFailure uses wait {
    let stored = try await mut self.stored_entry(device, item, alloc)
    let Some(change) = self.changes.get(item) else {
        return stored
    }
    var entry = stored.value_or(ItemEntry(address: 0, length: 0, kind: 0, refcount: 0, heads: 0, tree: 0, agent: false))
    if change.placed {
        entry.address = change.address
        entry.length = change.length
        entry.kind = change.kind
    }
    if change.described {
        entry.tree = change.tree
        entry.agent = change.agent
    }
    entry.refcount = u32.saturate(i64.widen(entry.refcount) + change.delta)
    entry.heads = u32.saturate(i64.widen(entry.heads) + change.heads)
    return Some(entry)
} Index.item_entry

/// The number of entries naming `item`, its pending changes included.
pkg fn Index.refcount[D: disk::Device](mut self, device: D, item: u64, alloc: mem::Alloc) -> i64 fails TreeFailure uses wait {
    let stored = try await mut self.stored_entry(device, item, alloc)
    let base = match stored {
        Some(entry) => i64.widen(entry.refcount)
        None => 0
    }
    return base + self.change_of(item).delta
} Index.refcount

/// The value `key` holds in the tree under `root`.
pkg fn Index.get[D: disk::Device](
    mut self,
    device: D,
    root: Root,
    key: Slice[u8],
    alloc: mem::Alloc,
    ) -> Option[mem::Bytes] fails TreeFailure uses wait {
    var id = root.node
    var pointer = root.pointer
    loop {
        try await mut self.load(device, tree: root.tree, id, pointer, alloc)
        let Some(node) = self.node_at(root.tree, id) else {
            fail TreeFailure.Corrupt
        }
        if node.is_leaf() {
            let at = node.search(key)
            if at < node.leaves.len() and node.leaves[at].key.view() == key {
                return Some(disk::copy_range(node.leaves[at].value.view(), at: 0, count: node.leaves[at].value.len(), alloc))
            }
            return None
        }
        let child = node.children[node.route(key)]
        id = child.node
        pointer = child.pointer
    }
} Index.get

/// Inserts or replaces the value of `key` in the tree under `root`, copying every node on its path that another tree references: the path down to the leaf is made writable and recorded, then settled from the leaf up, each split entering its parent.
pkg fn Index.put[D: disk::Device, V: Values](
    mut self,
    device: D,
    mut root: Root,
    key: Slice[u8],
    value: Slice[u8],
    mut values: V,
    alloc: mem::Alloc,
    ) fails TreeFailure uses wait {
    if disk::BLOCK_BYTES < leaf_bytes(key.len(), value: value.len()) {
        fail TreeFailure.TooLarge
    }
    let tree = root.tree
    root.node = try await mut self.writable(device, tree, id: root.node, pointer: root.pointer, mut values, alloc)
    var path = try await mut self.writable_path(device, tree, top: root.node, key, mut values, alloc)
    let Some(bottom) = mut path.pop() else {
        fail TreeFailure.Corrupt
    }
    let Some(leaf) = mut self.withdraw(tree, id: bottom.child) else {
        fail TreeFailure.Corrupt
    }
    var node = leaf
    mut node.set_leaf(key, value, alloc)
    let Changed(totals: leaf_totals, split: leaf_split) = mut self.settle_node(tree, id: bottom.child, take node, alloc)
    var totals = leaf_totals
    var split = leaf_split
    loop {
        let Some(step) = mut path.pop() else {
            break
        }
        let Some(held) = mut self.withdraw(tree, id: step.parent) else {
            fail TreeFailure.Corrupt
        }
        var parent = held
        parent.children[step.at].node = step.child
        parent.children[step.at].count = totals.count
        parent.children[step.at].bytes = totals.bytes
        if step.at == 0 and key < parent.children[0].key.view() {
            parent.children[0].key = disk::copy_range(key, at: 0, count: key.len(), alloc)
        }
        match split {
            Some(sibling) => {
                if tree != ITEM_TABLE {
                    mut self.retain_new(sibling.node, tree, heads: values.reaches_heads())
                }
                mut parent.children.insert(step.at + 1, value: take sibling)
            }
            None => {
            }
        }
        let Changed(totals: settled, split: rest) = mut self.settle_node(tree, id: step.parent, node: take parent, alloc)
        totals = settled
        split = rest
    }
    let Some(sibling) = split else {
        return
    }
    mut self.grow(mut root, take sibling, totals, heads: values.reaches_heads(), alloc)
} Index.put

/// A step of a path down a tree: the node, the position of the child the path takes in it, and that child's writable id; the bottom step names the leaf alone, as its child.
struct Step derives Copy {
    parent: u64
    at: usize
    child: u64
} Step

/// The path from the writable node `top` down to the leaf where `key` lies, each child on it made writable.
fn Index.writable_path[D: disk::Device, V: Values](
    mut self,
    device: D,
    tree: u8,
    top: u64,
    key: Slice[u8],
    mut values: V,
    alloc: mem::Alloc,
    ) -> mem::List[Step] fails TreeFailure uses wait {
    var path = mem::List[Step].empty(alloc)
    var id = top
    loop {
        let Some(node) = self.node_at(tree, id) else {
            fail TreeFailure.Corrupt
        }
        if node.is_leaf() {
            mut path.push(Step(parent: 0, at: 0, child: id))
            return path
        }
        let at = node.route(key)
        let below = node.children[at].node
        let pointer = node.children[at].pointer
        let writable = try await mut self.writable(device, tree, id: below, pointer, mut values, alloc)
        mut path.push(Step(parent: id, at: at, child: writable))
        id = writable
    }
} Index.writable_path

/// Removes `key` from the tree under `root` and gives the value it held: the path down to the leaf is made writable and recorded, then settled from the leaf up, each child left without entries removed from its parent.
pkg fn Index.remove[D: disk::Device, V: Values](
    mut self,
    device: D,
    mut root: Root,
    key: Slice[u8],
    mut values: V,
    alloc: mem::Alloc,
    ) -> Option[mem::Bytes] fails TreeFailure uses wait {
    let held = try await mut self.get(device, root, key, alloc)
    if held.is_none() {
        return None
    }
    let tree = root.tree
    root.node = try await mut self.writable(device, tree, id: root.node, pointer: root.pointer, mut values, alloc)
    var path = try await mut self.writable_path(device, tree, top: root.node, key, mut values, alloc)
    let Some(bottom) = mut path.pop() else {
        fail TreeFailure.Corrupt
    }
    let Some(leaf) = mut self.withdraw(tree, id: bottom.child) else {
        fail TreeFailure.Corrupt
    }
    var node = leaf
    var value: Option[mem::Bytes] = None
    let at = node.search(key)
    if at < node.leaves.len() and node.leaves[at].key.view() == key {
        let Leaf(key: _, value: old) = mut node.leaves.remove(at)
        value = Some(take old)
    }
    var removed = mut self.settle_removal(tree, id: bottom.child, take node)
    loop {
        let Some(step) = mut path.pop() else {
            break
        }
        let Some(above) = mut self.withdraw(tree, id: step.parent) else {
            fail TreeFailure.Corrupt
        }
        var parent = above
        parent.children[step.at].node = step.child
        parent.children[step.at].count = removed.totals.count
        parent.children[step.at].bytes = removed.totals.bytes
        if removed.empty {
            let gone = mut parent.children.remove(step.at)
            if tree != ITEM_TABLE {
                mut self.release(step.child, tree, pointer: gone.pointer)
                if values.reaches_heads() {
                    mut self.reach(step.child, delta: -1)
                }
            }
        }
        removed = mut self.settle_removal(tree, id: step.parent, node: take parent)
    }
    if removed.empty {
        let Some(top) = mut self.withdraw(tree, id: root.node) else {
            fail TreeFailure.Corrupt
        }
        var emptied = top
        emptied.level = 0
        mut emptied.children.truncate(0)
        discard mut self.keep(tree, id: root.node, node: take emptied)
    }
    return value
} Index.remove

/// Puts a node a removal changed back, dirty, giving its totals and whether it is left without entries.
fn Index.settle_removal(mut self, tree: u8, id: u64, take node: Node) -> Removed {
    var held = node
    let totals = held.totals()
    let empty = held.count() == 0
    held.dirty = true
    discard mut self.keep(tree, id, node: take held)
    return Removed(totals: totals, empty: empty)
} Index.settle_removal

/// The totals of the tree under `root`.
pkg fn Index.totals[D: disk::Device](mut self, device: D, root: Root, alloc: mem::Alloc) -> Totals fails TreeFailure uses wait {
    try await mut self.load(device, tree: root.tree, id: root.node, pointer: root.pointer, alloc)
    let Some(node) = self.node_at(root.tree, id: root.node) else {
        fail TreeFailure.Corrupt
    }
    return node.totals()
} Index.totals

/// Makes the node `id` of `tree` safe to change in place: a copy under a new id when another tree references it, the copy naming everything the node names; marked dirty either way.
fn Index.writable[D: disk::Device, V: Values](
    mut self,
    device: D,
    tree: u8,
    id: u64,
    pointer: disk::Pointer,
    mut values: V,
    alloc: mem::Alloc,
    ) -> u64 fails TreeFailure uses wait {
    try await mut self.load(device, tree, id, pointer, alloc)
    if tree == ITEM_TABLE {
        return mut self.dirty_table_node(id)
    }
    let count = try await mut self.refcount(device, item: id, alloc)
    let Some(held) = mut self.withdraw(tree, id) else {
        fail TreeFailure.Corrupt
    }
    var node = held
    if count <= 1 {
        node.dirty = true
        discard mut self.keep(tree, id, take node)
        return id
    }
    let copy = mut self.new_node_id(tree)
    let duplicate = node.duplicate(item: copy, mut values, alloc)
    let heads = values.reaches_heads()
    for child in duplicate.children {
        mut self.retain(child.node)
        if heads {
            mut self.reach(child.node, delta: 1)
        }
    }
    discard mut self.keep(tree, id, take node)
    discard mut self.keep(tree, id: copy, node: take duplicate)
    mut self.release(id, tree, pointer)
    if heads {
        mut self.reach(id, delta: -1)
    }
    mut self.retain_new(copy, tree, heads)
    return copy
} Index.writable

/// Gives an item-table node a dirty id, under which it is changed until the next index flush writes it.
fn Index.dirty_table_node(mut self, id: u64) -> u64 {
    if (id & DIRTY_BIT) != 0 {
        return id
    }
    let Some(held) = mut self.withdraw(ITEM_TABLE, id) else {
        return id
    }
    var node = held
    node.dirty = true
    mut self.stale.push(Retired(address: id, length: u32.truncate(NODE_BYTES)))
    let dirty = mut self.new_node_id(ITEM_TABLE)
    discard mut self.keep(ITEM_TABLE, id: dirty, take node)
    return dirty
} Index.dirty_table_node

/// Puts a changed node back, split in two when it outgrew 16 KiB, and gives its totals and the split-off node.
fn Index.settle_node(
    mut self,
    tree: u8,
    id: u64,
    take node: Node,
    alloc: mem::Alloc,
    ) -> Changed {
    var held = node
    held.dirty = true
    if held.encoded_bytes() <= NODE_BYTES {
        let totals = held.totals()
        discard mut self.keep(tree, id, node: take held)
        return Changed(totals: totals, split: None)
    }
    let right_id = mut self.new_node_id(tree)
    let right = mut held.split_off(item: item_of(tree, id: right_id), alloc)
    let sibling = Child(key: right.first_key(alloc), node: right_id, pointer: disk::Pointer.none(), count: right.totals().count, bytes: right.totals().bytes)
    let totals = held.totals()
    discard mut self.keep(tree, id, node: take held)
    discard mut self.keep(tree, id: right_id, node: take right)
    return Changed(totals: totals, split: Some(take sibling))
} Index.settle_node

/// Grows the tree under `root` by a level: a new top node over its old one and the node split from it.
fn Index.grow(
    mut self,
    mut root: Root,
    take sibling: Child,
    totals: Totals,
    heads: bool,
    alloc: mem::Alloc,
    ) {
    let top = mut self.new_node_id(root.tree)
    let item = item_of(root.tree, id: top)
    let level = match self.node_at(root.tree, id: root.node) {
        Some(old) => old.level + 1
        None => 1
    }
    var node = Node(tree: root.tree, level: level, item: item, leaves: mem::List.empty(alloc), children: mem::List.empty(alloc), dirty: true)
    mut node.children.push(Child(key: mem::Bytes.empty(alloc), node: root.node, pointer: root.pointer, count: totals.count, bytes: totals.bytes))
    let sibling_id = sibling.node
    mut node.children.push(take sibling)
    discard mut self.keep(root.tree, id: top, take node)
    if root.tree != ITEM_TABLE {
        mut self.retain_new(sibling_id, tree: root.tree, heads)
        mut self.retain_new(top, tree: root.tree, heads)
    }
    root.node = top
} Index.grow

/// Loads the node `id` of `tree` into memory, read through `pointer` when it is not there: an item-table node at its address, any other at the address its item's entry gives.
pkg fn Index.load[D: disk::Device](
    mut self,
    device: D,
    tree: u8,
    id: u64,
    pointer: disk::Pointer,
    alloc: mem::Alloc,
    ) fails TreeFailure uses wait {
    if tree == ITEM_TABLE {
        try await mut self.load_table(device, id, pointer, alloc)
        return
    }
    if self.node_at(tree, id).is_some() {
        return
    }
    let Some(entry) = try await mut self.item_entry(device, item: id, alloc) else {
        fail TreeFailure.Corrupt
    }
    try await mut self.read_node(device, tree, id, address: entry.address, pointer, alloc)
} Index.load

/// Loads the item-table node `id`, which lies at its address, into memory when it is not there.
fn Index.load_table[D: disk::Device](
    mut self,
    device: D,
    id: u64,
    pointer: disk::Pointer,
    alloc: mem::Alloc,
    ) fails TreeFailure uses wait {
    if self.node_at(ITEM_TABLE, id).is_some() {
        return
    }
    try await mut self.read_node(device, tree: ITEM_TABLE, id, address: id, pointer, alloc)
} Index.load_table

/// Reads the node `id` of `tree` at `address` through `pointer` and keeps it in memory.
fn Index.read_node[D: disk::Device](
    mut self,
    device: D,
    tree: u8,
    id: u64,
    address: u64,
    pointer: disk::Pointer,
    alloc: mem::Alloc,
    ) fails TreeFailure uses wait {
    let record = match attempt await log::read_record(device, address, pointer, alloc) {
        Ok(Some(found)) => found
        Ok(None) => fail TreeFailure.Corrupt
        Err(log::LogFailure.Cancelled(cancelled)) => fail cancelled
        Err(log::LogFailure.Io) or Err(log::LogFailure.Full) or Err(log::LogFailure.TooLarge) => fail TreeFailure.Io
    }
    let Some(node) = Node.read(record.payload.view(), tree, item: item_of(tree, id), alloc) else {
        fail TreeFailure.Corrupt
    }
    discard mut self.keep(tree, id, take node)
} Index.read_node

/// The node `id` of `tree` in memory.
pkg proj fn Index.node_at(self, tree: u8, id: u64) -> Option[Node] {
    if tree == ITEM_TABLE {
        return self.table.get(id)
    }
    return self.nodes.get(id)
} Index.node_at

/// Withdraws the node `id` of `tree` from memory.
pkg fn Index.withdraw(mut self, tree: u8, id: u64) -> Option[Node] {
    if tree == ITEM_TABLE {
        return mut self.table.remove(id)
    }
    return mut self.nodes.remove(id)
} Index.withdraw

/// Keeps the node `id` of `tree` in memory.
pkg fn Index.keep(mut self, tree: u8, id: u64, take node: Node) -> Option[Node] {
    if tree == ITEM_TABLE {
        return mut self.table.insert(id, value: take node)
    }
    return mut self.nodes.insert(id, value: take node)
} Index.keep

/// A new in-memory id for a node of `tree`: an item id, or a dirty id for an item-table node.
fn Index.new_node_id(mut self, tree: u8) -> u64 {
    if tree == ITEM_TABLE {
        self.next_dirty += 1
        return self.next_dirty
    }
    return mut self.new_item()
} Index.new_node_id

/// The item id a node of `tree` under in-memory id `id` holds: none in the item table.
fn item_of(tree: u8, id: u64) -> u64 {
    if tree == ITEM_TABLE {
        return 0
    }
    return id
} item_of

/// The pending change of `item`, none yet when it has none.
fn Index.change_of(self, item: u64) -> ItemChange {
    return match self.changes.get(item) {
        Some(change) => change
        None => ItemChange(placed: false, address: 0, length: 0, kind: 0, delta: 0, heads: 0, described: false, agent: false, tree: 0, pointer: disk::Pointer.none(), reaching: Reaching.Stored)
    }
} Index.change_of

/// The entry the item table holds for `item`, its pending changes left out.
fn Index.stored_entry[D: disk::Device](mut self, device: D, item: u64, alloc: mem::Alloc) -> Option[ItemEntry] fails TreeFailure uses wait {
    var key = Array[u8, 8].filled(0)
    mut key.view_mut().write_u64_be(0, value: item)
    var id = self.items.node
    var pointer = self.items.pointer
    loop {
        try await mut self.load_table(device, id, pointer, alloc)
        let Some(node) = self.node_at(ITEM_TABLE, id) else {
            fail TreeFailure.Corrupt
        }
        if node.is_leaf() {
            let at = node.search(key.view())
            if at >= node.leaves.len() or node.leaves[at].key.view() != key.view() {
                return None
            }
            return match attempt mem::wire::Codec[ItemEntry].decode(Untrusted.of(node.leaves[at].value.view()), alloc) {
                Ok(entry) => Some(entry)
                Err(_) => fail TreeFailure.Corrupt
            }
        }
        let child = node.children[node.route(key.view())]
        id = child.node
        pointer = child.pointer
    }
} Index.stored_entry
