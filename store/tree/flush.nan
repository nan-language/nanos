//! Index flushes: dirty nodes written to the log children first, items no entry names freed with what they name, and every item's place and count written to the item table.

/// The values of the item table's leaves, which name nothing.
pkg struct NoValues derives Copy {
} NoValues

impl NoValues: Values

pkg fn NoValues.retain(mut self, tree: u8, value: Slice[u8]) {
} NoValues.retain

pkg fn NoValues.release(mut self, tree: u8, value: Slice[u8]) {
} NoValues.release

pkg fn NoValues.reach(mut self, tree: u8, value: Slice[u8], delta: i64) {
} NoValues.reach

pkg fn NoValues.reaches_heads(self) -> bool = false

/// A node as an index flush wrote it: its in-memory id and the pointer naming it.
struct Written derives Copy {
    id: u64
    pointer: disk::Pointer
} Written

/// Writes the dirty nodes of the tree under `root` to the log, children first, and gives the tree with its top node's pointer: the nodes under way wait on a stack, each with the next child to write.
pkg fn Index.write_tree(
    mut self,
    mut log: log::Log,
    root: Root,
    flush: u64,
    time: i64,
    alloc: mem::Alloc,
    ) -> Root fails TreeFailure {
    let tree = root.tree
    var stack = mem::List[Writing].empty(alloc)
    mut stack.push(Writing(id: root.node, pointer: root.pointer, next: 0))
    loop {
        let Some(top) = mut stack.pop() else {
            fail TreeFailure.Corrupt
        }
        let below = match first self.node_at(tree, id: top.id) {
            Some(node) if node.dirty and top.next < node.children.len() => Some(Writing(id: node.children[top.next].node, pointer: node.children[top.next].pointer, next: 0))
            else => None
        }
        match below {
            Some(child) => {
                mut stack.push(top)
                mut stack.push(child)
                continue
            }
            None => {
            }
        }
        let written = try mut self.write_node(mut log, tree, id: top.id, pointer: top.pointer, flush, time, alloc)
        let Some(parent) = mut stack.pop() else {
            return Root(tree: tree, node: written.id, pointer: written.pointer)
        }
        let Some(held) = mut self.withdraw(tree, id: parent.id) else {
            fail TreeFailure.Corrupt
        }
        var node = held
        node.children[parent.next].node = written.id
        node.children[parent.next].pointer = written.pointer
        discard mut self.keep(tree, id: parent.id, take node)
        mut stack.push(Writing(id: parent.id, pointer: parent.pointer, next: parent.next + 1))
    }
} Index.write_tree

/// A node an index flush writes once its children are written: its in-memory id, its pointer, and the next child to write.
struct Writing derives Copy {
    id: u64
    pointer: disk::Pointer
    next: usize
} Writing

/// Frees every item no entry names any more, each freeing what it names in turn: a node its children and the values of its leaves, by `values`.
pkg fn Index.free_unnamed[D: disk::Device, V: Values](mut self, device: D, mut values: V, alloc: mem::Alloc) fails TreeFailure uses wait {
    loop {
        let Some(item) = try await mut self.unnamed(device, alloc) else {
            return
        }
        try await mut self.free_item(device, item, mut values, alloc)
    }
} Index.free_unnamed

/// Writes each item's new place and count into the item table, then the item table's dirty nodes, and gives its top node.
pkg fn Index.write_items[D: disk::Device](
    mut self,
    device: D,
    mut log: log::Log,
    flush: u64,
    time: i64,
    alloc: mem::Alloc,
    ) -> Root fails TreeFailure uses wait {
    var items = mem::List[u64].empty(alloc)
    for entry in self.changes.cursor() {
        mut items.push(entry.key())
    }
    var none = NoValues()
    for item in items {
        let Some(updated) = try await mut self.item_entry(device, item, alloc) else {
            continue
        }
        let Some(change) = mut self.changes.remove(item) else {
            continue
        }
        let stored = try await mut self.stored_entry(device, item, alloc)
        if change.placed {
            match stored {
                Some(old) => mut self.stale.push(Retired(address: old.address, length: old.length))
                None => {
                }
            }
        }
        mut self.account(before: stored, after: Some(updated))
        var bytes = mem::Bytes.empty(alloc)
        mem::wire::Codec[ItemEntry].encode(updated, out: mut bytes)
        var table = self.items
        try await mut self.put(device, root: mut table, key: item_key(item).view(), value: bytes.view(), values: mut none, alloc)
        self.items = table
    }
    self.items = try mut self.write_tree(mut log, root: self.items, flush, time, alloc)
    return self.items
} Index.write_items

/// The records gone stale since the last index flush, taken from the index.
pkg fn Index.take_stale(mut self, alloc: mem::Alloc) -> mem::List[Retired] {
    var gone = mem::List[Retired].empty(alloc)
    loop {
        let Some(record) = mut self.stale.pop() else {
            return gone
        }
        mut gone.push(record)
    }
} Index.take_stale

/// An item whose count of naming entries has fallen to zero, if any.
fn Index.unnamed[D: disk::Device](mut self, device: D, alloc: mem::Alloc) -> Option[u64] fails TreeFailure uses wait {
    var candidates = mem::List[u64].empty(alloc)
    for entry in self.changes.cursor() {
        mut candidates.push(entry.key())
    }
    for item in candidates {
        let count = try await mut self.refcount(device, item, alloc)
        if count <= 0 {
            return Some(item)
        }
    }
    return None
} Index.unnamed

/// Frees `item`: removes its entry and retires its records, the one the item table names and the one placed since, and for a node releases its children and the values of its leaves.
fn Index.free_item[D: disk::Device, V: Values](
    mut self,
    device: D,
    item: u64,
    mut values: V,
    alloc: mem::Alloc,
    ) fails TreeFailure uses wait {
    let change = self.change_of(item)
    let stored = try await mut self.stored_entry(device, item, alloc)
    mut self.account(before: stored, after: None)
    discard mut self.changes.remove(item)
    var none = NoValues()
    match stored {
        Some(entry) => {
            mut self.stale.push(Retired(address: entry.address, length: entry.length))
            var table = self.items
            discard try await mut self.remove(device, root: mut table, key: item_key(item).view(), values: mut none, alloc)
            self.items = table
        }
        None => {
        }
    }
    if change.placed {
        mut self.stale.push(Retired(address: change.address, length: change.length))
    }
    if change.tree == 0 {
        return
    }
    try await mut self.load(device, tree: change.tree, id: item, pointer: change.pointer, alloc)
    let Some(node) = mut self.withdraw(change.tree, id: item) else {
        return
    }
    for leaf in node.leaves {
        mut values.release(change.tree, value: leaf.value.view())
    }
    for child in node.children {
        mut self.release(child.node, tree: change.tree, pointer: child.pointer)
    }
} Index.free_item

/// Writes the node `id` of `tree`, whose children are written, when it is dirty, and gives where it lies.
fn Index.write_node(
    mut self,
    mut log: log::Log,
    tree: u8,
    id: u64,
    pointer: disk::Pointer,
    flush: u64,
    time: i64,
    alloc: mem::Alloc,
    ) -> Written fails TreeFailure {
    let Some(held) = mut self.withdraw(tree, id) else {
        return Written(id: id, pointer: pointer)
    }
    var node = held
    if not node.dirty {
        discard mut self.keep(tree, id, take node)
        return Written(id: id, pointer: pointer)
    }
    let bytes = node.encode(flush, alloc)
    var key = Array[u8, 32].filled(0)
    mut key.view_mut().write_u64_le(0, value: node.item)
    let appended = match attempt mut log.append(disk::RecordKind.Index, key, payload: bytes.view(), time, alloc) {
        Ok(placed) => placed
        Err(log::LogFailure.Full) => fail TreeFailure.Full
        Err(log::LogFailure.TooLarge) => fail TreeFailure.TooLarge
        Err(log::LogFailure.Io) => fail TreeFailure.Io
        Err(log::LogFailure.Cancelled(cancelled)) => fail cancelled
    }
    node.dirty = false
    if tree == ITEM_TABLE {
        discard mut self.keep(tree, id: appended.address, take node)
        return Written(id: appended.address, pointer: appended.pointer)
    }
    mut self.place(id, address: appended.address, length: appended.pointer.length, kind: disk::RecordKind.Index.code())
    mut self.describe(id, tree, agent: false)
    discard mut self.keep(tree, id, take node)
    return Written(id: id, pointer: disk::Pointer(target: id, length: appended.pointer.length, kind: appended.pointer.kind, by_item: true, checksum: appended.pointer.checksum))
} Index.write_node

/// The key of `item` in the item table.
fn item_key(item: u64) -> Array[u8, 8] {
    var key = Array[u8, 8].filled(0)
    mut key.view_mut().write_u64_be(0, value: item)
    return key
} item_key

/// Has the next index flush rewrite the live item-table node lying at `address`, whose record holds `payload`, with every node above it, by writing an entry below it again; gives whether a live one lies there.
pkg fn Index.rewrite_table_node[D: disk::Device](
    mut self,
    device: D,
    address: u64,
    payload: Untrusted[Slice[u8]],
    alloc: mem::Alloc,
    ) -> bool fails TreeFailure uses wait {
    let Some(lying) = Node.read(payload, tree: ITEM_TABLE, item: 0, alloc) else {
        return false
    }
    let key = lying.first_key(alloc)
    var at = self.items
    loop {
        if at.pointer.target == address and not at.pointer.by_item {
            break
        }
        try await mut self.load(device, tree: ITEM_TABLE, id: at.node, pointer: at.pointer, alloc)
        let Some(node) = self.node_at(ITEM_TABLE, id: at.node) else {
            return false
        }
        if node.is_leaf() or node.children.len() == 0 {
            return false
        }
        let child = node.children[node.route(key.view())]
        at = Root(tree: ITEM_TABLE, node: child.node, pointer: child.pointer)
    }
    let Some(entry) = try await mut self.first_table_entry(device, below: at, alloc) else {
        return true
    }
    var table = self.items
    var none = NoValues()
    try await mut self.put(device, root: mut table, key: entry.key.view(), value: entry.value.view(), values: mut none, alloc)
    self.items = table
    return true
} Index.rewrite_table_node

/// The least entry of the item table below the node `below`.
fn Index.first_table_entry[D: disk::Device](mut self, device: D, below: Root, alloc: mem::Alloc) -> Option[Leaf] fails TreeFailure uses wait {
    var at = below
    loop {
        try await mut self.load(device, tree: ITEM_TABLE, id: at.node, pointer: at.pointer, alloc)
        let Some(node) = self.node_at(ITEM_TABLE, id: at.node) else {
            return None
        }
        if node.is_leaf() {
            if node.leaves.len() == 0 {
                return None
            }
            return Some(Leaf(key: copied(node.leaves[0].key.view(), alloc), value: copied(node.leaves[0].value.view(), alloc)))
        }
        if node.children.len() == 0 {
            return None
        }
        at = Root(tree: ITEM_TABLE, node: node.children[0].node, pointer: node.children[0].pointer)
    }
} Index.first_table_entry

/// Applies the changes of what heads reach: a node that heads come to reach, or cease to, adds or removes one referrer that heads reach for each of its children and the values of its leaves, until no node changes.
pkg fn Index.settle_heads[D: disk::Device, V: Values](mut self, device: D, mut values: V, alloc: mem::Alloc) fails TreeFailure uses wait {
    loop {
        let Some(turn) = try await mut self.next_turn(device, alloc) else {
            return
        }
        var change = self.change_of(turn.item)
        change.reaching = match turn.reaches {
            true => Reaching.Reaches
            false => Reaching.Unreached
        }
        discard mut self.changes.insert(turn.item, value: change)
        let tree = match turn.tree {
            0 => change.tree
            else => turn.tree
        }
        if tree == 0 or tree == ITEM_TABLE {
            continue
        }
        let delta: i64 = match turn.reaches {
            true => 1
            false => -1
        }
        try await mut self.load(device, tree, id: turn.item, pointer: change.pointer, alloc)
        let Some(node) = mut self.withdraw(tree, id: turn.item) else {
            continue
        }
        for leaf in node.leaves {
            mut values.reach(tree, value: leaf.value.view(), delta)
        }
        for child in node.children {
            mut self.reach(child.node, delta)
        }
        discard mut self.keep(tree, id: turn.item, take node)
    }
} Index.settle_heads

/// A node whose children and values must start or stop counting it among what heads reach them through.
struct Turn derives Copy {
    item: u64
    tree: u8
    reaches: bool
} Turn

/// The next changed item whose being reached from heads differs from what its children and values count.
fn Index.next_turn[D: disk::Device](mut self, device: D, alloc: mem::Alloc) -> Option[Turn] fails TreeFailure uses wait {
    var items = mem::List[u64].empty(alloc)
    for entry in self.changes.cursor() {
        mut items.push(entry.key())
    }
    for item in items {
        let change = self.change_of(item)
        let stored = try await mut self.stored_entry(device, item, alloc)
        let stored_heads = match stored {
            Some(entry) => i64.widen(entry.heads)
            None => 0
        }
        let counted = match change.reaching {
            Reaching.Reaches => true
            Reaching.Unreached => false
            Reaching.Stored => stored_heads > 0
        }
        let reaches = stored_heads + change.heads > 0
        if counted != reaches {
            let tree = match stored {
                Some(entry) => entry.tree
                None => 0
            }
            return Some(Turn(item: item, tree: tree, reaches: reaches))
        }
    }
    return None
} Index.next_turn

/// Counts the change of an item's entry from `before` to `after` in the bytes that only past commits reach and the bytes agents added.
fn Index.account(mut self, before: Option[ItemEntry], after: Option[ItemEntry]) {
    self.history_change += i64.widen(history_bytes(after)) - i64.widen(history_bytes(before))
    self.agents_change += i64.widen(agent_bytes(after)) - i64.widen(agent_bytes(before))
} Index.account

/// The bytes of an item that something names but no head reaches: a value, or a node of tree 1, which past commits read.
fn history_bytes(entry: Option[ItemEntry]) -> u32 {
    let Some(held) = entry else {
        return 0
    }
    if held.refcount == 0 or held.heads > 0 or held.agent or held.tree > 1 {
        return 0
    }
    return held.length
} history_bytes

/// The bytes of a value an agent or child principal added that something names.
fn agent_bytes(entry: Option[ItemEntry]) -> u32 {
    let Some(held) = entry else {
        return 0
    }
    if held.refcount == 0 or not held.agent {
        return 0
    }
    return held.length
} agent_bytes

/// The changes of the bytes only past commits reach and of the bytes agents added since the last call.
pkg fn Index.take_accounts(mut self) -> Accounts {
    let accounts = Accounts(history: self.history_change, agents: self.agents_change)
    self.history_change = 0
    self.agents_change = 0
    return accounts
} Index.take_accounts

/// Changes of the bytes only past commits reach and of the bytes agents added.
pkg struct Accounts derives Copy {
    pkg history: i64
    pkg agents: i64
} Accounts
