//! The model the store holds: node kinds and declarations, declared types, versions, transactions and their writes, and what reads give.

pub closed enum NodeKind derives Copy, Eq, Render, Encode {
    Record
    Blob
    Dir
    Stream
} NodeKind

/// A NaN type by its canonical path and its schema hash.
pub closed struct TypeRef derives Eq, Render, Encode {
    pub name: text::String
    pub schema: ident::HashValue
} TypeRef

/// The kind of every child of a dir, and the type of its record and stream children.
pub closed struct Element derives Eq, Render, Encode {
    pub kind: NodeKind
    pub type: Option[TypeRef]
} Element

/// The children a numbered dir of unversioned nodes keeps: at most `count`, none older than `age_s`.
pub closed struct Keep derives Copy, Eq, Render, Encode {
    pub count: u32
    pub age_s: Option[u64]
} Keep

pub closed struct DirDecl derives Eq, Render, Encode {
    pub element: Option[Element]
    pub ephemeral: bool
    pub secret: bool
    pub numbered: bool
    pub keep: Option[Keep]
} DirDecl

pub closed struct StreamDecl derives Eq, Render, Encode {
    pub type: TypeRef
    pub max_age_s: Option[u64]
    pub max_bytes: Option[u64]
} StreamDecl

pub closed enum Declaration derives Eq, Render, Encode {
    Dir(DirDecl)
    Stream(StreamDecl)
} Declaration

/// A node's version as an operation names it: the commit that last wrote it, its hash, or that no node exists.
pub closed enum Version derives Eq, Render, Encode {
    Commit(ident::CommitId)
    Hash(ident::HashValue)
    Absent
} Version

pub closed enum Scope derives Copy, Eq, Render, Encode {
    Node
    Subtree
} Scope

pub closed struct Read derives Eq, Render, Encode {
    pub path: ident::Path
    pub version: Version
    pub scope: Scope
} Read

pub closed struct Expect derives Eq, Render, Encode {
    pub path: ident::Path
    pub version: Version
} Expect

/// What a `Put` or `Add` writes: a record of a type, or a blob the store holds.
pub closed enum Value derives Eq, Render, Encode {
    Record(type: TypeRef, bytes: mem::Bytes, secret: bool)
    Blob(ident::HashValue)
} Value

pub closed enum Write derives Eq, Render, Encode {
    Put(path: ident::Path, value: Value)
    Make(path: ident::Path, declaration: Declaration)
    Delete(path: ident::Path)
    Add(path: ident::Path, value: Value)
    Append(path: ident::Path, entries: mem::List[mem::Bytes])
    Expire(path: ident::Path, at: Option[ident::WallTime])
    Hold(path: ident::Path, on: bool)
    Trim(path: ident::Path, below: u64)
} Write

pub closed struct Transaction derives Eq, Render, Encode {
    pub base: Option[ident::CommitId]
    pub reads: mem::List[Read]
    pub expects: mem::List[Expect]
    pub writes: mem::List[Write]
    pub key: Option[text::String]
    pub plan: Option[ident::HashValue]
    pub intent: Option[text::String]
} Transaction

pub closed struct Committed derives Eq, Render, Encode {
    pub number: ident::CommitId
    pub branch: text::String
    pub time: ident::WallTime
} Committed

pub closed struct StreamEntry derives Eq, Render, Encode {
    pub seq: u64
    pub time: ident::WallTime
    pub value: mem::Bytes
} StreamEntry

/// A node as a read gives it; `size` counts a record's or blob's bytes, a dir's children or a stream's entries, and `next` is the sequence number a stream's next entry takes, 0 for other nodes.
pub closed struct Node derives Render, Encode {
    pub path: ident::Path
    pub kind: NodeKind
    pub version: ident::CommitId
    pub subtree: Option[ident::CommitId]
    pub declared: Option[TypeRef]
    pub hash: Option[ident::HashValue]
    pub size: u64
    pub next: u64
    pub origins: mem::List[ident::OriginLabel]
    pub secret: bool
    pub expires: Option[ident::WallTime]
    pub declaration: Option[Declaration]
    pub value: Option[Untrusted[mem::Bytes]]
} Node

/// A child in a listing: its name, kind, version, size and type name.
pub closed struct Entry derives Eq, Render, Encode {
    pub name: text::String
    pub kind: NodeKind
    pub version: ident::CommitId
    pub size: u64
    pub type: Option[text::String]
} Entry

pub closed struct Listing derives Eq, Render, Encode {
    pub entries: mem::List[Entry]
    pub next: Option[text::String]
} Listing

pub closed struct Count derives Copy, Eq, Render, Encode {
    pub children: u64
    pub bytes: u64
} Count
