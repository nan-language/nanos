//! The store of chapters 11 and 12: one versioned, transactional, content-addressed store over a volume of 4 KiB blocks, and the `store` instance serving it through Views.

package store {
    language 1
    targets any
    dep devices "../devices"
    dep ident "../ident"
    dep os "../os"
    allow capability in service
    allow validate in devices, disk, ident, log, os, service, store, tree
} store
