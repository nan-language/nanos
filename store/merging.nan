//! The parts of a merge: changes told by versions, sameness by hashes, conflicts with each side's hash, the source's nodes taken into the target, and values merged field by field by their schema trees.

fn min_of(one: u64, other: u64) -> u64 {
    if one < other {
        return one
    }
    return other
} min_of

/// The children of dir `dir` in `snapshot` by name, none for dir 0.
fn Store.children_map[D: disk::Device](
    mut self,
    device: D,
    snapshot: Snapshot,
    dir: u64,
    alloc: mem::Alloc,
    ) -> mem::Map[mem::Bytes, NodeEntry] fails StoreError uses wait {
    var children = mem::Map[mem::Bytes, NodeEntry].empty(alloc)
    if dir == 0 {
        return children
    }
    let found = try await mut self.snapshot_children(device, snapshot, dir, alloc)
    for child in take found {
        discard mut children.insert(take child.name, value: take child.entry)
    }
    return children
} Store.children_map

/// Whether a node changed since the base: added, removed, or written, or for a dir changed below, after the base.
fn changed_from(base: Option[NodeEntry], now: Option[NodeEntry]) -> bool {
    let Some(was) = base else {
        return now.is_some()
    }
    let Some(held) = now else {
        return true
    }
    return was.version != held.version or was.subtree != held.subtree
} changed_from

/// Whether both sides changed a node to the same: both removed it, or their nodes have one hash.
fn Store.same_on_both[D: disk::Device](
    mut self,
    device: D,
    merging: Merging,
    sides: Sides,
    alloc: mem::Alloc,
    ) -> bool fails StoreError uses wait {
    let Some(source) = sides.source else {
        return sides.target.is_none()
    }
    let Some(target) = sides.target else {
        return false
    }
    let source_hash = try await mut self.hash_in(device, snapshot: merging.source, entry: source, tree: TREE_VERSIONED, alloc)
    let target_hash = try await mut self.hash_in(device, snapshot: merging.target, entry: target, tree: TREE_VERSIONED, alloc)
    return source_hash == target_hash
} Store.same_on_both

/// The side a take resolves the conflict at `path` by.
fn taken_side(takes: Slice[Take], path: ident::Path) -> Option[Side] {
    for taken in takes {
        if taken.path == path {
            return Some(taken.side)
        }
    }
    return None
} taken_side

/// Records a conflict of `kind` at `path`.
fn Store.add_conflict[D: disk::Device](
    mut self,
    device: D,
    mut merging: Merging,
    path: ident::Path,
    kind: ConflictKind,
    sides: Sides,
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    let conflict = try await mut self.conflict(device, merging, path, field: None, kind, sides, alloc)
    mut merging.conflicts.push(take conflict)
} Store.add_conflict

/// A conflict of `kind` at `path`, with each side's hash.
fn Store.conflict[D: disk::Device](
    mut self,
    device: D,
    merging: Merging,
    path: ident::Path,
    take field: Option[text::String],
    kind: ConflictKind,
    sides: Sides,
    alloc: mem::Alloc,
    ) -> Conflict fails StoreError uses wait {
    let base = try await mut self.side_hash(device, snapshot: merging.base, entry: sides.base, alloc)
    let source = try await mut self.side_hash(device, snapshot: merging.source, entry: sides.source, alloc)
    let target = try await mut self.side_hash(device, snapshot: merging.target, entry: sides.target, alloc)
    return Conflict(path: copied_path(path, alloc), field: take field, kind: kind, base: base, source: source, target: target)
} Store.conflict

fn Store.side_hash[D: disk::Device](
    mut self,
    device: D,
    snapshot: Snapshot,
    entry: Option[NodeEntry],
    alloc: mem::Alloc,
    ) -> Option[ident::HashValue] fails StoreError uses wait {
    let Some(held) = entry else {
        return None
    }
    return Some(try await mut self.hash_in(device, snapshot, entry: held, tree: TREE_VERSIONED, alloc))
} Store.side_hash

/// Takes the source's node named `name` into the target's dir `dir`: its entry, and a dir the target does not hold with all it holds.
fn Store.take_source[D: disk::Device](
    mut self,
    device: D,
    mut merging: Merging,
    mut staged: Staged,
    name: Slice[u8],
    sides: Sides,
    dir: u64,
    mut ancestors: mem::List[Found],
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    let place = Place(head: merging.writing.head, tree: TREE_VERSIONED, dir: dir, name: copied_bytes(name, alloc))
    let Some(source) = sides.source else {
        discard try await mut self.set_entry(device, place, entry: None, mut staged, alloc)
        mut staged.touch(ancestors.view(), count: ancestors.len(), children_changed: true, alloc)
        return
    }
    var written = try source.copied(alloc)
    written.version = merging.writing.number
    let source_dir = try child_dir(source, tree: TREE_VERSIONED, alloc)
    if source_dir.dir != 0 {
        written.subtree = merging.writing.number
    }
    written.hash = None
    discard try await mut self.set_entry(device, place, entry: Some(take written), mut staged, alloc)
    var target_dir: u64 = 0
    match sides.target {
        Some(held) => {
            let found = try child_dir(held, tree: TREE_VERSIONED, alloc)
            target_dir = found.dir
        }
        None => {
        }
    }
    if source_dir.dir != 0 and source_dir.tree == TREE_VERSIONED and source_dir.dir != target_dir {
        try await mut self.copy_subtree(device, snapshot: merging.source, head: merging.writing.head, dir: source_dir.dir, mut staged, alloc)
    }
    mut staged.touch(ancestors.view(), count: ancestors.len(), children_changed: sides.target.is_none(), alloc)
} Store.take_source

/// Writes every entry dir `dir` holds in `snapshot` into the versioned tree of the branch at `head`, and what each dir among them holds, the dirs left to copy waiting on a list.
fn Store.copy_subtree[D: disk::Device](
    mut self,
    device: D,
    snapshot: Snapshot,
    head: usize,
    dir: u64,
    mut staged: Staged,
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    var pending = mem::List[u64].empty(alloc)
    mut pending.push(dir)
    loop {
        let Some(copied) = mut pending.pop() else {
            return
        }
        let children = try await mut self.snapshot_children(device, snapshot, dir: copied, alloc)
        for child in children {
            let held = try child_dir(child.entry, tree: TREE_VERSIONED, alloc)
            let place = Place(head: head, tree: TREE_VERSIONED, dir: copied, name: copied_bytes(child.name.view(), alloc))
            let entry = try child.entry.copied(alloc)
            discard try await mut self.set_entry(device, place, entry: Some(take entry), mut staged, alloc)
            if held.dir != 0 and held.tree == TREE_VERSIONED {
                mut pending.push(held.dir)
            }
        }
    }
} Store.copy_subtree

/// Writes a record merged field by field, a conflict of kind `Invalid` when its type's decoder rejects it.
fn Store.write_merged[D: disk::Device](
    mut self,
    device: D,
    mut merging: Merging,
    mut staged: Staged,
    path: ident::Path,
    name: Slice[u8],
    sides: Sides,
    dir: u64,
    type: TypeRef,
    bytes: Slice[u8],
    mut ancestors: mem::List[Found],
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    let raw = copied_bytes(bytes, alloc)
    let checked = attempt self.schemas.decode(type.schema, raw: Untrusted.of(raw.view()), alloc)
    let Ok(canonical) = checked else {
        try await mut self.add_conflict(device, mut merging, path, kind: ConflictKind.Invalid, sides, alloc)
        return
    }
    let record = accepted_bytes(canonical.view(), alloc)
    let Some(target) = sides.target else {
        return
    }
    let content = mut self.record_content(take record, agent: merging.writing.agent, mut staged, alloc)
    let entry = NodeEntry(kind: NodeKind.Record.code(), version: merging.writing.number, subtree: 0, origins: merging.writing.origins, type: target.type, declared: target.declared, secret: 0, expires: 0, hash: None, held: target.held, content: take content)
    let place = Place(head: merging.writing.head, tree: TREE_VERSIONED, dir: dir, name: copied_bytes(name, alloc))
    discard try await mut self.set_entry(device, place, entry: Some(take entry), mut staged, alloc)
    mut staged.touch(ancestors.view(), count: ancestors.len(), children_changed: false, alloc)
} Store.write_merged

/// The value of schema node `node` merged from its base, source and target wire bytes: a side changed alone taken, records and maps merged key by key, any other change on both sides a clash at `field`. The records and maps under way wait on a stack, each joined once every part of it is merged.
fn merge_value(
    schema: mem::wire::Schema,
    node: usize,
    base: Option[mem::Bytes],
    source: Slice[u8],
    target: Slice[u8],
    field: Str,
    alloc: mem::Alloc,
    ) -> Merged {
    var stack = mem::List[Combining].empty(alloc)
    match value_step(schema, node, base, source, target, field, key: mem::Bytes.empty(alloc), alloc) {
        Step3.Done(merged) => return merged
        Step3.Open(combining) => mut stack.push(take combining)
    }
    loop {
        let Some(top) = mut stack.pop() else {
            return Merged.Clash(text::String.of(field, alloc))
        }
        var combining = top
        if combining.next < combining.parts.len() {
            let at = combining.next
            combining.next += 1
            let step = part_step(schema, part: combining.parts[at], alloc)
            match step {
                Step3.Done(Merged.Clash(clash)) => return Merged.Clash(take clash)
                Step3.Done(Merged.Value(bytes)) => {
                    if not combining.parts[at].gone {
                        mut combining.merged.push(Part(key: copied_bytes(combining.parts[at].key.view(), alloc), value: take bytes))
                    }
                    mut stack.push(take combining)
                }
                Step3.Open(nested) => {
                    mut stack.push(take combining)
                    mut stack.push(take nested)
                }
            }
            continue
        }
        let Combining(key: key, record: record, parts: _, next: _, merged: merged) = combining
        let bytes = joined(merged.view(), record, alloc)
        let Some(above) = mut stack.pop() else {
            return Merged.Value(take bytes)
        }
        var parent = above
        mut parent.merged.push(Part(key: take key, value: take bytes))
        mut stack.push(take parent)
    }
} merge_value

/// A record or map being merged: its key in the value holding it, whether it is a record, its parts to merge, the next of them, and those merged.
struct Combining {
    key: mem::Bytes
    record: bool
    parts: mem::List[Sided]
    next: usize
    merged: mem::List[Part]
} Combining

/// A field or entry to merge: its key, its schema node, its three sides, its field path, and whether it is gone, from both sides or from the side that alone changed it.
struct Sided {
    key: mem::Bytes
    node: usize
    base: Option[mem::Bytes]
    source: Option[mem::Bytes]
    target: Option[mem::Bytes]
    field: text::String
    gone: bool
} Sided

/// A step of a merge: its outcome, or a record or map to merge part by part.
enum Step3 {
    Done(Merged)
    Open(Combining)
} Step3

/// The first step of merging a value whose sides are `base`, `source` and `target`, the value of `key` in what holds it: a side changed alone taken, a record or map opened, or a clash at `field`.
fn value_step(
    schema: mem::wire::Schema,
    node: usize,
    base: Option[mem::Bytes],
    source: Slice[u8],
    target: Slice[u8],
    field: Str,
    take key: mem::Bytes,
    alloc: mem::Alloc,
    ) -> Step3 {
    if source == target {
        return Step3.Done(Merged.Value(copied_bytes(source, alloc)))
    }
    match base {
        Some(held) => {
            if held.view() == source {
                return Step3.Done(Merged.Value(copied_bytes(target, alloc)))
            }
            if held.view() == target {
                return Step3.Done(Merged.Value(copied_bytes(source, alloc)))
            }
        }
        None => {
        }
    }
    if node >= schema.nodes.len() {
        return Step3.Done(Merged.Clash(text::String.of(field, alloc)))
    }
    let opened = match schema.nodes[node] {
        mem::wire::SchemaNode.Record(open: _, fields: fields) => record_sides(schema, fields: fields.view(), base, source, target, field, alloc)
        mem::wire::SchemaNode.Map(key: keyed, value: valued) => map_sides(schema, key: keyed, value: valued, base, source, target, field, alloc)
        else => None
    }
    let Some(parts) = opened else {
        return Step3.Done(Merged.Clash(text::String.of(field, alloc)))
    }
    let record = match schema.nodes[node] {
        mem::wire::SchemaNode.Record(open: _, fields: _) => true
        else => false
    }
    return Step3.Open(Combining(key: take key, record: record, parts: take parts, next: 0, merged: mem::List.empty(alloc)))
} value_step

/// The step of merging a field or entry from its three sides: kept or gone when a side changed alone, a clash when only one side holds it, else its value's step.
fn part_step(schema: mem::wire::Schema, part: Sided, alloc: mem::Alloc) -> Step3 {
    if part.source == part.target {
        return taken_value(part.source, alloc)
    }
    if part.base == part.source {
        return taken_value(part.target, alloc)
    }
    if part.base == part.target {
        return taken_value(part.source, alloc)
    }
    let Some(from_source) = part.source else {
        return Step3.Done(Merged.Clash(text::String.of(part.field.as_str(), alloc)))
    }
    let Some(from_target) = part.target else {
        return Step3.Done(Merged.Clash(text::String.of(part.field.as_str(), alloc)))
    }
    let base = match part.base {
        Some(held) => Some(copied_bytes(held.view(), alloc))
        None => None
    }
    return value_step(schema, node: part.node, base, source: from_source.view(), target: from_target.view(), field: part.field.as_str(), key: copied_bytes(part.key.view(), alloc), alloc)
} part_step

/// A side's value kept, or an empty value for one gone, which its `Sided` marks.
fn taken_value(value: Option[mem::Bytes], alloc: mem::Alloc) -> Step3 {
    return match value {
        Some(bytes) => Step3.Done(Merged.Value(copied_bytes(bytes.view(), alloc)))
        None => Step3.Done(Merged.Value(mem::Bytes.empty(alloc)))
    }
} taken_value

/// The fields of a record to merge, in key order, each with its schema node and its three sides; `None` when a side does not split into fields.
fn record_sides(
    schema: mem::wire::Schema,
    fields: Slice[mem::wire::SchemaField],
    base: Option[mem::Bytes],
    source: Slice[u8],
    target: Slice[u8],
    field: Str,
    alloc: mem::Alloc,
    ) -> Option[mem::List[Sided]] {
    let Some(source_parts) = record_parts(source, alloc) else {
        return None
    }
    let Some(target_parts) = record_parts(target, alloc) else {
        return None
    }
    var base_parts = mem::List[Part].empty(alloc)
    match base {
        Some(held) => {
            base_parts = parts_or_empty(record_parts(held.view(), alloc), alloc)
        }
        None => {
        }
    }
    var keys = mem::Set[mem::Bytes].empty(alloc)
    for part in source_parts {
        discard mut keys.insert(copied_bytes(part.key.view(), alloc))
    }
    for part in target_parts {
        discard mut keys.insert(copied_bytes(part.key.view(), alloc))
    }
    var sides = mem::List[Sided].empty(alloc)
    for key in keys.cursor() {
        var node = schema.nodes.len()
        for described in fields {
            if described.key.as_bytes() == key.view() {
                node = described.value
            }
        }
        mut sides.push(sided(key: key.view(), node, base: value_of_key(base_parts.view(), key: key.view(), alloc), source: value_of_key(source_parts.view(), key: key.view(), alloc), target: value_of_key(target_parts.view(), key: key.view(), alloc), field: field_path(field, key: key.view(), alloc), alloc))
    }
    return Some(take sides)
} record_sides

/// The entries of a map to merge, in the order of their keys, each with the schema node of its value and its three sides; `None` when the map's keys have no order or a side does not split into entries.
fn map_sides(
    schema: mem::wire::Schema,
    key: usize,
    value: usize,
    base: Option[mem::Bytes],
    source: Slice[u8],
    target: Slice[u8],
    field: Str,
    alloc: mem::Alloc,
    ) -> Option[mem::List[Sided]] {
    if not has_order(schema, node: key, alloc) {
        return None
    }
    let Some(source_parts) = map_parts(schema, key, value, bytes: source, alloc) else {
        return None
    }
    let Some(target_parts) = map_parts(schema, key, value, bytes: target, alloc) else {
        return None
    }
    var base_parts = mem::List[Part].empty(alloc)
    match base {
        Some(held) => {
            base_parts = parts_or_empty(map_parts(schema, key, value, bytes: held.view(), alloc), alloc)
        }
        None => {
        }
    }
    var keys = mem::List[mem::Bytes].empty(alloc)
    for part in source_parts {
        mut keys.push(copied_bytes(part.key.view(), alloc))
    }
    for part in target_parts {
        if value_of_key(source_parts.view(), key: part.key.view(), alloc).is_none() {
            mut keys.push(copied_bytes(part.key.view(), alloc))
        }
    }
    mut keys.sort_by(fn(left: mem::Bytes, right: mem::Bytes) => wire_order(schema, node: key, left: left.view(), right: right.view(), alloc))
    var sides = mem::List[Sided].empty(alloc)
    for entry in keys {
        mut sides.push(sided(key: entry.view(), node: value, base: value_of_key(base_parts.view(), key: entry.view(), alloc), source: value_of_key(source_parts.view(), key: entry.view(), alloc), target: value_of_key(target_parts.view(), key: entry.view(), alloc), field: text::String.of(field, alloc), alloc))
    }
    return Some(take sides)
} map_sides

/// A part to merge, gone when the side it takes holds none.
fn sided(
    key: Slice[u8],
    node: usize,
    take base: Option[mem::Bytes],
    take source: Option[mem::Bytes],
    take target: Option[mem::Bytes],
    take field: text::String,
    alloc: mem::Alloc,
    ) -> Sided {
    let gone = (source == target and source.is_none()) or (base == source and target.is_none()) or (base == target and source.is_none())
    return Sided(key: copied_bytes(key, alloc), node: node, base: take base, source: take source, target: take target, field: take field, gone: gone)
} sided

/// The path of field `key` within `field`.
fn field_path(field: Str, key: Slice[u8], alloc: mem::Alloc) -> text::String {
    var path = text::String.of(field, alloc)
    if field.byte_len() > 0 {
        mut path.append(".")
    }
    mut path.append(text_of_name(key, alloc).as_str())
    return path
} field_path

/// The parts that split, none when they did not.
fn parts_or_empty(take found: Option[mem::List[Part]], alloc: mem::Alloc) -> mem::List[Part] {
    return match found {
        Some(parts) => parts
        None => mem::List.empty(alloc)
    }
} parts_or_empty
