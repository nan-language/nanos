//! The checks of a transaction before its writes: its request key, its expectations and its reads at the branch's head; and the ids of the origin sets and types its nodes carry.

/// The digest a request key keeps: the hash of `transaction`, a line feed and the wire bytes of the transaction's writes, expectations, plan and intent.
pkg fn request_digest(transaction: Transaction, alloc: mem::Alloc) -> ident::HashValue {
    var bytes = wire_of(transaction.writes, alloc)
    mut bytes.append(wire_of(transaction.expects, alloc).view())
    mut bytes.append(wire_of(transaction.plan, alloc).view())
    mut bytes.append(wire_of(transaction.intent, alloc).view())
    return ident::HashValue.of_object(ident::Kind.Transaction, bytes: bytes.view())
} request_digest

/// The commit made earlier under the transaction's request key for the same principal, when its digest is the same; `request.key-reused` when it differs.
pkg fn Store.earlier_commit[D: disk::Device](
    mut self,
    device: D,
    key: Option[text::String],
    stamp: Stamp,
    digest: ident::HashValue,
    alloc: mem::Alloc,
    ) -> Option[Committed] fails StoreError uses wait {
    let Some(held) = key else {
        return None
    }
    let Some(bytes) = try await mut self.catalog_get(device, key: request_key(stamp.principal, key: held.as_str(), alloc).view(), alloc) else {
        return None
    }
    let entry = try decode_request_entry(bytes.view(), alloc)
    if entry.digest != digest {
        fail StoreError.KeyReused
    }
    return Some(Committed(number: ident::CommitId(number: entry.commit), branch: take entry.branch, time: entry.time))
} Store.earlier_commit

/// Records the transaction's request key, when it has one, for its principal, with the commit it makes.
pkg fn Store.request_entry[D: disk::Device](
    mut self,
    device: D,
    key: Option[text::String],
    stamp: Stamp,
    writing: Writing,
    digest: ident::HashValue,
    mut staged: Staged,
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    let Some(held) = key else {
        return
    }
    let entry = RequestEntry(session: stamp.session, commit: writing.number, digest: digest, branch: text::String.of(self.heads[writing.head].branch.name.as_str(), alloc), time: writing.now)
    try await mut self.stage_catalog(device, key: request_key(stamp.principal, key: held.as_str(), alloc).view(), value: wire_of(entry, alloc).view(), mut staged, alloc)
} Store.request_entry

/// The request keys kept: for each session, and for each principal of commits no session makes, those of its latest `window` keyed commits.
pkg fn Store.keep_requests[D: disk::Device](mut self, device: D, alloc: mem::Alloc) fails StoreError uses wait {
    let leaves = try await mut self.catalog_scan(device, kind: KIND_REQUEST, from: b"", limit: 0xFFFF_FFFF, alloc)
    var kept = mem::List[Keyed].empty(alloc)
    for leaf in leaves {
        let entry = try decode_request_entry(leaf.value.view(), alloc)
        mut kept.push(Keyed(group: request_group(leaf.key.view(), session: entry.session, alloc), commit: entry.commit, key: copied_bytes(leaf.key.view(), alloc)))
    }
    mut kept.sort_by(fn(left: Keyed, right: Keyed) => match left.group.view().cmp(right.group.view()) {
        core::Ordering.Equal => right.commit.cmp(left.commit)
        else => left.group.view().cmp(right.group.view())
    })
    var count: u64 = 0
    for at in 0..<kept.len() {
        if at == 0 or kept[at].group != kept[at - 1].group {
            count = 0
        }
        count += 1
        if count > u64.widen(self.request_window) {
            discard try await mut self.catalog_remove(device, key: kept[at].key.view(), alloc)
        }
    }
} Store.keep_requests

/// A request entry as keeping weighs it: the session or principal it counts under, its commit and its catalog key.
struct Keyed {
    group: mem::Bytes
    commit: u64
    key: mem::Bytes
} Keyed

/// What a request entry counts under: its session, or the principal its catalog key names for a commit no session makes.
fn request_group(key: Slice[u8], session: Option[ident::SessionId], alloc: mem::Alloc) -> mem::Bytes {
    var group = mem::Bytes.empty(alloc)
    match session {
        Some(held) => {
            mut group.push(1)
            mut group.append(Array[u8, 8].filled(0).view())
            mut group.view_mut().write_u64_be(1, value: held.boot)
            mut group.append(Array[u8, 8].filled(0).view())
            mut group.view_mut().write_u64_be(9, value: held.number)
        }
        None => {
            mut group.push(0)
            for byte in key {
                if byte == 0 {
                    break
                }
                mut group.push(byte)
            }
        }
    }
    return group
} request_group

/// Whether every expectation holds at the head of the branch at `head`.
pkg fn Store.expectations_hold[D: disk::Device](
    mut self,
    device: D,
    head: usize,
    expects: Slice[Expect],
    now: ident::WallTime,
    alloc: mem::Alloc,
    ) -> bool fails StoreError uses wait {
    for condition in expects {
        let holds = try await mut self.version_holds(device, head, path: condition.path, version: condition.version, scope: Scope.Node, now, alloc)
        if not holds {
            return false
        }
    }
    return true
} Store.expectations_hold

/// Whether every read still holds at the head of the branch at `head`: a `Node` read the node's version, a `Subtree` read the dir's subtree version.
pkg fn Store.reads_hold[D: disk::Device](
    mut self,
    device: D,
    head: usize,
    reads: Slice[Read],
    now: ident::WallTime,
    alloc: mem::Alloc,
    ) -> bool fails StoreError uses wait {
    for read in reads {
        let holds = try await mut self.version_holds(device, head, path: read.path, version: read.version, scope: read.scope, now, alloc)
        if not holds {
            return false
        }
    }
    return true
} Store.reads_hold

/// Whether the node at `path` has `version` at the head: the commit that last wrote it or, for `Subtree`, the dir's subtree version; its hash; or none for `Absent`.
fn Store.version_holds[D: disk::Device](
    mut self,
    device: D,
    head: usize,
    path: ident::Path,
    version: Version,
    scope: Scope,
    now: ident::WallTime,
    alloc: mem::Alloc,
    ) -> bool fails StoreError uses wait {
    let segments = path.segments(alloc)
    let resolution = match first attempt await mut self.resolve(device, head, segments: segments.view(), now, alloc) {
        Ok(found) => found
        Err(StoreError.NotFound) => return version == Version.Absent
        Err(failure) => fail failure
    }
    let Some(found) = resolution.node() else {
        return version == Version.Absent
    }
    return match version {
        Version.Absent => false
        Version.Commit(commit) => match scope {
            Scope.Node => found.entry.version == commit.number
            Scope.Subtree => found.entry.subtree == commit.number
        }
        Version.Hash(hash) => try await mut self.node_hash(device, found, alloc) == hash
    }
} Store.version_holds

/// The id of the origin set `labels`, a new one when none holds it, 0 for none.
pkg fn Store.origin_id[D: disk::Device](
    mut self,
    device: D,
    labels: Slice[ident::OriginLabel],
    mut staged: Staged,
    alloc: mem::Alloc,
    ) -> u32 fails StoreError uses wait {
    if labels.len() == 0 {
        return 0
    }
    var sorted = mem::List[ident::OriginLabel].empty(alloc)
    for label in labels {
        mut sorted.push(ident::OriginLabel(text: label.text))
    }
    mut sorted.sort_by(fn(left: ident::OriginLabel, right: ident::OriginLabel) => left.cmp(right))
    let lookup = origin_lookup_key(sorted.view(), alloc)
    match try await mut self.catalog_get(device, key: lookup.view(), alloc) {
        Some(bytes) => return bytes.view().u32_be(0)
        None => {
        }
    }
    let id = self.counters.origin
    self.counters.origin += 1
    let set = OriginSet(labels: take sorted, refcount: 0)
    try await mut self.stage_catalog(device, key: number_key(KIND_ORIGIN_SET, number: u64.widen(id), width: 4, alloc).view(), value: wire_of(set, alloc).view(), mut staged, alloc)
    try await mut self.stage_catalog(device, key: lookup.view(), value: id_bytes(id).view(), mut staged, alloc)
    mut self.refs.count_id(kind: KIND_ORIGIN_SET, id, delta: 0)
    return id
} Store.origin_id

/// The id of `type`, a new one when none holds it.
pkg fn Store.type_id[D: disk::Device](
    mut self,
    device: D,
    type: TypeRef,
    mut staged: Staged,
    alloc: mem::Alloc,
    ) -> u32 fails StoreError uses wait {
    let lookup = type_lookup_key(type, alloc)
    match try await mut self.catalog_get(device, key: lookup.view(), alloc) {
        Some(bytes) => return bytes.view().u32_be(0)
        None => {
        }
    }
    let id = self.counters.type
    self.counters.type += 1
    let entry = TypeEntry(type: type.copied(alloc), refcount: 0)
    try await mut self.stage_catalog(device, key: number_key(KIND_TYPE, number: u64.widen(id), width: 4, alloc).view(), value: wire_of(entry, alloc).view(), mut staged, alloc)
    try await mut self.stage_catalog(device, key: lookup.view(), value: id_bytes(id).view(), mut staged, alloc)
    mut self.refs.count_id(kind: KIND_TYPE, id, delta: 0)
    return id
} Store.type_id

/// The type of id `id`.
pkg fn Store.type_of[D: disk::Device](mut self, device: D, id: u32, alloc: mem::Alloc) -> TypeRef fails StoreError uses wait {
    let Some(bytes) = try await mut self.catalog_get(device, key: number_key(KIND_TYPE, number: u64.widen(id), width: 4, alloc).view(), alloc) else {
        fail StoreError.Corrupt
    }
    let entry = try decode_type_entry(bytes.view(), alloc)
    return entry.type
} Store.type_of

/// The catalog key of `key` as the request key of `principal`.
fn request_key(principal: ident::Principal, key: Str, alloc: mem::Alloc) -> mem::Bytes {
    var bytes = catalog_key(KIND_REQUEST, key: principal.text.as_bytes(), alloc)
    mut bytes.push(0)
    mut bytes.append(key.as_bytes())
    return bytes
} request_key

/// The 4 bytes of an id, big-endian.
pkg fn id_bytes(id: u32) -> Array[u8, 4] {
    var bytes = Array[u8, 4].filled(0)
    mut bytes.view_mut().write_u32_be(0, value: id)
    return bytes
} id_bytes
