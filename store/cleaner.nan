//! The cleaner: a full segment holding little live data read a batch at a time, each live record appended unchanged to the log with its entry pointed at the copy, and the segment freed once its last batch is read; a step after each run of writes while the log grows, and every candidate while free segments run low.

/// The segment bytes a step of the cleaner reads at least, unless the segment ends first.
const STEP_BYTES: u64 = 1_048_576

/// The segment the cleaner is emptying: its number, the block of its next batch, and that batch's number once the first is read.
pkg struct Cleaning derives Copy, Eq {
    pkg segment: u32
    pkg block: u64
    pkg batch: Option[u64]
} Cleaning

/// Cleans while the log grows: a step after the writes since the last index flush, and steps until none is left while free segments, those freed awaiting their index flushes counted, are at most 4 plus 1% of all segments, or while the volume converts to encryption, which ends once no segment holds plain records.
pub fn Store.keep_clean[D: disk::Device](mut self, device: D, now: ident::WallTime, alloc: mem::Alloc) fails StoreError uses wait {
    if self.read_only or self.first_logged == 0 {
        return
    }
    let converting = (self.superblock.flags & disk::CONVERTING) != 0
    loop {
        if not try await mut self.clean(device, now, alloc) or not (converting or self.space_low()) {
            break
        }
    }
    try await mut self.finish_converting(device, alloc)
} Store.keep_clean

/// Whether free segments, those freed awaiting their index flushes counted, are at most 4 plus 1% of all segments.
pkg fn Store.space_low(self) -> bool {
    var free = self.log.free_segments()
    for segment in self.log.segments {
        if segment.state == log::SegmentState.Freed {
            free += 1
        }
    }
    return free <= 4 + self.superblock.segments / 100
} Store.space_low

/// Whether cleaning or index flushes could free space: a segment is being cleaned or awaits its index flushes, a full one holds less than a quarter of live data, or the log grew since the last index flush.
pkg fn Store.reclaimable(self, now: ident::WallTime) -> bool {
    if self.cleaning.is_some() or self.log.appended > 0 or self.log.cleaning_candidate(now: now.utc_ns, skipped: self.unclean).is_some() {
        return true
    }
    for segment in self.log.segments {
        if segment.state == log::SegmentState.Freed {
            return true
        }
    }
    return false
} Store.reclaimable

/// Cleans a step: the next batches of the segment being emptied, or else of the full segment of least live data for its age, until a megabyte is read or the segment ends, their live records moved and the copies made durable; gives whether there was a segment to clean. A segment ends after its last batch or before a batch not following the one before; one whose batch fails its checksum stays full, and the cleaner tells of the corruption and passes it over until the next mount.
pub fn Store.clean[D: disk::Device](mut self, device: D, now: ident::WallTime, alloc: mem::Alloc) -> bool fails StoreError uses wait {
    if self.read_only {
        fail StoreError.ReadOnly
    }
    if self.cleaning.is_none() {
        let Some(segment) = self.log.cleaning_candidate(now: now.utc_ns, skipped: self.unclean) else {
            return false
        }
        self.cleaning = Some(Cleaning(segment: segment, block: 1, batch: None))
    }
    let Some(started) = self.cleaning else {
        return false
    }
    var at = started
    try await mut self.bound_log(device, adding: STEP_BYTES, now, alloc)
    var read: u64 = 0
    while read < STEP_BYTES {
        let Some(header) = try await mut self.next_batch(device, at, alloc) else {
            mut self.log.freed(at.segment, flush: self.flush)
            self.cleaning = None
            break
        }
        let start = disk::segment_start(at.segment) + at.block
        let address = start * u64.widen(disk::BLOCK_BYTES)
        let whole = try await read_blocks(device, block: start, count: header.blocks, alloc)
        let records = match disk::batch_verifies(whole.view(), alloc) {
            true => disk::batch_records(whole.view(), header, volume: self.volume_key, alloc)
            false => None
        }
        let Some(placed) = records else {
            mut self.events.push(Event.Corruption(address: address, kind: 0))
            discard mut self.unclean.insert(at.segment)
            self.cleaning = None
            break
        }
        for record in take placed {
            let length = u32.truncate(record.record.payload.byte_len())
            try await mut self.move_live(device, record: Lying(address: address + u64.widen(record.offset), kind: record.record.kind, key: record.record.key, length: length, payload: take record.record.payload), now, alloc)
        }
        at.block += u64.widen(header.blocks)
        at.batch = Some(header.batch + 1)
        if header.ends_segment {
            at.block = disk::SEGMENT_BLOCKS
        }
        read += u64.widen(header.blocks) * u64.widen(disk::BLOCK_BYTES)
        self.cleaning = Some(at)
    }
    if self.log.has_pending() {
        try await mut self.flush_log(device, alloc)
    }
    return true
} Store.clean

/// The header of the batch at `at` of the segment being emptied, `None` past its last: at its end, or where no batch follows the one before.
fn Store.next_batch[D: disk::Device](mut self, device: D, at: Cleaning, alloc: mem::Alloc) -> Option[disk::BatchHeader] fails StoreError uses wait {
    if at.block >= disk::SEGMENT_BLOCKS {
        return None
    }
    let opening = try await read_blocks(device, block: disk::segment_start(at.segment) + at.block, count: 1, alloc)
    let Some(header) = disk::BatchHeader.read(opening.view()) else {
        return None
    }
    let follows = match at.batch {
        Some(number) => header.batch == number
        None => true
    }
    if not follows or header.blocks == 0 or u64.widen(header.blocks) > disk::SEGMENT_BLOCKS - at.block {
        return None
    }
    return Some(header)
} Store.next_batch

/// A record of a segment: where it lies, its kind, key and length, and its payload.
pkg struct Lying {
    pkg address: u64
    pkg kind: disk::RecordKind
    pkg key: Array[u8, 32]
    pkg length: u32
    pkg payload: Untrusted[mem::Bytes]
} Lying

/// Moves `record` when an entry names it: a live node of the item table is left for the next index flush to rewrite, any other record is copied.
fn Store.move_live[D: disk::Device](
    mut self,
    device: D,
    record: Lying,
    now: ident::WallTime,
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    if record.kind == disk::RecordKind.Index and record.key.view().u64_le(0) == 0 {
        match attempt await mut self.index.rewrite_table_node(device, address: record.address, payload: record.payload.view(), alloc) {
            Ok(_) => {
            }
            Err(failure) => fail StoreError.of_tree(take failure)
        }
        return
    }
    try await mut self.move_if_live(device, record, now, alloc)
} Store.move_live

/// Appends `record` unchanged to the log when an entry names it, and points that entry at the copy.
fn Store.move_if_live[D: disk::Device](
    mut self,
    device: D,
    record: Lying,
    now: ident::WallTime,
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    match record.kind {
        disk::RecordKind.Value or disk::RecordKind.Index => {
            let item = record.key.view().u64_le(0)
            if item == 0 {
                return
            }
            let entry = match attempt await mut self.index.item_entry(device, item, alloc) {
                Ok(found) => found
                Err(failure) => fail StoreError.of_tree(take failure)
            }
            let Some(held) = entry else {
                return
            }
            if held.address != record.address {
                return
            }
            let copy = try mut self.copy_record(record, now, alloc)
            mut self.index.place(item, address: copy.address, length: record.length, kind: record.kind.code())
        }
        disk::RecordKind.Piece => try await mut self.move_named(device, key: catalog_key(KIND_PIECE, key: record.key.view(), alloc), record, now, alloc)
        disk::RecordKind.Stream => try await mut self.move_named(device, key: run_key(record.key.view().u64_le(0), earliest: record.key.view().u64_le(8), alloc), record, now, alloc)
        disk::RecordKind.Commit => try await mut self.move_named(device, key: number_key(KIND_COMMIT, number: record.key.view().u64_le(0), width: 8, alloc), record, now, alloc)
        disk::RecordKind.Blob or disk::RecordKind.Pad => {
        }
    }
} Store.move_if_live

/// Moves a record the catalog entry at `key` names by its pointer field, when it names this one.
fn Store.move_named[D: disk::Device](
    mut self,
    device: D,
    key: mem::Bytes,
    record: Lying,
    now: ident::WallTime,
    alloc: mem::Alloc,
    ) fails StoreError uses wait {
    let Some(held) = try await mut self.catalog_get(device, key: key.view(), alloc) else {
        return
    }
    var moved: Option[mem::Bytes] = None
    if record.kind == disk::RecordKind.Piece {
        let entry = try decode_piece_entry(held.view(), alloc)
        let Some(pointer) = try mut self.moved_pointer(entry.record.view(), record, now, alloc) else {
            return
        }
        moved = Some(wire_of(PieceEntry(record: pointer.to_list(alloc), refcount: entry.refcount), alloc))
    } else if record.kind == disk::RecordKind.Stream {
        let entry = try decode_stream_run(held.view(), alloc)
        let Some(pointer) = try mut self.moved_pointer(entry.record.view(), record, now, alloc) else {
            return
        }
        moved = Some(wire_of(StreamRun(record: pointer.to_list(alloc), count: entry.count, bytes: entry.bytes, time: entry.time, agent: entry.agent), alloc))
    } else {
        var entry = try decode_commit_entry(held.view(), alloc)
        let Some(bytes) = entry.record else {
            return
        }
        let Some(pointer) = try mut self.moved_pointer(bytes.view(), record, now, alloc) else {
            return
        }
        entry.record = Some(pointer.to_list(alloc))
        moved = Some(wire_of(entry, alloc))
    }
    let Some(value) = moved else {
        return
    }
    try await mut self.catalog_put(device, key: key.view(), value: value.view(), alloc)
} Store.move_named

/// The pointer to a copy of `record` when `pointer` names it.
fn Store.moved_pointer(
    mut self,
    pointer: Slice[u8],
    record: Lying,
    now: ident::WallTime,
    alloc: mem::Alloc,
    ) -> Option[disk::Pointer] fails StoreError {
    let Some(named) = disk::Pointer.of_bytes(pointer) else {
        return None
    }
    if named.target != record.address {
        return None
    }
    let copy = try mut self.copy_record(record, now, alloc)
    return Some(copy.pointer)
} Store.moved_pointer

/// Appends a copy of `record` to the log.
fn Store.copy_record(mut self, record: Lying, now: ident::WallTime, alloc: mem::Alloc) -> log::Appended fails StoreError {
    let payload = accepted_bytes(record.payload.view(), alloc)
    return match attempt mut self.log.append(record.kind, key: record.key, payload: payload.view(), time: now.utc_ns, alloc) {
        Ok(placed) => placed
        Err(failure) => fail StoreError.of_log(take failure)
    }
} Store.copy_record
