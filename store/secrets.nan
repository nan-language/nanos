//! Secret records: the keyring as the engine holds it, each live secret's slot and seed, and the sealing of a secret record's value through the store's `Secrets`.

/// The keyring blocks a mount reads at once.
const KEYRING_READ: u32 = 64

/// The bytes a secret record's envelope adds to its value: the secret id, the nonce and the tag.
pkg const ENVELOPE_BYTES: u64 = 48

/// What the store needs to make secret records: a fresh seed for a new secret, and the envelope of a value under the node key of a secret.
pub interface Secrets {
    fn seed(self) -> Array[u8, 32]
    fn seal(
        self,
        secret: u64,
        seed: Array[u8, 32],
        schema: ident::HashValue,
        value: Slice[u8],
        alloc: mem::Alloc,
        ) -> mem::Bytes fails StoreError uses wait
} Secrets

/// The secrets of commits that write no secret record: sealing fails with `store.kind`.
pub open struct Unsealed derives Copy {
} Unsealed

impl Unsealed: Secrets

pub fn Unsealed.seed(self) -> Array[u8, 32] = Array[u8, 32].filled(0)

pub fn Unsealed.seal(
    self,
    secret: u64,
    seed: Array[u8, 32],
    schema: ident::HashValue,
    value: Slice[u8],
    alloc: mem::Alloc,
    ) -> mem::Bytes fails StoreError {
    fail StoreError.Kind
} Unsealed.seal

/// A live secret: its slot, numbered across the keyring's blocks, its seed and the commit that created its record.
pkg struct Kept derives Copy {
    pkg slot: u32
    pkg seed: Array[u8, 32]
    pkg commit: u64
} Kept

/// The keyring as the engine holds it: each live secret by id, and the sequence of each block.
pkg struct Keyring {
    pkg secrets: mem::Map[u64, Kept]
    pkg sequences: mem::List[u64]
} Keyring

pkg fn Keyring.empty(alloc: mem::Alloc) -> Keyring {
    var sequences = mem::List[u64].empty(alloc)
    for _ in 0..<disk::KEYRING_BLOCKS {
        mut sequences.push(0)
    }
    return Keyring(secrets: mem::Map.empty(alloc), sequences: take sequences)
} Keyring.empty

/// Loads the keyring: each block's valid copy with the higher sequence, the other copy rewritten when they differ; and numbers new secrets past every one it holds.
pkg fn Store.load_keyring[D: disk::Device](mut self, device: D, alloc: mem::Alloc) fails StoreError uses wait {
    var rewrote = false
    var base: u32 = 0
    while base < disk::KEYRING_BLOCKS {
        var count = disk::KEYRING_BLOCKS - base
        if count > KEYRING_READ {
            count = KEYRING_READ
        }
        let copies = try await read_blocks(device, block: disk::KEYRING_COPY_0 + u64.widen(base), count, alloc)
        let others = try await read_blocks(device, block: disk::KEYRING_COPY_1 + u64.widen(base), count, alloc)
        for offset in 0..<count {
            let index = base + offset
            let at = usize.widen(offset) * disk::BLOCK_BYTES
            let zeroth = block_at(copies.view(), at, alloc)
            let oneth = block_at(others.view(), at, alloc)
            let zeroth_sequence = sequence_of(zeroth)
            let oneth_sequence = sequence_of(oneth)
            let Some(current) = newer(take zeroth, take oneth) else {
                continue
            }
            if zeroth_sequence != Some(current.sequence) {
                try await mut self.guarded_write(device, block: disk::KEYRING_COPY_0 + u64.widen(index), data: current.to_block(alloc), alloc)
                rewrote = true
            }
            if oneth_sequence != Some(current.sequence) {
                try await mut self.guarded_write(device, block: disk::KEYRING_COPY_1 + u64.widen(index), data: current.to_block(alloc), alloc)
                rewrote = true
            }
            mut self.hold_block(index, block: take current)
        }
        base += count
    }
    if rewrote {
        try await mut self.guarded_flush(device, alloc)
    }
} Store.load_keyring

/// Holds the secrets of the keyring block `index`, numbering new secrets past them.
fn Store.hold_block(mut self, index: u32, take block: disk::KeyringBlock) {
    self.keyring.sequences[usize.widen(index)] = block.sequence
    var slot = index * u32.truncate(disk::SLOTS_PER_BLOCK)
    for held in block.slots {
        if held.secret != 0 {
            discard mut self.keyring.secrets.insert(held.secret, value: Kept(slot: slot, seed: held.seed, commit: held.commit))
            if held.secret >= self.counters.secret {
                self.counters.secret = held.secret + 1
            }
        }
        slot += 1
    }
} Store.hold_block

/// A new secret of seed `seed`, created by the commit `commit`, in the lowest free slot, its block written before it is given: `store.full` when no slot is free.
pkg fn Store.new_secret[D: disk::Device](
    mut self,
    device: D,
    seed: Array[u8, 32],
    commit: u64,
    alloc: mem::Alloc,
    ) -> u64 fails StoreError uses wait {
    var used = mem::Set[u32].empty(alloc)
    for entry in self.keyring.secrets {
        discard mut used.insert(entry.value().slot)
    }
    var slot: u32 = 0
    while used.contains(slot) {
        slot += 1
    }
    if slot >= disk::KEYRING_BLOCKS * u32.truncate(disk::SLOTS_PER_BLOCK) {
        fail StoreError.Full
    }
    let secret = self.counters.secret
    self.counters.secret += 1
    discard mut self.keyring.secrets.insert(secret, value: Kept(slot: slot, seed: seed, commit: commit))
    try await mut self.write_keyring_block(device, index: slot / u32.truncate(disk::SLOTS_PER_BLOCK), alloc)
    return secret
} Store.new_secret

/// Destroys the slot of `secret`, when the keyring holds it, writing its block's copies one after the other.
pkg fn Store.erase_secret[D: disk::Device](mut self, device: D, secret: u64, alloc: mem::Alloc) fails StoreError uses wait {
    let Some(kept) = mut self.keyring.secrets.remove(secret) else {
        return
    }
    try await mut self.write_keyring_block(device, index: kept.slot / u32.truncate(disk::SLOTS_PER_BLOCK), alloc)
} Store.erase_secret

/// The seed of `secret`, `store.erased` when no slot holds it.
pkg fn Store.seed_of(self, secret: u64) -> Array[u8, 32] fails StoreError {
    let Some(kept) = self.keyring.secrets.get(secret) else {
        fail StoreError.Erased
    }
    return kept.seed
} Store.seed_of

/// Writes the keyring block `index` as the secrets held give it, under its next sequence: copy 0, a flush, copy 1, a flush.
fn Store.write_keyring_block[D: disk::Device](mut self, device: D, index: u32, alloc: mem::Alloc) fails StoreError uses wait {
    var block = disk::KeyringBlock.empty(alloc)
    let lowest = index * u32.truncate(disk::SLOTS_PER_BLOCK)
    for entry in self.keyring.secrets {
        let kept = entry.value()
        if kept.slot >= lowest and kept.slot < lowest + u32.truncate(disk::SLOTS_PER_BLOCK) {
            block.slots[usize.widen(kept.slot - lowest)] = disk::Slot(secret: entry.key(), seed: kept.seed, commit: kept.commit)
        }
    }
    let at = usize.widen(index)
    block.sequence = self.keyring.sequences[at] + 1
    self.keyring.sequences[at] = block.sequence
    try await mut self.guarded_write(device, block: disk::KEYRING_COPY_0 + u64.widen(index), data: block.to_block(alloc), alloc)
    try await mut self.guarded_flush(device, alloc)
    try await mut self.guarded_write(device, block: disk::KEYRING_COPY_1 + u64.widen(index), data: block.to_block(alloc), alloc)
    try await mut self.guarded_flush(device, alloc)
} Store.write_keyring_block

/// The keyring block at `at` of `blocks`, `None` when that copy is blank or damaged.
fn block_at(blocks: Untrusted[Slice[u8]], at: usize, alloc: mem::Alloc) -> Option[disk::KeyringBlock] {
    let Some(parts) = blocks.split_at(at) else {
        return None
    }
    return disk::KeyringBlock.read(parts.tail, alloc)
} block_at

/// The valid copy with the higher sequence, `None` when neither is valid.
fn newer(take zeroth: Option[disk::KeyringBlock], take oneth: Option[disk::KeyringBlock]) -> Option[disk::KeyringBlock] {
    let zeroth_sequence = sequence_of(zeroth)
    let oneth_sequence = sequence_of(oneth)
    if oneth_sequence.is_some() and (zeroth_sequence.is_none() or oneth_sequence.value_or(0) > zeroth_sequence.value_or(0)) {
        return oneth
    }
    return zeroth
} newer

fn sequence_of(block: Option[disk::KeyringBlock]) -> Option[u64] {
    return match block {
        Some(held) => Some(held.sequence)
        None => None
    }
} sequence_of

/// Erases the secret record at `path` of `branch`: destroys its keyring slot, then commits its deletion under `stamp`; `store.kind` for a node that is no secret record. Once its slot is destroyed, every version of the node, on any branch, fails to read with `store.erased`, and an erase repeated after a failed deletion commits it.
pub fn Store.erase[D: disk::Device](
    mut self,
    device: D,
    branch: Str,
    path: ident::Path,
    take stamp: Stamp,
    now: ident::WallTime,
    alloc: mem::Alloc,
    ) -> Committed fails StoreError uses wait {
    let head = try self.head_named(branch)
    let segments = path.segments(alloc)
    let resolution = try await mut self.resolve(device, head, segments: segments.view(), now, alloc)
    let Some(found) = resolution.node() else {
        fail StoreError.NotFound
    }
    let secret = found.entry.secret
    if secret == 0 {
        fail StoreError.Kind
    }
    try await mut self.erase_secret(device, secret, alloc)
    var writes = mem::List[Write].empty(alloc)
    mut writes.push(Write.Delete(path: ident::Path(text: text::String.of(path.text.as_str(), alloc))))
    let transaction = Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: None, plan: None, intent: None)
    return try await mut self.commit(device, branch, take transaction, take stamp, now, alloc)
} Store.erase
