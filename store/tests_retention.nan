//! Tests of retention, pins, stream retention, expiries, the cleaner, space, collections and scrub.

fn short_retention(alloc: mem::Alloc) -> Retention {
    var tiers = mem::List[Tier].empty(alloc)
    mut tiers.push(Tier(every_s: 0, age_s: 100))
    return Retention(tiers: take tiers, max_pct: 25, agent_pct: 25)
} short_retention

fn commit_at(
    mut store: Store,
    device: disk::MemoryVolume,
    take writes: mem::List[Write],
    second: i64,
    alloc: mem::Alloc,
    ) -> Committed fails StoreError uses wait {
    return try await mut store.commit(device, branch: "main", transaction: blind(take writes, alloc), stamp: system_stamp(alloc), now: at_second(second), alloc)
} commit_at

fn large_setting(level: u32, size: usize, alloc: mem::Alloc) -> Value {
    var label = text::String.empty(alloc)
    for _ in 0..<size {
        mut label.push('x')
    }
    return Value.Record(type: setting_type(alloc), bytes: wire_of(Setting(level: level, label: take label), alloc), secret: false)
} large_setting

test commits_older_than_every_tier_are_thinned for Store.thin {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    mut store.retain_by(short_retention(alloc))
    let kept = try await commit_at(mut store, device, writes: single(put("/data/x", level: 1, alloc), alloc), second: 3, alloc)
    let pinned = try await commit_at(mut store, device, writes: single(put("/data/x", level: 2, alloc), alloc), second: 4, alloc)
    discard try await commit_at(mut store, device, writes: single(put("/data/x", level: 3, alloc), alloc), second: 5, alloc)
    try await mut store.pin(device, branch: "main", commit: pinned.number, by: ident::Principal(text: text::Fixed[64].of("owner")), note: None, now: at_second(6), alloc)
    try await mut store.index_flush(device, now: at_second(10), alloc)
    let young = try await level_then(mut store, device, text: "/data/x", at: kept.number.number, alloc)
    expect young == 1
    discard try await commit_at(mut store, device, writes: single(put("/data/y", level: 9, alloc), alloc), second: 300, alloc)
    try await mut store.index_flush(device, now: at_second(301), alloc)
    let thinned = attempt await mut store.get_at(device, branch: "main", path: path_of("/data/x", alloc), at: kept.number, now: at_second(301), alloc)
    let refused = match thinned {
        Err(StoreError.Thinned(retained: _)) => true
        else => false
    }
    expect refused
    let held = try await level_then(mut store, device, text: "/data/x", at: pinned.number.number, alloc)
    expect held == 2
    let now_level = try await level_on(mut store, device, branch: "main", text: "/data/x", alloc)
    expect now_level == 3
    var mounted = try await Store.mount(device, volume_id: Array[u8, 16].filled(9), now: at_second(302), alloc)
    let after = try await level_on(mut mounted, device, branch: "main", text: "/data/x", alloc)
    expect after == 3
} commits_older_than_every_tier_are_thinned

test streams_drop_entries_beyond_their_bytes_at_appends for Store.keep_appended {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    let limited = Declaration.Stream(StreamDecl(type: setting_type(alloc), max_age_s: None, max_bytes: Some(200)))
    discard try await commit_at(mut store, device, writes: single(Write.Make(path: path_of("/data/events", alloc), declaration: take limited), alloc), second: 3, alloc)
    for round in 0..<6u32 {
        var entries = mem::List[mem::Bytes].empty(alloc)
        mut entries.push(entry_of(round, alloc))
        mut entries.push(entry_of(round + 100, alloc))
        mut entries.push(entry_of(round + 200, alloc))
        discard try await commit_at(mut store, device, writes: single(Write.Append(path: path_of("/data/events", alloc), entries: take entries), alloc), second: 4, alloc)
    }
    let read = try await mut store.read_stream(device, branch: "main", path: path_of("/data/events", alloc), from: 1, limit: 100, now: at_second(5), alloc)
    expect read.lost > 0 and read.entries.len() < 18 and read.entries[read.entries.len() - 1].seq == 18
    var mounted = try await Store.mount(device, volume_id: Array[u8, 16].filled(9), now: at_second(6), alloc)
    let replayed = try await mut mounted.read_stream(device, branch: "main", path: path_of("/data/events", alloc), from: 1, limit: 100, now: at_second(6), alloc)
    expect replayed.lost == read.lost and replayed.entries.len() == read.entries.len()
} streams_drop_entries_beyond_their_bytes_at_appends

test expired_nodes_vanish for Store.expire_node {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    var writes = mem::List[Write].empty(alloc)
    mut writes.push(put("/state/app/lease", level: 1, alloc))
    mut writes.push(Write.Expire(path: path_of("/state/app/lease", alloc), at: Some(at_second(50))))
    discard try await commit_at(mut store, device, take writes, second: 3, alloc)
    let before = attempt await mut store.get(device, branch: "main", path: path_of("/state/app/lease", alloc), now: at_second(40), alloc)
    let after = attempt await mut store.get(device, branch: "main", path: path_of("/state/app/lease", alloc), now: at_second(60), alloc)
    expect before.is_ok() and after.is_err()
    let versioned = attempt await mut store.commit(device, branch: "main", transaction: blind(single(Write.Expire(path: path_of("/data", alloc), at: None), alloc), alloc), stamp: system_stamp(alloc), now: at_second(4), alloc)
    expect is_failure(versioned, code: StoreError.Kind)
} expired_nodes_vanish

test the_cleaner_frees_segments_of_little_live_data for Store.clean {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    mut store.retain_by(short_retention(alloc))
    for index in 0..<90u32 {
        let name = decimal_name(u64.widen(index), alloc)
        let path = text_of_name(name.view(), alloc)
        var full = text::String.of("/data/big/", alloc)
        mut full.append(path.as_str())
        discard try await commit_at(mut store, device, writes: single(Write.Put(path: path_of(full.as_str(), alloc), value: large_setting(index, size: 100_000, alloc)), alloc), second: 3, alloc)
    }
    try await mut store.index_flush(device, now: at_second(4), alloc)
    for index in 0..<90u32 {
        let name = decimal_name(u64.widen(index), alloc)
        let path = text_of_name(name.view(), alloc)
        var full = text::String.of("/data/big/", alloc)
        mut full.append(path.as_str())
        discard try await commit_at(mut store, device, writes: single(Write.Put(path: path_of(full.as_str(), alloc), value: setting(index, label: "small", alloc)), alloc), second: 500, alloc)
    }
    try await mut store.index_flush(device, now: at_second(700), alloc)
    let cleaned = try await mut store.clean(device, now: at_second(9_000), alloc)
    expect cleaned
    while try await mut store.clean(device, now: at_second(9_000), alloc) {
    }
    expect store.log.cleaning_candidate(now: at_second(9_000).utc_ns).is_none()
    try await mut store.index_flush(device, now: at_second(9_001), alloc)
    try await mut store.index_flush(device, now: at_second(9_002), alloc)
    let level = try await level_on(mut store, device, branch: "main", text: "/data/big/7", alloc)
    expect level == 7
    var mounted = try await Store.mount(device, volume_id: Array[u8, 16].filled(9), now: at_second(9_003), alloc)
    let remounted = try await level_on(mut mounted, device, branch: "main", text: "/data/big/42", alloc)
    expect remounted == 42
    let discarded = try await device.discarded()
    expect discarded > 0
} the_cleaner_frees_segments_of_little_live_data

test scrub_finds_damage_and_repairs_superblocks for Store.scrub {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    discard try await commit_at(mut store, device, writes: single(Write.Put(path: path_of("/data/large", alloc), value: large_setting(5, size: 3_000, alloc)), alloc), second: 3, alloc)
    try await mut store.index_flush(device, now: at_second(4), alloc)
    let clean = try await mut store.scrub(device, alloc)
    expect clean.errors.len() == 0 and clean.records > 0
    let node = try await mut store.get(device, branch: "main", path: path_of("/data/large", alloc), now: at_second(5), alloc)
    expect node.size > 1_024
    try await device.damage(offset: 0 + 100, alloc)
    discard try await mut store.scrub(device, alloc)
    var mounted = try await Store.mount(device, volume_id: Array[u8, 16].filled(9), now: at_second(6), alloc)
    let level = try await level_on(mut mounted, device, branch: "main", text: "/data/large", alloc)
    expect level == 5
} scrub_finds_damage_and_repairs_superblocks

fn agent_stamp(alloc: mem::Alloc) -> Stamp {
    var stamp = system_stamp(alloc)
    stamp.principal = ident::Principal(text: text::Fixed[64].of("agent.ops"))
    return stamp
} agent_stamp

/// Whether an agent's draft append of 2 MiB fails with `store.full`.
fn agent_appends(mut store: Store, device: disk::MemoryVolume, alloc: mem::Alloc) -> bool fails task::Cancelled uses wait {
    let draft = mut store.draft(now: at_second(11), alloc)
    let bytes = mem::Bytes.zeroed(2_097_152, alloc)
    let appended = attempt await mut store.draft_append(device, draft, bytes: bytes.view(), by: agent_stamp(alloc).principal, now: at_second(11), alloc)
    return match appended {
        Err(StoreError.Full) => true
        else => false
    }
} agent_appends

fn put_large(
    mut store: Store,
    device: disk::MemoryVolume,
    text: Str,
    level: u32,
    take stamp: Stamp,
    alloc: mem::Alloc,
    ) -> Result[Committed, StoreError] fails task::Cancelled uses wait {
    let write = Write.Put(path: path_of(text, alloc), value: doubled_setting(level, doublings: 21, alloc))
    return attempt await mut store.commit(device, branch: "main", transaction: blind(single(take write, alloc), alloc), take stamp, now: at_second(10), alloc)
} put_large

test agents_stop_at_their_share_and_history_thins_past_max_pct for Store.check_agent_share {
    let alloc = testing::world().alloc
    let device = disk::MemoryVolume.of_blocks(16_384, alloc)
    var store = try await genesis_store(device, alloc)
    var level: u32 = 0
    var refused = false
    while not refused and level < 40 {
        level += 1
        let outcome = try await put_large(mut store, device, text: "/data/agent", level, stamp: agent_stamp(alloc), alloc)
        refused = is_failure(outcome, code: StoreError.Full)
    }
    expect refused and level > 4 and store.free_bytes() > 2_097_152
    let appended = try await agent_appends(mut store, device, alloc)
    expect appended
    for round in 1..=12u32 {
        discard try await put_large(mut store, device, text: "/data/system", level: round, stamp: system_stamp(alloc), alloc)
    }
    discard mut store.take_events(alloc)
    try await mut store.index_flush(device, now: at_second(12), alloc)
    let thinned = try await thinned_bytes(mut store, device, alloc)
    expect thinned > 0 and store.history_in_use() <= store.share_of(25)
    let kept = try await level_at(mut store, device, text: "/data/system", alloc)
    expect kept == 12
} agents_stop_at_their_share_and_history_thins_past_max_pct

/// The bytes the history-thinned events of an index flush report.
fn thinned_bytes(mut store: Store, device: disk::MemoryVolume, alloc: mem::Alloc) -> u64 fails StoreError uses wait {
    try await mut store.index_flush(device, now: at_second(13), alloc)
    var bytes: u64 = 0
    for event in mut store.take_events(alloc) {
        match event {
            Event.HistoryThinned(commits: _, bytes: freed, oldest: _) => {
                bytes += freed
            }
            else => {
            }
        }
    }
    return bytes
} thinned_bytes

test collections_thin_and_free_what_no_retained_commit_reaches for Store.gc {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    mut store.retain_by(short_retention(alloc))
    for level in 1..=6u32 {
        discard try await put_large(mut store, device, text: "/data/x", level, stamp: system_stamp(alloc), alloc)
    }
    let collected = try await mut store.gc(device, now: at_second(1_000), alloc)
    expect collected.commits >= 5 and collected.bytes > 0
    let level = try await level_at(mut store, device, text: "/data/x", alloc)
    expect level == 6
} collections_thin_and_free_what_no_retained_commit_reaches
