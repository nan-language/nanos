//! Tests of secret records on in-memory volumes.

/// Secrets sealing a value as its secret id, a zero nonce, the value itself and a zero tag.
struct Plainly derives Copy {
} Plainly

impl Plainly: Secrets

fn Plainly.seed(self) -> Array[u8, 32] = Array[u8, 32].filled(3)

fn Plainly.seal(
    self,
    secret: u64,
    seed: Array[u8, 32],
    schema: ident::HashValue,
    value: Slice[u8],
    alloc: mem::Alloc,
    ) -> mem::Bytes {
    var envelope = mem::Bytes.empty(alloc)
    for at in 0..<8u32 {
        mut envelope.push(u8.truncate(secret >> (8 * at)))
    }
    for _ in 0..<24u32 {
        mut envelope.push(0)
    }
    mut envelope.append(value)
    for _ in 0..<16u32 {
        mut envelope.push(0)
    }
    return envelope
} Plainly.seal

fn secret_put(text: Str, level: u32, alloc: mem::Alloc) -> Write {
    let value = Setting(level: level, label: text::String.of(text, alloc))
    return Write.Put(path: path_of(text, alloc), value: Value.Record(type: setting_type(alloc), bytes: wire_of(value, alloc), secret: true))
} secret_put

test secret_records_seal_keep_their_secret_and_erase for Store.erase {
    let alloc = testing::world().alloc
    let device = test_volume(alloc)
    var store = try await genesis_store(device, alloc)
    var sealed = mem::List[Write].empty(alloc)
    mut sealed.push(secret_put("/data/token", level: 5, alloc))
    discard try await mut store.commit_sealed(device, branch: "main", transaction: blind(take sealed, alloc), stamp: system_stamp(alloc), secrets: Plainly(), now: at_second(3), alloc)
    var unsealed = mem::List[Write].empty(alloc)
    mut unsealed.push(secret_put("/data/other", level: 1, alloc))
    let refused = attempt await mut store.commit(device, branch: "main", transaction: blind(take unsealed, alloc), stamp: system_stamp(alloc), now: at_second(4), alloc)
    var again = mem::List[Write].empty(alloc)
    mut again.push(put("/data/token", level: 6, alloc))
    discard try await mut store.commit_sealed(device, branch: "main", transaction: blind(take again, alloc), stamp: system_stamp(alloc), secrets: Plainly(), now: at_second(5), alloc)
    var mounted = try await Store.mount(device, volume_id: Array[u8, 16].filled(9), now: at_second(6), alloc)
    let node = try await mut mounted.get(device, branch: "main", path: path_of("/data/token", alloc), now: at_second(6), alloc)
    let plain = wire_of(Setting(level: 6, label: text::String.of("/data/token", alloc)), alloc)
    let owner = ident::Principal(text: text::Fixed[64].of("owner"))
    discard try await mut mounted.branch(device, name: "kept", from: "main", at: None, by: owner, expires: None, system: false, now: at_second(7), alloc)
    discard try await mut mounted.erase(device, branch: "main", path: path_of("/data/token", alloc), stamp: system_stamp(alloc), now: at_second(8), alloc)
    let deleted = attempt await mut mounted.get(device, branch: "main", path: path_of("/data/token", alloc), now: at_second(8), alloc)
    let elsewhere = attempt await mut mounted.get(device, branch: "kept", path: path_of("/data/token", alloc), now: at_second(8), alloc)
    var remounted = try await Store.mount(device, volume_id: Array[u8, 16].filled(9), now: at_second(9), alloc)
    let destroyed = attempt remounted.seed_of(1)
    let gone = match deleted {
        Err(StoreError.NotFound) => true
        else => false
    }
    let erased = match elsewhere {
        Err(StoreError.Erased) => true
        else => false
    }
    let lost = match destroyed {
        Err(StoreError.Erased) => true
        else => false
    }
    expect refused.is_err() and node.secret and node.value.is_none() and node.size == u64.widen(plain.len())
    expect gone and erased and lost and remounted.counters.secret == 2
} secret_records_seal_keep_their_secret_and_erase
