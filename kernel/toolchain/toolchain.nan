//! The toolchain of the `nan` job: the NaN toolchain the generation ships, isolated once per boot and run for each run a capability orders in an isolated space of its own, and the standard streams its space reaches.

/// The boot modules the generation ships the toolchain in: its image and its tree hash.
pkg const IMAGE_MODULE: Str = "nan.nbun"

pkg const TREE_MODULE: Str = "nan.ntree"

/// The bytes of the toolchain's standard streams a run keeps.
const KEPT_OUTPUT: usize = 1_048_576

/// The frames a run lends its space: 768 MiB for its heap and 64 MiB for the toolchain's image.
pkg const RUN_FRAMES: u64 = 212_992

/// The toolchain as the start isolated it: its isolated bundle and its tree hash.
pkg struct Shipped {
    pkg job: sys::load::Isolated
    pkg tree: ident::HashValue
} Shipped

/// The toolchain whose image and tree hash the modules `image` and `tree` hold, isolated through `loader` with its copy drawn through `alloc`; `None` when they do not decode or it does not isolate.
pkg fn Shipped.of(loader: sys::load::Loader, image: Untrusted[Slice[u8]], tree: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[Shipped] {
    let Some(hash) = tree_hash(tree) else {
        return None
    }
    let bundle = copied(image, alloc)
    let isolated = trusted "the generation ships the toolchain lowered against the interface file of the kernel it ships" { attempt loader.isolate_unverified(bundle.view(), alloc) }
    let Ok(job) = isolated else {
        return None
    }
    return Some(Shipped(job: take job, tree: hash))
} Shipped.of

/// The hash a tree file holds, `None` for other bytes.
validator fn tree_hash(raw: Untrusted[Slice[u8]]) -> Option[ident::HashValue] {
    let bytes = raw.inspect()
    if bytes.len() != 33 or bytes[0] != 0x01 {
        return None
    }
    var hash = Array[u8, 33].filled(0)
    for at in 0usize..<33 {
        hash[at] = bytes[at]
    }
    return Some(ident::HashValue(bytes: hash))
} tree_hash

/// A copy of `raw` drawn through `alloc`.
validator fn copied(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.empty(alloc)
    mut bytes.append(raw.inspect())
    return bytes
} copied

/// Runs `run` in an isolated space of the toolchain for `tenant` on `cpu`, its pages taken from `frames` and given back to them, `RUN_FRAMES` of them lent by the run, until it ends or its stop closes, and tells its end and what it wrote; the capabilities of its file system and standard streams draw through `alloc`.
pkg fn Shipped.run(
    self,
    cpu: hw::Ring0,
    tenant: u64,
    take run: code::Run,
    mut frames: mem::List[hw::PhysFrame[4_096]],
    exec: task::Executor,
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    let code::Run(input: input, workspace: workspace, clock: clock, log: log, random: random, stop: stop, done: done) = run
    let filing = code::MintedWorkspace.of(workspace, alloc)
    defer take filing.close()
    let capture = MintedCapture.of(alloc)
    defer take capture.close()
    let Ok(fs) = attempt sys::Fs.served(filing.mint()) else {
        discard attempt await done.send(Err(text::Fixed[32].of("instance.env-incomplete")))
        return
    }
    let Ok(stdio) = attempt sys::Stdio.served(capture.mint()) else {
        discard attempt await done.send(Err(text::Fixed[32].of("instance.env-incomplete")))
        return
    }
    let services = nanos::Services(clock: clock, log: log, stdio: stdio, random: random, fs: fs)
    let Some(bell) = mut frames.pop() else {
        discard attempt await done.send(Err(text::Fixed[32].of("place.unavailable")))
        return
    }
    let link = nanos::Link.of(take bell, alloc)
    var extended = match mut frames.pop() {
        Some(state) => Some(hw::ExtendedState.of(take state))
        None => None
    }
    var loan = isolation::loaned(mut frames, count: RUN_FRAMES, alloc)
    let job = self.job
    var ended: Result[nanos::Ended, text::Fixed[32]] = Ok(nanos::Ended.Cancelled)
    var inputs = Some(take input)
    var stops = Some(take stop)
    let scoped = attempt await nanos::isolate(cpu, tenant, services, mut frames, mut extended, exec, alloc, body: fn[mut ended, mut inputs, mut stops, mut loan](space: nanos::Isolation) fails task::Cancelled uses wait limits stack 131_072 {
        let Some(given) = mut inputs.extract() else {
            return
        }
        let Some(watched) = mut stops.extract() else {
            return
        }
        match try await isolation::ended_job(space, job, link, services, caps: nanos::Caps.empty(alloc), input: take given, stop: take watched, frames: mut loan, exec, alloc) {
            Some(outcome) => {
                ended = outcome
            }
            None => {
            }
        }
    })
    for frame in take loan {
        mut frames.push(take frame)
    }
    take link.release(mut frames)
    match extended {
        Some(owned) => mut frames.push(take owned.into_frame())
        None => {
        }
    }
    match scoped {
        Ok(_) => {
        }
        Err(cancelled) => fail cancelled
    }
    let outcome: Result[code::Ran, text::Fixed[32]] = match ended {
        Ok(given) => Ok(code::Ran(ended: take given, written: try await capture.written(alloc)))
        Err(failure) => Err(failure)
    }
    discard attempt await done.send(take outcome)
} Shipped.run

/// The standard streams of a run of the toolchain: no input, and its output and errors kept together, up to `KEPT_OUTPUT` bytes.
struct Capture {
} Capture

impl Capture: sys::Kind[task::Cown[mem::Bytes], u8]

impl Capture: sys::StdioService

/// The root entry of a run's captured streams.
linear struct MintedCapture {
    minter: sys::Minter[Capture, task::Cown[mem::Bytes], u8]
    kept: task::Cown[mem::Bytes]
} MintedCapture

fn MintedCapture.of(alloc: mem::Alloc) -> MintedCapture {
    let kept = task::Cown.of(mem::Bytes.empty(alloc), alloc)
    return MintedCapture(minter: sys::Minter[Capture, task::Cown[mem::Bytes], u8].of(kept.share(), alloc), kept: take kept)
} MintedCapture.of

fn MintedCapture.mint(self) -> Capture {
    return self.minter.mint(0)
} MintedCapture.mint

/// What the run wrote.
fn MintedCapture.written(self, alloc: mem::Alloc) -> mem::Bytes fails task::Cancelled uses wait {
    var written = mem::Bytes.empty(alloc)
    let kept = self.kept.share()
    await when kept {
        mut written.append(kept.view())
    }
    return written
} MintedCapture.written

fn MintedCapture.close(take self) {
    let MintedCapture(minter: minter, kept: _) = self
    take minter.close()
} MintedCapture.close

fn Capture.read_in(self, mut buf: SliceMut[u8]) -> usize limits stack 4_096 {
    return 0
} Capture.read_in

fn Capture.write_out(self, data: Slice[u8]) fails sys::StdioError uses wait limits stack 4_096 {
    try await self.keep(data)
} Capture.write_out

fn Capture.write_err(self, data: Slice[u8]) fails sys::StdioError uses wait limits stack 4_096 {
    try await self.keep(data)
} Capture.write_err

/// Appends `data` to what the run wrote, up to `KEPT_OUTPUT` bytes.
fn Capture.keep(self, data: Slice[u8]) fails sys::StdioError uses wait {
    let Some(kept) = sys::reach(self, body: fn(state: task::Cown[mem::Bytes], record: u8) => state.share()) else {
        fail sys::StdioError.Closed
    }
    await when mut kept {
        let room = KEPT_OUTPUT.saturating_sub(kept.len())
        match data.prefix(data.len().min(room)) {
            Some(part) => mut kept.append(part)
            None => {
            }
        }
    }
} Capture.keep
