//! The board: the core's task holding the latest record each provider published below `/live`, which computes `/live/status` from them and the clocks, the records of `/live/cpus` from the scheduler's state, the counters of `/live/instances` and `/live/accounts` from the gauges of the running incarnations, and `/live/memory` from the memory keeper's counters and those gauges, when they are read.

/// The path of the record the board computes.
const LIVE_STATUS: Str = "/live/status"

/// The dir of the records of instances.
const LIVE_INSTANCES: Str = "/live/instances/"

/// The path of the store's record.
const LIVE_STORE: Str = "/live/store"

/// The path of the security record.
const LIVE_SECURITY: Str = "/live/security"

/// The path of the part of the security record `keys` publishes.
const KEYS_SECURITY: Str = "/live/security/keys"

/// The dir of the records of accounts.
const LIVE_ACCOUNTS: Str = "/live/accounts/"

/// The dir of the records of CPUs.
const LIVE_CPUS: Str = "/live/cpus"

/// The path of the memory summary.
const LIVE_MEMORY: Str = "/live/memory"

/// The idle state a resting CPU is in.
const HALTED: Str = "hlt"

/// What `/live/status` reads besides the records: the generation booted and its mode, and the clocks.
struct Origin derives Copy {
    generation: u64
    mode: os::BootMode
    clock: sys::Clock
    wall: ident::Wall
} Origin

/// The origin the handoff record `handoff` tells.
fn Origin.of(handoff: bootfmt::Handoff, clock: sys::Clock, wall: ident::Wall) -> Origin {
    let mode = match bootfmt::Mode.checked_from_bits(handoff.mode) {
        Some(bootfmt::Mode.Trial) => os::BootMode.Trial
        Some(bootfmt::Mode.Recovery) => os::BootMode.Recovery
        Some(bootfmt::Mode.Dev) => os::BootMode.Dev
        else => os::BootMode.Normal
    }
    return Origin(generation: handoff.generation, mode: mode, clock: clock, wall: wall)
} Origin.of

/// Holds `machine`, `security` and the records published through `postings`, a withdrawal taking those below its path too, and answers their reads, those of the CPUs of `cpus`, and those of the accounts and counters `gauges` reads and of the memory summary `memory` counts, these on tasks of its own through `exec`, until every sender is gone.
fn serve_board(
    take postings: task::Receiver[os::Posting],
    origin: Origin,
    machine: os::Machine,
    take security: os::LiveSecurity,
    cpus: mem::Shared[sched::State],
    gauges: runner::Gauges,
    memory: Counters,
    exec: task::Executor,
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    var records = mem::Map[text::String, os::Published].empty(alloc)
    discard mut records.insert(text::String.of("/live/machine", alloc), value: os::published("os::Machine", value: machine, alloc))
    discard mut records.insert(text::String.of(LIVE_SECURITY, alloc), value: os::published("os::LiveSecurity", value: security, alloc))
    var receiver = postings
    try await task::scope(exec, body: fn[mut records, mut receiver](s: task::Scope) fails task::Cancelled uses wait {
        loop {
            let Some(posting) = try await mut receiver.receive() else {
                s.cancel()
                return
            }
            match posting {
                os::Posting.Publish(path: path, record: record) => {
                    discard mut records.insert(take path, value: take record)
                }
                os::Posting.Withdraw(path: path) => withdraw(mut records, path: path.as_str(), alloc)
                os::Posting.Get(path: path, reply: reply) => {
                    match gauged_at(records, path: path.as_str(), alloc) {
                        Some(wanted) => {
                            let reading = gauges.share()
                            let counting = memory.share()
                            discard s.spawn(fn[take wanted, take reading, take counting, take reply]() fails task::Cancelled uses wait limits stack 16_384 {
                                let found = try await read_gauged(reading, counters: counting, take wanted, origin, alloc)
                                try await answer(reply, value: take found)
                            })
                        }
                        None => try await answer(reply, value: read_at(records, cpus: cpus.contents(), path: path.as_str(), origin, alloc))
                    }
                }
                os::Posting.List(path: path, after: after, limit: limit, reply: reply) => {
                    var accounts = mem::List[text::String].empty(alloc)
                    if path.as_str() == "/live/accounts" {
                        accounts = try await gauges.instances(alloc)
                    }
                    try await answer(reply, value: children(records, accounts, cpus: cpus.contents().count(), path: path.as_str(), after, limit, alloc))
                }
            }
        }
    })
} serve_board

/// What a read needs from the gauges of the running incarnations: an instance's account, the counters of the record its provider published, or the charges of every cell beside the memory keeper's counters.
enum Gauged {
    Account(instance: text::String)
    Instance(instance: text::String, record: os::Published)
    Memory
} Gauged

/// What a read of `path` needs from the gauges, `None` when it needs none.
fn gauged_at(records: mem::Map[text::String, os::Published], path: Str, alloc: mem::Alloc) -> Option[Gauged] {
    if path == LIVE_MEMORY {
        return Some(Gauged.Memory)
    }
    match name_below(path, dir: LIVE_ACCOUNTS, alloc) {
        Some(named) => return Some(Gauged.Account(instance: take named))
        None => {
        }
    }
    let Some(named) = name_below(path, dir: LIVE_INSTANCES, alloc) else {
        return None
    }
    let Some(record) = records.get(text::String.of(path, alloc)) else {
        return None
    }
    return Some(Gauged.Instance(instance: take named, record: os::Published(type: text::String.of(record.type.as_str(), alloc), schema: record.schema, bytes: copy_of(record.bytes.view(), alloc))))
} gauged_at

/// The record a read of what `wanted` needs gives as `gauges` and `counters` read it now: an instance's account, `None` when no incarnation of it runs, its published record with the counters of its running incarnation, or the memory summary, `None` once the memory keeper no longer runs.
fn read_gauged(
    gauges: runner::Gauges,
    counters: Counters,
    take wanted: Gauged,
    origin: Origin,
    alloc: mem::Alloc,
    ) -> Option[os::Published] fails task::Cancelled uses wait {
    match wanted {
        Gauged.Memory => {
            let charges = try await gauges.charges(alloc)
            let Some(reading) = try await counters.read() else {
                return None
            }
            return Some(os::published("os::MemorySummary", value: reading.summary(pooled: charges.pooled, reserved: charges.reserved), alloc))
        }
        Gauged.Account(instance: instance) => {
            let Some(gauge) = try await gauges.read(instance.as_str(), alloc) else {
                return None
            }
            let memory = gauge.memory
            let account = os::Account(cpu_ns: gauge.cpu_ns, wakeups: 0, io_bytes: 0, energy_mj: gauge.energy_mj, throttled: gauge.throttled, class: gauge.class, charge: memory.charged, peak: memory.peak, limit: memory.limit, as_of: rings::elapsed(origin.clock))
            return Some(os::published("os::Account", value: account, alloc))
        }
        Gauged.Instance(instance: instance, record: record) => {
            let Some(gauge) = try await gauges.read(instance.as_str(), alloc) else {
                return Some(take record)
            }
            let Some(published) = instance_of(Untrusted.of(record.bytes.view()), alloc) else {
                return Some(take record)
            }
            var gauged = published
            gauged.intake = gauge.intake
            gauged.memory = gauge.memory
            gauged.cpu_ns = gauge.cpu_ns
            gauged.as_of = rings::elapsed(origin.clock)
            return Some(os::published("os::LiveInstance", value: gauged, alloc))
        }
    }
} read_gauged

/// The record at `path` as of now: the status or a CPU computed, or the record a provider published.
fn read_at(
    records: mem::Map[text::String, os::Published],
    cpus: sched::State,
    path: Str,
    origin: Origin,
    alloc: mem::Alloc,
    ) -> Option[os::Published] {
    if path == LIVE_STATUS {
        return Some(status_of(records, origin, alloc))
    }
    if path == LIVE_SECURITY {
        return security_at(records, alloc)
    }
    return match records.get(text::String.of(path, alloc)) {
        Some(record) => Some(os::Published(type: text::String.of(record.type.as_str(), alloc), schema: record.schema, bytes: copy_of(record.bytes.view(), alloc)))
        None => cpu_at(cpus, path, origin, alloc)
    }
} read_at

/// The name that `path` holds directly below `dir`, `None` when it lies elsewhere.
fn name_below(path: Str, dir: Str, alloc: mem::Alloc) -> Option[text::String] {
    let Some(parts) = path.as_bytes().split_at(dir.as_bytes().len()) else {
        return None
    }
    if parts.head != dir.as_bytes() or parts.tail.len() == 0 {
        return None
    }
    for byte in parts.tail {
        if byte == b'/' {
            return None
        }
    }
    return match attempt text::String.try_from_utf8(parts.tail, alloc) {
        Ok(name) => Some(take name)
        Err(_) => None
    }
} name_below

/// Removes the record at `path` and every record below it.
fn withdraw(mut records: mem::Map[text::String, os::Published], path: Str, alloc: mem::Alloc) {
    var below = text::String.of(path, alloc)
    mut below.push('/')
    var gone = mem::List[text::String].empty(alloc)
    for entry in records {
        if entry.key().as_str() == path or entry.key().starts_with(below.as_str()) {
            mut gone.push(text::String.of(entry.key().as_str(), alloc))
        }
    }
    for key in take gone {
        discard mut records.remove(key)
    }
} withdraw

/// Sends `value` to a reader, which may have stopped waiting.
fn answer[T: Send](reply: task::Sender[T], take value: T) fails task::Cancelled uses wait {
    match attempt await reply.send(take value) {
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} answer

/// The children of `path` the records give, `status`, `accounts`, `cpus` and `memory` below `/live`, the `accounts` below `/live/accounts`, and the `cpus` CPUs below `/live/cpus`, in name order, named after `after`, at most `limit`.
fn children(
    records: mem::Map[text::String, os::Published],
    accounts: mem::List[text::String],
    cpus: u32,
    path: Str,
    after: Option[text::String],
    limit: u32,
    alloc: mem::Alloc,
    ) -> mem::List[os::LiveEntry] {
    var prefix = text::String.of(path, alloc)
    if not prefix.ends_with("/") {
        mut prefix.push('/')
    }
    var entries = mem::List[os::LiveEntry].empty(alloc)
    if path == "/live" {
        add_child(mut entries, name: b"status", type: Some(text::String.of("os::LiveStatus", alloc)), parent: false, after, alloc)
        add_child(mut entries, name: b"cpus", type: None, parent: true, after, alloc)
        add_child(mut entries, name: b"accounts", type: None, parent: true, after, alloc)
        add_child(mut entries, name: b"memory", type: Some(text::String.of("os::MemorySummary", alloc)), parent: false, after, alloc)
    }
    if path == "/live/accounts" {
        for account in accounts {
            add_child(mut entries, name: account.as_bytes(), type: Some(text::String.of("os::Account", alloc)), parent: false, after, alloc)
        }
    }
    if path == LIVE_CPUS {
        for number in 0..<cpus {
            let name = store::decimal_name(u64.widen(number), alloc)
            add_child(mut entries, name: name.view(), type: Some(text::String.of("os::LiveCpu", alloc)), parent: false, after, alloc)
        }
    }
    for entry in records {
        if entry.key().starts_with("/live/security/") {
            continue
        }
        let key = entry.key().as_bytes()
        let Some(parts) = key.split_at(prefix.byte_len()) else {
            continue
        }
        if parts.head != prefix.as_bytes() or parts.tail.len() == 0 {
            continue
        }
        var end: usize = 0
        while end < parts.tail.len() and parts.tail[end] != b'/' {
            end += 1
        }
        let Some(name) = parts.tail.prefix(end) else {
            continue
        }
        let type = match end == parts.tail.len() {
            true => Some(text::String.of(entry.value().type.as_str(), alloc))
            false => None
        }
        add_child(mut entries, name, take type, parent: end < parts.tail.len(), after, alloc)
    }
    mut entries.truncate(usize.widen(limit))
    return entries
} children

/// Adds the child `name` to `entries`, kept in name order, or what it adds to the child already there, unless `name` does not come after `after`.
fn add_child(
    mut entries: mem::List[os::LiveEntry],
    name: Slice[u8],
    take type: Option[text::String],
    parent: bool,
    after: Option[text::String],
    alloc: mem::Alloc,
    ) {
    match after {
        Some(bound) => {
            if name <= bound.as_bytes() {
                return
            }
        }
        None => {
        }
    }
    var at: usize = 0
    while at < entries.len() and entries[at].name.as_bytes() < name {
        at += 1
    }
    if at < entries.len() and entries[at].name.as_bytes() == name {
        let os::LiveEntry(name: kept, type: typed, parent: nested) = mut entries.remove(at)
        let merged = match type {
            Some(given) => Some(take given)
            None => typed
        }
        mut entries.insert(at, value: os::LiveEntry(name: take kept, type: take merged, parent: nested or parent))
        return
    }
    let named = match attempt text::String.try_from_utf8(name, alloc) {
        Ok(spelt) => spelt
        Err(_) => return
    }
    mut entries.insert(at, value: os::LiveEntry(name: take named, type: take type, parent: parent))
} add_child

/// The record as of now of the CPU `path` names below `/live/cpus`, `None` when it names none.
fn cpu_at(cpus: sched::State, path: Str, origin: Origin, alloc: mem::Alloc) -> Option[os::Published] {
    let Some(parts) = path.as_bytes().split_at(LIVE_CPUS.as_bytes().len() + 1) else {
        return None
    }
    if parts.head.prefix(LIVE_CPUS.as_bytes().len()) != Some(LIVE_CPUS.as_bytes()) or parts.head[LIVE_CPUS.as_bytes().len()] != b'/' {
        return None
    }
    let Some(number) = store::decimal_value(parts.tail) else {
        return None
    }
    if number >= u64.widen(cpus.count()) {
        return None
    }
    let cpu = u32.truncate(number)
    let Some(place) = cpus.place(cpu) else {
        return None
    }
    let Some(reading) = cpus.reading(cpu) else {
        return None
    }
    var siblings = mem::List[u32].empty(alloc)
    for other in 0..<cpus.count() {
        let shares_core = match cpus.place(other) {
            Some(spot) => spot.core == place.core
            None => false
        }
        if other != cpu and shares_core {
            mut siblings.push(other)
        }
    }
    var idle_state = text::String.empty(alloc)
    if reading.resting {
        match reading.resting_in {
            Some(hint) => {
                mut idle_state.append("mwait c")
                mut idle_state.write(Dyn[Render].view(u32.widen(hint >> 4) + 1), budget: 3)
            }
            None => mut idle_state.append(HALTED)
        }
    }
    let times = reading.times
    let time = os::CpuTime(normal: times.normal, background: times.background, latency: times.latency, interrupts: times.core, idle: times.idle)
    let record = os::LiveCpu(online: reading.started, package_id: place.package_id, core: place.core, llc: u32.truncate(place.cache), node: place.node, siblings: take siblings, time: time, run_queue: reading.queued, idle_state: take idle_state, frequency_mhz: 0, wakeups: reading.wakeups, as_of: rings::elapsed(origin.clock))
    return Some(os::published("os::LiveCpu", value: record, alloc))
} cpu_at

/// The record of `/live/status` as of now: the instances the records of `/live/instances` count running, converging and failed, and the share of the store's capacity in use its record tells.
fn status_of(records: mem::Map[text::String, os::Published], origin: Origin, alloc: mem::Alloc) -> os::Published {
    var counts = os::InstanceCounts(running: 0, converging: 0, failed: 0)
    var used_pct: u8 = 0
    var exposures = mem::List[text::String].empty(alloc)
    for entry in records {
        if entry.key().starts_with(LIVE_INSTANCES) {
            let Some(instance) = instance_of(Untrusted.of(entry.value().bytes.view()), alloc) else {
                continue
            }
            if instance.state == os::Lifecycle.Running {
                counts.running += 1
            }
            match instance.status.state {
                os::ReconcileState.Converging => {
                    counts.converging += 1
                }
                os::ReconcileState.Failed(code: _, detail: _) => {
                    counts.failed += 1
                }
                os::ReconcileState.Converged => {
                }
            }
        } else if entry.key().as_str() == LIVE_STORE {
            used_pct = used_share(Untrusted.of(entry.value().bytes.view()), alloc)
        }
    }
    match security_at(records, alloc) {
        Some(security) => {
            exposures = exposures_of(Untrusted.of(security.bytes.view()), alloc)
        }
        None => {
        }
    }
    let now = rings::elapsed(origin.clock)
    let status = os::LiveStatus(generation: origin.generation, mode: origin.mode, claimed: false, uptime: now, time: origin.wall.now(origin.clock), instances: counts, approvals: 0, store_used_pct: used_pct, exposures: take exposures, cursor: ident::Cursor(seq: 0), as_of: now)
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[os::LiveStatus].encode(status, out: mut bytes)
    return os::Published(type: text::String.of("os::LiveStatus", alloc), schema: mem::wire::Codec[os::LiveStatus].schema_hash(), bytes: take bytes)
} status_of

validator fn instance_of(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[os::LiveInstance] {
    return match attempt mem::wire::Codec[os::LiveInstance].decode(raw, alloc) {
        Ok(found) => Some(take found)
        Err(_) => None
    }
} instance_of

/// The record of `/live/security`: the core's, with the part `keys` published below it.
fn security_at(records: mem::Map[text::String, os::Published], alloc: mem::Alloc) -> Option[os::Published] {
    let Some(core) = records.get(text::String.of(LIVE_SECURITY, alloc)) else {
        return None
    }
    let Some(held) = security_of_record(Untrusted.of(core.bytes.view()), alloc) else {
        return None
    }
    var security = held
    match records.get(text::String.of(KEYS_SECURITY, alloc)) {
        Some(part) => {
            match keys_part(Untrusted.of(part.bytes.view()), alloc) {
                Some(told) => {
                    let os::KeysSecurity(keys: space, key_storage: storage, link_keys: link) = told
                    security.keys = space
                    security.key_storage = storage
                    security.link_keys = link
                }
                None => {
                }
            }
        }
        None => {
        }
    }
    return Some(os::published("os::LiveSecurity", value: security, alloc))
} security_at

validator fn security_of_record(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[os::LiveSecurity] {
    return match attempt mem::wire::Codec[os::LiveSecurity].decode(raw, alloc) {
        Ok(found) => Some(take found)
        Err(_) => None
    }
} security_of_record

validator fn keys_part(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[os::KeysSecurity] {
    return match attempt mem::wire::Codec[os::KeysSecurity].decode(raw, alloc) {
        Ok(found) => Some(take found)
        Err(_) => None
    }
} keys_part

/// The fields of the security record `raw` away from their protected value.
validator fn exposures_of(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> mem::List[text::String] {
    return match attempt mem::wire::Codec[os::LiveSecurity].decode(raw, alloc) {
        Ok(security) => security.exposures(alloc)
        Err(_) => mem::List.empty(alloc)
    }
} exposures_of

/// The share of the store's capacity in use, in percent, that its record `raw` tells.
validator fn used_share(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> u8 {
    let Ok(stored) = attempt mem::wire::Codec[store::service::LiveStore].decode(raw, alloc) else {
        return 0
    }
    if stored.capacity == 0 {
        return 0
    }
    return u8.saturate(stored.used.saturating_mul(100) / stored.capacity)
} used_share

/// The record of `/live/security` as the core knows it at start from the handoff record and `machine`: the loader's floor and build, secure boot and measurement, unconfined DMA, no isolated space, `keys` unconfined with its keys sealed in the TPM when the machine has one, no link or audit key yet, and a plain volume.
fn security_of(handoff: bootfmt::Handoff, machine: os::Machine, alloc: mem::Alloc) -> os::LiveSecurity {
    let flags = handoff.flags
    let rollback = match flags.floor_in_tpm or flags.floor_in_variable {
        true => os::Rollback.Protected
        false => os::Rollback.Unprotected
    }
    let loader = match flags.development {
        true => os::LoaderBuild.Development
        false => os::LoaderBuild.Production
    }
    let key_storage = match machine.conditions.tpm {
        true => os::KeyStorage.Tpm
        false => os::KeyStorage.Software
    }
    let link_keys = os::LinkKeys(x25519: mem::Bytes.empty(alloc), ed25519: mem::Bytes.empty(alloc))
    return os::LiveSecurity(rollback: rollback, loader: loader, secure_boot: machine.conditions.secure_boot, measured: machine.conditions.tpm and handoff.event_log_size > 0, dma: os::Confinement.Unconfined, isolated_spaces: false, keys: os::KeysSpace.Unconfined, key_storage: key_storage, link_keys: take link_keys, audit: os::AuditChain.Intact, audit_key: mem::Bytes.empty(alloc), volume: os::VolumeCipher.Plain, as_of: 0)
} security_of

/// The record of `/live/machine` the measured facts `facts` give, the store's device not yet measured, on mains power.
fn machine_of(facts: Facts) -> os::Machine {
    let level = match facts.features.level {
        cpu::Level.X86v1 => os::Level.X86v1
        cpu::Level.X86v2 => os::Level.X86v2
        cpu::Level.X86v3 => os::Level.X86v3
        cpu::Level.X86v4 => os::Level.X86v4
    }
    let features = facts.features
    let conditions = os::Conditions(iommu: false, tpm: facts.conditions.tpm, secure_boot: facts.conditions.secure_boot, user_mode: false, invariant_tsc: features.invariant_tsc, tsc_deadline: features.tsc_deadline, pcid: features.pcid, pages_1g: features.pages_1g, mwait: features.mwait, watchdog: false, nic: false, meltdown_immune: features.meltdown_immune)
    return os::Machine(arch: os::Arch.Amd64, conditions: conditions, ram_bytes: facts.ram_bytes, cpus: facts.cpus, level: level, smt: features.smt, numa_nodes: facts.nodes, storage: os::Storage.File, power: os::PowerSource.Mains)
} machine_of

fn copy_of(bytes: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    var copied = mem::Bytes.empty(alloc)
    mut copied.append(bytes)
    return copied
} copy_of

/// An instance's record in `state`, reconciled as `reconciled`.
fn instance_record(state: os::Lifecycle, take reconciled: os::ReconcileState, alloc: mem::Alloc) -> os::LiveInstance {
    let durability = os::Durability(class: os::DurabilityClass.Volatile, epoch_s: None, max_bytes: 1_048_576)
    return os::LiveInstance(state: state, status: os::ReconcileStatus(state: take reconciled, desired: 0, since: ident::WallTime.unknown()), bundle: ident::HashValue(bytes: Array[u8, 33].filled(1)), space: text::String.of("shared", alloc), durability: durability, restarts: 0, fault: None, intake: 0, memory: os::Usage(charged: 0, limit: 65_536, peak: 0), cpu_ns: 0, reservation: None, probation: None, summary: None, as_of: 0)
} instance_record

validator fn running_of(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Array[u32, 2] {
    var counts = Array[u32, 2].filled(0)
    match attempt mem::wire::Codec[os::LiveStatus].decode(raw, alloc) {
        Ok(status) => {
            counts[0] = status.instances.running
            counts[1] = status.instances.failed
        }
        Err(_) => {
        }
    }
    return counts
} running_of

validator fn cpu_of(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[os::LiveCpu] {
    return match attempt mem::wire::Codec[os::LiveCpu].decode(raw, alloc) {
        Ok(found) => Some(take found)
        Err(_) => None
    }
} cpu_of

/// Requests no memory keeper takes.
fn unkept(alloc: mem::Alloc) -> task::Sender[MemoryRequest] {
    let task::Channel(sender: requests, receiver: dropped) = task::Channel[MemoryRequest].bounded(1, alloc)
    discard dropped
    return requests
} unkept

/// The scheduler's state for two CPUs of one core, both started.
fn two_cpus(clock: sys::Clock, alloc: mem::Alloc) -> mem::Shared[sched::State] {
    var places = mem::List[sched::Place].empty(alloc)
    for _ in 0..<2u32 {
        mut places.push(sched::Place(package_id: 0, core: 0, cache: 0, node: 0))
    }
    let state = mem::Shared.of(sched::State.of(take places, clock, idle_states: mem::List.empty(alloc), hwp: false, alloc), alloc)
    state.contents().start(1)
    return state
} two_cpus

test boards_list_what_providers_publish_and_compute_status_and_cpus for serve_board {
    let world = testing::world()
    let alloc = world.alloc
    let task::Channel(sender: posted, receiver: postings) = task::Channel[os::Posting].bounded(4, alloc)
    let origin = Origin(generation: 3, mode: os::BootMode.Dev, clock: world.clock, wall: ident::Wall(at: ident::WallTime.unknown(), since_ns: 0))
    let conditions = os::Conditions(iommu: false, tpm: false, secure_boot: false, user_mode: false, invariant_tsc: false, tsc_deadline: false, pcid: false, pages_1g: false, mwait: false, watchdog: false, nic: false, meltdown_immune: false)
    let machine = os::Machine(arch: os::Arch.Amd64, conditions: conditions, ram_bytes: 1, cpus: 1, level: os::Level.X86v1, smt: false, numa_nodes: 1, storage: os::Storage.File, power: os::PowerSource.Mains)
    let living = os::MintedLive.of(posted, own: "/live/store", alloc)
    defer take living.close()
    let live = living.mint()
    var given = Some(take postings)
    try await task::scope(world.exec, body: fn[mut given](s: task::Scope) fails task::Cancelled uses wait {
        let Some(board) = mut given.extract() else {
            return
        }
        discard s.spawn(fn[take board]() fails task::Cancelled uses wait limits stack 32_768 {
            try await serve_board(take board, origin, machine, security: security_of(bootfmt::Handoff.empty(), machine, alloc), cpus: two_cpus(world.clock, alloc), gauges: runner::Gauges.empty(alloc), memory: Counters(requests: unkept(alloc), alloc: alloc), exec: world.exec, alloc)
        })
        try await os::publish(posted, path: "/live/instances/a", type: "os::LiveInstance", value: instance_record(os::Lifecycle.Running, reconciled: os::ReconcileState.Converged, alloc), alloc)
        try await os::publish(posted, path: "/live/instances/b", type: "os::LiveInstance", value: instance_record(os::Lifecycle.Failed, reconciled: os::ReconcileState.Failed(code: text::String.of("trap.unreachable", alloc), detail: text::String.empty(alloc)), alloc), alloc)
        let top = try await live.list("/live", after: None, limit: 8, alloc)
        let instances = try await live.list("/live/instances", after: Some(text::String.of("a", alloc)), limit: 8, alloc)
        let Some(status) = try await live.get(LIVE_STATUS, alloc) else {
            expect false
            return
        }
        let counts = running_of(Untrusted.of(status.bytes.view()), alloc)
        let cpus = try await live.list(LIVE_CPUS, after: None, limit: 8, alloc)
        let second = try await live.get("/live/cpus/1", alloc)
        let beyond = try await live.get("/live/cpus/2", alloc)
        let accounts = try await live.list("/live/accounts", after: None, limit: 8, alloc)
        let account = try await live.get("/live/accounts/a", alloc)
        let Some(ungauged) = try await live.get("/live/instances/a", alloc) else {
            expect false
            return
        }
        let Some(published) = instance_of(Untrusted.of(ungauged.bytes.view()), alloc) else {
            expect false
            return
        }
        let memory = try await live.get(LIVE_MEMORY, alloc)
        expect top.len() == 7 and top[0].name.as_str() == "accounts" and top[0].parent and top[1].name.as_str() == "cpus" and top[2].name.as_str() == "instances" and top[2].parent and top[3].name.as_str() == "machine" and top[4].name.as_str() == "memory" and top[5].name.as_str() == "security" and top[6].name.as_str() == "status"
        expect memory.is_none()
        expect accounts.len() == 0 and account.is_none() and published.memory.limit == 65_536
        expect instances.len() == 1 and instances[0].name.as_str() == "b"
        expect counts[0] == 1 and counts[1] == 1
        expect cpus.len() == 2 and cpus[0].name.as_str() == "0" and cpus[1].name.as_str() == "1"
        expect beyond.is_none()
        let Some(record) = second else {
            expect false
            return
        }
        let Some(cpu) = cpu_of(Untrusted.of(record.bytes.view()), alloc) else {
            expect false
            return
        }
        expect cpu.online and cpu.siblings.len() == 1 and cpu.siblings[0] == 0 and cpu.run_queue == 0
        s.cancel()
    })
} boards_list_what_providers_publish_and_compute_status_and_cpus
