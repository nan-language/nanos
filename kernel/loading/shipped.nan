//! Bundles the generation ships beside the kernel image, which the core runs from their images.

/// A capability reading a bundle the generation ships: its code hash and its image.
pkg struct Shipped {
} Shipped

impl Shipped: sys::Kind[ShippedBundle, u8]

/// What the capability of a shipped bundle reaches: the bundle's code hash and its image.
struct ShippedBundle {
    code: ident::HashValue
    image: mem::Bytes
} ShippedBundle

/// The root entry of the capabilities of a shipped bundle, revoked when it closes.
pkg linear struct MintedShipped {
    minter: sys::Minter[Shipped, ShippedBundle, u8]
} MintedShipped

/// A root entry of the bundle whose image is `image`, its code hash the content hash of its bytes.
pkg fn MintedShipped.of(take image: mem::Bytes, alloc: mem::Alloc) -> MintedShipped {
    let code = ident::HashValue.of_content(image.view())
    return MintedShipped(minter: sys::Minter[Shipped, ShippedBundle, u8].of(ShippedBundle(code: code, image: take image), alloc))
} MintedShipped.of

pkg fn MintedShipped.mint(self) -> Shipped {
    return self.minter.mint(0)
} MintedShipped.mint

pkg fn MintedShipped.close(take self) {
    let MintedShipped(minter: minter) = self
    take minter.close()
} MintedShipped.close

/// The bundle's code hash, `None` once the capability is stale.
pkg fn Shipped.code(self) -> Option[ident::HashValue] {
    return sys::reach(self, body: fn(state: ShippedBundle, record: u8) => state.code)
} Shipped.code

/// A copy of the bundle's image drawn through `alloc`, `None` once the capability is stale.
pkg fn Shipped.image(self, alloc: mem::Alloc) -> Option[mem::Bytes] {
    return sys::reach(self, body: fn(state: ShippedBundle, record: u8) -> mem::Bytes {
        var copy = mem::Bytes.empty(alloc)
        mut copy.append(state.image.view())
        return copy
    })
} Shipped.image
