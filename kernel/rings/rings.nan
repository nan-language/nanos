//! The core rings: each CPU's ring of the events the core and the runner write, with interrupts disabled, for `journal` to drain, their kinds indexed as the journal package's kind table gives them.

/// The records of a ring: one 64 KiB chunk of the core reserve.
const RING_RECORDS: usize = 2_048

/// The severity of a `critical` record, which makes its ring due at once.
const CRITICAL: u8 = 5

/// How long a ring's oldest record waits before the ring is due.
const DUE_NS: u64 = 1_000_000_000

/// A ring: its records, where the next goes and where the oldest it holds is, how many it holds for the journal, how many found it full, and whether a quarter of it filled or a critical record entered it since it was last empty.
struct Ring {
    records: mem::List[journal::RingRecord]
    next: usize
    oldest: usize
    held: usize
    lost: u64
    due: bool
} Ring

/// The core rings, one per CPU by number, the running CPU's number, the clock their records are timed by, the signal writers post when the journal must look at the rings, the instance each slot of the runner's table names, the boot counter, the causes the core opened in this boot, its system cause first, and their principals.
pkg struct Rings {
    rings: mem::List[hw::SpinLock[Ring]]
    here: hw::PerCpu[u32]
    clock: sys::Clock
    signal: mem::Shared[hw::Signal[Unit]]
    sources: task::Cown[mem::Map[u32, ident::Moniker]]
    boot: u64
    causes: mem::Shared[core::atomic::AtomicU64]
    opened: journal::Principals
} Rings

impl Rings: runner::Journal

/// The rings of `cpus` CPUs in the boot of counter `boot`, drawn through `alloc`.
pkg fn Rings.of(cpus: u32, clock: sys::Clock, boot: u64, alloc: mem::Alloc) -> Rings {
    var rings = mem::List[hw::SpinLock[Ring]].empty(alloc)
    for _ in 0..<cpus {
        var records = mem::List[journal::RingRecord].empty(alloc)
        for _ in 0..<RING_RECORDS {
            mut records.push(journal::RingRecord.from_bits(Array[u8, 32].filled(0)))
        }
        mut rings.push(hw::SpinLock.of(Ring(records: take records, next: 0, oldest: 0, held: 0, lost: 0, due: false)))
    }
    return Rings(rings: take rings, here: hw::PerCpu.of(init: fn(cpu: u32) => cpu, alloc), clock: clock, signal: mem::Shared.of(hw::Signal[Unit].empty(), alloc), sources: task::Cown.of(mem::Map.empty(alloc), alloc), boot: boot, causes: mem::Shared.of(core::atomic::AtomicU64.of(1), alloc), opened: journal::Principals.empty(alloc))
} Rings.of

/// Notes that the slot `slot` names the instance `moniker`.
pkg fn Rings.name(self, slot: u32, take moniker: ident::Moniker) fails task::Cancelled uses wait {
    let sources = self.sources.share()
    var named = Some(take moniker)
    await when mut sources {
        match mut named.extract() {
            Some(given) => {
                discard mut sources.insert(slot, value: take given)
            }
            None => {
            }
        }
    }
} Rings.name

/// The monikers noted for the slots of the runner's table.
pkg fn Rings.monikers(self) -> task::Cown[mem::Map[u32, ident::Moniker]] {
    return self.sources.share()
} Rings.monikers

/// The instance the slot `slot` names, `supervisor` for the core's slot 0 and for a slot naming none.
pkg fn Rings.source_of(self, slot: u32) -> ident::Moniker fails task::Cancelled uses wait {
    let sources = self.sources.share()
    var named = text::Fixed[59].of("supervisor")
    await when sources {
        match sources.get(slot) {
            Some(moniker) => {
                named = moniker.text
            }
            None => {
            }
        }
    }
    return ident::Moniker(text: named)
} Rings.source_of

/// Writes the record of an event of the cause `cause`, and its continuation when it has one, in the running CPU's ring, counting the event lost when the ring has no room for it, and posts the signal when the journal must look at the ring.
pkg fn Rings.record(self, slot: u32, cause: u64, event: runner::Event) {
    self.write(journal::RingRecord(time: elapsed(self.clock), cause: cause, source: slot, kind: kind_of(event), severity: severity_of(event), flags: 0, argument: argument_of(event)), continuation: continuation_of(event))
} Rings.record

/// The principals of the causes the core opened.
pkg fn Rings.principals(self) -> journal::Principals {
    return self.opened.share()
} Rings.principals

/// Opens the start cause of the incarnation `incarnation` of the instance `moniker` of slot `slot` under the cause `parent`, noting its principal and writing its record, and gives it, traced when `parent` is; causes as a header holds them.
pkg fn Rings.open(self, slot: u32, moniker: ident::Moniker, incarnation: u64, parent: u64) -> u64 {
    let count = self.causes.contents().fetch_add(1).value_or(0) + 1
    let opened = ident::Cause.counted(self.boot, count)
    var principal = text::Fixed[64].of("inst.")
    mut principal.append(moniker.text.as_str())
    self.opened.note(opened, principal: ident::Principal(text: principal))
    let cause = os::Header.of_work(cause: parent, slot: slot).child(opened)
    var subject = Array[u8, 32].filled(0)
    for at in 0..<8usize {
        subject[at] = u8.truncate(incarnation >> u32.truncate(8 * at))
    }
    self.write(journal::RingRecord(time: elapsed(self.clock), cause: cause, source: slot, kind: journal::CauseKind.Start.number(), severity: 0, flags: journal::CAUSE_RECORD, argument: parent), continuation: Some(journal::RingRecord.from_bits(subject)))
    return cause
} Rings.open

/// Writes the record of the span of a handler call of the instance of slot `slot`.
pkg fn Rings.span(self, slot: u32, span: runner::Span) {
    var operation = Array[u8, 20].filled(0)
    var at: usize = 0
    for byte in span.operation.as_str().as_bytes() {
        if at == operation.len() {
            break
        }
        operation[at] = byte
        at += 1
    }
    let call = journal::SpanDetail(wait_ns: span.wait_ns, sender: span.sender, operation: operation)
    self.write(journal::RingRecord(time: span.start_ns, cause: span.cause, source: slot, kind: journal::trap_number(span.trapped), severity: 0, flags: journal::SPAN_RECORD, argument: span.run_ns), continuation: Some(journal::RingRecord.from_bits(call.to_bits())))
} Rings.span

/// Writes the record of a device event as the core's, its continuation holding the device's bus path.
pkg fn Rings.record_device(self, event: devices::Event) {
    var payload = Array[u8, 32].filled(0)
    let path = event.path.text()
    var at: usize = 0
    for byte in path.as_bytes() {
        payload[at] = byte
        at += 1
    }
    self.write(journal::RingRecord(time: elapsed(self.clock), cause: 0, source: 0, kind: device_kind(event.kind), severity: device_severity(event.kind), flags: 0, argument: event.argument), continuation: Some(journal::RingRecord.from_bits(payload)))
} Rings.record_device

/// Writes the record of an event of the store as the core's: its argument is the log bytes a mount replayed, the address of a corrupt structure, the commits thinned, or the free bytes when writes are refused.
pkg fn Rings.record_store(self, event: store::Event) {
    let kind = match event {
        store::Event.Mounted(format: _, replayed: _) => journal::STORE_MOUNTED
        store::Event.Corruption(address: _, kind: _) => journal::STORE_CORRUPTION
        store::Event.DeviceFailed => journal::STORE_DEVICE_FAILED
        store::Event.HistoryThinned(commits: _, bytes: _, oldest: _) => journal::STORE_HISTORY_THINNED
        store::Event.WritesRefused(free: _, history: _) => journal::STORE_WRITES_REFUSED
    }
    let severity: u8 = match event {
        store::Event.Mounted(format: _, replayed: _) => 1
        store::Event.HistoryThinned(commits: _, bytes: _, oldest: _) => 2
        store::Event.WritesRefused(free: _, history: _) => 3
        store::Event.Corruption(address: _, kind: _) => 4
        store::Event.DeviceFailed => 5
    }
    let argument = match event {
        store::Event.Mounted(format: _, replayed: replayed) => replayed
        store::Event.Corruption(address: address, kind: _) => address
        store::Event.DeviceFailed => 0
        store::Event.HistoryThinned(commits: commits, bytes: _, oldest: _) => commits
        store::Event.WritesRefused(free: free, history: _) => free
    }
    self.write(journal::RingRecord(time: elapsed(self.clock), cause: 0, source: 0, kind: kind, severity: severity, flags: 0, argument: argument), continuation: None)
} Rings.record_store

/// Writes `boot.started` and one `boot.candidate-failed` per failure entry of `handoff` as the core's.
pkg fn Rings.record_boot(self, handoff: bootfmt::Handoff) {
    var started = Array[u8, 32].filled(0)
    started[0] = handoff.mode
    started[1] = handoff.slot
    let flags = handoff.flags.to_bits()
    var at: usize = 0
    while at < 8 {
        if at < 4 {
            started[4 + at] = u8.truncate(flags >> u32.truncate(8 * at))
        }
        started[8 + at] = u8.truncate(handoff.boot_counter >> u32.truncate(8 * at))
        at += 1
    }
    self.write(journal::RingRecord(time: elapsed(self.clock), cause: 0, source: 0, kind: journal::BOOT_STARTED, severity: 1, flags: 0, argument: handoff.generation), continuation: Some(journal::RingRecord.from_bits(started)))
    for entry in 0..<usize.widen(handoff.failure_count) {
        if entry >= handoff.failures.len() {
            break
        }
        let failure = handoff.failures[entry]
        var code = Array[u8, 32].filled(0)
        for index in 0..<failure.code.len() {
            code[index] = failure.code[index]
        }
        self.write(journal::RingRecord(time: elapsed(self.clock), cause: 0, source: 0, kind: journal::BOOT_CANDIDATE_FAILED, severity: 3, flags: 0, argument: failure.generation), continuation: Some(journal::RingRecord.from_bits(code)))
    }
} Rings.record_boot

fn Rings.write(self, record: journal::RingRecord, continuation: Option[journal::RingRecord]) {
    var written = record
    if continuation.is_some() {
        written.flags = written.flags | journal::CONTINUED
    }
    hw::without_irqs(fn(t: hw::IrqsDisabled) limits notrap, terminates {
        let cpu = self.here.with(t, body: fn(mut number: u32) -> u32 limits notrap, terminates, noalloc {
            return number
        })
        let Some(ring) = self.rings.get(usize.widen(cpu)) else {
            return
        }
        let wake = ring.with(t, body: fn(mut held: Ring) -> bool limits notrap, terminates, noalloc {
            return mut held.write(written, continuation)
        })
        if wake {
            self.signal.contents().post(t, value: Unit)
        }
    })
} Rings.write

/// Waits until a ring is due, a quarter full, holding a critical record or holding a record 1 s old, and gives its CPU's number; while every ring is empty it waits for a write alone. The tasks of `exec` race the signal against the clock.
pkg fn Rings.due(self, exec: task::Executor) -> u32 fails task::Cancelled uses wait {
    loop {
        let now = elapsed(self.clock)
        var earliest: Option[u64] = None
        for cpu in 0..<self.rings.len() {
            let Some(at) = self.due_at(cpu) else {
                continue
            }
            if at <= now {
                return u32.fit(cpu)
            }
            match earliest {
                Some(sooner) => {
                    if at < sooner {
                        earliest = Some(at)
                    }
                }
                None => {
                    earliest = Some(at)
                }
            }
        }
        match earliest {
            Some(at) => {
                let signal = self.signal.share()
                let clock = self.clock
                try await task::race(exec, left: fn[take signal]() fails task::Cancelled uses wait limits stack 4_096 {
                    try await signal.contents().wait()
                }, right: fn() fails task::Cancelled uses wait limits stack 4_096 {
                    try await clock.sleep_ns(at - now)
                })
            }
            None => try await self.signal.contents().wait()
        }
    }
} Rings.due

/// Moves the records `cpu`'s ring holds into `into`, oldest first, each event's continuation after it, and gives how many events found it full since its last drain.
pkg fn Rings.drain(self, cpu: u32, mut into: mem::List[journal::RingRecord]) -> u64 {
    let Some(ring) = self.rings.get(usize.widen(cpu)) else {
        return 0
    }
    let count = hw::without_irqs(fn(t: hw::IrqsDisabled) -> usize limits notrap, terminates {
        return ring.with(t, body: fn(mut held: Ring) -> usize limits notrap, terminates, noalloc {
            return held.held
        })
    })
    for _ in 0..<count {
        let taken = hw::without_irqs(fn(t: hw::IrqsDisabled) -> Option[journal::RingRecord] limits notrap, terminates {
            return ring.with(t, body: fn(mut held: Ring) -> Option[journal::RingRecord] limits notrap, terminates, noalloc {
                return mut held.pop()
            })
        })
        let Some(record) = taken else {
            break
        }
        mut into.push(record)
    }
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> u64 limits notrap, terminates {
        return ring.with(t, body: fn(mut held: Ring) -> u64 limits notrap, terminates, noalloc {
            let lost = held.lost
            held.lost = 0
            return lost
        })
    })
} Rings.drain

/// When the ring `cpu` is due, in nanoseconds of the clock: 0 when it is due at once, `None` when it holds no record.
fn Rings.due_at(self, cpu: usize) -> Option[u64] {
    let Some(ring) = self.rings.get(cpu) else {
        return None
    }
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> Option[u64] limits notrap, terminates {
        return ring.with(t, body: fn(mut held: Ring) -> Option[u64] limits notrap, terminates, noalloc {
            return held.due_at()
        })
    })
} Rings.due_at

/// Writes `record` and its continuation, counting the event lost when the ring has no room for both; whether the journal must look at the ring: the event entered it empty, filled a quarter of it, or is critical.
fn Ring.write(mut self, record: journal::RingRecord, continuation: Option[journal::RingRecord]) -> bool limits notrap, terminates, noalloc {
    let size = self.records.len()
    let needed: usize = match continuation {
        Some(_) => 2
        None => 1
    }
    if needed > size or self.held > size - needed {
        self.lost = self.lost.saturating_add(1)
        return false
    }
    let before = self.held
    mut self.put(record)
    match continuation {
        Some(more) => mut self.put(more)
        None => {
        }
    }
    if (before < size / 4 and self.held >= size / 4) or record.severity == CRITICAL {
        self.due = true
        return true
    }
    return before == 0
} Ring.write

/// Writes `record` after the newest record, when the ring has room for it.
fn Ring.put(mut self, record: journal::RingRecord) limits notrap, terminates, noalloc {
    let size = self.records.len()
    if self.held >= size or self.next >= size {
        return
    }
    self.records[self.next] = record
    var next = self.next + 1
    if next == size {
        next = 0
    }
    self.next = next
    self.held += 1
} Ring.put

/// Takes the oldest record the ring holds; a ring holding none is no longer due.
fn Ring.pop(mut self) -> Option[journal::RingRecord] limits notrap, terminates, noalloc {
    let size = self.records.len()
    if self.held == 0 or self.oldest >= size {
        return None
    }
    let record = self.records[self.oldest]
    var oldest = self.oldest + 1
    if oldest == size {
        oldest = 0
    }
    self.oldest = oldest
    self.held -= 1
    if self.held == 0 {
        self.due = false
    }
    return Some(record)
} Ring.pop

/// When the ring is due: 0 when it is due at once, else 1 s after its oldest record, `None` when it holds none.
fn Ring.due_at(self) -> Option[u64] limits notrap, terminates, noalloc {
    if self.held == 0 or self.oldest >= self.records.len() {
        return None
    }
    if self.due {
        return Some(0)
    }
    return Some(self.records[self.oldest].time.saturating_add(DUE_NS))
} Ring.due_at

/// The continuation of an event that has more payload than its record holds: the reason of an `auth.revoked`, the checkpoint an `instance.started` restored, the code of an `instance.checkpoint-failed`, the trap kind of an `instance.trapped`.
fn continuation_of(event: runner::Event) -> Option[journal::RingRecord] {
    var payload = Array[u8, 32].filled(0)
    match event {
        runner::Event.Revoked(grant: _, reason: reason) => {
            payload[0] = match reason {
                runner::Reason.Revoke => 0
                runner::Reason.Expiry => 1
            }
        }
        runner::Event.Started(incarnation: _, checkpoint: Some(number)) => {
            var at: usize = 0
            while at < 8 {
                payload[at] = u8.truncate(number >> u32.truncate(8 * at))
                at += 1
            }
        }
        runner::Event.CheckpointFailed(code: code, bytes: _) => {
            var at: usize = 0
            for byte in code.as_bytes() {
                payload[at] = byte
                at += 1
            }
        }
        runner::Event.Trapped(incarnation: _, kind: kind, limit: _) => {
            var at: usize = 0
            for byte in journal::trap_code(kind).as_bytes() {
                payload[at] = byte
                at += 1
            }
        }
        else => return None
    }
    return Some(journal::RingRecord.from_bits(payload))
} continuation_of

/// Appends the decimal digits of `value` to `text`.
pkg fn push_decimal[N: usize where N > 0](mut text: text::Fixed[N], value: u64) {
    var digits = Array[u8, 20].filled(0)
    var count: usize = 0
    var rest = value
    loop {
        digits[count] = u8.truncate(rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 or count == 20 {
            break
        }
    }
    while count > 0 {
        count -= 1
        mut text.push(char.checked_from_bits(0x30 + u32.widen(digits[count])).value_or('0'))
    }
} push_decimal

/// What the continuation of a record of kind `kind` adds: the reason of an `auth.revoked`, the bus path of a device event, the checkpoint an `instance.started` restored, the boot counter of a `boot.started`, the code of an `instance.checkpoint-failed`, an `instance.trapped` or a `boot.candidate-failed`.
pkg fn detail(kind: u16, continuation: journal::RingRecord) -> text::Fixed[40] {
    if kind == journal::STARTED {
        var restored = text::Fixed[40].of("checkpoint ")
        let bytes = continuation.to_bits()
        var number: u64 = 0
        var at: usize = 0
        while at < 8 {
            number = number | (u64.widen(bytes[at]) << u32.truncate(8 * at))
            at += 1
        }
        push_decimal(mut restored, value: number)
        return restored
    }
    if kind == journal::BOOT_STARTED {
        var counted = text::Fixed[40].of("counter ")
        let bytes = continuation.to_bits()
        var number: u64 = 0
        var at: usize = 16
        while at > 8 {
            at -= 1
            number = (number << 8) | u64.widen(bytes[at])
        }
        push_decimal(mut counted, value: number)
        return counted
    }
    if kind == journal::CHECKPOINT_FAILED or kind == journal::TRAPPED or kind == journal::BOOT_CANDIDATE_FAILED {
        var code = text::Fixed[40].of("code ")
        for byte in continuation.to_bits() {
            if byte == 0 {
                break
            }
            mut code.push(char.checked_from_bits(u32.widen(byte)).value_or('?'))
        }
        return code
    }
    if kind >= journal::DEVICE_ADDED and kind <= journal::DEVICE_INTERRUPT_STORM {
        var path = text::Fixed[40].of("path ")
        for byte in continuation.to_bits() {
            if byte == 0 {
                break
            }
            mut path.push(char.checked_from_bits(u32.widen(byte)).value_or('?'))
        }
        return path
    }
    if kind != journal::REVOKED {
        return text::Fixed[40].empty()
    }
    return text::Fixed[40].of(match continuation.to_bits()[0] {
        0 => "reason revoke"
        1 => "reason expiry"
        else => "reason unknown"
    })
} detail

fn device_kind(kind: devices::EventKind) -> u16 {
    return match kind {
        devices::EventKind.Added => journal::DEVICE_ADDED
        devices::EventKind.Removed => journal::DEVICE_REMOVED
        devices::EventKind.TableInvalid => journal::DEVICE_TABLE_INVALID
        devices::EventKind.Bound => journal::DEVICE_BOUND
        devices::EventKind.Unbound => journal::DEVICE_UNBOUND
        devices::EventKind.CutOff => journal::DEVICE_CUT_OFF
        devices::EventKind.Failed => journal::DEVICE_FAILED
        devices::EventKind.Suspended => journal::DEVICE_SUSPENDED
        devices::EventKind.Resumed => journal::DEVICE_RESUMED
        devices::EventKind.InterruptStorm => journal::DEVICE_INTERRUPT_STORM
    }
} device_kind

/// A device event's severity: `info` for the topology and bindings, `notice` for cut-offs, `warn` for invalid tables, `error` for failures and storms.
fn device_severity(kind: devices::EventKind) -> u8 {
    return match kind {
        devices::EventKind.CutOff => 2
        devices::EventKind.TableInvalid => 3
        devices::EventKind.Failed or devices::EventKind.InterruptStorm => 4
        else => 1
    }
} device_severity

/// The clock's reading in nanoseconds, 0 once it is revoked.
pkg fn elapsed(clock: sys::Clock) -> u64 {
    return match attempt clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
} elapsed

/// The index of an event's kind in the kernel image's kind table.
fn kind_of(event: runner::Event) -> u16 {
    return match event {
        runner::Event.Started(incarnation: _, checkpoint: _) => journal::STARTED
        runner::Event.Stopped(abandoned: _) => journal::STOPPED
        runner::Event.Trapped(incarnation: _, kind: _, limit: _) => journal::TRAPPED
        runner::Event.Failed(restarts: _) => journal::FAILED
        runner::Event.SlowHandler(ns: _) => journal::SLOW_HANDLER
        runner::Event.Integrity(incarnation: _) => journal::INTEGRITY
        runner::Event.Revoked(grant: _, reason: _) => journal::REVOKED
        runner::Event.CheckpointFailed(code: _, bytes: _) => journal::CHECKPOINT_FAILED
    }
} kind_of

/// An event's severity: 0 for `debug` up to 5 for `critical`.
fn severity_of(event: runner::Event) -> u8 {
    return match event {
        runner::Event.Started(incarnation: _, checkpoint: _) or runner::Event.Stopped(abandoned: _) => 1
        runner::Event.Revoked(grant: _, reason: _) => 2
        runner::Event.SlowHandler(ns: _) or runner::Event.CheckpointFailed(code: _, bytes: _) => 3
        runner::Event.Trapped(incarnation: _, kind: _, limit: _) or runner::Event.Failed(restarts: _) => 4
        runner::Event.Integrity(incarnation: _) => 5
    }
} severity_of

/// The first 8 bytes of an event's payload.
fn argument_of(event: runner::Event) -> u64 {
    return match event {
        runner::Event.Started(incarnation: incarnation, checkpoint: _) => incarnation
        runner::Event.Stopped(abandoned: true) => 1
        runner::Event.Stopped(abandoned: false) => 0
        runner::Event.Trapped(incarnation: incarnation, kind: _, limit: _) => incarnation
        runner::Event.Failed(restarts: restarts) => u64.widen(restarts)
        runner::Event.SlowHandler(ns: ns) => ns
        runner::Event.Integrity(incarnation: incarnation) => incarnation
        runner::Event.Revoked(grant: grant, reason: _) => grant
        runner::Event.CheckpointFailed(code: _, bytes: bytes) => bytes
    }
} argument_of

test rings_wake_the_journal_and_count_what_they_drop for Ring.write {
    let alloc = testing::world().alloc
    var records = mem::List[journal::RingRecord].empty(alloc)
    for _ in 0..<8u32 {
        mut records.push(journal::RingRecord.from_bits(Array[u8, 32].filled(0)))
    }
    var ring = Ring(records: take records, next: 0, oldest: 0, held: 0, lost: 0, due: false)
    var woke = Array[bool, 10].filled(false)
    for at in 0..<10usize {
        woke[at] = mut ring.write(journal::RingRecord(time: 1, cause: 0, source: 3, kind: 0, severity: 1, flags: 0, argument: u64.widen(at)), continuation: None)
    }
    expect woke[0] and woke[1] and not woke[2] and not woke[7] and not woke[9]
    expect ring.held == 8 and ring.lost == 2 and ring.next == 0 and ring.due
    var taken = mem::List[u64].empty(alloc)
    for _ in 0..<3u32 {
        let Some(record) = mut ring.pop() else {
            break
        }
        mut taken.push(record.argument)
    }
    for at in 10..<13u64 {
        discard mut ring.write(journal::RingRecord(time: 1, cause: 0, source: 3, kind: 0, severity: 1, flags: 0, argument: at), continuation: None)
    }
    loop {
        let Some(record) = mut ring.pop() else {
            break
        }
        mut taken.push(record.argument)
    }
    expect taken.len() == 11 and taken[0] == 0 and taken[2] == 2 and taken[3] == 3 and taken[7] == 7 and taken[8] == 10 and taken[10] == 12
    expect ring.held == 0 and not ring.due and ring.due_at().is_none()
} rings_wake_the_journal_and_count_what_they_drop

test rings_fall_due_a_quarter_full_on_critical_records_or_a_second_after_their_oldest for Rings.due {
    let world = testing::world()
    let alloc = world.alloc
    let cpus = hw::cpu_count()
    let rings = Rings.of(cpus, clock: world.clock, boot: 1, alloc)
    rings.record(slot: 1, cause: 0, event: runner::Event.Started(incarnation: 1, checkpoint: None))
    let early = try await task::within(world.clock, ms: 500, body: fn() -> u32 fails task::Cancelled uses wait {
        return try await rings.due(world.exec)
    })
    let aged = try await rings.due(world.exec)
    var records = mem::List[journal::RingRecord].empty(alloc)
    let lost = rings.drain(aged, into: mut records)
    expect early.is_none()
    expect lost == 0 and records.len() == 1 and records[0].source == 1
    let quarters = (RING_RECORDS / 4) * usize.widen(cpus)
    for _ in 0..<quarters {
        rings.record(slot: 2, cause: 0, event: runner::Event.Started(incarnation: 1, checkpoint: None))
    }
    let quarter = try await task::within(world.clock, ms: 100, body: fn() -> u32 fails task::Cancelled uses wait {
        return try await rings.due(world.exec)
    })
    for cpu in 0..<cpus {
        discard rings.drain(cpu, into: mut records)
    }
    rings.record(slot: 3, cause: 0, event: runner::Event.Integrity(incarnation: 1))
    let urgent = try await task::within(world.clock, ms: 100, body: fn() -> u32 fails task::Cancelled uses wait {
        return try await rings.due(world.exec)
    })
    expect quarter.is_some()
    let Some(cpu) = urgent else {
        expect false
        return
    }
    var last = mem::List[journal::RingRecord].empty(alloc)
    discard rings.drain(cpu, into: mut last)
    expect last.len() == 1 and last[0].severity == CRITICAL
} rings_fall_due_a_quarter_full_on_critical_records_or_a_second_after_their_oldest

test continuations_name_the_checkpoint_restored_and_the_code_of_a_failed_one for detail {
    expect continuation_of(runner::Event.Started(incarnation: 4, checkpoint: None)).is_none()
    let Some(restored) = continuation_of(runner::Event.Started(incarnation: 4, checkpoint: Some(1_234))) else {
        expect false
        return
    }
    expect detail(kind: journal::STARTED, continuation: restored).as_str() == "checkpoint 1234"
    let Some(too_large) = continuation_of(runner::Event.CheckpointFailed(code: text::Fixed[32].of("instance.checkpoint-too-large"), bytes: 9)) else {
        expect false
        return
    }
    expect detail(kind: journal::CHECKPOINT_FAILED, continuation: too_large).as_str() == "code instance.checkpoint-too-large"
} continuations_name_the_checkpoint_restored_and_the_code_of_a_failed_one

test boots_give_their_start_and_each_failed_candidate for Rings.record_boot {
    let world = testing::world()
    let alloc = world.alloc
    let cpus = hw::cpu_count()
    let rings = Rings.of(cpus, clock: world.clock, boot: 1, alloc)
    var handoff = bootfmt::Handoff.empty()
    handoff.generation = 7
    handoff.boot_counter = 0x1_0203
    handoff.mode = bootfmt::Mode.Trial.to_bits()
    handoff.slot = bootfmt::Slot.B.to_bits()
    handoff.failure_count = 1
    var code = Array[u8, 24].filled(0)
    let named = "boot.hash-mismatch".as_bytes()
    for at in 0..<named.len() {
        code[at] = named[at]
    }
    var failures = handoff.failures
    failures[0] = bootfmt::Failure(generation: 6, code: code)
    handoff.failures = failures
    rings.record_boot(handoff)
    var records = mem::List[journal::RingRecord].empty(alloc)
    for cpu in 0..<cpus {
        discard rings.drain(cpu, into: mut records)
    }
    expect records.len() == 4
    let system = ident::Cause.of(boot: 1, number: 1)
    let started = journal::CoreRecord(record: records[0], more: single(records[1], alloc), source: ident::Moniker(text: text::Fixed[59].of("supervisor")), sender: None).event(system, alloc)
    let failed = journal::CoreRecord(record: records[2], more: single(records[3], alloc), source: ident::Moniker(text: text::Fixed[59].of("supervisor")), sender: None).event(system, alloc)
    let Ok(boot) = attempt mem::wire::Codec[journal::BootStarted].decode(Untrusted.of(started.payload.bytes.view()), alloc) else {
        expect false
        return
    }
    expect started.kind.as_str() == "boot.started" and boot.generation == 7 and boot.boot_counter == 0x1_0203 and boot.mode == bootfmt::Mode.Trial.to_bits() and boot.slot == bootfmt::Slot.B.to_bits()
    expect failed.kind.as_str() == "boot.candidate-failed" and failed.severity == journal::Severity.Warn and records[2].argument == 6
    expect detail(kind: journal::BOOT_STARTED, continuation: records[1]).as_str() == "counter 66051"
    expect detail(kind: journal::BOOT_CANDIDATE_FAILED, continuation: records[3]).as_str() == "code boot.hash-mismatch"
} boots_give_their_start_and_each_failed_candidate

test start_causes_open_under_their_parent_and_spans_name_their_call for Rings.open {
    let world = testing::world()
    let alloc = world.alloc
    let cpus = hw::cpu_count()
    let rings = Rings.of(cpus, clock: world.clock, boot: 5, alloc)
    let system = ident::Cause.of(boot: 5, number: 1)
    let traced = system.bits | 0x8000_0000_0000_0000
    let fat = ident::Moniker(text: text::Fixed[59].of("fat"))
    let fat_cause = rings.open(slot: 3, moniker: ident::Moniker(text: fat.text), incarnation: 2, parent: traced)
    let store_cause = rings.open(slot: 4, moniker: ident::Moniker(text: text::Fixed[59].of("store")), incarnation: 1, parent: 0)
    rings.span(slot: 3, span: runner::Span(cause: fat_cause, start_ns: 10, wait_ns: 4, run_ns: 6, sender: 4, operation: text::Fixed[20].of("read"), trapped: Some(sys::TrapKind.Bounds)))
    var records = mem::List[journal::RingRecord].empty(alloc)
    for cpu in 0..<cpus {
        discard rings.drain(cpu, into: mut records)
    }
    expect records.len() == 6
    let wall = ident::Wall(at: ident::WallTime(utc_ns: 1_000, uncertainty_ns: 0), since_ns: 0)
    let Some(journal::TraceRecord.Cause(opened)) = journal::CoreRecord(record: records[0], more: single(records[1], alloc), source: ident::Moniker(text: fat.text), sender: None).trace(system, wall, alloc) else {
        expect false
        return
    }
    let Some(journal::TraceRecord.Span(span)) = journal::CoreRecord(record: records[4], more: single(records[5], alloc), source: ident::Moniker(text: fat.text), sender: Some(ident::Moniker(text: text::Fixed[59].of("store")))).trace(system, wall, alloc) else {
        expect false
        return
    }
    let principal = rings.principals().of(ident::Cause.of(boot: 5, number: 2), system)
    expect fat_cause == (ident::Cause.of(boot: 5, number: 2).bits | 0x8000_0000_0000_0000) and store_cause == ident::Cause.of(boot: 5, number: 3).bits
    expect opened.parent == Some(system) and opened.subject.as_str() == "fat 2" and principal.text.as_str() == "inst.fat"
    expect span.operation.as_str() == "read" and span.wait_ns == 4 and span.run_ns == 6 and records[5].to_bits()[8] == 4 and not records[4].is_event()
} start_causes_open_under_their_parent_and_spans_name_their_call

fn single(record: journal::RingRecord, alloc: mem::Alloc) -> mem::List[journal::RingRecord] {
    var list = mem::List[journal::RingRecord].empty(alloc)
    mut list.push(record)
    return list
} single
