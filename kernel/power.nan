//! Power off and reboot as the core carries them out: through the sandbox's exit port.

const EXIT_PORT: u16 = 0xF4

/// The bytes the exit port takes for a power off and a reboot.
const OFF: u8 = 0

const REBOOT: u8 = 2

registers ExitPort {
    status: u8 at 0x0 write
} ExitPort

/// Carries out each power off or reboot `orders` brings, for as long as they come.
fn switch_power(take orders: task::Receiver[power::Switching]) fails task::Cancelled uses wait {
    var receiver = orders
    loop {
        let Some(switching) = try await mut receiver.receive() else {
            return
        }
        var port = trusted "the exit port is I/O port 0xF4, which the sandbox decodes and the core maps nowhere else" { hw::Ports[ExitPort].map(port: EXIT_PORT) }
        mut port.write(ExitPort.status, value: match switching {
            power::Switching.Off => OFF
            power::Switching.Reboot => REBOOT
        })
        take port.unmap()
    }
} switch_power
