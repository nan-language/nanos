//! The NaN OS kernel: the core's entry and start sequence.

/// Copies of the firmware tables the start reads and of those `devices` reads, taken before the shared space replaces the entry root that maps them.
struct Tables {
    madt: Option[Untrusted[mem::Bytes]]
    fadt: Option[Untrusted[mem::Bytes]]
    srat: Option[Untrusted[mem::Bytes]]
    copies: mem::List[keeper::Table]
} Tables

/// The start sequence: each step that fails halts the kernel with its code. The first task starts every other CPU, prints the start line, then runs the base instances of the image's genesis record.
fn main(take k: boot::Kernel) -> Never limits stack 65_536 {
    let Some(cpu) = mut k.ring0() else {
        expect false
        loop {
        }
    }
    let alloc = k.alloc()
    let source = random::Source.empty(alloc)
    var modules = mut k.modules()
    let Some(handoff) = read_handoff(modules, source) else {
        halt(code: "fault.handoff-invalid", subject: "handoff")
    }
    let features = cpu::Features.read(cpu)
    let tables = Tables(madt: k.acpi_table(acpi::Signature.Madt.bytes(), alloc), fadt: k.acpi_table(acpi::Signature.Fadt.bytes(), alloc), srat: k.acpi_table(acpi::Signature.Srat.bytes(), alloc), copies: device_tables(k, alloc))
    var regions = mut k.regions()
    for module in take modules {
        insert_region(mut regions, region: take module.into_region())
    }
    let extents = extents_of(regions, alloc)
    let nodes = cpu::Nodes.of(srat_of(tables.srat, alloc), alloc)
    let cpus = hw::cpu_count()
    let Some(plan) = frames::Plan.of(extents.view(), nodes, cpus, alloc) else {
        halt(code: "fault.memory-insufficient", subject: "frames")
    }
    let ram = plan.ram
    var memory = frames::Memory.build(take regions, plan, scratch: alloc)
    let core = memory.core.alloc()
    let Some(shared) = spaces::Shared.build(extents.view(), features, cpus, frames: mut memory.frames, alloc: core) else {
        halt(code: "fault.memory-insufficient", subject: "shared-space")
    }
    let low = shared.low_memory()
    var roots = take shared.into_roots()
    cpu::enable(cpu, features)
    spaces::install(cpu, root: mut roots.remove(0))
    let Some(madt) = tables.madt else {
        halt(code: "fault.firmware-tables-invalid", subject: "MADT")
    }
    if not (attempt acpi::check_madt(madt.view())).is_ok() {
        halt(code: "fault.firmware-tables-invalid", subject: "MADT")
    }
    let isa = acpi::isa_routes(madt.view())
    if not valid(tables.fadt, check: acpi::check_fadt) {
        halt(code: "fault.firmware-tables-invalid", subject: "FADT")
    }
    let clock = k.clock()
    let wall = start_wall(tables.fadt, clock)
    let state = mem::Shared.of(sched::State.of(places_of(features, nodes, cpus, alloc: core), clock, alloc: core), alloc: core)
    mut k.policy(sched::Scheduler.of(state.share()))
    let facts = Facts(cpus: cpus, nodes: nodes.count(), ram_bytes: ram, features: features, conditions: handoff.conditions)
    let bundle = ident::HashValue(bytes: handoff.kernel_hash)
    let known = image_genesis(bundle, alloc: core)
    let functions = mut k.pci_functions()
    let ports = mut k.pci_ports()
    let Tables(madt: _, fadt: _, srat: _, copies: copies) = tables
    let keeper = keeper::Keeper.of(take functions, take ports, tables: take copies, source: source.share(), alloc: core)
    let drawing = random::Drawing.of(take source, alloc: core)
    let Ok(drawn) = attempt drawing.random() else {
        expect false
        loop {
        }
    }
    let rings = journal::Rings.of(cpus, clock, alloc: core)
    take k.anchor(Unit, run: fn[take cpu, take roots, take memory, take state, take known, take keeper, take rings](exec: task::Executor) fails task::Cancelled uses wait limits stack 65_536 {
        discard attempt await start_cpus(cpu, take roots, features, state, frames: mut memory.frames, exec)
        state.contents().all_started()
        discard attempt await low.release(cpu)
        report_start(facts, memory)
        let Some(pool) = memory.pools.get(0) else {
            halt(code: "fault.memory-insufficient", subject: "pools")
        }
        let config = runner::Config(exec: exec, pool: pool.alloc(), alloc: core, clock: clock, wall: wall, random: drawn, classes: sched::classes())
        discard attempt await run_base(take known, take keeper, bundle, boot: devices::BootVolume(scheme: handoff.volume_scheme, partition: handoff.volume_partition, signature: handoff.volume_signature), isa, config, rings, frames: mut memory.frames)
        let parked = hw::Signal[Unit].empty()
        loop {
            discard attempt await parked.wait()
        }
    })
} main

/// Copies of the tables `devices` reads: the DSDT and the SSDT, which hold the AML namespace, and the SPCR, which names the console UART.
fn device_tables(k: boot::Kernel, alloc: mem::Alloc) -> mem::List[keeper::Table] {
    var tables = mem::List[keeper::Table].empty(alloc)
    copy_table(k, signature: acpi::Signature.Dsdt, mut tables, alloc)
    copy_table(k, signature: acpi::Signature.Ssdt, mut tables, alloc)
    copy_table(k, signature: acpi::Signature.Spcr, mut tables, alloc)
    return tables
} device_tables

/// Appends a copy of the table of `signature` to `tables` when the firmware has one.
fn copy_table(k: boot::Kernel, signature: acpi::Signature, mut tables: mem::List[keeper::Table], alloc: mem::Alloc) {
    match k.acpi_table(signature.bytes(), alloc) {
        Some(bytes) => mut tables.push(keeper::Table.of(signature.bytes(), take bytes))
        None => {
        }
    }
} copy_table

/// The handoff record, module 0 of the start information, decoded through its validator, its entropy, when it holds some, mixed into `source` and then overwritten.
fn read_handoff(modules: mem::List[boot::Module], source: random::Source) -> Option[bootfmt::Handoff] {
    let Some(module) = modules.get(0) else {
        return None
    }
    let read = attempt bootfmt::Handoff.read(module.contents())
    let Ok(record) = read else {
        return None
    }
    var handoff = record
    if handoff.flags.entropy {
        source.mix(handoff.entropy.view())
    }
    handoff.entropy = Array[u8, 64].filled(0)
    return Some(handoff)
} read_handoff

/// Inserts `region` into `regions` in address order.
fn insert_region(mut regions: mem::List[hw::Region], take region: hw::Region) {
    var at: usize = 0
    while at < regions.len() and regions[at].base() < region.base() {
        at += 1
    }
    mut regions.insert(at, value: take region)
} insert_region

fn extents_of(regions: mem::List[hw::Region], alloc: mem::Alloc) -> mem::List[frames::Extent] {
    var extents = mem::List[frames::Extent].empty(alloc)
    for region in regions {
        mut extents.push(frames::Extent(base: region.base(), end: region.base() + region.byte_len()))
    }
    return extents
} extents_of

/// The SRAT when the firmware has one and it passes its validator.
fn srat_of(raw: Option[Untrusted[mem::Bytes]], alloc: mem::Alloc) -> Option[acpi::Srat] {
    let Some(bytes) = raw else {
        return None
    }
    let Ok(srat) = attempt acpi::Srat.read(bytes.view(), alloc) else {
        return None
    }
    return Some(take srat)
} srat_of

/// Whether a table is present and passes `check`.
fn valid(raw: Option[Untrusted[mem::Bytes]], check: fn(raw: Untrusted[Slice[u8]]) fails acpi::TableError) -> bool {
    let Some(bytes) = raw else {
        return false
    }
    return (attempt check(bytes.view())).is_ok()
} valid

/// Where each CPU lies: the last-level cache its APIC id names and its NUMA node.
fn places_of(features: cpu::Features, nodes: cpu::Nodes, cpus: u32, alloc: mem::Alloc) -> mem::List[sched::Place] {
    var places = mem::List[sched::Place].empty(alloc)
    for number in 0..<cpus {
        let apic_id = hw::cpu_hardware_id(number).value_or(0)
        mut places.push(sched::Place(cache: apic_id >> u32.widen(features.topology.cache_shift), node: nodes.of_cpu(apic_id)))
    }
    return places
} places_of

/// Starts every CPU but the boot CPU, `roots` holding their roots in order: on each, a task of an executor pinned to it enables its features, installs its root of the shared space and marks it started. The frame of a root no task took returns to `frames`.
fn start_cpus(
    cpu: hw::Ring0,
    take roots: mem::List[hw::PageTableRoot],
    features: cpu::Features,
    state: mem::Shared[sched::State],
    mut frames: frames::Frames,
    exec: task::Executor,
    ) fails task::Cancelled uses wait {
    var number: u32 = 1
    for root in take roots {
        let account = exec.split(sched::pinned_share(number))
        var slot = Some(take root)
        discard attempt await task::scope(account.executor(), body: fn[mut slot](s: task::Scope) {
            discard s.spawn(fn[mut slot]() limits stack 8_192 {
                let Some(taken) = mut slot.extract() else {
                    return
                }
                cpu::enable(cpu, features)
                spaces::install(cpu, root: take taken)
                state.contents().start(number)
            })
        })
        take account.close()
        match slot {
            Some(left) => mut frames.release(take left.into_frame())
            None => {
            }
        }
        number += 1
    }
} start_cpus
