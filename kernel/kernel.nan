//! The NaN OS kernel: the core's entry and start sequence.

fn main(take k: boot::Kernel) -> Never limits stack 65_536 {
    let modules = mut k.modules()
    let handoff = read_handoff(modules)
    if handoff.is_none() {
        report_halt("fault.handoff-invalid", subject: "handoff")
    }
    expect handoff.is_some()
    loop {
    }
} main

/// The handoff record, module 0 of the start information, decoded through its validator.
fn read_handoff(modules: mem::List[boot::Module]) -> Option[bootfmt::Handoff] {
    let Some(module) = modules.get(0) else {
        return None
    }
    let read = attempt bootfmt::Handoff.read(module.contents())
    let Ok(handoff) = read else {
        return None
    }
    return Some(handoff)
} read_handoff
