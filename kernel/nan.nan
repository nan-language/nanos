//! The `nan` job: the toolchain the generation ships run for a job's request in an isolated space over the job's workspace, and the core task running each run on the frames the start sets aside.

/// The frames the start sets aside for the toolchain's spaces: those of a space's boot heap, 768 MiB, and 128 MiB for its images, stacks and tables.
const SPACE_FRAMES: u64 = 229_376

/// The least RAM of a machine that runs the `nan` job.
const TOOLCHAIN_RAM: u64 = 4_294_967_296

/// The boot modules the start holds back from the frame allocator while it isolates the toolchain they ship.
linear struct Shipping {
    held: mem::List[boot::Module]
} Shipping

/// The modules `modules` holds that ship the toolchain, the regions of the others inserted into `regions`.
fn Shipping.of(take modules: mem::List[boot::Module], mut regions: mem::List[hw::Region], alloc: mem::Alloc) -> Shipping {
    var shipping = Shipping(held: mem::List.empty(alloc))
    for module in take modules {
        match mut shipping.hold(take module, alloc) {
            Some(other) => insert_region(mut regions, region: take other.into_region())
            None => {
            }
        }
    }
    return shipping
} Shipping.of

/// The toolchain `shipping` holds, isolated through `loader` on a machine of `ram` bytes of RAM that runs the `nan` job; the memory of its modules then goes to the frame allocator of `memory`.
fn shipped_toolchain(
    take shipping: Shipping,
    loader: sys::load::Loader,
    ram: u64,
    mut memory: frames::Memory,
    alloc: mem::Alloc,
    ) -> Option[toolchain::Shipped] {
    let shipped = match ram >= TOOLCHAIN_RAM {
        true => shipping.isolated(loader, alloc)
        false => None
    }
    take shipping.release(mut memory, scratch: alloc)
    return shipped
} shipped_toolchain

/// The minted toolchain capabilities of `shipped`, when the start isolated one, whose runs go to `runs`.
fn minted_toolchain(shipped: Option[toolchain::Shipped], runs: task::Sender[code::Run], alloc: mem::Alloc) -> Option[code::MintedToolchain] {
    return match shipped {
        Some(given) => Some(code::MintedToolchain.of(runs, tree: given.tree, nlif: given.nlif.view(), alloc))
        None => None
    }
} minted_toolchain

/// The tree hash of `shipped`, when the start isolated one.
fn toolchain_tree(shipped: Option[toolchain::Shipped]) -> Option[ident::HashValue] {
    return match shipped {
        Some(given) => Some(given.tree)
        None => None
    }
} toolchain_tree

/// The frames set aside from `frames` for the spaces of `shipped`, when the start isolated one.
fn spaces_of(shipped: Option[toolchain::Shipped], mut frames: frames::Frames, alloc: mem::Alloc) -> mem::List[hw::PhysFrame[4_096]] {
    return match shipped {
        Some(_) => mut frames.lend(SPACE_FRAMES, alloc)
        None => mem::List.empty(alloc)
    }
} spaces_of

/// Holds `module` back when it is one the toolchain ships in, giving it back otherwise.
fn Shipping.hold(mut self, take module: boot::Module, alloc: mem::Alloc) -> Option[boot::Module] {
    let name = module.name(alloc)
    if is_named(name, wanted: toolchain::IMAGE_MODULE) or is_named(name, wanted: toolchain::TREE_MODULE) or is_named(name, wanted: toolchain::INTERFACE_MODULE) {
        mut self.held.push(take module)
        return None
    }
    return Some(take module)
} Shipping.hold

/// Whether the module name `raw` is `wanted`.
validator fn is_named(raw: Untrusted[mem::Bytes], wanted: Str) -> bool {
    return raw.inspect().view() == wanted.as_bytes()
} is_named

/// The position of the held module named `wanted`.
fn Shipping.position(self, wanted: Str, alloc: mem::Alloc) -> Option[usize] {
    return self.held.position(fn(module: boot::Module) => is_named(module.name(alloc), wanted))
} Shipping.position

/// The toolchain the held modules ship, isolated through `loader`; `None` unless all three are held and it isolates.
fn Shipping.isolated(self, loader: sys::load::Loader, alloc: mem::Alloc) -> Option[toolchain::Shipped] {
    let Some(image) = self.position(toolchain::IMAGE_MODULE, alloc) else {
        return None
    }
    let Some(tree) = self.position(toolchain::TREE_MODULE, alloc) else {
        return None
    }
    let Some(nlif) = self.position(toolchain::INTERFACE_MODULE, alloc) else {
        return None
    }
    return toolchain::Shipped.of(loader, image: self.held[image].contents(), tree: self.held[tree].contents(), nlif: self.held[nlif].contents(), alloc)
} Shipping.isolated

/// Gives the memory of the held modules to the frame allocator of `memory`.
fn Shipping.release(take self, mut memory: frames::Memory, scratch: mem::Alloc) {
    let Shipping(held: held) = self
    for module in take held {
        mut memory.add(take module.into_region(), scratch)
    }
} Shipping.release

/// A toolchain capability `toolchains` mints, when there is one.
fn mint_toolchain(toolchains: Option[code::MintedToolchain]) -> Option[code::Toolchain] {
    return match toolchains {
        Some(minted) => Some(minted.mint())
        None => None
    }
} mint_toolchain

/// Revokes the toolchain capabilities `toolchains` mints.
fn close_toolchains(take toolchains: Option[code::MintedToolchain]) {
    match toolchains {
        Some(minted) => take minted.close()
        None => {
        }
    }
} close_toolchains

/// Runs the toolchain `shipped`, when the start isolated one, for each run `runs` brings, one at a time, in an isolated space on `cpu` over `frames`, which the start set aside for it.
fn serve_toolchain(
    cpu: hw::Ring0,
    shipped: Option[toolchain::Shipped],
    take runs: task::Receiver[code::Run],
    mut frames: mem::List[hw::PhysFrame[4_096]],
    exec: task::Executor,
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    let Some(toolchain) = shipped else {
        discard runs
        return
    }
    var receiver = runs
    loop {
        let Some(run) = try await mut receiver.receive() else {
            return
        }
        try await toolchain.run(cpu, take run, mut frames, exec, alloc)
    }
} serve_toolchain

/// Runs the `nan` job with `input`, the encoding of its `code::NanRequest`, on `world`: the toolchain's command over the workspace the request names in the job's file view, in an isolated space the core runs, its result the `code::NanReport` of what the toolchain wrote, a build that passed also writing the bundle file of what it built; `code.no-image` on a machine running no toolchain.
fn Base.run_nan(self, take input: mem::Bytes, take world: nanos::World, alloc: mem::Alloc) -> os::JobOutcome fails task::Cancelled uses wait {
    let Some(toolchain) = self.toolchain else {
        return os::JobOutcome.Failed(text: text::String.of("code.no-image", alloc))
    }
    let Some(tree) = toolchain.tree() else {
        return os::JobOutcome.Failed(text: text::String.of("code.no-image", alloc))
    }
    let Ok(request) = attempt mem::wire::Codec[code::NanRequest].decode(Untrusted.of(input.view()), alloc) else {
        return mismatch(alloc)
    }
    let disk = match request.tree.is_empty() {
        true => world.fs
        false => match attempt world.fs.subdir(request.tree.as_str()) {
            Ok(dir) => dir
            Err(_) => return os::JobOutcome.Failed(text: text::String.of("store.not-found", alloc))
        }
    }
    let nlif = toolchain.nlif(alloc)
    let task::Channel(sender: ordering, receiver: orders) = code::orders_of(alloc)
    var outcome: Result[code::Ran, text::Fixed[32]] = Err(text::Fixed[32].of("instance.env-incomplete"))
    var serving = Some(take orders)
    try await task::scope(world.exec, body: fn[mut serving, mut outcome](s: task::Scope) fails task::Cancelled uses wait {
        let Some(given) = mut serving.extract() else {
            return
        }
        discard s.spawn(fn[take given]() fails task::Cancelled uses wait limits stack 65_536 {
            try await code::serve_workspace(disk, tree, nlif: nlif.view(), orders: take given, alloc)
        })
        outcome = try await toolchain.run(command: request.command, scope: request.scope.as_str(), workspace: ordering, clock: world.clock, log: world.log, random: world.random, alloc)
        s.cancel()
    })
    discard serving
    let given = match outcome {
        Ok(run) => run
        Err(code) => return os::JobOutcome.Failed(text: text::String.of(code.as_str(), alloc))
    }
    let code::Ran(ended: ended, written: written) = given
    return match ended {
        nanos::Ended.Returned(_) => {
            var report = code::report_of(written.view(), alloc)
            if request.command == code::NanCommand.Build and report.passed() {
                match attempt await bundle_file(disk, root: request.scope.as_str(), nlif: nlif.view(), target: nanos_target(self.machine.arch).as_str(), alloc) {
                    Ok(path) => {
                        var line = text::String.of("wrote ", alloc)
                        mut line.append(path.as_str())
                        mut report.records.push(take line)
                    }
                    Err(failed) => {
                        var text = text::String.of("code.malformed", alloc)
                        mut text.append(" ")
                        mut text.write(Dyn[Render].view(failed), budget: 32)
                        return os::JobOutcome.Failed(text: take text)
                    }
                }
            }
            var bytes = mem::Bytes.empty(alloc)
            mem::wire::Codec[code::NanReport].encode(report, out: mut bytes)
            return os::JobOutcome.Returned(bytes: take bytes)
        }
        nanos::Ended.Trapped(trap) => os::JobOutcome.Trapped(text: text::String.of(journal::trap_code(trap.kind()).as_str(), alloc))
        nanos::Ended.Cancelled or nanos::Ended.Abandoned => os::JobOutcome.Cancelled(reason: text::String.empty(alloc))
        nanos::Ended.Failed(text) => os::JobOutcome.Failed(text: take text)
        nanos::Ended.Undecodable => mismatch(alloc)
    }
} Base.run_nan

/// Writes the bundle file `<root>.bundle` of what the bundle build of the package `root` wrote for the nanos target `target` into the workspace `disk`, against the interface file `nlif`, carrying the sources of the packages of its closure outside std; its path in the workspace.
fn bundle_file(
    disk: sys::Fs,
    root: Str,
    take nlif: Slice[u8],
    target: Str,
    alloc: mem::Alloc,
    ) -> text::String fails sys::fs::FsError uses wait {
    let image = try await disk.read_all(code::built_path(workspace: "", root, target, extension: ".nbun", alloc).as_str(), alloc)
    let artefacts = try await disk.read_all(code::built_path(workspace: "", root, target, extension: ".narts", alloc).as_str(), alloc)
    let Some(packages) = code::packages_of(artefacts.view(), alloc) else {
        fail sys::fs::FsError.InvalidPath
    }
    let sources = try await code::sources_of(disk, workspace: "", packages: packages.view(), alloc)
    let Some(made) = code::Bundle.made(root, image: image.view(), artefacts: artefacts.view(), interface_file: Untrusted.of(take nlif), take sources, alloc) else {
        fail sys::fs::FsError.InvalidPath
    }
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[code::Bundle].encode(made.bundle, out: mut bytes)
    let path = code::built_path(workspace: "", root, target, extension: ".bundle", alloc)
    try await disk.write_all(path.as_str(), data: bytes.view())
    return path
} bundle_file

/// The nanos target of the architecture `arch`.
fn nanos_target(arch: os::Arch) -> text::Fixed[16] {
    return match arch {
        os::Arch.Amd64 => text::Fixed[16].of("x86_64-nanos")
        os::Arch.Aarch64 => text::Fixed[16].of("aarch64-nanos")
    }
} nanos_target
