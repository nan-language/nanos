//! Jobs and instances of bundles in isolated spaces as their domains reach them: the capability through which the task of a job's or an instance's domain has the core run the job or hold the instance in a space of its own.

/// A capability having the core hold instances in isolated spaces.
pkg struct Spaces {
} Spaces

impl Spaces: sys::Kind[Placing, u8]

/// Where the core takes the orders of isolated instances, and the clock by which their spaces keep time.
struct Placing {
    orders: task::Sender[Input]
    clock: sys::Clock
} Placing

/// The root entry of the capabilities the core mints, revoked when it closes.
pkg linear struct MintedSpaces {
    minter: sys::Minter[Spaces, Placing, u8]
} MintedSpaces

/// What the core's spaces take: an order to hold an instance or to run a job, or the frames of a space whose instance or job has ended.
pkg linear enum Input {
    Order(Order)
    Job(JobOrder)
    Returned(mem::List[hw::PhysFrame[4_096]])
} Input

/// An order to run the job of the bundle of code hash `code` whose image is `image` in the isolated space `space`, whose label it is, for the principal `principal`: the encoding of its input, what the core serves the space, the bytes it may draw, the executor and cell of its domain, where its end goes, and the receiver whose sender the job's domain releases to stop it.
pkg struct JobOrder {
    pkg image: mem::Bytes
    pkg code: ident::HashValue
    pkg space: text::Fixed[32]
    pkg principal: text::Fixed[64]
    pkg input: mem::Bytes
    pkg services: nanos::Services
    pkg bytes: u64
    pkg exec: task::Executor
    pkg alloc: mem::Alloc
    pkg done: task::Sender[Result[nanos::Ended, text::Fixed[32]]]
    pkg stop: task::Receiver[Unit]
} JobOrder

/// An order to hold an instance of the component entry `component` of the bundle of code hash `code` whose image is `image` in the isolated space `space`, whose label it is, for the principal `principal`: what the core serves the space, the capabilities of its world, the checkpoint the instance resumes from, the runner capability it acts through, the bytes it may draw, the executor and cell of its domain, where the instance goes, and the receiver whose sender the domain releases once the instance has ended.
pkg struct Order {
    pkg image: mem::Bytes
    pkg code: ident::HashValue
    pkg space: text::Fixed[32]
    pkg principal: text::Fixed[64]
    pkg component: text::String
    pkg services: nanos::Services
    pkg caps: nanos::Caps
    pkg checkpoint: Option[nanos::Checkpoint]
    pkg runner: sys::Runner
    pkg bytes: u64
    pkg exec: task::Executor
    pkg alloc: mem::Alloc
    pkg held: task::Sender[Result[Held, text::Fixed[32]]]
    pkg released: task::Receiver[Unit]
} Order

/// An instance the core holds in an isolated space, with the protocol schema its bundle gives for its component.
pkg linear struct Held {
    pkg instance: nanos::Instance
    pkg schema: Option[sys::ProtocolSchema]
} Held

/// The capabilities whose orders go to `orders`, their spaces keeping time by `clock`.
pkg fn MintedSpaces.of(orders: task::Sender[Input], clock: sys::Clock, alloc: mem::Alloc) -> MintedSpaces {
    return MintedSpaces(minter: sys::Minter[Spaces, Placing, u8].of(Placing(orders: orders.split(), clock: clock), alloc))
} MintedSpaces.of

pkg fn MintedSpaces.mint(self) -> Spaces {
    return self.minter.mint(0)
} MintedSpaces.mint

/// Revokes every capability of this root entry.
pkg fn MintedSpaces.close(take self) {
    let MintedSpaces(minter: minter) = self
    take minter.close()
} MintedSpaces.close

/// Runs an instance of the component the bundle of code hash `code` whose image is `image` exports as its entry `component` as `hosting` asks, in the isolated space `isolated` the core makes for it: its world there holds the core's clock, the log, standard streams, random source and file system of `world`, and those of its capabilities that cross. A bundle that does not isolate is `Unloadable` with `code.no-image`, one without the entry with `code.malformed`, and one whose space finds too few frames with `budget.memory-pressure`.
pkg fn Spaces.host(
    self,
    take image: mem::Bytes,
    code: ident::HashValue,
    component: Str,
    isolated: runner::Isolation,
    take world: nanos::World,
    take hosting: runner::Hosting,
    ) -> Result[runner::Ended, sys::Trap] fails task::Cancelled uses wait {
    let alloc = world.alloc
    let exec = world.exec
    var hosted = hosting
    defer take hosted.close()
    let Some(Placing(orders: orders, clock: clock)) = sys::reach(self, body: fn(placing: Placing, record: u8) => Placing(orders: placing.orders.split(), clock: placing.clock)) else {
        return Ok(runner::Ended.Unloadable(code: text::Fixed[32].of("port.revoked")))
    }
    let services = services_of(world, clock)
    let nanos::World(alloc: _, exec: _, clock: _, random: _, log: _, stdio: _, fs: _, net: _, caps: caps) = world
    let task::Channel(sender: held, receiver: holding) = task::Channel[Result[Held, text::Fixed[32]]].bounded(1, alloc)
    let task::Channel(sender: releasing, receiver: released) = task::Channel[Unit].bounded(1, alloc)
    let order = Order(image: take image, code: code, space: isolated.space, principal: isolated.principal, component: text::String.of(component, alloc), services: services, caps: take caps, checkpoint: mut hosted.take_checkpoint(), runner: hosted.runner(), bytes: isolated.bytes, exec: exec, alloc: alloc, held: take held, released: take released)
    var receiver = holding
    let answer = match attempt await orders.send(Input.Order(take order)) {
        Ok(_) => attempt await mut receiver.receive()
        Err(task::SendError.Closed) => Ok(None)
        Err(task::SendError.Cancelled(cancelled)) => Err(take cancelled)
    }
    let drained = attempt await take receiver.drain(visit: abandon_held)
    let given = match answer {
        Ok(Some(Ok(held_instance))) => held_instance
        Ok(Some(Err(refused))) => return Ok(runner::Ended.Unloadable(code: refused))
        Ok(None) => return Ok(runner::Ended.Unloadable(code: text::Fixed[32].of("port.server-stopped")))
        Err(cancelled) => fail cancelled
    }
    let Held(instance: instance, schema: schema) = given
    match drained {
        Ok(_) => {
        }
        Err(cancelled) => {
            take instance.abandon()
            fail cancelled
        }
    }
    mut hosted.describe(schema)
    undefer hosted
    let ran = attempt await runner::Hosting.run(take hosted, take instance)
    discard releasing
    return match ran {
        Ok(ended) => ended
        Err(cancelled) => fail cancelled
    }
} Spaces.host

/// Runs the job of the bundle of code hash `code` whose image is `image` on `input`, the encoding of its input, in the isolated space `isolated` the core makes for it, until it ends or `domain` abandons it: its world there holds the core's clock and the log, standard streams, random source and file system of `world`, none of its other capabilities crossing. A bundle that does not isolate fails with `code.no-image`, one without a job with `code.malformed`, and one whose space finds too few frames with `budget.memory-pressure`.
pkg fn Spaces.run(
    self,
    take image: mem::Bytes,
    code: ident::HashValue,
    take input: mem::Bytes,
    isolated: runner::Isolation,
    take world: nanos::World,
    domain: sys::Abandoner,
    ) -> os::JobOutcome fails task::Cancelled uses wait {
    let alloc = world.alloc
    let exec = world.exec
    let Some(Placing(orders: orders, clock: clock)) = sys::reach(self, body: fn(placing: Placing, record: u8) => Placing(orders: placing.orders.split(), clock: placing.clock)) else {
        return os::JobOutcome.Failed(text: text::String.of("port.revoked", alloc))
    }
    let task::Channel(sender: done, receiver: ending) = task::Channel[Result[nanos::Ended, text::Fixed[32]]].bounded(1, alloc)
    let task::Channel(sender: stopping, receiver: stop) = task::Channel[Unit].bounded(1, alloc)
    let task::Channel(sender: holding, receiver: parked) = task::Channel[Unit].bounded(1, alloc)
    let order = JobOrder(image: take image, code: code, space: isolated.space, principal: isolated.principal, input: take input, services: services_of(world, clock), bytes: isolated.bytes, exec: exec, alloc: alloc, done: take done, stop: take stop)
    match attempt await orders.send(Input.Job(take order)) {
        Ok(_) => {
        }
        Err(task::SendError.Closed) => return os::JobOutcome.Failed(text: text::String.of("port.server-stopped", alloc))
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
    }
    var ended: Option[Result[nanos::Ended, text::Fixed[32]]] = None
    var ends = Some(take ending)
    var parks = Some(take parked)
    try await task::scope(exec, body: fn[mut ended, mut ends, mut parks](s: task::Scope) fails task::Cancelled uses wait {
        let Some(waiting_end) = mut ends.extract() else {
            return
        }
        let Some(waiting_park) = mut parks.extract() else {
            return
        }
        let task::Channel(sender: finishing, receiver: earliest) = task::Channel[Option[Result[nanos::Ended, text::Fixed[32]]]].bounded(2, alloc)
        let abandoned = finishing.split()
        discard s.spawn(fn[take waiting_end, take finishing]() fails task::Cancelled uses wait limits stack 4_096 {
            var receiver = waiting_end
            let received = try await mut receiver.receive()
            discard attempt await finishing.send(take received)
        })
        discard s.spawn(fn[take waiting_park, take abandoned]() fails task::Cancelled uses wait limits stack 8_192 {
            discard try await domain.run(fn[take waiting_park]() fails task::Cancelled uses wait limits stack 4_096 {
                var waiting = waiting_park
                discard try await mut waiting.receive()
            }, exec, alloc)
            discard attempt await abandoned.send(None)
        })
        var receiver = earliest
        ended = match try await mut receiver.receive() {
            Some(outcome) => outcome
            None => None
        }
        s.cancel()
    })
    discard stopping
    discard holding
    return match ended {
        Some(Ok(how)) => loading::job_outcome(take how, alloc)
        Some(Err(refused)) => os::JobOutcome.Failed(text: text::String.of(refused.as_str(), alloc))
        None => os::JobOutcome.Cancelled(reason: text::String.empty(alloc))
    }
} Spaces.run

/// How the job of `job` ended on `input` in the isolation `space`, its link `link`, once it ended or the sender of `stop` was released, `None` then: the failure `code.malformed` for a bundle without a job, and `place.unavailable` for one the space could not place.
pkg fn ended_job(
    space: nanos::Isolation,
    job: sys::load::Isolated,
    link: nanos::Link,
    take input: mem::Bytes,
    take stop: task::Receiver[Unit],
    exec: task::Executor,
    alloc: mem::Alloc,
    ) -> Option[Result[nanos::Ended, text::Fixed[32]]] fails task::Cancelled uses wait {
    var inputs = Some(take input)
    var stops = Some(take stop)
    var ended: Option[Result[nanos::Ended, text::Fixed[32]]] = None
    try await task::scope(exec, body: fn[mut inputs, mut stops, mut ended](s: task::Scope) fails task::Cancelled uses wait {
        let Some(given) = mut inputs.extract() else {
            return
        }
        let Some(watched) = mut stops.extract() else {
            return
        }
        let task::Channel(sender: finishing, receiver: finished) = task::Channel[Result[nanos::Ended, text::Fixed[32]]].bounded(1, alloc)
        discard s.spawn(fn[take given, take finishing]() fails task::Cancelled uses wait limits stack 65_536 {
            let outcome: Result[nanos::Ended, text::Fixed[32]] = match attempt await nanos::run_isolated(space, job, link, input: take given, alloc) {
                Ok(how) => Ok(take how)
                Err(nanos::IsolatedError.Cancelled(cancelled)) => fail cancelled
                Err(nanos::IsolatedError.NoJob) => Err(text::Fixed[32].of("code.malformed"))
                Err(nanos::IsolatedError.NoChannel) or Err(nanos::IsolatedError.Unplaced(_)) => Err(text::Fixed[32].of("place.unavailable"))
            }
            discard attempt await finishing.send(take outcome)
        })
        ended = try await task::race(exec, left: fn[take finished]() -> Option[Result[nanos::Ended, text::Fixed[32]]] fails task::Cancelled uses wait limits stack 4_096 {
            var receiver = finished
            return try await mut receiver.receive()
        }, right: fn[take watched]() -> Option[Result[nanos::Ended, text::Fixed[32]]] fails task::Cancelled uses wait limits stack 4_096 {
            var waiting = watched
            discard try await mut waiting.receive()
            return None
        })
        s.cancel()
    })
    return ended
} ended_job

/// What the core serves a space for `world`: `clock`, and the log, standard streams, random source and file system of `world`.
fn services_of(world: nanos::World, clock: sys::Clock) -> nanos::Services = nanos::Services(clock: clock, log: world.log, stdio: world.stdio, random: world.random, fs: world.fs)

/// Abandons the instance of an answer no domain took.
fn abandon_held(take left: Result[Held, text::Fixed[32]]) {
    match left {
        Ok(Held(instance: instance, schema: _)) => take instance.abandon()
        Err(_) => {
        }
    }
} abandon_held
