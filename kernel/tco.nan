//! The watchdog the start sequence finds: the TCO timer of an ICH9 LPC bridge, the bridge's root complex registers mapped where the firmware left them or at their conventional address, its NO_REBOOT bit cleared.

registers PciConfig {
    address: u32 at 0x0 write
    data: u32 at 0x4 read write
} PciConfig

/// The general control and status register of the root complex.
registers ChipsetControl {
    control: u32 at 0x0 read write
} ChipsetControl

const PCI_CONFIG_PORT: u16 = 0xCF8

/// The configuration address of bus 0, device 31, function 0, where an ICH9 holds its LPC bridge, and the bridge's vendor and device ids.
const LPC: u32 = 0x8000_F800

const ICH9_LPC: u32 = 0x2918_8086

/// The bridge's registers: the power management I/O base, the ACPI control holding its enable bit, and the root complex base.
const PMBASE_REGISTER: u32 = 0x40

const ACPI_CONTROL: u32 = 0x44

const ACPI_ENABLED: u32 = 0x80

const RCBA_REGISTER: u32 = 0xF0

/// The root complex base an ICH9's firmware conventionally gives, its enable bit set.
const RCBA_CONVENTIONAL: u32 = 0xFED1_C001

const RCBA_MASK: u32 = 0xFFFF_C000

/// The offset of the general control and status register in the root complex registers, and its bit keeping a second expiry from resetting.
const GCS: u64 = 0x3410

const NO_REBOOT: u32 = 0x20

/// The offset of the TCO timer's registers in the power management I/O space.
const TCO_OFFSET: u32 = 0x60

/// The I/O base of the TCO timer of the machine's ICH9 LPC bridge once its NO_REBOOT bit is clear, `None` without one or when the bit stays set: start step 7, before any instance runs.
fn tco_watchdog() -> Option[u16] {
    var config = trusted "the PCI configuration ports 0xCF8 and 0xCFC are touched by the core alone, at start, before any instance runs" { hw::Ports[PciConfig].map(port: PCI_CONFIG_PORT) }
    let id = config_read(mut config, offset: 0)
    let pmbase = config_read(mut config, offset: PMBASE_REGISTER)
    let acpi = config_read(mut config, offset: ACPI_CONTROL)
    var rcba = config_read(mut config, offset: RCBA_REGISTER)
    if id == ICH9_LPC and (rcba & 1) == 0 {
        mut config.write(PciConfig.address, value: LPC | RCBA_REGISTER)
        mut config.write(PciConfig.data, value: RCBA_CONVENTIONAL)
        rcba = config_read(mut config, offset: RCBA_REGISTER)
    }
    take config.unmap()
    if id != ICH9_LPC or (acpi & ACPI_ENABLED) == 0 or (rcba & 1) == 0 or (pmbase & 0xFF80) == 0 {
        return None
    }
    var chipset = trusted "the ICH9's general control and status register lies in its root complex registers, which the core maps nowhere else" { hw::Mmio[ChipsetControl].map(phys: u64.widen(rcba & RCBA_MASK) + GCS) }
    let control = mut chipset.read(ChipsetControl.control)
    mut chipset.write(ChipsetControl.control, value: control & ~NO_REBOOT)
    let cleared = (mut chipset.read(ChipsetControl.control) & NO_REBOOT) == 0
    take chipset.unmap()
    if not cleared {
        return None
    }
    return Some(u16.truncate((pmbase & 0xFF80) + TCO_OFFSET))
} tco_watchdog

/// The register at `offset` of the LPC bridge's configuration space.
fn config_read(mut config: hw::Ports[PciConfig], offset: u32) -> u32 {
    mut config.write(PciConfig.address, value: LPC | offset)
    return mut config.read(PciConfig.data)
} config_read
