//! The genesis record of the boot: the one the loader passes beside the kernel image, or the one the image holds, with the owner's records.

/// The genesis record of the boot: the one the loader passed, `passed`, when its blob id is the one the handoff record carries and it decodes through its validator naming the handoff record's generation, else `None`; without one, the record of the image `image` running the base jobs `jobs`. On a claimed machine, or in `dev` mode, it holds the owner's records.
fn boot_genesis(
    passed: Option[loading::Shipped],
    handoff: bootfmt::Handoff,
    image: genesis::Image,
    jobs: genesis::Jobs,
    alloc: mem::Alloc,
    ) -> Option[store::service::Genesis] {
    var record = genesis::record_of(handoff.generation, image, jobs, alloc)
    match passed {
        Some(shipped) => {
            let Some(read) = passed_genesis(shipped, handoff, alloc) else {
                return None
            }
            record = read
        }
        None => {
        }
    }
    return match owner_of(handoff, alloc) {
        Some(owner) => Some(genesis::owned(take record, owner, alloc))
        None => Some(take record)
    }
} boot_genesis

/// The genesis record `shipped` holds, when its blob id is the one the handoff record carries and it decodes, naming the handoff record's generation.
fn passed_genesis(shipped: loading::Shipped, handoff: bootfmt::Handoff, alloc: mem::Alloc) -> Option[store::service::Genesis] {
    let Some(bytes) = shipped.image(alloc) else {
        return None
    }
    if ident::HashValue.of_content(bytes.view()).bytes != handoff.genesis_hash {
        return None
    }
    let Some(read) = genesis_from(Untrusted.of(bytes.view()), alloc) else {
        return None
    }
    if read.generation != handoff.generation {
        return None
    }
    return Some(take read)
} passed_genesis

/// The base instances' specifications and grants `record` holds, its grants numbered in their order; `None` when a grant does not decode.
fn known_of(take record: store::service::Genesis, alloc: mem::Alloc) -> Option[runner::Known] {
    let store::service::Genesis(format: _, generation: _, nodes: _, instances: specs, admission: _, jobs: _, config: _, principals: _, grants: grants, policy: _) = record
    var known = mem::Map[u64, os::Grant].empty(alloc)
    for typed in grants {
        let Some(grant) = grant_from(Untrusted.of(typed.bytes.view()), alloc) else {
            return None
        }
        discard mut known.insert(u64.widen(known.len()), value: take grant)
    }
    return Some(runner::Known(specs: take specs, grants: take known))
} known_of

/// The owner's principal record: holding the owner key the handoff record names on a claimed machine, no key in `dev` mode on an unclaimed one, `None` otherwise.
fn owner_of(handoff: bootfmt::Handoff, alloc: mem::Alloc) -> Option[os::PrincipalRecord] {
    let claimed = handoff.owner_key != Array[u8, 32].filled(0)
    if not claimed and handoff.mode != bootfmt::Mode.Dev.to_bits() {
        return None
    }
    let key = match claimed {
        true => Some(handoff.owner_key)
        false => None
    }
    return Some(os::PrincipalRecord(key: key, former: mem::List.empty(alloc), parent: None, expires_utc_ns: None))
} owner_of

validator fn genesis_from(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[store::service::Genesis] {
    return match attempt mem::wire::Codec[store::service::Genesis].decode(raw, alloc) {
        Ok(record) => Some(take record)
        Err(_) => None
    }
} genesis_from

validator fn grant_from(raw: Untrusted[Slice[u8]], alloc: mem::Alloc) -> Option[os::Grant] {
    return match attempt mem::wire::Codec[os::Grant].decode(raw, alloc) {
        Ok(grant) => Some(take grant)
        Err(_) => None
    }
} grant_from
