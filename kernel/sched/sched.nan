//! Run queues, CPU classes, wake placement, accounting, idle, idle states and energy-performance preferences: the policy through which NaN's runtime runs the kernel's tasks.

/// The class of the root executor's share, and so of the core's tasks.
const CORE: u8 = 0

const LATENCY: u8 = 1

const NORMAL: u8 = 2

const BACKGROUND: u8 = 3

/// The class of core work for one CPU alone, the CPU being its share's `reserve_ppm`.
const PINNED: u8 = 4

/// The class of core work whose deadlines never wake an idle machine: each passes with the next firing of another deadline, slice or pacing tick after it.
const DEFERRABLE: u8 = 5

/// The slack of a deadline of deferrable work: long enough that its window never ends first.
const DEFERRED_SLACK_NS: u64 = 0x7FFF_FFFF_FFFF_FFFF

/// The bounds of the slack of `normal` work's deadlines, 1% of their delay, and the bound of `background` work's, 10%.
const NORMAL_SLACK_MIN_NS: u64 = 50_000

const NORMAL_SLACK_MAX_NS: u64 = 100_000_000

const BACKGROUND_SLACK_MAX_NS: u64 = 1_000_000_000

/// The slice of `normal` and `background` work.
const SLICE_NS: u64 = 3_000_000

/// The weight at which virtual time counts real nanoseconds.
const UNIT_WEIGHT: u64 = 100

/// The bits of a key below its class's rank.
const RANK_SHIFT: u32 = 62

const VALUE_MASK: u64 = 0x3FFF_FFFF_FFFF_FFFF

/// The accounts with ready work that each CPU keeps the virtual time of.
const ENTITIES: usize = 64

/// The idle periods each CPU remembers to predict its next.
const PERIODS: usize = 8

/// An MWAIT idle state: its hint and its exit latency.
pkg struct IdleState derives Copy, Eq {
    pkg hint: u8
    pkg exit_ns: u64
} IdleState

/// Where a CPU lies: its package, core, last-level cache and NUMA node.
pkg struct Place derives Copy, Eq {
    pkg package_id: u32
    pkg core: u32
    pkg cache: u64
    pkg node: u32
} Place

/// What the policy and the core's tasks share: each CPU's state behind its lock, where each CPU lies, the running CPU's number, the clock, the MWAIT states idle CPUs may enter, none without MWAIT, the power of a running CPU in mW, which charges the energy of CPU time, the energy-performance preferences of `latency`, `normal` and `background` work in bits 7:0, 15:8 and 23:16, and on a machine with HWP the signal through which each CPU posts the preference it wants.
pkg struct State {
    cpus: mem::List[hw::SpinLock[Cpu]]
    places: mem::List[Place]
    here: hw::PerCpu[u32]
    clock: sys::Clock
    started: core::atomic::AtomicBool
    idle_states: mem::List[IdleState]
    pkg busy_mw: mem::Shared[core::atomic::AtomicU64]
    pkg preferences: core::atomic::AtomicU32
    wanting: mem::List[mem::Shared[hw::Signal[u8]]]
} State

/// The kernel's policy, whose hooks NaN's runtime calls with the CPU's interrupts disabled.
pkg struct Scheduler {
    state: mem::Shared[State]
} Scheduler

/// A CPU's run queue as the policy sees it, with the time it spent, whether it rests, since when and in which MWAIT state, none for HLT, the rests it left, the lengths of its last idle periods, each from its entry into an idle state to its return, the next taking slot `next_period`, the start of the one it is in, its latency tolerance, none when unbounded, the tasks of `latency`, `normal` and `background` work queued on it, and the energy-performance preference it last wanted.
struct Cpu {
    started: bool
    idle: bool
    queued: u32
    bound: u32
    virtual_ns: u64
    running: Running
    entities: mem::Bounded[Entity, ENTITIES]
    times: Times
    resting: bool
    rested_ns: u64
    resting_in: Option[u8]
    wakeups: u64
    periods: Array[u64, PERIODS]
    next_period: usize
    period_ns: u64
    tolerance_ns: Option[u64]
    classes: Array[u32, 3]
    preference: Option[u8]
} Cpu

/// The time a CPU spent on work of each class, core work counting all of its classes, and idle.
pkg struct Times derives Copy, Eq {
    pkg normal: u64
    pkg background: u64
    pkg latency: u64
    pkg core: u64
    pkg idle: u64
} Times

/// What a CPU's state tells at a moment: whether it started and rests, the hint of the MWAIT state it rests in, none for HLT, its time, the work queued on it and the rests it left.
pkg struct Reading derives Copy {
    pkg started: bool
    pkg resting: bool
    pkg resting_in: Option[u8]
    pkg times: Times
    pkg queued: u32
    pkg wakeups: u64
} Reading

/// The work a CPU runs: its account, weight and class, since when, and whether it runs any.
struct Running derives Copy {
    executor: u64
    weight: u64
    class: u8
    since_ns: u64
    active: bool
} Running

/// An account with ready work on a CPU: its virtual runtime and its tasks placed there that have not started.
struct Entity derives Copy {
    executor: u64
    virtual_ns: u64
    ready: u32
} Entity

/// The classes of the executors of `latency`, `normal` and `background` accounts, then of deferrable core work, in that order.
pkg fn classes() -> Array[u8, 4] {
    var table = Array[u8, 4].filled(LATENCY)
    table[1] = NORMAL
    table[2] = BACKGROUND
    table[3] = DEFERRABLE
    return table
} classes

/// The share of the executors whose tasks run on CPU `cpu` alone.
pkg fn pinned_share(cpu: u32) -> task::Share
    requires cpu <= 1_000_000
{
    return task::Share(weight: 1, class: PINNED, reserve_ppm: cpu)
} pinned_share

/// Whether work of `class` stays on the CPU it is placed on, where no steal takes it: `latency` work and core work for one CPU.
fn binds(class: u8) -> bool = class == LATENCY or class == PINNED

/// The rank of a class in every run queue: `latency` work first, then the core's, then `normal` and `background` work.
fn rank(class: u8) -> u64 {
    return match class {
        LATENCY => 0
        CORE or PINNED or DEFERRABLE => 1
        NORMAL => 2
        else => 3
    }
} rank

/// The key placing work of `class` with `value` in a run queue: by rank, then by value.
fn key(class: u8, value: u64) -> u64 {
    return (rank(class) << RANK_SHIFT) | (value & VALUE_MASK)
} key

/// The virtual time `ns` of running is worth at `weight`.
fn virtual_of(ns: u64, weight: u64) -> u64 {
    if weight == 0 {
        return ns.saturating_mul(UNIT_WEIGHT)
    }
    return ns.saturating_mul(UNIT_WEIGHT) / weight
} virtual_of

/// The state for `places.len()` CPUs, every CPU but the boot CPU not yet started, idle CPUs entering `idle_states` or halting, a running CPU's power and the preferences those of the power settings by default, each CPU posting the preference it wants when `hwp`.
pkg fn State.of(
    take places: mem::List[Place],
    clock: sys::Clock,
    take idle_states: mem::List[IdleState],
    hwp: bool,
    alloc: mem::Alloc,
    ) -> State {
    var cpus = mem::List[hw::SpinLock[Cpu]].empty(alloc)
    for index in 0..<places.len() {
        var cpu = Cpu.fresh()
        cpu.started = index == 0
        mut cpus.push(hw::SpinLock.of(take cpu))
    }
    var wanting = mem::List[mem::Shared[hw::Signal[u8]]].empty(alloc)
    if hwp {
        for _ in 0..<places.len() {
            mut wanting.push(mem::Shared.of(hw::Signal[u8].empty(), alloc))
        }
    }
    let defaults = power::PowerConfig.default_of(alloc)
    let busy_mw = mem::Shared.of(core::atomic::AtomicU64.of(u64.widen(defaults.busy_mw)), alloc)
    var chosen = Array[u8, 3].filled(defaults.preference_latency)
    chosen[1] = defaults.preference_normal
    chosen[2] = defaults.preference_background
    let preferences = core::atomic::AtomicU32.of(pack(chosen))
    return State(cpus: take cpus, places: take places, here: hw::PerCpu.of(init: fn(cpu: u32) => cpu, alloc), clock: clock, started: core::atomic::AtomicBool.of(false), idle_states: take idle_states, busy_mw: take busy_mw, preferences: take preferences, wanting: take wanting)
} State.of

/// Applies the power settings: a running CPU's power `busy_mw`, and `preferences`, those of `latency`, `normal` and `background` work.
pkg fn State.apply(self, busy_mw: u64, preferences: Array[u8, 3]) {
    self.busy_mw.contents().store(busy_mw)
    self.preferences.store(pack(preferences))
} State.apply

/// The signal through which CPU `cpu` posts the energy-performance preference it wants, none without HWP.
pkg fn State.wanted_by(self, cpu: u32) -> Option[mem::Shared[hw::Signal[u8]]] {
    return match self.wanting.get(usize.widen(cpu)) {
        Some(signal) => Some(signal.share())
        None => None
    }
} State.wanted_by

/// `preferences` as the state holds them, in bits 7:0, 15:8 and 23:16.
fn pack(preferences: Array[u8, 3]) -> u32 = u32.widen(preferences[0]) | (u32.widen(preferences[1]) << 8) | (u32.widen(preferences[2]) << 16)

/// A CPU not started, running nothing.
fn Cpu.fresh() -> Cpu {
    let nothing = Running(executor: 0, weight: 1, class: CORE, since_ns: 0, active: false)
    return Cpu(started: false, idle: false, queued: 0, bound: 0, virtual_ns: 0, running: nothing, entities: mem::Bounded.empty(), times: Times.none(), resting: false, rested_ns: 0, resting_in: None, wakeups: 0, periods: Array[u64, PERIODS].filled(0), next_period: 0, period_ns: 0, tolerance_ns: None, classes: Array[u32, 3].filled(0), preference: None)
} Cpu.fresh

/// Marks CPU `cpu` started: it runs on the shared space with its features enabled, so work may go to it.
pkg fn State.start(self, cpu: u32) {
    let Some(lock) = self.cpus.get(usize.widen(cpu)) else {
        return
    }
    hw::without_irqs(fn(t: hw::IrqsDisabled) limits notrap, terminates {
        lock.with(t, body: fn(mut state: Cpu) limits notrap, terminates, noalloc {
            state.started = true
        })
    })
} State.start

/// Sets CPU `cpu`'s latency tolerance to `tolerance_ns`, unbounded when `None`.
pkg fn State.tolerate(self, cpu: u32, tolerance_ns: Option[u64]) {
    let Some(lock) = self.cpus.get(usize.widen(cpu)) else {
        return
    }
    hw::without_irqs(fn(t: hw::IrqsDisabled) limits notrap, terminates {
        lock.with(t, body: fn(mut state: Cpu) limits notrap, terminates, noalloc {
            state.tolerance_ns = tolerance_ns
        })
    })
} State.tolerate

/// Marks every CPU started, from which on idle CPUs take work from others.
pkg fn State.all_started(self) {
    self.started.store(true)
} State.all_started

/// The number of CPUs.
pkg fn State.count(self) -> u32 = u32.truncate(self.places.len())

/// Where CPU `cpu` lies.
pkg fn State.place(self, cpu: u32) -> Option[Place] {
    return match self.places.get(usize.widen(cpu)) {
        Some(found) => Some(found)
        None => None
    }
} State.place

/// What CPU `cpu`'s state tells now.
pkg fn State.reading(self, cpu: u32) -> Option[Reading] {
    let Some(lock) = self.cpus.get(usize.widen(cpu)) else {
        return None
    }
    let now = self.now()
    return Some(hw::without_irqs(fn(t: hw::IrqsDisabled) -> Reading limits notrap, terminates {
        return lock.with(t, body: fn(mut current: Cpu) -> Reading limits notrap, terminates, noalloc {
            return current.reading(now_ns: now)
        })
    }))
} State.reading

fn State.now(self) -> u64 limits notrap, terminates, noalloc {
    return match attempt self.clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
} State.now

/// The running CPU's number.
fn State.running_cpu(self, t: hw::IrqsDisabled) -> u32 limits notrap, terminates, noalloc {
    return self.here.with(t, body: fn(mut cpu: u32) -> u32 limits notrap, terminates, noalloc {
        return cpu
    })
} State.running_cpu

/// Whether CPU `cpu` has started and idles.
fn State.is_idle(self, t: hw::IrqsDisabled, cpu: u32) -> bool limits notrap, terminates, noalloc {
    let Some(lock) = self.cpus.get(usize.widen(cpu)) else {
        return false
    }
    return lock.with(t, body: fn(mut state: Cpu) -> bool limits notrap, terminates, noalloc {
        return state.started and state.idle
    })
} State.is_idle

/// Whether CPU `cpu` has started.
fn State.is_started(self, t: hw::IrqsDisabled, cpu: u32) -> bool limits notrap, terminates, noalloc {
    let Some(lock) = self.cpus.get(usize.widen(cpu)) else {
        return false
    }
    return lock.with(t, body: fn(mut state: Cpu) -> bool limits notrap, terminates, noalloc {
        return state.started
    })
} State.is_started

/// The CPU a woken task goes to: the CPU it last ran on when that CPU idles, else an idle CPU sharing that CPU's last-level cache, else the waker's CPU, which also stands as the last CPU of a task that never ran.
fn State.wake_cpu(self, t: hw::IrqsDisabled, previous: Option[u32], waker: u32) -> u32 limits notrap, terminates, noalloc {
    let last = previous.value_or(waker)
    if self.is_idle(t, cpu: last) {
        return last
    }
    let Some(place) = self.places.get(usize.widen(last)) else {
        return waker
    }
    for index in 0..<self.places.len() {
        let Some(other) = self.places.get(index) else {
            continue
        }
        let cpu = u32.truncate(index)
        if other.cache == place.cache and self.is_idle(t, cpu) {
            return cpu
        }
    }
    return waker
} State.wake_cpu

/// Charges the running work of the running CPU when it is of `task`'s account, as when `task` is preempted.
fn State.charge_running(self, t: hw::IrqsDisabled, task: hw::TaskView) limits notrap, terminates, noalloc {
    let Some(lock) = self.cpus.get(usize.widen(self.running_cpu(t))) else {
        return
    }
    let now = self.now()
    lock.with(t, body: fn(mut state: Cpu) limits notrap, terminates, noalloc {
        if state.running.active and state.running.executor == task.executor {
            mut state.charge(now_ns: now)
        }
    })
} State.charge_running

/// Adds `task` to CPU `cpu`'s queue and gives its key.
fn State.enqueue(self, t: hw::IrqsDisabled, cpu: u32, task: hw::TaskView) -> u64 limits notrap, terminates, noalloc {
    let Some(lock) = self.cpus.get(usize.widen(cpu)) else {
        return key(task.share.class, value: 0)
    }
    let now = self.now()
    return lock.with(t, body: fn(mut state: Cpu) -> u64 limits notrap, terminates, noalloc {
        return mut state.enqueue(task, now_ns: now)
    })
} State.enqueue

impl Scheduler: hw::Policy

/// The policy over `state`, which the core's tasks share.
pkg fn Scheduler.of(take state: mem::Shared[State]) -> Scheduler = Scheduler(state: take state)

pkg fn Scheduler.place(self, t: hw::IrqsDisabled, task: hw::TaskView) -> hw::Placement limits notrap, terminates, noalloc, stack 4_096 {
    let state = self.state.contents()
    state.charge_running(t, task)
    var here = state.running_cpu(t)
    if not state.is_started(t, cpu: here) {
        here = 0
    }
    var target = here
    if task.share.class == PINNED {
        target = task.share.reserve_ppm
    } else {
        target = state.wake_cpu(t, previous: task.last_cpu, waker: here)
    }
    return hw::Placement(cpu: target, key: state.enqueue(t, cpu: target, task), bound: binds(task.share.class))
} Scheduler.place

pkg fn Scheduler.steal(self, t: hw::IrqsDisabled, cpu: u32, round: u32) -> Option[hw::Steal] limits notrap, terminates, noalloc, stack 4_096 {
    let state = self.state.contents()
    if round != 0 or not state.started.load() {
        return None
    }
    let Some(place) = state.places.get(usize.widen(cpu)) else {
        return None
    }
    var best: Option[hw::Steal] = None
    var best_tier: u8 = 3
    for index in 0..<state.places.len() {
        let other = u32.truncate(index)
        let Some(lock) = state.cpus.get(index) else {
            continue
        }
        let Some(spot) = state.places.get(index) else {
            continue
        }
        let unbound = lock.with(t, body: fn(mut victim: Cpu) -> u32 limits notrap, terminates, noalloc {
            if not victim.started {
                return 0
            }
            return victim.queued.saturating_sub(victim.bound)
        })
        var tier: u8 = 2
        if spot.cache == place.cache {
            tier = 0
        } else if spot.node == place.node {
            tier = 1
        }
        let busier = match best {
            Some(steal) => tier < best_tier or (tier == best_tier and unbound > steal.tasks)
            None => true
        }
        if other != cpu and unbound > 0 and busier {
            best = Some(hw::Steal(cpu: other, tasks: unbound))
            best_tier = tier
        }
    }
    return best
} Scheduler.steal

/// The slice of `task` as CPU `cpu` switches to it; when the preference the CPU wants changes, it posts the new one.
pkg fn Scheduler.slice(self, t: hw::IrqsDisabled, cpu: u32, task: hw::TaskView) -> u64 limits notrap, terminates, noalloc, stack 4_096 {
    let state = self.state.contents()
    let now = state.now()
    let preferences = state.preferences.load()
    let Some(lock) = state.cpus.get(usize.widen(cpu)) else {
        return 0
    }
    let switched = lock.with(t, body: fn(mut current: Cpu) -> Switched limits notrap, terminates, noalloc {
        let slice = mut current.switch_to(task, now_ns: now)
        return Switched(slice: slice, wanted: mut current.prefer(preferences))
    })
    match switched.wanted {
        Some(preference) => {
            match state.wanting.get(usize.widen(cpu)) {
                Some(signal) => signal.contents().post(t, value: preference)
                None => {
                }
            }
        }
        None => {
        }
    }
    return switched.slice
} Scheduler.slice

/// What a switch gives: the slice, and the preference the CPU wants when it changed.
struct Switched derives Copy {
    slice: u64
    wanted: Option[u8]
} Switched

/// The energy-performance preference this CPU wants under the preferences `preferences` of the three classes, the lowest of those of the classes it runs and has queued, when it differs from the one it wanted last, which it then becomes; `None` otherwise, or when it runs none of them.
fn Cpu.prefer(mut self, preferences: u32) -> Option[u8] limits notrap, terminates, noalloc {
    var wanted: Option[u8] = None
    for index in 0..<3u32 {
        let class = u8.truncate(index + 1)
        let runs = self.classes[usize.widen(index)] > 0 or (self.running.active and self.running.class == class)
        if runs {
            let preference = u8.truncate(preferences >> (index * 8))
            wanted = Some(wanted.value_or(preference).min(preference))
        }
    }
    if wanted.is_none() or wanted == self.preference {
        return None
    }
    self.preference = wanted
    return wanted
} Cpu.prefer

/// The slack of a deadline `delay_ns` ahead by the class of the work arming it: 1% of the delay, from 50 µs to 100 ms, for `normal` work, 10% up to 1 s for `background` work, a window that never ends first for deferrable work, and none for the rest.
pkg fn Scheduler.slack(self, t: hw::IrqsDisabled, task: hw::TaskView, delay_ns: u64) -> u64 limits notrap, terminates, noalloc, stack 4_096 {
    return match task.share.class {
        NORMAL => bounded(delay_ns / 100, low: NORMAL_SLACK_MIN_NS, high: NORMAL_SLACK_MAX_NS)
        BACKGROUND => bounded(delay_ns / 10, low: 0, high: BACKGROUND_SLACK_MAX_NS)
        DEFERRABLE => DEFERRED_SLACK_NS
        else => 0
    }
} Scheduler.slack

/// `value` held between `low` and `high`.
fn bounded(value: u64, low: u64, high: u64) -> u64 limits notrap, terminates, noalloc {
    if value < low {
        return low
    }
    if value > high {
        return high
    }
    return value
} bounded

/// The idle state of a CPU with no work: the deepest MWAIT state whose exit latency is below half the rest it predicts and below its latency tolerance, else HLT.
pkg fn Scheduler.idle(self, t: hw::IrqsDisabled, cpu: u32, until_ns: Option[u64]) -> hw::Idle limits notrap, terminates, noalloc, stack 4_096 {
    let state = self.state.contents()
    let now = state.now()
    let Some(lock) = state.cpus.get(usize.widen(cpu)) else {
        return hw::Idle.Halt
    }
    let entered = lock.with(t, body: fn(mut current: Cpu) -> Option[u8] limits notrap, terminates, noalloc {
        mut current.go_idle(now_ns: now)
        current.resting_in = match deepest(state.idle_states.view(), below: current.exit_bound(now_ns: now, until_ns)) {
            Some(chosen) => Some(chosen.hint)
            None => None
        }
        return current.resting_in
    })
    return match entered {
        Some(hint) => hw::Idle.Mwait(hint)
        None => hw::Idle.Halt
    }
} Scheduler.idle

/// The exit latency below which the idle state a CPU enters at `now_ns` stays: half the rest it predicts and its latency tolerance, `None` when it knows neither.
fn Cpu.exit_bound(self, now_ns: u64, until_ns: Option[u64]) -> Option[u64] limits notrap, terminates, noalloc {
    let half = match self.predicted(now_ns, until_ns) {
        Some(rest) => Some(rest / 2)
        None => None
    }
    return least(half, right: self.tolerance_ns)
} Cpu.exit_bound

/// The idle period the CPU predicts at `now_ns`: the time to its earliest timer, `until_ns`, or, when shorter, the mean of its last idle periods; `None` when it knows neither.
fn Cpu.predicted(self, now_ns: u64, until_ns: Option[u64]) -> Option[u64] limits notrap, terminates, noalloc {
    let timer = match until_ns {
        Some(at) => Some(at.saturating_sub(now_ns))
        None => None
    }
    var total: u64 = 0
    var counted: u64 = 0
    for period in self.periods {
        if period > 0 {
            total = total.saturating_add(period)
            counted = counted.saturating_add(1)
        }
    }
    if counted == 0 {
        return timer
    }
    return least(timer, right: Some(total / counted))
} Cpu.predicted

/// The lesser of two bounds, each `None` when unbounded.
fn least(left: Option[u64], right: Option[u64]) -> Option[u64] limits notrap, terminates, noalloc {
    return match left {
        Some(ns) => Some(ns.min(right.value_or(ns)))
        None => right
    }
} least

/// The state of `states` with the longest exit latency below `below`, any when it is `None`.
fn deepest(states: Slice[IdleState], below: Option[u64]) -> Option[IdleState] limits notrap, terminates, noalloc {
    var chosen: Option[IdleState] = None
    for state in states {
        let fits = match below {
            Some(ns) => state.exit_ns < ns
            None => true
        }
        let deeper = match chosen {
            Some(held) => state.exit_ns > held.exit_ns
            None => true
        }
        if fits and deeper {
            chosen = Some(state)
        }
    }
    return chosen
} deepest

/// Charges the running work for the time since it started or was last charged: to the CPU's time of its class, and `normal` and `background` work to its account's virtual runtime.
fn Cpu.charge(mut self, now_ns: u64) limits notrap, terminates, noalloc {
    if not self.running.active {
        return
    }
    let ran = now_ns.saturating_sub(self.running.since_ns)
    self.running.since_ns = now_ns
    self.times = self.times.charged(self.running.class, ns: ran)
    if self.running.class != NORMAL and self.running.class != BACKGROUND {
        return
    }
    let added = virtual_of(ran, weight: self.running.weight)
    let executor = self.running.executor
    for entity in mut self.entities {
        if entity.executor == executor {
            entity.virtual_ns = entity.virtual_ns.saturating_add(added)
        }
    }
} Cpu.charge

/// Adds `task` to this CPU's queue at `now_ns` and gives its key: `latency` work by deadline, `normal` and `background` work by its account's virtual deadline, the core's work in the order it arrives.
fn Cpu.enqueue(mut self, task: hw::TaskView, now_ns: u64) -> u64 limits notrap, terminates, noalloc {
    self.queued = self.queued.saturating_add(1)
    self.idle = false
    let class = task.share.class
    match class_index(class) {
        Some(index) => {
            self.classes[index % 3] = self.classes[index % 3].saturating_add(1)
        }
        None => {
        }
    }
    if binds(class) {
        self.bound = self.bound.saturating_add(1)
    }
    if class == LATENCY {
        return key(class, value: task.deadline_ns.value_or(now_ns))
    }
    if class == NORMAL or class == BACKGROUND {
        let start = mut self.ready_entity(task.executor)
        return key(class, value: start.saturating_add(virtual_of(SLICE_NS, weight: u64.widen(task.share.weight))))
    }
    return key(class, value: 0)
} Cpu.enqueue

/// The virtual runtime of account `executor` on this CPU, counting one more ready task of it: an account this CPU keeps none for starts at the CPU's virtual time, in the place of one without ready work when the CPU keeps as many as it can.
fn Cpu.ready_entity(mut self, executor: u64) -> u64 limits notrap, terminates, noalloc {
    let floor = self.virtual_ns
    for entity in mut self.entities {
        if entity.executor == executor {
            entity.ready = entity.ready.saturating_add(1)
            if entity.virtual_ns < floor {
                entity.virtual_ns = floor
            }
            return entity.virtual_ns
        }
    }
    let fresh = Entity(executor: executor, virtual_ns: floor, ready: 1)
    if (attempt mut self.entities.try_push(fresh)).is_ok() {
        return floor
    }
    let running = self.running
    for entity in mut self.entities {
        if entity.ready == 0 and not (running.active and running.executor == entity.executor) {
            entity.executor = executor
            entity.virtual_ns = floor
            entity.ready = 1
            return floor
        }
    }
    return floor
} Cpu.ready_entity

/// Switches this CPU to `task` at `now_ns` and gives its slice: `normal` and `background` work gets one while other work waits on the CPU, other work none. A rest it leaves counts as idle time and a wakeup.
fn Cpu.switch_to(mut self, task: hw::TaskView, now_ns: u64) -> u64 limits notrap, terminates, noalloc {
    mut self.charge(now_ns)
    if self.resting {
        mut self.end_period(now_ns)
        self.times.idle = self.times.idle.saturating_add(now_ns.saturating_sub(self.rested_ns))
        self.resting = false
        self.resting_in = None
        self.wakeups = self.wakeups.saturating_add(1)
    }
    self.queued = self.queued.saturating_sub(1)
    let class = task.share.class
    if binds(class) {
        self.bound = self.bound.saturating_sub(1)
    }
    match class_index(class) {
        Some(index) => {
            self.classes[index % 3] = self.classes[index % 3].saturating_sub(1)
        }
        None => {
        }
    }
    self.idle = false
    self.running = Running(executor: task.executor, weight: u64.widen(task.share.weight), class: class, since_ns: now_ns, active: true)
    var floor = self.virtual_ns
    for entity in mut self.entities {
        if entity.executor == task.executor {
            entity.ready = entity.ready.saturating_sub(1)
            if entity.virtual_ns > floor {
                floor = entity.virtual_ns
            }
        }
    }
    self.virtual_ns = floor
    if (class == NORMAL or class == BACKGROUND) and self.queued > 0 {
        return SLICE_NS
    }
    return 0
} Cpu.switch_to

/// Makes this CPU idle at `now_ns`, about to enter an idle state: its queue is empty, it rests from then on unless it already does, ending the idle period it returned from, and a new idle period begins.
fn Cpu.go_idle(mut self, now_ns: u64) limits notrap, terminates, noalloc {
    mut self.charge(now_ns)
    if self.resting {
        mut self.end_period(now_ns)
    } else {
        self.resting = true
        self.rested_ns = now_ns
    }
    self.period_ns = now_ns
    self.running.active = false
    self.idle = true
    self.queued = 0
    self.bound = 0
    self.classes = Array[u32, 3].filled(0)
    for entity in mut self.entities {
        entity.ready = 0
    }
} Cpu.go_idle

/// The place of `latency`, `normal` and `background` work among a CPU's queued classes; `None` for core work.
fn class_index(class: u8) -> Option[usize] limits notrap, terminates, noalloc {
    if class == LATENCY or class == NORMAL or class == BACKGROUND {
        return Some(usize.widen(class) - 1)
    }
    return None
} class_index

/// Counts the idle period the CPU leaves at `now_ns` among its last ones.
fn Cpu.end_period(mut self, now_ns: u64) limits notrap, terminates, noalloc {
    let slot = self.next_period % PERIODS
    self.periods[slot] = now_ns.saturating_sub(self.period_ns).max(1)
    self.next_period = (slot + 1) % PERIODS
} Cpu.end_period

/// What this CPU's state tells at `now_ns`, the work it runs and its rest counted until then.
fn Cpu.reading(self, now_ns: u64) -> Reading limits notrap, terminates, noalloc {
    var times = self.times
    if self.running.active {
        times = times.charged(self.running.class, ns: now_ns.saturating_sub(self.running.since_ns))
    }
    if self.resting {
        times.idle = times.idle.saturating_add(now_ns.saturating_sub(self.rested_ns))
    }
    return Reading(started: self.started, resting: self.resting, resting_in: self.resting_in, times: times, queued: self.queued, wakeups: self.wakeups)
} Cpu.reading

fn Times.none() -> Times = Times(normal: 0, background: 0, latency: 0, core: 0, idle: 0)

/// These times with `ns` more of work of `class`.
fn Times.charged(self, class: u8, ns: u64) -> Times limits notrap, terminates, noalloc {
    var times = self
    if class == NORMAL {
        times.normal = times.normal.saturating_add(ns)
    } else if class == BACKGROUND {
        times.background = times.background.saturating_add(ns)
    } else if class == LATENCY {
        times.latency = times.latency.saturating_add(ns)
    } else {
        times.core = times.core.saturating_add(ns)
    }
    return times
} Times.charged

fn view(executor: u64, class: u8, weight: u32) -> hw::TaskView {
    return hw::TaskView(task: executor, executor: executor, share: task::Share(weight: weight, class: class, reserve_ppm: 0), last_cpu: None, ran_ns: 0, deadline_ns: None)
} view

fn idle_cpu() -> Cpu {
    var cpu = Cpu.fresh()
    cpu.started = true
    cpu.idle = true
    return cpu
} idle_cpu

/// A CPU charges each class the time it ran work of it and counts its rests as idle time, each rest it leaves a wakeup, until the moment it is read.
test cpus_count_their_time_by_class_and_their_wakeups for Cpu.reading {
    var cpu = idle_cpu()
    discard mut cpu.switch_to(view(executor: 1, class: NORMAL, weight: 100), now_ns: 0)
    discard mut cpu.switch_to(view(executor: 2, class: LATENCY, weight: 100), now_ns: 30)
    discard mut cpu.switch_to(view(executor: 0, class: CORE, weight: 1), now_ns: 50)
    mut cpu.go_idle(now_ns: 60)
    mut cpu.go_idle(now_ns: 80)
    discard mut cpu.switch_to(view(executor: 3, class: BACKGROUND, weight: 100), now_ns: 100)
    let running = cpu.reading(now_ns: 110)
    expect running.times == Times(normal: 30, background: 10, latency: 20, core: 10, idle: 40)
    expect running.wakeups == 1 and not running.resting
    mut cpu.go_idle(now_ns: 120)
    let rested = cpu.reading(now_ns: 150)
    expect rested.times == Times(normal: 30, background: 20, latency: 20, core: 10, idle: 70)
    expect rested.resting and rested.wakeups == 1
} cpus_count_their_time_by_class_and_their_wakeups

test classes_order_every_queue for key {
    expect key(LATENCY, value: 1_000_000_000_000_000) < key(CORE, value: 0)
    expect key(CORE, value: 0) == key(PINNED, value: 0)
    expect key(PINNED, value: 0) < key(NORMAL, value: 0)
    expect key(NORMAL, value: 1_000_000_000_000_000) < key(BACKGROUND, value: 0)
    expect key(NORMAL, value: 5) < key(NORMAL, value: 6)
} classes_order_every_queue

/// Two `normal` accounts weighing 300 and 100 share a CPU, each running a slice whenever its key is the queue's smallest, the earlier queued first among equal keys: they run in the ratio of their weights.
test weights_divide_a_cpu for Cpu.enqueue {
    var cpu = idle_cpu()
    let heavy = view(executor: 1, class: NORMAL, weight: 300)
    let light = view(executor: 2, class: NORMAL, weight: 100)
    var now: u64 = 0
    var heavy_key = mut cpu.enqueue(heavy, now_ns: now)
    var light_key = mut cpu.enqueue(light, now_ns: now)
    var heavy_first = false
    var heavy_runs: u32 = 0
    var light_runs: u32 = 0
    for _ in 0..<40u32 {
        let pick_heavy = heavy_key < light_key or (heavy_key == light_key and heavy_first)
        var running = light
        if pick_heavy {
            running = heavy
        }
        discard mut cpu.switch_to(running, now_ns: now)
        now += SLICE_NS
        mut cpu.charge(now_ns: now)
        if pick_heavy {
            heavy_runs += 1
            heavy_key = mut cpu.enqueue(heavy, now_ns: now)
            heavy_first = false
        } else {
            light_runs += 1
            light_key = mut cpu.enqueue(light, now_ns: now)
            heavy_first = true
        }
    }
    expect heavy_runs == 30
    expect light_runs == 10
} weights_divide_a_cpu

test slices_end_only_shared_work for Cpu.switch_to {
    var cpu = idle_cpu()
    let alone = view(executor: 1, class: NORMAL, weight: 100)
    discard mut cpu.enqueue(alone, now_ns: 0)
    let solo = mut cpu.switch_to(alone, now_ns: 0)
    expect solo == 0
    discard mut cpu.enqueue(alone, now_ns: 10)
    discard mut cpu.enqueue(view(executor: 2, class: BACKGROUND, weight: 100), now_ns: 10)
    let shared = mut cpu.switch_to(alone, now_ns: 10)
    expect shared == SLICE_NS
    let core_work = mut cpu.switch_to(view(executor: 0, class: CORE, weight: 1), now_ns: 20)
    expect core_work == 0
    mut cpu.go_idle(now_ns: 30)
    expect cpu.idle and cpu.queued == 0
} slices_end_only_shared_work

/// A policy over four started CPUs: CPUs 0 and 1 share a cache, CPUs 2 and 3 another, all on node 0.
fn four_cpus(clock: sys::Clock, alloc: mem::Alloc) -> Scheduler {
    var places = mem::List[Place].empty(alloc)
    for cpu in 0u64..<4 {
        mut places.push(Place(package_id: 0, core: u32.truncate(cpu), cache: cpu / 2, node: 0))
    }
    let state = mem::Shared.of(State.of(take places, clock, idle_states: mem::List.empty(alloc), hwp: false, alloc), alloc)
    for cpu in 1u32..<4 {
        state.contents().start(cpu)
    }
    state.contents().all_started()
    return Scheduler.of(take state)
} four_cpus

fn last_on(cpu: u32, executor: u64) -> hw::TaskView {
    var task = view(executor, class: NORMAL, weight: 100)
    task.last_cpu = Some(cpu)
    return task
} last_on

/// The CPUs the policy gives four wakes while CPU 0 runs a task and the others idle: back to idle CPU 2, then from busy CPU 0 to its idle cache sibling 1, then, with no idle CPU left in that cache, to the waker's CPU 0, and a pinned task to its CPU.
fn placements(policy: Scheduler) -> Array[u32, 4] {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> Array[u32, 4] limits notrap, terminates {
        discard policy.slice(t, cpu: 0, task: view(executor: 0, class: CORE, weight: 1))
        for cpu in 1u32..<4 {
            discard policy.idle(t, cpu, until_ns: None)
        }
        var cpus = Array[u32, 4].filled(9)
        cpus[0] = policy.place(t, task: last_on(cpu: 2, executor: 5)).cpu
        cpus[1] = policy.place(t, task: last_on(cpu: 0, executor: 6)).cpu
        cpus[2] = policy.place(t, task: last_on(cpu: 0, executor: 7)).cpu
        let fixed = hw::TaskView(task: 8, executor: 8, share: pinned_share(3), last_cpu: None, ran_ns: 0, deadline_ns: None)
        cpus[3] = policy.place(t, task: fixed).cpu
        return cpus
    })
} placements

test wakes_go_to_idle_cpus_near_their_last for Scheduler.place {
    let world = testing::world()
    let cpus = placements(four_cpus(clock: world.clock, alloc: world.alloc))
    expect cpus[0] == 2
    expect cpus[1] == 1
    expect cpus[2] == 0
    expect cpus[3] == 3
} wakes_go_to_idle_cpus_near_their_last

/// What idle CPUs 3 and 1 steal once work waits on CPUs 0 and 2, CPU 2's pinned task never counting, and CPU 1's second round.
fn steals(policy: Scheduler) -> Array[Option[hw::Steal], 3] {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> Array[Option[hw::Steal], 3] limits notrap, terminates {
        for cpu in 0u32..<4 {
            discard policy.idle(t, cpu, until_ns: None)
        }
        let state = policy.state.contents()
        discard state.enqueue(t, cpu: 0, task: view(executor: 5, class: NORMAL, weight: 100))
        discard state.enqueue(t, cpu: 0, task: view(executor: 6, class: NORMAL, weight: 100))
        discard state.enqueue(t, cpu: 2, task: view(executor: 7, class: NORMAL, weight: 100))
        discard state.enqueue(t, cpu: 2, task: hw::TaskView(task: 8, executor: 8, share: pinned_share(2), last_cpu: None, ran_ns: 0, deadline_ns: None))
        var victims = Array[Option[hw::Steal], 3].filled(None)
        victims[0] = policy.steal(t, cpu: 3, round: 0)
        victims[1] = policy.steal(t, cpu: 1, round: 0)
        victims[2] = policy.steal(t, cpu: 1, round: 1)
        return victims
    })
} steals

test idle_cpus_steal_nearest_work_first for Scheduler.steal {
    let world = testing::world()
    let victims = steals(four_cpus(clock: world.clock, alloc: world.alloc))
    expect victims[0] == Some(hw::Steal(cpu: 2, tasks: 1))
    expect victims[1] == Some(hw::Steal(cpu: 0, tasks: 2))
    expect victims[2] == None
} idle_cpus_steal_nearest_work_first

test slack_follows_the_class_arming_the_deadline for Scheduler.slack {
    let world = testing::world()
    let policy = four_cpus(clock: world.clock, alloc: world.alloc)
    let slacks = hw::without_irqs(fn(t: hw::IrqsDisabled) -> Array[u64, 7] limits notrap, terminates {
        var given = Array[u64, 7].filled(0)
        given[0] = policy.slack(t, task: view(executor: 1, class: NORMAL, weight: 100), delay_ns: 1_000_000)
        given[1] = policy.slack(t, task: view(executor: 1, class: NORMAL, weight: 100), delay_ns: 1_000_000_000)
        given[2] = policy.slack(t, task: view(executor: 1, class: NORMAL, weight: 100), delay_ns: 60_000_000_000)
        given[3] = policy.slack(t, task: view(executor: 2, class: BACKGROUND, weight: 100), delay_ns: 1_000_000_000)
        given[4] = policy.slack(t, task: view(executor: 2, class: BACKGROUND, weight: 100), delay_ns: 60_000_000_000)
        given[5] = policy.slack(t, task: view(executor: 3, class: LATENCY, weight: 100), delay_ns: 1_000_000_000)
        given[6] = policy.slack(t, task: view(executor: 4, class: DEFERRABLE, weight: 1), delay_ns: 1_000)
        return given
    })
    expect slacks[0] == 50_000 and slacks[1] == 10_000_000 and slacks[2] == 100_000_000
    expect slacks[3] == 100_000_000 and slacks[4] == 1_000_000_000
    expect slacks[5] == 0 and slacks[6] == DEFERRED_SLACK_NS
} slack_follows_the_class_arming_the_deadline

/// With one MWAIT state exiting in 1 µs, a CPU whose earliest timer is 1 ms away enters it and shows it, one whose timer is 2 µs away halts, as does one whose reservations leave it 1 µs of each period; idle periods of 1.5 µs, whether a task or another idle state ends them, bring the prediction down to their mean.
test idle_cpus_enter_the_deepest_state_their_rest_and_tolerance_allow for Scheduler.idle {
    let world = testing::world()
    var places = mem::List[Place].empty(world.alloc)
    mut places.push(Place(package_id: 0, core: 0, cache: 0, node: 0))
    var states = mem::List[IdleState].empty(world.alloc)
    mut states.push(IdleState(hint: 0x20, exit_ns: 1_000))
    let state = mem::Shared.of(State.of(take places, clock: world.clock, idle_states: take states, hwp: false, alloc: world.alloc), alloc: world.alloc)
    let policy = Scheduler.of(state.share())
    let far = hw::without_irqs(fn(t: hw::IrqsDisabled) -> hw::Idle limits notrap, terminates {
        return policy.idle(t, cpu: 0, until_ns: Some(state.contents().now() + 1_000_000))
    })
    let shown = match state.contents().reading(0) {
        Some(reading) => reading.resting_in
        None => None
    }
    let near = hw::without_irqs(fn(t: hw::IrqsDisabled) -> hw::Idle limits notrap, terminates {
        return policy.idle(t, cpu: 0, until_ns: Some(state.contents().now() + 2_000))
    })
    state.contents().tolerate(0, tolerance_ns: Some(1_000))
    let tolerated = hw::without_irqs(fn(t: hw::IrqsDisabled) -> hw::Idle limits notrap, terminates {
        return policy.idle(t, cpu: 0, until_ns: Some(state.contents().now() + 1_000_000))
    })
    expect far == hw::Idle.Mwait(0x20) and near == hw::Idle.Halt and tolerated == hw::Idle.Halt
    expect shown == Some(0x20)
    var woken = idle_cpu()
    var returning = idle_cpu()
    for at in 0u64..<8 {
        mut woken.go_idle(now_ns: at * 2_000)
        discard mut woken.switch_to(view(executor: 1, class: NORMAL, weight: 100), now_ns: at * 2_000 + 1_500)
        mut returning.go_idle(now_ns: at * 1_500)
    }
    mut returning.go_idle(now_ns: 12_000)
    expect woken.predicted(now_ns: 0, until_ns: Some(1_000_000)) == Some(1_500)
    expect returning.predicted(now_ns: 12_000, until_ns: Some(1_000_000)) == Some(1_500)
} idle_cpus_enter_the_deepest_state_their_rest_and_tolerance_allow

/// With the default preferences, a CPU running `normal` work wants 128, once; `latency` work queued behind it brings 0, which running it keeps; after a rest, `background` work alone wants 255.
test cpus_want_the_lowest_preference_of_the_classes_they_run for Cpu.prefer {
    var chosen = Array[u8, 3].filled(0)
    chosen[1] = 128
    chosen[2] = 255
    let preferences = pack(chosen)
    var cpu = idle_cpu()
    discard mut cpu.enqueue(view(executor: 1, class: NORMAL, weight: 100), now_ns: 0)
    discard mut cpu.switch_to(view(executor: 1, class: NORMAL, weight: 100), now_ns: 0)
    let running_normal = mut cpu.prefer(preferences)
    let again = mut cpu.prefer(preferences)
    discard mut cpu.enqueue(view(executor: 2, class: LATENCY, weight: 100), now_ns: 10)
    let queued = mut cpu.prefer(preferences)
    discard mut cpu.switch_to(view(executor: 2, class: LATENCY, weight: 100), now_ns: 20)
    let running_latency = mut cpu.prefer(preferences)
    mut cpu.go_idle(now_ns: 30)
    discard mut cpu.enqueue(view(executor: 3, class: BACKGROUND, weight: 100), now_ns: 40)
    discard mut cpu.switch_to(view(executor: 3, class: BACKGROUND, weight: 100), now_ns: 40)
    let running_background = mut cpu.prefer(preferences)
    expect running_normal == Some(128) and again.is_none() and queued == Some(0) and running_latency.is_none() and running_background == Some(255)
} cpus_want_the_lowest_preference_of_the_classes_they_run
