//! Run queues, CPU classes, wake placement, stealing, deadline slack and idle: the policy through which NaN's runtime runs the kernel's tasks, each in the order it becomes ready and none preempted.

/// The class of the root executor's share, and so of the core's tasks.
const CORE: u8 = 0

const LATENCY: u8 = 1

const NORMAL: u8 = 2

const BACKGROUND: u8 = 3

/// The class of core work for one CPU alone, the CPU being its share's `reserve_ppm`.
const PINNED: u8 = 4

/// The class of core work whose deadlines never wake an idle machine: each passes with the next firing of another deadline, slice or pacing tick after it.
const DEFERRABLE: u8 = 5

/// The slack of a deadline of deferrable work: long enough that its window never ends first.
const DEFERRED_SLACK_NS: u64 = 0x7FFF_FFFF_FFFF_FFFF

/// The bounds of the slack of `normal` work's deadlines, 1% of their delay, and the bound of `background` work's, 10%.
const NORMAL_SLACK_MIN_NS: u64 = 50_000

const NORMAL_SLACK_MAX_NS: u64 = 100_000_000

const BACKGROUND_SLACK_MAX_NS: u64 = 1_000_000_000

/// Where a CPU lies: its last-level cache and NUMA node.
pkg struct Place derives Copy, Eq {
    pkg cache: u64
    pkg node: u32
} Place

/// What the policy and the core's tasks share: each CPU's state behind its lock, where each CPU lies, the running CPU's number and the clock.
pkg struct State {
    cpus: mem::List[hw::SpinLock[Cpu]]
    places: mem::List[Place]
    here: hw::PerCpu[u32]
    clock: sys::Clock
    started: core::atomic::AtomicBool
} State

/// The kernel's policy, whose hooks NaN's runtime calls with the CPU's interrupts disabled.
pkg struct Scheduler {
    state: mem::Shared[State]
} Scheduler

/// A CPU's run queue as the policy sees it: whether it has started and idles, and how many tasks wait on it, and how many of those are bound to it.
struct Cpu {
    started: bool
    idle: bool
    queued: u32
    bound: u32
} Cpu

/// The classes of the executors of `latency`, `normal` and `background` accounts, then of deferrable core work, in that order.
pkg fn classes() -> Array[u8, 4] {
    var table = Array[u8, 4].filled(LATENCY)
    table[1] = NORMAL
    table[2] = BACKGROUND
    table[3] = DEFERRABLE
    return table
} classes

/// The share of the executors whose tasks run on CPU `cpu` alone.
pkg fn pinned_share(cpu: u32) -> task::Share
    requires cpu <= 1_000_000
{
    return task::Share(weight: 1, class: PINNED, reserve_ppm: cpu)
} pinned_share

/// Whether work of `class` stays on the CPU it is placed on, where no steal takes it: `latency` work and core work for one CPU.
fn binds(class: u8) -> bool = class == LATENCY or class == PINNED

/// The state for `places.len()` CPUs, every CPU but the boot CPU not yet started.
pkg fn State.of(take places: mem::List[Place], clock: sys::Clock, alloc: mem::Alloc) -> State {
    var cpus = mem::List[hw::SpinLock[Cpu]].empty(alloc)
    for index in 0..<places.len() {
        mut cpus.push(hw::SpinLock.of(Cpu(started: index == 0, idle: false, queued: 0, bound: 0)))
    }
    return State(cpus: take cpus, places: take places, here: hw::PerCpu.of(init: fn(cpu: u32) => cpu, alloc), clock: clock, started: core::atomic::AtomicBool.of(false))
} State.of

/// Marks CPU `cpu` started: it runs on the shared space with its features enabled, so work may go to it.
pkg fn State.start(self, cpu: u32) {
    let Some(lock) = self.cpus.get(usize.widen(cpu)) else {
        return
    }
    hw::without_irqs(fn(t: hw::IrqsDisabled) limits notrap, terminates {
        lock.with(t, body: fn(mut state: Cpu) limits notrap, terminates, noalloc {
            state.started = true
        })
    })
} State.start

/// Marks every CPU started, from which on idle CPUs take work from others.
pkg fn State.all_started(self) {
    self.started.store(true)
} State.all_started

fn State.now(self) -> u64 limits notrap, terminates, noalloc {
    return match attempt self.clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
} State.now

/// The running CPU's number.
fn State.running_cpu(self, t: hw::IrqsDisabled) -> u32 limits notrap, terminates, noalloc {
    return self.here.with(t, body: fn(mut cpu: u32) -> u32 limits notrap, terminates, noalloc {
        return cpu
    })
} State.running_cpu

/// Whether CPU `cpu` has started and idles.
fn State.is_idle(self, t: hw::IrqsDisabled, cpu: u32) -> bool limits notrap, terminates, noalloc {
    let Some(lock) = self.cpus.get(usize.widen(cpu)) else {
        return false
    }
    return lock.with(t, body: fn(mut state: Cpu) -> bool limits notrap, terminates, noalloc {
        return state.started and state.idle
    })
} State.is_idle

/// Whether CPU `cpu` has started.
fn State.is_started(self, t: hw::IrqsDisabled, cpu: u32) -> bool limits notrap, terminates, noalloc {
    let Some(lock) = self.cpus.get(usize.widen(cpu)) else {
        return false
    }
    return lock.with(t, body: fn(mut state: Cpu) -> bool limits notrap, terminates, noalloc {
        return state.started
    })
} State.is_started

/// The CPU a woken task goes to: the CPU it last ran on when that CPU idles, else an idle CPU sharing that CPU's last-level cache, else the waker's CPU, which also stands as the last CPU of a task that never ran.
fn State.wake_cpu(self, t: hw::IrqsDisabled, previous: Option[u32], waker: u32) -> u32 limits notrap, terminates, noalloc {
    let last = previous.value_or(waker)
    if self.is_idle(t, cpu: last) {
        return last
    }
    let Some(place) = self.places.get(usize.widen(last)) else {
        return waker
    }
    for index in 0..<self.places.len() {
        let Some(other) = self.places.get(index) else {
            continue
        }
        let cpu = u32.truncate(index)
        if other.cache == place.cache and self.is_idle(t, cpu) {
            return cpu
        }
    }
    return waker
} State.wake_cpu

/// Adds `task` to CPU `cpu`'s queue.
fn State.enqueue(self, t: hw::IrqsDisabled, cpu: u32, task: hw::TaskView) limits notrap, terminates, noalloc {
    let Some(lock) = self.cpus.get(usize.widen(cpu)) else {
        return
    }
    lock.with(t, body: fn(mut state: Cpu) limits notrap, terminates, noalloc {
        mut state.enqueue(task)
    })
} State.enqueue

impl Scheduler: hw::Policy

/// The policy over `state`, which the core's tasks share.
pkg fn Scheduler.of(take state: mem::Shared[State]) -> Scheduler = Scheduler(state: take state)

/// Places `task` with a key that grows with the time it becomes ready, so that tasks run in that order and a wake never preempts the running task.
pkg fn Scheduler.place(self, t: hw::IrqsDisabled, task: hw::TaskView) -> hw::Placement limits notrap, terminates, noalloc, stack 4_096 {
    let state = self.state.contents()
    var here = state.running_cpu(t)
    if not state.is_started(t, cpu: here) {
        here = 0
    }
    var target = here
    if task.share.class == PINNED {
        target = task.share.reserve_ppm
    } else {
        target = state.wake_cpu(t, previous: task.last_cpu, waker: here)
    }
    state.enqueue(t, cpu: target, task)
    return hw::Placement(cpu: target, key: state.now(), bound: binds(task.share.class))
} Scheduler.place

pkg fn Scheduler.steal(self, t: hw::IrqsDisabled, cpu: u32, round: u32) -> Option[hw::Steal] limits notrap, terminates, noalloc, stack 4_096 {
    let state = self.state.contents()
    if round != 0 or not state.started.load() {
        return None
    }
    let Some(place) = state.places.get(usize.widen(cpu)) else {
        return None
    }
    var best: Option[hw::Steal] = None
    var best_tier: u8 = 3
    for index in 0..<state.places.len() {
        let other = u32.truncate(index)
        let Some(lock) = state.cpus.get(index) else {
            continue
        }
        let Some(spot) = state.places.get(index) else {
            continue
        }
        let unbound = lock.with(t, body: fn(mut victim: Cpu) -> u32 limits notrap, terminates, noalloc {
            if not victim.started {
                return 0
            }
            return victim.queued.saturating_sub(victim.bound)
        })
        var tier: u8 = 2
        if spot.cache == place.cache {
            tier = 0
        } else if spot.node == place.node {
            tier = 1
        }
        let busier = match best {
            Some(steal) => tier < best_tier or (tier == best_tier and unbound > steal.tasks)
            None => true
        }
        if other != cpu and unbound > 0 and busier {
            best = Some(hw::Steal(cpu: other, tasks: unbound))
            best_tier = tier
        }
    }
    return best
} Scheduler.steal

/// Gives no slice: a task runs until it suspends.
pkg fn Scheduler.slice(self, t: hw::IrqsDisabled, cpu: u32, task: hw::TaskView) -> u64 limits notrap, terminates, noalloc, stack 4_096 {
    let Some(lock) = self.state.contents().cpus.get(usize.widen(cpu)) else {
        return 0
    }
    lock.with(t, body: fn(mut current: Cpu) limits notrap, terminates, noalloc {
        mut current.switch_to(task)
    })
    return 0
} Scheduler.slice

/// The slack of a deadline `delay_ns` ahead by the class of the work arming it: 1% of the delay, from 50 µs to 100 ms, for `normal` work, 10% up to 1 s for `background` work, a window that never ends first for deferrable work, and none for the rest.
pkg fn Scheduler.slack(self, t: hw::IrqsDisabled, task: hw::TaskView, delay_ns: u64) -> u64 limits notrap, terminates, noalloc, stack 4_096 {
    return match task.share.class {
        NORMAL => bounded(delay_ns / 100, low: NORMAL_SLACK_MIN_NS, high: NORMAL_SLACK_MAX_NS)
        BACKGROUND => bounded(delay_ns / 10, low: 0, high: BACKGROUND_SLACK_MAX_NS)
        DEFERRABLE => DEFERRED_SLACK_NS
        else => 0
    }
} Scheduler.slack

/// `value` held between `low` and `high`.
fn bounded(value: u64, low: u64, high: u64) -> u64 limits notrap, terminates, noalloc {
    if value < low {
        return low
    }
    if value > high {
        return high
    }
    return value
} bounded

pkg fn Scheduler.idle(self, t: hw::IrqsDisabled, cpu: u32, until_ns: Option[u64]) -> hw::Idle limits notrap, terminates, noalloc, stack 4_096 {
    let Some(lock) = self.state.contents().cpus.get(usize.widen(cpu)) else {
        return hw::Idle.Halt
    }
    lock.with(t, body: fn(mut current: Cpu) limits notrap, terminates, noalloc {
        mut current.go_idle()
    })
    return hw::Idle.Halt
} Scheduler.idle

/// Adds `task` to this CPU's queue.
fn Cpu.enqueue(mut self, task: hw::TaskView) limits notrap, terminates, noalloc {
    self.queued = self.queued.saturating_add(1)
    self.idle = false
    if binds(task.share.class) {
        self.bound = self.bound.saturating_add(1)
    }
} Cpu.enqueue

/// Switches this CPU to `task`, which leaves its queue.
fn Cpu.switch_to(mut self, task: hw::TaskView) limits notrap, terminates, noalloc {
    self.queued = self.queued.saturating_sub(1)
    if binds(task.share.class) {
        self.bound = self.bound.saturating_sub(1)
    }
    self.idle = false
} Cpu.switch_to

/// Makes this CPU idle: its queue is empty.
fn Cpu.go_idle(mut self) limits notrap, terminates, noalloc {
    self.idle = true
    self.queued = 0
    self.bound = 0
} Cpu.go_idle

fn view(executor: u64, class: u8, weight: u32) -> hw::TaskView {
    return hw::TaskView(task: executor, executor: executor, share: task::Share(weight: weight, class: class, reserve_ppm: 0), last_cpu: None, ran_ns: 0, deadline_ns: None)
} view

/// A policy over four started CPUs: CPUs 0 and 1 share a cache, CPUs 2 and 3 another, all on node 0.
fn four_cpus(clock: sys::Clock, alloc: mem::Alloc) -> Scheduler {
    var places = mem::List[Place].empty(alloc)
    for cpu in 0u64..<4 {
        mut places.push(Place(cache: cpu / 2, node: 0))
    }
    let state = mem::Shared.of(State.of(take places, clock, alloc), alloc)
    for cpu in 1u32..<4 {
        state.contents().start(cpu)
    }
    state.contents().all_started()
    return Scheduler.of(take state)
} four_cpus

fn last_on(cpu: u32, executor: u64) -> hw::TaskView {
    var task = view(executor, class: NORMAL, weight: 100)
    task.last_cpu = Some(cpu)
    return task
} last_on

/// The CPUs the policy gives four wakes while CPU 0 runs a task and the others idle: back to idle CPU 2, then from busy CPU 0 to its idle cache sibling 1, then, with no idle CPU left in that cache, to the waker's CPU 0, and a pinned task to its CPU.
fn placements(policy: Scheduler) -> Array[u32, 4] {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> Array[u32, 4] limits notrap, terminates {
        discard policy.slice(t, cpu: 0, task: view(executor: 0, class: CORE, weight: 1))
        for cpu in 1u32..<4 {
            discard policy.idle(t, cpu, until_ns: None)
        }
        var cpus = Array[u32, 4].filled(9)
        cpus[0] = policy.place(t, task: last_on(cpu: 2, executor: 5)).cpu
        cpus[1] = policy.place(t, task: last_on(cpu: 0, executor: 6)).cpu
        cpus[2] = policy.place(t, task: last_on(cpu: 0, executor: 7)).cpu
        let fixed = hw::TaskView(task: 8, executor: 8, share: pinned_share(3), last_cpu: None, ran_ns: 0, deadline_ns: None)
        cpus[3] = policy.place(t, task: fixed).cpu
        return cpus
    })
} placements

test wakes_go_to_idle_cpus_near_their_last for Scheduler.place {
    let world = testing::world()
    let cpus = placements(four_cpus(clock: world.clock, alloc: world.alloc))
    expect cpus[0] == 2
    expect cpus[1] == 1
    expect cpus[2] == 0
    expect cpus[3] == 3
} wakes_go_to_idle_cpus_near_their_last

/// What idle CPUs 3 and 1 steal once work waits on CPUs 0 and 2, CPU 2's pinned task never counting, and CPU 1's second round.
fn steals(policy: Scheduler) -> Array[Option[hw::Steal], 3] {
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> Array[Option[hw::Steal], 3] limits notrap, terminates {
        for cpu in 0u32..<4 {
            discard policy.idle(t, cpu, until_ns: None)
        }
        let state = policy.state.contents()
        state.enqueue(t, cpu: 0, task: view(executor: 5, class: NORMAL, weight: 100))
        state.enqueue(t, cpu: 0, task: view(executor: 6, class: NORMAL, weight: 100))
        state.enqueue(t, cpu: 2, task: view(executor: 7, class: NORMAL, weight: 100))
        state.enqueue(t, cpu: 2, task: hw::TaskView(task: 8, executor: 8, share: pinned_share(2), last_cpu: None, ran_ns: 0, deadline_ns: None))
        var victims = Array[Option[hw::Steal], 3].filled(None)
        victims[0] = policy.steal(t, cpu: 3, round: 0)
        victims[1] = policy.steal(t, cpu: 1, round: 0)
        victims[2] = policy.steal(t, cpu: 1, round: 1)
        return victims
    })
} steals

test idle_cpus_steal_nearest_work_first for Scheduler.steal {
    let world = testing::world()
    let victims = steals(four_cpus(clock: world.clock, alloc: world.alloc))
    expect victims[0] == Some(hw::Steal(cpu: 2, tasks: 1))
    expect victims[1] == Some(hw::Steal(cpu: 0, tasks: 2))
    expect victims[2] == None
} idle_cpus_steal_nearest_work_first

test slack_follows_the_class_arming_the_deadline for Scheduler.slack {
    let world = testing::world()
    let policy = four_cpus(clock: world.clock, alloc: world.alloc)
    let slacks = hw::without_irqs(fn(t: hw::IrqsDisabled) -> Array[u64, 7] limits notrap, terminates {
        var given = Array[u64, 7].filled(0)
        given[0] = policy.slack(t, task: view(executor: 1, class: NORMAL, weight: 100), delay_ns: 1_000_000)
        given[1] = policy.slack(t, task: view(executor: 1, class: NORMAL, weight: 100), delay_ns: 1_000_000_000)
        given[2] = policy.slack(t, task: view(executor: 1, class: NORMAL, weight: 100), delay_ns: 60_000_000_000)
        given[3] = policy.slack(t, task: view(executor: 2, class: BACKGROUND, weight: 100), delay_ns: 1_000_000_000)
        given[4] = policy.slack(t, task: view(executor: 2, class: BACKGROUND, weight: 100), delay_ns: 60_000_000_000)
        given[5] = policy.slack(t, task: view(executor: 3, class: LATENCY, weight: 100), delay_ns: 1_000_000_000)
        given[6] = policy.slack(t, task: view(executor: 4, class: DEFERRABLE, weight: 1), delay_ns: 1_000)
        return given
    })
    expect slacks[0] == 50_000 and slacks[1] == 10_000_000 and slacks[2] == 100_000_000
    expect slacks[3] == 100_000_000 and slacks[4] == 1_000_000_000
    expect slacks[5] == 0 and slacks[6] == DEFERRED_SLACK_NS
} slack_follows_the_class_arming_the_deadline

/// A core task made ready, then a `latency` one: the later never gets the smaller key, so it never preempts the earlier, and no task gets a slice.
test wakes_never_preempt for Scheduler.place {
    let world = testing::world()
    let policy = four_cpus(clock: world.clock, alloc: world.alloc)
    let seen = hw::without_irqs(fn(t: hw::IrqsDisabled) -> Array[u64, 3] limits notrap, terminates {
        var given = Array[u64, 3].filled(0)
        given[0] = policy.place(t, task: view(executor: 1, class: CORE, weight: 1)).key
        given[1] = policy.place(t, task: view(executor: 2, class: LATENCY, weight: 100)).key
        given[2] = policy.slice(t, cpu: 0, task: view(executor: 2, class: LATENCY, weight: 100))
        return given
    })
    expect seen[0] <= seen[1] and seen[2] == 0
} wakes_never_preempt
