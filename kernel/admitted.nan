//! The base bundle's admission record, which genesis writes at `/sys/code/<bundle>`.

/// The canonical path of admission records.
const ADMISSION_TYPE: Str = "code::Admission"

/// The root package of the base bundle.
const BASE_ROOT: Str = "kernel"

/// The admission record of the base bundle as the running kernel knows it, typed: each base component with its state schema, protocol, operations' bounds and configuration type, provenance `vendor`, shared, and its image the kernel image of blob id `bundle`, exporting `support` and spanning `image_bytes`, lowered at the base set of x86_64. What only the build's artefacts tell, its packages, digest lines, Env fields, closure summary and toolchain, is empty, the toolchain hash all zeros.
fn Base.admission(self, alloc: mem::Alloc) -> store::service::TypedValue {
    var components = mem::List[code::Component].empty(alloc)
    mut components.push(self.component(SUPERVISOR, state: mem::wire::Codec[supervisor::Supervision].schema_hash(), alloc))
    mut components.push(self.component(DEVICES, state: mem::wire::Codec[devices::Manager].schema_hash(), alloc))
    mut components.push(self.component(VIEW, state: mem::wire::Codec[devices::View].schema_hash(), alloc))
    mut components.push(self.component(FAT, state: mem::wire::Codec[fat::Files].schema_hash(), alloc))
    mut components.push(self.component(VIRTIO_RNG, state: mem::wire::Codec[drivers::virtio::Rng].schema_hash(), alloc))
    mut components.push(self.component(VIRTIO_BLK, state: mem::wire::Codec[drivers::virtio::Blk].schema_hash(), alloc))
    mut components.push(self.component(NVME, state: mem::wire::Codec[drivers::nvme::Nvme].schema_hash(), alloc))
    mut components.push(self.component(AML_EVALUATOR, state: mem::wire::Codec[devices::aml::Evaluator].schema_hash(), alloc))
    mut components.push(self.component(UART_DRIVER, state: mem::wire::Codec[drivers::uart::Uart].schema_hash(), alloc))
    mut components.push(self.component(CMOS_DRIVER, state: mem::wire::Codec[drivers::cmos::Cmos].schema_hash(), alloc))
    mut components.push(self.component(AHCI, state: mem::wire::Codec[drivers::ahci::Ahci].schema_hash(), alloc))
    mut components.push(self.component(STORE_SERVICE, state: mem::wire::Codec[store::service::Service].schema_hash(), alloc))
    mut components.push(self.component(JOURNAL, state: mem::wire::Codec[journal::Recorder].schema_hash(), alloc))
    mut components.push(self.component(KEYS, state: mem::wire::Codec[keys::Keyring].schema_hash(), alloc))
    mut components.push(self.component(POLICY, state: mem::wire::Codec[policy::Overseer].schema_hash(), alloc))
    mut components.push(self.component(GENERATIONS, state: mem::wire::Codec[generations::Boot].schema_hash(), alloc))
    mut components.push(self.component(TIMEKEEPER, state: mem::wire::Codec[clock::Timekeeper].schema_hash(), alloc))
    mut components.push(self.component(POWER, state: mem::wire::Codec[power::Powering].schema_hash(), alloc))
    mut components.push(self.component(LINKER, state: mem::wire::Codec[link::Linker].schema_hash(), alloc))
    mut components.push(self.component(DESK, state: mem::wire::Codec[console::Desk].schema_hash(), alloc))
    mut components.push(self.component(ADMISSION, state: mem::wire::Codec[admission::Admitter].schema_hash(), alloc))
    let unknown = ident::HashValue(bytes: Array[u8, 33].filled(0))
    let record = code::Admission(
        root: text::String.of(BASE_ROOT, alloc),
        packages: mem::List.empty(alloc),
        components: take components,
        program: None,
        authority: mem::List.empty(alloc),
        escapes: mem::List.empty(alloc),
        contributions: mem::List.empty(alloc),
        provenance: os::Provenance.Vendor,
        shared: true,
        check: code::CodeCheck.Verified(toolchain: unknown),
        image: code::Lowered(level: code::Level.X86v1, toolchain: unknown, support: self.support, image: self.bundle, code_bytes: self.image_bytes),
        admitted: ident::CommitId(number: 0),
    )
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[code::Admission].encode(record, out: mut bytes)
    return store::service::TypedValue(type: store::TypeRef.of(ADMISSION_TYPE, schema: mem::wire::Codec[code::Admission].schema_hash(), alloc), bytes: take bytes)
} Base.admission

/// The base component of state type `component` and state schema `state` as the kernel image runs it.
fn Base.component(self, component: Str, state: mem::wire::SchemaHash, alloc: mem::Alloc) -> code::Component {
    var protocol = ident::HashValue(bytes: Array[u8, 33].filled(0))
    var operations = mem::List[code::Operation].empty(alloc)
    match self.schema(component, alloc) {
        Some(served) => {
            protocol = ident::HashValue(bytes: served.hash.bytes)
            for operation in served.operations {
                mut operations.push(code::Operation.of_schema(operation, alloc))
            }
        }
        None => {
        }
    }
    let config = match config_type(component) {
        Some(name) => Some(text::String.of(name.as_str(), alloc))
        None => None
    }
    return code::Component(state: text::String.of(component, alloc), schema: ident::HashValue(bytes: state.bytes), protocol: protocol, operations: take operations, env: mem::List.empty(alloc), config: take config)
} Base.component
