//! The admission records of the base bundle and of the base jobs, which genesis writes at `/sys/code/<hash>`.

/// The canonical path of admission records.
const ADMISSION_TYPE: Str = "code::Admission"

/// The root package of the base bundle.
const BASE_ROOT: Str = "kernel"

/// The admission record of the base bundle as the running kernel knows it, typed: each base component with its state schema, protocol, operations' bounds and configuration type.
fn Base.admission(self, alloc: mem::Alloc) -> store::service::TypedValue {
    var components = mem::List[code::Component].empty(alloc)
    for state in base_states(alloc) {
        mut components.push(self.component(state.path.as_str(), state: state.schema, alloc))
    }
    return self.record(root: BASE_ROOT, take components, program: None, alloc)
} Base.admission

/// The schema tree of each base component's state.
fn base_states(alloc: mem::Alloc) -> mem::List[code::Tree] {
    var states = mem::List[code::Tree].empty(alloc)
    mut states.push(code::Tree.of(SUPERVISOR, schema: mem::wire::Codec[supervisor::Supervision].schema(alloc), alloc))
    mut states.push(code::Tree.of(DEVICES, schema: mem::wire::Codec[devices::Manager].schema(alloc), alloc))
    mut states.push(code::Tree.of(VIEW, schema: mem::wire::Codec[devices::View].schema(alloc), alloc))
    mut states.push(code::Tree.of(FAT, schema: mem::wire::Codec[fat::Files].schema(alloc), alloc))
    mut states.push(code::Tree.of(VIRTIO_RNG, schema: mem::wire::Codec[drivers::virtio::Rng].schema(alloc), alloc))
    mut states.push(code::Tree.of(VIRTIO_BLK, schema: mem::wire::Codec[drivers::virtio::Blk].schema(alloc), alloc))
    mut states.push(code::Tree.of(NVME, schema: mem::wire::Codec[drivers::nvme::Nvme].schema(alloc), alloc))
    mut states.push(code::Tree.of(AML_EVALUATOR, schema: mem::wire::Codec[devices::aml::Evaluator].schema(alloc), alloc))
    mut states.push(code::Tree.of(UART_DRIVER, schema: mem::wire::Codec[drivers::uart::Uart].schema(alloc), alloc))
    mut states.push(code::Tree.of(CMOS_DRIVER, schema: mem::wire::Codec[drivers::cmos::Cmos].schema(alloc), alloc))
    mut states.push(code::Tree.of(AHCI, schema: mem::wire::Codec[drivers::ahci::Ahci].schema(alloc), alloc))
    mut states.push(code::Tree.of(STORE_SERVICE, schema: mem::wire::Codec[store::service::Service].schema(alloc), alloc))
    mut states.push(code::Tree.of(JOURNAL, schema: mem::wire::Codec[journal::Recorder].schema(alloc), alloc))
    mut states.push(code::Tree.of(KEYS, schema: mem::wire::Codec[keys::Keyring].schema(alloc), alloc))
    mut states.push(code::Tree.of(POLICY, schema: mem::wire::Codec[policy::Overseer].schema(alloc), alloc))
    mut states.push(code::Tree.of(GENERATIONS, schema: mem::wire::Codec[generations::Boot].schema(alloc), alloc))
    mut states.push(code::Tree.of(TIMEKEEPER, schema: mem::wire::Codec[clock::Timekeeper].schema(alloc), alloc))
    mut states.push(code::Tree.of(POWER, schema: mem::wire::Codec[power::Powering].schema(alloc), alloc))
    mut states.push(code::Tree.of(LINKER, schema: mem::wire::Codec[link::Linker].schema(alloc), alloc))
    mut states.push(code::Tree.of(DESK, schema: mem::wire::Codec[console::Desk].schema(alloc), alloc))
    mut states.push(code::Tree.of(ADMISSION, schema: mem::wire::Codec[admission::Admitter].schema(alloc), alloc))
    return states
} base_states

/// The admission record of a closure of the kernel image rooted at `root`, exporting `components` or the program `program`, provenance `vendor`, shared, and its image the kernel image of blob id `bundle`, exporting `support` and spanning `image_bytes`, lowered at the base set of x86_64; what only the build's artefacts tell is empty, the toolchain hash `HashValue.zero`.
fn Base.record(
    self,
    root: Str,
    take components: mem::List[code::Component],
    take program: Option[code::Program],
    alloc: mem::Alloc,
    ) -> store::service::TypedValue {
    let unknown = ident::HashValue.zero()
    let record = code::Admission(
        root: text::String.of(root, alloc),
        packages: mem::List.empty(alloc),
        components: take components,
        program: take program,
        authority: mem::List.empty(alloc),
        escapes: mem::List.empty(alloc),
        contributions: mem::List.empty(alloc),
        provenance: os::Provenance.Vendor,
        shared: true,
        check: code::CodeCheck.Verified(toolchain: unknown),
        image: code::Lowered(level: code::Level.X86v1, toolchain: unknown, support: self.support, image: self.bundle, code_bytes: self.image_bytes),
        admitted: ident::CommitId(number: 0),
    )
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[code::Admission].encode(record, out: mut bytes)
    return store::service::TypedValue(type: store::TypeRef.of(ADMISSION_TYPE, schema: mem::wire::Codec[code::Admission].schema_hash(), alloc), bytes: take bytes)
} Base.record

/// The base component of state type `component` and state schema `state` as the kernel image runs it.
fn Base.component(self, component: Str, state: ident::HashValue, alloc: mem::Alloc) -> code::Component {
    var protocol = ident::HashValue.zero()
    var operations = mem::List[code::Operation].empty(alloc)
    match self.schema(component, alloc) {
        Some(served) => {
            protocol = ident::HashValue(bytes: served.hash.bytes)
            for operation in served.operations {
                mut operations.push(code::Operation.of_schema(operation, alloc))
            }
        }
        None => {
        }
    }
    let config = match config_type(component) {
        Some(name) => Some(text::String.of(name.as_str(), alloc))
        None => None
    }
    return code::Component(state: text::String.of(component, alloc), schema: state, protocol: protocol, operations: take operations, env: mem::List.empty(alloc), config: take config, earlier: mem::List.empty(alloc), flexible: false)
} Base.component
