//! The NaN OS kernel.

package kernel {
    language 1
    targets x86_64-bare
    entry main
    dep acpi "../acpi"
    dep bootfmt "../bootfmt"
    dep devices "../devices"
    dep drivers "../drivers"
    dep fat "../fat"
    dep ident "../ident"
    dep journal "../journal"
    dep keys "../keys"
    dep os "../os"
    dep runner "../runner"
    dep store "../store"
    dep supervisor "../supervisor"
    allow capability in random
    allow confined in keeper
    allow contribute devices::drivers in drivers
    allow device in drivers, kernel
    allow priv in cpu, spaces
    allow trusted in cpu, kernel, spaces
    allow validate in acpi, bootfmt, devices, drivers, fat, ident, journal, keeper, kernel, keys, os, runner, store, supervisor
} kernel
