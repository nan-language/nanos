//! The NaN OS kernel.

package kernel {
    language 1
    targets x86_64-bare
    entry main
    dep acpi "../acpi"
    dep bootfmt "../bootfmt"
    dep ident "../ident"
    dep os "../os"
    dep runner "../runner"
    dep supervisor "../supervisor"
    allow device in kernel
    allow priv in cpu, spaces
    allow trusted in cpu, kernel, spaces
    allow validate in acpi, bootfmt, ident, kernel, os, runner, supervisor
} kernel
