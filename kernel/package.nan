//! The NaN OS kernel.

package kernel {
    language 1
    targets x86_64-bare
    entry main
    dep acpi "../acpi"
    dep admission "../admission"
    dep bootfmt "../bootfmt"
    dep clock "../clock"
    dep code "../code"
    dep console "../console"
    dep devices "../devices"
    dep drivers "../drivers"
    dep fat "../fat"
    dep generations "../generations"
    dep ident "../ident"
    dep journal "../journal"
    dep keys "../keys"
    dep link "../link"
    dep os "../os"
    dep policy "../policy"
    dep power "../power"
    dep replay "../jobs/replay"
    dep runner "../runner"
    dep scrub "../jobs/scrub"
    dep selftest "../jobs/selftest"
    dep store "../store"
    dep supervisor "../supervisor"
    allow capability in loading, random, toolchain
    allow contribute devices::drivers in drivers
    allow device in drivers, keeper, kernel
    allow priv in cpu, spaces
    allow trusted in cpu, kernel, loading, spaces, toolchain
    allow validate in acpi, admission, bootfmt, clock, code, console, devices, drivers, fat, generations, ident, journal, keeper, kernel, keys, link, os, policy, power, replay, runner, scrub, selftest, store, supervisor, toolchain
} kernel
