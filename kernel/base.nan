    let task::Channel(sender: runs, receiver: run_orders) = task::Channel[code::Run].bounded(1, alloc: config.alloc)
    let toolchains = minted_toolchain(shipped, runs, alloc: config.alloc)
    defer close_toolchains(take toolchains)
    defer close_shipped(take keyring)
    defer close_shipped(take passed)
    defer take interfaces.close()
    var spaces = spaces_of(shipped, mut frames, alloc: heap)
    defer mut frames.take_back(take spaces)
    var isolated = mem::List[hw::PhysFrame[4_096]].empty(heap)
    defer mut frames.take_back(take isolated)
    let task::Channel(sender: placing, receiver: placed) = task::Channel[isolation::Input].bounded(16, alloc: config.alloc)
    let placings = isolation::MintedSpaces.of(placing, clock: config.clock, alloc: config.alloc)
    defer take placings.close()
    var unplaced = Some(take placed)
    var pool = cells
    defer take pool.close()
    let task::Channel(sender: orders, receiver: ordered) = task::Channel[devices::RootOrder].bounded(16, alloc: config.alloc)
    let task::Channel(sender: reported, receiver: reports) = task::Channel[store::service::Report].bounded(16, alloc: config.alloc)
    let task::Channel(sender: granted, receiver: granting) = task::Channel[os::Granted].bounded(1, alloc: config.alloc)
    let task::Channel(sender: posted, receiver: postings) = task::Channel[os::Posting].bounded(16, alloc: config.alloc)
    let task::Channel(sender: switched, receiver: switches) = task::Channel[power::Switching].bounded(1, alloc: config.alloc)
    let task::Channel(sender: accounted, receiver: accounting) = task::Channel[os::AccountOrder].bounded(16, alloc: config.alloc)
    let task::Channel(sender: transferred, receiver: transfers) = task::Channel[os::Transfer].bounded(TRANSFER_ROOM, alloc: config.alloc)
    let loading::Channels(loads: loads, load_orders: load_orders, registered: registered, registry_orders: registry_orders) = loading::Channels.of(room: LOAD_ROOM, alloc: config.alloc)
    let task::Channel(sender: tracings, receiver: traced) = task::Channel[mem::List[journal::TracedInstance]].bounded(1, alloc: config.alloc)
    let task::Channel(sender: armings, receiver: arming) = task::Channel[journal::Arming].bounded(1, alloc: config.alloc)
    let backlog = journal::Backlog.of(tracings, armings, principals: rings.principals(), alloc: config.alloc)
    let lives = Roots.of(orders, reported, posted, switched, accounted, take transferred, loads, registered, backlog, monikers: rings.monikers(), alloc: config.alloc)
    defer take lives.close()
    let task::Channel(sender: logs, receiver: logged) = task::Channel[journal::Logged].bounded(LOG_ROOM, alloc: config.alloc)
    let base = Base(root: lives.root.mint(claim: false), claims: lives.root.mint(claim: true), bundle: bundle, support: support, image_bytes: fixed.image, boot: boot, isa: isa, reporter: lives.reporter.mint(), store_live: lives.store.mint(), devices_live: lives.devices.mint(), wall: config.wall, handoff: handoff, feed: lives.feed.mint(), keys_live: lives.keys.mint(), boot_live: lives.boot.mint(), machine: machine, switch: lives.switch.mint(), sessions_live: lives.sessions.mint(), plans_live: lives.plans.mint(), callers: lives.callers.mint(), accounts: lives.accounts.mint(), meter: lives.meter.mint(), loading: lives.loading.mint(), spaces: Some(placings.mint()), registries: lives.registries.mint(), jobs: genesis::Jobs.of(bundle, tree: toolchain_tree(shipped), alloc: config.alloc), genesis: mint_shipped(passed), toolchain: mint_toolchain(toolchains), keyring: mint_shipped(keyring), kernel: interfaces.mint())
    var requested = incoming
    let counters = Counters.of(requests.split(), alloc: config.alloc)
    let lending = requests.split()
    var given = Some(Given(known: take known, machine: Resources(requests: take requests, cpus: cpus.share(), alloc: config.alloc), keeper: take keeper, orders: take ordered, store_events: take reports, granted: take granted, granting: take granting, postings: take postings, switches: take switches, logged: take logged, traced: take traced, arming: take arming, accounting: take accounting, transfers: take transfers, loads: take load_orders, registry_orders: take registry_orders, loader: take loader, runs: take run_orders))
    defer abandon_given(take given)
    let scoped = attempt await task::scope(config.exec, body: fn[mut frames, mut given, mut requested, mut pool, mut spaces, mut isolated, mut unplaced](s: task::Scope) fails task::Cancelled uses wait {
        let Some(Given(known: genesis, machine: resources, keeper: held, orders: root_orders, store_events: store_events, granted: grants_out, granting: grants_in, postings: board, switches: switch_orders, logged: log_records, traced: tracing, arming: arming_orders, accounting: account_orders, transfers: transfer_records, loads: bundle_orders, registry_orders: registering, loader: bundles, runs: toolchain_runs)) = mut given.extract() else {
            return
        }
        let origin = Origin.of(handoff, clock: config.clock, wall: config.wall)
        let gauges = runner::Gauges.empty(alloc: config.alloc)
        let reading = gauges.share()
        let metering = gauges.share()
        discard s.spawn(fn[take metering, take transfer_records]() fails task::Cancelled uses wait limits stack 32_768 {
            try await keep_metrics(metering, transfers: take transfer_records, backlog, cpus, config)
        })
        discard s.spawn(fn[take board, take reading]() fails task::Cancelled uses wait limits stack 32_768 {
            try await serve_board(take board, origin, machine, security: security_of(handoff, machine, alloc: config.alloc), cpus, gauges: reading, memory: counters, exec: config.exec, alloc: config.alloc)
        })
        discard s.spawn(fn() fails task::Cancelled uses wait limits stack 8_192 {
            try await tend_cpus(cpu, cpus, rapl, clock: config.clock, exec: config.exec, alloc: config.alloc)
        })
        discard s.spawn(fn() fails task::Cancelled uses wait limits stack 16_384 {
            try await print_events(rings, backlog, exec: config.exec, alloc: config.alloc)
        })
        discard s.spawn(fn[take store_events, take grants_out]() fails task::Cancelled uses wait limits stack 8_192 {
            try await record_store_events(take store_events, rings, blob_cache: counters.blob_cache.share(), store_cache: counters.store_cache.share(), granted: take grants_out)
        })
        discard s.spawn(fn[take switch_orders]() fails task::Cancelled uses wait limits stack 4_096 {
