//! The base instances: the components the kernel image holds, and its genesis record of their specifications and grants.

/// The log records instances hand to the core that it takes in at once.
const LOG_ROOM: usize = 256

/// The orders of loading that wait for the core to carry them out.
const LOAD_ROOM: usize = 16

/// The transfers drivers charge that wait for the core to fold them.
const TRANSFER_ROOM: usize = 256

/// How long after the core's start `store`, `keys`, `journal` and `policy` may take to run.
const BASE_DEADLINE_NS: u64 = 30_000_000_000

/// The base components, by the canonical path of their state type: what they reach of the core is the device root, its claiming copy, the bundle the image's instances run, the hash of the support routines the image exports, the bytes the image spans, the boot volume the handoff record names, where the MADT routes each ISA interrupt, where the store reports its events, the wall clock, the handoff record, the feed of the core rings, where `keys` publishes its part of `/live/security` and `boot` `/live/boot`, the machine's measured facts, the switch of the machine's power, where `link` publishes `/live/sessions` and learns the instances calling it, the loader of jobs' bundles, the load-time registries, the genesis record the loader passed, the `keyring` bundle the generation ships, and the kernel's interface file.
struct Base derives Copy {
    root: devices::Root
    claims: devices::Root
    bundle: ident::HashValue
    support: ident::HashValue
    image_bytes: u64
    boot: devices::BootVolume
    isa: Array[acpi::IsaRoute, 16]
    reporter: store::service::Reporter
    store_live: os::Live
    devices_live: os::Live
    wall: ident::Wall
    handoff: bootfmt::Handoff
    feed: journal::Feed
    keys_live: os::Live
    boot_live: os::Live
    machine: os::Machine
    switch: power::Switch
    sessions_live: os::Live
    plans_live: os::Live
    callers: os::Callers
    accounts: os::Accounts
    meter: os::Meter
    loading: loading::Loading
    spaces: Option[isolation::Spaces]
    registries: devices::Registries
    jobs: genesis::Jobs
    genesis: Option[loading::Shipped]
    toolchain: Option[code::Toolchain]
    keyring: Option[loading::Shipped]
    kernel: code::Interface
} Base

impl Base: runner::Components

fn Base.protocols(self, component: Str) -> Option[os::Protocols] = genesis::protocols(component)

/// The protocol schema each base component serves.
fn Base.schema(self, component: Str, alloc: mem::Alloc) -> Option[sys::ProtocolSchema] {
    return genesis::schema(component, alloc)
} Base.schema

/// Whether the component's Env draws only on its world: `policy`'s and `clock`'s.
fn Base.forkable(self, component: Str) -> bool = component == genesis::POLICY or component == genesis::TIMEKEEPER

fn Base.state(self, component: Str, alloc: mem::Alloc) -> Option[ident::HashValue] {
    for tree in genesis::base_states(alloc) {
        if tree.path.as_str() == component {
            return Some(tree.schema)
        }
    }
    return None
} Base.state

/// Whether the component's Env takes a configuration record.
fn Base.configured(self, component: Str) -> bool {
    return genesis::config_type(component).is_some()
} Base.configured

fn Base.serve(self, component: Str, take world: nanos::World, take serving: runner::Serving) -> Result[runner::Ended, sys::Trap] fails task::Cancelled uses wait {
    if component == genesis::KEYS {
        return try await self.serve_keys(take world, take serving)
    }
    return Ok(try await self.served(component, take world, take serving))
} Base.serve

/// Runs an instance of the component of the kernel image `component`.
fn Base.served(self, component: Str, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    if component == genesis::DEVICES {
        let Ok(control) = attempt nanos::Cap[os::Control].get(world.caps, key: "control") else {
            return runner::Ended.EnvIncomplete
        }
        let Ok(handle) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "fat") else {
            return runner::Ended.EnvIncomplete
        }
        let Some(files) = os::Port[devices::Fat].of(handle) else {
            return runner::Ended.EnvIncomplete
        }
        let env = devices::Env(root: self.root, control: control, bundle: self.bundle, boot: self.boot, clock: world.clock, files: files, live: self.devices_live, exec: world.exec, alloc: world.alloc)
        return try await runner::Driven[devices::Manager, devices::Env, devices::Devices].run(take env, exec: world.exec, alloc: world.alloc, take serving, peers: mem::List.empty(world.alloc), release: fn(take ended: devices::Env) limits stack 512 {
        })
    }
    if component == genesis::VIEW {
        let exec = world.exec
        let alloc = world.alloc
        let Ok(env) = attempt devices::ViewEnv.build(take world) else {
            return runner::Ended.EnvIncomplete
        }
        return try await runner::Driven[devices::View, devices::ViewEnv, devices::VolumeView].run(take env, exec, alloc, take serving, peers: schema_of_block(alloc), release: fn(take ended: devices::ViewEnv) limits stack 512 {
        })
    }
    if component == genesis::FAT {
        let exec = world.exec
        let alloc = world.alloc
        let Ok(env) = attempt fat::Env.build(take world) else {
            return runner::Ended.EnvIncomplete
        }
        var peers = mem::List[sys::ProtocolSchema].empty(alloc)
        mut peers.push(sys::Wire[devices::Fat].schema(alloc))
        return try await runner::Driven[fat::Files, fat::Env, fat::FatFiles].run(take env, exec, alloc, take serving, take peers, release: fat::Env.abandon)
    }
    if component.starts_with("drivers::") {
        return try await self.serve_driver(component, take world, take serving)
    }
    if component == genesis::AML_EVALUATOR {
        return try await runner::Served[devices::aml::Evaluator, devices::aml::EvaluatorEnv, devices::aml::Aml].run(take world, take serving)
    }
    if component == genesis::STORE_SERVICE {
        return try await self.serve_store(take world, take serving)
    }
    if component == genesis::JOURNAL {
        return try await self.serve_journal(take world, take serving)
    }
    if component == genesis::POLICY {
        return try await self.serve_policy(take world, take serving)
    }
    if component == genesis::GENERATIONS {
        return try await self.serve_boot(take world, take serving)
    }
    if component == genesis::TIMEKEEPER {
        return try await self.serve_clock(take world, take serving)
    }
    if component == genesis::POWER {
        return try await self.serve_power(take world, take serving)
    }
    if component == genesis::LINKER {
        return try await self.serve_link(take world, take serving)
    }
    if component == genesis::DESK {
        return try await self.serve_console(take world, take serving)
    }
    if component == genesis::ADMISSION {
        return try await self.serve_admission(take world, take serving)
    }
    let exec = world.exec
    let alloc = world.alloc
    let Ok(env) = attempt supervisor::Env.build(take world, registries: self.registries, recovery: self.handoff.mode == bootfmt::Mode.Recovery.to_bits()) else {
        return runner::Ended.EnvIncomplete
    }
    var peers = mem::List[sys::ProtocolSchema].empty(alloc)
    mut peers.push(sys::Wire[store::service::Watcher].schema(alloc))
    return try await runner::Driven[supervisor::Supervision, supervisor::Env, supervisor::Supervisor].run(take env, exec, alloc, take serving, take peers, release: fn(take ended: supervisor::Env) limits stack 512 {
    })
} Base.served

fn Base.run_job(
    self,
    take image: Option[mem::Bytes],
    code: ident::HashValue,
    take input: mem::Bytes,
    take world: nanos::World,
    space: Option[runner::Isolation],
    domain: sys::Abandoner,
    exec: task::Executor,
    alloc: mem::Alloc,
    ) -> os::JobOutcome fails task::Cancelled uses wait {
    let Some(loaded) = image else {
        return try await self.run_base_job(code, take input, take world, domain, exec, alloc)
    }
    let Some(isolated) = space else {
        return try await self.loading.run_job(take loaded, code, take input, take world, domain, exec, alloc)
    }
    let Some(spaces) = self.spaces else {
        return os::JobOutcome.Failed(text: text::String.of("place.unavailable", alloc))
    }
    return try await spaces.run(take loaded, code, take input, isolated, take world, domain)
} Base.run_job

fn Base.host(
    self,
    take image: mem::Bytes,
    code: ident::HashValue,
    component: Str,
    take world: nanos::World,
    take hosting: runner::Hosting,
    ) -> Result[runner::Ended, sys::Trap] fails task::Cancelled uses wait {
    let Some(isolated) = hosting.isolation() else {
        return try await self.loading.host(take image, code, component, take world, take hosting)
    }
    let Some(spaces) = self.spaces else {
        take hosting.close()
        return Ok(runner::Ended.Unloadable(code: text::Fixed[32].of("place.unavailable")))
    }
    return try await spaces.host(take image, code, component, isolated, take world, take hosting)
} Base.host

/// Serves the base driver `component`.
fn Base.serve_driver(self, component: Str, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    if component == genesis::VIRTIO_RNG {
        return try await self.serve_rng(take world, take serving)
    }
    if component == genesis::VIRTIO_BLK {
        return try await self.serve_blk(take world, take serving)
    }
    if component == genesis::NVME {
        return try await self.serve_nvme(take world, take serving)
    }
    if component == genesis::AHCI {
        return try await self.serve_ahci(take world, take serving)
    }
    if component == genesis::TPM_CRB {
        return try await self.serve_crb(take world, take serving)
    }
    return try await self.serve_platform(component, take world, take serving)
} Base.serve_driver

/// Serves `virtio-rng` on the function its claim names.
fn Base.serve_rng(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Some(path) = claimed_path(world) else {
        return runner::Ended.EnvIncomplete
    }
    match try await self.claimed(path, serving, alloc) {
        Some(devices::Claimed.Pci(attached)) => {
            let Some(env) = drivers::virtio::RngEnv.of(take attached, clock: world.clock, alarm: self.alarm(path, serving), alloc) else {
                return runner::Ended.EnvIncomplete
            }
            var peers = mem::List[sys::ProtocolSchema].empty(alloc)
            mut peers.push(sys::Wire[devices::Entropy].schema(alloc))
            return try await runner::Driven[drivers::virtio::Rng, drivers::virtio::RngEnv, drivers::virtio::RngDevice].run(take env, exec: world.exec, alloc, take serving, take peers, release: drivers::virtio::RngEnv.abandon)
        }
        Some(devices::Claimed.Platform(_)) or None => return runner::Ended.EnvIncomplete
    }
} Base.serve_rng

/// Serves `virtio-blk` on the function its claim names.
fn Base.serve_blk(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Some(path) = claimed_path(world) else {
        return runner::Ended.EnvIncomplete
    }
    match try await self.claimed(path, serving, alloc) {
        Some(devices::Claimed.Pci(attached)) => {
            let Some(env) = drivers::virtio::BlkEnv.of(take attached, clock: world.clock, alarm: self.alarm(path, serving), meter: self.meter, alloc) else {
                return runner::Ended.EnvIncomplete
            }
            return try await runner::Driven[drivers::virtio::Blk, drivers::virtio::BlkEnv, drivers::virtio::BlkDevice].run(take env, exec: world.exec, alloc, take serving, peers: schema_of_block(alloc), release: drivers::virtio::BlkEnv.abandon)
        }
        Some(devices::Claimed.Platform(_)) or None => return runner::Ended.EnvIncomplete
    }
} Base.serve_blk

/// Serves `nvme` on the function its claim names.
fn Base.serve_nvme(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Some(path) = claimed_path(world) else {
        return runner::Ended.EnvIncomplete
    }
    match try await self.claimed(path, serving, alloc) {
        Some(devices::Claimed.Pci(attached)) => {
            let Some(env) = drivers::nvme::NvmeEnv.of(take attached, clock: world.clock, alarm: self.alarm(path, serving), meter: self.meter, alloc) else {
                return runner::Ended.EnvIncomplete
            }
            return try await runner::Driven[drivers::nvme::Nvme, drivers::nvme::NvmeEnv, drivers::nvme::NvmeDevice].run(take env, exec: world.exec, alloc, take serving, peers: schema_of_block(alloc), release: drivers::nvme::NvmeEnv.abandon)
        }
        Some(devices::Claimed.Platform(_)) or None => return runner::Ended.EnvIncomplete
    }
} Base.serve_nvme

/// Serves the `uart` or `cmos` driver `component` on the first port window its claimed platform device has.
fn Base.serve_platform(self, component: Str, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let exec = world.exec
    let Some(path) = claimed_path(world) else {
        return runner::Ended.EnvIncomplete
    }
    var resources = mem::List[devices::Resource].empty(alloc)
    match try await self.claimed(path, serving, alloc) {
        Some(devices::Claimed.Platform(claimed)) => {
            resources = claimed
        }
        Some(devices::Claimed.Pci(attached)) => release_attached(take attached)
        None => {
        }
    }
    let Some(port) = first_ports(resources) else {
        return runner::Ended.EnvIncomplete
    }
    var peers = mem::List[sys::ProtocolSchema].empty(alloc)
    if component == genesis::UART_DRIVER {
        let Some(line) = routed_line(resources, isa: self.isa) else {
            return runner::Ended.EnvIncomplete
        }
        let regs = trusted "devices declared the genesis::UART_DRIVER's I/O window as the firmware's _CRS gives it, the keeper refuses a window overlapping another device's, and devices binds one driver per device" { hw::Ports[drivers::uart::Regs].map(port: port) }
        let Some(env) = drivers::uart::UartEnv.of(take regs, line: line.line, edge: line.edge, active_low: line.active_low, clock: world.clock, alarm: self.alarm(path, serving), alloc) else {
            return runner::Ended.EnvIncomplete
        }
        mut peers.push(sys::Wire[devices::Console].schema(alloc))
        return try await runner::Driven[drivers::uart::Uart, drivers::uart::UartEnv, drivers::uart::UartDevice].run(take env, exec, alloc, take serving, take peers, release: drivers::uart::UartEnv.abandon)
    }
    let regs = trusted "devices declared the RTC's I/O window as the firmware's _CRS gives it, the keeper refuses a window overlapping another device's, devices binds one driver per device, and the core reads the RTC only before any instance runs" { hw::Ports[drivers::cmos::Regs].map(port: port) }
    mut peers.push(sys::Wire[devices::Rtc].schema(alloc))
    return try await runner::Driven[drivers::cmos::Cmos, drivers::cmos::CmosEnv, drivers::cmos::CmosDevice].run(drivers::cmos::CmosEnv.of(take regs), exec, alloc, take serving, take peers, release: drivers::cmos::CmosEnv.abandon)
} Base.serve_platform

/// Serves `tpm-crb` on the first memory window its claimed platform device has.
fn Base.serve_crb(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Some(path) = claimed_path(world) else {
        return runner::Ended.EnvIncomplete
    }
    var resources = mem::List[devices::Resource].empty(alloc)
    match try await self.claimed(path, serving, alloc) {
        Some(devices::Claimed.Platform(claimed)) => {
            resources = claimed
        }
        Some(devices::Claimed.Pci(attached)) => release_attached(take attached)
        None => {
        }
    }
    let Some(base) = first_window(resources) else {
        return runner::Ended.EnvIncomplete
    }
    let regs = trusted "devices declared the TPM's memory window as the firmware's _CRS gives it, the keeper refuses a window overlapping another device's or the core's, and devices binds one driver per device" { hw::Mmio[drivers::crb::Regs].map(phys: base) }
    let Some(env) = drivers::crb::CrbEnv.of(take regs, base, clock: world.clock, alloc) else {
        return runner::Ended.EnvIncomplete
    }
    var peers = mem::List[sys::ProtocolSchema].empty(alloc)
    mut peers.push(sys::Wire[devices::Tpm].schema(alloc))
    return try await runner::Driven[drivers::crb::Crb, drivers::crb::CrbEnv, drivers::crb::CrbDevice].run(take env, exec: world.exec, alloc, take serving, take peers, release: drivers::crb::CrbEnv.abandon)
} Base.serve_crb

/// The base of the first memory window of `resources`.
fn first_window(resources: mem::List[devices::Resource]) -> Option[u64] {
    for resource in resources {
        match resource {
            devices::Resource.Window(base: base, size: _) => return Some(base)
            else => {
            }
        }
    }
    return None
} first_window

/// A platform line as `install_platform` takes it: its global system interrupt, its trigger and its polarity.
struct Routed derives Copy {
    line: u32
    edge: bool
    active_low: bool
} Routed

/// The first interrupt line of `resources`, an ISA interrupt as `isa` routes it.
fn routed_line(resources: mem::List[devices::Resource], isa: Array[acpi::IsaRoute, 16]) -> Option[Routed] {
    for resource in resources {
        let devices::Resource.Line(number: number, isa: from_isa, edge: edge, active_low: active_low) = resource else {
            continue
        }
        if not from_isa {
            return Some(Routed(line: number, edge: edge, active_low: active_low))
        }
        if number >= 16 {
            continue
        }
        let route = isa[usize.widen(number)]
        return Some(Routed(line: route.line, edge: route.edge.value_or(edge), active_low: route.active_low.value_or(active_low)))
    }
    return None
} routed_line

/// The first I/O port window of `resources`.
fn first_ports(resources: mem::List[devices::Resource]) -> Option[u16] {
    for resource in resources {
        match resource {
            devices::Resource.Ports(base: base, count: _) => return Some(base)
            else => {
            }
        }
    }
    return None
} first_ports

/// Serves `ahci` on the function its claim names.
fn Base.serve_ahci(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Some(path) = claimed_path(world) else {
        return runner::Ended.EnvIncomplete
    }
    match try await self.claimed(path, serving, alloc) {
        Some(devices::Claimed.Pci(attached)) => {
            let Some(env) = drivers::ahci::AhciEnv.of(take attached, clock: world.clock, alarm: self.alarm(path, serving), meter: self.meter, alloc) else {
                return runner::Ended.EnvIncomplete
            }
            return try await runner::Driven[drivers::ahci::Ahci, drivers::ahci::AhciEnv, drivers::ahci::AhciDevice].run(take env, exec: world.exec, alloc, take serving, peers: schema_of_block(alloc), release: drivers::ahci::AhciEnv.abandon)
        }
        Some(devices::Claimed.Platform(_)) or None => return runner::Ended.EnvIncomplete
    }
} Base.serve_ahci

/// Serves `store` on the port of the `store-volume` role, with the image's genesis record and the `/sys/boot` record of the handoff record.
fn Base.serve_store(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Ok(handle) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "volume") else {
        return runner::Ended.EnvIncomplete
    }
    let Some(volume) = os::Port[devices::Block].of(handle) else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(managing) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "devices") else {
        return runner::Ended.EnvIncomplete
    }
    let Some(manager) = os::Port[devices::Devices].of(managing) else {
        return runner::Ended.EnvIncomplete
    }
    let keyring = match attempt nanos::Cap[os::PortHandle].get(world.caps, key: "keys") {
        Ok(reached) => os::Port[store::service::Sealing].of(reached)
        Err(_) => None
    }
    let Some(genesis) = boot_genesis(self.genesis, handoff: self.handoff, image: genesis::Image(bundle: self.bundle, support: self.support, bytes: self.image_bytes), jobs: self.jobs, alloc) else {
        return runner::Ended.EnvIncomplete
    }
    let env = store::service::Env.of(volume, take genesis, boot: boot_record(self.handoff, alloc), running: store::service::Running(trial: trial_boot(self.handoff), recovery: self.handoff.mode == bootfmt::Mode.Recovery.to_bits()), clock: world.clock, wall: self.wall, random: world.random, reporter: self.reporter, live: self.store_live, devices: manager, keys: keyring, alloc)
    return try await runner::Driven[store::service::Service, store::service::Env, store::service::Store].run(take env, exec: world.exec, alloc, take serving, peers: mem::List.empty(alloc), release: fn(take ended: store::service::Env) limits stack 8_192 {
    })
} Base.serve_store

/// Serves `journal` on the feed of the core rings and its View of `/journal`, with its configuration record, the configuration chapter 17 gives by default when it has none.
fn Base.serve_journal(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Ok(tree) = attempt nanos::Cap[store::service::View].get(world.caps, key: "tree") else {
        return runner::Ended.EnvIncomplete
    }
    let config = match mut serving.take_config() {
        Some(record) => match attempt mem::wire::Codec[journal::JournalConfig].decode(record.view(), alloc) {
            Ok(configured) => configured
            Err(_) => return runner::Ended.EnvIncomplete
        }
        None => journal::JournalConfig.default_of(alloc)
    }
    let system = ident::Cause.of(boot: self.handoff.boot_counter, number: 1)
    let env = journal::Env.of(self.feed, tree, take config, system, clock: world.clock, wall: self.wall, alloc)
    return try await runner::Driven[journal::Recorder, journal::Env, journal::Journal].run(take env, exec: world.exec, alloc, take serving, peers: mem::List.empty(alloc), release: fn(take ended: journal::Env) limits stack 1_024 {
    })
} Base.serve_journal

/// Serves `keys` from the `keyring` bundle the generation ships, on its Views of `/sys/principals` and `/data`, the kernel's entropy, its source of events, its part of `/live/security` and what its start tells it: the owner key the handoff record names and whether `serving` keeps its checkpoints. It runs alone in its isolated space on a machine with `user-mode`, else in the shared space; without the bundle it is unloadable.
fn Base.serve_keys(self, take world: nanos::World, take serving: runner::Serving) -> Result[runner::Ended, sys::Trap] fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Some(keyring) = self.keyring else {
        return Ok(no_image())
    }
    let Some(image) = keyring.image(alloc) else {
        return Ok(no_image())
    }
    let Some(code) = keyring.code() else {
        return Ok(no_image())
    }
    var owner: Option[Array[u8, 32]] = None
    if self.handoff.owner_key != Array[u8, 32].filled(0) {
        owner = Some(self.handoff.owner_key)
    }
    let isolated = self.machine.conditions.user_mode
    let starts = keys::MintedStart.of(keys::Told(owner: owner, kept: serving.keeps(), isolated: isolated), alloc)
    defer take starts.close()
    let nanos::World(alloc: _, exec: exec, clock: clock, random: random, log: log, stdio: stdio, fs: fs, net: net, caps: caps) = world
    var held = caps
    mut nanos::Cap[os::Live].put(mut held, key: "live", capability: self.keys_live)
    mut nanos::Cap[keys::Start].put(mut held, key: "start", capability: starts.mint())
    let alone = os::Space.Alone(moniker: genesis::moniker("keys"))
    let space = match isolated {
        true => Some(runner::Isolation(space: alone.label(), key: alone.key(), principal: text::Fixed[64].of("system"), bytes: genesis::KEYS_MEMORY))
        false => None
    }
    let hosting = runner::Hosting.of(take serving, protocol: sys::Wire[keys::Keys].hash(), operations: operations_of(sys::Wire[keys::Keys].schema(alloc), alloc), space, exec, alloc)
    return try await self.host(take image, code, component: genesis::KEYRING_ENTRY, world: nanos::World(alloc: alloc, exec: exec, clock: clock, random: random, log: log, stdio: stdio, fs: fs, net: net, caps: take held), take hosting)
} Base.serve_keys

/// How an instance whose bundle has no image ends.
fn no_image() -> runner::Ended {
    return runner::Ended.Unloadable(code: text::Fixed[32].of("code.no-image"))
} no_image

/// The names of the operations of the protocol `schema` describes, by number.
fn operations_of(schema: sys::ProtocolSchema, alloc: mem::Alloc) -> mem::List[text::String] {
    var names = mem::List[text::String].empty(alloc)
    for operation in schema.operations {
        mut names.push(text::String.of(operation.name.as_str(), alloc))
    }
    return names
} operations_of

/// Serves `policy` on its Views of `/sys/policy` and of its configuration record, its ports to `keys` and to itself, its source of events, the kernel's entropy and the clocks, with its configuration record.
