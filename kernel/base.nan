/// Serves the `uart` or `cmos` driver `component` on the first port window its claimed platform device has.
fn Base.serve_platform(self, component: Str, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let exec = world.exec
    let Some(path) = claimed_path(world) else {
        return runner::Ended.EnvIncomplete
    }
    var resources = mem::List[devices::Resource].empty(alloc)
    match try await self.claimed(path, alloc) {
        Some(devices::Claimed.Platform(claimed)) => {
            resources = claimed
        }
        Some(devices::Claimed.Pci(function)) => take function.release()
        None => {
        }
    }
    let Some(port) = first_ports(resources) else {
        return runner::Ended.EnvIncomplete
    }
    var peers = mem::List[sys::ProtocolSchema].empty(alloc)
    if component == UART_DRIVER {
        let Some(line) = routed_line(resources, isa: self.isa) else {
            return runner::Ended.EnvIncomplete
        }
        let regs = trusted "devices declared the UART_DRIVER's I/O window as the firmware's _CRS gives it, the keeper refuses a window overlapping another device's, and devices binds one driver per device" { hw::Ports[drivers::uart::Regs].map(port: port) }
        let Some(env) = drivers::uart::UartEnv.of(take regs, line: line.line, edge: line.edge, active_low: line.active_low, clock: world.clock, alarm: self.alarm(path, serving), alloc) else {
            return runner::Ended.EnvIncomplete
        }
        mut peers.push(sys::Wire[devices::Console].schema(alloc))
        return try await runner::Driven[drivers::uart::Uart, drivers::uart::UartEnv, drivers::uart::UartDevice].run(take env, exec, alloc, take serving, take peers, release: drivers::uart::UartEnv.abandon)
    }
    let regs = trusted "devices declared the RTC's I/O window as the firmware's _CRS gives it, the keeper refuses a window overlapping another device's, devices binds one driver per device, and the core reads the RTC only before any instance runs" { hw::Ports[drivers::cmos::Regs].map(port: port) }
    mut peers.push(sys::Wire[devices::Rtc].schema(alloc))
    return try await runner::Driven[drivers::cmos::Cmos, drivers::cmos::CmosEnv, drivers::cmos::CmosDevice].run(drivers::cmos::CmosEnv.of(take regs), exec, alloc, take serving, take peers, release: drivers::cmos::CmosEnv.abandon)
} Base.serve_platform

/// A platform line as `install_platform` takes it: its global system interrupt, its trigger and its polarity.
struct Routed derives Copy {
    line: u32
    edge: bool
    active_low: bool
} Routed

/// The first interrupt line of `resources`, an ISA interrupt as `isa` routes it.
fn routed_line(resources: mem::List[devices::Resource], isa: Array[acpi::IsaRoute, 16]) -> Option[Routed] {
    for resource in resources {
        let devices::Resource.Line(number: number, isa: from_isa, edge: edge, active_low: active_low) = resource else {
            continue
        }
        if not from_isa {
            return Some(Routed(line: number, edge: edge, active_low: active_low))
        }
        if number >= 16 {
            continue
        }
        let route = isa[usize.widen(number)]
        return Some(Routed(line: route.line, edge: route.edge.value_or(edge), active_low: route.active_low.value_or(active_low)))
    }
    return None
} routed_line

/// The first I/O port window of `resources`.
fn first_ports(resources: mem::List[devices::Resource]) -> Option[u16] {
    for resource in resources {
        match resource {
            devices::Resource.Ports(base: base, count: _) => return Some(base)
            else => {
            }
        }
    }
    return None
} first_ports

/// Serves `ahci` on the function its claim names.
fn Base.serve_ahci(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Some(path) = claimed_path(world) else {
        return runner::Ended.EnvIncomplete
    }
    match try await self.claimed(path, alloc) {
        Some(devices::Claimed.Pci(function)) => {
            let Some(env) = drivers::ahci::AhciEnv.of(take function, clock: world.clock, alarm: self.alarm(path, serving), alloc) else {
                return runner::Ended.EnvIncomplete
            }
            return try await runner::Driven[drivers::ahci::Ahci, drivers::ahci::AhciEnv, drivers::ahci::AhciDevice].run(take env, exec: world.exec, alloc, take serving, peers: schema_of_block(alloc), release: drivers::ahci::AhciEnv.abandon)
        }
        Some(devices::Claimed.Platform(_)) or None => return runner::Ended.EnvIncomplete
    }
} Base.serve_ahci

/// Serves `store` on the port of the `store-volume` role, with the image's genesis record and the `/sys/boot` record of the handoff record.
fn Base.serve_store(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Ok(handle) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "volume") else {
        return runner::Ended.EnvIncomplete
    }
    let Some(volume) = os::Port[devices::Block].of(handle) else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(managing) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "devices") else {
        return runner::Ended.EnvIncomplete
    }
    let Some(manager) = os::Port[devices::Devices].of(managing) else {
        return runner::Ended.EnvIncomplete
    }
    let keyring = match attempt nanos::Cap[os::PortHandle].get(world.caps, key: "keys") {
        Ok(reached) => os::Port[store::service::Sealing].of(reached)
        Err(_) => None
    }
    let genesis = genesis_record(self.bundle, handoff: self.handoff, alloc)
    let env = store::service::Env.of(volume, take genesis, boot: boot_record(self.handoff, alloc), clock: world.clock, wall: self.wall, random: world.random, reporter: self.reporter, live: self.store_live, devices: manager, keys: keyring, alloc)
    return try await runner::Driven[store::service::Service, store::service::Env, store::service::Store].run(take env, exec: world.exec, alloc, take serving, peers: mem::List.empty(alloc), release: fn(take ended: store::service::Env) limits stack 8_192 {
    })
} Base.serve_store

/// Serves `journal` on the feed of the core rings and its View of `/journal`, with its configuration record, the configuration chapter 17 gives by default when it has none.
fn Base.serve_journal(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Ok(tree) = attempt nanos::Cap[store::service::View].get(world.caps, key: "tree") else {
        return runner::Ended.EnvIncomplete
    }
    let config = match mut serving.take_config() {
        Some(record) => match attempt mem::wire::Codec[journal::JournalConfig].decode(record.view(), alloc) {
            Ok(configured) => configured
            Err(_) => return runner::Ended.EnvIncomplete
        }
        None => journal::JournalConfig.default_of(alloc)
    }
    let system = ident::Cause.of(boot: self.handoff.boot_counter, number: 1)
    let env = journal::Env.of(self.feed, tree, take config, system, clock: world.clock, wall: self.wall, alloc)
    return try await runner::Driven[journal::Recorder, journal::Env, journal::Journal].run(take env, exec: world.exec, alloc, take serving, peers: mem::List.empty(alloc), release: fn(take ended: journal::Env) limits stack 1_024 {
    })
} Base.serve_journal

/// Serves `keys` on its Views of `/sys/principals` and `/data`, the kernel's entropy, its source of events, its part of `/live/security` and the owner key the handoff record names, keeping its checkpoints when `serving` does.
fn Base.serve_keys(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Ok(principals) = attempt nanos::Cap[store::service::View].get(world.caps, key: "principals") else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(data) = attempt nanos::Cap[store::service::View].get(world.caps, key: "data") else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(events) = attempt nanos::Cap[journal::Source].get(world.caps, key: "events") else {
        return runner::Ended.EnvIncomplete
    }
    var owner: Option[Array[u8, 32]] = None
    if self.handoff.owner_key != Array[u8, 32].filled(0) {
        owner = Some(self.handoff.owner_key)
    }
    let env = keys::Env.of(principals, data, random: world.random, events, live: self.keys_live, owner, kept: serving.keeps(), alloc)
    var peers = mem::List[sys::ProtocolSchema].empty(alloc)
    mut peers.push(sys::Wire[store::service::Sealing].schema(alloc))
    return try await runner::Driven[keys::Keyring, keys::Env, keys::Keys].run(take env, exec: world.exec, alloc, take serving, take peers, release: fn(take ended: keys::Env) limits stack 512 {
    })
} Base.serve_keys

/// Serves `policy` on its Views of `/sys/policy` and of its configuration record, its ports to `keys` and to itself, its source of events, the kernel's entropy and the clocks, with its configuration record.
fn Base.serve_policy(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Ok(read) = attempt nanos::Cap[store::service::View].get(world.caps, key: "policy") else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(configuring) = attempt nanos::Cap[store::service::View].get(world.caps, key: "configuring") else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(keying) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "keys") else {
        return runner::Ended.EnvIncomplete
    }
    let Some(keyring) = os::Port[keys::Keys].of(keying) else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(own) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "own") else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(events) = attempt nanos::Cap[journal::Source].get(world.caps, key: "events") else {
        return runner::Ended.EnvIncomplete
    }
    let config: Option[policy::PolicyConfig] = match mut serving.take_config() {
        Some(record) => match attempt mem::wire::Codec[policy::PolicyConfig].decode(record.view(), alloc) {
            Ok(configured) => Some(configured)
            Err(_) => return runner::Ended.EnvIncomplete
        }
        None => None
    }
    let dev = self.handoff.mode == bootfmt::Mode.Dev.to_bits()
    let env = policy::Env.of(config, policy: read, configuring, keys: keyring, own, events, random: world.random, clock: world.clock, wall: self.wall, iommu: self.machine.conditions.iommu, dev, alloc)
    var peers = mem::List[sys::ProtocolSchema].empty(alloc)
    mut peers.push(sys::Wire[store::service::Watcher].schema(alloc))
    return try await runner::Driven[policy::Overseer, policy::Env, policy::Oversight].run(take env, exec: world.exec, alloc, take serving, take peers, release: fn(take ended: policy::Env) limits stack 512 {
    })
} Base.serve_policy

/// Serves `boot` on its port to `fat`, its View of `/sys/boot`, its source of events and the handoff record.
fn Base.serve_boot(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Ok(filing) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "fat") else {
        return runner::Ended.EnvIncomplete
    }
    let Some(files) = os::Port[devices::Fat].of(filing) else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(mirror) = attempt nanos::Cap[store::service::View].get(world.caps, key: "mirror") else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(events) = attempt nanos::Cap[journal::Source].get(world.caps, key: "events") else {
        return runner::Ended.EnvIncomplete
    }
    let env = generations::Env.of(fat: files, mirror, live: self.boot_live, events, handoff: self.handoff, clock: world.clock, alloc)
    return try await runner::Driven[generations::Boot, generations::Env, generations::Generations].run(take env, exec: world.exec, alloc, take serving, peers: mem::List.empty(alloc), release: fn(take ended: generations::Env) limits stack 512 {
    })
} Base.serve_boot

/// Serves `clock` on its port to the RTC of the `rtc` role when it has one, the wall clock of the core's start and its configuration record, the configuration by default when it has none.
fn Base.serve_clock(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let rtc = match attempt nanos::Cap[os::PortHandle].get(world.caps, key: "rtc") {
        Ok(handle) => os::Port[devices::Rtc].of(handle)
        Err(_) => None
    }
    let config = match mut serving.take_config() {
        Some(record) => match attempt mem::wire::Codec[clock::ClockConfig].decode(record.view(), alloc) {
            Ok(configured) => configured
            Err(_) => return runner::Ended.EnvIncomplete
        }
        None => clock::ClockConfig.default_of(alloc)
    }
    let env = clock::Env.of(rtc, clock: world.clock, start: self.wall, take config, alloc)
    return try await runner::Driven[clock::Timekeeper, clock::Env, clock::Timekeeping].run(take env, exec: world.exec, alloc, take serving, peers: mem::List.empty(alloc), release: fn(take ended: clock::Env) limits stack 512 {
    })
} Base.serve_clock

/// Serves `power` on the switch of the machine's power and its View of its configuration record.
fn Base.serve_power(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Ok(configuring) = attempt nanos::Cap[store::service::View].get(world.caps, key: "configuring") else {
        return runner::Ended.EnvIncomplete
    }
    let env = power::Env.of(switch: self.switch, configuring, clock: world.clock, alloc)
    return try await runner::Driven[power::Powering, power::Env, power::Power].run(take env, exec: world.exec, alloc, take serving, peers: mem::List.empty(alloc), release: fn(take ended: power::Env) limits stack 512 {
    })
} Base.serve_power

/// Serves `link` on its ports to the console UART, to `keys`, to `console` and to itself, its View of the tree, the kernel's entropy and the clocks, with its configuration record, the configuration by default when it has none.
fn Base.serve_link(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Ok(consoling) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "console") else {
        return runner::Ended.EnvIncomplete
    }
    let Some(console) = os::Port[devices::Console].of(consoling) else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(tree) = attempt nanos::Cap[store::service::View].get(world.caps, key: "tree") else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(keying) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "keys") else {
        return runner::Ended.EnvIncomplete
    }
    let Some(keyring) = os::Port[keys::Keys].of(keying) else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(attending) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "attendant") else {
        return runner::Ended.EnvIncomplete
    }
    let Some(attendant) = os::Port[console::Console].of(attending) else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(own) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "own") else {
        return runner::Ended.EnvIncomplete
    }
    let config = match mut serving.take_config() {
        Some(record) => match attempt mem::wire::Codec[link::LinkConfig].decode(record.view(), alloc) {
            Ok(configured) => configured
            Err(_) => return runner::Ended.EnvIncomplete
        }
        None => link::LinkConfig.default_of()
    }
    let Ok(events) = attempt nanos::Cap[journal::Source].get(world.caps, key: "events") else {
        return runner::Ended.EnvIncomplete
    }
    let env = link::Env.of(console, tree, keys: keyring, attendant, own, events, live: self.sessions_live, random: world.random, clock: world.clock, wall: self.wall, config, alloc)
    var peers = mem::List[sys::ProtocolSchema].empty(alloc)
    mut peers.push(sys::Wire[store::service::Watcher].schema(alloc))
    return try await runner::Driven[link::Linker, link::Env, link::Link].run(take env, exec: world.exec, alloc, take serving, take peers, release: fn(take ended: link::Env) limits stack 512 {
    })
} Base.serve_link

/// Serves `console` on the reserved lane of the console UART and its View of `/live`.
fn Base.serve_console(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Ok(handle) = attempt nanos::Cap[os::PortHandle].get(world.caps, key: "uart") else {
        return runner::Ended.EnvIncomplete
    }
    let Some(uart) = os::Port[devices::Console].of(handle) else {
        return runner::Ended.EnvIncomplete
    }
    let Ok(live) = attempt nanos::Cap[store::service::View].get(world.caps, key: "live") else {
        return runner::Ended.EnvIncomplete
    }
    return try await runner::Driven[console::Desk, console::Env, console::Console].run(console::Env.of(uart, live, alloc), exec: world.exec, alloc, take serving, peers: mem::List.empty(alloc), release: fn(take ended: console::Env) limits stack 512 {
    })
} Base.serve_console

/// The schemas a block driver or view serves the calls of: `Block`'s.
fn schema_of_block(alloc: mem::Alloc) -> mem::List[sys::ProtocolSchema] {
    var peers = mem::List[sys::ProtocolSchema].empty(alloc)
    mut peers.push(sys::Wire[devices::Block].schema(alloc))
    return peers
} schema_of_block

/// The bus path of the device a driver's world claims, `None` when it holds no live claim.
fn claimed_path(world: nanos::World) -> Option[devices::BusPath] {
    let Ok(claim) = attempt nanos::Cap[os::Device].get(world.caps, key: "device") else {
        return None
    }
    let Some(named) = claim.path(world.alloc) else {
        return None
    }
    return devices::BusPath.parse(named.as_str())
} claimed_path

/// The alarm of the driver of the device at `path`, which abandons the domain `serving` runs.
fn Base.alarm(self, path: devices::BusPath, serving: runner::Serving) -> devices::Alarm {
    return devices::Alarm.of(root: self.root, path, abandoner: serving.abandoner.share())
} Base.alarm

/// The hardware of the device at `path` for its driver, `None` when a driver holds it or the keeper holds no such device.
fn Base.claimed(self, path: devices::BusPath, alloc: mem::Alloc) -> Option[devices::Claimed] fails task::Cancelled uses wait {
    let ordered = match first attempt await self.claims.claim(path, alloc, release: release_claimed) {
        Ok(receiver) => receiver
        Err(devices::RootError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return None
    }
    var receiver = ordered
    let received = attempt await mut receiver.receive()
    let drained = attempt await take receiver.drain(visit: release_claimed)
    let claimed = match received {
        Ok(Some(given)) => given
        Ok(None) => None
        Err(cancelled) => fail cancelled
    }
    match drained {
        Ok(_) => return claimed
        Err(cancelled) => {
            release_claimed(take claimed)
            fail cancelled
        }
    }
} Base.claimed

/// Hands claimed hardware no Env took back to the keeper: a function returns, cut off.
fn release_claimed(take claimed: Option[devices::Claimed]) {
    match claimed {
        Some(devices::Claimed.Pci(function)) => take function.release()
        Some(devices::Claimed.Platform(_)) or None => {
        }
    }
} release_claimed

/// The genesis record the kernel image holds: the specification of each base instance, acting for `system` and running the image's bundle `bundle`, the root grant `g0`, the base instances' grants, and on a claimed machine or in `dev` mode the owner's grant.
fn image_genesis(bundle: ident::HashValue, handoff: bootfmt::Handoff, alloc: mem::Alloc) -> runner::Known {
    var building = Building(specs: mem::Map.empty(alloc), grants: mem::Map.empty(alloc))
    discard mut building.grants.insert(0, value: os::Grant(holder: principal("system"), object: os::Object.Machine, rights: rights(every: true, alloc), caveats: os::Caveats.none(), parent: None, granted_by: ident::CommitId(number: 1)))
    var supervising = os::InstanceSpec.of(principal: principal("system"), bundle, component: SUPERVISOR, alloc)
    mut building.grant(mut supervising, holder: "supervisor", field: "control", object: os::Object.Machine, granted: rights(every: false, alloc), alloc)
    discard mut supervising.wiring.insert(text::String.of("devices", alloc), value: os::Wire.to(moniker("devices")))
    var managing = os::InstanceSpec.of(principal: principal("system"), bundle, component: DEVICES, alloc)
    mut building.grant(mut managing, holder: "devices", field: "control", object: os::Object.Instance(prefix: moniker("devices")), granted: rights(every: false, alloc), alloc)
    mut building.grant(mut managing, holder: "devices", field: "clock", object: os::Object.Clock, granted: mem::Set.empty(alloc), alloc)
    discard mut managing.wiring.insert(text::String.of("fat", alloc), value: os::Wire.to(moniker("fat")))
    var filing = os::InstanceSpec.of(principal: principal("system"), bundle, component: FAT, alloc)
    discard mut filing.wiring.insert(text::String.of("volume", alloc), value: os::Wire(target: os::Target.Role(os::Role.BootVolume), operations: None, credit: os::Credit(messages: 64, calls: 64)))
    var storing = os::InstanceSpec.of(principal: principal("system"), bundle, component: STORE_SERVICE, alloc)
    storing.budget = os::Budget(limit: STORE_LIMIT, reserved: false)
    mut building.grant(mut storing, holder: "store", field: "clock", object: os::Object.Clock, granted: mem::Set.empty(alloc), alloc)
    mut building.grant(mut storing, holder: "store", field: "random", object: os::Object.Random, granted: mem::Set.empty(alloc), alloc)
    discard mut storing.wiring.insert(text::String.of("volume", alloc), value: os::Wire(target: os::Target.Role(os::Role.StoreVolume), operations: None, credit: os::Credit(messages: 64, calls: 64)))
    discard mut storing.wiring.insert(text::String.of("devices", alloc), value: os::Wire.to(moniker("devices")))
    var sealing = mem::List[text::String].empty(alloc)
    mut sealing.push(text::String.of("seal_secret", alloc))
    discard mut storing.wiring.insert(text::String.of("keys", alloc), value: os::Wire(target: os::Target.Instance(moniker("keys")), operations: Some(take sealing), credit: os::Credit(messages: 4, calls: 4)))
    mut building.grant(mut supervising, holder: "supervisor", field: "tree", object: tree_of("/sys", alloc), granted: tree_rights(alloc), alloc)
    var journaling = os::InstanceSpec.of(principal: principal("system"), bundle, component: JOURNAL, alloc)
    mut building.grant(mut journaling, holder: "journal", field: "tree", object: tree_of("/journal", alloc), granted: tree_rights(alloc), alloc)
    mut building.grant(mut journaling, holder: "journal", field: "clock", object: os::Object.Clock, granted: mem::Set.empty(alloc), alloc)
    discard mut building.specs.insert(moniker("supervisor"), value: take supervising)
    discard mut building.specs.insert(moniker("devices"), value: take managing)
    discard mut building.specs.insert(moniker("fat"), value: take filing)
    discard mut building.specs.insert(moniker("store"), value: take storing)
    var keeping = os::InstanceSpec.of(principal: principal("system"), bundle, component: KEYS, alloc)
    keeping.durability = os::Durability(class: os::DurabilityClass.Checkpointed, epoch_s: None, max_bytes: 65_536)
    mut building.grant(mut keeping, holder: "keys", field: "principals", object: tree_of("/sys/principals", alloc), granted: tree_rights(alloc), alloc)
    mut building.grant(mut keeping, holder: "keys", field: "data", object: tree_of("/data", alloc), granted: tree_rights(alloc), alloc)
    mut building.grant(mut keeping, holder: "keys", field: "random", object: os::Object.Random, granted: mem::Set.empty(alloc), alloc)
    discard mut building.specs.insert(moniker("journal"), value: take journaling)
    discard mut building.specs.insert(moniker("keys"), value: take keeping)
    var overseeing = os::InstanceSpec.of(principal: principal("system"), bundle, component: POLICY, alloc)
    overseeing.durability = os::Durability(class: os::DurabilityClass.Checkpointed, epoch_s: None, max_bytes: 1_048_576)
    mut building.grant(mut overseeing, holder: "policy", field: "policy", object: tree_of("/sys/policy", alloc), granted: read_rights(alloc), alloc)
    mut building.grant(mut overseeing, holder: "policy", field: "configuring", object: tree_of("/sys/config/policy", alloc), granted: tree_rights(alloc), alloc)
    mut building.grant(mut overseeing, holder: "policy", field: "random", object: os::Object.Random, granted: mem::Set.empty(alloc), alloc)
    mut building.grant(mut overseeing, holder: "policy", field: "clock", object: os::Object.Clock, granted: mem::Set.empty(alloc), alloc)
    discard mut overseeing.wiring.insert(text::String.of("keys", alloc), value: os::Wire.to(moniker("keys")))
    discard mut overseeing.wiring.insert(text::String.of("own", alloc), value: os::Wire(target: os::Target.Instance(moniker("policy")), operations: None, credit: os::Credit(messages: 16, calls: 1)))
    discard mut building.specs.insert(moniker("policy"), value: take overseeing)
    var booting = os::InstanceSpec.of(principal: principal("system"), bundle, component: GENERATIONS, alloc)
    mut building.grant(mut booting, holder: "boot", field: "mirror", object: tree_of("/sys/boot", alloc), granted: tree_rights(alloc), alloc)
    mut building.grant(mut booting, holder: "boot", field: "clock", object: os::Object.Clock, granted: mem::Set.empty(alloc), alloc)
    discard mut booting.wiring.insert(text::String.of("fat", alloc), value: os::Wire.to(moniker("fat")))
    discard mut building.specs.insert(moniker("boot"), value: take booting)
    var timekeeping = os::InstanceSpec.of(principal: principal("system"), bundle, component: TIMEKEEPER, alloc)
    timekeeping.lazy = true
    mut building.grant(mut timekeeping, holder: "clock", field: "clock", object: os::Object.Clock, granted: mem::Set.empty(alloc), alloc)
    discard mut timekeeping.wiring.insert(text::String.of("rtc", alloc), value: os::Wire(target: os::Target.Role(os::Role.Rtc), operations: None, credit: os::Credit(messages: 4, calls: 4)))
    discard mut building.specs.insert(moniker("clock"), value: take timekeeping)
    var powering = os::InstanceSpec.of(principal: principal("system"), bundle, component: POWER, alloc)
    powering.lazy = true
    mut building.grant(mut powering, holder: "power", field: "configuring", object: tree_of("/sys/config/power", alloc), granted: tree_rights(alloc), alloc)
    mut building.grant(mut powering, holder: "power", field: "clock", object: os::Object.Clock, granted: mem::Set.empty(alloc), alloc)
    discard mut building.specs.insert(moniker("power"), value: take powering)
    mut building.add_link(bundle, alloc)
    if owner_of(handoff, alloc).is_some() {
        let number = u64.widen(building.grants.len())
        discard mut building.grants.insert(number, value: os::Grant(holder: principal("owner"), object: os::Object.Machine, rights: rights(every: true, alloc), caveats: os::Caveats.none(), parent: Some(0), granted_by: ident::CommitId(number: 1)))
    }
    let Building(specs: specs, grants: grants) = building
    return runner::Known(specs: take specs, grants: take grants)
} image_genesis

/// Adds the specifications and grants of `link` and `console`, running `bundle`.
fn Building.add_link(mut self, bundle: ident::HashValue, alloc: mem::Alloc) {
    var linking = os::InstanceSpec.of(principal: principal("system"), bundle, component: LINKER, alloc)
    mut self.grant(mut linking, holder: "link", field: "tree", object: tree_of("/", alloc), granted: read_rights(alloc), alloc)
    mut self.grant(mut linking, holder: "link", field: "clock", object: os::Object.Clock, granted: mem::Set.empty(alloc), alloc)
    mut self.grant(mut linking, holder: "link", field: "random", object: os::Object.Random, granted: mem::Set.empty(alloc), alloc)
    var verifying = mem::List[text::String].empty(alloc)
    mut verifying.push(text::String.of("verify", alloc))
    discard mut linking.wiring.insert(text::String.of("keys", alloc), value: os::Wire(target: os::Target.Instance(moniker("keys")), operations: Some(take verifying), credit: os::Credit(messages: 4, calls: 4)))
    discard mut linking.wiring.insert(text::String.of("own", alloc), value: os::Wire(target: os::Target.Instance(moniker("link")), operations: None, credit: os::Credit(messages: link::WATCH_CREDIT, calls: 1)))
    var consoling = mem::List[text::String].empty(alloc)
    mut consoling.push(text::String.of("write", alloc))
    mut consoling.push(text::String.of("read", alloc))
    discard mut linking.wiring.insert(text::String.of("console", alloc), value: os::Wire(target: os::Target.Role(os::Role.Console), operations: Some(take consoling), credit: os::Credit(messages: 4, calls: 4)))
    var attending = mem::List[text::String].empty(alloc)
    mut attending.push(text::String.of("line", alloc))
    discard mut linking.wiring.insert(text::String.of("attendant", alloc), value: os::Wire(target: os::Target.Instance(moniker("console")), operations: Some(take attending), credit: os::Credit(messages: 16, calls: 1)))
    discard mut self.specs.insert(moniker("link"), value: take linking)
    var desking = os::InstanceSpec.of(principal: principal("system"), bundle, component: DESK, alloc)
    mut self.grant(mut desking, holder: "console", field: "live", object: tree_of("/live", alloc), granted: read_rights(alloc), alloc)
    var reserved = mem::List[text::String].empty(alloc)
    mut reserved.push(text::String.of("write_reserved", alloc))
    mut reserved.push(text::String.of("read_reserved", alloc))
    discard mut desking.wiring.insert(text::String.of("uart", alloc), value: os::Wire(target: os::Target.Role(os::Role.Console), operations: Some(take reserved), credit: os::Credit(messages: 4, calls: 4)))
    discard mut self.specs.insert(moniker("console"), value: take desking)
} Building.add_link

/// The specifications and grants of the image's genesis record as they are built.
struct Building {
    specs: mem::Map[ident::Moniker, os::InstanceSpec]
    grants: mem::Map[u64, os::Grant]
} Building

/// Grants `object` with the rights `granted` to the base instance `holder`, descending from `g0` under the next number, as the Env field `field` of its specification `spec`.
fn Building.grant(
    mut self,
    mut spec: os::InstanceSpec,
    holder: Str,
    field: Str,
    take object: os::Object,
    take granted: mem::Set[os::Right],
    alloc: mem::Alloc,
    ) {
    let number = u64.widen(self.grants.len())
    var name = text::Fixed[64].of("inst.")
    mut name.append(holder)
    discard mut self.grants.insert(number, value: os::Grant(holder: ident::Principal(text: name), object: take object, rights: take granted, caveats: os::Caveats.none(), parent: Some(0), granted_by: ident::CommitId(number: 1)))
    discard mut spec.grants.insert(text::String.of(field, alloc), value: number)
} Building.grant

/// The `Tree` object of the subtree `prefix` of `main`.
fn tree_of(prefix: Str, alloc: mem::Alloc) -> os::Object {
    return os::Object.Tree(prefix: tree_path(prefix, alloc), branch: text::String.of("main", alloc))
} tree_of

/// The genesis record of generation `generation`: the dirs of `/sys`, `/data` and `/state`, the base instances' specifications and grants of the image's genesis, running `bundle`, and the store's retention defaults.
fn genesis_record(bundle: ident::HashValue, handoff: bootfmt::Handoff, alloc: mem::Alloc) -> store::service::Genesis {
    let runner::Known(specs: specs, grants: grants) = image_genesis(bundle, handoff, alloc)
    var granted = mem::List[store::service::TypedValue].empty(alloc)
    for entry in take grants {
        let mem::KeyValue(key: _, value: grant) = entry
        var bytes = mem::Bytes.empty(alloc)
        mem::wire::Codec[os::Grant].encode(grant, out: mut bytes)
        mut granted.push(store::service::TypedValue(type: store::TypeRef.of(GRANT_TYPE, schema: mem::wire::Codec[os::Grant].schema_hash(), alloc), bytes: take bytes))
    }
    var stored = mem::Bytes.empty(alloc)
    mem::wire::Codec[store::service::StoreConfig].encode(store::service::StoreConfig(retention: store::Retention.default_of(alloc)), out: mut stored)
    let journaling = journal::JournalConfig.default_of(alloc)
    var journaled = mem::Bytes.empty(alloc)
    mem::wire::Codec[journal::JournalConfig].encode(journaling, out: mut journaled)
    var config = mem::Map[ident::Moniker, store::service::TypedValue].empty(alloc)
    discard mut config.insert(moniker("store"), value: store::service::TypedValue(type: store::TypeRef.of(STORE_CONFIG_TYPE, schema: mem::wire::Codec[store::service::StoreConfig].schema_hash(), alloc), bytes: take stored))
    discard mut config.insert(moniker("journal"), value: store::service::TypedValue(type: store::TypeRef.of(JOURNAL_CONFIG_TYPE, schema: mem::wire::Codec[journal::JournalConfig].schema_hash(), alloc), bytes: take journaled))
    var timed = mem::Bytes.empty(alloc)
    mem::wire::Codec[clock::ClockConfig].encode(clock::ClockConfig.default_of(alloc), out: mut timed)
    discard mut config.insert(moniker("clock"), value: store::service::TypedValue(type: store::TypeRef.of(CLOCK_CONFIG_TYPE, schema: mem::wire::Codec[clock::ClockConfig].schema_hash(), alloc), bytes: take timed))
    var linked = mem::Bytes.empty(alloc)
    mem::wire::Codec[link::LinkConfig].encode(link::LinkConfig.default_of(), out: mut linked)
    discard mut config.insert(moniker("link"), value: store::service::TypedValue(type: store::TypeRef.of(LINK_CONFIG_TYPE, schema: mem::wire::Codec[link::LinkConfig].schema_hash(), alloc), bytes: take linked))
    var powered = mem::Bytes.empty(alloc)
    mem::wire::Codec[power::PowerConfig].encode(power::PowerConfig.default_of(alloc), out: mut powered)
    discard mut config.insert(moniker("power"), value: store::service::TypedValue(type: store::TypeRef.of(POWER_CONFIG_TYPE, schema: mem::wire::Codec[power::PowerConfig].schema_hash(), alloc), bytes: take powered))
    var nodes = genesis_nodes(alloc)
    for node in take journal::declarations(journaling.retention(), alloc) {
        let mem::KeyValue(key: path, value: declaration) = node
        discard mut nodes.insert(take path, value: take declaration)
    }
    var principals = mem::Map[ident::Principal, store::service::TypedValue].empty(alloc)
    match owner_of(handoff, alloc) {
        Some(record) => {
            var bytes = mem::Bytes.empty(alloc)
            mem::wire::Codec[os::PrincipalRecord].encode(record, out: mut bytes)
            discard mut principals.insert(principal("owner"), value: store::service::TypedValue(type: principal_ref(alloc), bytes: take bytes))
            discard mut nodes.insert(tree_path("/data/owner", alloc), value: dir_of(None))
        }
        None => {
        }
    }
    var policed = mem::Bytes.empty(alloc)
    mem::wire::Codec[policy::SignedPolicy].encode(policy::SignedPolicy(policy: policy::Preset.Supervised.policy(version: 1, machine: Array[u8, 16].filled(0), alloc), signature: None), out: mut policed)
    let signed = store::service::TypedValue(type: store::TypeRef.of(SIGNED_POLICY_TYPE, schema: mem::wire::Codec[policy::SignedPolicy].schema_hash(), alloc), bytes: take policed)
    return store::service::Genesis(format: 1, generation: handoff.generation, nodes: take nodes, instances: take specs, config: take config, principals: take principals, grants: take granted, policy: take signed)
} genesis_record

/// The owner's principal record: holding the owner key the handoff record names on a claimed machine, no key in `dev` mode on an unclaimed one, `None` otherwise.
fn owner_of(handoff: bootfmt::Handoff, alloc: mem::Alloc) -> Option[os::PrincipalRecord] {
    let claimed = handoff.owner_key != Array[u8, 32].filled(0)
    if not claimed and handoff.mode != bootfmt::Mode.Dev.to_bits() {
        return None
    }
    let key = match claimed {
        true => Some(handoff.owner_key)
        false => None
    }
    return Some(os::PrincipalRecord(key: key, former: mem::List.empty(alloc), parent: None, expires_utc_ns: None))
} owner_of

/// The type of the records of `/sys/principals`.
fn principal_ref(alloc: mem::Alloc) -> store::TypeRef {
    return store::TypeRef.of(PRINCIPAL_RECORD_TYPE, schema: mem::wire::Codec[os::PrincipalRecord].schema_hash(), alloc)
} principal_ref

/// The dirs genesis declares: `/sys` and the dirs below it, their children records of the type each holds where it is one, `/data` and `/state`.
fn genesis_nodes(alloc: mem::Alloc) -> mem::Map[ident::Path, store::Declaration] {
    var nodes = mem::Map[ident::Path, store::Declaration].empty(alloc)
    discard mut nodes.insert(tree_path("/sys", alloc), value: dir_of(None))
    discard mut nodes.insert(tree_path("/sys/instances", alloc), value: dir_of(Some(store::Element(kind: store::NodeKind.Record, type: Some(store::service::spec_type(alloc))))))
    discard mut nodes.insert(tree_path("/sys/grants", alloc), value: dir_of(Some(store::Element(kind: store::NodeKind.Record, type: Some(store::TypeRef.of(GRANT_TYPE, schema: mem::wire::Codec[os::Grant].schema_hash(), alloc))))))
    discard mut nodes.insert(tree_path("/sys/code", alloc), value: dir_of(Some(store::Element(kind: store::NodeKind.Dir, type: None))))
    discard mut nodes.insert(tree_path("/sys/config", alloc), value: records_dir())
    discard mut nodes.insert(tree_path("/sys/principals", alloc), value: dir_of(Some(store::Element(kind: store::NodeKind.Record, type: Some(principal_ref(alloc))))))
    discard mut nodes.insert(tree_path("/sys/approvals", alloc), value: records_dir())
    discard mut nodes.insert(tree_path("/sys/plans", alloc), value: records_dir())
    discard mut nodes.insert(tree_path("/sys/outbox", alloc), value: records_dir())
    discard mut nodes.insert(tree_path("/sys/schedule", alloc), value: records_dir())
    discard mut nodes.insert(tree_path("/data", alloc), value: dir_of(None))
    discard mut nodes.insert(tree_path("/state", alloc), value: dir_of(None))
    return nodes
} genesis_nodes

/// The declaration of a versioned dir whose children are of `element`, any when `None`.
fn dir_of(take element: Option[store::Element]) -> store::Declaration {
    return store::Declaration.Dir(store::DirDecl(element: take element, ephemeral: false, secret: false, numbered: false, keep: None))
} dir_of

/// The declaration of a dir of records of any type.
fn records_dir() -> store::Declaration = dir_of(Some(store::Element(kind: store::NodeKind.Record, type: None)))

/// The record of `/sys/boot` the handoff record tells.
fn boot_record(handoff: bootfmt::Handoff, alloc: mem::Alloc) -> store::service::TypedValue {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[bootfmt::BootState].encode(bootfmt::BootState.of_handoff(handoff, alloc), out: mut bytes)
    return store::service::TypedValue(type: store::TypeRef.of(BOOT_STATE_TYPE, schema: mem::wire::Codec[bootfmt::BootState].schema_hash(), alloc), bytes: take bytes)
} boot_record

/// Runs the base instances of `known` and starts `supervisor`, which starts the others in their order, while the keeper serves the device root, the core carves the regions of reserved instances from `frames`, prints each event `rings` record and holds the board of `/live`, `machine` its first record; it never ends unless cancelled.
fn run_base(
    take known: runner::Known,
    take keeper: keeper::Keeper,
    bundle: ident::HashValue,
    boot: devices::BootVolume,
    isa: Array[acpi::IsaRoute, 16],
    handoff: bootfmt::Handoff,
    machine: os::Machine,
    config: runner::Config,
    rings: rings::Rings,
    cpus: mem::Shared[sched::State],
    mut frames: frames::Frames,
    ) fails task::Cancelled uses wait {
    let task::Channel(sender: requests, receiver: incoming) = task::Channel[Reservation].bounded(1, alloc: config.alloc)
    let task::Channel(sender: orders, receiver: ordered) = task::Channel[devices::RootOrder].bounded(16, alloc: config.alloc)
    let minted = devices::MintedRoot.of(orders, alloc: config.alloc)
    defer take minted.close()
    let task::Channel(sender: reported, receiver: reports) = task::Channel[store::service::Report].bounded(16, alloc: config.alloc)
    let reporting = store::service::MintedReporter.of(reported, alloc: config.alloc)
    defer take reporting.close()
    let task::Channel(sender: posted, receiver: postings) = task::Channel[os::Posting].bounded(16, alloc: config.alloc)
    let lives = LiveRoots.of(posted, alloc: config.alloc)
    defer take lives.close()
    let task::Channel(sender: tracings, receiver: traced) = task::Channel[mem::List[journal::TracedInstance]].bounded(1, alloc: config.alloc)
    let backlog = journal::Backlog.of(tracings, principals: rings.principals(), alloc: config.alloc)
    let feeding = journal::MintedFeed.of(backlog, alloc: config.alloc)
    defer take feeding.close()
    let task::Channel(sender: switched, receiver: switches) = task::Channel[power::Switching].bounded(1, alloc: config.alloc)
    let switching = power::MintedSwitch.of(switched, alloc: config.alloc)
    defer take switching.close()
    let task::Channel(sender: logs, receiver: logged) = task::Channel[journal::Logged].bounded(LOG_ROOM, alloc: config.alloc)
    let base = Base(root: minted.mint(claim: false), claims: minted.mint(claim: true), bundle: bundle, boot: boot, isa: isa, reporter: reporting.mint(), store_live: lives.store.mint(), devices_live: lives.devices.mint(), wall: config.wall, handoff: handoff, feed: feeding.mint(), keys_live: lives.keys.mint(), boot_live: lives.boot.mint(), machine: machine, switch: switching.mint(), sessions_live: lives.sessions.mint())
    var requested = incoming
    var given = Some(Given(known: take known, reservations: Reserver(requests: take requests, alloc: config.alloc), keeper: take keeper, orders: take ordered, store_events: take reports, postings: take postings, switches: take switches, logged: take logged, traced: take traced))
    defer abandon_given(take given)
    try await task::scope(config.exec, body: fn[mut frames, mut given, mut requested](s: task::Scope) fails task::Cancelled uses wait {
        let Some(Given(known: genesis, reservations: reserver, keeper: held, orders: root_orders, store_events: store_events, postings: board, switches: switch_orders, logged: log_records, traced: tracing)) = mut given.extract() else {
            return
        }
        let origin = Origin.of(handoff, clock: config.clock, wall: config.wall)
        let gauges = runner::Gauges.empty(alloc: config.alloc)
        let reading = gauges.share()
        let sampling = gauges.share()
        discard s.spawn(fn[take sampling]() fails task::Cancelled uses wait limits stack 32_768 {
            try await sample_metrics(sampling, backlog, clock: config.clock, wall: config.wall, alloc: config.alloc)
        })
        discard s.spawn(fn[take board, take reading]() fails task::Cancelled uses wait limits stack 32_768 {
            try await serve_board(take board, origin, machine, security: security_of(handoff, machine, alloc: config.alloc), cpus, gauges: reading, exec: config.exec, alloc: config.alloc)
        })
        discard s.spawn(fn() fails task::Cancelled uses wait limits stack 16_384 {
            try await print_events(rings, backlog, exec: config.exec, alloc: config.alloc)
        })
        discard s.spawn(fn[take store_events]() fails task::Cancelled uses wait limits stack 8_192 {
            try await record_store_events(take store_events, rings)
        })
        discard s.spawn(fn[take switch_orders]() fails task::Cancelled uses wait limits stack 4_096 {
            try await switch_power(take switch_orders)
        })
        discard s.spawn(fn[take log_records]() fails task::Cancelled uses wait limits stack 16_384 {
            try await hold_logs(take log_records, backlog)
        })
        let signal = held.slot_signal()
        let task::Channel(sender: inputs, receiver: received) = task::Channel[keeper::Input].bounded(16, alloc: config.alloc)
        let forwarding = inputs.split()
        discard s.spawn(fn[take held, take received]() fails task::Cancelled uses wait limits stack 32_768 {
            var keeping = held
            defer take keeping.release()
            try await mut keeping.serve(take received, rings, alloc: config.alloc)
        })
        discard s.spawn(fn[take root_orders, take forwarding]() fails task::Cancelled uses wait limits stack 8_192 {
            try await keeper::forward(take root_orders, inputs: take forwarding)
        })
        discard s.spawn(fn[take signal, take inputs]() fails task::Cancelled uses wait limits stack 8_192 {
            try await keeper::relay_slots(signal, take inputs)
        })
        discard s.spawn(fn[take genesis, take reserver, take gauges, take tracing]() fails task::Cancelled uses wait limits stack 32_768 {
            discard try await runner::run(take genesis, components: base, journal: rings, reservations: take reserver, config, postings: posted, logs: logs.split(), gauges, tracings: take tracing, body: fn(core: runner::Core) fails task::Cancelled uses wait {
                discard attempt await core.control.start(moniker("supervisor"), alloc: config.alloc)
                try await watch_base(core.control, clock: config.clock, alloc: config.alloc)
                let parked = hw::Signal[Unit].empty()
                loop {
                    try await parked.wait()
                }
            })
        })
        try await serve_reservations(mut frames, requests: mut requested)
    })
} run_base

/// The root entries of the `/live` records base instances publish: the store's, the devices', the part of `/live/security` `keys` tells, `/live/boot` and `/live/sessions`.
linear struct LiveRoots {
    store: os::MintedLive
    devices: os::MintedLive
    keys: os::MintedLive
    boot: os::MintedLive
    sessions: os::MintedLive
} LiveRoots

fn LiveRoots.of(posted: task::Sender[os::Posting], alloc: mem::Alloc) -> LiveRoots {
    return LiveRoots(store: os::MintedLive.of(posted, own: "/live/store", alloc), devices: os::MintedLive.of(posted, own: "/live/devices", alloc), keys: os::MintedLive.of(posted, own: "/live/security/keys", alloc), boot: os::MintedLive.of(posted, own: "/live/boot", alloc), sessions: os::MintedLive.of(posted, own: "/live/sessions", alloc))
} LiveRoots.of

/// Revokes the records' root entries.
fn LiveRoots.close(take self) {
    let LiveRoots(store: stored, devices: managed, keys: keyed, boot: booted, sessions: linked) = self
    take stored.close()
    take managed.close()
    take keyed.close()
    take booted.close()
    take linked.close()
} LiveRoots.close

/// Halts the kernel with `fault.base-not-running` and the first of `store`, `keys`, `journal` and `policy` that is not running 30 s after the core's start.
fn watch_base(control: os::Control, clock: sys::Clock, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let now = match attempt clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
    if now < BASE_DEADLINE_NS {
        try await clock.sleep_ns(BASE_DEADLINE_NS - now)
    }
    try await require_running(control, name: "store", alloc)
    try await require_running(control, name: "keys", alloc)
    try await require_running(control, name: "journal", alloc)
    try await require_running(control, name: "policy", alloc)
} watch_base

/// Halts the kernel with `fault.base-not-running` and `name` unless the instance `name` is running.
fn require_running(control: os::Control, name: Str, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let running = match first attempt await control.lifecycle(moniker(name), alloc) {
        Ok(os::Lifecycle.Running) => true
        Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
        else => false
    }
    if not running {
        halt(code: "fault.base-not-running", subject: name)
    }
} require_running

/// Holds each log record instances hand to the core in `backlog`, for `journal`.
fn hold_logs(take logged: task::Receiver[journal::Logged], backlog: journal::Backlog) fails task::Cancelled uses wait {
    var receiver = logged
    loop {
        let Some(record) = try await mut receiver.receive() else {
            return
        }
        try await backlog.hold_logged(take record)
    }
} hold_logs

/// Writes each event the store reports to the core rings, and halts the kernel with the code of a failed mount.
fn record_store_events(take reports: task::Receiver[store::service::Report], rings: rings::Rings) fails task::Cancelled uses wait {
    var receiver = reports
    loop {
        let Some(report) = try await mut receiver.receive() else {
            return
        }
        match report {
            store::service::Report.Event(event) => rings.record_store(event)
            store::service::Report.MountFailed(code: code) => halt(code: code.as_str(), subject: "store")
        }
    }
} record_store_events

/// Releases the keeper when the scope never took it.
fn abandon_given(take given: Option[Given]) {
    match given {
        Some(left) => {
            let Given(known: _, reservations: _, keeper: kept, orders: _, store_events: _, postings: _, switches: _, logged: _, traced: _) = left
            take kept.release()
        }
        None => {
        }
    }
} abandon_given

/// What the tasks of `run_base` take: the genesis record and the reservations the runner makes, the keeper with the device root's orders, the events the store reports, the postings to the board, the orders of the power switch, the log records of instances, and the instances `journal` traces.
linear struct Given {
    known: runner::Known
    reservations: Reserver
    keeper: keeper::Keeper
    orders: task::Receiver[devices::RootOrder]
    store_events: task::Receiver[store::service::Report]
    postings: task::Receiver[os::Posting]
    switches: task::Receiver[power::Switching]
    logged: task::Receiver[journal::Logged]
    traced: task::Receiver[mem::List[journal::TracedInstance]]
} Given

/// A reserved instance's request for a region of `bytes`, and where the store over it goes, `None` when no free range holds one.
struct Reservation {
    bytes: u64
    done: task::Sender[Option[mem::Heap]]
} Reservation

/// The runner's reservations, asking the task that holds the frame allocator for their regions.
struct Reserver {
    requests: task::Sender[Reservation]
    alloc: mem::Alloc
} Reserver

impl Reserver: runner::Reservations

fn Reserver.reserve(self, bytes: u64) -> Option[mem::Heap] fails task::Cancelled uses wait {
    let task::Channel(sender: done, receiver: outcome) = task::Channel[Option[mem::Heap]].bounded(1, alloc: self.alloc)
    match attempt await self.requests.send(Reservation(bytes: bytes, done: take done)) {
        Ok(_) => {
        }
        Err(task::SendError.Closed) => return None
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
    }
    var receiver = outcome
    let Some(store) = try await mut receiver.receive() else {
        return None
    }
    return store
} Reserver.reserve

/// Carves the region of each reservation `requests` brings from `frames`, under a store of its own, for as long as requests come.
fn serve_reservations(mut frames: frames::Frames, mut requests: task::Receiver[Reservation]) fails task::Cancelled uses wait {
    loop {
        let Some(Reservation(bytes: bytes, done: done)) = try await mut requests.receive() else {
            return
        }
        let store = match mut frames.reserve(bytes) {
            Some(region) => Some(mem::Heap.over(take region))
            None => None
        }
        discard attempt await done.send(store)
    }
} serve_reservations

/// The rights of `Control`, or every right when `every`.
fn rights(every: bool, alloc: mem::Alloc) -> mem::Set[os::Right] {
    var set = mem::Set[os::Right].empty(alloc)
    discard mut set.insert(os::Right.Read)
    discard mut set.insert(os::Right.Lifecycle)
    discard mut set.insert(os::Right.Update)
    discard mut set.insert(os::Right.Spawn)
    if every {
        discard mut set.insert(os::Right.Write)
        discard mut set.insert(os::Right.Admin)
        discard mut set.insert(os::Right.SecretRead)
        discard mut set.insert(os::Right.Parallel)
        discard mut set.insert(os::Right.Fine)
        discard mut set.insert(os::Right.Enroll)
    }
    return set
} rights

fn moniker(text: Str) -> ident::Moniker {
    return ident::Moniker(text: text::Fixed[59].of(text))
} moniker

fn principal(text: Str) -> ident::Principal {
    return ident::Principal(text: text::Fixed[64].of(text))
} principal

fn tree_path(text: Str, alloc: mem::Alloc) -> ident::Path {
    return ident::Path(text: text::String.of(text, alloc))
} tree_path

/// The rights of a `Tree` grant reading its subtree.
fn read_rights(alloc: mem::Alloc) -> mem::Set[os::Right] {
    var set = mem::Set[os::Right].empty(alloc)
    discard mut set.insert(os::Right.Read)
    return set
} read_rights

/// The rights of a `Tree` grant reading and writing its subtree.
fn tree_rights(alloc: mem::Alloc) -> mem::Set[os::Right] {
    var set = mem::Set[os::Right].empty(alloc)
    discard mut set.insert(os::Right.Read)
    discard mut set.insert(os::Right.Write)
    return set
} tree_rights

test supervisor_starts_from_the_image_genesis for image_genesis {
    let world = testing::world()
    let alloc = world.alloc
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    let config = runner::Config(exec: world.exec, pool: alloc, alloc: alloc, clock: world.clock, wall: ident::Wall(at: ident::WallTime.unknown(), since_ns: 0), random: world.random, classes: sched::classes(), system: ident::Cause.of(1, number: 1))
    let rings = rings::Rings.of(cpus: hw::cpu_count(), clock: world.clock, boot: 1, alloc)
    let task::Channel(sender: requests, receiver: unanswered) = task::Channel[Reservation].bounded(1, alloc)
    discard unanswered
    let task::Channel(sender: orders, receiver: unserved) = task::Channel[devices::RootOrder].bounded(1, alloc)
    discard unserved
    let minted = devices::MintedRoot.of(orders, alloc)
    defer take minted.close()
    let task::Channel(sender: reported, receiver: unreported) = task::Channel[store::service::Report].bounded(1, alloc)
    discard unreported
    let reporting = store::service::MintedReporter.of(reported, alloc)
    defer take reporting.close()
    let task::Channel(sender: posted, receiver: unposted) = task::Channel[os::Posting].bounded(1, alloc)
    discard unposted
    let living = os::MintedLive.of(posted, own: "/live/store", alloc)
    defer take living.close()
    let task::Channel(sender: tracings, receiver: untraced) = task::Channel[mem::List[journal::TracedInstance]].bounded(1, alloc)
    let feeding = journal::MintedFeed.of(journal::Backlog.of(tracings, principals: rings.principals(), alloc), alloc)
    defer take feeding.close()
    let task::Channel(sender: switched, receiver: unswitched) = task::Channel[power::Switching].bounded(1, alloc)
    discard unswitched
    let switching = power::MintedSwitch.of(switched, alloc)
    defer take switching.close()
    let base = Base(root: minted.mint(claim: false), claims: minted.mint(claim: true), bundle: ident::HashValue(bytes: bundle), boot: devices::BootVolume(scheme: 0, partition: 0, signature: Array[u8, 16].filled(0)), isa: Array[acpi::IsaRoute, 16].filled(acpi::IsaRoute(line: 0, edge: None, active_low: None)), reporter: reporting.mint(), store_live: living.mint(), devices_live: living.mint(), wall: config.wall, handoff: bootfmt::Handoff.empty(), feed: feeding.mint(), keys_live: living.mint(), boot_live: living.mint(), machine: os::Machine(arch: os::Arch.Amd64, conditions: os::Conditions(iommu: false, tpm: false, secure_boot: false, user_mode: false, invariant_tsc: false, tsc_deadline: false, pcid: false, pages_1g: false, mwait: false, watchdog: false, nic: false, meltdown_immune: false), ram_bytes: 1, cpus: 1, level: os::Level.X86v1, smt: false, numa_nodes: 1, storage: os::Storage.File, power: os::PowerSource.Mains), switch: switching.mint(), sessions_live: living.mint())
    let task::Channel(sender: logs, receiver: unlogged) = task::Channel[journal::Logged].bounded(1, alloc)
    discard unlogged
    let started = try await runner::run(image_genesis(ident::HashValue(bytes: bundle), handoff: bootfmt::Handoff.empty(), alloc), components: base, journal: rings, reservations: Reserver(requests: take requests, alloc: alloc), config, postings: posted, logs, gauges: runner::Gauges.empty(alloc), tracings: take untraced, body: fn(core: runner::Core) -> os::Lifecycle fails os::ControlError uses wait {
        let started = try await core.control.start(moniker("supervisor"), alloc)
        discard try await core.control.stop(moniker("supervisor"), alloc)
        return started
    })
    expect started == Some(os::Lifecycle.Running)
} supervisor_starts_from_the_image_genesis
