fn Base.serve_blk(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
    let Some(path) = claimed_path(world) else {
        return runner::Ended.EnvIncomplete
    }
    match try await self.claimed(path, alloc) {
        Some(devices::Claimed.Pci(function)) => {
            let Some(env) = drivers::virtio::BlkEnv.of(take function, clock: world.clock, alarm: self.alarm(path, serving), alloc) else {
                return runner::Ended.EnvIncomplete
            }
            return try await runner::Driven[drivers::virtio::Blk, drivers::virtio::BlkEnv, drivers::virtio::BlkDevice].run(take env, exec: world.exec, alloc, take serving, peers: schema_of_block(alloc), release: drivers::virtio::BlkEnv.abandon)
        }
        Some(devices::Claimed.Platform(_)) or None => return runner::Ended.EnvIncomplete
    }
} Base.serve_blk

/// Serves `nvme` on the function its claim names.
fn Base.serve_nvme(self, take world: nanos::World, take serving: runner::Serving) -> runner::Ended fails task::Cancelled uses wait {
    let alloc = world.alloc
