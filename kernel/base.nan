    match try await self.claimed(path, alloc) {
        Some(devices::Claimed.Pci(function)) => {
            let Some(env) = drivers::nvme::NvmeEnv.of(take function, clock: world.clock, alarm: self.alarm(path, serving), alloc) else {
                return runner::Ended.EnvIncomplete
            }
            return try await runner::Driven[drivers::nvme::Nvme, drivers::nvme::NvmeEnv, drivers::nvme::NvmeDevice].run(take env, exec: world.exec, alloc, take serving, peers: schema_of_block(alloc), release: drivers::nvme::NvmeEnv.abandon)
        }
        Some(devices::Claimed.Platform(_)) or None => return runner::Ended.EnvIncomplete
    }
