/// The schemas a block driver or view serves the calls of: `Block`'s.
fn schema_of_block(alloc: mem::Alloc) -> mem::List[sys::ProtocolSchema] {
    var peers = mem::List[sys::ProtocolSchema].empty(alloc)
    mut peers.push(sys::Wire[devices::Block].schema(alloc))
    return peers
} schema_of_block

/// The bus path of the device a driver's world claims, `None` when it holds no live claim.
fn claimed_path(world: nanos::World) -> Option[devices::BusPath] {
    let Ok(claim) = attempt nanos::Cap[os::Device].get(world.caps, key: "device") else {
        return None
    }
    let Some(named) = claim.path(world.alloc) else {
        return None
    }
    return devices::BusPath.parse(named.as_str())
} claimed_path

/// The alarm of the driver of the device at `path`, which abandons the domain `serving` runs.
fn Base.alarm(self, path: devices::BusPath, serving: runner::Serving) -> devices::Alarm {
    return devices::Alarm.of(root: self.root, path, abandoner: serving.abandoner.share())
} Base.alarm

/// The hardware of the device at `path` for the driver `serving` serves, whose domain the keeper abandons at a DMA fault, `None` when a driver holds it or the keeper holds no such device.
fn Base.claimed(self, path: devices::BusPath, serving: runner::Serving, alloc: mem::Alloc) -> Option[devices::Claimed] fails task::Cancelled uses wait {
    let ordered = match first attempt await self.claims.claim(path, abandoner: serving.abandoner.share(), alloc, release: release_claimed) {
        Ok(receiver) => receiver
        Err(devices::RootError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return None
    }
    var receiver = ordered
    let received = attempt await mut receiver.receive()
    let drained = attempt await take receiver.drain(visit: release_claimed)
    let claimed = match received {
        Ok(Some(given)) => given
        Ok(None) => None
        Err(cancelled) => fail cancelled
    }
    match drained {
        Ok(_) => return claimed
        Err(cancelled) => {
            release_claimed(take claimed)
            fail cancelled
        }
    }
} Base.claimed

/// Hands claimed hardware no Env took back to the keeper: a function returns, cut off.
fn release_claimed(take claimed: Option[devices::Claimed]) {
    match claimed {
        Some(devices::Claimed.Pci(attached)) => release_attached(take attached)
        Some(devices::Claimed.Platform(_)) or None => {
        }
    }
} release_claimed

/// Hands an attached function back to the keeper, cut off.
fn release_attached(take attached: devices::Attached) {
    let devices::Attached(function: function, space: _, external: _) = attached
    take function.release()
} release_attached

/// The record of `/sys/boot` the handoff record tells.
/// The trial branch the boot `handoff` tells runs on: one its generation's boot in mode `trial` creates, or one a later `normal` boot of it finds.
fn trial_boot(handoff: bootfmt::Handoff) -> Option[store::service::TrialBoot] {
    let creates = handoff.mode == bootfmt::Mode.Trial.to_bits()
    if handoff.generation == 0 or not (creates or handoff.mode == bootfmt::Mode.Normal.to_bits()) {
        return None
    }
    return Some(store::service::TrialBoot(generation: handoff.generation, creates: creates))
} trial_boot

fn boot_record(handoff: bootfmt::Handoff, alloc: mem::Alloc) -> store::service::TypedValue {
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[bootfmt::BootState].encode(bootfmt::BootState.of_handoff(handoff, alloc), out: mut bytes)
    return store::service::TypedValue(type: store::TypeRef.of(genesis::BOOT_STATE_TYPE, schema: mem::wire::Codec[bootfmt::BootState].schema_hash(), alloc), bytes: take bytes)
} boot_record

/// Runs the base instances of `known` and starts `supervisor`, which starts the others in their order, while the keeper serves the device root, the core carves the regions of reserved instances from `frames`, prints each event `rings` record, holds the board of `/live`, `machine` its first record, writes each CPU's energy-performance preference through `cpu` on a machine with HWP, loads jobs' bundles through `loader`, and runs the toolchain `shipped`, when the start isolated one, drawing through NaN's boot heap `heap`; it never ends unless cancelled.
fn run_base(
    cpu: hw::Ring0,
    rapl: Option[cpu::Rapl],
    take known: runner::Known,
    take keeper: keeper::Keeper,
    bundle: ident::HashValue,
    support: ident::HashValue,
    boot: devices::BootVolume,
    isa: Array[acpi::IsaRoute, 16],
    handoff: bootfmt::Handoff,
    reset: Option[acpi::ResetRegister],
    machine: os::Machine,
    config: runner::Config,
    rings: rings::Rings,
    cpus: mem::Shared[sched::State],
    mut frames: frames::Frames,
    take cells: frames::PoolCells,
    fixed: frames::Fixed,
    take loader: sys::load::Loader,
    spacing: sys::load::Loader,
    shipped: Option[toolchain::Shipped],
    take keyring: Option[loading::MintedShipped],
    take passed: Option[loading::MintedShipped],
    take interfaces: code::MintedInterface,
