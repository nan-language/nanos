/// The root entries of what base instances reach of the core: the device root, where the store reports its events, the feed of the core rings, the `/live` records they publish, the store's, the devices', the part of `/live/security` `keys` tells, `/live/boot` and `/live/sessions`; the monikers of the instances calling them; the power switch; the accounts of sessions; the drivers' meter; and the loading of jobs' bundles.
linear struct Roots {
    root: devices::MintedRoot
    reporter: store::service::MintedReporter
    feed: journal::MintedFeed
    store: os::MintedLive
    devices: os::MintedLive
    keys: os::MintedLive
    boot: os::MintedLive
    sessions: os::MintedLive
    plans: os::MintedLive
    callers: os::MintedCallers
    switch: power::MintedSwitch
    accounts: os::MintedAccounts
    meter: os::MintedMeter
    loading: loading::MintedLoading
    registries: devices::MintedRegistries
} Roots

fn Roots.of(
    orders: task::Sender[devices::RootOrder],
    reported: task::Sender[store::service::Report],
    posted: task::Sender[os::Posting],
    switched: task::Sender[power::Switching],
    accounted: task::Sender[os::AccountOrder],
    take transferred: task::Sender[os::Transfer],
    loads: task::Sender[loading::LoadOrder],
    registered: task::Sender[devices::RegistryOrder],
    backlog: journal::Backlog,
    take monikers: task::Cown[mem::Map[u32, ident::Moniker]],
    alloc: mem::Alloc,
    ) -> Roots {
    return Roots(root: devices::MintedRoot.of(orders, alloc), reporter: store::service::MintedReporter.of(reported, alloc), feed: journal::MintedFeed.of(backlog, alloc), store: os::MintedLive.of(posted, own: "/live/store", alloc), devices: os::MintedLive.of(posted, own: "/live/devices", alloc), keys: os::MintedLive.of(posted, own: "/live/security/keys", alloc), boot: os::MintedLive.of(posted, own: "/live/boot", alloc), sessions: os::MintedLive.of(posted, own: "/live/sessions", alloc), plans: os::MintedLive.of(posted, own: "/live/plans", alloc), callers: os::MintedCallers.of(take monikers, alloc), switch: power::MintedSwitch.of(switched, alloc), accounts: os::MintedAccounts.of(accounted, alloc), meter: os::MintedMeter.of(take transferred, alloc), loading: loading::MintedLoading.of(loads, alloc), registries: devices::MintedRegistries.of(registered, alloc))
} Roots.of

/// Revokes the root entries.
fn Roots.close(take self) {
    let Roots(root: rooted, reporter: reporting, feed: feeding, store: stored, devices: managed, keys: keyed, boot: booted, sessions: linked, plans: planned, callers: calling, switch: switching, accounts: accounting, meter: metering, loading: loads, registries: registering) = self
    take rooted.close()
    take reporting.close()
    take feeding.close()
    take stored.close()
    take managed.close()
    take keyed.close()
    take booted.close()
    take linked.close()
    take planned.close()
    take calling.close()
    take switching.close()
    take accounting.close()
    take metering.close()
    take loads.close()
    take registering.close()
} Roots.close

/// Halts the kernel with `fault.base-not-running` and the first of `store`, `keys`, `journal` and `policy` that is not running 30 s after the core's start.
fn watch_base(control: os::Control, clock: sys::Clock, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let now = match attempt clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
    if now < BASE_DEADLINE_NS {
        try await clock.sleep_ns(BASE_DEADLINE_NS - now)
    }
    try await require_running(control, name: "store", alloc)
    try await require_running(control, name: "keys", alloc)
    try await require_running(control, name: "journal", alloc)
    try await require_running(control, name: "policy", alloc)
} watch_base

/// Halts the kernel with `fault.base-not-running` and `name` unless the instance `name` runs, or hibernates until its next message.
fn require_running(control: os::Control, name: Str, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let running = match first attempt await control.lifecycle(genesis::moniker(name), alloc) {
        Ok(os::Lifecycle.Running) or Ok(os::Lifecycle.Hibernated) => true
        Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
        else => false
    }
    if not running {
        halt(code: "fault.base-not-running", subject: name)
    }
} require_running

/// Holds each log record instances hand to the core in `backlog`, for `journal`.
fn hold_logs(take logged: task::Receiver[journal::Logged], backlog: journal::Backlog) fails task::Cancelled uses wait {
    var receiver = logged
    loop {
        let Some(record) = try await mut receiver.receive() else {
            return
        }
        try await backlog.hold_logged(take record)
    }
} hold_logs

/// Writes each event the store reports to the core rings, keeps the bytes it reports its blob cache and its index nodes hold in `blob_cache` and `store_cache`, hands the grants it reports to the runner through `granted`, and halts the kernel with the code of a failed mount.
fn record_store_events(
    take reports: task::Receiver[store::service::Report],
    rings: rings::Rings,
    blob_cache: mem::Shared[core::atomic::AtomicU64],
    store_cache: mem::Shared[core::atomic::AtomicU64],
    take granted: task::Sender[os::Granted],
    ) fails task::Cancelled uses wait {
    var receiver = reports
    loop {
        let Some(report) = try await mut receiver.receive() else {
            return
        }
        match report {
            store::service::Report.Event(event) => rings.record_store(event)
            store::service::Report.MountFailed(code: code) => halt(code: code.as_str(), subject: "store")
            store::service::Report.BlobCache(bytes: bytes) => blob_cache.contents().store(bytes)
            store::service::Report.StoreCache(bytes: bytes) => store_cache.contents().store(bytes)
            store::service::Report.Grants(grants) => {
                match attempt await granted.send(take grants) {
                    Err(task::SendError.Cancelled(cancelled)) => fail cancelled
                    else => {
                    }
                }
            }
        }
    }
} record_store_events

/// Releases the keeper when the scope never took it.
fn abandon_given(take given: Option[Given]) {
    match given {
        Some(left) => {
            let Given(known: _, machine: _, keeper: kept, orders: _, store_events: _, granted: _, granting: _, postings: _, switches: _, logged: _, traced: _, arming: _, accounting: _, transfers: _, loads: _, registry_orders: _, loader: _, runs: _) = left
            take kept.release()
        }
        None => {
        }
    }
} abandon_given

/// What the tasks of `run_base` take: the genesis record and the machine the runner takes, the keeper with the device root's orders, the events the store reports and the grants it hands the runner, the postings to the board, the orders of the power switch, the log records of instances, the instances `journal` traces and the flight recorders it arms, the orders for the accounts of sessions, the transfers drivers charge, the orders of loading and of the registries with the loader carrying them out, and the runs of the toolchain.
linear struct Given {
    known: runner::Known
    machine: Resources
    keeper: keeper::Keeper
    orders: task::Receiver[devices::RootOrder]
    store_events: task::Receiver[store::service::Report]
    granted: task::Sender[os::Granted]
    granting: task::Receiver[os::Granted]
    postings: task::Receiver[os::Posting]
    switches: task::Receiver[power::Switching]
    logged: task::Receiver[journal::Logged]
    traced: task::Receiver[mem::List[journal::TracedInstance]]
    arming: task::Receiver[journal::Arming]
    accounting: task::Receiver[os::AccountOrder]
    transfers: task::Receiver[os::Transfer]
    loads: task::Receiver[loading::LoadOrder]
    registry_orders: task::Receiver[devices::RegistryOrder]
    loader: sys::load::Loader
    runs: task::Receiver[code::Run]
} Given

test supervisor_starts_from_the_image_genesis for boot_genesis {
    let world = testing::world()
    let alloc = world.alloc
    var bundle = Array[u8, 33].filled(0)
    bundle[0] = 0x01
    let config = runner::Config(base: ident::HashValue(bytes: bundle), exec: world.exec, hibernation: alloc, alloc: alloc, cpus: 1, clock: world.clock, wall: ident::Wall(at: ident::WallTime.unknown(), since_ns: 0), random: world.random, classes: sched::classes(), system: ident::Cause.of(1, number: 1), user_mode: false)
    let rings = rings::Rings.of(cpus: hw::cpu_count(), clock: world.clock, boot: 1, alloc)
    let task::Channel(sender: orders, receiver: unserved) = task::Channel[devices::RootOrder].bounded(1, alloc)
    discard unserved
    let minted = devices::MintedRoot.of(orders, alloc)
    defer take minted.close()
    let task::Channel(sender: reported, receiver: unreported) = task::Channel[store::service::Report].bounded(1, alloc)
    discard unreported
    let reporting = store::service::MintedReporter.of(reported, alloc)
    defer take reporting.close()
    let task::Channel(sender: posted, receiver: unposted) = task::Channel[os::Posting].bounded(1, alloc)
    discard unposted
    let living = os::MintedLive.of(posted, own: "/live/store", alloc)
    defer take living.close()
    let task::Channel(sender: tracings, receiver: untraced) = task::Channel[mem::List[journal::TracedInstance]].bounded(1, alloc)
    let task::Channel(sender: armings, receiver: unarmed) = task::Channel[journal::Arming].bounded(1, alloc)
    let feeding = journal::MintedFeed.of(journal::Backlog.of(tracings, armings, principals: rings.principals(), alloc), alloc)
    defer take feeding.close()
    let task::Channel(sender: switched, receiver: unswitched) = task::Channel[power::Switching].bounded(1, alloc)
    discard unswitched
    let switching = power::MintedSwitch.of(switched, alloc)
    defer take switching.close()
    let naming = os::MintedCallers.of(rings.monikers(), alloc)
    defer take naming.close()
    let task::Channel(sender: accounted, receiver: unaccounted) = task::Channel[os::AccountOrder].bounded(1, alloc)
    let accounts = os::MintedAccounts.of(accounted, alloc)
    defer take accounts.close()
    let task::Channel(sender: transferred, receiver: untransferred) = task::Channel[os::Transfer].bounded(1, alloc)
    discard untransferred
    let metering = os::MintedMeter.of(take transferred, alloc)
    defer take metering.close()
    let task::Channel(sender: loading, receiver: unloaded) = task::Channel[loading::LoadOrder].bounded(1, alloc)
    discard unloaded
    let loads = loading::MintedLoading.of(loading, alloc)
    defer take loads.close()
    let task::Channel(sender: registering, receiver: unregistered) = task::Channel[devices::RegistryOrder].bounded(1, alloc)
    discard unregistered
    let registries = devices::MintedRegistries.of(registering, alloc)
    defer take registries.close()
    let interfaces = code::MintedInterface.of(Untrusted.of(b""), support: ident::HashValue(bytes: bundle), alloc)
    defer take interfaces.close()
    let base = Base(root: minted.mint(claim: false), claims: minted.mint(claim: true), bundle: ident::HashValue(bytes: bundle), support: ident::HashValue(bytes: bundle), image_bytes: 0, boot: devices::BootVolume(scheme: 0, partition: 0, signature: Array[u8, 16].filled(0)), isa: Array[acpi::IsaRoute, 16].filled(acpi::IsaRoute(line: 0, edge: None, active_low: None)), reporter: reporting.mint(), store_live: living.mint(), devices_live: living.mint(), wall: config.wall, handoff: bootfmt::Handoff.empty(), feed: feeding.mint(), keys_live: living.mint(), boot_live: living.mint(), machine: os::Machine(arch: os::Arch.Amd64, conditions: os::Conditions(iommu: false, tpm: false, secure_boot: false, user_mode: false, invariant_tsc: false, tsc_deadline: false, pcid: false, pages_1g: false, mwait: false, watchdog: false, nic: false), ram_bytes: 1, cpus: 1, level: os::Level.X86v1, smt: false, numa_nodes: 1, storage: os::Storage.File, power: os::PowerSource.Mains), switch: switching.mint(), sessions_live: living.mint(), plans_live: living.mint(), callers: naming.mint(), accounts: accounts.mint(), meter: metering.mint(), loading: loads.mint(), spaces: None, registries: registries.mint(), jobs: genesis::Jobs.of(ident::HashValue(bytes: bundle), tree: None, alloc), genesis: None, toolchain: None, keyring: None, kernel: interfaces.mint())
    let task::Channel(sender: logs, receiver: unlogged) = task::Channel[journal::Logged].bounded(1, alloc)
    discard unlogged
    let task::Channel(sender: ungranted, receiver: granting) = task::Channel[os::Granted].bounded(1, alloc)
    discard ungranted
    let image = genesis::Image(bundle: ident::HashValue(bytes: bundle), support: ident::HashValue(bytes: bundle), bytes: 0)
    let Some(record) = boot_genesis(None, handoff: bootfmt::Handoff.empty(), image, jobs: genesis::Jobs.of(image.bundle, tree: None, alloc), alloc) else {
        expect false
        return
    }
    let Some(known) = known_of(take record, alloc) else {
        expect false
        return
    }
    let started = try await runner::run(take known, components: base, journal: rings, machine: Unkept(alloc: alloc), accounting: take unaccounted, config, postings: posted, logs, gauges: runner::Gauges.empty(alloc), tracings: take untraced, arming: take unarmed, take granting, body: fn(core: runner::Core) -> os::Lifecycle fails os::ControlError uses wait {
        let started = try await core.control.start(genesis::moniker("supervisor"), alloc)
        discard try await core.control.stop(genesis::moniker("supervisor"), alloc)
        return started
    })
    expect started == Some(os::Lifecycle.Running)
} supervisor_starts_from_the_image_genesis

/// The size of the pool of `Unkept`.
const UNKEPT_BYTES: u64 = 0x400_0000

/// The machine of the tests running base instances without a memory keeper: one pool, the world's allocator, at level 0, no region to reserve, 2 W for a running CPU, and neither reservations nor account terms kept.
struct Unkept {
    alloc: mem::Alloc
} Unkept

impl Unkept: runner::Machine

fn Unkept.reserve(self, bytes: u64) -> Option[mem::Heap] = None

fn Unkept.pool(self) -> Option[runner::Pooled] = Some(runner::Pooled(number: 0, alloc: self.alloc, bytes: UNKEPT_BYTES))

fn Unkept.settle(self, pool: u32) -> u8 = 0

/// Levels that never change.
fn Unkept.changed(self, seen: mem::List[u8]) -> mem::List[u8] fails task::Cancelled uses wait {
    let never = hw::Signal[Unit].empty()
    try await never.wait()
    return mem::List.empty(self.alloc)
} Unkept.changed

fn Unkept.busy_mw(self) -> mem::Shared[core::atomic::AtomicU64] {
    return mem::Shared.of(core::atomic::AtomicU64.of(2_000), alloc: self.alloc)
} Unkept.busy_mw

fn Unkept.run_reservation(
    self,
    id: u64,
    cpu: u32,
    runtime_ns: u64,
    period_ns: u64,
    ) {
} Unkept.run_reservation

fn Unkept.end_reservation(self, id: u64) {
} Unkept.end_reservation

fn Unkept.bind(
    self,
    executor: u64,
    account: u32,
    reservation: u64,
    cpu: u32,
    group: u64,
    ) {
} Unkept.bind

fn Unkept.unbind(self, executor: u64) {
} Unkept.unbind

fn Unkept.lend(self, executor: u64, lender: u32) {
} Unkept.lend

fn Unkept.unlend(self, executor: u64) {
} Unkept.unlend
