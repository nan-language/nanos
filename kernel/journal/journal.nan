//! The core rings: each CPU's ring of the events the core and the runner write, with interrupts disabled, for the journal to drain.

/// The records of a ring: one 64 KiB chunk of the core reserve.
const RING_RECORDS: usize = 2_048

/// The severity of a `critical` record, which makes its ring due at once.
const CRITICAL: u8 = 5

/// How long a ring's oldest record waits before the ring is due.
const DUE_NS: u64 = 1_000_000_000

/// A record of a core ring.
pkg layout Record: bytes 32 le {
    time: u64 at 0
    cause: u64 at 8
    source: u32 at 16
    kind: u16 at 20
    severity: u8 at 22
    flags: u8 at 23
    argument: u64 at 24
} Record

/// A ring: its records, where the next goes and where the oldest it holds is, how many it holds for the journal, how many found it full, and whether a quarter of it filled or a critical record entered it since it was last empty.
struct Ring {
    records: mem::List[Record]
    next: usize
    oldest: usize
    held: usize
    lost: u64
    due: bool
} Ring

/// The core rings, one per CPU by number, the running CPU's number, the clock their records are timed by, and the signal writers post when the journal must look at the rings.
pkg struct Rings {
    rings: mem::List[hw::SpinLock[Ring]]
    here: hw::PerCpu[u32]
    clock: sys::Clock
    signal: mem::Shared[hw::Signal[Unit]]
} Rings

impl Rings: runner::Journal

/// The rings of `cpus` CPUs, drawn through `alloc`.
pkg fn Rings.of(cpus: u32, clock: sys::Clock, alloc: mem::Alloc) -> Rings {
    var rings = mem::List[hw::SpinLock[Ring]].empty(alloc)
    for _ in 0..<cpus {
        var records = mem::List[Record].empty(alloc)
        for _ in 0..<RING_RECORDS {
            mut records.push(Record.from_bits(Array[u8, 32].filled(0)))
        }
        mut rings.push(hw::SpinLock.of(Ring(records: take records, next: 0, oldest: 0, held: 0, lost: 0, due: false)))
    }
    return Rings(rings: take rings, here: hw::PerCpu.of(init: fn(cpu: u32) => cpu, alloc), clock: clock, signal: mem::Shared.of(hw::Signal[Unit].empty(), alloc))
} Rings.of

/// Writes the record of an event, and its continuation when it has one, in the running CPU's ring, counting the event lost when the ring has no room for it, and posts the signal when the journal must look at the ring.
pkg fn Rings.record(self, slot: u32, event: runner::Event) {
    self.write(Record(time: elapsed(self.clock), cause: 0, source: slot, kind: kind_of(event), severity: severity_of(event), flags: 0, argument: argument_of(event)), continuation: continuation_of(event))
} Rings.record

/// Writes the record of a device event as the core's, its continuation holding the device's bus path.
pkg fn Rings.record_device(self, event: devices::Event) {
    var payload = Array[u8, 32].filled(0)
    let path = event.path.text()
    var at: usize = 0
    for byte in path.as_bytes() {
        payload[at] = byte
        at += 1
    }
    self.write(Record(time: elapsed(self.clock), cause: 0, source: 0, kind: device_kind(event.kind), severity: device_severity(event.kind), flags: 0, argument: event.argument), continuation: Some(Record.from_bits(payload)))
} Rings.record_device

/// Writes the record of an event of the store as the core's: its argument is the log bytes a mount replayed, the address of a corrupt structure, the commits thinned, or the free bytes when writes are refused.
pkg fn Rings.record_store(self, event: store::Event) {
    let kind = match event {
        store::Event.Mounted(format: _, replayed: _) => STORE_MOUNTED
        store::Event.Corruption(address: _, kind: _) => STORE_CORRUPTION
        store::Event.DeviceFailed => STORE_DEVICE_FAILED
        store::Event.HistoryThinned(commits: _, bytes: _, oldest: _) => STORE_HISTORY_THINNED
        store::Event.WritesRefused(free: _, history: _) => STORE_WRITES_REFUSED
    }
    let severity: u8 = match event {
        store::Event.Mounted(format: _, replayed: _) => 1
        store::Event.HistoryThinned(commits: _, bytes: _, oldest: _) => 2
        store::Event.WritesRefused(free: _, history: _) => 3
        store::Event.Corruption(address: _, kind: _) => 4
        store::Event.DeviceFailed => 5
    }
    let argument = match event {
        store::Event.Mounted(format: _, replayed: replayed) => replayed
        store::Event.Corruption(address: address, kind: _) => address
        store::Event.DeviceFailed => 0
        store::Event.HistoryThinned(commits: commits, bytes: _, oldest: _) => commits
        store::Event.WritesRefused(free: free, history: _) => free
    }
    self.write(Record(time: elapsed(self.clock), cause: 0, source: 0, kind: kind, severity: severity, flags: 0, argument: argument), continuation: None)
} Rings.record_store

fn Rings.write(self, record: Record, continuation: Option[Record]) {
    var written = record
    if continuation.is_some() {
        written.flags = CONTINUED
    }
    hw::without_irqs(fn(t: hw::IrqsDisabled) limits notrap, terminates {
        let cpu = self.here.with(t, body: fn(mut number: u32) -> u32 limits notrap, terminates, noalloc {
            return number
        })
        let Some(ring) = self.rings.get(usize.widen(cpu)) else {
            return
        }
        let wake = ring.with(t, body: fn(mut held: Ring) -> bool limits notrap, terminates, noalloc {
            return mut held.write(written, continuation)
        })
        if wake {
            self.signal.contents().post(t, value: Unit)
        }
    })
} Rings.write

/// Waits until a ring is due, a quarter full, holding a critical record or holding a record 1 s old, and gives its CPU's number; while every ring is empty it waits for a write alone. The tasks of `exec` race the signal against the clock.
pkg fn Rings.due(self, exec: task::Executor) -> u32 fails task::Cancelled uses wait {
    loop {
        let now = elapsed(self.clock)
        var earliest: Option[u64] = None
        for cpu in 0..<self.rings.len() {
            let Some(at) = self.due_at(cpu) else {
                continue
            }
            if at <= now {
                return u32.fit(cpu)
            }
            match earliest {
                Some(sooner) => {
                    if at < sooner {
                        earliest = Some(at)
                    }
                }
                None => {
                    earliest = Some(at)
                }
            }
        }
        match earliest {
            Some(at) => {
                let signal = self.signal.share()
                let clock = self.clock
                try await task::race(exec, left: fn[take signal]() fails task::Cancelled uses wait limits stack 4_096 {
                    try await signal.contents().wait()
                }, right: fn() fails task::Cancelled uses wait limits stack 4_096 {
                    try await clock.sleep_ns(at - now)
                })
            }
            None => try await self.signal.contents().wait()
        }
    }
} Rings.due

/// Moves the records `cpu`'s ring holds into `into`, oldest first, each event's continuation after it, and gives how many events found it full since its last drain.
pkg fn Rings.drain(self, cpu: u32, mut into: mem::List[Record]) -> u64 {
    let Some(ring) = self.rings.get(usize.widen(cpu)) else {
        return 0
    }
    let count = hw::without_irqs(fn(t: hw::IrqsDisabled) -> usize limits notrap, terminates {
        return ring.with(t, body: fn(mut held: Ring) -> usize limits notrap, terminates, noalloc {
            return held.held
        })
    })
    for _ in 0..<count {
        let taken = hw::without_irqs(fn(t: hw::IrqsDisabled) -> Option[Record] limits notrap, terminates {
            return ring.with(t, body: fn(mut held: Ring) -> Option[Record] limits notrap, terminates, noalloc {
                return mut held.pop()
            })
        })
        let Some(record) = taken else {
            break
        }
        mut into.push(record)
    }
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> u64 limits notrap, terminates {
        return ring.with(t, body: fn(mut held: Ring) -> u64 limits notrap, terminates, noalloc {
            let lost = held.lost
            held.lost = 0
            return lost
        })
    })
} Rings.drain

/// When the ring `cpu` is due, in nanoseconds of the clock: 0 when it is due at once, `None` when it holds no record.
fn Rings.due_at(self, cpu: usize) -> Option[u64] {
    let Some(ring) = self.rings.get(cpu) else {
        return None
    }
    return hw::without_irqs(fn(t: hw::IrqsDisabled) -> Option[u64] limits notrap, terminates {
        return ring.with(t, body: fn(mut held: Ring) -> Option[u64] limits notrap, terminates, noalloc {
            return held.due_at()
        })
    })
} Rings.due_at

/// Writes `record` and its continuation, counting the event lost when the ring has no room for both; whether the journal must look at the ring: the event entered it empty, filled a quarter of it, or is critical.
fn Ring.write(mut self, record: Record, continuation: Option[Record]) -> bool limits notrap, terminates, noalloc {
    let size = self.records.len()
    let needed: usize = match continuation {
        Some(_) => 2
        None => 1
    }
    if needed > size or self.held > size - needed {
        self.lost = self.lost.saturating_add(1)
        return false
    }
    let before = self.held
    mut self.put(record)
    match continuation {
        Some(more) => mut self.put(more)
        None => {
        }
    }
    if (before < size / 4 and self.held >= size / 4) or record.severity == CRITICAL {
        self.due = true
        return true
    }
    return before == 0
} Ring.write

/// Writes `record` after the newest record, when the ring has room for it.
fn Ring.put(mut self, record: Record) limits notrap, terminates, noalloc {
    let size = self.records.len()
    if self.held >= size or self.next >= size {
        return
    }
    self.records[self.next] = record
    var next = self.next + 1
    if next == size {
        next = 0
    }
    self.next = next
    self.held += 1
} Ring.put

/// Takes the oldest record the ring holds; a ring holding none is no longer due.
fn Ring.pop(mut self) -> Option[Record] limits notrap, terminates, noalloc {
    let size = self.records.len()
    if self.held == 0 or self.oldest >= size {
        return None
    }
    let record = self.records[self.oldest]
    var oldest = self.oldest + 1
    if oldest == size {
        oldest = 0
    }
    self.oldest = oldest
    self.held -= 1
    if self.held == 0 {
        self.due = false
    }
    return Some(record)
} Ring.pop

/// When the ring is due: 0 when it is due at once, else 1 s after its oldest record, `None` when it holds none.
fn Ring.due_at(self) -> Option[u64] limits notrap, terminates, noalloc {
    if self.held == 0 or self.oldest >= self.records.len() {
        return None
    }
    if self.due {
        return Some(0)
    }
    return Some(self.records[self.oldest].time.saturating_add(DUE_NS))
} Ring.due_at

/// The flag of a record that a continuation record follows.
const CONTINUED: u8 = 0x01

/// The kernel image's kind table: the index of each kind the core and the runner record, `auth.revoked`'s continuation holding its reason.
const STARTED: u16 = 0

const STOPPED: u16 = 1

const TRAPPED: u16 = 2

const FAILED: u16 = 3

const SLOW_HANDLER: u16 = 4

const INTEGRITY: u16 = 5

const REVOKED: u16 = 6

/// The kinds of device events follow, in the order of `devices::EventKind`, their continuation holding the device's bus path.
const DEVICE_ADDED: u16 = 7

const DEVICE_REMOVED: u16 = 8

const DEVICE_TABLE_INVALID: u16 = 9

const DEVICE_BOUND: u16 = 10

const DEVICE_UNBOUND: u16 = 11

const DEVICE_CUT_OFF: u16 = 12

const DEVICE_FAILED: u16 = 13

const DEVICE_SUSPENDED: u16 = 14

const DEVICE_RESUMED: u16 = 15

const DEVICE_INTERRUPT_STORM: u16 = 16

/// The kinds of the store's events follow, in the order of `store::Event`.
const STORE_MOUNTED: u16 = 17

const STORE_CORRUPTION: u16 = 18

const STORE_DEVICE_FAILED: u16 = 19

const STORE_HISTORY_THINNED: u16 = 20

const STORE_WRITES_REFUSED: u16 = 21

/// The continuation of an event that has more payload than its record holds: the reason of an `auth.revoked`.
fn continuation_of(event: runner::Event) -> Option[Record] {
    let runner::Event.Revoked(grant: _, reason: reason) = event else {
        return None
    }
    var payload = Array[u8, 32].filled(0)
    payload[0] = match reason {
        runner::Reason.Revoke => 0
        runner::Reason.Expiry => 1
    }
    return Some(Record.from_bits(payload))
} continuation_of

/// The name of the kind of index `kind` in the kernel image's kind table.
pkg fn kind_name(kind: u16) -> text::Fixed[24] {
    return text::Fixed[24].of(match kind {
        STARTED => "instance.started"
        STOPPED => "instance.stopped"
        TRAPPED => "instance.trapped"
        FAILED => "instance.failed"
        SLOW_HANDLER => "instance.slow-handler"
        INTEGRITY => "fault.integrity"
        REVOKED => "auth.revoked"
        DEVICE_ADDED => "device.added"
        DEVICE_REMOVED => "device.removed"
        DEVICE_TABLE_INVALID => "device.table-invalid"
        DEVICE_BOUND => "device.bound"
        DEVICE_UNBOUND => "device.unbound"
        DEVICE_CUT_OFF => "device.cut-off"
        DEVICE_FAILED => "device.failed"
        DEVICE_SUSPENDED => "device.suspended"
        DEVICE_RESUMED => "device.resumed"
        DEVICE_INTERRUPT_STORM => "device.interrupt-storm"
        STORE_MOUNTED => "store.mounted"
        STORE_CORRUPTION => "store.corruption"
        STORE_DEVICE_FAILED => "store.device-failed"
        STORE_HISTORY_THINNED => "store.history-thinned"
        STORE_WRITES_REFUSED => "store.writes-refused"
        else => "unknown"
    })
} kind_name

/// The name of a severity, from `debug` for 0 up to `critical` for 5.
pkg fn severity_name(severity: u8) -> text::Fixed[8] {
    return text::Fixed[8].of(match severity {
        0 => "debug"
        1 => "info"
        2 => "notice"
        3 => "warn"
        4 => "error"
        else => "critical"
    })
} severity_name

/// Whether a record has a continuation after it.
pkg fn Record.continued(self) -> bool = (self.flags & CONTINUED) != 0

/// What the continuation of a record of kind `kind` adds: the reason of an `auth.revoked`, the bus path of a device event.
pkg fn detail(kind: u16, continuation: Record) -> text::Fixed[40] {
    if kind >= DEVICE_ADDED and kind <= DEVICE_INTERRUPT_STORM {
        var path = text::Fixed[40].of("path ")
        for byte in continuation.to_bits() {
            if byte == 0 {
                break
            }
            mut path.push(char.checked_from_bits(u32.widen(byte)).value_or('?'))
        }
        return path
    }
    if kind != REVOKED {
        return text::Fixed[40].empty()
    }
    return text::Fixed[40].of(match continuation.to_bits()[0] {
        0 => "reason revoke"
        1 => "reason expiry"
        else => "reason unknown"
    })
} detail

fn device_kind(kind: devices::EventKind) -> u16 {
    return match kind {
        devices::EventKind.Added => DEVICE_ADDED
        devices::EventKind.Removed => DEVICE_REMOVED
        devices::EventKind.TableInvalid => DEVICE_TABLE_INVALID
        devices::EventKind.Bound => DEVICE_BOUND
        devices::EventKind.Unbound => DEVICE_UNBOUND
        devices::EventKind.CutOff => DEVICE_CUT_OFF
        devices::EventKind.Failed => DEVICE_FAILED
        devices::EventKind.Suspended => DEVICE_SUSPENDED
        devices::EventKind.Resumed => DEVICE_RESUMED
        devices::EventKind.InterruptStorm => DEVICE_INTERRUPT_STORM
    }
} device_kind

/// A device event's severity: `info` for the topology and bindings, `notice` for cut-offs, `warn` for invalid tables, `error` for failures and storms.
fn device_severity(kind: devices::EventKind) -> u8 {
    return match kind {
        devices::EventKind.CutOff => 2
        devices::EventKind.TableInvalid => 3
        devices::EventKind.Failed or devices::EventKind.InterruptStorm => 4
        else => 1
    }
} device_severity

/// The clock's reading in nanoseconds, 0 once it is revoked.
fn elapsed(clock: sys::Clock) -> u64 {
    return match attempt clock.elapsed_ns() {
        Ok(ns) => ns
        Err(_) => 0
    }
} elapsed

/// The index of an event's kind in the kernel image's kind table.
fn kind_of(event: runner::Event) -> u16 {
    return match event {
        runner::Event.Started(incarnation: _) => STARTED
        runner::Event.Stopped(abandoned: _) => STOPPED
        runner::Event.Trapped(incarnation: _, kind: _, limit: _) => TRAPPED
        runner::Event.Failed(restarts: _) => FAILED
        runner::Event.SlowHandler(ns: _) => SLOW_HANDLER
        runner::Event.Integrity(incarnation: _) => INTEGRITY
        runner::Event.Revoked(grant: _, reason: _) => REVOKED
    }
} kind_of

/// An event's severity: 0 for `debug` up to 5 for `critical`.
fn severity_of(event: runner::Event) -> u8 {
    return match event {
        runner::Event.Started(incarnation: _) or runner::Event.Stopped(abandoned: _) => 1
        runner::Event.Revoked(grant: _, reason: _) => 2
        runner::Event.SlowHandler(ns: _) => 3
        runner::Event.Trapped(incarnation: _, kind: _, limit: _) or runner::Event.Failed(restarts: _) => 4
        runner::Event.Integrity(incarnation: _) => 5
    }
} severity_of

/// The first 8 bytes of an event's payload.
fn argument_of(event: runner::Event) -> u64 {
    return match event {
        runner::Event.Started(incarnation: incarnation) => incarnation
        runner::Event.Stopped(abandoned: true) => 1
        runner::Event.Stopped(abandoned: false) => 0
        runner::Event.Trapped(incarnation: incarnation, kind: _, limit: _) => incarnation
        runner::Event.Failed(restarts: restarts) => u64.widen(restarts)
        runner::Event.SlowHandler(ns: ns) => ns
        runner::Event.Integrity(incarnation: incarnation) => incarnation
        runner::Event.Revoked(grant: grant, reason: _) => grant
    }
} argument_of

test rings_wake_the_journal_and_count_what_they_drop for Ring.write {
    let alloc = testing::world().alloc
    var records = mem::List[Record].empty(alloc)
    for _ in 0..<8u32 {
        mut records.push(Record.from_bits(Array[u8, 32].filled(0)))
    }
    var ring = Ring(records: take records, next: 0, oldest: 0, held: 0, lost: 0, due: false)
    var woke = Array[bool, 10].filled(false)
    for at in 0..<10usize {
        woke[at] = mut ring.write(Record(time: 1, cause: 0, source: 3, kind: 0, severity: 1, flags: 0, argument: u64.widen(at)), continuation: None)
    }
    expect woke[0] and woke[1] and not woke[2] and not woke[7] and not woke[9]
    expect ring.held == 8 and ring.lost == 2 and ring.next == 0 and ring.due
    var taken = mem::List[u64].empty(alloc)
    for _ in 0..<3u32 {
        let Some(record) = mut ring.pop() else {
            break
        }
        mut taken.push(record.argument)
    }
    for at in 10..<13u64 {
        discard mut ring.write(Record(time: 1, cause: 0, source: 3, kind: 0, severity: 1, flags: 0, argument: at), continuation: None)
    }
    loop {
        let Some(record) = mut ring.pop() else {
            break
        }
        mut taken.push(record.argument)
    }
    expect taken.len() == 11 and taken[0] == 0 and taken[2] == 2 and taken[3] == 3 and taken[7] == 7 and taken[8] == 10 and taken[10] == 12
    expect ring.held == 0 and not ring.due and ring.due_at().is_none()
} rings_wake_the_journal_and_count_what_they_drop

test rings_fall_due_a_quarter_full_on_critical_records_or_a_second_after_their_oldest for Rings.due {
    let world = testing::world()
    let alloc = world.alloc
    let cpus = hw::cpu_count()
    let rings = Rings.of(cpus, clock: world.clock, alloc)
    rings.record(slot: 1, event: runner::Event.Started(incarnation: 1))
    let early = try await task::within(world.clock, ms: 500, body: fn() -> u32 fails task::Cancelled uses wait {
        return try await rings.due(world.exec)
    })
    let aged = try await rings.due(world.exec)
    var records = mem::List[Record].empty(alloc)
    let lost = rings.drain(aged, into: mut records)
    expect early.is_none()
    expect lost == 0 and records.len() == 1 and records[0].source == 1
    let quarters = (RING_RECORDS / 4) * usize.widen(cpus)
    for _ in 0..<quarters {
        rings.record(slot: 2, event: runner::Event.Started(incarnation: 1))
    }
    let quarter = try await task::within(world.clock, ms: 100, body: fn() -> u32 fails task::Cancelled uses wait {
        return try await rings.due(world.exec)
    })
    for cpu in 0..<cpus {
        discard rings.drain(cpu, into: mut records)
    }
    rings.record(slot: 3, event: runner::Event.Integrity(incarnation: 1))
    let urgent = try await task::within(world.clock, ms: 100, body: fn() -> u32 fails task::Cancelled uses wait {
        return try await rings.due(world.exec)
    })
    expect quarter.is_some()
    let Some(cpu) = urgent else {
        expect false
        return
    }
    var last = mem::List[Record].empty(alloc)
    discard rings.drain(cpu, into: mut last)
    expect last.len() == 1 and last[0].severity == CRITICAL
} rings_fall_due_a_quarter_full_on_critical_records_or_a_second_after_their_oldest
