//! The base jobs: the generation's jobs, which the kernel image runs and genesis admits, the `nan` job among them on a machine running the toolchain the generation ships.

/// The stack a base job's `main` runs on.
const JOB_STACK: usize = 262_144

/// The bytes of a base job's failure its rendering keeps.
const FAILURE_BUDGET: usize = 1_024

fn Base.base_job(self, code: ident::HashValue) -> bool = self.base_job_of(code).is_some()

/// A base job.
enum BaseJob derives Copy, Eq {
    Selftest
    Scrub
    Replay
    Nan
} BaseJob

/// The base job of code hash `code`, `None` for another bundle's job.
fn Base.base_job_of(self, code: ident::HashValue) -> Option[BaseJob] {
    if code == self.jobs.selftest {
        return Some(BaseJob.Selftest)
    }
    if code == self.jobs.scrub {
        return Some(BaseJob.Scrub)
    }
    if code == self.jobs.replay {
        return Some(BaseJob.Replay)
    }
    if self.jobs.nan == Some(code) {
        return Some(BaseJob.Nan)
    }
    return None
} Base.base_job_of

/// Runs the base job of code hash `code` on `world` with `input`, the encoding of its input, in a domain run of `domain` through `exec` and `alloc`, as a loaded bundle's `main` runs: `Cancelled` with an empty reason when `domain` abandoned it.
fn Base.run_base_job(
    self,
    code: ident::HashValue,
    take input: mem::Bytes,
    take world: nanos::World,
    domain: sys::Abandoner,
    exec: task::Executor,
    alloc: mem::Alloc,
    ) -> os::JobOutcome fails task::Cancelled uses wait {
    let Some(job) = self.base_job_of(code) else {
        return os::JobOutcome.Failed(text: text::String.of("code.malformed", alloc))
    }
    let ran = attempt await domain.run_sized(fn[take world, take input]() -> os::JobOutcome fails task::Cancelled uses wait limits stack 196_608 {
        return try await job.run(base: self, take world, take input, alloc)
    }, stack: JOB_STACK, exec, alloc)
    return match first ran {
        Ok(Ok(outcome)) => outcome
        Ok(Err(trap)) if trap.kind() == sys::TrapKind.Abandoned => os::JobOutcome.Cancelled(reason: text::String.empty(alloc))
        Ok(Err(trap)) => os::JobOutcome.Trapped(text: text::String.of(journal::trap_code(trap.kind()).as_str(), alloc))
        Err(cancelled) => fail cancelled
    }
} Base.run_base_job

/// Runs the job's `main` on `world` with the input `input` encodes, the `nan` job's through `base`: its result encoded, its failure rendered, `instance.input-mismatch` for an input that does not decode.
fn BaseJob.run(
    self,
    base: Base,
    take world: nanos::World,
    take input: mem::Bytes,
    alloc: mem::Alloc,
    ) -> os::JobOutcome fails task::Cancelled uses wait {
    match self {
        BaseJob.Nan => return try await base.run_nan(take input, take world, alloc)
        BaseJob.Selftest => {
            let Ok(given) = attempt mem::wire::Codec[Unit].decode(Untrusted.of(input.view()), alloc) else {
                return mismatch(alloc)
            }
            let ended: Result[mem::List[selftest::Check], task::Cancelled] = attempt await selftest::main(take world, input: given)
            return outcome_of(ended, alloc)
        }
        BaseJob.Scrub => {
            let Ok(given) = attempt mem::wire::Codec[Unit].decode(Untrusted.of(input.view()), alloc) else {
                return mismatch(alloc)
            }
            let ended: Result[store::ScrubReport, scrub::Unscrubbed] = attempt await scrub::main(take world, input: given)
            return outcome_of(ended, alloc)
        }
        BaseJob.Replay => {
            let Ok(given) = attempt mem::wire::Codec[journal::ReplayRequest].decode(Untrusted.of(input.view()), alloc) else {
                return mismatch(alloc)
            }
            let ended: Result[journal::ReplayReport, replay::Unreplayed] = attempt await replay::main(take world, input: take given)
            return outcome_of(ended, alloc)
        }
    }
} BaseJob.run

/// How a `main` ending with `result` ended: its result encoded, or its failure rendered.
fn outcome_of[O: Encode, F: Render](result: Result[O, F], alloc: mem::Alloc) -> os::JobOutcome {
    return match result {
        Ok(output) => {
            var bytes = mem::Bytes.empty(alloc)
            mem::wire::Codec[O].encode(output, out: mut bytes)
            return os::JobOutcome.Returned(bytes: take bytes)
        }
        Err(failure) => {
            var text = text::String.empty(alloc)
            mut text.write(Dyn[Render].view(failure), budget: FAILURE_BUDGET)
            return os::JobOutcome.Failed(text: take text)
        }
    }
} outcome_of

/// The failure of a job whose input does not decode.
fn mismatch(alloc: mem::Alloc) -> os::JobOutcome {
    return os::JobOutcome.Failed(text: text::String.of("instance.input-mismatch", alloc))
} mismatch
