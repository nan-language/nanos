//! NUMA nodes: the SRAT's proximity domains, numbered from 0 in increasing order.

/// The NUMA nodes of the machine and what lies in each.
pkg struct Nodes {
    domains: mem::List[u32]
    memory: mem::List[acpi::MemoryAffinity]
    processors: mem::List[acpi::ProcessorAffinity]
} Nodes

/// The nodes the SRAT describes, one node holding everything without it.
pkg fn Nodes.of(take srat: Option[acpi::Srat], alloc: mem::Alloc) -> Nodes {
    var domains = mem::List[u32].empty(alloc)
    let Some(table) = srat else {
        return Nodes(domains: take domains, memory: mem::List.empty(alloc), processors: mem::List.empty(alloc))
    }
    for range in table.memory {
        add_domain(mut domains, domain: range.domain)
    }
    for processor in table.processors {
        add_domain(mut domains, domain: processor.domain)
    }
    let acpi::Srat(memory: memory, processors: processors) = table
    return Nodes(domains: take domains, memory: take memory, processors: take processors)
} Nodes.of

/// Inserts `domain` into the increasing list `domains` unless it holds it.
fn add_domain(mut domains: mem::List[u32], domain: u32) {
    var at: usize = 0
    while at < domains.len() and domains[at] < domain {
        at += 1
    }
    if at == domains.len() or domains[at] != domain {
        mut domains.insert(at, value: domain)
    }
} add_domain

/// The number of nodes, at least 1.
pkg fn Nodes.count(self) -> u32 {
    if self.domains.len() == 0 {
        return 1
    }
    return u32.fit(self.domains.len())
} Nodes.count

/// The node holding physical address `address`, node 0 when no range of the SRAT holds it.
pkg fn Nodes.of_address(self, address: u64) -> u32 {
    for range in self.memory {
        if address >= range.base and address - range.base < range.byte_len {
            return self.node(range.domain)
        }
    }
    return 0
} Nodes.of_address

/// The node of the CPU whose APIC id is `apic_id`, node 0 when the SRAT names none.
pkg fn Nodes.of_cpu(self, apic_id: u64) -> u32 {
    for processor in self.processors {
        if u64.widen(processor.apic_id) == apic_id {
            return self.node(processor.domain)
        }
    }
    return 0
} Nodes.of_cpu

fn Nodes.node(self, domain: u32) -> u32 {
    for at in 0..<self.domains.len() {
        if self.domains[at] == domain {
            return u32.fit(at)
        }
    }
    return 0
} Nodes.node

test cpus_and_memory_find_their_nodes for Nodes.of_cpu {
    let alloc = testing::world().alloc
    var memory = mem::List[acpi::MemoryAffinity].empty(alloc)
    mut memory.push(acpi::MemoryAffinity(base: 0, byte_len: 0x4000_0000, domain: 9))
    var processors = mem::List[acpi::ProcessorAffinity].empty(alloc)
    mut processors.push(acpi::ProcessorAffinity(apic_id: 0, domain: 9))
    mut processors.push(acpi::ProcessorAffinity(apic_id: 2, domain: 4))
    let nodes = Nodes.of(Some(acpi::Srat(memory: take memory, processors: take processors)), alloc)
    expect nodes.count() == 2
    expect nodes.of_cpu(0) == 1
    expect nodes.of_cpu(2) == 0
    expect nodes.of_cpu(7) == 0
    expect nodes.of_address(0x1000) == 1
    let single = Nodes.of(None, alloc)
    expect single.count() == 1
    expect single.of_cpu(3) == 0
} cpus_and_memory_find_their_nodes
