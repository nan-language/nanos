//! The lines the core prints on the serial console: its start line, the events the core rings record, and the line before a kernel halt.

const SERIAL_PORT: u16 = 0x3F8

const MIB: u64 = 1_048_576

layout LineStatus: u8 {
    holding_empty: bit 5
    reserved: rest
} LineStatus

registers Uart {
    data: u8 at 0x0 write
    line_status: LineStatus at 0x5 read
} Uart

/// A line of at most 240 bytes.
struct Line {
    text: text::Fixed[240]
} Line

/// The measured facts the start line gives.
struct Facts derives Copy {
    cpus: u32
    nodes: u32
    ram_bytes: u64
    features: cpu::Features
    conditions: bootfmt::Conditions
} Facts

/// Prints `kernel: <code> <subject>`.
fn report_halt(code: Str, subject: Str) {
    var line = Line(text: text::Fixed[240].of("kernel: "))
    mut line.text.append(code)
    mut line.text.append(" ")
    mut line.text.append(subject)
    line.print()
} report_halt

/// Halts the kernel at a failed start step, after its line `kernel: <code> <subject>`.
fn halt(code: Str, subject: Str) -> Never {
    report_halt(code, subject)
    expect false
    loop {
    }
} halt

/// Prints `kernel: started` followed by the machine's measured facts and the memory the core holds: its CPUs, NUMA nodes and RAM in MiB, the number of node pools and the MiB they hold, the MiB of free frames, then the level, whether its cores run several hardware threads, and the machine conditions that hold among those the loader and the start detect.
fn report_start(facts: Facts, memory: frames::Memory) {
    var line = Line(text: text::Fixed[240].of("kernel: started "))
    mut line.count(u64.widen(facts.cpus), one: " cpu, ", many: " cpus, ")
    mut line.count(u64.widen(facts.nodes), one: " node, ", many: " nodes, ")
    mut line.decimal(facts.ram_bytes / MIB)
    mut line.text.append(" MiB: ")
    mut line.count(u64.widen(memory.pools.len()), one: " pool of ", many: " pools of ")
    mut line.decimal(memory.pool_bytes / MIB)
    mut line.text.append(" MiB, ")
    mut line.decimal(memory.frames.free_bytes() / MIB)
    mut line.text.append(" MiB of frames, level ")
    mut line.text.append(match facts.features.level {
        cpu::Level.X86v1 => "x86-64"
        cpu::Level.X86v2 => "x86-64-v2"
        cpu::Level.X86v3 => "x86-64-v3"
        cpu::Level.X86v4 => "x86-64-v4"
    })
    if facts.features.smt {
        mut line.text.append(", smt")
    }
    mut line.text.append(", conditions")
    mut line.condition(facts.conditions.tpm, name: "tpm")
    mut line.condition(facts.conditions.secure_boot, name: "secure-boot")
    mut line.condition(facts.features.invariant_tsc, name: "invariant-tsc")
    mut line.condition(facts.features.tsc_deadline, name: "tsc-deadline")
    mut line.condition(facts.features.pcid, name: "pcid")
    mut line.condition(facts.features.pages_1g, name: "pages-1g")
    mut line.condition(facts.features.mwait, name: "mwait")
    mut line.condition(facts.features.meltdown_immune, name: "meltdown-immune")
    line.print()
} report_start

/// Prints each event the core rings record on the serial console once its ring is due, `kernel: event <kind> <severity> source <slot> argument <argument>` and what its continuation adds, then how many events found the ring full, and holds the ring's records in `backlog` for `journal`, until cancelled.
fn print_events(rings: rings::Rings, backlog: journal::Backlog, exec: task::Executor, alloc: mem::Alloc) fails task::Cancelled uses wait {
    var records = mem::List[journal::RingRecord].empty(alloc)
    loop {
        let cpu = try await rings.due(exec)
        mut records.truncate(0)
        let lost = rings.drain(cpu, into: mut records)
        var drained = mem::List[journal::CoreRecord].empty(alloc)
        var at: usize = 0
        while at < records.len() {
            let record = records[at]
            at += 1
            var line = Line(text: text::Fixed[240].of("kernel: event "))
            mut line.text.append(journal::kind_name(record.kind).as_str())
            mut line.text.append(" ")
            mut line.text.append(journal::Severity.of_code(record.severity).name().as_str())
            mut line.text.append(" source ")
            mut line.decimal(u64.widen(record.source))
            mut line.text.append(" argument ")
            mut line.decimal(record.argument)
            var more = mem::List[journal::RingRecord].empty(alloc)
            if record.continued() and at < records.len() {
                mut line.text.append(" ")
                mut line.text.append(rings::detail(kind: record.kind, continuation: records[at]).as_str())
                mut more.push(records[at])
                at += 1
            }
            line.print()
            mut drained.push(journal::CoreRecord(record: record, more: take more, source: try await rings.source_of(record.source)))
        }
        if lost > 0 {
            var line = Line(text: text::Fixed[240].of("kernel: event journal.lost warn cpu "))
            mut line.decimal(u64.widen(cpu))
            mut line.text.append(" count ")
            mut line.decimal(lost)
            line.print()
        }
        try await backlog.hold(journal::Drained(cpu: cpu, records: take drained, lost: lost))
    }
} print_events

/// Appends `value` followed by `one` or `many`, as `value` is 1 or not.
fn Line.count(mut self, value: u64, one: Str, many: Str) {
    mut self.decimal(value)
    if value == 1 {
        mut self.text.append(one)
    } else {
        mut self.text.append(many)
    }
} Line.count

fn Line.condition(mut self, holds: bool, name: Str) {
    if holds {
        mut self.text.append(" ")
        mut self.text.append(name)
    }
} Line.condition

fn Line.decimal(mut self, value: u64) {
    rings::push_decimal(mut self.text, value)
} Line.decimal

/// Writes the line and a line feed to the serial console, polling the UART.
fn Line.print(self) {
    var uart = trusted "the descriptor's serial port is the 16550 UART at I/O port 0x3F8, and the core maps it nowhere else" { hw::Ports[Uart].map(port: SERIAL_PORT) }
    write(mut uart, text: self.text.as_str())
    write(mut uart, text: "\n")
    take uart.unmap()
} Line.print

fn write(mut uart: hw::Ports[Uart], text: Str) {
    for byte in text.as_bytes() {
        loop {
            let status = mut uart.read(Uart.line_status)
            if status.holding_empty {
                break
            }
        }
        mut uart.write(Uart.data, value: byte)
    }
} write

test counts_name_their_unit for Line.count {
    var line = Line(text: text::Fixed[240].of(""))
    mut line.count(1, one: " node, ", many: " nodes, ")
    mut line.count(4, one: " cpu", many: " cpus")
    expect line.text.as_str() == "1 node, 4 cpus"
    var zero = Line(text: text::Fixed[240].of(""))
    mut zero.count(0, one: " pool", many: " pools")
    expect zero.text.as_str() == "0 pools"
} counts_name_their_unit
