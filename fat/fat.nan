//! The `fat` component: the boot volume through the `boot-volume` role, its requests served one at a time by a keyed task holding the mounted volume, a file whose extent it gave held in use. Each operation reaches the volume's device, so it declares the class NaN gives a register access.

/// The keys of the keyed tasks: the mount, and the one serving the request under way.
const MOUNTING: u64 = 1

const SERVING: u64 = 2

/// What `fat` serves: `devices::Fat`'s operations, and the messages its keyed tasks post.
pub protocol FatFiles {
    pub fn list(path: text::String) -> mem::List[devices::FatEntry] fails devices::FatError limits irreversible(emit, actuate, erase, spend)
    pub fn read(path: text::String, offset: u64, count: u32) -> Untrusted[mem::Bytes] fails devices::FatError limits irreversible(emit, actuate, erase, spend)
    pub fn write(path: text::String, data: mem::Bytes) fails devices::FatError limits irreversible(emit, actuate, erase, spend)
    pub fn overwrite(path: text::String, offset: u64, data: mem::Bytes) fails devices::FatError limits irreversible(emit, actuate, erase, spend)
    pub fn remove(path: text::String) fails devices::FatError limits irreversible(emit, actuate, erase, spend)
    pub fn allocate(path: text::String, bytes: u64) fails devices::FatError limits irreversible(emit, actuate, erase, spend)
    pub fn extent(path: text::String) -> devices::Extent fails devices::FatError limits irreversible(emit, actuate, erase, spend)
    pub fn free() -> u64 fails devices::FatError limits irreversible(emit, actuate, erase, spend)
    fn mounted(volume: Option[Volume]) limits irreversible(emit, actuate, erase, spend)
    fn served(request: u64, reply: mem::Bytes, volume: Volume, held: Option[text::String]) limits irreversible(emit, actuate, erase, spend)
} FatFiles

/// The bytes the calls to the volume draw at most at once.
const CALL_BYTES: usize = 1_048_576

/// The Env of `fat`: the port of the `boot-volume` role, its cell, and the cell its calls to the volume draw through, whose chunks never hold the cache's blocks.
pub closed linear struct Env {
    pub volume: os::Port[devices::Block]
    pub alloc: mem::Alloc
    pub calls: mem::Budget
} Env

impl Env: nanos::Environment

/// A request waiting for the volume.
pub closed enum Job derives Encode {
    List(path: text::String)
    Read(path: text::String, offset: u64, count: u32)
    Write(path: text::String, data: mem::Bytes)
    Overwrite(path: text::String, offset: u64, data: mem::Bytes)
    Remove(path: text::String)
    Allocate(path: text::String, bytes: u64)
    Extent(path: text::String)
    Free
} Job

pub closed struct Queued derives Encode {
    pub request: u64
    pub job: Job
} Queued

/// The state of `fat`: the mounted volume while no request holds it, the requests waiting, whether one is under way, whether the volume failed validation, and the paths of the files held in use.
pub closed struct Files derives Encode {
    pub volume: Option[Volume]
    pub queued: mem::List[Queued]
    pub serving: bool
    pub bad: bool
    pub in_use: mem::List[text::String]
} Files

impl Files: sys::Component[Env, FatFiles]

impl Files: sys::Resume[Env, FatFiles]

/// The storage behind the `boot-volume` role's port, its unit 0.
pub closed struct Wired derives Copy {
    pub disk: os::Port[devices::Block]
    pub calls: mem::Alloc
} Wired

impl Wired: Storage

pub fn Env.build(take world: nanos::World) -> Env fails nanos::CapError {
    let handle = try nanos::Cap[os::PortHandle].get(world.caps, key: "volume")
    let Some(port) = os::Port[devices::Block].of(handle) else {
        fail nanos::CapError.Missing
    }
    return Env(volume: port, alloc: world.alloc, calls: world.alloc.split(CALL_BYTES))
} Env.build

pub fn Env.abandon(take self) {
    let Env(volume: _, alloc: _, calls: calls) = self
    take calls.close()
} Env.abandon

pub fn Wired.geometry(self, alloc: mem::Alloc) -> devices::BlockInfo fails Failure uses wait {
    var call = sys::Encoded.empty(self.calls)
    let reply = sys::Wire[devices::Block].info(mut call, unit: 0)
    return match first attempt await self.disk.call(take call, reply, alloc: self.calls) {
        Ok(info) => info
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        Err(_) => fail devices::FatError.Io
    }
} Wired.geometry

pub fn Wired.read(self, block: u64, count: u32, alloc: mem::Alloc) -> Untrusted[mem::Bytes] fails Failure uses wait {
    var call = sys::Encoded.empty(self.calls)
    let reply = sys::Wire[devices::Block].read(mut call, unit: 0, block, count)
    return match first attempt await self.disk.call(take call, reply, alloc: self.calls) {
        Ok(bytes) => bytes
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        Err(_) => fail devices::FatError.Io
    }
} Wired.read

pub fn Wired.write(self, block: u64, take data: mem::Bytes, alloc: mem::Alloc) fails Failure uses wait {
    var call = sys::Encoded.empty(self.calls)
    let reply = sys::Wire[devices::Block].write(mut call, unit: 0, block, take data, fua: false)
    match first attempt await self.disk.call(take call, reply, alloc: self.calls) {
        Ok(_) => {
        }
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        Err(_) => fail devices::FatError.Io
    }
} Wired.write

pub fn Wired.flush(self, alloc: mem::Alloc) fails Failure uses wait {
    var call = sys::Encoded.empty(self.calls)
    let reply = sys::Wire[devices::Block].flush(mut call, unit: 0)
    match first attempt await self.disk.call(take call, reply, alloc: self.calls) {
        Ok(_) => {
        }
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        Err(_) => fail devices::FatError.Io
    }
} Wired.flush

pub fn Files.start(mut env: Env) -> Files = Files(volume: None, queued: mem::List.empty(env.alloc), serving: true, bad: false, in_use: mem::List.empty(env.alloc))

/// Once started, mounts the volume: validates its geometry and frees the clusters no entry reaches.
pub fn Files.resume(mut self, reason: sys::ResumeReason, mut env: Env, mut cx: sys::Cx[FatFiles]) {
    let disk = Wired(disk: env.volume, calls: env.calls.alloc())
    let alloc = env.alloc
    mut cx.spawn(key: MOUNTING, run: fn(out: sys::Outbox[FatFiles]) fails task::Cancelled uses wait limits stack 32_768 {
        let mounted = match first attempt await mount(disk, alloc) {
            Ok(volume) => Some(take volume)
            Err(Failure.Cancelled(cancelled)) => fail cancelled
            Err(_) => None
        }
        discard attempt await out.mounted(volume: take mounted)
    })
} Files.resume

fn Files.mounted(mut self, take volume: Option[Volume], mut env: Env, mut cx: sys::Cx[FatFiles]) {
    self.serving = false
    self.bad = volume.is_none()
    self.volume = volume
    mut self.next_job(mut env, mut cx)
} Files.mounted

pub fn Files.list(mut self, take path: text::String, mut env: Env, mut cx: sys::Cx[FatFiles]) -> mem::List[devices::FatEntry] fails devices::FatError {
    try mut self.queue(Job.List(path: take path), mut env, mut cx)
    return mem::List.empty(env.alloc)
} Files.list

pub fn Files.read(
    mut self,
    take path: text::String,
    take offset: u64,
    take count: u32,
    mut env: Env,
    mut cx: sys::Cx[FatFiles],
    ) -> Untrusted[mem::Bytes] fails devices::FatError {
    try mut self.queue(Job.Read(path: take path, offset: offset, count: count), mut env, mut cx)
    return Untrusted.of(mem::Bytes.empty(env.alloc))
} Files.read

pub fn Files.write(
    mut self,
    take path: text::String,
    take data: mem::Bytes,
    mut env: Env,
    mut cx: sys::Cx[FatFiles],
    ) fails devices::FatError {
    try self.free_to_change(path)
    try mut self.queue(Job.Write(path: take path, data: take data), mut env, mut cx)
} Files.write

pub fn Files.overwrite(
    mut self,
    take path: text::String,
    take offset: u64,
    take data: mem::Bytes,
    mut env: Env,
    mut cx: sys::Cx[FatFiles],
    ) fails devices::FatError {
    try self.free_to_change(path)
    try mut self.queue(Job.Overwrite(path: take path, offset: offset, data: take data), mut env, mut cx)
} Files.overwrite

pub fn Files.remove(mut self, take path: text::String, mut env: Env, mut cx: sys::Cx[FatFiles]) fails devices::FatError {
    try self.free_to_change(path)
    try mut self.queue(Job.Remove(path: take path), mut env, mut cx)
} Files.remove

pub fn Files.allocate(
    mut self,
    take path: text::String,
    take bytes: u64,
    mut env: Env,
    mut cx: sys::Cx[FatFiles],
    ) fails devices::FatError {
    try mut self.queue(Job.Allocate(path: take path, bytes: bytes), mut env, mut cx)
} Files.allocate

pub fn Files.extent(mut self, take path: text::String, mut env: Env, mut cx: sys::Cx[FatFiles]) -> devices::Extent fails devices::FatError {
    try mut self.queue(Job.Extent(path: take path), mut env, mut cx)
    return devices::Extent(start: 0, blocks: 0)
} Files.extent

pub fn Files.free(mut self, mut env: Env, mut cx: sys::Cx[FatFiles]) -> u64 fails devices::FatError {
    try mut self.queue(Job.Free, mut env, mut cx)
    return 0
} Files.free

/// Refuses a change to a file held in use.
fn Files.free_to_change(self, path: text::String) fails devices::FatError {
    if self.holds(path) {
        fail devices::FatError.InUse
    }
} Files.free_to_change

/// Whether the file at `path` is held in use, its path compared without regard to case.
fn Files.holds(self, path: text::String) -> bool {
    for held in self.in_use {
        if same_name(held.as_str(), b: path.as_str()) {
            return true
        }
    }
    return false
} Files.holds

/// Answers the request served, takes the volume back and serves the next.
fn Files.served(
    mut self,
    take request: u64,
    take reply: mem::Bytes,
    take volume: Volume,
    take held: Option[text::String],
    mut env: Env,
    mut cx: sys::Cx[FatFiles],
    ) {
    discard attempt mut cx.reply(request, reply: sys::Encoded(bytes: take reply, handles: mem::List.empty(env.alloc)))
    match held {
        Some(path) => {
            if not self.holds(path) {
                mut self.in_use.push(take path)
            }
        }
        None => {
        }
    }
    self.volume = Some(take volume)
    self.serving = false
    mut self.next_job(mut env, mut cx)
} Files.served

/// Postpones a request until a keyed task has served it; fails at once on a volume that failed validation.
fn Files.queue(mut self, take job: Job, mut env: Env, mut cx: sys::Cx[FatFiles]) fails devices::FatError {
    if self.bad {
        fail devices::FatError.BadVolume
    }
    let Some(request) = mut cx.postpone() else {
        fail devices::FatError.Io
    }
    mut self.queued.push(Queued(request: request, job: take job))
    mut self.next_job(mut env, mut cx)
} Files.queue

/// Hands the volume and the first waiting request to a keyed task while none is under way.
fn Files.next_job(mut self, mut env: Env, mut cx: sys::Cx[FatFiles]) {
    if self.serving or self.queued.len() == 0 {
        return
    }
    let Some(volume) = mut self.volume.extract() else {
        return
    }
    let Queued(request: request, job: job) = mut self.queued.remove(0)
    self.serving = true
    let disk = Wired(disk: env.volume, calls: env.calls.alloc())
    let alloc = env.alloc
    mut cx.spawn(key: SERVING, run: fn[take volume, take job](out: sys::Outbox[FatFiles]) fails task::Cancelled uses wait limits stack 32_768 {
        var held = volume
        let Served(reply: reply, held: path) = try await serve(mut held, disk, take job, alloc)
        discard attempt await out.served(request, take reply, volume: take held, held: take path)
    })
} Files.next_job

/// Mounts the volume behind `disk`'s unit 0 and frees its lost clusters.
pub fn mount[D: Storage](disk: D, alloc: mem::Alloc) -> Volume fails Failure uses wait {
    let info = try await disk.geometry(alloc)
    var volume = try await Volume.mount(disk, block_bytes: info.block_bytes, blocks: info.blocks, alloc)
    try await mut volume.free_lost(disk, alloc)
    return volume
} mount

/// A request served: the encoding of its reply, and the path of the file it holds in use from then on.
pub closed struct Served {
    pub reply: mem::Bytes
    pub held: Option[text::String]
} Served

/// Serves one request on the volume: an extent given holds its file in use.
pub fn serve[D: Storage](mut volume: Volume, disk: D, take job: Job, alloc: mem::Alloc) -> Served fails task::Cancelled uses wait {
    var bytes = mem::Bytes.empty(alloc)
    var held: Option[text::String] = None
    match job {
        Job.List(path: path) => {
            let outcome = attempt await mut volume.list(disk, path: path.as_str(), alloc)
            mem::wire::Codec[Result[mem::List[devices::FatEntry], devices::FatError]].encode(try settled(take outcome), out: mut bytes)
        }
        Job.Read(path: path, offset: offset, count: count) => {
            let outcome = attempt await mut volume.read_file(disk, path: path.as_str(), offset, count, alloc)
            mem::wire::Codec[Result[Untrusted[mem::Bytes], devices::FatError]].encode(try settled(take outcome), out: mut bytes)
        }
        Job.Write(path: path, data: data) => {
            let outcome = attempt await mut volume.write_file(disk, path: path.as_str(), data: data.view(), alloc)
            mem::wire::Codec[Result[Unit, devices::FatError]].encode(try settled(take outcome), out: mut bytes)
        }
        Job.Overwrite(path: path, offset: offset, data: data) => {
            let outcome = attempt await mut volume.overwrite_file(disk, path: path.as_str(), offset, data: data.view(), alloc)
            mem::wire::Codec[Result[Unit, devices::FatError]].encode(try settled(take outcome), out: mut bytes)
        }
        Job.Remove(path: path) => {
            let outcome = attempt await mut volume.remove_file(disk, path: path.as_str(), alloc)
            mem::wire::Codec[Result[Unit, devices::FatError]].encode(try settled(take outcome), out: mut bytes)
        }
        Job.Allocate(path: path, bytes: size) => {
            let outcome = attempt await mut volume.allocate_file(disk, path: path.as_str(), bytes: size, alloc)
            mem::wire::Codec[Result[Unit, devices::FatError]].encode(try settled(take outcome), out: mut bytes)
        }
        Job.Extent(path: path) => {
            let outcome = try settled(attempt await mut volume.extent_of(disk, path: path.as_str(), alloc))
            if outcome.is_ok() {
                held = Some(text::String.of(path.as_str(), alloc))
            }
            mem::wire::Codec[Result[devices::Extent, devices::FatError]].encode(outcome, out: mut bytes)
        }
        Job.Free => {
            let outcome = attempt await volume.free_bytes(disk, alloc)
            mem::wire::Codec[Result[u64, devices::FatError]].encode(try settled(take outcome), out: mut bytes)
        }
    }
    return Served(reply: take bytes, held: take held)
} serve

/// A step's outcome as a reply: its result, or the operation's failure; a cancellation stays one.
fn settled[T](take outcome: Result[T, Failure]) -> Result[T, devices::FatError] fails task::Cancelled {
    return match outcome {
        Ok(value) => Ok(take value)
        Err(Failure.Fat(error)) => Err(error)
        Err(Failure.Cancelled(cancelled)) => fail cancelled
    }
} settled
