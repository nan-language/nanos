//! The supervisor: the base instance that starts the base instances in their order, then reconciles the instances that run with `/sys/instances` and `/sys/config` and the bundles the core holds for their contributions with `/sys/code`, has `admission` judge the admitted bundles again when `/sys/policy` or `/sys/principals` change, and stops and restarts instances.

/// The key of the keyed task that starts the base instances, then subscribes to the desired state.
const STARTING: u64 = 1

/// The key of the keyed task reconciling the instances with the desired state.
const RECONCILING: u64 = 2

/// The key of the keyed task holding the bundles contributing to the core's registries.
const HOLDING_PASS: u64 = 3

/// The key of the keyed task asking `admission` to judge the admitted bundles again.
const READMITTING: u64 = 4

/// A subscription's first commit when it tells of the commits from now on only.
const FROM_NOW: ident::CommitId = ident::CommitId(number: 0xFFFF_FFFF_FFFF_FFFF)

/// The key of the keyed task answering a request, plus its number.
const ANSWERING: u64 = 0x1_0000_0000

/// The base instances `supervisor` starts after itself, one step per line, those of a step in parallel: chapter 20's start order, the lazy ones last. A moniker a step names again is restarted, and one without a specification is passed over.
const START_ORDER: Str = "devices\nfat\nkeys\nstore\nkeys journal\npolicy\nboot\nnet link console\nadmission clock power infer\n"

/// The specifications one listing gives at once.
const PAGE: u32 = 256

/// The credit of the port the store tells the supervisor's subscriptions through.
const WATCH_CREDIT: u16 = 64

/// The bit setting the keys of the keyed tasks following probations apart from those acting on instances.
const PROBATING: u64 = 0x4000_0000_0000_0000

pub protocol Supervisor {
    /// Stops the instance `moniker`, setting `stopped` in its specification when the store holds it.
    pub fn stop(moniker: ident::Moniker) limits restorable
    /// Restarts the instance `moniker`.
    pub fn restart(moniker: ident::Moniker) limits restorable
    /// Hibernates the running checkpointed instance `moniker`: its state becomes a hibernation image and its memory is freed until a message, a due `after` message or `wake` revives it.
    pub fn hibernate(moniker: ident::Moniker) fails SupervisorFailure limits restorable
    /// Revives the hibernated instance `moniker`.
    pub fn wake(moniker: ident::Moniker) limits restorable
    /// A commit changed the desired state below a subscription's prefix.
    pub fn changed(subscription: u64, commit: ident::CommitId, paths: mem::List[ident::Path], more: u64) limits traceless
    pub fn appended(subscription: u64, path: ident::Path, seq: u64) limits traceless
    /// The store could not tell of `commits` commits.
    pub fn lost(subscription: u64, commits: u64) limits traceless
    fn reconciled(listed: mem::List[ident::Moniker], updates: mem::List[Update]) limits traceless
    fn held(holding: Holding) limits traceless
    /// The request `request` ended with `reply`.
    fn answered(request: u64, reply: sys::Encoded) limits traceless
} Supervisor

/// The configuration record of `supervisor`, `/sys/config/supervisor`: whether every instance but the base ones is frozen, and the bounds of the probation of an update.
pub closed struct SupervisorConfig derives Render, Encode {
    pub frozen: bool
    pub probation: os::Probation
} SupervisorConfig

/// The configuration chapter 20 gives `supervisor` by default.
pub fn SupervisorConfig.defaults() -> SupervisorConfig = SupervisorConfig(frozen: false, probation: os::Probation.defaults())

/// An update a reconciling pass started: the instance, the bundle it ran, the bundle its specification names, and the commit that wrote that specification.
pub closed struct Update derives Render, Encode {
    pub moniker: ident::Moniker
    pub old: ident::HashValue
    pub new: ident::HashValue
    pub commit: u64
} Update

/// Why an operation on an instance failed: it keeps no checkpoints, or it does not run.
pub closed enum SupervisorFailure derives Eq, Render, Encode {
    Volatile
    NotRunning
} SupervisorFailure

/// What the runner does to an instance for the supervisor.
enum Carried derives Copy, Eq {
    Stop
    Restart
    Wake
} Carried

pub closed struct Env {
    pub control: os::Control
    pub devices: Option[os::Port[devices::Devices]]
    pub tree: Option[store::service::View]
    pub admission: Option[os::Port[admission::Admitting]]
    pub registries: devices::Registries
    pub exec: task::Executor
    pub alloc: mem::Alloc
} Env

/// The supervisor's state: the monikers whose specifications it last found in `/sys/instances`, which a later pass deletes when their specifications are gone, whether a pass is under way and another is due after it, the bundles the core holds for their contributions, and how far a holding pass is.
pub closed struct Supervision derives Render, Encode {
    pub listed: mem::List[ident::Moniker]
    pub reconciling: bool
    pub due: bool
    pub holding: Holding
    pub pass: Pass
} Supervision

/// Whether a holding pass is under way, and whether another is due after it, bringing the drivers it starts to a commit when it names one.
pub closed enum Pass derives Copy, Eq, Render, Encode {
    Idle
    Running
    Due(reached: Option[u64])
} Pass

impl Supervision: sys::Component[Env, Supervisor]

impl Supervision: sys::Resume[Env, Supervisor]

pub fn Env.build(take world: nanos::World, registries: devices::Registries) -> Env fails nanos::CapError {
    let devices = match attempt nanos::Cap[os::PortHandle].get(world.caps, key: "devices") {
        Ok(handle) => os::Port[devices::Devices].of(handle)
        Err(_) => None
    }
    let tree = match attempt nanos::Cap[store::service::View].get(world.caps, key: "tree") {
        Ok(view) => Some(view)
        Err(_) => None
    }
    let admitting = match attempt nanos::Cap[os::PortHandle].get(world.caps, key: "admission") {
        Ok(handle) => os::Port[admission::Admitting].of(handle)
        Err(_) => None
    }
    return Env(control: try nanos::Cap[os::Control].get(world.caps, key: "control"), devices: devices, tree: tree, admission: admitting, registries: registries, exec: world.exec, alloc: world.alloc)
} Env.build

pub fn Supervision.start(mut env: Env) -> Supervision = Supervision(listed: mem::List.empty(env.alloc), reconciling: false, due: false, holding: Holding.none(env.alloc), pass: Pass.Idle)

/// Once started, starts the base instances in their order, then subscribes to the desired state, whose commits since genesis each start a reconciling pass.
pub fn Supervision.resume(mut self, reason: sys::ResumeReason, mut env: Env, mut cx: sys::Cx[Supervisor]) {
    if reason != sys::ResumeReason.Started {
        return
    }
    let control = env.control
    let manager = env.devices
    let tree = env.tree
    let exec = env.exec
    let alloc = env.alloc
    mut cx.spawn(key: STARTING, run: fn(out: sys::Outbox[Supervisor]) fails task::Cancelled uses wait limits stack 32_768 {
        try await start_in_order(control, devices: manager, exec, alloc)
        let Some(view) = tree else {
            return
        }
        try await subscribe(control, view, alloc)
    })
} Supervision.resume

pub fn Supervision.stop(mut self, take moniker: ident::Moniker, mut env: Env, mut cx: sys::Cx[Supervisor]) {
    let Some(view) = env.tree else {
        carry_out(mut cx, control: env.control, take moniker, order: Carried.Stop, reached: None, alloc: env.alloc)
        return
    }
    let alloc = env.alloc
    mut cx.spawn(key: keyed(moniker), run: fn[take moniker](out: sys::Outbox[Supervisor]) fails task::Cancelled uses wait limits stack 32_768 {
        try await mark_stopped(view, take moniker, alloc)
    })
} Supervision.stop

pub fn Supervision.restart(mut self, take moniker: ident::Moniker, mut env: Env, mut cx: sys::Cx[Supervisor]) {
    carry_out(mut cx, control: env.control, take moniker, order: Carried.Restart, reached: None, alloc: env.alloc)
} Supervision.restart

/// Has the runner hibernate the instance `moniker` from a keyed task, which answers the request once it hibernated or still runs; the failure returned is the one a postponed request drops.
pub fn Supervision.hibernate(mut self, take moniker: ident::Moniker, mut env: Env, mut cx: sys::Cx[Supervisor]) fails SupervisorFailure {
    let control = env.control
    let alloc = env.alloc
    let Some(request) = mut cx.postpone() else {
        fail SupervisorFailure.NotRunning
    }
    mut cx.spawn(key: ANSWERING + request, run: fn[take moniker](out: sys::Outbox[Supervisor]) fails task::Cancelled uses wait limits stack 16_384 {
        let outcome: Result[Unit, SupervisorFailure] = match first attempt await control.hibernate(take moniker, alloc) {
            Ok(_) => Ok(Unit)
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            Err(os::ControlError.Volatile) => Err(SupervisorFailure.Volatile)
            Err(_) => Err(SupervisorFailure.NotRunning)
        }
        var reply = sys::Encoded.empty(alloc)
        mem::wire::Codec[Result[Unit, SupervisorFailure]].encode(outcome, out: mut reply.bytes)
        discard attempt await out.answered(request, take reply)
    })
    fail SupervisorFailure.NotRunning
} Supervision.hibernate

pub fn Supervision.wake(mut self, take moniker: ident::Moniker, mut env: Env, mut cx: sys::Cx[Supervisor]) {
    carry_out(mut cx, control: env.control, take moniker, order: Carried.Wake, reached: None, alloc: env.alloc)
} Supervision.wake

fn Supervision.answered(
    mut self,
    take request: u64,
    take reply: sys::Encoded,
    mut env: Env,
    mut cx: sys::Cx[Supervisor],
    ) {
    discard attempt mut cx.reply(request, reply)
    mut cx.cancel(key: ANSWERING + request)
} Supervision.answered

/// Reconciles with a commit's desired state: a pass over every specification and a restart of each instance whose configuration record it changed, when it changed either, a holding pass when it changed `/sys/code`, and a judgement of the admitted bundles when it changed `/sys/policy` or `/sys/principals`.
pub fn Supervision.changed(
    mut self,
    take subscription: u64,
    take commit: ident::CommitId,
    take paths: mem::List[ident::Path],
    take more: u64,
    mut env: Env,
    mut cx: sys::Cx[Supervisor],
    ) {
    var admitted = more > 0
    var specified = more > 0
    var policed = false
    var rekeyed = false
    for path in paths {
        if path.text.as_str().starts_with("/sys/code") {
            admitted = true
            continue
        }
        if path.text.as_str().starts_with("/sys/policy") {
            policed = true
            continue
        }
        if path.text.as_str().starts_with("/sys/principals") {
            rekeyed = true
            continue
        }
        specified = true
        let Some(moniker) = configured(path, alloc: env.alloc) else {
            continue
        }
        carry_out(mut cx, control: env.control, take moniker, order: Carried.Restart, reached: Some(commit.number), alloc: env.alloc)
    }
    if admitted {
        mut self.hold(reached: Some(commit.number), mut env, mut cx)
    }
    if specified {
        mut self.reconcile(mut env, mut cx)
    }
    if policed or rekeyed {
        let changed = match policed {
            true => Some(commit.number)
            false => None
        }
        readmit(mut cx, admitting: env.admission, changed, alloc: env.alloc)
    }
} Supervision.changed

/// Has `admission` judge the admitted bundles again, from a keyed task, with the policy as the commit `changed` left it when it names one.
fn readmit(mut cx: sys::Cx[Supervisor], admitting: Option[os::Port[admission::Admitting]], changed: Option[u64], alloc: mem::Alloc) {
    let Some(port) = admitting else {
        return
    }
    mut cx.spawn(key: READMITTING, run: fn(out: sys::Outbox[Supervisor]) fails task::Cancelled uses wait limits stack 8_192 {
        var call = sys::Encoded.empty(alloc)
        sys::Wire[admission::Admitting].recompute(mut call, changed)
        match attempt await port.post(take call) {
            Err(os::PortError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
    })
} readmit

pub fn Supervision.appended(
    mut self,
    take subscription: u64,
    take path: ident::Path,
    take seq: u64,
    mut env: Env,
    mut cx: sys::Cx[Supervisor],
    ) {
} Supervision.appended

/// Reconciles every specification and the bundles held for their contributions after the store could not tell of some commits.
pub fn Supervision.lost(
    mut self,
    take subscription: u64,
    take commits: u64,
    mut env: Env,
    mut cx: sys::Cx[Supervisor],
    ) {
    mut self.hold(reached: None, mut env, mut cx)
    mut self.reconcile(mut env, mut cx)
} Supervision.lost

/// Starts a holding pass from a keyed task, the drivers it starts reaching the commit `reached` when it names one, or marks one due when a pass is under way.
fn Supervision.hold(mut self, reached: Option[u64], mut env: Env, mut cx: sys::Cx[Supervisor]) {
    let Some(view) = env.tree else {
        return
    }
    match self.pass {
        Pass.Idle => {
        }
        Pass.Running => {
            self.pass = Pass.Due(reached: reached)
            return
        }
        Pass.Due(reached: earlier) => {
            self.pass = Pass.Due(reached: later(earlier, reached))
            return
        }
    }
    self.pass = Pass.Running
    let holder = Holder(view: view, registries: env.registries, devices: env.devices)
    let before = self.holding.copied(env.alloc)
    let alloc = env.alloc
    mut cx.spawn(key: HOLDING_PASS, run: fn[take before](out: sys::Outbox[Supervisor]) fails task::Cancelled uses wait limits stack 32_768 {
        let holding = try await holder.pass(take before, reached, alloc)
        discard attempt await out.held(take holding)
    })
} Supervision.hold

/// Keeps what a holding pass held, and starts the pass due after it.
fn Supervision.held(mut self, take holding: Holding, mut env: Env, mut cx: sys::Cx[Supervisor]) {
    self.holding = holding
    let Pass.Due(reached: reached) = self.pass else {
        self.pass = Pass.Idle
        return
    }
    self.pass = Pass.Idle
    mut self.hold(reached, mut env, mut cx)
} Supervision.held

/// The later of the commits `earlier` and `reached`.
fn later(earlier: Option[u64], reached: Option[u64]) -> Option[u64] {
    return match earlier {
        Some(was) => match reached {
            Some(now) => Some(was.max(now))
            None => earlier
        }
        None => reached
    }
} later

/// Keeps the monikers a pass found, follows the probation of each update it started on a keyed task with the other updates of its commit, and starts the pass due after it.
fn Supervision.reconciled(
    mut self,
    take listed: mem::List[ident::Moniker],
    take updates: mem::List[Update],
    mut env: Env,
    mut cx: sys::Cx[Supervisor],
    ) {
    self.listed = listed
    match env.tree {
        Some(view) => {
            for at in 0..<updates.len() {
                var siblings = mem::List[Update].empty(env.alloc)
                for other in 0..<updates.len() {
                    if other != at and updates[other].commit == updates[at].commit {
                        mut siblings.push(Update(moniker: ident::Moniker(text: updates[other].moniker.text), old: updates[other].old, new: updates[other].new, commit: updates[other].commit))
                    }
                }
                let update = Update(moniker: ident::Moniker(text: updates[at].moniker.text), old: updates[at].old, new: updates[at].new, commit: updates[at].commit)
                let control = env.control
                let alloc = env.alloc
                mut cx.spawn(key: keyed(update.moniker) ^ PROBATING, run: fn[take update, take siblings](out: sys::Outbox[Supervisor]) fails task::Cancelled uses wait limits stack 32_768 {
                    try await follow_probation(control, view, take update, take siblings, alloc)
                })
            }
        }
        None => {
        }
    }
    self.reconciling = false
    if self.due {
        self.due = false
        mut self.reconcile(mut env, mut cx)
    }
} Supervision.reconciled

/// Starts a pass bringing the instances to `/sys/instances` from a keyed task, or marks one due when a pass is under way.
fn Supervision.reconcile(mut self, mut env: Env, mut cx: sys::Cx[Supervisor]) {
    let Some(view) = env.tree else {
        return
    }
    if self.reconciling {
        self.due = true
        return
    }
    self.reconciling = true
    var before = mem::List[ident::Moniker].empty(env.alloc)
    for moniker in self.listed {
        mut before.push(ident::Moniker(text: moniker.text))
    }
    let control = env.control
    let alloc = env.alloc
    mut cx.spawn(key: RECONCILING, run: fn[take before](out: sys::Outbox[Supervisor]) fails task::Cancelled uses wait limits stack 32_768 {
        let Reconciled(listed: listed, updates: updates) = try await reconcile(control, view, take before, alloc)
        discard attempt await out.reconciled(listed: take listed, take updates)
    })
} Supervision.reconcile

/// The key of the keyed task acting on the instance `moniker`, which a later order for the same instance does not cancel.
fn keyed(moniker: ident::Moniker) -> u64 {
    var key = STARTING
    for byte in moniker.text.as_bytes() {
        key = key.wrapping_mul(31).wrapping_add(u64.widen(byte))
    }
    return key | 0x8000_0000_0000_0000
} keyed

/// Has the runner carry out `order` on the instance `moniker` from a keyed task of its own, which a later order for the same instance does not cancel, then tells it the commit of the desired value it brought the instance to, when `reached` names one.
fn carry_out(
    mut cx: sys::Cx[Supervisor],
    control: os::Control,
    take moniker: ident::Moniker,
    order: Carried,
    reached: Option[u64],
    alloc: mem::Alloc,
    ) {
    mut cx.spawn(key: keyed(moniker), run: fn[take moniker](out: sys::Outbox[Supervisor]) fails task::Cancelled uses wait limits stack 16_384 {
        let ordered = match order {
            Carried.Stop => attempt await control.stop(ident::Moniker(text: moniker.text), alloc)
            Carried.Restart => attempt await control.restart(ident::Moniker(text: moniker.text), alloc)
            Carried.Wake => attempt await control.wake(ident::Moniker(text: moniker.text), alloc)
        }
        try settled(take ordered)
        let Some(commit) = reached else {
            return
        }
        try settled(attempt await control.converge(take moniker, desired: commit, alloc))
    })
} carry_out

/// Subscribes the supervisor's own port to the commits changing `/instances`, `/config` and `/code` of its View since genesis, and `/policy` and `/principals` from now.
fn subscribe(control: os::Control, view: store::service::View, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let port = match first attempt await control.port(ident::Moniker(text: text::Fixed[59].of("supervisor")), credit: os::Credit(messages: WATCH_CREDIT, calls: 1), alloc) {
        Ok(handle) => handle
        Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return
    }
    try await watch(view, prefix: desired("/instances", alloc), since: ident::CommitId(number: 0), port, alloc)
    try await watch(view, prefix: desired("/config", alloc), since: ident::CommitId(number: 0), port, alloc)
    try await watch(view, prefix: desired("/code", alloc), since: ident::CommitId(number: 0), port, alloc)
    try await watch(view, prefix: desired("/policy", alloc), since: FROM_NOW, port, alloc)
    try await watch(view, prefix: desired("/principals", alloc), since: FROM_NOW, port, alloc)
} subscribe

/// Has the store tell `port` of the commits after `since` that change nodes below `prefix`.
fn watch(view: store::service::View, take prefix: ident::Path, since: ident::CommitId, port: os::PortHandle, alloc: mem::Alloc) fails task::Cancelled uses wait {
    match attempt await view.subscribe(take prefix, since, port, alloc) {
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} watch

fn desired(text: Str, alloc: mem::Alloc) -> ident::Path {
    return ident::Path(text: text::String.of(text, alloc))
} desired

/// The instance whose configuration record `path` names below `/sys/config`.
fn configured(path: ident::Path, alloc: mem::Alloc) -> Option[ident::Moniker] {
    let segments = path.segments(alloc)
    if segments.len() != 3 or segments[0].view() != b"sys" or segments[1].view() != b"config" {
        return None
    }
    var name = text::Fixed[59].empty()
    for byte in segments[2] {
        let Some(c) = char.checked_from_bits(u32.widen(byte)) else {
            return None
        }
        mut name.push(c)
    }
    if not ident::is_moniker(name) {
        return None
    }
    return Some(ident::Moniker(text: name))
} configured

/// What a reconciling pass found: the monikers of the specifications, and the updates it started.
struct Reconciled {
    listed: mem::List[ident::Moniker]
    updates: mem::List[Update]
} Reconciled

/// Brings the instances to the specifications of `/instances`: each stopped as its specification asks or started, created first when the runner has none, and each instance of `before` whose specification is gone deleted; gives the monikers it found and the updates it started.
fn reconcile(control: os::Control, view: store::service::View, take before: mem::List[ident::Moniker], alloc: mem::Alloc) -> Reconciled fails task::Cancelled uses wait {
    var listed = mem::List[ident::Moniker].empty(alloc)
    var updates = mem::List[Update].empty(alloc)
    var after: Option[text::String] = None
    loop {
        let listing = match first attempt await view.list(desired("/instances", alloc), take after, limit: PAGE, alloc) {
            Ok(found) => found
            Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
            Err(_) => return Reconciled(listed: take before, updates: take updates)
        }
        for entry in listing.entries {
            var name = text::Fixed[59].empty()
            mut name.append(entry.name.as_str())
            if not ident::is_moniker(name) {
                continue
            }
            match try await converge(control, view, moniker: ident::Moniker(text: name), alloc) {
                Some(update) => mut updates.push(take update)
                None => {
                }
            }
            mut listed.push(ident::Moniker(text: name))
        }
        let Some(next) = listing.next else {
            break
        }
        after = Some(take next)
    }
    for gone in take before {
        if not holds(listed, moniker: gone) {
            match attempt await control.delete(take gone, alloc) {
                Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
                else => {
                }
            }
        }
    }
    return Reconciled(listed: take listed, updates: take updates)
} reconcile

/// The specification of the instance `moniker` the View's `/instances` holds, with the commit that last wrote it; `None` when it holds none that decodes.
fn spec_of(view: store::service::View, moniker: ident::Moniker, alloc: mem::Alloc) -> Option[Specified] fails task::Cancelled uses wait {
    let Some(path) = desired("/instances", alloc).child(moniker.text.as_bytes(), alloc) else {
        return None
    }
    let node = match first attempt await view.get(take path, at: None, alloc) {
        Ok(found) => found
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return None
    }
    let Some(value) = node.value else {
        return None
    }
    let Ok(spec) = attempt mem::wire::Codec[os::InstanceSpec].decode(value.view(), alloc) else {
        return None
    }
    return Some(Specified(spec: take spec, version: node.version.number))
} spec_of

/// A specification, and the commit that last wrote it.
struct Specified {
    spec: os::InstanceSpec
    version: u64
} Specified

/// Brings the instance `moniker` to its specification: has the runner take it, creating the instance when it has none, then stops it when the specification asks, else starts it; then tells the runner the commit of that specification. Gives the update it started when the specification names another bundle than the instance runs.
fn converge(control: os::Control, view: store::service::View, moniker: ident::Moniker, alloc: mem::Alloc) -> Option[Update] fails task::Cancelled uses wait {
    let Some(Specified(spec: spec, version: version)) = try await spec_of(view, moniker, alloc) else {
        return None
    }
    let stopped = spec.stopped
    var update: Option[Update] = None
    match first attempt await control.describe(ident::Moniker(text: moniker.text), alloc) {
        Ok(described) => {
            if described.bundle != spec.bundle and not stopped {
                update = Some(Update(moniker: ident::Moniker(text: moniker.text), old: described.bundle, new: spec.bundle, commit: version))
            }
        }
        Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
        Err(_) => {
        }
    }
    match attempt await control.specify(ident::Moniker(text: moniker.text), take spec, alloc) {
        Err(os::ControlError.Missing) => {
            let Some(Specified(spec: created, version: _)) = try await spec_of(view, moniker, alloc) else {
                return None
            }
            try settled(attempt await control.create(ident::Moniker(text: moniker.text), spec: take created, grants: mem::Map.empty(alloc), alloc))
        }
        Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
    if stopped {
        try settled(attempt await control.stop(ident::Moniker(text: moniker.text), alloc))
    } else {
        try settled(attempt await control.start(ident::Moniker(text: moniker.text), alloc))
    }
    try settled(attempt await control.converge(ident::Moniker(text: moniker.text), desired: version, alloc))
    return update
} converge

/// Waits for the end of the probation of `update` under the bounds `/config/supervisor` gives, and when the runner reverted it, has the runner revert `siblings`, the other updates of its commit, and the specification name the old bundle again unless it changed since the update.
fn follow_probation(
    control: os::Control,
    view: store::service::View,
    take update: Update,
    take siblings: mem::List[Update],
    alloc: mem::Alloc,
    ) fails task::Cancelled uses wait {
    let probation = try await configured_probation(view, alloc)
    let reverted = match first attempt await control.probated(ident::Moniker(text: update.moniker.text), bundle: update.new, probation, alloc) {
        Ok(given) => given
        Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return
    }
    if not reverted {
        return
    }
    for sibling in siblings {
        match attempt await control.revert(ident::Moniker(text: sibling.moniker.text), bundle: sibling.new, alloc) {
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
    }
    let Some(Specified(spec: held, version: version)) = try await spec_of(view, moniker: ident::Moniker(text: update.moniker.text), alloc) else {
        return
    }
    if held.bundle != update.new {
        return
    }
    let Some(path) = desired("/instances", alloc).child(update.moniker.text.as_bytes(), alloc) else {
        return
    }
    var spec = held
    spec.bundle = update.old
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[os::InstanceSpec].encode(spec, out: mut bytes)
    var expects = mem::List[store::Expect].empty(alloc)
    mut expects.push(store::Expect(path: ident::Path(text: text::String.of(path.text.as_str(), alloc)), version: store::Version.Commit(ident::CommitId(number: version))))
    var writes = mem::List[store::Write].empty(alloc)
    mut writes.push(store::Write.Put(path: take path, value: store::Value.Record(type: store::service::spec_type(alloc), bytes: take bytes, secret: false)))
    let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: take expects, writes: take writes, key: None, plan: None, intent: Some(text::String.of("revert update", alloc)))
    match attempt await view.commit(take transaction, typed: true, alloc) {
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} follow_probation

/// The probation bounds of `/config/supervisor`, chapter 10's when it holds none that decodes.
fn configured_probation(view: store::service::View, alloc: mem::Alloc) -> os::Probation fails task::Cancelled uses wait {
    let node = match first attempt await view.get(desired("/config/supervisor", alloc), at: None, alloc) {
        Ok(found) => found
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return os::Probation.defaults()
    }
    let Some(value) = node.value else {
        return os::Probation.defaults()
    }
    return match attempt mem::wire::Codec[SupervisorConfig].decode(value.view(), alloc) {
        Ok(config) => config.probation
        Err(_) => os::Probation.defaults()
    }
} configured_probation

/// An order's outcome, which the next pass acts on again when it failed; a cancellation stays one.
fn settled[T](take outcome: Result[T, os::ControlError]) fails task::Cancelled {
    match outcome {
        Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} settled

/// Sets `stopped` in the specification of the instance `moniker`, which the reconciling pass its commit starts then stops.
fn mark_stopped(view: store::service::View, take moniker: ident::Moniker, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let Some(Specified(spec: held, version: _)) = try await spec_of(view, moniker, alloc) else {
        return
    }
    let Some(path) = desired("/instances", alloc).child(moniker.text.as_bytes(), alloc) else {
        return
    }
    var spec = held
    spec.stopped = true
    var bytes = mem::Bytes.empty(alloc)
    mem::wire::Codec[os::InstanceSpec].encode(spec, out: mut bytes)
    var writes = mem::List[store::Write].empty(alloc)
    mut writes.push(store::Write.Put(path: take path, value: store::Value.Record(type: store::service::spec_type(alloc), bytes: take bytes, secret: false)))
    let transaction = store::Transaction(base: None, reads: mem::List.empty(alloc), expects: mem::List.empty(alloc), writes: take writes, key: None, plan: None, intent: Some(text::String.of("stop", alloc)))
    match attempt await view.commit(take transaction, typed: true, alloc) {
        Err(store::service::ViewError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} mark_stopped

/// Whether `monikers` holds `moniker`.
fn holds(monikers: mem::List[ident::Moniker], moniker: ident::Moniker) -> bool {
    for held in monikers {
        if held == moniker {
            return true
        }
    }
    return false
} holds

/// Starts the base instances in their order, each step once every instance of the step before runs, hibernates or has failed, and the steps after those holding `devices` or `fat` once `devices` has settled the role holders they need.
fn start_in_order(control: os::Control, devices: Option[os::Port[devices::Devices]], exec: task::Executor, alloc: mem::Alloc) fails task::Cancelled uses wait {
    var step = mem::List[Starting].empty(alloc)
    var started = mem::List[ident::Moniker].empty(alloc)
    var name = text::Fixed[59].empty()
    var settling = false
    for byte in START_ORDER.as_bytes() {
        if byte != b' ' and byte != b'\n' {
            mut name.push(char.checked_from_bits(u32.widen(byte)).value_or(' '))
            continue
        }
        settling = settling or name.as_str() == "devices" or name.as_str() == "fat"
        let again = holds(started, moniker: ident::Moniker(text: name))
        if not again {
            mut started.push(ident::Moniker(text: name))
        }
        mut step.push(Starting(moniker: ident::Moniker(text: name), again: again))
        name = text::Fixed[59].empty()
        if byte == b'\n' {
            try await start_all(control, steps: take step, exec, alloc)
            step = mem::List.empty(alloc)
            if settling {
                try await settle(devices, alloc)
            }
            settling = false
        }
    }
} start_in_order

/// Waits until `devices` has settled the role holders the steps after need, at once without a port to it.
fn settle(devices: Option[os::Port[devices::Devices]], alloc: mem::Alloc) fails task::Cancelled uses wait {
    let Some(port) = devices else {
        return
    }
    var call = sys::Encoded.empty(alloc)
    let reply = sys::Wire[devices::Devices].settled(mut call)
    match attempt await port.call(take call, reply, alloc) {
        Err(os::PortError.Cancelled(cancelled)) => fail cancelled
        else => {
        }
    }
} settle

/// A base instance a step of the start order starts, or restarts when an earlier step started it.
struct Starting {
    moniker: ident::Moniker
    again: bool
} Starting

/// Starts, or restarts, the instances `steps` names in parallel and returns once each runs, hibernates or has failed, passing over those without a specification.
fn start_all(control: os::Control, take steps: mem::List[Starting], exec: task::Executor, alloc: mem::Alloc) fails task::Cancelled uses wait {
    var given = Some(take steps)
    try await task::scope(exec, body: fn[mut given](s: task::Scope) {
        let Some(named) = mut given.extract() else {
            return
        }
        for each in take named {
            let Starting(moniker: moniker, again: again) = each
            discard s.spawn(fn[take moniker]() fails task::Cancelled uses wait limits stack 16_384 {
                let ordered = match again {
                    true => attempt await control.restart(take moniker, alloc)
                    false => attempt await control.start(take moniker, alloc)
                }
                match ordered {
                    Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
                    else => {
                    }
                }
            })
        }
    })
} start_all

/// Answers `count` orders from `orders` as a runner whose only instances are `fat` and `store`, and gives the monikers of the orders, in the order they came.
fn answered(take orders: task::Receiver[os::Order], count: usize, alloc: mem::Alloc) -> mem::List[text::String] fails task::Cancelled uses wait {
    var receiver = orders
    var names = mem::List[text::String].empty(alloc)
    while names.len() < count {
        let Some(order) = try await mut receiver.receive() else {
            break
        }
        let name = order.moniker.text.as_str()
        mut names.push(text::String.of(name, alloc))
        var outcome: Result[os::Outcome, os::ControlError] = Err(os::ControlError.Missing)
        if name == "fat" or name == "store" {
            outcome = Ok(os::Outcome.Lifecycle(os::Lifecycle.Running))
        }
        discard attempt await order.done.send(take outcome)
    }
    return names
} answered

test base_instances_start_step_by_step for start_in_order {
    let world = testing::world()
    let alloc = world.alloc
    let task::Channel(sender: orders, receiver: ordered) = task::Channel[os::Order].bounded(4, alloc)
    let minted = os::MintedControl.of(orders, grant: None, prefix: None, alloc)
    defer take minted.close()
    let control = minted.mint(os::ControlRights(read: false, lifecycle: true, spawn: false, reserved: 0))
    var names = mem::List[text::String].empty(alloc)
    var given = Some(take ordered)
    try await task::scope(world.exec, body: fn[mut names, mut given](s: task::Scope) fails task::Cancelled uses wait {
        discard s.spawn(fn() fails task::Cancelled uses wait limits stack 16_384 {
            try await start_in_order(control, devices: None, exec: world.exec, alloc)
        })
        let Some(receiver) = mut given.extract() else {
            return
        }
        names = try await answered(take receiver, count: 15, alloc)
    })
    expect names.len() == 15
    expect names[0].as_str() == "devices" and names[1].as_str() == "fat" and names[2].as_str() == "keys" and names[3].as_str() == "store"
    expect names[6].as_str() == "policy" and names[7].as_str() == "boot"
} base_instances_start_step_by_step
