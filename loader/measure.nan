//! Measurement: the PCR events the loader logs for the candidate it boots, and the event log it passes on.

/// The event type of the loader's events, `EV_IPL`.
const IPL_EVENT: u32 = 0x0000_000D

/// The PCRs of the manifest and the mode, and of the files.
const MANIFEST_PCR: u32 = 8

const FILES_PCR: u32 = 9

/// The module the event log copy goes in.
const EVENT_LOG_MODULE: Str = "eventlog"

/// Extends the PCRs with the candidate's measurements: the manifest hash in PCR 8, the blob ids of the kernel image, the genesis record and the `keyring` bundle in PCR 9, then the mode in PCR 8; a `dev` candidate's kernel image and mode only.
fn measure(services: boot::Services, candidate: Candidate, mode: text::Fixed[16]) {
    let dev = candidate.choice.mode == bootfmt::Mode.Dev.to_bits()
    if not dev {
        extend(services, pcr: MANIFEST_PCR, data: candidate.manifest.view())
    }
    extend(services, pcr: FILES_PCR, data: candidate.hash.view())
    if not dev {
        extend(services, pcr: FILES_PCR, data: candidate.genesis_hash.view())
    }
    match candidate.keyring {
        Some(file) => extend(services, pcr: FILES_PCR, data: file.hash.view())
        None => {
        }
    }
    var text = text::Fixed[24].of("nanos.mode ")
    mut text.append(mode.as_str())
    extend(services, pcr: MANIFEST_PCR, data: text.as_str().as_bytes())
} measure

/// Extends PCR `pcr` with `data`, logged as an `EV_IPL` event of the same bytes.
fn extend(services: boot::Services, pcr: u32, data: Slice[u8]) {
    discard attempt services.measure(pcr, event_type: IPL_EVENT, data, event: data)
} extend
