//! What drivers share for their interrupts: the storm limit of their vectors, the relay of a vector's signal to their messages, and the alarm through which they report a storming vector.

/// The most interrupts a vector raises in a second before the runtime masks it as storming.
pub const STORM_LIMIT: u32 = 100_000

/// How long a relay waits after a signal before calling once more, so that its driver finds a vector masked as storming.
const QUIET_MS: u64 = 1_000

/// Calls `post` after each post of `signal`, and once more after `QUIET_MS` without one, until `post` returns false.
pub fn relay(signal: mem::Shared[hw::Signal[Unit]], clock: sys::Clock, post: fn() -> bool fails task::Cancelled uses wait) fails task::Cancelled uses wait {
    loop {
        try await signal.contents().wait()
        loop {
            if not try await post() {
                return
            }
            let again = try await task::within(clock, ms: QUIET_MS, body: fn() fails task::Cancelled uses wait {
                try await signal.contents().wait()
            })
            if again.is_none() {
                if not try await post() {
                    return
                }
                break
            }
        }
    }
} relay

/// The alarm of the driver of the device at `path`: it records an interrupt storm of the device through `root` and abandons the driver's domain through `abandoner`.
pub open struct Alarm derives Send {
    root: Root
    path: BusPath
    abandoner: mem::Shared[sys::Abandoner]
} Alarm

pub fn Alarm.of(root: Root, path: BusPath, take abandoner: mem::Shared[sys::Abandoner]) -> Alarm = Alarm(root: root, path: path, abandoner: take abandoner)

/// Supersedes key `key`, that of the relay of the device's storming vector, of index `vector` among its vectors, with a keyed task that records `device.interrupt-storm` for it, then abandons the driver's domain.
pub fn Alarm.raise[M: Send](self, mut cx: sys::Cx[M], key: u64, vector: u16) {
    let root = self.root
    let path = self.path
    let abandoner = self.abandoner.share()
    mut cx.spawn(key: key, run: fn[take abandoner](out: sys::Outbox[M]) fails task::Cancelled uses wait limits stack 8_192 {
        match attempt await root.emit(Event(kind: EventKind.InterruptStorm, path: path, argument: u64.widen(vector))) {
            Err(RootError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
        abandoner.contents().trigger()
    })
} Alarm.raise
