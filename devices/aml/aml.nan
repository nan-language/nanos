//! The AML namespace of the DSDT and SSDTs: the tables checked and joined into one code, the namespace their definition blocks build, the evaluation of `\_S5`, `_PRT` and `_CRS`, and the platform devices they describe.

/// The bytes of an ACPI table header, which the code leaves out.
const HEADER_BYTES: u32 = 36

/// Why an evaluation or a table fails: a malformed encoding, an operation region reached, more than 100,000 opcodes run, more than 1 MiB drawn, an opcode the evaluator does not run, or a missing object.
pub closed enum AmlError derives Copy, Eq, Render, Encode {
    Malformed
    Region
    Opcodes
    Memory
    Unsupported
    Missing
} AmlError

/// The definition blocks of the valid tables, joined: their bytes, and where each block lies in them.
pub closed struct Code derives Render, Encode {
    pub bytes: mem::Bytes
    pub blocks: mem::List[Block]
} Code

/// A definition block of the code: from `start` to `end`.
pub closed struct Block derives Copy, Eq, Render, Encode {
    pub start: u32
    pub end: u32
} Block

/// What loading tables gives: the code of the valid ones, and the signatures of those that failed their checks.
pub closed struct Loaded derives Render, Encode {
    pub code: Code
    pub invalid: mem::List[Array[u8, 4]]
} Loaded

/// Joins the definition blocks of the tables `tables` whose header, length and checksum hold and whose signature is DSDT or SSDT.
pub fn load(tables: mem::List[Untrusted[mem::Bytes]], alloc: mem::Alloc) -> Loaded {
    var code = Code(bytes: mem::Bytes.empty(alloc), blocks: mem::List.empty(alloc))
    var invalid = mem::List[Array[u8, 4]].empty(alloc)
    for table in tables {
        let signature = append_block(table.view(), mut code)
        match signature {
            Some(refused) => mut invalid.push(refused)
            None => {
            }
        }
    }
    return Loaded(code: take code, invalid: take invalid)
} load

/// Appends the definition block of the table `raw` to `code`, or gives the table's signature when it fails its checks.
validator fn append_block(raw: Untrusted[Slice[u8]], mut code: Code) -> Option[Array[u8, 4]] {
    let bytes = raw.inspect()
    var signature = Array[u8, 4].filled(0)
    for at in 0..<4usize {
        if at < bytes.len() {
            signature[at] = bytes[at]
        }
    }
    if not valid_table(bytes) {
        return Some(signature)
    }
    let start = u32.fit(code.bytes.len())
    for at in usize.widen(HEADER_BYTES)..<bytes.len() {
        mut code.bytes.push(bytes[at])
    }
    mut code.blocks.push(Block(start: start, end: u32.fit(code.bytes.len())))
    return None
} append_block

/// Whether `raw` is a DSDT or SSDT whose length is its bytes' and whose checksum makes them sum to 0 modulo 256.
fn valid_table(raw: Slice[u8]) -> bool {
    if raw.len() < usize.widen(HEADER_BYTES) or usize.widen(raw.u32_le(4)) != raw.len() or raw.len() > 0x1000_0000 {
        return false
    }
    let named = (raw[0] == b'D' and raw[1] == b'S' and raw[2] == b'D' and raw[3] == b'T') or (raw[0] == b'S' and raw[1] == b'S' and raw[2] == b'D' and raw[3] == b'T')
    var sum: u8 = 0
    for byte in raw {
        sum = sum.wrapping_add(byte)
    }
    return named and sum == 0
} valid_table

/// A table of `signature` around the AML `body`, its checksum set.
fn sample_table(signature: Slice[u8], body: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    var bytes = mem::Bytes.zeroed(usize.widen(HEADER_BYTES), alloc)
    for at in 0..<4usize {
        bytes[at] = signature[at]
    }
    mut bytes.append(body)
    let length = u32.fit(bytes.len())
    mut bytes.view_mut().write_u32_le(4, value: length)
    var sum: u8 = 0
    for byte in bytes.view() {
        sum = sum.wrapping_add(byte)
    }
    bytes[9] = 0u8.wrapping_sub(sum)
    return bytes
} sample_table

test only_valid_aml_tables_join_the_code for load {
    let alloc = testing::world().alloc
    var tables = mem::List[Untrusted[mem::Bytes]].empty(alloc)
    mut tables.push(Untrusted.of(sample_table(b"DSDT", body: b"\x08ABCD\x01", alloc)))
    var broken = sample_table(b"SSDT", body: b"\x08WXYZ\x00", alloc)
    broken[9] = broken[9].wrapping_add(1)
    mut tables.push(Untrusted.of(take broken))
    mut tables.push(Untrusted.of(sample_table(b"FACP", body: b"", alloc)))
    let loaded = load(tables, alloc)
    expect loaded.code.blocks.len() == 1 and loaded.code.bytes.len() == 6
    expect loaded.invalid.len() == 2 and loaded.invalid[0][0] == b'S' and loaded.invalid[1][0] == b'F'
} only_valid_aml_tables_join_the_code
