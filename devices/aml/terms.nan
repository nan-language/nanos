//! The extent of terms: where a term argument or data object ends, found without evaluating it from each opcode's operand count.

/// The operands an operator opcode takes, its target included; `None` for an opcode that is no operator the evaluator knows.
pub fn arity(op: u8) -> Option[u8] {
    return match op {
        0x70 => Some(2)
        0x71 or 0x75 or 0x76 or 0x83 or 0x87 or 0x8E or 0x92 => Some(1)
        0x80 or 0x81 or 0x82 or 0x90 or 0x91 or 0x93 or 0x94 or 0x95 or 0x96 or 0x97 or 0x98 or 0x99 => Some(2)
        0x72 or 0x73 or 0x74 or 0x77 or 0x79 or 0x7A or 0x7B or 0x7C or 0x7D or 0x7E or 0x7F or 0x84 or 0x85 or 0x88 or 0x9C => Some(3)
        0x78 => Some(4)
        else => None
    }
} arity

/// The offset after the term starting at `at`, `None` when it is malformed or runs past `limit`. A name string counts as a term of its own, so a method invocation's arguments are not passed over.
pub fn term_end(code: Slice[u8], at: usize, limit: usize, scope: Path) -> Option[usize] {
    var pc = at
    var pending: u32 = 1
    while pending > 0 {
        if pc >= limit {
            return None
        }
        let op = code[pc]
        pending -= 1
        if op == 0x00 or op == 0x01 or op == 0xFF or (op >= 0x60 and op <= 0x6E) {
            pc += 1
        } else if op == 0x0A {
            pc += 2
        } else if op == 0x0B {
            pc += 3
        } else if op == 0x0C {
            pc += 5
        } else if op == 0x0E {
            pc += 9
        } else if op == 0x0D {
            pc += 1
            while pc < limit and code[pc] != 0 {
                pc += 1
            }
            pc += 1
        } else if op == 0x11 or op == 0x12 or op == 0x13 {
            let Some(sized) = package_end(code, at: pc + 1, limit) else {
                return None
            }
            pc = sized.length
        } else if op == 0x5B {
            if pc + 1 >= limit or (code[pc + 1] != 0x30 and code[pc + 1] != 0x31) {
                return None
            }
            pc += 2
        } else if starts_name(op) {
            let Some(named) = read_name(code, at: pc, scope) else {
                return None
            }
            pc = named.next
        } else {
            let Some(operands) = arity(op) else {
                return None
            }
            pending += u32.widen(operands)
            pc += 1
        }
    }
    if pc > limit {
        return None
    }
    return Some(pc)
} term_end
