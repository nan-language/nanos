//! Tests of the AML namespace over a definition block holding a UART and an RTC, a device absent by its `_STA`, one whose `_CRS` reads a field, a root bridge's `_PRT`, `\_S5_` and an endless loop.

/// The definition block: in `\_SB_`, COM1 (`PNP0501`, `_UID` 1, I/O 0x3F8 of 8 ports and IRQ 4), RTC_ (`PNP0B00`, a `_CRS` method returning I/O 0x70 of 8 ports), GONE (`_STA` 0), REGN (a `_CRS` method reading the field PVAL), LNKA and PCI0, whose `_CRS` holds I/O 0xCF8 of 8 ports, a DWordIO range it produces and a DWordMemory window it consumes, and whose `_PRT` method returns PRTP while PICF is 0; then `\_S5_` (5, 5) and the method `\LOOP`, `While (One) {}`.
const SAMPLE_BLOCK: Slice[u8] = b"\x08\x50\x49\x43\x46\x00\x10\x4E\x16\x5C\x5F\x53\x42\x5F\x5B\x82\x32\x43\x4F\x4D\x31\x08\x5F\x48\x49\x44\x0C\x41\xD0\x05\x01\x08\x5F\x55\x49\x44\x01\x08\x5F\x53\x54\x41\x0A\x0F\x08\x5F\x43\x52\x53\x11\x10\x0A\x0D\x47\x01\xF8\x03\xF8\x03\x00\x08\x22\x10\x00\x79\x00\x5B\x82\x35\x52\x54\x43\x5F\x08\x5F\x48\x49\x44\x0C\x41\xD0\x0B\x00\x08\x42\x55\x46\x30\x11\x0D\x0A\x0A\x47\x01\x70\x00\x70\x00\x00\x08\x79\x00\x14\x12\x5F\x43\x52\x53\x00\xA0\x09\x93\x01\x01\xA4\x42\x55\x46\x30\xA4\x00\x5B\x82\x15\x47\x4F\x4E\x45\x08\x5F\x48\x49\x44\x0C\x41\xD0\x0C\x0F\x08\x5F\x53\x54\x41\x00\x5B\x82\x37\x52\x45\x47\x4E\x08\x5F\x48\x49\x44\x0D\x51\x45\x4D\x55\x30\x30\x30\x32\x00\x5B\x80\x50\x52\x54\x52\x01\x0A\x60\x01\x5B\x81\x0B\x50\x52\x54\x52\x01\x50\x56\x41\x4C\x08\x14\x0B\x5F\x43\x52\x53\x00\xA4\x50\x56\x41\x4C\x5B\x82\x0F\x4C\x4E\x4B\x41\x08\x5F\x48\x49\x44\x0C\x41\xD0\x0C\x0F\x5B\x82\x49\x09\x50\x43\x49\x30\x08\x5F\x48\x49\x44\x0C\x41\xD0\x0A\x08\x08\x5F\x43\x52\x53\x11\x42\x04\x0A\x3E\x47\x01\xF8\x0C\xF8\x0C\x00\x08\x87\x17\x00\x01\x0C\x00\x00\x00\x00\x00\x00\x00\x00\x00\xF7\x0C\x00\x00\x00\x00\x00\x00\xF8\x0C\x00\x00\x87\x17\x00\x00\x0D\x00\x00\x00\x00\x00\x00\x00\xD0\xFE\xFF\x03\xD0\xFE\x00\x00\x00\x00\x00\x04\x00\x00\x79\x00\x14\x1A\x5F\x50\x52\x54\x00\xA0\x0C\x93\x50\x49\x43\x46\x00\xA4\x50\x52\x54\x50\xA1\x06\xA4\x50\x52\x54\x41\x08\x50\x52\x54\x50\x12\x0E\x01\x12\x0B\x04\x0B\xFF\xFF\x00\x4C\x4E\x4B\x41\x00\x08\x50\x52\x54\x41\x12\x0C\x01\x12\x09\x04\x0B\xFF\xFF\x00\x00\x0A\x10\x08\x5F\x53\x35\x5F\x12\x08\x04\x0A\x05\x0A\x05\x00\x00\x10\x0D\x5C\x00\x14\x09\x4C\x4F\x4F\x50\x00\xA2\x02\x01"

/// The code of a DSDT holding `SAMPLE_BLOCK`.
fn sample_code(alloc: mem::Alloc) -> Code {
    var tables = mem::List[Untrusted[mem::Bytes]].empty(alloc)
    mut tables.push(Untrusted.of(sample_table(b"DSDT", body: SAMPLE_BLOCK, alloc)))
    let Loaded(code: code, invalid: _) = load(tables, alloc)
    return code
} sample_code

fn path_of(names: Slice[u8]) -> Path {
    var path = Path.root()
    for at in 0..<(names.len() / 4) {
        let Some(longer) = path.child(u32.widen(names[4 * at]) | (u32.widen(names[4 * at + 1]) << 8) | (u32.widen(names[4 * at + 2]) << 16) | (u32.widen(names[4 * at + 3]) << 24)) else {
            return path
        }
        path = longer
    }
    return path
} path_of

test platform_devices_give_their_identifiers_and_windows for platform {
    let alloc = testing::world().alloc
    let found = try platform(sample_code(alloc), alloc)
    expect found.len() == 5
    expect found[0].hid.as_str() == "PNP0501" and found[0].uid == 1 and not found[0].failed
    expect found[0].windows.len() == 2 and found[0].windows[0] == Window.Ports(base: 0x3F8, count: 8) and found[0].windows[1] == Window.Line(number: 4, isa: true, edge: true, active_low: false)
    expect found[1].hid.as_str() == "PNP0B00" and found[1].windows.len() == 1 and found[1].windows[0] == Window.Ports(base: 0x70, count: 8)
    expect found[2].hid.as_str() == "QEMU0002" and found[2].failed
    expect found[3].hid.as_str() == "PNP0C0F" and found[4].hid.as_str() == "PNP0A08"
    expect found[4].windows.len() == 2 and found[4].windows[0] == Window.Ports(base: 0xCF8, count: 8) and found[4].windows[1] == Window.Memory(base: 0xFED0_0000, size: 0x400)
} platform_devices_give_their_identifiers_and_windows

test routes_and_sleep_states_evaluate for routes {
    let alloc = testing::world().alloc
    let found = try routes(sample_code(alloc), alloc)
    expect found.len() == 1 and found[0].address == 0xFFFF and found[0].pin == 0 and found[0].index == 0
    expect found[0].device == path_of(b"_SB_PCI0") and found[0].source == Some(path_of(b"_SB_LNKA"))
    let sleep = try sleep_state(sample_code(alloc), state: 5, alloc)
    expect sleep == Sleep(a: 5, b: 5)
} routes_and_sleep_states_evaluate

test endless_methods_stop_at_the_opcode_limit for evaluate {
    let alloc = testing::world().alloc
    let code = sample_code(alloc)
    let objects = try namespace(code, alloc)
    let Some(endless) = lookup(objects, path: path_of(b"LOOP"), search: false) else {
        expect false
        return
    }
    let outcome = attempt evaluate(code.bytes.view(), objects, object: endless, alloc)
    let stopped = match outcome {
        Err(AmlError.Opcodes) => true
        else => false
    }
    expect stopped
} endless_methods_stop_at_the_opcode_limit
