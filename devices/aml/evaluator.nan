//! The AML evaluator `devices.aml`: the instance holding the tables' code, which `devices` loads and asks for the platform devices, the PCI interrupt routes and the sleep states it describes.

/// What the evaluator serves.
pub protocol Aml {
    /// Holds the code of the tables `tables` that pass their checks, giving the signatures of those that fail.
    pub fn load(tables: mem::List[Untrusted[mem::Bytes]]) -> mem::List[Array[u8, 4]] limits recorded
    pub fn platform() -> mem::List[Platform] fails AmlError limits recorded
    pub fn routes() -> mem::List[Route] fails AmlError limits recorded
    pub fn sleep_state(state: u8) -> Sleep fails AmlError limits recorded
} Aml

/// The Env of the evaluator: its cell alone.
pub closed struct EvaluatorEnv {
    pub alloc: mem::Alloc
} EvaluatorEnv

impl EvaluatorEnv: nanos::Environment

/// The evaluator's state: the code it holds once loaded.
pub closed struct Evaluator derives Encode {
    pub code: Option[Code]
} Evaluator

impl Evaluator: sys::Component[EvaluatorEnv, Aml]

pub fn EvaluatorEnv.build(take world: nanos::World) -> EvaluatorEnv = EvaluatorEnv(alloc: world.alloc)

pub fn Evaluator.start(mut env: EvaluatorEnv) -> Evaluator = Evaluator(code: None)

pub fn Evaluator.load(mut self, take tables: mem::List[Untrusted[mem::Bytes]], mut env: EvaluatorEnv, mut cx: sys::Cx[Aml]) -> mem::List[Array[u8, 4]] {
    let Loaded(code: code, invalid: invalid) = load(tables, alloc: env.alloc)
    self.code = Some(take code)
    return invalid
} Evaluator.load

pub fn Evaluator.platform(mut self, mut env: EvaluatorEnv, mut cx: sys::Cx[Aml]) -> mem::List[Platform] fails AmlError {
    let Some(code) = self.code else {
        fail AmlError.Missing
    }
    return try platform(code, alloc: env.alloc)
} Evaluator.platform

pub fn Evaluator.routes(mut self, mut env: EvaluatorEnv, mut cx: sys::Cx[Aml]) -> mem::List[Route] fails AmlError {
    let Some(code) = self.code else {
        fail AmlError.Missing
    }
    return try routes(code, alloc: env.alloc)
} Evaluator.routes

pub fn Evaluator.sleep_state(mut self, take state: u8, mut env: EvaluatorEnv, mut cx: sys::Cx[Aml]) -> Sleep fails AmlError {
    let Some(code) = self.code else {
        fail AmlError.Missing
    }
    return try sleep_state(code, state, alloc: env.alloc)
} Evaluator.sleep_state
