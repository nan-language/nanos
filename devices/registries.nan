//! The load-time registries of the kernel image as bundles reach them: the capability through which the core previews what a bundle's image contributes to `drivers` and keeps a contributing bundle loaded.

/// What a bundle's image contributes to `drivers`, and the name of the first of its entries whose key an entry of the registry already has, when one has it.
pub closed struct Previewed derives Render, Encode {
    pub drivers: mem::List[DriverEntry]
    pub duplicate: Option[text::Fixed[20]]
} Previewed

/// An order to the core: give what the image `image` of the bundle of code hash `code` contributes, keep that bundle loaded for its contributions, let it go, or give the code hashes of the bundles it keeps loaded for their contributions; each answered through `done`, with the code of its failure.
pub closed enum RegistryOrder {
    Preview(code: ident::HashValue, image: mem::Bytes, done: task::Sender[Result[Previewed, text::Fixed[32]]])
    Hold(code: ident::HashValue, image: mem::Bytes, done: task::Sender[Result[Unit, text::Fixed[32]]])
    Release(code: ident::HashValue, done: task::Sender[Unit])
    Held(done: task::Sender[mem::List[ident::HashValue]])
} RegistryOrder

/// A capability having the core preview, hold and release the contributions of bundles to its load-time registries.
pub open struct Registries {
} Registries

impl Registries: sys::Kind[RegistryOrders, u8]

/// Where a `Registries` capability's orders go.
struct RegistryOrders {
    orders: task::Sender[RegistryOrder]
} RegistryOrders

/// The root entry the `Registries` capabilities derive from, revoked when it closes.
pub open linear struct MintedRegistries derives Send {
    minter: sys::Minter[Registries, RegistryOrders, u8]
} MintedRegistries

/// A root entry of capabilities ordering through `orders`.
pub fn MintedRegistries.of(orders: task::Sender[RegistryOrder], alloc: mem::Alloc) -> MintedRegistries {
    return MintedRegistries(minter: sys::Minter[Registries, RegistryOrders, u8].of(RegistryOrders(orders: orders.split()), alloc))
} MintedRegistries.of

pub fn MintedRegistries.mint(self) -> Registries {
    return self.minter.mint(0)
} MintedRegistries.mint

/// Revokes every capability of this root entry.
pub fn MintedRegistries.close(take self) {
    let MintedRegistries(minter: minter) = self
    take minter.close()
} MintedRegistries.close

/// What the image `image` of the bundle of code hash `code` contributes, each entry from that bundle, automatic unless an agent's; `port.revoked` once the capability is stale.
pub fn Registries.preview(self, code: ident::HashValue, take image: mem::Bytes, alloc: mem::Alloc) -> Result[Previewed, text::Fixed[32]] fails task::Cancelled uses wait {
    let task::Channel(sender: done, receiver: answer) = task::Channel[Result[Previewed, text::Fixed[32]]].bounded(1, alloc)
    if not try await self.order(RegistryOrder.Preview(code: code, image: take image, done: take done)) {
        return Err(text::Fixed[32].of("port.revoked"))
    }
    var receiver = answer
    return match try await mut receiver.receive() {
        Some(given) => given
        None => Err(text::Fixed[32].of("port.server-stopped"))
    }
} Registries.preview

/// Keeps the bundle of code hash `code`, whose image is `image`, loaded with its contributions until `release`; the code of the load's failure otherwise.
pub fn Registries.hold(self, code: ident::HashValue, take image: mem::Bytes, alloc: mem::Alloc) -> Result[Unit, text::Fixed[32]] fails task::Cancelled uses wait {
    let task::Channel(sender: done, receiver: answer) = task::Channel[Result[Unit, text::Fixed[32]]].bounded(1, alloc)
    if not try await self.order(RegistryOrder.Hold(code: code, image: take image, done: take done)) {
        return Err(text::Fixed[32].of("port.revoked"))
    }
    var receiver = answer
    return match try await mut receiver.receive() {
        Some(given) => given
        None => Err(text::Fixed[32].of("port.server-stopped"))
    }
} Registries.hold

/// Lets go of the bundle of code hash `code` a `hold` kept loaded.
pub fn Registries.release(self, code: ident::HashValue, alloc: mem::Alloc) fails task::Cancelled uses wait {
    let task::Channel(sender: done, receiver: answer) = task::Channel[Unit].bounded(1, alloc)
    if not try await self.order(RegistryOrder.Release(code: code, done: take done)) {
        return
    }
    var receiver = answer
    discard try await mut receiver.receive()
} Registries.release

/// The code hashes of the bundles the core keeps loaded for their contributions, `None` once the capability is stale.
pub fn Registries.held(self, alloc: mem::Alloc) -> Option[mem::List[ident::HashValue]] fails task::Cancelled uses wait {
    let task::Channel(sender: done, receiver: answer) = task::Channel[mem::List[ident::HashValue]].bounded(1, alloc)
    if not try await self.order(RegistryOrder.Held(done: take done)) {
        return None
    }
    var receiver = answer
    return try await mut receiver.receive()
} Registries.held

/// Sends `order` to the core; whether the capability reached it.
fn Registries.order(self, take order: RegistryOrder) -> bool fails task::Cancelled uses wait {
    let Some(orders) = sys::reach(self, body: fn(state: RegistryOrders, record: u8) => state.orders.split()) else {
        return false
    }
    return match attempt await orders.send(take order) {
        Ok(_) => true
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
        Err(task::SendError.Closed) => false
    }
} Registries.order
