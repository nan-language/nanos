//! The device root: the capability of every device of the machine, whose orders the core's keeper carries out.

/// The device root, or the core's copy of it, which alone claims devices for their drivers.
pub open struct Root {
} Root

impl Root: sys::Kind[Keeper, RootRights]

pub layout RootRights: u8 {
    claim: bit 0
    reserved: rest
} RootRights

/// The root entry the device root's copies derive from, revoked when it closes.
pub open linear struct MintedRoot derives Send {
    minter: sys::Minter[Root, Keeper, RootRights]
} MintedRoot

/// Where a root's orders go, and the clock its waits for their outcomes run on.
struct Keeper {
    orders: task::Sender[RootOrder]
    clock: sys::Clock
} Keeper

/// A resource of a device: a memory BAR, a window of I/O ports or of memory, its MSI-X vectors, its MSI capability, the INTx pin it raises, or a platform interrupt line.
pub closed enum Resource derives Copy, Eq, Encode {
    Memory(bar: u8, base: u64)
    Ports(base: u16, count: u16)
    Window(base: u64, size: u64)
    Msix(vectors: u16)
    Msi
    Intx(pin: u8)
    Line(number: u32)
} Resource

/// A device the keeper holds: where it sits, what identifies it, its resources, and whether the core keeps it for itself.
pub closed struct Found derives Encode {
    pub path: BusPath
    pub ids: DeviceIds
    pub resources: mem::List[Resource]
    pub core: bool
} Found

/// What a driver's Env is built from: its PCI function, or the port windows of its platform device.
pub closed linear enum Claimed {
    Pci(hw::PciFunction)
    Platform(mem::List[Resource])
} Claimed

/// An order to the keeper, with where its outcome goes.
pub closed enum RootOrder {
    /// The devices the keeper holds.
    Devices(done: task::Sender[mem::List[Found]])
    /// The `index`th firmware table of `signature`.
    Table(signature: Array[u8, 4], index: u32, done: task::Sender[Option[Untrusted[mem::Bytes]]])
    /// Adds a platform device the AML namespace describes, refused when its windows overlap another's or the core's.
    Declare(path: BusPath, ids: DeviceIds, resources: mem::List[Resource], done: task::Sender[bool])
    /// The device's hardware, for its driver's Env, `None` while a driver holds it.
    Claim(path: BusPath, done: task::Sender[Option[Claimed]])
    /// An event of a device to record.
    Emit(event: Event)
} RootOrder

/// The kinds of device events.
pub closed enum EventKind derives Copy, Eq, Encode {
    Added
    Removed
    TableInvalid
    Bound
    Unbound
    CutOff
    Failed
    Suspended
    Resumed
} EventKind

/// A device event: its kind, the device's bus path, and its argument: the bound entry's index in the registry, the failure's code, or the table's signature.
pub closed struct Event derives Copy, Eq, Encode {
    pub kind: EventKind
    pub path: BusPath
    pub argument: u64
} Event

/// A root entry over the keeper `orders` reach, waiting for outcomes on `clock`.
pub fn MintedRoot.of(orders: task::Sender[RootOrder], clock: sys::Clock, alloc: mem::Alloc) -> MintedRoot {
    return MintedRoot(minter: sys::Minter[Root, Keeper, RootRights].of(Keeper(orders: orders.split(), clock: clock), alloc))
} MintedRoot.of

/// A copy of the root, claiming devices when `claim`.
pub fn MintedRoot.mint(self, claim: bool) -> Root {
    return self.minter.mint(RootRights(claim: claim, reserved: 0))
} MintedRoot.mint

pub fn MintedRoot.close(take self) {
    let MintedRoot(minter: minter) = self
    take minter.close()
} MintedRoot.close

pub closed enum RootError derives Render {
    Revoked
    Denied
    Cancelled(task::Cancelled) from
} RootError

/// The keeper's orders, when the root is live and permits `claiming` when asked.
fn Root.orders(self, claiming: bool) -> task::Sender[RootOrder] fails RootError {
    let reached = sys::reach(self, body: fn(state: Keeper, record: RootRights) -> Option[task::Sender[RootOrder]] {
        if claiming and not record.claim {
            return None
        }
        return Some(state.orders.split())
    })
    let Some(permitted) = reached else {
        fail RootError.Revoked
    }
    let Some(orders) = permitted else {
        fail RootError.Denied
    }
    return orders
} Root.orders

/// The clock the root's waits run on.
fn Root.clock(self) -> sys::Clock fails RootError {
    let Some(clock) = sys::reach(self, body: fn(state: Keeper, record: RootRights) -> sys::Clock {
        return state.clock
    }) else {
        fail RootError.Revoked
    }
    return clock
} Root.clock

/// Sends `order` to the keeper.
fn Root.send(self, take order: RootOrder, claiming: bool) fails RootError uses wait {
    let orders = try self.orders(claiming)
    match attempt await orders.send(take order) {
        Ok(_) => {
        }
        Err(task::SendError.Closed) => fail RootError.Revoked
        Err(task::SendError.Cancelled(cancelled)) => fail cancelled
    }
} Root.send

/// Waits for an outcome from `outcome`, revoked when the keeper drops it. The wait starts again every `RECHECK_MS`, which takes an outcome already queued whose wake-up was lost.
fn awaited[T: Send](take outcome: task::Receiver[T], clock: sys::Clock) -> T fails RootError uses wait {
    var receiver = outcome
    loop {
        let given = try await task::within(clock, ms: RECHECK_MS, body: fn[mut receiver]() -> Option[T] fails task::Cancelled uses wait limits stack 4_096 {
            return try await mut receiver.receive()
        })
        match given {
            Some(Some(value)) => return value
            Some(None) => fail RootError.Revoked
            None => {
            }
        }
    }
} awaited

const RECHECK_MS: u64 = 1_000

/// The devices the keeper holds.
pub fn Root.devices(self, alloc: mem::Alloc) -> mem::List[Found] fails RootError uses wait {
    let task::Channel(sender: done, receiver: outcome) = task::Channel[mem::List[Found]].bounded(1, alloc)
    try await self.send(RootOrder.Devices(done: take done), claiming: false)
    return try await awaited(take outcome, clock: try self.clock())
} Root.devices

/// The `index`th firmware table of `signature`, `None` when the firmware has no such table.
pub fn Root.table(self, signature: Array[u8, 4], index: u32, alloc: mem::Alloc) -> Option[Untrusted[mem::Bytes]] fails RootError uses wait {
    let task::Channel(sender: done, receiver: outcome) = task::Channel[Option[Untrusted[mem::Bytes]]].bounded(1, alloc)
    try await self.send(RootOrder.Table(signature: signature, index: index, done: take done), claiming: false)
    return try await awaited(take outcome, clock: try self.clock())
} Root.table

/// Adds the platform device at `path`, false when the keeper refuses it.
pub fn Root.declare(
    self,
    path: BusPath,
    ids: DeviceIds,
    take resources: mem::List[Resource],
    alloc: mem::Alloc,
    ) -> bool fails RootError uses wait {
    let task::Channel(sender: done, receiver: outcome) = task::Channel[bool].bounded(1, alloc)
    try await self.send(RootOrder.Declare(path: path, ids: ids, resources: take resources, done: take done), claiming: false)
    return try await awaited(take outcome, clock: try self.clock())
} Root.declare

/// Orders the hardware of the device at `path` for its driver's Env, giving where it comes: `None` while a driver holds it or the keeper holds no such device. Only the core's root claims; `release` takes what comes when the order cannot be sent.
pub fn Root.claim(self, path: BusPath, alloc: mem::Alloc, release: fn(take left: Option[Claimed])) -> task::Receiver[Option[Claimed]] fails RootError uses wait {
    let task::Channel(sender: done, receiver: outcome) = task::Channel[Option[Claimed]].bounded(1, alloc)
    match attempt await self.send(RootOrder.Claim(path: path, done: take done), claiming: true) {
        Ok(_) => return outcome
        Err(failure) => {
            discard attempt await take outcome.drain(visit: release)
            fail failure
        }
    }
} Root.claim

/// Records a device event.
pub fn Root.emit(self, event: Event) fails RootError uses wait {
    try await self.send(RootOrder.Emit(event: event), claiming: false)
} Root.emit
