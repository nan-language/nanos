//! The device protocols drivers serve, and the failures of their operations.

/// A failure of a device operation.
pub closed enum DeviceError derives Copy, Eq, Render, Encode {
    OutOfRange
    TooLarge
    Io
    Timeout
    Reset
    Unaligned
    ReadOnly
    Unsupported
    Unplugged
} DeviceError

/// A `Block` device's geometry: its units, its block size, the blocks of the unit asked about, the largest transfer, its zone size, 0 when it is not zoned, and whether it has a volatile cache, honours FUA writes, discards blocks and is read-only.
pub closed struct BlockInfo derives Copy, Eq, Render, Encode {
    pub units: u16
    pub block_bytes: u32
    pub blocks: u64
    pub max_transfer_bytes: u32
    pub zone_blocks: u32
    pub cache: bool
    pub fua: bool
    pub discards: bool
    pub read_only: bool
} BlockInfo

/// The device protocol of block devices, each serving every unit of its controller.
pub protocol Block {
    pub fn info(unit: u16) -> BlockInfo fails DeviceError limits irreversible(emit, actuate, erase, spend)
    /// `count` blocks from `block`.
    pub fn read(unit: u16, block: u64, count: u32) -> Untrusted[mem::Bytes] fails DeviceError limits irreversible(emit, actuate, erase, spend)
    /// Writes whole blocks from `block`, durable at completion when `fua`.
    pub fn write(unit: u16, block: u64, data: mem::Bytes, fua: bool) fails DeviceError limits irreversible(emit, actuate, erase, spend)
    pub fn flush(unit: u16) fails DeviceError limits irreversible(emit, actuate, erase, spend)
    pub fn discard_blocks(unit: u16, block: u64, count: u32) fails DeviceError limits irreversible(emit, actuate, erase, spend)
} Block

/// The device protocol of serial consoles; the `_reserved` operations are the reserved lane of `console`.
pub protocol Console {
    /// Queues at most 4 KiB, waiting while 64 KiB are queued.
    pub fn write(data: mem::Bytes) fails DeviceError limits irreversible(emit, actuate, erase, spend)
    /// From 1 to `max` bytes, once any arrive.
    pub fn read(max: u32) -> Untrusted[mem::Bytes] fails DeviceError limits irreversible(emit, actuate, erase, spend)
    pub fn write_reserved(data: mem::Bytes) fails DeviceError limits irreversible(emit, actuate, erase, spend)
    pub fn read_reserved(max: u32) -> Untrusted[mem::Bytes] fails DeviceError limits irreversible(emit, actuate, erase, spend)
} Console

/// The device protocol of entropy sources.
pub protocol Entropy {
    /// `count` bytes, from 1 to 4,096.
    pub fn fill(count: u32) -> Untrusted[mem::Bytes] fails DeviceError limits irreversible(emit, actuate, erase, spend)
} Entropy

/// The device protocol of real-time clocks, which hold UTC in seconds.
pub protocol Rtc {
    pub fn read() -> i64 fails DeviceError limits irreversible(emit, actuate, erase, spend)
    pub fn set(utc_s: i64) fails DeviceError limits irreversible(emit, actuate, erase, spend)
} Rtc

/// The device protocol a driver's instances serve.
pub closed enum Class derives Copy, Eq, Render, Encode {
    Block
    Console
    Entropy
    Rtc
} Class

/// The protocol hash of a class's device protocol.
pub fn Class.protocol(self) -> sys::ProtocolHash {
    return match self {
        Class.Block => sys::Wire[Block].hash()
        Class.Console => sys::Wire[Console].hash()
        Class.Entropy => sys::Wire[Entropy].hash()
        Class.Rtc => sys::Wire[Rtc].hash()
    }
} Class.protocol
