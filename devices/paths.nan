//! Bus paths: where a device sits, naming its record under `/live/devices`.

/// A device's bus path: a PCI function by its address, or an ACPI device by its `_HID` and `_UID`.
pub closed enum BusPath derives Copy, Eq, Ord, Render, Encode {
    Pci(PciAddress)
    Acpi(hid: text::Fixed[8], uid: u32)
} BusPath

/// A PCI function's segment, bus, device and function numbers.
pub closed struct PciAddress derives Copy, Eq, Ord, Render, Encode {
    pub segment: u16
    pub bus: u8
    pub device: u8
    pub function: u8
} PciAddress

pub fn PciAddress.of(address: hw::PciAddress) -> PciAddress = PciAddress(segment: address.segment, bus: address.bus, device: address.device, function: address.function)

/// The text of a bus path: `pci/0000.00.1f.2` or `acpi/PNP0501.1`.
pub fn BusPath.text(self) -> text::Fixed[32]
    example BusPath.Pci(PciAddress(segment: 0, bus: 0, device: 0x1F, function: 2)).text().as_str() == "pci/0000.00.1f.2"
    example BusPath.Acpi(hid: text::Fixed[8].of("PNP0501"), uid: 1).text().as_str() == "acpi/PNP0501.1"
{
    var written = text::Fixed[32].empty()
    match self {
        BusPath.Pci(address) => {
            mut written.append("pci/")
            hex(mut written, value: u64.widen(address.segment), digits: 4)
            mut written.append(".")
            hex(mut written, value: u64.widen(address.bus), digits: 2)
            mut written.append(".")
            hex(mut written, value: u64.widen(address.device), digits: 2)
            mut written.append(".")
            hex(mut written, value: u64.widen(address.function), digits: 1)
        }
        BusPath.Acpi(hid: hid, uid: uid) => {
            mut written.append("acpi/")
            mut written.append(hid.as_str())
            mut written.append(".")
            decimal(mut written, value: u64.widen(uid))
        }
    }
    return written
} BusPath.text

/// The bus path `text` names, `None` when it names none.
pub fn BusPath.parse(text: Str) -> Option[BusPath]
    example BusPath.parse("pci/0000.00.1f.2") == Some(BusPath.Pci(PciAddress(segment: 0, bus: 0, device: 0x1F, function: 2)))
    example BusPath.parse("acpi/PNP0501.1") == Some(BusPath.Acpi(hid: text::Fixed[8].of("PNP0501"), uid: 1))
    example BusPath.parse("pci/0000.00.1F.2") == None
{
    let bytes = text.as_bytes()
    let Some(parts) = bytes.split_at(5) else {
        return None
    }
    if parts.head == b"acpi/" {
        return acpi_path(parts.tail)
    }
    let Some(halves) = bytes.split_at(4) else {
        return None
    }
    if halves.head != b"pci/" or halves.tail.len() != 12 {
        return None
    }
    let rest = halves.tail
    if rest[4] != b'.' or rest[7] != b'.' or rest[10] != b'.' {
        return None
    }
    let Some(segment) = hex_of(rest, from: 0, to: 4) else {
        return None
    }
    let Some(bus) = hex_of(rest, from: 5, to: 7) else {
        return None
    }
    let Some(device) = hex_of(rest, from: 8, to: 10) else {
        return None
    }
    let Some(function) = hex_of(rest, from: 11, to: 12) else {
        return None
    }
    if device > 0x1F or function > 7 {
        return None
    }
    return Some(BusPath.Pci(PciAddress(segment: u16.fit(segment), bus: u8.fit(bus), device: u8.fit(device), function: u8.fit(function))))
} BusPath.parse

/// The ACPI bus path after `acpi/`: an identifier of capitals and digits, a dot, and a decimal `_UID`.
fn acpi_path(text: Slice[u8]) -> Option[BusPath] {
    var dot: usize = 0
    while dot < text.len() and text[dot] != b'.' {
        let byte = text[dot]
        if not ((byte >= b'A' and byte <= b'Z') or (byte >= b'0' and byte <= b'9')) {
            return None
        }
        dot += 1
    }
    if dot == 0 or dot > 8 or dot + 1 >= text.len() {
        return None
    }
    var uid: u64 = 0
    for at in (dot + 1)..<text.len() {
        let byte = text[at]
        if byte < b'0' or byte > b'9' {
            return None
        }
        let Some(scaled) = uid.checked_mul(10) else {
            return None
        }
        uid = scaled + u64.widen(byte - b'0')
        if uid > 0xFFFF_FFFF {
            return None
        }
    }
    var hid = text::Fixed[8].empty()
    for at in 0..<dot {
        mut hid.push(char.checked_from_bits(u32.widen(text[at])).value_or('0'))
    }
    return Some(BusPath.Acpi(hid: hid, uid: u32.fit(uid)))
} acpi_path

/// The lower-case hexadecimal number of `text` from `from` to `to`.
fn hex_of(text: Slice[u8], from: usize, to: usize) -> Option[u64] {
    var value: u64 = 0
    for at in from..<to {
        let byte = text[at]
        let digit = match byte {
            b'0'..=b'9' => byte - b'0'
            b'a'..=b'f' => byte - b'a' + 10
            else => return None
        }
        value = value * 16 + u64.widen(digit)
    }
    return Some(value)
} hex_of

fn hex[N: usize where N > 0](mut written: text::Fixed[N], value: u64, digits: u32) {
    var shift = digits * 4
    while shift > 0 {
        shift -= 4
        let digit = u32.truncate((value >> shift) & 0xF)
        let code = match digit < 10 {
            true => 0x30 + digit
            false => 0x57 + digit
        }
        mut written.push(char.checked_from_bits(code).value_or('0'))
    }
} hex

fn decimal[N: usize where N > 0](mut written: text::Fixed[N], value: u64) {
    var digits = Array[u8, 20].filled(0)
    var count: usize = 0
    var rest = value
    loop {
        digits[count] = u8.truncate(rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 or count == 20 {
            break
        }
    }
    while count > 0 {
        count -= 1
        mut written.push(char.checked_from_bits(0x30 + u32.widen(digits[count])).value_or('0'))
    }
} decimal
