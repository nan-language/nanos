//! Bus paths: where a device sits, naming its record under `/live/devices`.

/// A device's bus path: a PCI function by its address, or an ACPI device by its `_HID` and `_UID`.
pub closed enum BusPath derives Copy, Eq, Ord, Render, Encode {
    Pci(PciAddress)
    Acpi(hid: text::Fixed[8], uid: u32)
} BusPath

/// A PCI function's segment, bus, device and function numbers.
pub closed struct PciAddress derives Copy, Eq, Ord, Render, Encode {
    pub segment: u16
    pub bus: u8
    pub device: u8
    pub function: u8
} PciAddress

pub fn PciAddress.of(address: hw::PciAddress) -> PciAddress = PciAddress(segment: address.segment, bus: address.bus, device: address.device, function: address.function)

/// The text of a bus path: `pci/0000.00.1f.2` or `acpi/PNP0501.1`.
pub fn BusPath.text(self) -> text::Fixed[32]
    example BusPath.Pci(PciAddress(segment: 0, bus: 0, device: 0x1F, function: 2)).text().as_str() == "pci/0000.00.1f.2"
    example BusPath.Acpi(hid: text::Fixed[8].of("PNP0501"), uid: 1).text().as_str() == "acpi/PNP0501.1"
{
    var written = text::Fixed[32].empty()
    match self {
        BusPath.Pci(address) => {
            mut written.append("pci/")
            hex(mut written, value: u64.widen(address.segment), digits: 4)
            mut written.append(".")
            hex(mut written, value: u64.widen(address.bus), digits: 2)
            mut written.append(".")
            hex(mut written, value: u64.widen(address.device), digits: 2)
            mut written.append(".")
            hex(mut written, value: u64.widen(address.function), digits: 1)
        }
        BusPath.Acpi(hid: hid, uid: uid) => {
            mut written.append("acpi/")
            mut written.append(hid.as_str())
            mut written.append(".")
            decimal(mut written, value: u64.widen(uid))
        }
    }
    return written
} BusPath.text

/// The bus path `text` names, `None` when it names none.
pub fn BusPath.parse(text: Str) -> Option[BusPath]
    example BusPath.parse("pci/0000.00.1f.2") == Some(BusPath.Pci(PciAddress(segment: 0, bus: 0, device: 0x1F, function: 2)))
    example BusPath.parse("acpi/PNP0501.1") == Some(BusPath.Acpi(hid: text::Fixed[8].of("PNP0501"), uid: 1))
    example BusPath.parse("pci/0000.00.1F.2") == None
{
    let bytes = text.as_bytes()
    let Some(parts) = bytes.split_at(5) else {
        return None
    }
    if parts.head == b"acpi/" {
        return acpi_path(parts.tail)
    }
    let Some(halves) = bytes.split_at(4) else {
        return None
    }
    if halves.head != b"pci/" or halves.tail.len() != 12 {
        return None
    }
    let rest = halves.tail
    if rest[4] != b'.' or rest[7] != b'.' or rest[10] != b'.' {
        return None
    }
    let Some(segment) = hex_of(rest, from: 0, to: 4) else {
        return None
    }
    let Some(bus) = hex_of(rest, from: 5, to: 7) else {
        return None
    }
    let Some(device) = hex_of(rest, from: 8, to: 10) else {
        return None
    }
    let Some(function) = hex_of(rest, from: 11, to: 12) else {
        return None
    }
    if device > 0x1F or function > 7 {
        return None
    }
    return Some(BusPath.Pci(PciAddress(segment: u16.fit(segment), bus: u8.fit(bus), device: u8.fit(device), function: u8.fit(function))))
} BusPath.parse

/// The ACPI bus path after `acpi/`: an identifier of capitals and digits, a dot, and a decimal `_UID`.
fn acpi_path(text: Slice[u8]) -> Option[BusPath] {
    var dot: usize = 0
    while dot < text.len() and text[dot] != b'.' {
        let byte = text[dot]
        if not ((byte >= b'A' and byte <= b'Z') or (byte >= b'0' and byte <= b'9')) {
            return None
        }
        dot += 1
    }
    if dot == 0 or dot > 8 or dot + 1 >= text.len() {
        return None
    }
    var uid: u64 = 0
    for at in (dot + 1)..<text.len() {
        let byte = text[at]
        if byte < b'0' or byte > b'9' {
            return None
        }
        let Some(scaled) = uid.checked_mul(10) else {
            return None
        }
        uid = scaled + u64.widen(byte - b'0')
        if uid > 0xFFFF_FFFF {
            return None
        }
    }
    var hid = text::Fixed[8].empty()
    for at in 0..<dot {
        mut hid.push(char.checked_from_bits(u32.widen(text[at])).value_or('0'))
    }
    return Some(BusPath.Acpi(hid: hid, uid: u32.fit(uid)))
} acpi_path

/// The lower-case hexadecimal number of `text` from `from` to `to`.
fn hex_of(text: Slice[u8], from: usize, to: usize) -> Option[u64] {
    var value: u64 = 0
    for at in from..<to {
        let byte = text[at]
        let digit = match byte {
            b'0'..=b'9' => byte - b'0'
            b'a'..=b'f' => byte - b'a' + 10
            else => return None
        }
        value = value * 16 + u64.widen(digit)
    }
    return Some(value)
} hex_of

fn hex[N: usize where N > 0](mut written: text::Fixed[N], value: u64, digits: u32) {
    var shift = digits * 4
    while shift > 0 {
        shift -= 4
        let digit = u32.truncate((value >> shift) & 0xF)
        let code = match digit < 10 {
            true => 0x30 + digit
            false => 0x57 + digit
        }
        mut written.push(char.checked_from_bits(code).value_or('0'))
    }
} hex

fn decimal[N: usize where N > 0](mut written: text::Fixed[N], value: u64) {
    var digits = Array[u8, 20].filled(0)
    var count: usize = 0
    var rest = value
    loop {
        digits[count] = u8.truncate(rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 or count == 20 {
            break
        }
    }
    while count > 0 {
        count -= 1
        mut written.push(char.checked_from_bits(0x30 + u32.widen(digits[count])).value_or('0'))
    }
} decimal

/// A bridge above PCI functions: its segment, the buses below it, whether it is a bridge to conventional PCI, the DMA of whose functions reaches the IOMMU under its secondary bus, and whether the functions below it are external: its slot takes hot-plugged devices or the firmware marks it external-facing.
pub closed struct Bridge derives Copy, Eq {
    pub segment: u16
    pub secondary: u8
    pub subordinate: u8
    pub conventional: bool
    pub external: bool
} Bridge

/// Whether the function at `address` is external: below one of `bridges` whose functions are.
pub fn external(address: PciAddress, bridges: Slice[Bridge]) -> bool {
    for bridge in bridges {
        if bridge.external and bridge.segment == address.segment and address.bus >= bridge.secondary and address.bus <= bridge.subordinate {
            return true
        }
    }
    return false
} external

/// The IOMMU group of the function at `address` below `bridges`: the requester id its DMA reaches the IOMMU under, below its segment in the high 16 bits, which is function 0 of the secondary bus of the outermost bridge to conventional PCI above it, or else its own.
pub fn iommu_group(address: PciAddress, bridges: Slice[Bridge]) -> u32 {
    var requester = (u32.widen(address.bus) << 8) | (u32.widen(address.device) << 3) | u32.widen(address.function)
    var outermost: Option[Bridge] = None
    for bridge in bridges {
        if not bridge.conventional or bridge.segment != address.segment or address.bus < bridge.secondary or address.bus > bridge.subordinate {
            continue
        }
        match first outermost {
            Some(found) if found.secondary <= bridge.secondary => {
            }
            else => {
                outermost = Some(bridge)
            }
        }
    }
    match outermost {
        Some(bridge) => {
            requester = u32.widen(bridge.secondary) << 8
        }
        None => {
        }
    }
    return (u32.widen(address.segment) << 16) | requester
} iommu_group

test functions_below_a_bridge_to_conventional_pci_share_its_group for iommu_group {
    var bridges = Array[Bridge, 3].filled(Bridge(segment: 0, secondary: 0, subordinate: 0, conventional: false, external: false))
    bridges[0] = Bridge(segment: 0, secondary: 1, subordinate: 4, conventional: false, external: false)
    bridges[1] = Bridge(segment: 0, secondary: 2, subordinate: 4, conventional: true, external: false)
    bridges[2] = Bridge(segment: 0, secondary: 3, subordinate: 3, conventional: true, external: false)
    let behind = iommu_group(PciAddress(segment: 0, bus: 3, device: 4, function: 1), bridges: bridges.view())
    let beside = iommu_group(PciAddress(segment: 0, bus: 2, device: 0, function: 0), bridges: bridges.view())
    let express = iommu_group(PciAddress(segment: 0, bus: 1, device: 0, function: 0), bridges: bridges.view())
    let alone = iommu_group(PciAddress(segment: 1, bus: 0, device: 0x1F, function: 2), bridges: bridges.view())
    expect behind == 0x200 and beside == 0x200
    expect express == 0x100 and alone == 0x1_00FA
} functions_below_a_bridge_to_conventional_pci_share_its_group

test functions_below_an_external_bridge_are_external for external {
    var bridges = Array[Bridge, 2].filled(Bridge(segment: 0, secondary: 1, subordinate: 1, conventional: false, external: false))
    bridges[1] = Bridge(segment: 0, secondary: 2, subordinate: 5, conventional: false, external: true)
    expect external(PciAddress(segment: 0, bus: 4, device: 0, function: 0), bridges: bridges.view())
    expect not external(PciAddress(segment: 0, bus: 1, device: 0, function: 0), bridges: bridges.view())
    expect not external(PciAddress(segment: 1, bus: 4, device: 0, function: 0), bridges: bridges.view())
} functions_below_an_external_bridge_are_external
