//! The `devices` component: the records of the machine's devices, their bindings, and the driver instances it creates for them through its `Control`.

/// The keys of the keyed tasks: discovery, the wait for the topology to change, and per device those binding its driver, retiring it, resetting the device and following its driver's lifecycle, the device's key added.
const DISCOVERY: u64 = 1

const WATCHING: u64 = 2

const BINDING: u64 = 0x1_0000

const RETIRING: u64 = 0x5_0000

const RESETTING: u64 = 0x6_0000

const FOLLOWING: u64 = 0x7_0000

/// The reasons `device.cut-off` gives in its argument.
const CUT_ABANDONED: u64 = 0

const CUT_STOPPED: u64 = 1

const CUT_REMOVED: u64 = 2

const CUT_RESET: u64 = 3

/// The key of the keyed task recording the oldest event queued.
const EVENTS: u64 = 3

/// How long a driver has to run and reply `Healthy` once started.
const START_MS: u64 = 5_000

/// The record of a device at `/live/devices/<bus path>`.
pub closed struct LiveDevice derives Encode {
    pub path: BusPath
    pub ids: DeviceIds
    pub resources: mem::List[Resource]
    pub dma: Dma
    pub entry: Option[text::Fixed[20]]
    pub driver: Option[ident::Moniker]
    pub role: Option[os::Role]
    pub power: Power
    pub status: Status
    pub units: mem::List[UnitRecord]
} LiveDevice

/// The DMA confinement of a device's driver.
pub closed enum Dma derives Copy, Eq, Render, Encode {
    None
    Confined
    Unconfined
} Dma

pub closed enum Power derives Copy, Eq, Render, Encode {
    On
    Suspended
    Off
} Power

/// How far a device has reconciled with its binding.
pub closed enum Status derives Copy, Eq, Render, Encode {
    Pending
    Converged
    Failed(Code)
} Status

/// The codes of chapter 15 a device's status carries.
pub closed enum Code derives Copy, Eq, Render, Encode {
    DriverMismatch
    NoVectors
    StartTimeout
    Unhealthy
    DriverFailed
    ResetFailed
    Aml
} Code

/// The code's number, which a `device.failed` event carries as its argument.
pub fn Code.number(self) -> u64 {
    return match self {
        Code.DriverMismatch => 1
        Code.NoVectors => 2
        Code.StartTimeout => 3
        Code.Unhealthy => 4
        Code.DriverFailed => 5
        Code.ResetFailed => 6
        Code.Aml => 7
    }
} Code.number

/// A device's power policy: `auto` and `on` keep it on while a driver holds it, `off` keeps it off with no driver.
pub closed enum PowerPolicy derives Copy, Eq, Render, Encode {
    Auto
    On
    Off
} PowerPolicy

/// A device's binding: how its driver is chosen, and its power policy.
pub closed struct Binding derives Copy, Eq, Encode {
    pub driver: DriverChoice
    pub power: PowerPolicy
} Binding

/// Why an operation of `devices` fails, chapter 15's codes.
pub closed enum DevicesError derives Copy, Eq, Render, Encode {
    Unknown
    DriverMismatch
    NoDriver
} DevicesError

/// The operations of `devices`, and the messages its keyed tasks post.
pub protocol Devices {
    /// The number of devices bound to a driver, once every binding, volume read and view under way has settled, `boot-volume` is resolved and, once `fat` runs, `store-volume` placed.
    pub fn settled() -> u32 limits irreversible(emit, actuate, erase, spend)
    pub fn bind(device: BusPath, driver: text::String) fails DevicesError limits irreversible(emit, actuate, erase, spend)
    pub fn unbind(device: BusPath) fails DevicesError limits irreversible(emit, actuate, erase, spend)
    pub fn power(device: BusPath, policy: PowerPolicy) fails DevicesError limits irreversible(emit, actuate, erase, spend)
    pub fn reset(device: BusPath) fails DevicesError limits irreversible(emit, actuate, erase, spend)
    fn restarted(path: BusPath, cut: bool, lifecycle: Option[os::Lifecycle]) limits irreversible(emit, actuate, erase, spend)
    fn driver_changed(path: BusPath, moniker: ident::Moniker, from: Option[os::Lifecycle], to: os::Lifecycle) limits irreversible(emit, actuate, erase, spend)
    fn listed(found: mem::List[Found], failed: mem::List[BusPath], console: Option[u16]) limits irreversible(emit, actuate, erase, spend)
    fn bound(path: BusPath, moniker: ident::Moniker, lifecycle: Option[os::Lifecycle]) limits irreversible(emit, actuate, erase, spend)
    fn volumes(path: BusPath, units: mem::List[UnitRecord]) limits irreversible(emit, actuate, erase, spend)
    fn changed(generation: u64, found: mem::List[Found]) limits irreversible(emit, actuate, erase, spend)
    fn viewed(moniker: ident::Moniker, held: bool) limits irreversible(emit, actuate, erase, spend)
    fn stored(moniker: ident::Moniker, outcome: Stored) limits irreversible(emit, actuate, erase, spend)
    fn recorded() limits irreversible(emit, actuate, erase, spend)
} Devices

/// The Env of `devices`: the device root, a `Control` over the instances under `devices`, the bundle its drivers run, the boot volume the handoff record names, its clock, a port to `fat`, and its executor and cell.
pub closed struct Env {
    pub root: Root
    pub control: os::Control
    pub bundle: ident::HashValue
    pub boot: BootVolume
    pub clock: sys::Clock
    pub files: os::Port[Fat]
    pub exec: task::Executor
    pub alloc: mem::Alloc
} Env

/// The state of `devices`: each device's record, every bus path seen, whose position is its device's key, the bindings set, the volume views it created, the port of the UART the SPCR names, the drivers it assigned the class roles to, how many bindings, volume reads and views are under way, whether discovery has listed the devices and `boot-volume` is resolved, the `settled` requests waiting, and the events queued for recording, the oldest being recorded.
pub closed struct Manager derives Encode {
    pub records: mem::List[LiveDevice]
    pub paths: mem::List[BusPath]
    pub bindings: mem::Map[BusPath, Binding]
    pub views: mem::List[ViewRecord]
    pub console: Option[u16]
    pub holders: mem::Map[os::Role, ident::Moniker]
    pub store: Placement
    pub underway: u32
    pub discovered: bool
    pub boot_resolved: bool
    pub waiting: mem::List[u64]
    pub queued: mem::List[Event]
} Manager

impl Manager: sys::Component[Env, Devices]

impl Manager: sys::Resume[Env, Devices]

pub fn Manager.start(mut env: Env) -> Manager = Manager(records: mem::List.empty(env.alloc), paths: mem::List.empty(env.alloc), bindings: mem::Map.empty(env.alloc), views: mem::List.empty(env.alloc), console: None, holders: mem::Map.empty(env.alloc), store: Placement.Open, underway: 0, discovered: false, boot_resolved: false, waiting: mem::List.empty(env.alloc), queued: mem::List.empty(env.alloc))

/// Once started, lists the devices the keeper holds, the platform devices of the AML namespace declared first.
pub fn Manager.resume(mut self, reason: sys::ResumeReason, mut env: Env, mut cx: sys::Cx[Devices]) {
    let root = env.root
    let control = env.control
    let bundle = env.bundle
    let alloc = env.alloc
    mut cx.spawn(key: DISCOVERY, run: fn(out: sys::Outbox[Devices]) fails task::Cancelled uses wait limits stack 32_768 {
        let Discovered(found: found, failed: failed, console: console) = try await discover(root, control, bundle, alloc)
        discard attempt await out.listed(take found, take failed, console)
    })
} Manager.resume

/// Answers once every binding, volume read and view has settled and a try at placing `store-volume` has ended.
pub fn Manager.settled(mut self, mut env: Env, mut cx: sys::Cx[Devices]) -> u32 {
    let Some(request) = mut cx.postpone() else {
        return self.bound_count()
    }
    mut self.waiting.push(request)
    mut self.answer_settled(mut env, mut cx)
    return 0
} Manager.settled

/// The number of devices bound to a driver.
fn Manager.bound_count(self) -> u32 {
    var count: u32 = 0
    for record in self.records {
        if record.driver.is_some() and record.status == Status.Converged {
            count += 1
        }
    }
    return count
} Manager.bound_count

/// Records the devices discovery found and binds their drivers, then waits for the topology to change.
fn Manager.listed(
    mut self,
    take found: mem::List[Found],
    take failed: mem::List[BusPath],
    take console: Option[u16],
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) {
    self.console = console
    mut self.add(take found, failed, mut env, mut cx)
    self.discovered = true
    mut self.watch(seen: 0, mut env, mut cx)
    mut self.answer_settled(mut env, mut cx)
} Manager.listed

/// Removes the PCI devices the topology's generation `generation` no longer holds, records the devices it newly holds and binds their drivers, then waits for its next change.
fn Manager.changed(
    mut self,
    take generation: u64,
    take found: mem::List[Found],
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) {
    var at: usize = 0
    while at < self.records.len() {
        let path = self.records[at].path
        let held = match path {
            BusPath.Pci(_) => found_in(found, path)
            else => true
        }
        if held {
            at += 1
        } else {
            mut self.remove(at, mut env, mut cx)
        }
    }
    mut self.add(take found, failed: mem::List.empty(env.alloc), mut env, mut cx)
    mut self.watch(seen: generation, mut env, mut cx)
    mut self.answer_settled(mut env, mut cx)
} Manager.changed

/// Records each device of `found` not yet recorded and binds its driver, but for a platform device whose `_CRS` evaluation failed.
fn Manager.add(
    mut self,
    take found: mem::List[Found],
    failed: mem::List[BusPath],
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) {
    for each in take found {
        let Found(path: path, ids: ids, resources: resources, core: core) = each
        if self.index_of(path).is_some() {
            continue
        }
        mut self.records.push(LiveDevice(path: path, ids: ids, resources: take resources, dma: Dma.None, entry: None, driver: None, role: None, power: Power.Off, status: Status.Pending, units: mem::List.empty(env.alloc)))
        mut self.emit(env.root, kind: EventKind.Added, path, argument: 0, mut cx)
        let at = self.records.len() - 1
        if core {
            self.records[at].status = Status.Converged
            continue
        }
        if listed_in(failed, path) {
            mut self.mark_failed(at, code: Code.Aml, mut env, mut cx)
            continue
        }
        mut self.reconcile(at, mut env, mut cx)
    }
} Manager.add

/// Has a keyed task wait for the topology to pass the generation `seen` and list the devices it then holds.
fn Manager.watch(mut self, seen: u64, mut env: Env, mut cx: sys::Cx[Devices]) {
    let root = env.root
    let alloc = env.alloc
    mut cx.spawn(key: WATCHING, run: fn(out: sys::Outbox[Devices]) fails task::Cancelled uses wait limits stack 16_384 {
        let generation = match first attempt await root.changes(seen, alloc) {
            Ok(next) => next
            Err(RootError.Cancelled(cancelled)) => fail cancelled
            Err(_) => return
        }
        let found = match first attempt await root.devices(alloc) {
            Ok(listed) => listed
            Err(RootError.Cancelled(cancelled)) => fail cancelled
            Err(_) => return
        }
        discard attempt await out.changed(generation, take found)
    })
} Manager.watch

/// Deletes the record at `at` of a device that left, and has a keyed task delete its driver and the views over it, then cut it off.
fn Manager.remove(mut self, at: usize, mut env: Env, mut cx: sys::Cx[Devices]) {
    let path = self.records[at].path
    let monikers = mut self.detach(at, mut env, mut cx)
    discard mut self.records.remove(at)
    mut self.emit(env.root, kind: EventKind.Removed, path, argument: 0, mut cx)
    mut self.emit(env.root, kind: EventKind.CutOff, path, argument: CUT_REMOVED, mut cx)
    mut self.retire(path, take monikers, reset: false, unplugged: true, mut env, mut cx)
} Manager.remove

/// Takes the driver of the device at `at` and the views over it off its record, no longer following the driver, and gives the class roles it held to other devices: their monikers, the driver's last.
fn Manager.detach(mut self, at: usize, mut env: Env, mut cx: sys::Cx[Devices]) -> mem::List[ident::Moniker] {
    let alloc = env.alloc
    let path = self.records[at].path
    let key = mut self.key_of(path)
    mut cx.cancel(key: FOLLOWING + key)
    var monikers = mem::List[ident::Moniker].empty(alloc)
    var view: usize = 0
    while view < self.views.len() {
        if self.views[view].device == path {
            let gone = mut self.views.remove(view)
            mut monikers.push(ident::Moniker(text: gone.moniker.text))
        } else {
            view += 1
        }
    }
    match self.records[at].driver {
        Some(driver) => mut monikers.push(ident::Moniker(text: driver.text))
        None => {
        }
    }
    self.records[at].driver = None
    self.records[at].entry = None
    self.records[at].role = None
    self.records[at].power = Power.Off
    mut self.records[at].units.truncate(0)
    mut self.resolve_roles(mut env, mut cx)
    return monikers
} Manager.detach

/// Has a keyed task delete the instances `monikers`, as unplugged when `unplugged`, then cut the device at `path` off, resetting it when `reset`.
fn Manager.retire(
    mut self,
    path: BusPath,
    take monikers: mem::List[ident::Moniker],
    reset: bool,
    unplugged: bool,
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) {
    let root = env.root
    let control = env.control
    let alloc = env.alloc
    let key = mut self.key_of(path)
    mut cx.spawn(key: RETIRING + key, run: fn[take monikers](out: sys::Outbox[Devices]) fails task::Cancelled uses wait limits stack 16_384 {
        discard try await wind_down(control, root, monikers, path, reset, unplugged, alloc)
    })
} Manager.retire

/// Deletes the instances `monikers`, as unplugged when `unplugged`, then cuts the device at `path` off, resetting it when `reset`; whether its reset succeeded.
fn wind_down(
    control: os::Control,
    root: Root,
    monikers: mem::List[ident::Moniker],
    path: BusPath,
    reset: bool,
    unplugged: bool,
    alloc: mem::Alloc,
    ) -> bool fails task::Cancelled uses wait {
    for moniker in monikers {
        let deleted = match unplugged {
            true => attempt await control.unplug(ident::Moniker(text: moniker.text), alloc)
            false => attempt await control.delete(ident::Moniker(text: moniker.text), alloc)
        }
        match deleted {
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
    }
    return match first attempt await root.cut(path, reset, alloc) {
        Ok(done) => done
        Err(RootError.Cancelled(cancelled)) => fail cancelled
        Err(_) => false
    }
} wind_down

/// Brings the device at `at` to its binding: the driver the binding chooses, none under `unbound` or the policy `off`, a driver it no longer chooses retired and its device cut off first.
fn Manager.reconcile(mut self, at: usize, mut env: Env, mut cx: sys::Cx[Devices]) {
    let path = self.records[at].path
    let wanted_by = self.binding_of(path)
    let wanted = match wanted_by.power {
        PowerPolicy.Off => Choice.Unbound
        else => choose(self.records[at].ids, choice: wanted_by.driver, entries: drivers)
    }
    let current = self.records[at].entry
    let held = self.records[at].driver.is_some()
    match wanted {
        Choice.Bind(name) => {
            if held and current == Some(name) {
                return
            }
            let leaving = mut self.detach(at, mut env, mut cx)
            if held {
                mut self.emit(env.root, kind: EventKind.Unbound, path, argument: 0, mut cx)
                mut self.emit(env.root, kind: EventKind.CutOff, path, argument: CUT_STOPPED, mut cx)
            }
            mut self.attach(at, name, take leaving, mut env, mut cx)
        }
        Choice.Unbound or Choice.Mismatch => {
            match wanted {
                Choice.Mismatch => mut self.mark_failed(at, code: Code.DriverMismatch, mut env, mut cx)
                else => {
                    self.records[at].status = Status.Converged
                }
            }
            if not held {
                return
            }
            let leaving = mut self.detach(at, mut env, mut cx)
            mut self.emit(env.root, kind: EventKind.Unbound, path, argument: 0, mut cx)
            mut self.emit(env.root, kind: EventKind.CutOff, path, argument: CUT_STOPPED, mut cx)
            mut self.retire(path, monikers: take leaving, reset: true, unplugged: false, mut env, mut cx)
        }
    }
} Manager.reconcile

/// The binding of the device at `path`: the one set, else the defaults.
fn Manager.binding_of(self, path: BusPath) -> Binding {
    return match self.bindings.get(path) {
        Some(set) => set
        None => Binding(driver: DriverChoice.Automatic, power: PowerPolicy.Auto)
    }
} Manager.binding_of

/// Binds the device at `device` to the `drivers` entry `driver`.
pub fn Manager.bind(
    mut self,
    take device: BusPath,
    take driver: text::String,
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) fails DevicesError {
    let Some(at) = self.index_of(device) else {
        fail DevicesError.Unknown
    }
    if driver.as_str().byte_len() > 20 {
        fail DevicesError.DriverMismatch
    }
    let choice = DriverChoice.Entry(text::Fixed[20].of(driver.as_str()))
    if choose(self.records[at].ids, choice, entries: drivers) == Choice.Mismatch {
        fail DevicesError.DriverMismatch
    }
    let set = self.binding_of(device)
    discard mut self.bindings.insert(device, value: Binding(driver: choice, power: set.power))
    mut self.reconcile(at, mut env, mut cx)
} Manager.bind

/// Unbinds the device at `device`: no driver holds it.
pub fn Manager.unbind(mut self, take device: BusPath, mut env: Env, mut cx: sys::Cx[Devices]) fails DevicesError {
    let Some(at) = self.index_of(device) else {
        fail DevicesError.Unknown
    }
    let set = self.binding_of(device)
    discard mut self.bindings.insert(device, value: Binding(driver: DriverChoice.Unbound, power: set.power))
    mut self.reconcile(at, mut env, mut cx)
} Manager.unbind

/// Sets the power policy of the device at `device`.
pub fn Manager.power(
    mut self,
    take device: BusPath,
    take policy: PowerPolicy,
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) fails DevicesError {
    let Some(at) = self.index_of(device) else {
        fail DevicesError.Unknown
    }
    let set = self.binding_of(device)
    discard mut self.bindings.insert(device, value: Binding(driver: set.driver, power: policy))
    mut self.reconcile(at, mut env, mut cx)
} Manager.power

/// Resets the device at `device`: has a keyed task stop its driver, cut it off and reset it, then start the driver again.
pub fn Manager.reset(mut self, take device: BusPath, mut env: Env, mut cx: sys::Cx[Devices]) fails DevicesError {
    let Some(at) = self.index_of(device) else {
        fail DevicesError.Unknown
    }
    let Some(driver) = self.records[at].driver else {
        fail DevicesError.NoDriver
    }
    let moniker = ident::Moniker(text: driver.text)
    self.records[at].status = Status.Pending
    self.underway += 1
    mut self.emit(env.root, kind: EventKind.CutOff, path: device, argument: CUT_RESET, mut cx)
    let root = env.root
    let control = env.control
    let alloc = env.alloc
    let key = mut self.key_of(device)
    mut cx.spawn(key: RESETTING + key, run: fn[take moniker](out: sys::Outbox[Devices]) fails task::Cancelled uses wait limits stack 16_384 {
        match attempt await control.stop(ident::Moniker(text: moniker.text), alloc) {
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
        let cut = match first attempt await root.cut(device, reset: true, alloc) {
            Ok(done) => done
            Err(RootError.Cancelled(cancelled)) => fail cancelled
            Err(_) => false
        }
        var lifecycle: Option[os::Lifecycle] = None
        if cut {
            lifecycle = match first attempt await control.start(ident::Moniker(text: moniker.text), alloc) {
                Ok(started) => Some(started)
                Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
                Err(_) => None
            }
        }
        discard attempt await out.restarted(path: device, cut, lifecycle)
    })
} Manager.reset

/// Records how the device at `path` came back from its reset: `converged` once its driver runs again, `failed(device.reset-failed)` when the function did not respond; nothing once it lost its driver meanwhile.
fn Manager.restarted(
    mut self,
    take path: BusPath,
    take cut: bool,
    take lifecycle: Option[os::Lifecycle],
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) {
    self.underway = self.underway.saturating_sub(1)
    let Some(at) = self.index_of(path) else {
        mut self.answer_settled(mut env, mut cx)
        return
    }
    if self.records[at].driver.is_none() {
        mut self.answer_settled(mut env, mut cx)
        return
    }
    if lifecycle == Some(os::Lifecycle.Running) {
        self.records[at].status = Status.Converged
    } else if cut {
        mut self.mark_failed(at, code: Code.Unhealthy, mut env, mut cx)
    } else {
        mut self.mark_failed(at, code: Code.ResetFailed, mut env, mut cx)
    }
    mut self.answer_settled(mut env, mut cx)
} Manager.restarted

/// Gives the device at `at` the status `failed` with `code`, emitting `device.failed`.
fn Manager.mark_failed(
    mut self,
    at: usize,
    code: Code,
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) {
    self.records[at].status = Status.Failed(code)
    mut self.emit(env.root, kind: EventKind.Failed, path: self.records[at].path, argument: code.number(), mut cx)
} Manager.mark_failed

/// Has a keyed task follow the lifecycle of the driver `moniker` of the device at `path`, which runs, posting each change.
fn Manager.follow(
    mut self,
    path: BusPath,
    take moniker: ident::Moniker,
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) {
    let control = env.control
    let alloc = env.alloc
    let key = mut self.key_of(path)
    mut cx.spawn(key: FOLLOWING + key, run: fn[take moniker](out: sys::Outbox[Devices]) fails task::Cancelled uses wait limits stack 16_384 {
        var seen: Option[os::Lifecycle] = Some(os::Lifecycle.Running)
        loop {
            let now = match first attempt await control.changed(ident::Moniker(text: moniker.text), seen, alloc) {
                Ok(lifecycle) => lifecycle
                Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
                Err(_) => return
            }
            if (attempt await out.driver_changed(path, moniker: ident::Moniker(text: moniker.text), from: seen, to: now)).is_err() {
                return
            }
            seen = Some(now)
        }
    })
} Manager.follow

/// Records what a change of the lifecycle of the driver `moniker` of the device at `path` from `from` to `to` means: an abandonment cuts the device off, and a driver past its restart limit leaves it `failed(device.driver-failed)`.
fn Manager.driver_changed(
    mut self,
    take path: BusPath,
    take moniker: ident::Moniker,
    take from: Option[os::Lifecycle],
    take to: os::Lifecycle,
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) {
    let Some(at) = self.index_of(path) else {
        return
    }
    if self.records[at].driver != Some(ident::Moniker(text: moniker.text)) {
        return
    }
    if from == Some(os::Lifecycle.Running) and (to == os::Lifecycle.Starting or to == os::Lifecycle.Failed) {
        mut self.emit(env.root, kind: EventKind.CutOff, path, argument: CUT_ABANDONED, mut cx)
    }
    if to == os::Lifecycle.Failed {
        mut self.mark_failed(at, code: Code.DriverFailed, mut env, mut cx)
    }
} Manager.driver_changed

/// The key of the device at `path`: the position of `path` among the bus paths seen, which it joins when new.
fn Manager.key_of(mut self, path: BusPath) -> u64 {
    for at in 0..<self.paths.len() {
        if self.paths[at] == path {
            return u64.widen(at)
        }
    }
    mut self.paths.push(path)
    return u64.widen(self.paths.len() - 1)
} Manager.key_of

/// Has a keyed task retire the instances `leaving` and cut the device at `at` off when there are any, then create and start its driver of the entry `name`.
fn Manager.attach(
    mut self,
    at: usize,
    name: text::Fixed[20],
    take leaving: mem::List[ident::Moniker],
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) {
    let Some(entry) = entry_named(name) else {
        return
    }
    self.records[at].status = Status.Pending
    let moniker = self.moniker_for(name)
    self.records[at].entry = Some(name)
    self.records[at].driver = Some(ident::Moniker(text: moniker.text))
    self.records[at].dma = Dma.Unconfined
    self.underway += 1
    let path = self.records[at].path
    let control = env.control
    let clock = env.clock
    let alloc = env.alloc
    let spec = os::InstanceSpec.of(principal: ident::Principal(text: text::Fixed[64].of("system")), bundle: env.bundle, component: entry.component.as_str(), alloc)
    let key = mut self.key_of(path)
    let root = env.root
    mut cx.spawn(key: BINDING + key, run: fn[take moniker, take spec, take leaving](out: sys::Outbox[Devices]) fails task::Cancelled uses wait limits stack 16_384 {
        if leaving.len() > 0 {
            discard try await wind_down(control, root, monikers: leaving, path, reset: true, unplugged: false, alloc)
        }
        let lifecycle = try await start_driver(control, clock, moniker, take spec, path, alloc)
        discard attempt await out.bound(path, take moniker, lifecycle)
    })
} Manager.attach

/// Records how the driver of the device at `path` started: `converged` once it runs, else `failed`, its device cut off.
fn Manager.bound(
    mut self,
    take path: BusPath,
    take moniker: ident::Moniker,
    take lifecycle: Option[os::Lifecycle],
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) {
    self.underway = self.underway.saturating_sub(1)
    let Some(at) = self.index_of(path) else {
        mut self.answer_settled(mut env, mut cx)
        return
    }
    if self.records[at].driver != Some(ident::Moniker(text: moniker.text)) {
        mut self.answer_settled(mut env, mut cx)
        return
    }
    match lifecycle {
        Some(os::Lifecycle.Running) => {
            self.records[at].status = Status.Converged
            self.records[at].power = Power.On
            mut self.emit(env.root, kind: EventKind.Bound, path, argument: entry_index(self.records[at].entry), mut cx)
            mut self.follow(path, moniker: ident::Moniker(text: moniker.text), mut env, mut cx)
            mut self.serve_class(at, moniker, mut env, mut cx)
        }
        else => {
            let code = match lifecycle {
                None => Code.StartTimeout
                else => Code.Unhealthy
            }
            let leaving = mut self.detach(at, mut env, mut cx)
            mut self.mark_failed(at, code, mut env, mut cx)
            mut self.emit(env.root, kind: EventKind.CutOff, path, argument: CUT_STOPPED, mut cx)
            mut self.retire(path, monikers: take leaving, reset: true, unplugged: false, mut env, mut cx)
        }
    }
    mut self.answer_settled(mut env, mut cx)
} Manager.bound

/// What a bound driver's device protocol brings: a block device's units are read, and a device of a role class holds it when no other does.
fn Manager.serve_class(
    mut self,
    at: usize,
    moniker: ident::Moniker,
    mut env: Env,
    mut cx: sys::Cx[Devices],
    ) {
    let Some(name) = self.records[at].entry else {
        return
    }
    let Some(entry) = entry_named(name) else {
        return
    }
    match entry.class {
        Class.Block => mut self.read_volumes(at, moniker, mut env, mut cx)
        Class.Entropy or Class.Rtc or Class.Console => mut self.resolve_roles(mut env, mut cx)
    }
} Manager.serve_class

/// Answers the waiting `settled` requests once discovery is done, no binding, volume read or view is under way, `boot-volume` has its view, and a try at placing `store-volume` has ended.
fn Manager.answer_settled(mut self, mut env: Env, mut cx: sys::Cx[Devices]) {
    if not self.discovered or self.underway > 0 {
        return
    }
    if mut self.resolve_boot(mut env, mut cx) {
        return
    }
    if self.waiting.len() > 0 and self.store == Placement.Open {
        mut self.place_store(mut env, mut cx)
        if self.store == Placement.Placing {
            return
        }
    }
    let alloc = env.alloc
    let count: Result[u32, Never] = Ok(self.bound_count())
    for request in self.waiting {
        var reply = sys::Encoded.empty(alloc)
        mem::wire::Codec[Result[u32, Never]].encode(count, out: mut reply.bytes)
        discard attempt mut cx.reply(request, reply)
    }
    mut self.waiting.truncate(0)
    if self.store == Placement.Tried {
        self.store = Placement.Open
    }
} Manager.answer_settled

/// The index in the `drivers` registry of the entry `name`, 0 without one.
fn entry_index(name: Option[text::Fixed[20]]) -> u64 {
    let Some(wanted) = name else {
        return 0
    }
    for at in 0..<drivers.len() {
        if drivers[at].name == wanted {
            return u64.widen(at)
        }
    }
    return 0
} entry_index

fn found_in(found: mem::List[Found], path: BusPath) -> bool {
    for each in found {
        if each.path == path {
            return true
        }
    }
    return false
} found_in

fn listed_in(paths: mem::List[BusPath], path: BusPath) -> bool {
    for each in paths {
        if each == path {
            return true
        }
    }
    return false
} listed_in

/// The index of the record of the device at `path`.
fn Manager.index_of(self, path: BusPath) -> Option[usize] {
    for at in 0..<self.records.len() {
        if self.records[at].path == path {
            return Some(at)
        }
    }
    return None
} Manager.index_of

/// `devices.<name><n>`, n the lowest index no driver of the entry `name` has.
fn Manager.moniker_for(self, name: text::Fixed[20]) -> ident::Moniker {
    var index: u64 = 0
    loop {
        let candidate = driver_moniker(name, index)
        var taken = false
        for record in self.records {
            match record.driver {
                Some(driver) => {
                    if driver == candidate {
                        taken = true
                    }
                }
                None => {
                }
            }
        }
        if not taken {
            return candidate
        }
        index += 1
    }
} Manager.moniker_for

fn driver_moniker(name: text::Fixed[20], index: u64) -> ident::Moniker {
    var text = text::Fixed[59].of("devices.")
    mut text.append(name.as_str())
    decimal(mut text, value: index)
    return ident::Moniker(text: text)
} driver_moniker

/// The `drivers` entry `name`.
fn entry_named(name: text::Fixed[20]) -> Option[Registration] {
    for entry in drivers {
        if entry.name == name {
            return Some(entry)
        }
    }
    return None
} entry_named

/// Creates the driver `moniker` under `spec` with a `Clock` grant and a `Device` grant on `path`, and starts it: its lifecycle once it settles, `None` when it does not within `START_MS`.
fn start_driver(
    control: os::Control,
    clock: sys::Clock,
    moniker: ident::Moniker,
    take spec: os::InstanceSpec,
    path: BusPath,
    alloc: mem::Alloc,
    ) -> Option[os::Lifecycle] fails task::Cancelled uses wait {
    var grants = mem::Map[text::String, os::Grant].empty(alloc)
    discard mut grants.insert(text::String.of("clock", alloc), value: os::Grant(holder: holder_of(moniker), object: os::Object.Clock, rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: None, granted_by: ident::CommitId(number: 1)))
    discard mut grants.insert(text::String.of("device", alloc), value: os::Grant(holder: holder_of(moniker), object: os::Object.Device(path: text::String.of(path.text().as_str(), alloc)), rights: mem::Set.empty(alloc), caveats: os::Caveats.none(), parent: None, granted_by: ident::CommitId(number: 1)))
    match first attempt await control.create(ident::Moniker(text: moniker.text), take spec, take grants, alloc) {
        Ok(_) => {
        }
        Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
        Err(_) => return Some(os::Lifecycle.Failed)
    }
    let started = try await task::within(clock, ms: START_MS, body: fn() -> Result[os::Lifecycle, os::ControlError] fails task::Cancelled uses wait limits stack 8_192 {
        return match first attempt await control.start(ident::Moniker(text: moniker.text), alloc) {
            Err(os::ControlError.Cancelled(cancelled)) => fail cancelled
            other => other
        }
    })
    return match started {
        Some(Ok(lifecycle)) => Some(lifecycle)
        Some(Err(_)) => Some(os::Lifecycle.Failed)
        None => None
    }
} start_driver

/// The principal `inst.<moniker>` an instance's grants are held by.
fn holder_of(moniker: ident::Moniker) -> ident::Principal {
    var name = text::Fixed[64].of("inst.")
    mut name.append(moniker.text.as_str())
    return ident::Principal(text: name)
} holder_of

/// Queues a device event, which a keyed task records through the root once the events queued before it are.
fn Manager.emit(
    mut self,
    root: Root,
    kind: EventKind,
    path: BusPath,
    argument: u64,
    mut cx: sys::Cx[Devices],
    ) {
    mut self.queued.push(Event(kind: kind, path: path, argument: argument))
    if self.queued.len() == 1 {
        self.record_oldest(root, mut cx)
    }
} Manager.emit

/// Has the keyed task of `EVENTS` record the oldest event queued through the root.
fn Manager.record_oldest(self, root: Root, mut cx: sys::Cx[Devices]) {
    let event = self.queued[0]
    mut cx.spawn(key: EVENTS, run: fn(out: sys::Outbox[Devices]) fails task::Cancelled uses wait limits stack 8_192 {
        match attempt await root.emit(event) {
            Err(RootError.Cancelled(cancelled)) => fail cancelled
            else => {
            }
        }
        discard attempt await out.recorded()
    })
} Manager.record_oldest

/// Drops the event recorded, then has the next one recorded.
fn Manager.recorded(mut self, mut env: Env, mut cx: sys::Cx[Devices]) {
    discard mut self.queued.remove(0)
    if self.queued.len() > 0 {
        self.record_oldest(env.root, mut cx)
    }
} Manager.recorded
