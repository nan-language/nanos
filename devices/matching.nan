//! Driver matching: the identifiers of devices, the `drivers` registry of the entries driving them, and the choice of a device's driver.

/// What identifies a device: a PCI function's identifiers and 24-bit class code, or an ACPI device's `_HID`, `_CID`s and `_UID`.
pub closed enum DeviceIds derives Copy, Eq, Encode {
    Pci(vendor: u16, device: u16, subsystem_vendor: u16, subsystem: u16, class: u32, revision: u8)
    Acpi(hid: text::Fixed[8], cids: Array[text::Fixed[8], 4], uid: u32)
} DeviceIds

/// What a `drivers` entry drives, from most to least specific; `None` pads an entry's list.
pub closed enum DeviceMatch derives Copy, Eq {
    None
    PciSubsystem(vendor: u16, device: u16, subsystem_vendor: u16, subsystem: u16)
    PciDevice(vendor: u16, device: u16)
    PciClass(class: u32, mask: u32)
    AcpiId(u64)
} DeviceMatch

/// The matches of an entry: at most four.
pub fn matches(head: DeviceMatch, rest: DeviceMatch) -> Array[DeviceMatch, 4] limits pure {
    var listed = Array[DeviceMatch, 4].filled(DeviceMatch.None)
    listed[0] = head
    listed[1] = rest
    return listed
} matches

/// An entry of the `drivers` registry: its name, the devices it drives, the device protocol its instances serve, the canonical path of their component, and its tie-break among equally specific matches, higher first.
pub closed view struct Registration {
    pub name: Str
    pub matches: Array[DeviceMatch, 4]
    pub class: Class
    pub component: Str
    pub priority: u8
} Registration

/// A `drivers` entry as matching compares it.
pub closed struct Candidate derives Copy, Eq {
    pub name: text::Fixed[20]
    pub matches: Array[DeviceMatch, 4]
    pub class: Class
    pub component: text::Fixed[48]
    pub priority: u8
} Candidate

/// The entries of the `drivers` registry.
pub fn candidates(alloc: mem::Alloc) -> mem::List[Candidate] {
    var listed = mem::List[Candidate].empty(alloc)
    for entry in drivers {
        mut listed.push(Candidate(name: text::Fixed[20].of(entry.name), matches: entry.matches, class: entry.class, component: text::Fixed[48].of(entry.component), priority: entry.priority))
    }
    return listed
} candidates

pub registry drivers: Registration keyed by name

/// How a device's binding chooses its driver: the most specific matching entry, none, or the entry it names.
pub closed enum DriverChoice derives Copy, Eq, Encode {
    Automatic
    Unbound
    Entry(text::Fixed[20])
} DriverChoice

/// How specifically the match fits `ids`, higher being more specific, 0 when it does not.
pub fn DeviceMatch.rank(self, ids: DeviceIds) -> u8 {
    return match ids {
        DeviceIds.Pci(vendor: vendor, device: device, subsystem_vendor: subsystem_vendor, subsystem: subsystem, class: class, revision: _) => match self {
            DeviceMatch.PciSubsystem(vendor: v, device: d, subsystem_vendor: sv, subsystem: ss) => ranked(v == vendor and d == device and sv == subsystem_vendor and ss == subsystem, rank: 5)
            DeviceMatch.PciDevice(vendor: v, device: d) => ranked(v == vendor and d == device, rank: 4)
            DeviceMatch.PciClass(class: wanted, mask: mask) => ranked((class & mask) == (wanted & mask), rank: 3)
            else => 0
        }
        DeviceIds.Acpi(hid: hid, cids: cids, uid: _) => match self {
            DeviceMatch.AcpiId(id) => acpi_rank(id, hid, cids)
            else => 0
        }
    }
} DeviceMatch.rank

fn ranked(holds: bool, rank: u8) -> u8 {
    if holds {
        return rank
    }
    return 0
} ranked

/// An `_HID` match above a `_CID` match.
fn acpi_rank(id: u64, hid: text::Fixed[8], cids: Array[text::Fixed[8], 4]) -> u8 {
    if packed(hid.as_bytes()) == id {
        return 2
    }
    for cid in cids {
        if cid.byte_len() > 0 and packed(cid.as_bytes()) == id {
            return 1
        }
    }
    return 0
} acpi_rank

/// An ACPI identifier of at most eight characters as a match holds it: its bytes, little-endian.
pub fn acpi_id(name: Str) -> u64 limits pure {
    return packed(name.as_bytes())
} acpi_id

fn packed(bytes: Slice[u8]) -> u64 limits pure {
    var id: u64 = 0
    var at: usize = 0
    for byte in bytes {
        if at < 8 {
            id = id | (u64.widen(byte) << u32.fit(8 * at))
        }
        at += 1
    }
    return id
} packed

/// How specifically an entry matches `ids`: its best match, 0 when none matches.
pub fn Candidate.rank(self, ids: DeviceIds) -> u8 {
    var best: u8 = 0
    for wanted in self.matches {
        let rank = wanted.rank(ids)
        if rank > best {
            best = rank
        }
    }
    return best
} Candidate.rank

/// The outcome of choosing a device's driver.
pub closed enum Choice derives Copy, Eq {
    Bind(text::Fixed[20])
    Unbound
    Mismatch
} Choice

/// The driver `choice` gives a device identified by `ids` among `entries`: the entry a binding names when it matches, else the most specific match, ties going to the higher priority, then to the lower name.
pub fn choose(ids: DeviceIds, choice: DriverChoice, entries: Slice[Candidate]) -> Choice {
    match choice {
        DriverChoice.Unbound => return Choice.Unbound
        DriverChoice.Entry(name) => {
            for entry in entries {
                if entry.name == name and entry.rank(ids) > 0 {
                    return Choice.Bind(name)
                }
            }
            return Choice.Mismatch
        }
        DriverChoice.Automatic => {
        }
    }
    var best: Option[Candidate] = None
    for entry in entries {
        let rank = entry.rank(ids)
        if rank == 0 {
            continue
        }
        let better = match best {
            None => true
            Some(held) => rank > held.rank(ids) or (rank == held.rank(ids) and (entry.priority > held.priority or (entry.priority == held.priority and entry.name < held.name)))
        }
        if better {
            best = Some(entry)
        }
    }
    return match best {
        Some(entry) => Choice.Bind(entry.name)
        None => Choice.Unbound
    }
} choose
