//! Driver matching: the identifiers of devices, the `drivers` registry of the entries driving them, and the choice of a device's driver.

/// What identifies a device: a PCI function's identifiers and 24-bit class code, or an ACPI device's `_HID`, `_CID`s and `_UID`.
pub closed enum DeviceIds derives Copy, Eq, Encode {
    Pci(vendor: u16, device: u16, subsystem_vendor: u16, subsystem: u16, class: u32, revision: u8)
    Acpi(hid: text::Fixed[8], cids: Array[text::Fixed[8], 4], uid: u32)
} DeviceIds

/// What a `drivers` entry drives, from most to least specific; `None` pads an entry's list.
pub closed enum DeviceMatch derives Copy, Eq {
    None
    PciSubsystem(vendor: u16, device: u16, subsystem_vendor: u16, subsystem: u16)
    PciDevice(vendor: u16, device: u16)
    PciClass(class: u32, mask: u32)
    AcpiId(text::Fixed[8])
} DeviceMatch

/// The matches of an entry: at most four.
pub fn matches(head: DeviceMatch, rest: DeviceMatch) -> Array[DeviceMatch, 4] limits pure {
    var listed = Array[DeviceMatch, 4].filled(DeviceMatch.None)
    listed[0] = head
    listed[1] = rest
    return listed
} matches

/// An entry of the `drivers` registry: its name, the devices it drives, the device protocol its instances serve, the canonical path of their component, and its tie-break among equally specific matches, higher first.
pub closed struct Registration derives Copy, Eq {
    pub name: text::Fixed[20]
    pub matches: Array[DeviceMatch, 4]
    pub class: Class
    pub component: text::Fixed[48]
    pub priority: u8
} Registration

pub registry drivers: Registration keyed by name

/// How a device's binding chooses its driver: the most specific matching entry, none, or the entry it names.
pub closed enum DriverChoice derives Copy, Eq, Encode {
    Automatic
    Unbound
    Entry(text::Fixed[20])
} DriverChoice

/// How specifically the match fits `ids`, higher being more specific, 0 when it does not.
pub fn DeviceMatch.rank(self, ids: DeviceIds) -> u8 {
    return match ids {
        DeviceIds.Pci(vendor: vendor, device: device, subsystem_vendor: subsystem_vendor, subsystem: subsystem, class: class, revision: _) => match self {
            DeviceMatch.PciSubsystem(vendor: v, device: d, subsystem_vendor: sv, subsystem: ss) => ranked(v == vendor and d == device and sv == subsystem_vendor and ss == subsystem, rank: 5)
            DeviceMatch.PciDevice(vendor: v, device: d) => ranked(v == vendor and d == device, rank: 4)
            DeviceMatch.PciClass(class: wanted, mask: mask) => ranked((class & mask) == (wanted & mask), rank: 3)
            else => 0
        }
        DeviceIds.Acpi(hid: hid, cids: cids, uid: _) => match self {
            DeviceMatch.AcpiId(id) => acpi_rank(id, hid, cids)
            else => 0
        }
    }
} DeviceMatch.rank

fn ranked(holds: bool, rank: u8) -> u8 {
    if holds {
        return rank
    }
    return 0
} ranked

/// An `_HID` match above a `_CID` match.
fn acpi_rank(id: text::Fixed[8], hid: text::Fixed[8], cids: Array[text::Fixed[8], 4]) -> u8 {
    if hid == id {
        return 2
    }
    for cid in cids {
        if cid.byte_len() > 0 and cid == id {
            return 1
        }
    }
    return 0
} acpi_rank

/// How specifically an entry matches `ids`: its best match, 0 when none matches.
pub fn Registration.rank(self, ids: DeviceIds) -> u8 {
    var best: u8 = 0
    for wanted in self.matches {
        let rank = wanted.rank(ids)
        if rank > best {
            best = rank
        }
    }
    return best
} Registration.rank

/// The outcome of choosing a device's driver.
pub closed enum Choice derives Copy, Eq {
    Bind(text::Fixed[20])
    Unbound
    Mismatch
} Choice

/// The driver `choice` gives a device identified by `ids` among `entries`: the entry a binding names when it matches, else the most specific match, ties going to the higher priority, then to the lower name.
pub fn choose(ids: DeviceIds, choice: DriverChoice, entries: Slice[Registration]) -> Choice {
    match choice {
        DriverChoice.Unbound => return Choice.Unbound
        DriverChoice.Entry(name) => {
            for entry in entries {
                if entry.name == name and entry.rank(ids) > 0 {
                    return Choice.Bind(name)
                }
            }
            return Choice.Mismatch
        }
        DriverChoice.Automatic => {
        }
    }
    var best: Option[Registration] = None
    for entry in entries {
        let rank = entry.rank(ids)
        if rank == 0 {
            continue
        }
        let better = match best {
            None => true
            Some(held) => rank > held.rank(ids) or (rank == held.rank(ids) and (entry.priority > held.priority or (entry.priority == held.priority and entry.name < held.name)))
        }
        if better {
            best = Some(entry)
        }
    }
    return match best {
        Some(entry) => Choice.Bind(entry.name)
        None => Choice.Unbound
    }
} choose

fn registration(name: Str, head: DeviceMatch, priority: u8) -> Registration {
    return Registration(name: text::Fixed[20].of(name), matches: matches(head, rest: DeviceMatch.None), class: Class.Block, component: text::Fixed[48].of("drivers::probe::Probe"), priority: priority)
} registration

fn bound(choice: Choice) -> text::Fixed[20] {
    return match choice {
        Choice.Bind(name) => name
        Choice.Unbound => text::Fixed[20].of("unbound")
        Choice.Mismatch => text::Fixed[20].of("mismatch")
    }
} bound

/// A virtio disk among entries matching its class, its identifiers at two priorities and under two names, and a 16550 by `_HID` or `_CID`.
test the_most_specific_entry_drives_a_device for choose {
    let world = testing::world()
    var entries = mem::List[Registration].empty(world.alloc)
    mut entries.push(registration("class", head: DeviceMatch.PciClass(class: 0x01_0000, mask: 0xFF_0000), priority: 9))
    mut entries.push(registration("plain", head: DeviceMatch.PciDevice(vendor: 0x1AF4, device: 0x1042), priority: 0))
    mut entries.push(registration("raised", head: DeviceMatch.PciDevice(vendor: 0x1AF4, device: 0x1042), priority: 1))
    mut entries.push(registration("also-raised", head: DeviceMatch.PciDevice(vendor: 0x1AF4, device: 0x1042), priority: 1))
    mut entries.push(registration("by-cid", head: DeviceMatch.AcpiId(text::Fixed[8].of("PNP0500")), priority: 9))
    mut entries.push(registration("by-hid", head: DeviceMatch.AcpiId(text::Fixed[8].of("PNP0501")), priority: 0))
    let disk = DeviceIds.Pci(vendor: 0x1AF4, device: 0x1042, subsystem_vendor: 0x1AF4, subsystem: 2, class: 0x01_0000, revision: 1)
    var cids = Array[text::Fixed[8], 4].filled(text::Fixed[8].empty())
    cids[0] = text::Fixed[8].of("PNP0500")
    let uart = DeviceIds.Acpi(hid: text::Fixed[8].of("PNP0501"), cids: cids, uid: 1)
    let other = DeviceIds.Pci(vendor: 0x8086, device: 0x1234, subsystem_vendor: 0, subsystem: 0, class: 0x02_0000, revision: 0)
    let named = text::Fixed[20].of("class")
    expect bound(choose(disk, choice: DriverChoice.Automatic, entries: entries.view())).as_str() == "also-raised"
    expect bound(choose(disk, choice: DriverChoice.Entry(named), entries: entries.view())).as_str() == "class"
    expect bound(choose(disk, choice: DriverChoice.Entry(text::Fixed[20].of("by-hid")), entries: entries.view())).as_str() == "mismatch"
    expect bound(choose(disk, choice: DriverChoice.Unbound, entries: entries.view())).as_str() == "unbound"
    expect bound(choose(uart, choice: DriverChoice.Automatic, entries: entries.view())).as_str() == "by-hid"
    expect bound(choose(other, choice: DriverChoice.Automatic, entries: entries.view())).as_str() == "unbound"
} the_most_specific_entry_drives_a_device
