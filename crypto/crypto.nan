//! The ciphers of NaN OS: XChaCha20-Poly1305 sealing and BLAKE3 key derivation, computing on secret values in constant time.

/// A 256-bit secret key.
pub closed struct Key {
    pub bytes: Array[core::Secret[u8], 32]
} Key

/// The key holding `bytes`.
pub fn Key.of(bytes: Array[u8, 32]) -> Key {
    var held = Array[core::Secret[u8], 32].filled(core::Secret.of(0u8))
    for at in 0..<32usize {
        held[at] = core::Secret.of(bytes[at])
    }
    return Key(bytes: held)
} Key.of

/// The XChaCha20-Poly1305 sealing of `plain` under `key` and the 192-bit nonce `nonce`: its ciphertext, then the 16-byte tag over `aad` and the ciphertext.
pub fn seal(
    key: Key,
    nonce: Array[u8, 24],
    aad: Slice[u8],
    plain: Slice[u8],
    alloc: mem::Alloc,
    ) -> mem::Bytes {
    let stream = Stream.of(key, nonce)
    var sealed = stream.xored(plain, alloc)
    let tag = stream.tag(aad, ciphertext: sealed.view(), alloc)
    mut sealed.append(tag.view())
    return sealed
} seal

/// The plaintext of `sealed`, a sealing under `key` and `nonce` whose tag covers `aad`; `None` when its tag differs.
pub fn open(
    key: Key,
    nonce: Array[u8, 24],
    aad: Slice[u8],
    sealed: Slice[u8],
    alloc: mem::Alloc,
    ) -> Option[mem::Bytes] {
    let Some(parts) = sealed.split_at(sealed.len().saturating_sub(16)) else {
        return None
    }
    if parts.tail.len() != 16 {
        return None
    }
    let stream = Stream.of(key, nonce)
    let tag = stream.tag(aad, ciphertext: parts.head, alloc)
    var differs: u8 = 0
    for at in 0..<16usize {
        differs = differs | (tag[at] ^ parts.tail[at])
    }
    if differs != 0 {
        return None
    }
    return Some(stream.xored(parts.head, alloc))
} open

/// The XChaCha20 stream of a key and a nonce: the subkey HChaCha20 derives and the nonce's last eight bytes.
struct Stream derives Copy {
    subkey: Array[core::Secret[u32], 8]
    tail: Array[core::Secret[u32], 3]
} Stream

fn Stream.of(key: Key, nonce: Array[u8, 24]) -> Stream {
    var head = Array[core::Secret[u32], 4].filled(core::Secret.of(0u32))
    for at in 0..<4usize {
        head[at] = core::Secret.of(nonce.view().u32_le(4 * at))
    }
    var tail = Array[core::Secret[u32], 3].filled(core::Secret.of(0u32))
    tail[1] = core::Secret.of(nonce.view().u32_le(16))
    tail[2] = core::Secret.of(nonce.view().u32_le(20))
    return Stream(subkey: hchacha(key.words(), nonce: head), tail: tail)
} Stream.of

/// `data` XORed with the stream from block 1.
fn Stream.xored(self, data: Slice[u8], alloc: mem::Alloc) -> mem::Bytes {
    var out = mem::Bytes.empty(alloc)
    var counter: u32 = 1
    var at: usize = 0
    while at < data.len() {
        let words = block(self.subkey, counter, nonce: self.tail)
        var index: usize = 0
        while index < 64 and at + index < data.len() {
            let keyed = byte_of(words.words[index / 4], index: index % 4)
            mut out.push(keyed.bit_xor(core::Secret.of(data[at + index])).reveal())
            index += 1
        }
        at += 64
        counter += 1
    }
    return out
} Stream.xored

/// The Poly1305 tag, under the key of block 0, over `aad` and `ciphertext`, each padded to 16 bytes, and their lengths.
fn Stream.tag(self, aad: Slice[u8], ciphertext: Slice[u8], alloc: mem::Alloc) -> Array[u8, 16] {
    var mac = Mac.of(block(self.subkey, counter: 0, nonce: self.tail))
    var data = mem::Bytes.empty(alloc)
    mut data.append(aad)
    padded(mut data)
    mut data.append(ciphertext)
    padded(mut data)
    push_u64_le(mut data, value: u64.widen(aad.len()))
    push_u64_le(mut data, value: u64.widen(ciphertext.len()))
    var offset: usize = 0
    while offset < data.len() {
        mut mac.absorb(data.view(), at: offset)
        offset += 16
    }
    return mac.tag()
} Stream.tag

/// The key's eight little-endian words.
fn Key.words(self) -> Array[core::Secret[u32], 8] {
    var words = Array[core::Secret[u32], 8].filled(core::Secret.of(0u32))
    for at in 0..<8usize {
        words[at] = word_le(self.bytes.view(), at: 4 * at)
    }
    return words
} Key.words

fn push_u64_le(mut data: mem::Bytes, value: u64) {
    for at in 0..<8u32 {
        mut data.push(u8.truncate(value >> (8 * at)))
    }
} push_u64_le

/// Pads `data` with zero bytes to a multiple of 16.
fn padded(mut data: mem::Bytes) {
    while data.len() % 16 != 0 {
        mut data.push(0)
    }
} padded

test sealing_follows_the_xchacha_draft for seal {
    let alloc = testing::world().alloc
    var key = Array[u8, 32].filled(0)
    var nonce = Array[u8, 24].filled(0)
    for at in 0..<32usize {
        key[at] = u8.truncate(0x80 + at)
    }
    for at in 0..<24usize {
        nonce[at] = u8.truncate(0x40 + at)
    }
    let aad = b"\x50\x51\x52\x53\xC0\xC1\xC2\xC3\xC4\xC5\xC6\xC7"
    let sealed = seal(Key.of(key), nonce, aad, plain: b"Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.", alloc)
    let bytes = sealed.view()
    expect sealed.len() == 130 and bytes[0] == 0xBD and bytes[1] == 0x6D and bytes[15] == 0x39 and bytes[114] == 0xC0 and bytes[115] == 0x87 and bytes[129] == 0x49
} sealing_follows_the_xchacha_draft

test sealing_short_and_empty_values for seal {
    let alloc = testing::world().alloc
    var key = Array[u8, 32].filled(0)
    var nonce = Array[u8, 24].filled(0)
    for at in 0..<32usize {
        key[at] = u8.truncate(at)
    }
    for at in 0..<24usize {
        nonce[at] = u8.truncate(at)
    }
    let short = seal(Key.of(key), nonce, aad: b"ab", plain: b"hello", alloc)
    let empty = seal(Key.of(key), nonce, aad: b"", plain: b"", alloc)
    let held = short.view()
    let tag = empty.view()
    expect short.len() == 21 and held[0] == 0xF6 and held[4] == 0xFF and held[5] == 0xE9 and held[20] == 0xA4
    expect empty.len() == 16 and tag[0] == 0x2D and tag[15] == 0x90
} sealing_short_and_empty_values

test opening_checks_the_tag for open {
    let alloc = testing::world().alloc
    let key = Key.of(Array[u8, 32].filled(7))
    let nonce = Array[u8, 24].filled(9)
    let sealed = seal(key, nonce, aad: b"keys", plain: b"a secret worth keeping", alloc)
    let opened = open(key, nonce, aad: b"keys", sealed: sealed.view(), alloc)
    expect opened.is_some()
    let Some(plain) = opened else {
        return
    }
    expect plain.view() == b"a secret worth keeping"
    var tampered = mem::Bytes.empty(alloc)
    mut tampered.append(sealed.view())
    tampered[0] = tampered[0] ^ 1
    let refused = open(key, nonce, aad: b"keys", sealed: tampered.view(), alloc)
    let other = open(key, nonce, aad: b"other", sealed: sealed.view(), alloc)
    let short = open(key, nonce, aad: b"", sealed: b"short", alloc)
    expect refused.is_none() and other.is_none() and short.is_none()
} opening_checks_the_tag
