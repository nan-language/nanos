//! BLAKE3 in key-derivation mode over at most one chunk of key material, on secret words.

const CHUNK_START: u32 = 1

const CHUNK_END: u32 = 2

const ROOT: u32 = 8

const DERIVE_KEY_CONTEXT: u32 = 32

const DERIVE_KEY_MATERIAL: u32 = 64

/// The bytes of a block and of a chunk.
const BLOCK_BYTES: usize = 64

const CHUNK_BYTES: usize = 1_024

/// The key BLAKE3 derives from `material`, of at most 1,024 bytes, under the context string `context`, of at most 1,024 bytes too.
pub fn derive_key(context: Str, material: Slice[core::Secret[u8]], alloc: mem::Alloc) -> Key {
    var named = mem::List[core::Secret[u8]].empty(alloc)
    for byte in context.as_bytes() {
        mut named.push(core::Secret.of(byte))
    }
    let context_key = chunk_value(start_words(), bytes: named.view(), flags: DERIVE_KEY_CONTEXT)
    let derived = chunk_value(context_key, bytes: material, flags: DERIVE_KEY_MATERIAL)
    var bytes = Array[core::Secret[u8], 32].filled(core::Secret.of(0u8))
    for at in 0..<32usize {
        bytes[at] = byte_of(derived[at / 4], index: at % 4)
    }
    return Key(bytes: bytes)
} derive_key

/// BLAKE3's initial words.
fn start_words() -> Array[core::Secret[u32], 8] {
    var words = Array[core::Secret[u32], 8].filled(core::Secret.of(0u32))
    words[0] = core::Secret.of(0x6A09_E667u32)
    words[1] = core::Secret.of(0xBB67_AE85u32)
    words[2] = core::Secret.of(0x3C6E_F372u32)
    words[3] = core::Secret.of(0xA54F_F53Au32)
    words[4] = core::Secret.of(0x510E_527Fu32)
    words[5] = core::Secret.of(0x9B05_688Cu32)
    words[6] = core::Secret.of(0x1F83_D9ABu32)
    words[7] = core::Secret.of(0x5BE0_CD19u32)
    return words
} start_words

/// The root output's first 32 bytes, as words, of the single chunk `bytes` hashed under `key` with the mode flags `flags`.
fn chunk_value(key: Array[core::Secret[u32], 8], bytes: Slice[core::Secret[u8]], flags: u32) -> Array[core::Secret[u32], 8] {
    expect bytes.len() <= CHUNK_BYTES
    var value = key
    var blocks = (bytes.len() + BLOCK_BYTES - 1) / BLOCK_BYTES
    if blocks == 0 {
        blocks = 1
    }
    for index in 0..<blocks {
        let start = index * BLOCK_BYTES
        var length = bytes.len() - start
        if length > BLOCK_BYTES {
            length = BLOCK_BYTES
        }
        var words = Array[core::Secret[u32], 16].filled(core::Secret.of(0u32))
        for at in 0..<length {
            let byte = core::Secret[u32].widen(bytes[start + at])
            words[at / 4] = words[at / 4].bit_or(byte.shl(u32.truncate(8 * (at % 4))))
        }
        var block_flags = flags
        if index == 0 {
            block_flags = block_flags | CHUNK_START
        }
        if index == blocks - 1 {
            block_flags = block_flags | CHUNK_END | ROOT
        }
        value = compress(value, message: words, length: u32.truncate(length), flags: block_flags)
    }
    return value
} chunk_value

/// The chaining value of the block `message` of `length` bytes under `value`, chunk counter 0 and flags `flags`.
fn compress(value: Array[core::Secret[u32], 8], message: Array[core::Secret[u32], 16], length: u32, flags: u32) -> Array[core::Secret[u32], 8] {
    let start = start_words()
    var state = Array[core::Secret[u32], 16].filled(core::Secret.of(0u32))
    for at in 0..<8usize {
        state[at] = value[at]
    }
    for at in 0..<4usize {
        state[8 + at] = start[at]
    }
    state[14] = core::Secret.of(length)
    state[15] = core::Secret.of(flags)
    var words = message
    for round in 0..<7u32 {
        mix(mut state, a: 0, b: 4, c: 8, d: 12, x: words[0], y: words[1])
        mix(mut state, a: 1, b: 5, c: 9, d: 13, x: words[2], y: words[3])
        mix(mut state, a: 2, b: 6, c: 10, d: 14, x: words[4], y: words[5])
        mix(mut state, a: 3, b: 7, c: 11, d: 15, x: words[6], y: words[7])
        mix(mut state, a: 0, b: 5, c: 10, d: 15, x: words[8], y: words[9])
        mix(mut state, a: 1, b: 6, c: 11, d: 12, x: words[10], y: words[11])
        mix(mut state, a: 2, b: 7, c: 8, d: 13, x: words[12], y: words[13])
        mix(mut state, a: 3, b: 4, c: 9, d: 14, x: words[14], y: words[15])
        if round < 6 {
            words = permuted(words)
        }
    }
    var chained = Array[core::Secret[u32], 8].filled(core::Secret.of(0u32))
    for at in 0..<8usize {
        chained[at] = state[at].bit_xor(state[8 + at])
    }
    return chained
} compress

fn mix(
    mut state: Array[core::Secret[u32], 16],
    a: usize,
    b: usize,
    c: usize,
    d: usize,
    x: core::Secret[u32],
    y: core::Secret[u32],
    ) {
    state[a] = state[a].wrapping_add(state[b]).wrapping_add(x)
    state[d] = state[d].bit_xor(state[a]).rotate_right(16)
    state[c] = state[c].wrapping_add(state[d])
    state[b] = state[b].bit_xor(state[c]).rotate_right(12)
    state[a] = state[a].wrapping_add(state[b]).wrapping_add(y)
    state[d] = state[d].bit_xor(state[a]).rotate_right(8)
    state[c] = state[c].wrapping_add(state[d])
    state[b] = state[b].bit_xor(state[c]).rotate_right(7)
} mix

/// The message words in the order of BLAKE3's next round.
fn permuted(words: Array[core::Secret[u32], 16]) -> Array[core::Secret[u32], 16] {
    var next = words
    next[0] = words[2]
    next[1] = words[6]
    next[2] = words[3]
    next[3] = words[10]
    next[4] = words[7]
    next[5] = words[0]
    next[6] = words[4]
    next[7] = words[13]
    next[8] = words[1]
    next[9] = words[11]
    next[10] = words[12]
    next[11] = words[5]
    next[12] = words[9]
    next[13] = words[14]
    next[14] = words[15]
    next[15] = words[8]
    return next
} permuted

test derived_keys_follow_blake3 for derive_key {
    let alloc = testing::world().alloc
    let nothing = mem::List[core::Secret[u8]].empty(alloc)
    let empty = derive_key("BLAKE3 2019-12-27 16:29:52 test vectors context", material: nothing.view(), alloc)
    var material = Array[core::Secret[u8], 72].filled(core::Secret.of(0u8))
    for at in 0..<72usize {
        material[at] = core::Secret.of(u8.truncate(at))
    }
    let node = derive_key("NaN OS store node key 1", material: material.view(), alloc)
    expect empty.bytes[0].reveal() == 0x2C and empty.bytes[1].reveal() == 0xC3 and empty.bytes[31].reveal() == 0x7D
    expect node.bytes[0].reveal() == 0xE3 and node.bytes[1].reveal() == 0x16 and node.bytes[31].reveal() == 0xB5
} derived_keys_follow_blake3
