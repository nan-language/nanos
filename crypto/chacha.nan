//! ChaCha20 (RFC 8439) and HChaCha20, on secret words.

/// The words "expand 32-byte k".
const SIGMA_0: u32 = 0x6170_7865

const SIGMA_1: u32 = 0x3320_646E

const SIGMA_2: u32 = 0x7962_2D32

const SIGMA_3: u32 = 0x6B20_6574

/// A ChaCha state of 16 secret words.
pub closed struct Words {
    pub words: Array[core::Secret[u32], 16]
} Words

/// The state ChaCha starts from: the constants, the key's eight words, then the words `tail` gives.
fn initial(key: Array[core::Secret[u32], 8], tail: Array[core::Secret[u32], 4]) -> Array[core::Secret[u32], 16] {
    var state = Array[core::Secret[u32], 16].filled(core::Secret.of(0u32))
    state[0] = core::Secret.of(SIGMA_0)
    state[1] = core::Secret.of(SIGMA_1)
    state[2] = core::Secret.of(SIGMA_2)
    state[3] = core::Secret.of(SIGMA_3)
    for at in 0..<8usize {
        state[4 + at] = key[at]
    }
    for at in 0..<4usize {
        state[12 + at] = tail[at]
    }
    return state
} initial

fn quarter(
    mut state: Array[core::Secret[u32], 16],
    a: usize,
    b: usize,
    c: usize,
    d: usize,
    ) {
    state[a] = state[a].wrapping_add(state[b])
    state[d] = state[d].bit_xor(state[a]).rotate_left(16)
    state[c] = state[c].wrapping_add(state[d])
    state[b] = state[b].bit_xor(state[c]).rotate_left(12)
    state[a] = state[a].wrapping_add(state[b])
    state[d] = state[d].bit_xor(state[a]).rotate_left(8)
    state[c] = state[c].wrapping_add(state[d])
    state[b] = state[b].bit_xor(state[c]).rotate_left(7)
} quarter

/// The 20 rounds of ChaCha over `state`.
fn rounds(mut state: Array[core::Secret[u32], 16]) {
    for _ in 0..<10u32 {
        quarter(mut state, a: 0, b: 4, c: 8, d: 12)
        quarter(mut state, a: 1, b: 5, c: 9, d: 13)
        quarter(mut state, a: 2, b: 6, c: 10, d: 14)
        quarter(mut state, a: 3, b: 7, c: 11, d: 15)
        quarter(mut state, a: 0, b: 5, c: 10, d: 15)
        quarter(mut state, a: 1, b: 6, c: 11, d: 12)
        quarter(mut state, a: 2, b: 7, c: 8, d: 13)
        quarter(mut state, a: 3, b: 4, c: 9, d: 14)
    }
} rounds

/// The ChaCha20 block of `key` at block counter `counter` under the 96-bit nonce `nonce`.
pub fn block(key: Array[core::Secret[u32], 8], counter: u32, nonce: Array[core::Secret[u32], 3]) -> Words {
    var tail = Array[core::Secret[u32], 4].filled(core::Secret.of(counter))
    for at in 0..<3usize {
        tail[1 + at] = nonce[at]
    }
    let start = initial(key, tail)
    var state = start
    rounds(mut state)
    for at in 0..<16usize {
        state[at] = state[at].wrapping_add(start[at])
    }
    return Words(words: state)
} block

/// The HChaCha20 subkey of `key` under the 128-bit nonce `nonce`.
pub fn hchacha(key: Array[core::Secret[u32], 8], nonce: Array[core::Secret[u32], 4]) -> Array[core::Secret[u32], 8] {
    var state = initial(key, tail: nonce)
    rounds(mut state)
    var subkey = Array[core::Secret[u32], 8].filled(core::Secret.of(0u32))
    for at in 0..<4usize {
        subkey[at] = state[at]
        subkey[4 + at] = state[12 + at]
    }
    return subkey
} hchacha

/// The little-endian word at `at` of `bytes`.
pub fn word_le(bytes: Slice[core::Secret[u8]], at: usize) -> core::Secret[u32] {
    var word = core::Secret.of(0u32)
    for shift in 0..<4usize {
        let byte = core::Secret[u32].widen(bytes[at + shift])
        word = word.bit_or(byte.shl(u32.truncate(8 * shift)))
    }
    return word
} word_le

/// The byte `index`, from 0 for the least significant, of `word`.
pub fn byte_of(word: core::Secret[u32], index: usize) -> core::Secret[u8] {
    return core::Secret[u8].truncate(word.shr(u32.truncate(8 * index)))
} byte_of

test chacha_blocks_follow_rfc_8439 for block {
    var key = Array[core::Secret[u32], 8].filled(core::Secret.of(0u32))
    var bytes = Array[core::Secret[u8], 32].filled(core::Secret.of(0u8))
    for at in 0..<32usize {
        bytes[at] = core::Secret.of(u8.truncate(at))
    }
    for at in 0..<8usize {
        key[at] = word_le(bytes.view(), at: 4 * at)
    }
    var nonce = Array[core::Secret[u32], 3].filled(core::Secret.of(0u32))
    nonce[0] = core::Secret.of(0x0900_0000u32)
    nonce[1] = core::Secret.of(0x4A00_0000u32)
    let out = block(key, counter: 1, nonce)
    expect out.words[0].reveal() == 0xE4E7_F110 and out.words[1].reveal() == 0x1559_3BD1 and out.words[15].reveal() == 0x4E3C_50A2
} chacha_blocks_follow_rfc_8439

test hchacha_follows_the_xchacha_draft for hchacha {
    var bytes = Array[core::Secret[u8], 32].filled(core::Secret.of(0u8))
    for at in 0..<32usize {
        bytes[at] = core::Secret.of(u8.truncate(at))
    }
    var key = Array[core::Secret[u32], 8].filled(core::Secret.of(0u32))
    for at in 0..<8usize {
        key[at] = word_le(bytes.view(), at: 4 * at)
    }
    var nonce = Array[core::Secret[u32], 4].filled(core::Secret.of(0u32))
    nonce[0] = core::Secret.of(0x0900_0000u32)
    nonce[1] = core::Secret.of(0x4A00_0000u32)
    nonce[3] = core::Secret.of(0x2759_4131u32)
    let subkey = hchacha(key, nonce)
    expect subkey[0].reveal() == 0x423B_4182 and subkey[1].reveal() == 0xFE7B_B227 and subkey[7].reveal() == 0xDCEC_D326
} hchacha_follows_the_xchacha_draft
