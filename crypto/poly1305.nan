//! Poly1305 (RFC 8439) over whole 16-byte blocks, its accumulator in five secret 26-bit limbs.

const LIMB: u64 = 0x3FF_FFFF

/// A Poly1305 authenticator: its key's clamped `r` and `s`, and the accumulator.
struct Mac {
    r: Array[core::Secret[u64], 5]
    s: Array[core::Secret[u64], 4]
    h: Array[core::Secret[u64], 5]
} Mac

/// The authenticator keyed by the first eight words of `key`, `r` then `s`.
fn Mac.of(key: Words) -> Mac {
    let t0 = core::Secret[u64].widen(key.words[0])
    let t1 = core::Secret[u64].widen(key.words[1])
    let t2 = core::Secret[u64].widen(key.words[2])
    let t3 = core::Secret[u64].widen(key.words[3])
    var r = Array[core::Secret[u64], 5].filled(core::Secret.of(0u64))
    r[0] = t0.bit_and(core::Secret.of(0x3FF_FFFFu64))
    r[1] = t0.shr(26).bit_or(t1.shl(6)).bit_and(core::Secret.of(0x3FF_FF03u64))
    r[2] = t1.shr(20).bit_or(t2.shl(12)).bit_and(core::Secret.of(0x3FF_C0FFu64))
    r[3] = t2.shr(14).bit_or(t3.shl(18)).bit_and(core::Secret.of(0x3F0_3FFFu64))
    r[4] = t3.shr(8).bit_and(core::Secret.of(0x00F_FFFFu64))
    var s = Array[core::Secret[u64], 4].filled(core::Secret.of(0u64))
    for at in 0..<4usize {
        s[at] = core::Secret[u64].widen(key.words[4 + at])
    }
    return Mac(r: r, s: s, h: Array[core::Secret[u64], 5].filled(core::Secret.of(0u64)))
} Mac.of

/// Absorbs the 16 bytes of `data` from `at`.
fn Mac.absorb(mut self, data: Slice[u8], at: usize) {
    let m0 = core::Secret.of(u64.widen(data.u32_le(at)))
    let m1 = core::Secret.of(u64.widen(data.u32_le(at + 4)))
    let m2 = core::Secret.of(u64.widen(data.u32_le(at + 8)))
    let m3 = core::Secret.of(u64.widen(data.u32_le(at + 12)))
    let low26 = core::Secret.of(LIMB)
    var h = self.h
    h[0] = h[0].wrapping_add(m0.bit_and(low26))
    h[1] = h[1].wrapping_add(m0.shr(26).bit_or(m1.shl(6)).bit_and(low26))
    h[2] = h[2].wrapping_add(m1.shr(20).bit_or(m2.shl(12)).bit_and(low26))
    h[3] = h[3].wrapping_add(m2.shr(14).bit_or(m3.shl(18)).bit_and(low26))
    h[4] = h[4].wrapping_add(m3.shr(8).bit_or(core::Secret.of(0x100_0000u64)))
    let r = self.r
    let five = core::Secret.of(5u64)
    let s1 = r[1].wrapping_mul(five)
    let s2 = r[2].wrapping_mul(five)
    let s3 = r[3].wrapping_mul(five)
    let s4 = r[4].wrapping_mul(five)
    var d = Array[core::Secret[u64], 5].filled(core::Secret.of(0u64))
    d[0] = h[0].wrapping_mul(r[0]).wrapping_add(h[1].wrapping_mul(s4)).wrapping_add(h[2].wrapping_mul(s3)).wrapping_add(h[3].wrapping_mul(s2)).wrapping_add(h[4].wrapping_mul(s1))
    d[1] = h[0].wrapping_mul(r[1]).wrapping_add(h[1].wrapping_mul(r[0])).wrapping_add(h[2].wrapping_mul(s4)).wrapping_add(h[3].wrapping_mul(s3)).wrapping_add(h[4].wrapping_mul(s2))
    d[2] = h[0].wrapping_mul(r[2]).wrapping_add(h[1].wrapping_mul(r[1])).wrapping_add(h[2].wrapping_mul(r[0])).wrapping_add(h[3].wrapping_mul(s4)).wrapping_add(h[4].wrapping_mul(s3))
    d[3] = h[0].wrapping_mul(r[3]).wrapping_add(h[1].wrapping_mul(r[2])).wrapping_add(h[2].wrapping_mul(r[1])).wrapping_add(h[3].wrapping_mul(r[0])).wrapping_add(h[4].wrapping_mul(s4))
    d[4] = h[0].wrapping_mul(r[4]).wrapping_add(h[1].wrapping_mul(r[3])).wrapping_add(h[2].wrapping_mul(r[2])).wrapping_add(h[3].wrapping_mul(r[1])).wrapping_add(h[4].wrapping_mul(r[0]))
    var carry = core::Secret.of(0u64)
    for index in 0..<5usize {
        let total = d[index].wrapping_add(carry)
        h[index] = total.bit_and(low26)
        carry = total.shr(26)
    }
    h[0] = h[0].wrapping_add(carry.wrapping_mul(five))
    h[1] = h[1].wrapping_add(h[0].shr(26))
    h[0] = h[0].bit_and(low26)
    self.h = h
} Mac.absorb

/// The tag: the accumulator reduced modulo 2^130 − 5, plus `s` modulo 2^128.
fn Mac.tag(self) -> Array[u8, 16] {
    let low26 = core::Secret.of(LIMB)
    var h = self.h
    var carry = core::Secret.of(0u64)
    for at in 1..<5usize {
        h[at] = h[at].wrapping_add(carry)
        carry = h[at].shr(26)
        h[at] = h[at].bit_and(low26)
    }
    h[0] = h[0].wrapping_add(carry.wrapping_mul(core::Secret.of(5u64)))
    h[1] = h[1].wrapping_add(h[0].shr(26))
    h[0] = h[0].bit_and(low26)
    var g = Array[core::Secret[u64], 5].filled(core::Secret.of(0u64))
    carry = core::Secret.of(5u64)
    for at in 0..<4usize {
        let total = h[at].wrapping_add(carry)
        g[at] = total.bit_and(low26)
        carry = total.shr(26)
    }
    g[4] = h[4].wrapping_add(carry).wrapping_sub(core::Secret.of(0x400_0000u64))
    let reduced = g[4].shr(63).eq(core::Secret.of(0u64))
    for at in 0..<5usize {
        h[at] = reduced.select(g[at], if_false: h[at])
    }
    let mask = core::Secret.of(0xFFFF_FFFFu64)
    var words = Array[core::Secret[u64], 4].filled(core::Secret.of(0u64))
    words[0] = h[0].bit_or(h[1].shl(26)).bit_and(mask)
    words[1] = h[1].shr(6).bit_or(h[2].shl(20)).bit_and(mask)
    words[2] = h[2].shr(12).bit_or(h[3].shl(14)).bit_and(mask)
    words[3] = h[3].shr(18).bit_or(h[4].shl(8)).bit_and(mask)
    var tag = Array[u8, 16].filled(0)
    var sum = core::Secret.of(0u64)
    for at in 0..<4usize {
        sum = words[at].wrapping_add(self.s[at]).wrapping_add(sum.shr(32))
        let word = core::Secret[u32].truncate(sum)
        for index in 0..<4usize {
            tag[4 * at + index] = byte_of(word, index).reveal()
        }
    }
    return tag
} Mac.tag
