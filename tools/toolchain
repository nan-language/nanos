#!/bin/sh
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
workspace=$(cd "${1:-$root}" && pwd)
version=$(sed -n 's/.*NAN_VERSION=\(v[0-9.]*\).*/\1/p' "$root/tools/install")
interface=$workspace/.nan/images/x86_64-bare/kernel.nlif
if [ ! -f "$interface" ]; then
    echo "toolchain: $interface is missing; build the kernel first" >&2
    exit 1
fi

cache=$root/.nan/toolchain
mkdir -p "$cache"
exec 9>"$cache/lock"
flock 9

source=$cache/nan-${version#v}
if [ ! -d "$source" ]; then
    find "$cache" -mindepth 1 -maxdepth 1 ! -name lock -exec rm -rf {} +
    mkdir "$cache/download"
    curl -fsSL "https://github.com/nan-language/nan/archive/refs/tags/$version.tar.gz" | tar -C "$cache/download" -xzf - "nan-${version#v}/toolchain"
    sed -i 's/^    targets x86_64-linux$/    targets x86_64-nanos/' "$cache/download/nan-${version#v}/toolchain/nan/package.nan"
    mv "$cache/download/nan-${version#v}" "$source"
    rmdir "$cache/download"
fi

against=$(sha256sum "$interface" | cut -d' ' -f1)
if [ "$(cat "$source/against" 2>/dev/null || true)" != "$against" ]; then
    rm -f "$source/against"
    (cd "$source/toolchain" && nan build nan --against "$interface" >/dev/null)
    echo "$against" >"$source/against"
fi

built=$source/toolchain/.nan/images/x86_64-nanos
images=$workspace/.nan/images/x86_64-nanos
mkdir -p "$images"
cp "$built/nan.nbun" "$built/nan.ntree" "$images/"
echo "ok toolchain $version: $images/nan.nbun"
