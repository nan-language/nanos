#!/bin/sh
set -eu

usage() {
    echo "usage: tools/sandbox start|reset [<instance>]" >&2
    exit 2
}

case ${1:-} in
    start | reset) ;;
    *) usage ;;
esac
[ $# -le 2 ] || usage
name=${2:-default}
case $name in
    "" | *[!A-Za-z0-9_-]*) usage ;;
esac

root=$(cd "$(dirname "$0")/.." && pwd)
instance=$root/.sandbox/$name
mkdir -p "$root/.sandbox"
exec 9>"$instance.lock"
if ! flock -w 5 9; then
    echo "sandbox: $name is running" >&2
    exit 1
fi

case $1 in
    reset)
        rm -rf "$instance"
        ;;
    start)
        rm -rf "$instance"
        mkdir "$instance"
        tar -C "$root" --exclude=./.git --exclude=./.nan --exclude=./.sandbox -cf - . | tar -C "$instance" -xf -
        cd "$instance"
        nan build .
        exec nan run loader
        ;;
esac
