//! The bundler: the host program making the bundle files NaN OS admits from what bundle builds write, and the generations it boots.

package bundler {
    language 1
    targets x86_64-linux
    entry main
    dep bootfmt "../../bootfmt"
    dep code "../../code"
    dep devices "../../devices"
    dep drivers "../../drivers"
    dep genesis "../../genesis"
    dep ident "../../ident"
    dep store "../../store"
    allow confined in drivers, genesis
    allow contribute devices::drivers in drivers
    allow device in drivers, genesis
    allow validate in bootfmt, bundler, code, devices, drivers, genesis, ident, store
} bundler
